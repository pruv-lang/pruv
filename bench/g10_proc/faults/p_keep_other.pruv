// Must verify: reading stderr keeps the stdout snapshot (G10_PROC_SPEC 4.6).
fn good(take input: Process) -> Process ! proc, alloc
  requires proc_ok(input) && proc_size(input, 1) == 3
{
  let p: Process = proc_read(move input, 2, 16);
  if proc_ok(p) {
    assert proc_size(p, 1) == 3;
  }
  return move p;
}
