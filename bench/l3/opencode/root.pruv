// OpenCode conversation import (L3-7): public entries. See bench/l3/opencode/DESIGN.md and IMPL_NOTES.md.
// Written without a shell: not compiled or verified.
// Pruv owns every decision; the host only runs primitive requests and applies bank patches. Each opencode_step consumes at
// most one completion and returns one step packet. Root validates shapes, matches the completion, dispatches by ctl phase
// range to the stateful modules, and re-checks what they return (progress rule, request ids) before the host sees it.
mod json;
mod parse;
mod access;
mod jstr;
mod bytes;
mod text;
mod time;
mod names;
mod turns;
mod util;
mod packet;
mod path;
mod admit;
mod sql;
mod rows;
mod list;
mod export;
mod entry;
mod convert;
mod plan;

fn safe_mode(cfg: [i64]) -> i64
  ensures 0 <= result && result <= 5
{
  if len(cfg) < 2 { return 0; }
  if cfg[1] < 0 || cfg[1] > 5 { return 0; }
  return cfg[1];
}

// key text equality over two refs of t (both already range-checked)
fn key_same(t: [u8], s1: i64, l1: i64, s2: i64, l2: i64) -> bool
  requires 0 <= s1 && 0 <= l1 && l1 <= len(t) - s1 && 0 <= s2 && 0 <= l2 && l2 <= len(t) - s2
{
  if l1 != l2 { return false; }
  let mut i: i64 = 0;
  while i < l1
    invariant 0 <= i && i <= l1 && l1 == l2 && 0 <= s1 && l1 <= len(t) - s1 && 0 <= s2 && l2 <= len(t) - s2
    decreases l1 - i
  {
    if t[s1 + i] != t[s2 + i] { return false; }
    i = i + 1;
  }
  return true;
}

// no NUL byte; and no '=' when no_eq (an environment key)
fn str_clean(t: [u8], s: i64, l: i64, no_eq: bool) -> bool
  requires 0 <= s && 0 <= l && l <= len(t) - s
{
  let mut j: i64 = 0;
  while j < l
    invariant 0 <= j && j <= l && 0 <= s && l <= len(t) - s
    decreases l - j
  {
    let c: i64 = t[s + j];
    if c == 0 { return false; }
    if no_eq && c == 61 { return false; }
    j = j + 1;
  }
  return true;
}

// effective-environment table: refs inside t and nonempty keys; keys without NUL or '=', values without NUL and unique
// keys only when uniq, i.e. once at begin: the configuration is immutable across a case
fn env_ok(cfg: [i64], t: [u8], n: i64, uniq: bool) -> bool ! alloc
  requires 0 <= n && n <= 536870903 && len(cfg) == 32 + 4 * n
{
  if uniq { return keys_unique(cfg, t, n); }
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n <= 536870903 && len(cfg) == 32 + 4 * n
    decreases n - i
  {
    let b: i64 = 32 + 4 * i;
    let ks: i64 = cfg[b];
    let kl: i64 = cfg[b + 1];
    let vs: i64 = cfg[b + 2];
    let vl: i64 = cfg[b + 3];
    if ks < 0 || vs < 0 || kl < 1 { return false; }
    if !crate::packet::ref_ok(ks, kl, len(t)) || !crate::packet::ref_ok(vs, vl, len(t)) { return false; }
    i = i + 1;
  }
  return true;
}

// DB5 (D-R07-1): the begin pass. One loop per row checks the refs, scans the key once (NUL, '=' and an FNV-1a hash
// together), scans the value for NUL, then places the row number in an open-addressing table (power-of-two size > 2N,
// linear probing, slot = band(hash, size-1)): O(E) expected instead of comparing every key with every earlier key.
fn keys_unique(cfg: [i64], t: [u8], n: i64) -> bool ! alloc
  requires 0 <= n && n <= 536870903 && len(cfg) == 32 + 4 * n
{
  let mut size: i64 = 1;
  while size <= 2 * n
    invariant 1 <= size && size <= 4 * n + 2 && n <= 536870903
    decreases 4 * n + 2 - size
  {
    size = size * 2;
  }
  let mask: i64 = size - 1;
  let mut tab: [i64] = alloc(size, -1);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n <= 536870903 && len(cfg) == 32 + 4 * n && mask == size - 1 && 1 <= size && len(tab) == size
    decreases n - i
  {
    let b: i64 = 32 + 4 * i;
    let ks: i64 = cfg[b];
    let kl: i64 = cfg[b + 1];
    let vs: i64 = cfg[b + 2];
    let vl: i64 = cfg[b + 3];
    if ks < 0 || vs < 0 || kl < 1 { return false; }
    if !crate::packet::ref_ok(ks, kl, len(t)) || !crate::packet::ref_ok(vs, vl, len(t)) { return false; }
    if !str_clean(t, vs, vl, false) { return false; }
    let mut h: i64 = -3750763034362895579;
    let mut k: i64 = 0;
    while k < kl
      invariant 0 <= k && k <= kl && 0 <= ks && kl <= len(t) - ks
      decreases kl - k
    {
      let c: i64 = t[ks + k];
      if c == 0 || c == 61 { return false; }
      h = wrapping_mul(bxor(h, c), 1099511628211);
      k = k + 1;
    }
    let mut at: i64 = band(h, mask);
    let mut probes: i64 = 0;
    let mut placed: bool = false;
    while !placed && probes < size
      invariant 0 <= at && at < size && 0 <= probes && probes <= size && len(tab) == size && mask == size - 1
      invariant 0 <= i && i < n && n <= 536870903 && len(cfg) == 32 + 4 * n && 0 <= ks && 0 <= kl && kl <= len(t) - ks
      decreases size - probes
    {
      let r: i64 = tab[at];
      if r < 0 {
        tab[at] = i;
        placed = true;
      } else {
        if r >= n { return false; }
        let b2: i64 = 32 + 4 * r;
        let s2: i64 = cfg[b2];
        let l2: i64 = cfg[b2 + 1];
        if s2 < 0 || !crate::packet::ref_ok(s2, l2, len(t)) { return false; }
        if key_same(t, ks, kl, s2, l2) { return false; }
        at = band(at + 1, mask);
      }
      probes = probes + 1;
    }
    if !placed { return false; }
    i = i + 1;
  }
  return true;
}

// cfg: 32+4N words (32+4N <= 2^31-1), version 1, mode 0..5, timeouts 1..2^31-1, env mode 0/1, refs absent or inside cfg_text, N
// matches the length, direct plan ref present iff mode 5, reserved words 21..31 zero, valid environment table.
fn cfg_ok(cfg: [i64], t: [u8], uniq: bool) -> bool ! alloc
  ensures result ==> (len(cfg) >= 32 && len(cfg) <= 2147483647 && 0 <= cfg[1] && cfg[1] <= 5 && len(t) <= 2147483647)
{
  if !cfg_head_ok(cfg, t) { return false; }
  let n: i64 = (len(cfg) - 32) / 4;
  return env_ok(cfg, t, n, uniq);
}

// the O(1) header part of cfg_ok; the checked step runs cfg_ok(uniq=false): this plus the O(E) refs-only row loop
fn cfg_head_ok(cfg: [i64], t: [u8]) -> bool
  ensures result ==> (len(cfg) >= 32 && len(cfg) <= 2147483647 && 0 <= cfg[1] && cfg[1] <= 5 && len(t) <= 2147483647)
  ensures result ==> (len(cfg) - 32) % 4 == 0
{
  if len(cfg) < 32 || len(cfg) > 2147483647 || len(t) > 2147483647 { return false; }
  if (len(cfg) - 32) % 4 != 0 { return false; }
  let n: i64 = (len(cfg) - 32) / 4;
  if cfg[18] != n { return false; }
  if cfg[0] != 1 || cfg[1] < 0 || cfg[1] > 5 { return false; }
  if cfg[2] < 1 || cfg[2] > 2147483647 || cfg[3] < 1 || cfg[3] > 2147483647 { return false; }
  if cfg[4] < 1 || cfg[4] > 2147483647 || cfg[5] < 0 || cfg[5] > 1 { return false; }
  let mut k: i64 = 6;
  while k <= 16
    invariant 6 <= k && k <= 18 && len(cfg) >= 32 && len(t) <= 2147483647
    decreases 18 - k
  {
    if !crate::packet::ref_ok(cfg[k], cfg[k + 1], len(t)) { return false; }
    k = k + 2;
  }
  if !crate::packet::ref_ok(cfg[19], cfg[20], len(t)) { return false; }
  if cfg[1] == 5 && cfg[19] < 0 { return false; }
  if cfg[1] != 5 && cfg[19] != -1 { return false; }
  let mut z: i64 = 21;
  while z < 32
    invariant 21 <= z && z <= 32 && len(cfg) >= 32
    decreases 32 - z
  {
    if cfg[z] != 0 { return false; }
    z = z + 1;
  }
  return true;
}

// two-word refs of ctl (words 24,26,..,36): absent (-1,0) or inside the text bank when tl >= 0 (tl < 0: structure only)
fn ctl_refs_ok(a: [i64], off: i64, tl: i64) -> bool
  requires 0 <= off && off <= 12 && len(a) >= off + 64 && -1 <= tl
{
  let mut k: i64 = 24;
  while k <= 36
    invariant 24 <= k && k <= 38 && 0 <= off && off <= 12 && len(a) >= off + 64 && -1 <= tl
    decreases 38 - k
  {
    let s: i64 = a[off + k];
    let n: i64 = a[off + k + 1];
    if tl >= 0 {
      if !crate::packet::ref_ok(s, n, tl) { return false; }
    } else {
      if s < -1 || n < 0 { return false; }
      if s == -1 && n != 0 { return false; }
    }
    k = k + 2;
  }
  return true;
}

// 64-word control block at offset off of a (0 for ctl, 12 inside a step packet), same mode, internally consistent
fn ctl_ok_at(a: [i64], off: i64, mode: i64, tl: i64) -> bool
  requires 0 <= off && off <= 12 && len(a) >= off + 64 && -1 <= tl
  ensures result ==> (a[off + 1] == mode && 0 <= a[off + 2] && a[off + 2] <= 999 && 1 <= a[off + 3] && a[off + 3] <= 1000000000)
  ensures result ==> (0 <= a[off + 4] && a[off + 4] < a[off + 3] && 0 <= a[off + 5] && a[off + 5] <= 15 && 0 <= a[off + 6] && a[off + 6] <= 2)
{
  if a[off] != 1 || a[off + 1] != mode { return false; }
  let ph: i64 = a[off + 2];
  let nid: i64 = a[off + 3];
  let pend: i64 = a[off + 4];
  let opc: i64 = a[off + 5];
  let ex: i64 = a[off + 6];
  if ph < 0 || ph > 999 || nid < 1 || nid > 1000000000 { return false; }
  if pend < 0 || pend >= nid || opc < 0 || opc > 15 || ex < 0 || ex > 2 { return false; }
  if pend == 0 && opc != 0 { return false; }
  if pend != 0 && opc == 0 { return false; }
  if ex == 1 && pend == 0 { return false; }
  if ex != 1 && pend != 0 { return false; }
  if ex == 2 && ph != 999 { return false; }
  if ex != 2 && ph == 999 { return false; }
  if a[off + 7] < 0 || a[off + 7] > 999 { return false; }
  if a[off + 8] < -1 || a[off + 9] < -1 || a[off + 10] < -1 || a[off + 11] < -1 || a[off + 12] < -1 { return false; }
  if a[off + 13] < 0 || a[off + 13] > 1 || a[off + 14] < 0 || a[off + 14] > 1 || a[off + 15] < 0 || a[off + 15] > 1 { return false; }
  if a[off + 16] < 0 || a[off + 17] < 0 || a[off + 18] < 0 || a[off + 19] < 0 || a[off + 19] > 2 { return false; }
  if a[off + 20] < 0 || a[off + 21] < 0 || a[off + 20] > a[off + 21] { return false; }
  if a[off + 22] < 0 || a[off + 22] > 1 || a[off + 23] < 0 || a[off + 23] > 5 { return false; }
  if a[off + 38] < 0 || a[off + 38] > 1 || a[off + 39] < 0 { return false; }
  if !ctl_refs_ok(a, off, tl) { return false; }
  let mut z: i64 = 40;
  while z < 64
    invariant 40 <= z && z <= 64 && 0 <= off && off <= 12 && len(a) >= off + 64
    decreases 64 - z
  {
    if a[off + z] != 0 { return false; }
    z = z + 1;
  }
  return true;
}

// every bank and the completion are at most 2^31-1 elements (the modules rely on this)
fn banks_ok(query_words: [i64], query_bytes: [u8], rows: [i64], text: [u8], document: [u8], saved_result: [i64], completion: [u8]) -> bool
  ensures result ==> (len(query_words) <= 2147483647 && len(query_bytes) <= 2147483647 && len(rows) <= 2147483647 && len(text) <= 2147483647)
  ensures result ==> (len(document) <= 2147483647 && len(saved_result) <= 2147483647 && len(completion) <= 2147483647)
{
  return len(query_words) <= 2147483647 && len(query_bytes) <= 2147483647 && len(rows) <= 2147483647 && len(text) <= 2147483647
    && len(document) <= 2147483647 && len(saved_result) <= 2147483647 && len(completion) <= 2147483647;
}

// the control state is changed (a continue packet must make progress)
fn ctl_differs(old: [i64], p: [i64]) -> bool
  requires len(old) == 64 && len(p) >= 76
{
  let mut i: i64 = 0;
  while i < 64
    invariant 0 <= i && i <= 64 && len(old) == 64 && len(p) >= 76
    decreases 64 - i
  {
    if p[12 + i] != old[i] { return true; }
    i = i + 1;
  }
  return false;
}

// event/completion patch sources (kinds 1 and 2) stay inside the event words / completion bytes
fn patch_src_ok(p: [i64], pc: i64, nev: i64, ncomp: i64) -> bool
  requires 0 <= pc && pc <= 512 && len(p) >= 76 + 8 * pc && 0 <= nev && 0 <= ncomp
{
  let mut i: i64 = 0;
  while i < pc
    invariant 0 <= i && i <= pc && pc <= 512 && len(p) >= 76 + 8 * pc && 0 <= nev && 0 <= ncomp
    decreases pc - i
  {
    let b: i64 = 76 + 8 * i;
    if p[b] == 1 {
      let src: i64 = p[b + 4];
      let off: i64 = p[b + 5];
      let cnt: i64 = p[b + 3];
      if src == 1 && (off < 0 || off > nev || cnt < 0 || cnt > nev - off) { return false; }
      if src == 2 && (off < 0 || off > ncomp || cnt < 0 || cnt > ncomp - off) { return false; }
    }
    i = i + 1;
  }
  return true;
}

// What a module returned: header and length consistent, new ctl valid (mode kept, next id grows by exactly the issued
// request), the request row matches ctl[4]/[5]/[6], action rules, patch sources, progress for a continue.
fn out_ok(old: [i64], p: [i64], nev: i64, ncomp: i64) -> bool
  requires len(old) == 64 && 1 <= old[3] && old[3] <= 1000000000 && 0 <= nev && 0 <= ncomp
  ensures result ==> len(p) >= 76
{
  if len(p) < 76 || len(p) > 2147483647 { return false; }
  if p[0] != 1329812273 || p[1] != 1 || p[3] != 64 { return false; }
  let action: i64 = p[2];
  if action < 0 || action > 2 { return false; }
  let pc: i64 = p[4];
  let rc: i64 = p[5];
  let lw: i64 = p[6];
  let lb: i64 = p[7];
  let lr: i64 = p[8];
  if pc < 0 || pc > 512 || rc < 0 || rc > 1 { return false; }
  if lw < 0 || lw > 2147483647 || lb < 0 || lb > 2147483647 || lr < 0 || lr > 2147483647 { return false; }
  if len(p) != 76 + 8 * pc + 12 * rc + lw + lb + lr { return false; }
  if p[9] != 0 || p[10] != 0 || p[11] != 0 { return false; }
  if !ctl_ok_at(p, 12, old[1], -1) { return false; }
  let ph: i64 = p[14];
  let nid: i64 = p[15];
  let pend: i64 = p[16];
  let opc: i64 = p[17];
  let ex: i64 = p[18];
  if action == 0 {
    if rc != 1 || old[3] >= 1000000000 { return false; }
    if ph == 999 || nid != old[3] + 1 || pend != old[3] || ex != 1 { return false; }
    let rb: i64 = 76 + 8 * pc;
    if p[rb] != old[3] || p[rb + 1] != opc { return false; }
  } else {
    if rc != 0 || nid != old[3] { return false; }
    if action == 1 {
      if ph != 999 || pend != 0 || ex != 2 { return false; }
    } else {
      if ph == 999 || pend != 0 || opc != 0 || ex != 0 { return false; }
      if !ctl_differs(old, p) { return false; }
    }
  }
  return patch_src_ok(p, pc, nev, ncomp);
}

// Phase dispatch (ranges in IMPL_NOTES.md). Requires = exactly what every module's advance requires.
fn route(cfg: [i64], cfg_text: [u8], ctl: [i64], query_words: [i64], query_bytes: [u8], rows: [i64], text: [u8],
         document: [u8], saved_result: [i64], event: [i64], completion: [u8]) -> [i64] ! alloc
  requires len(cfg) >= 32 && len(cfg) <= 2147483647 && 0 <= cfg[1] && cfg[1] <= 5 && len(ctl) == 64 && len(event) >= 16
  requires 1 <= ctl[3] && ctl[3] <= 1000000000 && 0 <= ctl[4] && ctl[4] < ctl[3] && 0 <= ctl[2] && ctl[2] <= 999
  requires 0 <= ctl[5] && ctl[5] <= 15 && 0 <= ctl[6] && ctl[6] <= 2 && ctl[1] == cfg[1]
  requires len(cfg_text) <= 2147483647 && len(query_words) <= 2147483647 && len(query_bytes) <= 2147483647 && len(rows) <= 2147483647
  requires len(text) <= 2147483647 && len(document) <= 2147483647 && len(saved_result) <= 2147483647 && len(completion) <= 2147483647
  ensures len(result) >= 76
{
  let phase: i64 = ctl[2];
  if phase >= 100 && phase <= 199 {
    return crate::admit::advance(cfg, cfg_text, ctl, query_words, query_bytes, rows, text, document, saved_result, event, completion);
  }
  if phase >= 200 && phase <= 299 {
    return crate::sql::advance(cfg, cfg_text, ctl, query_words, query_bytes, rows, text, document, saved_result, event, completion);
  }
  if phase >= 300 && phase <= 399 {
    return crate::list::advance(cfg, cfg_text, ctl, query_words, query_bytes, rows, text, document, saved_result, event, completion);
  }
  if phase >= 400 && phase <= 499 {
    return crate::export::advance(cfg, cfg_text, ctl, query_words, query_bytes, rows, text, document, saved_result, event, completion);
  }
  if phase == 500 {
    if cfg[1] == 5 && (cfg[19] < 0 || cfg[20] < 0) { return crate::packet::done_internal(ctl, 0); }
    if cfg[1] == 5 {
      // direct plan: the JSON array is cfg_text[cfg[19]..cfg[19]+cfg[20]]; plan::direct returns a result packet
      let res: [i64] = crate::plan::direct(cfg, cfg_text);
      return crate::packet::done_wrap(ctl, res);
    }
    if cfg[1] == 1 {
      return crate::convert::advance(cfg, cfg_text, ctl, query_words, query_bytes, rows, text, document, saved_result, event, completion);
    }
    return crate::packet::done_internal(ctl, 28);
  }
  if phase == 600 {
    // dataDir (3) / folderKey (4): no I/O; path::utility returns a result packet
    if cfg[1] == 3 || cfg[1] == 4 {
      let res2: [i64] = crate::path::utility(cfg, cfg_text, cfg[1]);
      return crate::packet::done_wrap(ctl, res2);
    }
    return crate::packet::done_internal(ctl, 28);
  }
  return crate::packet::done_internal(ctl, 28);
}

pub fn opencode_begin(cfg: [i64], cfg_text: [u8]) -> [i64] ! alloc
  ensures len(result) >= 76
{
  if !cfg_ok(cfg, cfg_text, true) { return crate::packet::done_internal(crate::packet::ctl_init(safe_mode(cfg), 999), 0); }
  // every configuration string must fit the core's 10^9-byte string bound: explicit InputTooLarge, never a changed value
  if len(cfg_text) > 1000000000 { return crate::packet::done_simple(crate::packet::ctl_init(cfg[1], 999), 0, 3, 5); }
  let mode: i64 = cfg[1];
  let mut phase: i64 = 100;
  if mode == 3 || mode == 4 { phase = 600; }
  if mode == 5 { phase = 500; }
  let ctl: [i64] = crate::packet::ctl_init(mode, phase);
  let ep: [i64] = alloc(0, 0);
  let eb: [u8] = alloc(0, 0);
  return crate::packet::step_packet(ctl, ep, ep, ep, eb, ep, 2);
}

// Checked step: re-checks the configuration geometry (O(E), no text scan) for a caller that did not keep the begin
// admission. A host that owns the admitted configuration calls opencode_step_admitted instead.
pub fn opencode_step(
  cfg: [i64], cfg_text: [u8], ctl: [i64],
  query_words: [i64], query_bytes: [u8], rows: [i64], text: [u8],
  document: [u8], saved_result: [i64],
  event: [i64], completion: [u8]
) -> [i64] ! alloc
  ensures len(result) >= 76
{
  if !cfg_ok(cfg, cfg_text, false) { return crate::packet::done_internal(crate::packet::ctl_init(safe_mode(cfg), 999), 0); }
  return step_body(cfg, cfg_text, ctl, query_words, query_bytes, rows, text, document, saved_result, event, completion);
}

// Admitted step (R07 B): the host passes the same immutable cfg/cfg_text that opencode_begin admitted (keys, values,
// uniqueness, every ref) and that begin answered with a continue packet. Only the O(1) facts the phase modules need are
// entry requires (checked at run time); the per-step O(E) environment walk is gone. Every bank, event, completion and
// the ctl stay checked as before, and spawn_pool keeps its own ref guards.
pub fn opencode_step_admitted(
  cfg: [i64], cfg_text: [u8], ctl: [i64],
  query_words: [i64], query_bytes: [u8], rows: [i64], text: [u8],
  document: [u8], saved_result: [i64],
  event: [i64], completion: [u8]
) -> [i64] ! alloc
  requires len(cfg) >= 32 && len(cfg) <= 2147483647 && 0 <= cfg[1] && cfg[1] <= 5 && len(cfg_text) <= 2147483647
  ensures len(result) >= 76
{
  return step_body(cfg, cfg_text, ctl, query_words, query_bytes, rows, text, document, saved_result, event, completion);
}

fn step_body(
  cfg: [i64], cfg_text: [u8], ctl: [i64],
  query_words: [i64], query_bytes: [u8], rows: [i64], text: [u8],
  document: [u8], saved_result: [i64],
  event: [i64], completion: [u8]
) -> [i64] ! alloc
  requires len(cfg) >= 32 && len(cfg) <= 2147483647 && 0 <= cfg[1] && cfg[1] <= 5 && len(cfg_text) <= 2147483647
  ensures len(result) >= 76
{
  // DB5 (D-R07-3): the blank control is built only on the paths that answer with it
  if len(ctl) != 64 { return crate::packet::done_internal(crate::packet::ctl_init(cfg[1], 999), 28); }
  if !banks_ok(query_words, query_bytes, rows, text, document, saved_result, completion) {
    return crate::packet::done_simple(crate::packet::ctl_init(cfg[1], 999), 0, 3, 5);
  }
  if !ctl_ok_at(ctl, 0, cfg[1], len(text)) { return crate::packet::done_internal(crate::packet::ctl_init(cfg[1], 999), 28); }
  if !crate::packet::event_shape(event, len(completion)) { return crate::packet::done_internal(ctl, 28); }
  // terminal reentry; the empty event only after begin/continue; a completion only for the pending request, once
  let ex: i64 = ctl[6];
  if ex == 2 || ctl[2] == 999 { return crate::packet::done_internal(crate::packet::ctl_init(cfg[1], 999), 28); }
  let empty_ev: bool = crate::packet::event_empty(event);
  if ex == 0 {
    if !empty_ev { return crate::packet::done_internal(ctl, 28); }
  } else {
    if empty_ev || ctl[4] <= 0 { return crate::packet::done_internal(ctl, 28); }
    if event[1] != ctl[4] || event[2] != ctl[5] { return crate::packet::done_internal(ctl, 28); }
  }
  let p: [i64] = route(cfg, cfg_text, ctl, query_words, query_bytes, rows, text, document, saved_result, event, completion);
  if !out_ok(ctl, p, len(event), len(completion)) { return crate::packet::done_internal(ctl, 28); }
  return p;
}
