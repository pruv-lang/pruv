// OpenCode path module (package B): follows DESIGN.md/IMPL_NOTES.md; written without a shell (not compiled).
// Contents: POSIX join/dirname/containment, data dir, DB path, folder key, `utility` (modes 3/4), and the step helpers that
// admit.pruv, sql.pruv and list.pruv share (ask, proceed, append_patch, ok_event, db_error, fail_with, rows_ok).

// ---- POSIX join/normalize (Node path.posix), in the hand shape ----
// Hand `normalize(p: &str) -> String`: `Vec<&str>` pieces of `p`, `pop` on "..", `out.join("/")`, then '.', the
// trailing '/' and `insert(0, '/')`. The piece sum (R-6g9-13) bounds the join (R-6g9-16) with no run-time guard.
pub fn normalize(p: str) -> str ! alloc
  requires len(p) <= 2000000002
  ensures 1 <= len(result) && len(result) <= len(p) + 1
{
  let n: i64 = len(p);
  if n == 0 {
    return ".";
  }
  let rooted: bool = p[0] == 47;
  let dir: bool = p[n - 1] == 47;
  let mut out: Vec<ref str> = vec_new::<ref str>();
  let mut st: i64 = 0;
  let mut i: i64 = 0;
  while i <= n
    invariant 0 <= st && st <= i && i <= n + 1 && n == len(p)
    invariant st == 0 || st == n + 1 || (1 <= st && st <= n && p[st - 1] == 47)
    invariant vec_views_len::<ref str>(out, len(out)) + len(out) <= st
    invariant (dir && i >= n) ==> st >= n
    invariant dir ==> vec_views_len::<ref str>(out, len(out)) + len(out) <= n
    decreases n + 1 - i
  {
    if i == n || p[i] == 47 {
      let w: i64 = i - st;
      if w > 0 && !(w == 1 && p[st] == 46) {
        if w == 2 && p[st] == 46 && p[st + 1] == 46 {
          let m: i64 = len(out);
          let mut back: bool = false;
          if m > 0 {
            let last: ref str = vec_get::<ref str>(out, m - 1);
            back = !(len(last) == 2 && last[0] == 46 && last[1] == 46);
          }
          if back {
            vec_pop::<ref str>(inout out);
          } else if !rooted {
            vec_push::<ref str>(inout out, subview(p, st, i));
          }
        } else {
          vec_push::<ref str>(inout out, subview(p, st, i));
        }
      }
      st = i + 1;
    }
    i = i + 1;
  }
  let mut s: String = vec_join::<ref str>(out, "/");
  if len(s) == 0 && !rooted { s = string_push_char(move s, 46); }
  if dir && len(s) > 0 && string_byte(s, len(s) - 1) != 47 { s = string_push_char(move s, 47); }
  if rooted { s = string_prepend_char(move s, 47); }
  return string_into_str(move s);
}

// path.posix.join(a, b) (hand `join`): both empty => "."; one empty => normalize the other; else normalize "a/b".
pub fn join(a: str, b: str) -> str ! alloc
  requires len(a) <= 1000000000 && len(b) <= 1000000000
  ensures len(result) <= len(a) + len(b) + 2
{
  let na: i64 = len(a);
  let nb: i64 = len(b);
  if na == 0 && nb == 0 { return "."; }
  if nb == 0 { return normalize(a); }
  if na == 0 { return normalize(b); }
  let mut f: String = string_with_capacity(na + nb + 1);
  f = string_push_str(move f, a);
  f = string_push_char(move f, 47);
  f = string_push_str(move f, b);
  let full: str = string_into_str(move f);
  return normalize(full);
}

// path.posix.dirname of a str, borrowed (hand `dirname(&db)` -> `&str`, both following Node, row 4.4q-DN): "." for "",
// "/" or "//" for rooted inputs, else the prefix before the last '/' that follows a non-'/' byte. One backward scan with
// `break` and an `Option` cut, as the hand's `for i in (1..n).rev()` (no `rev` in `for`: a counting-down `while`, row
// 4.4t-RV). The cut is at a '/' byte, so it is a char boundary (no run-time test).
pub fn dirname(p: str) -> ref str from(p)
  ensures len(result) <= len(p) + 1
{
  let n: i64 = len(p);
  if n == 0 { return "."; }
  let root: bool = p[0] == 47;
  let mut end: Option<i64> = None;
  let mut matched: bool = true;
  let mut i: i64 = n - 1;
  while i >= 1
    invariant 0 <= i && i <= n - 1 && n == len(p) && end == None
    decreases i
  {
    if p[i] == 47 {
      if !matched {
        end = Some(i);
        break;
      }
    } else {
      matched = false;
    }
    i = i - 1;
  }
  match end {
    None => {
      if root { return "/"; }
      return ".";
    }
    Some(e) => {
      if root && e == 1 { return "//"; }
      return subview(p, 0, e);
    }
  }
}

// `file` starts with `parent` + '/' (just `parent` when it already ends with '/'); the prefix must be nonempty.
pub fn contained(parent: [u8], file: [u8]) -> bool
{
  let pn: i64 = len(parent);
  if pn == 0 { return false; }
  let mut extra: i64 = 1;
  if parent[pn - 1] == 47 { extra = 0; }
  if len(file) - pn < extra { return false; }
  if !eq_range(parent, 0, file, 0, pn) { return false; }
  if extra == 1 {
    if file[pn] != 47 { return false; }
  }
  return true;
}

// ---- folderKey (non-win32): drop all trailing '/' unless that empties the input ----
pub fn key_len(b: [u8]) -> i64
  ensures 0 <= result && result <= len(b)
{
  let mut n: i64 = len(b);
  while n > 0 && b[n - 1] == 47
    invariant 0 <= n && n <= len(b)
    decreases n
  {
    n = n - 1;
  }
  if n == 0 { return len(b); }
  return n;
}

pub fn folder_key(b: [u8]) -> ref [u8] from(b)
  ensures len(result) <= len(b)
{
  let k: i64 = key_len(b);
  return subview(b, 0, k);
}

pub fn same_key(a: [u8], b: [u8]) -> bool
{
  let na: i64 = key_len(a);
  let nb: i64 = key_len(b);
  if na != nb { return false; }
  return eq_range(a, 0, b, 0, na);
}

// ---- environment, data dir, DB path ----
fn key_eq(t: [u8], s: i64, l: i64, lit: str) -> bool
  requires 0 <= s && 0 <= l && l <= len(t) - s
{
  if l != len(lit) { return false; }
  let mut i: i64 = 0;
  while i < l
    invariant 0 <= i && i <= l && l == len(lit) && 0 <= s && l <= len(t) - s
    decreases l - i
  {
    let x: i64 = t[s + i];
    let y: i64 = lit[i];
    if x != y { return false; }
    i = i + 1;
  }
  return true;
}

// value of the environment pair named `name` ("" when absent; absent and empty are the same for every caller)
pub fn env_value(cfg: [i64], cfg_text: [u8], name: str) -> ref str from(cfg_text)
  requires len(cfg) >= 32 && len(cfg) <= 2147483647 && utf8_valid(cfg_text)
  ensures len(result) <= 1000000000
{
  let n: i64 = (len(cfg) - 32) / 4;
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && 4 * n <= len(cfg) - 32 && len(cfg) >= 32 && len(cfg) <= 2147483647
    decreases n - i
  {
    let b: i64 = 32 + 4 * i;
    let ks: i64 = cfg[b];
    let kl: i64 = cfg[b + 1];
    if ks >= 0 && crate::packet::ref_ok(ks, kl, len(cfg_text)) {
      if key_eq(cfg_text, ks, kl, name) { return crate::util::cfg_view(cfg_text, cfg[b + 2], cfg[b + 3]); }
    }
    i = i + 1;
  }
  return "";
}

// opencodeDataDir: trimmed XDG_DATA_HOME when nonempty and absolute (join with opencode), else <OS home>/.local/share/opencode
pub fn data_dir(cfg: [i64], cfg_text: [u8]) -> str ! alloc
  requires len(cfg) >= 32 && len(cfg) <= 2147483647 && utf8_valid(cfg_text)
  ensures len(result) <= 1000000100
{
  let xv: ref str = env_value(cfg, cfg_text, "XDG_DATA_HOME");
  let xdg: ref str = crate::text::trim(xv);
  if len(xdg) > 0 && xdg[0] == 47 { return join(xdg, "opencode"); }
  let home: ref str = crate::util::cfg_view(cfg_text, cfg[16], cfg[17]);
  return join(home, ".local/share/opencode");
}

// The database named by OPENCODE_DB (trimmed): exactly ":memory:" => none; empty => join(home, "opencode.db"); absolute => as
// given; relative => join(home, given). home = source.home (words 6,7). Read once.
pub enum DbPath { Memory, File(path: str) }

pub fn db_path(cfg: [i64], cfg_text: [u8]) -> DbPath ! alloc
  requires len(cfg) >= 32 && len(cfg) <= 2147483647 && utf8_valid(cfg_text)
{
  let gv: ref str = env_value(cfg, cfg_text, "OPENCODE_DB");
  let given: ref str = crate::text::trim(gv);
  if crate::text::same(given, ":memory:") { return DbPath::Memory; }  // MUT:M01 => if false { return DbPath::Memory; }
  let home: ref str = crate::util::cfg_view(cfg_text, cfg[6], cfg[7]);
  if len(given) == 0 { return DbPath::File(join(home, "opencode.db")); }
  if given[0] == 47 { return DbPath::File(copy(given)); }
  return DbPath::File(join(home, given));
}

// result packet for mode 3 (dataDir) or 4 (folderKey of the folder ref, words 8,9); no I/O
pub fn utility(cfg: [i64], cfg_text: [u8], mode: i64) -> [i64] ! alloc
  requires len(cfg) >= 32 && len(cfg) <= 2147483647 && (mode == 3 || mode == 4) && len(cfg_text) <= 2147483647
  ensures len(result) >= 40
{
  if mode == 3 {
    // the configuration text is checked once (hand `Config::decode`); every field read below borrows it
    if !utf8_valid(cfg_text) { return crate::packet::simple_error(3, 0, 3, 6); }
    let d: str = data_dir(cfg, cfg_text);
    // hand `data_dir(&conf).into_bytes()`: the String's buffer becomes the value bytes, no copy
    let b: [u8] = str_into_bytes(move d);
    if len(b) > 1073741823 { return crate::packet::simple_error(3, 0, 3, 5); }
    return crate::packet::ok_value(3, b);
  }
  let folder: ref [u8] = crate::util::span_view(cfg_text, cfg[8], cfg[9]);
  let k: ref [u8] = folder_key(folder);
  if len(k) > 1073741823 { return crate::packet::simple_error(4, 0, 3, 5); }
  return crate::packet::ok_value(4, k);
}

// ---- step helpers shared by admit, sql and list ----
// Issue ONE request (id ctl[3]); `args` is the step word pool (its first argn words are the request arguments, the rest may be
// literal patch words), `bytes` the byte pool, `patches` apply before the request.
pub fn ask(ctl: [i64], phase: i64, opcode: i64, stage: i64, flags: i64, handle: i64,
           patches: [i64], args: [i64], argn: i64, bytes: [u8]) -> [i64] ! alloc
  requires len(ctl) == 64 && 1 <= ctl[3] && ctl[3] <= 1000000000
  requires 0 <= phase && phase <= 998 && 1 <= opcode && opcode <= 15 && 0 <= stage && stage <= 28 && 0 <= flags && -1 <= handle
  requires len(patches) <= 4096 && len(args) <= 2147483647 && 0 <= argn && argn <= len(args) && len(bytes) <= 2147483647
  ensures len(result) >= 76
{
  if ctl[3] >= 1000000000 { return crate::packet::done_internal(ctl, 28); }
  let id: i64 = ctl[3];
  let c: [i64] = crate::packet::ctl_await(ctl, phase, opcode);
  let req: [i64] = crate::packet::request(id, opcode, stage, flags, handle, 0, 0, 0, 0, argn);
  let ep: [i64] = alloc(0, 0);
  return crate::packet::step_packet(c, patches, req, args, bytes, ep, 0);
}

// Continue packet at `phase` (nothing pending); the phase must differ from the incoming one so root sees progress.
pub fn proceed(ctl: [i64], phase: i64, patches: [i64]) -> [i64] ! alloc
  requires len(ctl) == 64 && 0 <= phase && phase <= 998 && len(patches) <= 4096
  ensures len(result) >= 76
{
  let c: [i64] = crate::packet::ctl_next(ctl, phase);
  let ep: [i64] = alloc(0, 0);
  let eb: [u8] = alloc(0, 0);
  return crate::packet::step_packet(c, patches, ep, ep, eb, ep, 2);
}

// patches: resize bank to cur+count, then copy `count` elements to offset cur from source src at src_off
pub fn append_patch(bank: i64, cur: i64, count: i64, src: i64, src_off: i64) -> [i64] ! alloc
  requires 0 <= bank && bank <= 5 && 0 <= cur && 0 <= count && cur <= 2147483647 - count && 1 <= src && src <= 4 && 0 <= src_off
  ensures len(result) == 16
{
  let r: [i64] = crate::packet::patch_resize(bank, cur + count);
  let cp: [i64] = crate::packet::patch_copy(bank, cur, count, src, src_off);
  return crate::packet::cat_words(r, cp);
}

// a successful completion of `opcode` with exactly `nwords` payload words
pub fn ok_event(event: [i64], opcode: i64, nwords: i64) -> bool
  requires len(event) >= 16 && 0 <= nwords && nwords <= 1000000000
  ensures result ==> (len(event) == 16 + nwords && event[2] == opcode && event[3] == 0 && event[6] == nwords)
{
  return event[2] == opcode && event[3] == 0 && event[6] == nwords && len(event) - 16 == nwords;
}

// bank 2 holds 7*n row words followed by n count words
pub fn rows_ok(rows: [i64], n: i64) -> bool
  ensures result ==> (0 <= n && n <= 134217727 && 8 * n <= len(rows))
{
  return 0 <= n && n <= 134217727 && 8 * n <= len(rows);
}

// read-failed result for a failed DB completion (class 4 => InputTooLarge, class 5 => InternalInvariant); raw code and native kept
pub fn db_error(ctl: [i64], stage: i64, event: [i64], completion: [u8]) -> [i64] ! alloc
  requires len(ctl) == 64 && len(event) >= 16 && 0 <= stage && stage <= 28
  ensures len(result) >= 40
{
  let mode: i64 = ctl[1];
  let raw0: [u8] = alloc(0, 0);
  let cls: i64 = event[4];
  if cls == 4 { return crate::packet::error(mode, stage, 3, 5, 0, raw0, "", ""); }
  if cls == 5 { return crate::packet::error(mode, stage, 3, 6, 0, raw0, "", ""); }
  let mut native: i64 = event[5];
  if native < 0 { native = 0; }
  let raw: [u8] = crate::util::span_bytes(completion, event[8], event[9]);
  return crate::packet::error(mode, stage, 1, 2, native, raw, "", "");
}

// error results without a completion: InternalInvariant / InputTooLarge / read-failed detail `columns`, at `stage`
pub fn internal_at(ctl: [i64], stage: i64) -> [i64] ! alloc
  requires len(ctl) == 64
  ensures len(result) >= 40
{
  let raw0: [u8] = alloc(0, 0);
  return crate::packet::error(ctl[1], stage, 3, 6, 0, raw0, "", "");
}

pub fn toobig_at(ctl: [i64], stage: i64) -> [i64] ! alloc
  requires len(ctl) == 64
  ensures len(result) >= 40
{
  let raw0: [u8] = alloc(0, 0);
  return crate::packet::error(ctl[1], stage, 3, 5, 0, raw0, "", "");
}

pub fn columns_at(ctl: [i64], stage: i64) -> [i64] ! alloc
  requires len(ctl) == 64
  ensures len(result) >= 40
{
  let raw0: [u8] = alloc(0, 0);
  return crate::packet::error(ctl[1], stage, 1, 2, 0, raw0, "", "columns");
}

// DB failure: save the error result in bank 5 (ctl[38] = 1) and close the connection (phase 390 consumes the close); no
// connection => finish at once.
pub fn fail_with(ctl: [i64], err: [i64]) -> [i64] ! alloc
  requires len(ctl) == 64 && 1 <= ctl[3] && ctl[3] <= 1000000000 && len(err) >= 40
  ensures len(result) >= 76
{
  if len(err) > 100000000 || ctl[8] < 0 || ctl[3] >= 1000000000 { return crate::packet::done_wrap(ctl, err); }
  let n: i64 = len(err);
  let pr: [i64] = crate::packet::patch_resize(5, n);
  let pc: [i64] = crate::packet::patch_copy(5, 0, n, 3, 0);
  let patches: [i64] = crate::packet::cat_words(pr, pc);
  let mut c: [i64] = copy(ctl);
  c[38] = 1;
  let eb: [u8] = alloc(0, 0);
  return ask(c, 390, 5, 10, 0, ctl[8], patches, err, 0, eb);
}
