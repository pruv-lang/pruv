// OpenCode row module (package B): follows DESIGN.md/IMPL_NOTES.md; written without a shell (not compiled).
// decode(queryWords, queryBytes): the select result payload (banks 0/1: [C=4, R, 8 column-ref words, R*16 typed values]) becomes
// validated seven-word rows [idStart, idLen, dirStart, dirLen, titleStart, titleLen, updatedMs] (refs into the text bank, where the
// returned pool of id ++ directory ++ cleaned title per kept row, in SQL order, is appended), plus updated_number (P9), clean_title, db_iso (with the extended
// years of JS TimeClip). Nothing here sorts, caps or backfills rows.

pub struct Decoded { status: i64, count: i64, rows: [i64], pool: [u8] }

fn bad(status: i64) -> Decoded ! alloc
  ensures result.status == status && result.count == 0 && len(result.rows) == 0 && len(result.pool) == 0
{
  let er: [i64] = alloc(0, 0);
  let eb: [u8] = alloc(0, 0);
  return Decoded { status: status, count: 0, rows: move er, pool: move eb };
}

fn alnum(x: i64) -> bool
{
  return (48 <= x && x <= 57) || (65 <= x && x <= 90) || (97 <= x && x <= 122);
}

// /^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/ on the bytes t[s..s+l]
pub fn valid_id(t: [u8], s: i64, l: i64) -> bool
  ensures result ==> (0 <= s && 1 <= l && l <= 128 && l <= len(t) - s)
{
  if !crate::packet::ref_ok(s, l, len(t)) || s < 0 || l < 1 || l > 128 { return false; }
  let c0: i64 = t[s];
  if !alnum(c0) { return false; }
  let mut i: i64 = 1;
  while i < l
    invariant 1 <= i && i <= l && l <= 128 && 0 <= s && l <= len(t) - s
    decreases l - i
  {
    let x: i64 = t[s + i];
    if !(alnum(x) || x == 95 || x == 45) { return false; }
    i = i + 1;
  }
  return true;
}

fn has_prefix(s: str, lit: str) -> bool
{
  if len(lit) > len(s) { return false; }
  let mut k: i64 = 0;
  while k < len(lit)
    invariant 0 <= k && k <= len(lit) && len(lit) <= len(s)
    decreases len(lit) - k
  {
    let x: i64 = s[k];
    let y: i64 = lit[k];
    if x != y { return false; }
    k = k + 1;
  }
  return true;
}

// cleanTitle: only a TEXT value counts; empty, or a raw start "New session - " / "Child session - " (tested before trimming),
// gives ""; otherwise whitespace collapsed, trimmed, cut to 120 UTF-16 units (P2: a split astral scalar is dropped).
// The cell is read as a borrowed str of qb[a..a+b] (hand `cell_text`); bytes that are not UTF-8 give "".
pub fn clean_title(kind: i64, a: i64, b: i64, qb: [u8]) -> str ! alloc
  requires len(qb) <= 2147483647
  ensures len(result) <= len(qb)
{
  let empty: str = "";
  if kind != 3 { return copy(empty); }
  if !crate::packet::ref_ok(a, b, len(qb)) || a < 0 { return copy(empty); }
  let v: ref [u8] = subview(qb, a, a + b);
  if !utf8_valid(v) { return copy(empty); }
  if b < 1 { return copy(empty); }
  if has_prefix(subview(qb, a, a + b), "New session - ") { return copy(empty); }
  if has_prefix(subview(qb, a, a + b), "Child session - ") { return copy(empty); }
  return crate::text::one_line(subview(qb, a, a + b), 120);
}

// trimmed [+-]?[0-9]+ within +-(2^53-1) (checked accumulation); blank, other text, or beyond the range => 0 (P9)
fn text_number(s: str) -> i64
  ensures -9007199254740991 <= result && result <= 9007199254740991
{
  let sp: crate::text::Span = crate::text::trim_span(s);
  let hi: i64 = sp.hi;
  let mut i: i64 = sp.lo;
  if i >= hi { return 0; }
  let mut neg: bool = false;
  let c0: i64 = s[i];
  if c0 == 43 {
    i = i + 1;
  } else if c0 == 45 {
    neg = true;
    i = i + 1;
  }
  if i >= hi { return 0; }
  let mut v: i64 = 0;
  while i < hi
    invariant 0 <= i && i <= hi && hi <= len(s) && 0 <= v && v <= 9007199254740991
    decreases hi - i
  {
    let c: i64 = s[i];
    if c < 48 || c > 57 { return 0; }
    let d: i64 = c - 48;
    if v > (9007199254740991 - d) / 10 { return 0; }
    v = v * 10 + d;
    i = i + 1;
  }
  if neg { return 0 - v; }
  return v;
}

// P9 for the `updated` cell [kind, a, b]: safe INTEGER; finite integral REAL within the safe range (limbs a=high32, b=low32);
// trimmed integer TEXT (a,b = start,len in qb); NULL, BLOB, fractions, exponents, hex, anything else => 0.
pub fn updated_number(kind: i64, a: i64, b: i64, qb: [u8]) -> i64 ! alloc
  ensures -9007199254740991 <= result && result <= 9007199254740991
{
  if kind == 1 {
    if a < -9007199254740991 || a > 9007199254740991 { return 0; }
    return a;
  }
  if kind == 2 {
    if !crate::util::limbs_ok(a, b) { return 0; }
    if !crate::util::real_is_safe_integer(a, b) { return 0; }
    return crate::util::real_to_integer(a, b);
  }
  if kind == 3 {
    if !crate::packet::ref_ok(a, b, len(qb)) || a < 0 { return 0; }
    let v: ref [u8] = subview(qb, a, a + b);
    if !utf8_valid(v) { return 0; }
    return text_number(subview(qb, a, a + b));
  }
  return 0;
}

// "+YYYYYY-MM-DDTHH:mm:ss.sssZ" for 253402300800000 <= ms <= 8640000000000000 (years 10000..275760); empty only if the
// calendar arithmetic left its guarded ranges.
fn format_ext(ms: i64) -> [u8] ! alloc
  requires 253402300800000 <= ms && ms <= 8640000000000000
  ensures len(result) == 0 || len(result) == 27
{
  let c: crate::time::Civil = crate::time::civil(ms);
  let y: i64 = c.year;
  let m: i64 = c.month;
  let d: i64 = c.day;
  let rem: i64 = c.rem;
  let h: i64 = rem / 3600000;
  let mi: i64 = (rem / 60000) % 60;
  let sec: i64 = (rem / 1000) % 60;
  let f: i64 = rem % 1000;
  if y < 10000 || y > 275760 || m < 1 || m > 12 || d < 1 || d > 31 || rem < 0 || h < 0 || h > 23 {
    let none: [u8] = alloc(0, 0);
    return none;
  }
  let mut out: [u8] = alloc(0, 0);
  arr_reserve(inout out, 27);
  arr_push(inout out, 43);
  arr_push(inout out, 48 + (y / 100000) % 10);
  arr_push(inout out, 48 + (y / 10000) % 10);
  arr_push(inout out, 48 + (y / 1000) % 10);
  arr_push(inout out, 48 + (y / 100) % 10);
  arr_push(inout out, 48 + (y / 10) % 10);
  arr_push(inout out, 48 + y % 10);
  arr_push(inout out, 45);
  arr_push(inout out, 48 + (m / 10) % 10);
  arr_push(inout out, 48 + m % 10);
  arr_push(inout out, 45);
  arr_push(inout out, 48 + (d / 10) % 10);
  arr_push(inout out, 48 + d % 10);
  arr_push(inout out, 84);
  arr_push(inout out, 48 + (h / 10) % 10);
  arr_push(inout out, 48 + h % 10);
  arr_push(inout out, 58);
  arr_push(inout out, 48 + (mi / 10) % 10);
  arr_push(inout out, 48 + mi % 10);
  arr_push(inout out, 58);
  arr_push(inout out, 48 + (sec / 10) % 10);
  arr_push(inout out, 48 + sec % 10);
  arr_push(inout out, 46);
  arr_push(inout out, 48 + (f / 100) % 10);
  arr_push(inout out, 48 + (f / 10) % 10);
  arr_push(inout out, 48 + f % 10);
  arr_push(inout out, 90);
  return out;
}

// isoOf(v) for a positive updated value: seconds below 1e11, else milliseconds. The 24-byte text for years 0000..9999 (shared
// time package), the 27-byte signed six-digit-year text up to the TimeClip limit 8640000000000000, else empty (absent).
pub fn db_iso(v: i64) -> [u8] ! alloc
  requires -9007199254740991 <= v && v <= 9007199254740991
  ensures len(result) == 0 || len(result) == 24 || len(result) == 27
{
  let empty: [u8] = alloc(0, 0);
  if v <= 0 { return empty; }
  let t: i64 = crate::time::integer_time(v);
  if t != crate::time::time_none() { return crate::time::format_iso(t); }
  if v < 253402300800000 || v > 8640000000000000 { return empty; }
  return format_ext(v);
}

// status 0 ok; 1 malformed payload (not 4 columns, bad length); 2 pool over 1e9 bytes. A row is kept when id is a TEXT thread name and
// directory a nonempty TEXT; every other row is dropped (it keeps its place in SQLite's limit but not in the output). The three
// ref starts of a row are offsets in the text bank the pool is appended to (`base` is its current length).
pub fn decode(query_words: [i64], query_bytes: [u8], base: i64) -> Decoded ! alloc
  requires len(query_words) <= 2147483647 && len(query_bytes) <= 2147483647 && 0 <= base && base <= 2147483647
  ensures result.status == 0 ==> (0 <= result.count && len(result.rows) == 7 * result.count)
  ensures result.status != 0 ==> (result.count == 0 && len(result.rows) == 0 && len(result.pool) == 0)
{
  let nw: i64 = len(query_words);
  if nw < 10 { return bad(1); }
  let cc: i64 = query_words[0];
  let nr: i64 = query_words[1];
  if cc != 4 || nr < 0 || nr > 100000000 { return bad(1); }
  if nw != 10 + 16 * nr { return bad(1); }
  let nq: i64 = len(query_bytes);
  let mut rows: [i64] = alloc(0, 0);
  let mut pool: [u8] = alloc(0, 0);
  let mut cnt: i64 = 0;
  let mut i: i64 = 0;
  while i < nr
    invariant 0 <= i && i <= nr && nr <= 100000000 && nw == 10 + 16 * nr && nw == len(query_words) && nq == len(query_bytes)
    invariant 0 <= cnt && cnt <= i && len(rows) == 7 * cnt && len(pool) <= 1000000000
    decreases nr - i
  {
    let b: i64 = 10 + 16 * i;
    let kid: i64 = query_words[b];
    let ia: i64 = query_words[b + 1];
    let il: i64 = query_words[b + 2];
    let kdir: i64 = query_words[b + 4];
    let da: i64 = query_words[b + 5];
    let dl: i64 = query_words[b + 6];
    if kid == 3 && kdir == 3 && valid_id(query_bytes, ia, il) && crate::packet::ref_ok(da, dl, nq) && da >= 0 && dl >= 1 {
      let title: str = clean_title(query_words[b + 8], query_words[b + 9], query_words[b + 10], query_bytes);
      let tn: i64 = len(title);
      if il + dl + tn > 1000000000 - len(pool) { return bad(2); }
      let at: i64 = base + len(pool);
      arr_append(inout pool, query_bytes, ia, il);
      arr_append(inout pool, query_bytes, da, dl);
      arr_append(inout pool, title, 0, tn);
      arr_push(inout rows, at);
      arr_push(inout rows, il);
      arr_push(inout rows, at + il);
      arr_push(inout rows, dl);
      arr_push(inout rows, at + il + dl);
      arr_push(inout rows, tn);
      arr_push(inout rows, updated_number(query_words[b + 12], query_words[b + 13], query_words[b + 14], query_bytes));
      cnt = cnt + 1;
    }
    i = i + 1;
  }
  return Decoded { status: 0, count: cnt, rows: move rows, pool: move pool };
}
