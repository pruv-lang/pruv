[
  {"name": "F08-spawn-throw", "policies": ["P7"],
   "schedule": {"rules": [{"match": {"op": "spawn", "path": "$BIN/exporter"}, "error": {"class": "OS", "code": "EAGAIN"}}]},
   "expected": {"status": "error", "class": "EngineImportError", "code": "engine-missing", "stage": "spawn"}},
  {"name": "F08-child-error", "policies": ["P7"], "binary": "/nonexistent/opencode-q",
   "expected": {"status": "error", "class": "EngineImportError", "code": "engine-missing", "stage": "wait"}},
  {"name": "F08-exit-zero", "policies": ["P7"], "export": {"expect": {"cwd": "$SRC"}, "mode": "output", "exit": 0, "bytes": {"json": {"messages": []}}},
   "expected": {"status": "ok", "rowCount": 0}},
  {"name": "F08-exit-nonzero", "policies": ["P7"], "export": {"expect": {"cwd": "$SRC"}, "mode": "output", "exit": 3, "bytes": {"json": {"messages": []}}},
   "expected": {"status": "error", "class": "EngineImportError", "code": "read-failed", "stage": "wait"}},
  {"name": "F08-exit-signal", "policies": ["P7"], "export": {"expect": {"cwd": "$SRC"}, "mode": "signal", "signal": 15, "bytes": {"json": {"messages": []}}},
   "expected": {"status": "error", "class": "EngineImportError", "code": "read-failed", "stage": "wait"}},
  {"name": "F08-hang", "policies": ["P7"], "rpcMs": 1000, "serial": true,
   "export": {"expect": {"cwd": "$SRC"}, "mode": "hang", "write": false, "term": "exit", "termExit": 143, "bytes": {"json": {"messages": []}}},
   "expected": {"status": "error", "class": "EngineImportError", "code": "timeout", "stage": "wait"}},
  {"name": "F08-term-exit", "policies": ["P7"], "rpcMs": 1000, "serial": true,
   "export": {"expect": {"cwd": "$SRC"}, "mode": "hang", "term": "exit", "termExit": 0, "bytes": {"json": {"messages": []}}},
   "expected": {"status": "error", "class": "EngineImportError", "code": "timeout", "stage": "wait"}},
  {"name": "F08-kill-required", "policies": ["P7"], "rpcMs": 1000, "serial": true,
   "export": {"expect": {"cwd": "$SRC"}, "mode": "hang", "term": "ignore", "bytes": {"json": {"messages": []}}},
   "expected": {"status": "error", "class": "EngineImportError", "code": "timeout", "stage": "wait"}},
  {"name": "F08-give-up-script", "policies": ["P7"], "rpcMs": 1000, "serial": true,
   "export": {"expect": {"cwd": "$SRC"}, "mode": "hang", "term": "ignore", "bytes": {"json": {"messages": []}}},
   "schedule": {"rules": [
     {"match": {"op": "kill", "path": "$BIN/exporter", "occurrence": 1}, "error": {"class": "OS", "code": "EPERM"}},
     {"match": {"op": "kill", "path": "$BIN/exporter", "occurrence": 2}, "error": {"class": "OS", "code": "EPERM"}}]},
   "expected": {"status": "error", "class": "EngineImportError", "code": "timeout", "stage": "wait"}},
  {"name": "F08-error-after-timeout-script", "policies": ["P7"], "rpcMs": 300, "serial": true, "scripted": true,
   "disabled": "unreachable with a real child on POSIX: the pinned waitExport signals with process.kill(-pid), which throws synchronously and is caught, so a ChildProcess error event after spawn never arrives; both harnesses refuse observe rules (a scripted child facade is a later bundle). Expected when scripted: engine-missing at wait, even though a timeout was recorded",
   "export": {"expect": {"cwd": "$SRC"}, "mode": "hang", "term": "ignore", "bytes": {"json": {"messages": []}}},
   "expected": {"status": "error", "class": "EngineImportError", "code": "engine-missing", "stage": "wait"}},
  {"name": "F08-close-overrides-timeout", "policies": ["P7"], "rpcMs": 1000, "serial": true,
   "export": {"expect": {"cwd": "$SRC"}, "mode": "hang", "term": "exit", "termExit": 0,
              "bytes": {"json": {"messages": [{"info": {"role": "user"}, "parts": [{"type": "text", "text": "written before the hang"}]}]}}},
   "schedule": {"rules": [{"match": {"op": "close", "path": "$TMP/opencode-@1/export.json"}, "error": {"class": "OS", "code": "EIO"}}]},
   "expected": {"status": "error", "class": "RawOsError", "stage": "output-close"}},
  {"name": "F08-stat-error", "policies": ["P13"],
   "schedule": {"rules": [{"match": {"op": "stat", "path": "$TMP/opencode-@1/export.json"}, "error": {"class": "OS", "code": "EIO"}}]},
   "expected": {"status": "error", "class": "RawOsError", "stage": "output-stat"}},
  {"name": "F08-read-error", "policies": ["P13"],
   "schedule": {"rules": [{"match": {"op": "read", "path": "$TMP/opencode-@1/export.json"}, "error": {"class": "OS", "code": "EIO"}}]},
   "expected": {"status": "error", "class": "RawOsError", "stage": "output-read"}},
  {"name": "F08-rm-error", "policies": ["P13"],
   "schedule": {"rules": [{"match": {"op": "rm", "path": "$TMP/opencode-@1"}, "error": {"class": "OS", "code": "EACCES"}}]},
   "expected": {"status": "ok", "rowCount": 0}},
  {"name": "F08-mkdtemp-error",
   "schedule": {"rules": [{"match": {"op": "mkdtemp", "path": "$TMP/opencode-"}, "error": {"class": "OS", "code": "EACCES"}}]},
   "expected": {"status": "error", "class": "RawOsError", "stage": "temp-create"}},
  {"name": "F08-open-error",
   "schedule": {"rules": [{"match": {"op": "open", "path": "$TMP/opencode-@1/export.json"}, "error": {"class": "OS", "code": "EACCES"}}]},
   "expected": {"status": "error", "class": "RawOsError", "stage": "output-open"}},
  {"name": "F08-missing-temp-root", "tempRoot": "$TMP/not-there",
   "expected": {"status": "error", "class": "RawOsError", "stage": "temp-create"}},
  {"name": "F08-nul-temp-root", "tempRoot": "$TMP/t\u0000x",
   "expected": {"status": "error", "class": "OtherError", "stage": "temp-create"}},
  {"name": "F08-output-close-error", "policies": ["P13"],
   "schedule": {"rules": [{"match": {"op": "close", "path": "$TMP/opencode-@1/export.json"}, "error": {"class": "OS", "code": "EIO"}}]},
   "expected": {"status": "error", "class": "RawOsError", "stage": "output-close"}},
  {"name": "F08-real-20000ms", "policies": ["P7"], "slow": true, "serial": true, "rpcMs": 20000, "watchdog": 120,
   "export": {"expect": {"cwd": "$SRC"}, "mode": "hang", "term": "exit", "termExit": 0, "bytes": {"json": {"messages": []}}},
   "expected": {"status": "error", "class": "EngineImportError", "code": "timeout", "stage": "wait"}}
]
