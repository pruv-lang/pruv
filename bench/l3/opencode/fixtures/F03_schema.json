  {"name": "F03-corrupt", "mode": "rows", "db": {},
   "tree": [{"path": "$TMP", "kind": "dir", "mode": 448}, {"path": "$SRC/opencode.db", "kind": "file", "bytes": {"repeat": {"utf8": "garbage-not-sqlite\n"}, "count": 300}}],
