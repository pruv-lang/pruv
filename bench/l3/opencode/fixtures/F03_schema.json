   "expected": {"status": "error", "class": "EngineImportError", "code": "read-failed", "stage": "schema-session"}},
  {"name": "F03-unsafe-integer", "mode": "rows",
   "db": {"path": "$SRC/opencode.db",
          "ddl": ["CREATE TABLE session(id,parent_id,directory,title,time_updated)", "CREATE TABLE message(session_id)"],
          "inserts": [
            {"table": "session", "columns": ["id", "parent_id", "directory", "title", "time_updated"],
             "rows": [[{"kind": "text", "text": "S0000"}, {"kind": "null"}, {"kind": "text", "text": "/work"}, {"kind": "text", "text": "T"}, {"kind": "integer", "decimal": "9007199254740992"}]]},
            {"table": "message", "columns": ["session_id"], "rows": [[{"kind": "text", "text": "S0000"}]]}]},
   "expected": {"status": "error", "class": "EngineImportError", "code": "read-failed", "stage": "select"}},
  {"name": "F03-wal-visible", "mode": "rows",
