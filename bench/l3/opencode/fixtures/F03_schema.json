          "ddl": ["CREATE TABLE session(id,parent_id,directory,title,time_updated)", "CREATE TABLE message(session_id)"],
          "inserts": [
            {"table": "session", "columns": ["id", "parent_id", "directory", "title", "time_updated"],
             "rows": [[{"kind": "text", "text": "S0000"}, {"kind": "null"}, {"kind": "text", "text": "/work"}, {"kind": "text", "text": "T"}, {"kind": "integer", "decimal": "1700000000000"}]]},
            {"table": "message", "columns": ["session_id"], "rows": [[{"kind": "text", "text": "S0000"}]]}]},
   "expected": {"status": "ok", "rowCount": 1}},

