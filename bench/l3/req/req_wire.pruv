pub fn key(i: i64) -> [i64] ! alloc
  ensures len(result) >= 0
{
  if i == 0 { return crate::ent_u16::lit("wireWork.engineImport.timeout"); }
  if i == 1 { return crate::ent_u16::lit("wireWork.engineImport.notFound"); }
  if i == 2 { return crate::ent_u16::lit("wireWork.engineImport.codexUnsupported"); }
  if i == 3 { return crate::ent_u16::lit("wireWork.engineImport.grokExists"); }
  if i == 4 { return crate::ent_u16::lit("wireWork.engineImport.grokLoadFailed"); }
  if i == 5 { return crate::ent_u16::lit("wireWork.engineImport.engineMissing"); }
  if i == 6 { return crate::ent_u16::lit("wireWork.engineImport.readFailed"); }
  if i == 7 { return crate::ent_u16::lit("wireWork.engineImport.sameRefused"); }
  if i == 8 { return crate::ent_u16::lit("wireWork.engineImport.sameByAi"); }
  if i == 9 { return crate::ent_u16::lit("wireWork.engineImport.accountUnknown"); }
  if i == 10 { return crate::ent_u16::lit("wireWork.engineImport.busy"); }
  return crate::ent_u16::empty();
}

// the done pool of wire error i: key then message
pub fn pool(i: i64) -> [i64] ! alloc
  ensures len(result) >= 0
{
  return crate::ent_u16::cat(key(i), msg(i));
}

// the done record: [2, key slot at 1, message slot at 4]
pub fn rec(i: i64) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let kl: i64 = len(key(i));
  let mut r: [i64] = crate::ent_u16::zeros(7);
  crate::ent_u16::wr(inout r, 0, 2);
  crate::req_value::put(inout r, 1, 6, 0, kl);
  crate::req_value::put(inout r, 4, 6, kl, len(msg(i)));
  return r;
}
