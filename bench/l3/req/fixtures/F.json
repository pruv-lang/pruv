[
 {
  "id": "F01",
  "name": "folder-normalized",
  "rule": "3.2",
  "world": {
   "readers": {
    "claude": {
     "list": [
      {
       "ok": []
      }
     ]
    }
   },
   "checkFolder": {
    "/p/./x": {
     "ok": "/p/x"
    }
   }
  },
  "script": [
   {
    "ev": "start",
    "req": "r1",
    "op": "list",
    "input": {
     "source": "claude:home",
     "folder": "/p/./x"
    }
   }
  ],
  "expect": {
   "req": {
    "r1": {
     "terminal": "ok",
     "value": {
      "items": []
     }
    }
   },
   "counts": {
    "checkFolder": 1
   },
   "has": [
    {
     "c": "checkFolder",
     "a": [
      "/p/./x"
     ],
     "o": {
      "ok": "/p/x"
     }
    },
    {
     "c": "reader",
     "a": {
      "op": "list",
      "folder": "/p/x"
     }
    }
   ]
  }
 },
