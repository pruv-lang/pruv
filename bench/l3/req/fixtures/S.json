 {
  "id": "S06",
  "name": "source-throw",
  "rule": "3.1",
  "world": {
   "accounts": {
    "claude": {
     "throw": {
      "class": "Error",
      "ref": "e1",
      "message": "accounts down"
     }
    }
   },
   "errs": [
    {
     "class": "Error",
     "ref": "e1",
     "message": "accounts down"
    }
   ]
  },
  "script": [
   {
    "ev": "start",
    "req": "r1",
    "op": "list",
    "input": {
     "source": "claude:home",
     "folder": "/proj"
    }
   },
   {
    "ev": "start",
    "req": "r2",
    "op": "open",
    "input": {
     "source": "claude:home",
     "folder": "/proj",
     "thread": "t1",
     "mode": "fork"
    }
   }
  ],
  "expect": {
   "req": {
    "r1": {
     "terminal": "thrown",
     "ref": "e1"
    },
    "r2": {
     "terminal": "thrown",
     "ref": "e1"
    }
   },
   "counts": {
    "checkFolder": 0,
    "reader": 0,
    "timer.set": 0,
    "sessionList": 0,
    "opening.add": 0
   }
  }
 },
 {
  "id": "S07",
  "name": "no-home-leak",
  "rule": "3.1",
  "world": {
   "env": {
    "CLAUDE_CONFIG_DIR": "/secret/claude",
    "GROK_HOME": "/secret/grok"
   },
   "accounts": {
    "claude": {
     "ok": [
      {
       "id": "acc_0123456789abcdef",
       "name": "W"
      }
     ]
    }
   }
  },
  "script": [
   {
    "ev": "start",
    "req": "r1",
    "op": "sources"
   }
  ],
  "expect": {
   "req": {
    "r1": {
     "terminal": "ok",
     "keys": [
      "sources"
     ],
     "notContains": [
      "\"home\"",
      "\"kind\"",
      "\"accountName\"",
      "/secret",
      "engine-homes"
     ]
    }
   }
  }
 },
 {
  "id": "S08",
  "name": "fresh-per-request",
  "rule": "3.1",
  "note": "world.accounts is not a queue: freshness per request is visible only through the three accounts calls per engine.",
  "world": {
   "accounts": {
    "claude": {
     "ok": [
      {
       "id": "acc_0123456789abcdef",
       "name": "W"
      }
     ]
    }
   }
  },
  "script": [
   {
    "ev": "start",
    "req": "r1",
    "op": "sources"
   },
   {
    "ev": "start",
    "req": "r2",
    "op": "sources"
   },
   {
    "ev": "start",
    "req": "r3",
    "op": "sources"
   }
  ],
  "expect": {
   "req": {
    "r1": {
     "terminal": "ok"
    },
    "r2": {
     "terminal": "ok"
    },
    "r3": {
     "terminal": "ok"
    }
   },
   "matchCounts": [
    [
     {
      "c": "prim",
      "a": [
       "accounts",
       "claude"
      ]
     },
     3
    ],
    [
     {
      "c": "prim",
      "a": [
       "accounts",
       "codex"
      ]
     },
     3
    ]
   ]
  }
 },
