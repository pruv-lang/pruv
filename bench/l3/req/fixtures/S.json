 {
  "id": "S04",
  "name": "duplicate-source-first",
  "rule": "3.1",
  "note": "Duplicates are kept in order; list/open take the first match (the first account name is not observable through list/open).",
  "world": {
   "accounts": {
    "claude": {
     "ok": [
      {
       "id": "acc_0123456789abcdef",
       "name": "First"
      },
      {
       "id": "acc_0123456789abcdef",
       "name": "Second"
      }
     ]
    }
   }
  },
  "script": [
   {
    "ev": "start",
    "req": "r1",
    "op": "sources"
   }
  ],
  "expect": {
   "req": {
    "r1": {
     "terminal": "ok",
     "value": {
      "sources": [
       {
        "source": "claude:home",
        "engine": "claude",
        "label": ""
       },
       {
        "source": "claude:acc_0123456789abcdef",
        "engine": "claude",
        "account": "acc_0123456789abcdef",
        "label": "First"
       },
       {
        "source": "claude:acc_0123456789abcdef",
        "engine": "claude",
        "account": "acc_0123456789abcdef",
        "label": "Second"
       },
       {
        "source": "codex:home",
        "engine": "codex",
        "label": ""
       },
       {
        "source": "grok:home",
        "engine": "grok",
        "label": ""
       },
       {
        "source": "opencode:home",
        "engine": "opencode",
        "label": ""
       },
       {
        "source": "qwen:home",
        "engine": "qwen",
        "label": ""
       }
      ]
     }
    }
   }
  }
 },
