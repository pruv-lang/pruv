[
 {
  "id": "U01",
  "name": "external-title",
  "rule": "3.4",
  "world": {
   "readers": {
    "claude": {
     "read": [
      {
       "ok": {
        "title": "a   b\n  c\t d",
        "turns": [
         {
          "prompt": "first prompt",
          "reply": "r1",
          "tools": 0,
          "clipped": false
         }
        ]
       }
      }
     ]
    }
   }
  },
  "script": [
   {
    "ev": "start",
    "req": "r1",
    "op": "open",
    "input": {
     "source": "claude:home",
     "folder": "/proj",
     "thread": "t1",
     "mode": "fork"
    }
   }
  ],
  "expect": {
   "req": {
    "r1": {
     "terminal": "ok",
     "value": {
      "sessionId": "new-1"
     },
     "keys": [
      "sessionId"
     ]
    }
   },
   "createdAfter": [
    {
     "title": "a b c d"
    }
   ],
   "createdMeta": [
    {
     "seed": {
      "folder": "/proj"
     }
    }
   ]
  }
 },
