// L3-9 request ABI v1 (ABI.md 3.2 done record): terminal records. tags: 1 original thrown identity V, 2 WireError (key V,
// message V), 5 core code (0 InvalidPacket, 1 InputTooLarge, 2 InternalInvariant).

// Assemble the sourceUnknown record with the key followed by the non-ASCII message.
fn unknown(inout r: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let mut m: [i64] = crate::ent_u16::zeros(12);
  crate::ent_u16::wr(inout m, 0, 44256);
  crate::ent_u16::wr(inout m, 1, 47484);
  crate::ent_u16::wr(inout m, 2, 32);
  crate::ent_u16::wr(inout m, 3, 49688);
  crate::ent_u16::wr(inout m, 4, 32);
  crate::ent_u16::wr(inout m, 5, 50630);
  crate::ent_u16::wr(inout m, 6, 45716);
  crate::ent_u16::wr(inout m, 7, 32);
  crate::ent_u16::wr(inout m, 8, 52636);
  crate::ent_u16::wr(inout m, 9, 52376);
  crate::ent_u16::wr(inout m, 10, 50556);
  crate::ent_u16::wr(inout m, 11, 46);
  let mut pool: [i64] = crate::ent_value::pool_new();
  crate::ent_u16::wr(inout r, 0, 2);
  crate::ent_value::pool_put_lit(inout pool, inout r, 1, "wireWork.engineImport.sourceUnknown");
  crate::ent_value::pool_put(inout pool, inout r, 4, m);
  return pool;
}

pub fn unknown_pool() -> [i64] ! alloc
  ensures len(result) >= 0
{
  let mut r: [i64] = crate::ent_u16::zeros(7);
  return unknown(inout r);
}

pub fn unknown_rec() -> [i64] ! alloc
  ensures len(result) >= 0
{
  let mut r: [i64] = crate::ent_u16::zeros(7);
  let pool: [i64] = unknown(inout r);
  return r;
}

pub fn core_rec(code: i64) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let mut r: [i64] = crate::ent_u16::zeros(2);
  crate::ent_u16::wr(inout r, 0, 5);
  crate::ent_u16::wr(inout r, 1, code);
  return r;
}

// tag 1: the original thrown identity (an opaque ref slot copied from the child record at slot 1)
pub fn thrown_rec(cr: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let mut r: [i64] = crate::ent_u16::zeros(4);
  crate::ent_u16::wr(inout r, 0, 1);
  crate::req_value::copy_slot(inout r, 1, cr, 1);
  return r;
}

// the wire error key of a folder check failure (28 units)
pub fn folder_key() -> [i64] ! alloc
  ensures len(result) >= 0
{
  return crate::ent_u16::lit("wireWork.engineImport.folder");
}

// the default folder message (13 units, built from code units)
pub fn folder_default() -> [i64] ! alloc
  ensures len(result) >= 0
{
  let mut m: [i64] = crate::ent_u16::zeros(13);
  crate::ent_u16::wr(inout m, 0, 51060);
  crate::ent_u16::wr(inout m, 1, 32);
  crate::ent_u16::wr(inout m, 2, 54260);
  crate::ent_u16::wr(inout m, 3, 45908);
  crate::ent_u16::wr(inout m, 4, 45716);
  crate::ent_u16::wr(inout m, 5, 32);
  crate::ent_u16::wr(inout m, 6, 50424);
  crate::ent_u16::wr(inout m, 7, 32);
  crate::ent_u16::wr(inout m, 8, 49688);
  crate::ent_u16::wr(inout m, 9, 32);
  crate::ent_u16::wr(inout m, 10, 50630);
  crate::ent_u16::wr(inout m, 11, 50612);
  crate::ent_u16::wr(inout m, 12, 46);
  return m;
}

// importFailure of the reference: the host reply of call 25 holds only facts of the thrown value
// [0, isEngineImportError, name slot (string or absent), code slot (string or absent)].
// AbortError by name first, then the EngineImportError codes in order; -1 means rethrow the original.
pub fn map_wire(cpool: [i64], crec: [i64]) -> i64 ! alloc
  ensures result >= -1 && result <= 6
{
  if crate::req_value::is_str_lit(cpool, crec, 2, "AbortError") { return 0; }
  if crate::ent_u16::rd(crec, 1) != 1 { return 0 - 1; }
  if crate::req_value::is_str_lit(cpool, crec, 5, "not-found") { return 1; }
  if crate::req_value::is_str_lit(cpool, crec, 5, "codex-unsupported") { return 2; }
  if crate::req_value::is_str_lit(cpool, crec, 5, "grok-exists") { return 3; }
  if crate::req_value::is_str_lit(cpool, crec, 5, "grok-load-failed") { return 4; }
  if crate::req_value::is_str_lit(cpool, crec, 5, "timeout") { return 0; }
  if crate::req_value::is_str_lit(cpool, crec, 5, "engine-missing") { return 5; }
  if crate::req_value::is_str_lit(cpool, crec, 5, "read-failed") { return 6; }
  return 0 - 1;
}
