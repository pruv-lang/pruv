// L3-9 request ABI v1: op 1 projection of the accumulated source rows and the op 2/3 first-match lookup.
// Projection (reference: sources = rows.map(project)): {source, engine, [account if a non-empty string], label} where
// label = accountName for kind "account" (nullish becomes ""), else "". The done value is {sources: [...]}.
// Done tables (sections 6..): 6 = the root object rows, 7 = the array rows, 8+i = the object rows of source i.
// Key literals are appended to the done pool: sources 7, source 6, engine 6, account 7, label 5 (31 units).

fn has_acct(rows: [i64], p: i64) -> bool
  requires 0 <= p && p <= 1000000000
{
  return crate::ent_u16::rd(rows, p + 9) == 6 && crate::ent_u16::rd(rows, p + 11) > 0;
}

fn nrows(rows: [i64]) -> i64
  ensures 0 <= result && result <= 932067
{
  return crate::ent_u16::clamp(len(rows), 16777216) / 18;
}

// done pool: the request pool followed by the key literals
pub fn dpool(pool: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  return crate::ent_u16::cat(pool, crate::ent_u16::lit("sourcesenginesourceaccountlabel"));
}

// done record [0, V] with V = object slot over section 6
pub fn drec() -> [i64] ! alloc
  ensures len(result) >= 0
{
  let mut r: [i64] = crate::ent_u16::zeros(4);
  crate::req_value::put(inout r, 1, 8, 6, 1);
  return r;
}

pub fn tlens(rows: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let n: i64 = nrows(rows);
  let mut t: [i64] = crate::ent_u16::zeros(2 + n);
  crate::ent_u16::wr(inout t, 0, 6);
  crate::ent_u16::wr(inout t, 1, 3 * n);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n <= 932067
    decreases n - i
  {
    let mut k: i64 = 3;
    if has_acct(rows, 18 * i) { k = 4; }
    crate::ent_u16::wr(inout t, 2 + i, 6 * k);
    i = i + 1;
  }
  return t;
}

// key slot at table position at: key literal (offset within the key block, units)
fn key(inout o: [i64], at: i64, kb: i64, off: i64, n: i64) -> ()
  requires 0 <= at && at <= 1000000000 && 0 <= kb && kb <= 1000000000 && 0 <= off && off <= 1000 && 0 <= n && n <= 1000
  ensures len(o) == len(old(o))
{
  crate::req_value::put(inout o, at, 6, kb + off, n);
}

pub fn tabs(pool: [i64], rows: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let n: i64 = nrows(rows);
  let tl: [i64] = tlens(rows);
  let mut total: i64 = 6 + 3 * n;
  let mut j: i64 = 0;
  while j < n
    invariant 0 <= j && j <= n && n <= 932067 && 0 <= total && total <= 6 + 3 * n + 24 * j
    decreases n - j
  {
    total = total + crate::ent_u16::clamp(crate::ent_u16::rd(tl, 2 + j), 24);
    j = j + 1;
  }
  let mut o: [i64] = crate::ent_u16::zeros(total);
  let kb: i64 = crate::ent_u16::clamp(len(pool), 1000000000);
  // table 6: key "sources" -> array over section 7
  key(inout o, 0, kb, 0, 7);
  crate::req_value::put(inout o, 3, 7, 7, n);
  // table 7: one object slot per source
  let mut at: i64 = 6 + 3 * n;
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n <= 932067 && 0 <= at && at <= 6 + 3 * n + 24 * i
    decreases n - i
  {
    let p: i64 = 18 * i;
    let mut k: i64 = 3;
    if has_acct(rows, p) { k = 4; }
    crate::req_value::put(inout o, 6 + 3 * i, 8, 8 + i, k);
    let mut q: i64 = at;
    key(inout o, q, kb, 13, 6);
    crate::req_value::copy_slot(inout o, q + 3, rows, p);
    q = q + 6;
    key(inout o, q, kb, 7, 6);
    crate::req_value::copy_slot(inout o, q + 3, rows, p + 3);
    q = q + 6;
    if has_acct(rows, p) {
      key(inout o, q, kb, 19, 7);
      crate::req_value::copy_slot(inout o, q + 3, rows, p + 9);
      q = q + 6;
    }
    key(inout o, q, kb, 26, 5);
    if crate::req_value::is_str_lit(pool, rows, p + 6, "account") && !crate::req_value::nullish(rows, p + 12) {
      crate::req_value::copy_slot(inout o, q + 3, rows, p + 12);
    } else {
      crate::req_value::put(inout o, q + 3, 6, 0, 0);
    }
    at = at + 6 * k;
    i = i + 1;
  }
  return o;
}
