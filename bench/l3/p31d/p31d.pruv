// P31D small example: refresh borrows two sibling maps of the root state at once (R-6e-8),
// and poll returns a struct entry result holding an effect vector (R-6f-3).
pub struct Budget { limit_ms: i64, active_ms: i64 }
pub struct Clock { since_ms: i64, armed: bool }
pub struct St { sessions: HashMap<String, Budget>, clocks: HashMap<String, Clock> }
pub struct Effect { tag: i64, argument: i64 }
pub struct Reply { status: i64, effects: Vec<Effect> }

// Add the clock's elapsed time to the budget and re-arm the clock. 0 = done, 1 = unknown id.
pub fn refresh(inout st: St, sid: str, bid: str, now: i64) -> i64
{
  let mut res: i64 = 1;
  match map_get_mut::<String, Budget>(inout st.sessions, sid) {
    Some(budget) => {
      match map_get_mut::<String, Clock>(inout st.clocks, bid) {
        Some(clock) => {
          if 0 <= clock.since_ms && clock.since_ms <= now && now <= 1000000 &&
             0 <= budget.active_ms && budget.active_ms <= 1000000000000 {
            budget.active_ms = budget.active_ms + (now - clock.since_ms);
          }
          clock.since_ms = now;
          clock.armed = budget.active_ms < budget.limit_ms;
          res = 0;
        }
        None => { }
      }
    }
    None => { }
  }
  return res;
}

// Report whether session sid is over its limit; an over-limit session gets one stop effect.
pub fn poll(inout st: St, sid: str) -> Reply ! alloc
{
  let mut status: i64 = 1;
  let mut effects: Vec<Effect> = vec_new::<Effect>();
  match map_get_mut::<String, Budget>(inout st.sessions, sid) {
    Some(budget) => {
      status = 0;
      if budget.active_ms >= budget.limit_ms {
        effects = vec_push::<Effect>(move effects, Effect { tag: 1, argument: budget.active_ms });
      }
    }
    None => { }
  }
  return Reply { status: status, effects: move effects };
}
