// G10 transport: state holds status, partial length, chunk offset, exit code, chunk length.
pub fn live(l: Loop, slot: i64) -> bool
 requires ev_ok(l)
 ensures result ==> 0 <= slot && slot < ev_cap(l) && ev_kind(l,slot) == 3
{ return slot >= 0 && slot < ev_cap(l) && ev_kind(l,slot) == 3; }
pub fn send(take l: Loop, slot: i64, data: [u8]) -> Loop ! async, proc, alloc {
 if ev_ok(l) { if live(l,slot) && ev_write_open(l,slot) { return ev_proc_write(move l,slot,data); } }
 return move l;
}
pub fn close(take l: Loop, slot: i64) -> () ! async, net, proc, alloc {
 let mut q: Loop = move l;
 if ev_ok(q) { if live(q,slot) { q=ev_remove(move q,slot); } }
 let r: Result<i64> = ev_close(move q);
}
pub fn poll(take l: Loop, overall: i64, init: i64, ready: bool, inout st: [i64], wait: i64) -> Loop ! async, alloc
 requires len(st) == 5
 requires 0 <= wait && wait <= 10
 ensures len(st) == 5
 ensures st[1] == old(st)[1] && st[2] == old(st)[2] && st[3] == old(st)[3] && st[4] == old(st)[4]
{
 let mut q: Loop = move l;
 if ev_ok(q) {
 q=ev_wait(move q,wait);
 if ev_ok(q) && ev_event_kind(q) == 4 {
 if ev_event_slot(q) == overall { st[0]=-1; }
 else if ev_event_slot(q) == init && !ready { st[0]=-2; }
 }
 }
 return move q;
}
pub fn receive(take l: Loop, slot: i64, overall: i64, init: i64, ready: bool,
 inout st: [i64], inout line: [u8], inout chunk: [u8], inout tb: [i64], inout ts: [i64]) -> Loop ! async, proc, alloc
 requires len(st) == 5 && 0 <= st[1] && st[1] <= 4194304 && 0 <= st[2] && st[2] <= st[4] && 0 <= st[4] && st[4] <= 65536 && len(chunk) == 65536
 requires len(line) == 4194304
 requires len(ts) == 12 && ts[1] == 1024 && 0 <= ts[0] && ts[0] <= 2048 && len(tb) == 2050
 ensures len(st) == 5 && 0 <= st[1] && st[1] <= 4194304 && 0 <= st[2] && st[2] <= st[4] && 0 <= st[4] && st[4] <= 65536 && len(chunk) == 65536
 ensures len(line) == 4194304
 ensures len(ts) == 12 && ts[1] == 1024 && 0 <= ts[0] && ts[0] <= 2048 && len(tb) == 2050
{
 st[0]=-6;
 let mut q: Loop = poll(move l,overall,init,ready,inout st,0);
 if st[0] != -6 { return move q; }
 if !ev_ok(q) { st[0]=-5; return move q; }
 if !live(q,slot) { st[0]=-5; return move q; }
 if !ev_eof(q,slot) {
 q=ev_proc_read(move q,slot,2,65536);
 if ev_ok(q) { let err: [u8] = ev_bytes(q); crate::tail::tail_push(inout tb,inout ts,2,err); }
 }
 if st[2] == st[4] && ev_ok(q) {
 if live(q,slot) && !ev_eof(q,slot) {
 q=ev_proc_read(move q,slot,1,65536);
 if ev_ok(q) { let data: [u8] = ev_bytes(q);
 if len(data) <= 65536 {
 let mut k: i64 = 0;
 while k < len(data)
 invariant 0 <= k && k <= len(data) && len(data) <= 65536 && len(chunk) == 65536
 decreases len(data)-k
 { chunk[k]=data[k]; k=k+1; }
 st[4]=len(data); st[2]=0;
 } }
 }
 }
 let mut i: i64 = st[2];
 while i < st[4] && st[0] == -6
 invariant 0 <= i && i <= st[4] && st[4] <= 65536 && len(chunk) == 65536
 invariant len(st) == 5 && 0 <= st[1] && st[1] <= 4194304 && len(line) == 4194304
 decreases st[4]-i
 {
 let c: i64 = chunk[i]; i=i+1;
 if c == 10 { st[0]=st[1]; st[1]=0; }
 else if st[1] == 4194304 { st[0]=-3; }
 else { line[st[1]]=c; st[1]=st[1]+1; }
 }
 st[2]=i;
 if st[0] == -6 && ev_ok(q) {
 if live(q,slot) && ev_eof(q,slot) && st[2] == st[4] {
 q=ev_proc_wait(move q,slot); st[0]=-4;
 if ev_ok(q) { st[3]=ev_exit(q); }
 } else { q=poll(move q,overall,init,ready,inout st,10); }
 }
 if !ev_ok(q) { st[0]=-5; }
 return move q;
}
