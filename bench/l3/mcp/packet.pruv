// Absolute refs: UTF-16 strings; UTF-8 raw JSON and stderr.
// p grows in place (resizable inout: &mut Vec<i64> on Rust, a regrow on LLVM) and b is appended once (R-6g4-6,
// hand's extend_from_slice).
pub fn append(inout p: [i64], b: [i64]) -> () ! alloc
  requires len(p) <= 100000000 && len(b) <= 20000000
  ensures len(p) == len(old(p))+len(b)
{ arr_append(inout p,b,0,len(b)); }
// The same for bytes widened one per word (raw JSON, stderr): hand's `extend(b[s..e].iter().map(|&x| x as i64))`.
pub fn append_bytes(inout p: [i64], b: [u8], s: i64, e: i64) -> () ! alloc
  requires len(p) <= 100000000 && 0 <= s && s <= e && e <= len(b) && e-s <= 20000000
  ensures len(p) == len(old(p))+(e-s)
{ arr_append(inout p,b,s,e-s); }
// ---- Per-page tool records, line for line in the shape of perf/hand_packet.rs core_hand. ----
pub fn desc_cap() -> i64 ensures result >= 2 && result <= 65536 { return 65536; }
// Token span of a JSON string node (hand `str_span`); status 0 only for a string with an ok raw span.
pub fn str_span(d: crate::json::JsonDocument, id: i64) -> crate::access::Span
  ensures result.status == 0 ==> (0 <= result.start && result.start <= result.end && result.end <= len(d.source) && result.end <= 16777216)
{
  if crate::access::kind(d,id) != 4 { return crate::access::Span { status: -2, start: 0, end: 0 }; }
  return crate::access::raw_span(d,id);
}
// hand `hex`.
fn hex(c: i64) -> i64
  ensures 0 <= result && result <= 15
{
  if 48 <= c && c <= 57 { return c - 48; }
  if 65 <= c && c <= 70 { return c - 55; }
  if 97 <= c && c <= 102 { return c - 87; }
  return 0;
}
// hand `decode`: the string token src[s..e] (quotes included) decoded to UTF-16 units pushed onto out, the same
// units as jstr::step; stops once `limit` units were pushed (a step may overshoot by one unit).
fn decode(src: [u8], s: i64, e: i64, inout out: [i64], limit: i64) -> () ! alloc
  requires 0 <= s && s <= e && e <= len(src) && e <= 16777216
  requires len(out) <= 200000000 && 1 <= limit && limit <= 16777216
  ensures len(old(out)) <= len(out) && len(out) <= len(old(out)) + limit + 1
  ensures forall k in 0..len(old(out)): out[k] == old(out)[k]
{
  let base: i64 = len(out);
  let mut p: i64 = s; let mut stop: i64 = s;
  if e-s >= 2 { p=s+1; stop=e-1; }
  while p < stop && len(out)-base < limit
    invariant s <= p && p <= stop && stop <= e
    invariant base <= len(out) && len(out) <= base + limit + 1
    invariant forall k in 0..base: out[k] == old(out)[k]
    decreases stop-p
  {
    let c: i64 = src[p];
    if c < 128 && c != 92 { arr_push(inout out,c); p=p+1; }
    else if c == 92 && stop-p >= 2 {
      let x: i64 = src[p+1];
      if x == 117 && stop-p >= 6 {
        arr_push(inout out,4096*hex(src[p+2])+256*hex(src[p+3])+16*hex(src[p+4])+hex(src[p+5])); p=p+6;
      } else {
        let mut v: i64 = x;
        if x == 98 { v=8; } else if x == 102 { v=12; } else if x == 110 { v=10; } else if x == 114 { v=13; } else if x == 116 { v=9; }
        arr_push(inout out,v); p=p+2;
      }
    } else {
      let mut n: i64 = 1; let mut v: i64 = c;
      if 194 <= c && c <= 223 { n=2; v=c-192; } else if 224 <= c && c <= 239 { n=3; v=c-224; } else if 240 <= c && c <= 244 { n=4; v=c-240; }
      if stop-p < n { arr_push(inout out,65533); p=p+1; }
      else {
        let mut bad: bool = false; let mut k: i64 = 1;
        while k < n
          invariant 1 <= k && k <= n && n <= 4 && n <= stop-p && 0 <= v && v <= 16777215
          decreases n-k
        { let w: i64 = v*64+src[p+k]%64; if w > 16777215 { bad=true; k=n; } else { v=w; k=k+1; } }
        p=p+n;
        if bad || v > 1114111 { v=65533; }
        if n == 1 { v=c; }
        if v <= 65535 { arr_push(inout out,v); }
        else { arr_push(inout out,55296+(v-65536)/1024); arr_push(inout out,56320+(v-65536)%1024); }
      }
    }
  }
}
// hand `key_eq`: the decoded string token src[s..e] equals the ASCII key. A plain token (no backslash, no byte >= 128)
// is compared byte for byte; any other token is decoded into a temporary of capacity len(key)+1.
fn key_eq(src: [u8], s: i64, e: i64, key: [u8]) -> bool ! alloc
  requires 0 <= s && s <= e && e <= len(src) && e <= 16777216 && len(key) <= 64
{
  let mut p: i64 = s; let mut q: i64 = s;
  if e-s >= 2 { p=s+1; q=e-1; }
  let mut plain: bool = true; let mut i: i64 = p;
  while i < q
    invariant p <= i && i <= q && q <= len(src)
    decreases q-i
  { let c: i64 = src[i]; if c == 92 || c >= 128 { plain=false; i=q; } else { i=i+1; } }
  if plain {
    if q-p != len(key) { return false; }
    return eq_range(src,p,key,0,q-p);
  }
  let mut u: [i64] = alloc(0,0);
  arr_reserve(inout u,len(key)+1);
  decode(src,s,e,inout u,len(key)+1);
  if len(u) != len(key) { return false; }
  let mut k: i64 = 0;
  while k < len(u)
    invariant 0 <= k && k <= len(u) && len(u) == len(key)
    decreases len(u)-k
  { if u[k] != key[k] { return false; } k=k+1; }
  return true;
}
// hand `field`: the LAST member named key of object obj (its value id), -1 when obj is not an object or has no such
// member. The two range tests and the `next <= j` stop are the bounds and termination checks hand gets from
// indexing panics.
pub fn field(d: crate::json::JsonDocument, obj: i64, key: [u8]) -> i64 ! alloc
  requires len(key) <= 64
  ensures result == -1 || (0 <= result && result < len(d.tape)/6)
{
  if obj < 0 || obj >= len(d.tape)/6 || d.tape[6*obj] != 6 { return -1; }
  let stop: i64 = d.tape[6*obj+3];
  if stop > len(d.tape)/6 { return -1; }
  let mut j: i64 = obj+1; let mut found: i64 = -1;
  while j < stop
    invariant 0 <= obj && obj < j && stop <= len(d.tape)/6
    invariant found == -1 || (0 <= found && found < len(d.tape)/6)
    decreases stop-j
  {
    let v: i64 = j+1;
    if v >= stop { j=stop; }
    else {
      let s: i64 = d.tape[6*j+1]; let e: i64 = d.tape[6*j+2];
      if 0 <= s && s <= e && e <= len(d.source) && e <= 16777216 { if key_eq(d.source,s,e,key) { found=v; } }
      let next: i64 = d.tape[6*v+3];
      if next <= j { j=stop; } else { j=next; }
    }
  }
  return found;
}
// hand `is_unit_ok`.
fn unit_ok(u: i64) -> bool { return !(u < 32 || (127 <= u && u <= 159) || u == 8232 || u == 8233); }
// hand `put_field`: slots (slot, slot+1) get (-1, untouched) or (offset, n); decodes in place at the end of out.
fn put_field(src: [u8], sp: crate::access::Span, cap: i64, nonempty: bool, inout out: [i64], slot: i64) -> () ! alloc
  requires 0 <= slot && slot+1 < len(out) && 2 <= cap && cap <= 16000000 && len(out) <= 100100000
  requires sp.status == 0 ==> (0 <= sp.start && sp.start <= sp.end && sp.end <= len(src) && sp.end <= 16777216)
  ensures len(old(out)) <= len(out) && (len(out) == len(old(out)) || len(out) <= 100000000)
{
  out[slot] = -1;
  if sp.status != 0 { return; }
  let at: i64 = len(out);
  decode(src,sp.start,sp.end,inout out,cap+1);
  let m: i64 = len(out)-at;
  let mut n: i64 = m; if n > cap { n=cap; }
  if n > 0 && n < m && 55296 <= out[at+n-1] && out[at+n-1] <= 56319 && 56320 <= out[at+n] && out[at+n] <= 57343 { n=n-1; }
  if (!nonempty || m > 0) && at <= 100000000-n { out = truncate(out,at+n); out[slot]=at; out[slot+1]=n; }
  else { out = truncate(out,at); }
}
// p cut to its first m words (perf harness only; page leaves p at its logical end). `p = truncate(p, m)` on a local
// or a resizable inout is in place (R-6g4-3).
pub fn shorten(take p0: [i64], m: i64) -> [i64] ! alloc
  requires 0 <= m && m <= len(p0)
  ensures len(result) == m
{ let mut p: [i64] = move p0; p = truncate(p,m); return p; }
pub struct Counts { count: i64, objects: i64, end: i64 }
// One tools/list page (hand `core_hand` after its two root field lookups, which root.pruv does): every element counts
// as an object while objects < 500; an object whose name is usable is admitted while count < 500 and gets the 10 slots
// at 10+10*count:
//   0,1 name  2,3 title (nonempty)  4,5 description (cut at desc_cap)  as (offset, units), offset -1 when absent
//   6 readOnlyHint==true (1, else untouched)  7 destructiveHint (-1 absent/other, 0, 1)  8,9 raw JSON (offset, bytes)
// The packet reserves twice the array's bytes once (hand `with_capacity`), every unit is pushed, every raw JSON span is
// appended in one widening extend (R-6g4-6). Like hand, the name has no 100000000-word guard, so the packet may pass
// that bound by at most 200 words per admitted tool. Returns the new count and objects, and `end` == len(p).
pub fn page(inout p: [i64], d: crate::json::JsonDocument, tools: i64, count: i64, objects: i64) -> Counts ! alloc
  requires 5010 <= len(p) && 0 <= count && count <= 500 && 0 <= objects && objects <= 500
  requires len(p) <= 100000000 + 200*count
  ensures 5010 <= len(p) && len(p) <= 100000000 + 200*result.count
  ensures count <= result.count && result.count <= 500 && 0 <= result.objects && result.objects <= 500
  ensures 5010 <= result.end && result.end == len(p)
{
  if tools < 0 || tools >= len(d.tape)/6 || d.tape[6*tools] != 5 { return Counts { count: count, objects: objects, end: len(p) }; }
  let stop: i64 = d.tape[6*tools+3];
  if stop <= tools || stop > len(d.tape)/6 { return Counts { count: count, objects: objects, end: len(p) }; }
  let mut reserve: i64 = 0;
  let a: crate::access::Span = crate::access::raw_span(d,tools);
  if a.status == 0 { reserve = 2*(a.end-a.start); }
  // hand: `Vec::with_capacity(p0.len() + reserve)` then `extend_from_slice(p0)` (a fresh buffer, not a regrown one).
  let mut out: [i64] = alloc(0,0);
  arr_reserve(inout out,len(p)+reserve);
  arr_append(inout out,p,0,len(p));
  p = move out;
  let lp: i64 = len(p);
  let mut j: i64 = tools+1; let mut seen: i64 = 0;
  let mut obj: i64 = objects; let mut cnt: i64 = count;
  while 0 <= j && j < stop && seen < 1048576 && obj < 500
    invariant stop <= len(d.tape)/6
    invariant 0 <= seen && seen <= 1048576 && objects <= obj && obj <= 500 && count <= cnt && cnt <= 500
    invariant 5010 <= lp && lp <= len(p) && len(p) <= 100000000 + 200*cnt
    decreases 1048576-seen
  {
    let cur: i64 = j; j = d.tape[6*j+3]; seen=seen+1;
    if d.tape[6*cur] == 6 {
      obj=obj+1;
      if cnt < 500 {
        let at: i64 = len(p); let mut ok: bool = false; let mut m: i64 = 0;
        let ns: crate::access::Span = str_span(d,field(d,cur,"name"));
        if ns.status == 0 {
          decode(d.source,ns.start,ns.end,inout p,201);
          m = len(p)-at;
          ok = 1 <= m && m <= 200;
          if ok {
            let mut i: i64 = at;
            while i < len(p)
              invariant at <= i && i <= len(p) && len(p) == at+m && 1 <= m && m <= 200
              decreases len(p)-i
            { if !unit_ok(p[i]) { ok=false; i=len(p); } else { i=i+1; } }
          }
        }
        if ok {
          let base: i64 = 10+10*cnt;
          assert len(p) == at+m;
          assert 1 <= m && m <= 200;
          assert base+9 < len(p);
          assert len(p) <= 100000000 + 200*(cnt+1);
          p[base]=at; p[base+1]=m;
          put_field(d.source,str_span(d,field(d,cur,"title")),16000000,true,inout p,base+2);
          assert base+9 < len(p) && len(p) <= 100000000 + 200*(cnt+1);
          put_field(d.source,str_span(d,field(d,cur,"description")),desc_cap(),false,inout p,base+4);
          assert base+9 < len(p) && len(p) <= 100000000 + 200*(cnt+1);
          let an: i64 = field(d,cur,"annotations");
          if an >= 0 { let h: i64 = field(d,an,"readOnlyHint"); if h >= 0 && d.tape[6*h] == 2 { p[base+6]=1; } }
          p[base+7]=-1;
          if an >= 0 {
            let h: i64 = field(d,an,"destructiveHint");
            if h >= 0 { if d.tape[6*h] == 1 { p[base+7]=0; } else if d.tape[6*h] == 2 { p[base+7]=1; } }
          }
          // raw JSON of the tool object, widened one byte per word; an invalid span reads as empty.
          let rs: crate::access::Span = crate::access::raw_span(d,cur);
          let mut rstart: i64 = 0; let mut rl: i64 = 0;
          if rs.status == 0 { rstart=rs.start; rl=rs.end-rs.start; }
          if rl <= 16000000 && len(p) <= 100000000-rl {
            p[base+8]=len(p); p[base+9]=rl;
            arr_append(inout p,d.source,rstart,rl);
          }
          cnt=cnt+1;
        } else { p = truncate(p,at); }
      }
    }
  }
  return Counts { count: cnt, objects: obj, end: len(p) };
}
// The error message decoded onto the end of p after one exact reserve; p[6], p[7] = (offset, units). Nothing changes
// when id is not a string with a valid span.
pub fn put_message(inout p: [i64], d: crate::json::JsonDocument, id: i64) -> () ! alloc
  requires 5010 <= len(p) && len(p) <= 80000000
  ensures 5010 <= len(p) && len(p) <= 100000000
{
  let sp: crate::access::Span = str_span(d,id);
  if sp.status != 0 { return; }
  let lp: i64 = len(p);
  let mut inner: i64 = sp.end-sp.start; if inner >= 2 { inner=inner-2; }
  arr_reserve(inout p,inner);
  decode(d.source,sp.start,sp.end,inout p,16777216);
  p[6]=lp; p[7]=len(p)-lp;
}
