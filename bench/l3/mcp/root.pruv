// Protocol and G10 transport policy.
mod json;
mod access;
mod lines;
mod tail;
mod packet;
mod jstr;
mod util;
mod args;
mod transport;
trusted rust fn command_missing(command: str, cwd: str) -> bool ! proc, alloc
  ensures true
  = "::mcp_host::command_missing";
pub fn page_cap() -> i64 ensures result == 5 { return 5; }
pub fn tool_cap() -> i64 ensures result == 500 { return 500; }
// The bytes of s at b[at..], returns the new end (a literal argument is not allocated, R-6g-12).
fn put(inout b: [u8], at: i64, s: str) -> i64
  requires 0 <= at && at + len(s) <= len(b)
  ensures result == at + len(s)
{
  let n: i64 = len(s); let mut i: i64 = 0;
  while i < n invariant 0 <= i && i <= n && n == len(s) decreases n-i
  { b[at+i]=s[i]; i=i+1; }
  return at+n;
}
// One request line written into one buffer; the cursor is the raw token src[cs..ce) of the last page (no copy).
fn request(take l: Loop, slot: i64, id: i64, init: bool, old: bool, src: [u8], cs: i64, ce: i64, ms: i64) -> Loop ! async, alloc, proc
  requires 1 <= id && id <= 7 && 0 <= cs && cs <= ce && ce <= len(src) && ce - cs <= 16777216
{
  let mut b: [u8] = alloc(256+(ce-cs),0);
  let mut at: i64 = put(inout b,0,"{\"jsonrpc\":\"2.0\",\"id\":");
  if id == 1 { at=put(inout b,at,"1"); } if id == 2 { at=put(inout b,at,"2"); }
  if id == 3 { at=put(inout b,at,"3"); } if id == 4 { at=put(inout b,at,"4"); }
  if id == 5 { at=put(inout b,at,"5"); } if id == 6 { at=put(inout b,at,"6"); }
  if id == 7 { at=put(inout b,at,"7"); }
  if init {
    at=put(inout b,at,",\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"");
    if old { at=put(inout b,at,"2025-06-18"); } else { at=put(inout b,at,"2025-11-25"); }
    at=put(inout b,at,"\",\"capabilities\":{},\"clientInfo\":{\"name\":\"lair\",\"version\":\"1\"}}}\n");
  } else {
    at=put(inout b,at,",\"method\":\"tools/list\"");
    if ce-cs > 2 {
      at=put(inout b,at,",\"params\":{\"cursor\":");
      copy_range(inout b,at,src,cs,ce-cs); at=at+(ce-cs);
      at=put(inout b,at,"}");
    }
    at=put(inout b,at,"}\n");
  }
  b = truncate(b,at);
  return crate::transport::send(move l,slot,b,ms);
}
// The reply to a server request, id echoed from its raw token src[s..e).
fn reply(src: [u8], s: i64, e: i64, ping: bool) -> [u8] ! alloc
  requires 0 <= s && s <= e && e <= len(src) && e - s <= 16777216
{
  let mut b: [u8] = alloc(256+(e-s),0);
  let mut at: i64 = put(inout b,0,"{\"jsonrpc\":\"2.0\",\"id\":");
  copy_range(inout b,at,src,s,e-s); at=at+(e-s);
  if ping { at=put(inout b,at,",\"result\":{}}\n"); }
  else { at=put(inout b,at,",\"error\":{\"code\":-32601,\"message\":\"Lair 앱은 이 요청을 지원하지 않아.\"}}\n"); }
  return truncate(b,at);
}
pub fn mcp_check(command: str, argv: str, cwd: str, timeout_ms: i64) -> [i64] ! async, net, proc, alloc
  ensures len(result) >= 5010
{
  let mut p: [i64] = alloc(5010,0); p[1]=1; p[4]=-1; p[6]=-1;
  let sp: [i64] = crate::args::arg_spans(argv);
  if sp[0] != 0 { p[1]=0; p[2]=2; return p; }
  let args: ProcessArgs = crate::args::build_args(argv);
  let child: Process = proc_spawn(command,args,cwd);
  if !proc_ok(child) {
    let error: i64 = proc_error(child);
    let r: Result<i64> = proc_wait(move child);
    p[1]=0; p[2]=2;
    if error == 2 && command_missing(command,cwd) { p[2]=1; }
    return p;
  }
  let mut l: Loop = ev_new(3);
  if !ev_ok(l) || ev_count(l) >= ev_cap(l) {
    let k: Result<i64> = proc_kill(move child);
    crate::transport::close(move l,-1); p[2]=7; return p;
  }
  l=ev_add_process(move l,move child);
  let slot: i64 = ev_last(l);
  if !ev_ok(l) || ev_count(l) >= ev_cap(l) { crate::transport::close(move l,slot); p[2]=7; return p; }
  let mut ms: i64 = timeout_ms;
  if ms < 0 { ms=0; } if ms > 86400000 { ms=86400000; }
  l=ev_add_timer(move l,ms); let overall: i64 = ev_last(l);
  if !ev_ok(l) || ev_count(l) >= ev_cap(l) { crate::transport::close(move l,slot); p[2]=7; return p; }
  l=ev_add_timer(move l,30000); let init: i64 = ev_last(l);
  // writes before ready are bounded by the 30000 ms init timer too
  let mut im: i64 = ms; if im > 30000 { im=30000; }
  let mut st: [i64] = alloc(5,0);
  let mut line: [u8] = alloc(4096,0); let mut chunk: [u8] = alloc(65536,0);
  let mut tb: [i64] = crate::tail::tail_buf(1024); let mut ts: [i64] = crate::tail::tail_state(1024);
  let mut id: i64 = 1; let mut ready: bool = false; let mut page: i64 = 0; let mut objects: i64 = 0;
  let mut count: i64 = 0; let mut done: bool = false; let mut events: i64 = 0;
  let empty: [u8] = alloc(0,0); l=request(move l,slot,id,true,false,empty,0,0,im);
  while !done && events < 1000000
    invariant 0 <= events && events <= 1000000
    invariant 1 <= id && id <= 7 && 0 <= page && page <= 5
    invariant 0 <= objects && objects <= 500 && 0 <= count && count <= 500
    invariant 5010 <= len(p) && len(p) <= 100000000
    invariant len(st) == 5 && 0 <= st[1] && st[1] <= len(line) && 0 <= st[2] && st[2] <= st[4] && 0 <= st[4] && st[4] <= 65536 && len(chunk) == 65536
    invariant 1 <= len(line) && len(line) <= 4194304
    invariant len(ts) == 12 && ts[1] == 1024 && 0 <= ts[0] && ts[0] <= 2048 && len(tb) == 2050
    decreases 1000000-events
  {
    events=events+1; l=crate::transport::receive_grow(move l,slot,overall,init,ready,4194304,inout st,inout line,inout chunk,inout tb,inout ts); let n: i64 = st[0];
    if n < 0 && n != -6 {
      p[2]=3;
      if n == -2 { p[2]=4; } if n == -3 { p[2]=5; p[1]=1; }
      if n == -4 { p[2]=6; p[3]=st[3]; } if n == -5 { p[2]=7; }
      done=true;
    } else if n >= 0 && n <= len(line) {
      // The trimmed line is parsed from its bounds in the line buffer: one exact-size copy for the document source.
      let t: crate::util::Bounds = crate::util::trim_span(line,0,n);
      let parsed: crate::json::JsonParse = crate::lines::parse_copy(line,t.lo,t.hi);
      match parsed {
        crate::json::JsonParse::Failed(e) => { }
        crate::json::JsonParse::Parsed(d) => {
          if crate::access::kind(d,0) == 6 {
            let mid: i64 = crate::util::field(d,0,"id"); let method: i64 = crate::util::field(d,0,"method");
            if mid >= 0 && crate::access::kind(d,method) == 4 {
              let ms_: crate::access::Span = crate::access::raw_span(d,mid);
              let mut rs: i64 = 0; let mut re: i64 = 0; if ms_.status == 0 { rs=ms_.start; re=ms_.end; }
              let out: [u8] = reply(d.source,rs,re,crate::access::string_is(d,method,"ping") == 1);
              let mut w: i64 = ms; if !ready { w=im; }
              l=crate::transport::send(move l,slot,out,w);
            } else {
              let number: crate::access::Number = crate::access::number(d,mid);
              if number.status == 0 && crate::util::id_matches(d.source,number.start,number.end,id) {
                let error: i64 = crate::util::field(d,0,"error");
                if crate::access::kind(d,error) == 6 {
                  if !ready && id == 1 { id=2; l=request(move l,slot,id,true,true,empty,0,0,im); }
                  else {
                    p[2]=8;
                    if len(p) <= 80000000 { crate::packet::put_message(inout p,d,crate::util::field(d,error,"message")); }
                    done=true;
                  }
                } else if !ready {
                  // The literal is lent to send as read-only bytes (R-6g4-5): no allocation.
                  ready=true; p[1]=2; l=crate::transport::send(move l,slot,"{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}\n",ms);
                  if id < 7 { id=id+1; l=request(move l,slot,id,false,false,empty,0,0,ms); }
                } else {
                  let result_id: i64 = crate::util::field(d,0,"result"); let tools: i64 = crate::util::field(d,result_id,"tools");
                  let c: crate::packet::Counts = crate::packet::page(inout p,d,tools,count,objects);
                  count=c.count; objects=c.objects;
                  if page < 5 { page=page+1; }
                  // A string token decodes to no units exactly when it has nothing between its quotes.
                  let cur: i64 = crate::util::field(d,result_id,"nextCursor"); let cu: crate::access::Span = crate::packet::str_span(d,cur);
                  if page >= 5 || objects >= 500 || cu.status != 0 || cu.end-cu.start <= 2 { p[0]=1; p[8]=count; done=true; }
                  else if id < 7 { id=id+1; l=request(move l,slot,id,false,false,d.source,cu.start,cu.end,ms); }
                }
              }
            }
          }
        }
      }
    }
  }
  if !done { p[2]=9; }
  st[0]=-6; l=crate::transport::poll(move l,overall,init,true,inout st,0);
  if st[0] == -1 { p[0]=0; p[2]=3; p[8]=0; }
  crate::tail::tail_flush(inout tb,inout ts);
  let err: [u8] = crate::tail::tail_bytes(tb,ts);
  let e: crate::util::Bounds = crate::util::last_line(err); let sn: i64 = e.hi-e.lo;
  if len(p) <= 99995904 && sn <= 20000000 { p[4]=len(p); p[5]=sn; crate::packet::append_bytes(inout p,err,e.lo,e.hi); }
  crate::transport::close(move l,slot); return p;
}
