pub fn field(d: crate::json::JsonDocument, id: i64, key: str) -> i64 ! alloc { return crate::access::field(d,id,key); }
// Exact decimal equality to the small positive request IDs (no host f64 adapter).
// The number token is src[s..e) (a borrowed span of the document, no copy).
pub fn id_matches(src: [u8], s: i64, e: i64, id: i64) -> bool
 requires 1 <= id && id <= 7 && 0 <= s && s <= e && e <= len(src)
{
 let mut i: i64 = s; let mut digit: i64 = 0; let mut scale: i64 = 0;
 let mut frac: bool = false; let mut bad: bool = false;
 while i < e && i - s < 16777216 && src[i] != 101 && src[i] != 69
 invariant s <= i && i <= e && i - s <= 16777216
 invariant -(i-s) <= scale && scale <= i-s
 decreases 16777216-(i-s)
 {
 let c: i64 = src[i]; i=i+1;
 if c == 46 { frac=true; }
 else if c >= 48 && c <= 57 {
 if frac { scale=scale-1; }
 if digit == 0 { digit=c-48; }
 else if c == 48 { scale=scale+1; } else { bad=true; }
 } else { bad=true; }
 }
 let mut exp: i64 = 0; let mut neg: bool = false;
 if i < e { i=i+1;
 if i < e && src[i] == 45 { neg=true; i=i+1; }
 else if i < e && src[i] == 43 { i=i+1; }
 }
 while i < e
 invariant s <= i && i <= e && 0 <= exp && exp <= 16777217
 decreases e-i
 {
 if src[i] < 48 || src[i] > 57 { bad=true; }
 else if exp <= 1677721 { exp=exp*10+src[i]-48; if exp > 16777217 { exp=16777217; } }
 else { exp=16777217; }
 i=i+1;
 }
 if neg { exp=-exp; }
 return !bad && digit == id && scale+exp == 0;
}
// ECMAScript trim whitespace, encoded as UTF-8, inside b[0..end).
fn space(b: [u8], i: i64, end: i64) -> i64
 requires 0 <= i && i < end && end <= len(b)
 ensures 0 <= result && result <= 3 && result <= end-i
{
 let c: i64 = b[i];
 if c == 32 || (9 <= c && c <= 13) { return 1; }
 if i+1 < end && c == 194 && b[i+1] == 160 { return 2; }
 if i+2 < end {
 if c == 225 && b[i+1] == 154 && b[i+2] == 128 { return 3; }
 if c == 226 && b[i+1] == 128 && ((128 <= b[i+2] && b[i+2] <= 138) || b[i+2] == 168 || b[i+2] == 169 || b[i+2] == 175) { return 3; }
 if c == 226 && b[i+1] == 129 && b[i+2] == 159 { return 3; }
 if c == 227 && b[i+1] == 128 && b[i+2] == 128 { return 3; }
 if c == 239 && b[i+1] == 187 && b[i+2] == 191 { return 3; }
 }
 return 0;
}
pub struct Bounds { lo: i64, hi: i64 }
// The trimmed part of b[from..end) as bounds into b (no copy): String.prototype.trim on the UTF-8 bytes.
pub fn trim_span(b: [u8], from: i64, end: i64) -> Bounds
 requires 0 <= from && from <= end && end <= len(b)
 ensures from <= result.lo && result.lo <= result.hi && result.hi <= end
{
 let mut lo: i64 = from; let mut hi: i64 = from; let mut i: i64 = from;
 while i < end
 invariant from <= lo && lo <= i && from <= hi && hi <= i && i <= end
 decreases end-i
 {
 let n: i64 = space(b,i,end);
 if n > 0 { if lo == i { lo=lo+n; } i=i+n; }
 else { i=i+1; hi=i; }
 }
 if hi < lo { hi=lo; }
 return Bounds { lo: lo, hi: hi };
}
// The last line of the trimmed text, trimmed again, as bounds into b.
pub fn last_line(b: [u8]) -> Bounds
 ensures 0 <= result.lo && result.lo <= result.hi && result.hi <= len(b)
{
 let t: Bounds = trim_span(b,0,len(b)); let mut start: i64 = t.lo; let mut i: i64 = t.lo;
 while i < t.hi
 invariant t.lo <= start && start <= i && i <= t.hi
 decreases t.hi-i
 { if b[i] == 10 { start=i+1; } i=i+1; }
 return trim_span(b,start,t.hi);
}
