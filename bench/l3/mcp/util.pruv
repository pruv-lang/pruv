pub fn field(d: crate::json::JsonDocument, id: i64, key: str) -> i64 ! alloc { return crate::access::field(d,id,key); }
pub fn raw(d: crate::json::JsonDocument, id: i64) -> [u8] ! alloc {
  let s: crate::access::Span = crate::access::raw_span(d,id);
  if s.status != 0 { let e: [u8] = alloc(0,0); return e; }
  let mut b: [u8] = alloc(s.end-s.start,0); let mut i: i64 = 0;
  while i < len(b) invariant 0 <= i && i <= len(b) && len(b) == s.end-s.start decreases len(b)-i
  { b[i]=d.source[s.start+i]; i=i+1; } return b;
}
// Exact decimal equality to the small positive request IDs (no host f64 adapter).
pub fn id_matches(b: [u8], id: i64) -> bool
 requires 1 <= id && id <= 7
{
 let mut i: i64 = 0; let mut digit: i64 = 0; let mut scale: i64 = 0;
 let mut frac: bool = false; let mut bad: bool = false;
 while i < len(b) && i < 16777216 && b[i] != 101 && b[i] != 69
 invariant 0 <= i && i <= len(b) && i <= 16777216
 invariant -i <= scale && scale <= i
 decreases 16777216-i
 {
 let c: i64 = b[i]; i=i+1;
 if c == 46 { frac=true; }
 else if c >= 48 && c <= 57 {
 if frac { scale=scale-1; }
 if digit == 0 { digit=c-48; }
 else if c == 48 { scale=scale+1; } else { bad=true; }
 } else { bad=true; }
 }
 let mut exp: i64 = 0; let mut neg: bool = false;
 if i < len(b) { i=i+1;
 if i < len(b) && b[i] == 45 { neg=true; i=i+1; }
 else if i < len(b) && b[i] == 43 { i=i+1; }
 }
 while i < len(b)
 invariant 0 <= i && i <= len(b) && 0 <= exp && exp <= 16777217
 decreases len(b)-i
 {
 if b[i] < 48 || b[i] > 57 { bad=true; }
 else if exp <= 1677721 { exp=exp*10+b[i]-48; if exp > 16777217 { exp=16777217; } }
 else { exp=16777217; }
 i=i+1;
 }
 if neg { exp=-exp; }
 return !bad && digit == id && scale+exp == 0;
}
// ECMAScript trim whitespace, encoded as UTF-8.
fn space(b: [u8], i: i64) -> i64
 requires 0 <= i && i < len(b)
 ensures 0 <= result && result <= 3 && result <= len(b)-i
{
 let c: i64 = b[i];
 if c == 32 || (9 <= c && c <= 13) { return 1; }
 if i+1 < len(b) && c == 194 && b[i+1] == 160 { return 2; }
 if i+2 < len(b) {
 if c == 225 && b[i+1] == 154 && b[i+2] == 128 { return 3; }
 if c == 226 && b[i+1] == 128 && ((128 <= b[i+2] && b[i+2] <= 138) || b[i+2] == 168 || b[i+2] == 169 || b[i+2] == 175) { return 3; }
 if c == 226 && b[i+1] == 129 && b[i+2] == 159 { return 3; }
 if c == 227 && b[i+1] == 128 && b[i+2] == 128 { return 3; }
 if c == 239 && b[i+1] == 187 && b[i+2] == 191 { return 3; }
 }
 return 0;
}
pub fn trim(b: [u8]) -> [u8] ! alloc
 ensures len(result) <= len(b)
{
 let mut lo: i64 = 0; let mut hi: i64 = 0; let mut i: i64 = 0;
 while i < len(b)
 invariant 0 <= lo && lo <= i && 0 <= hi && hi <= i && i <= len(b)
 decreases len(b)-i
 {
 let n: i64 = space(b,i);
 if n > 0 { if lo == i { lo=lo+n; } i=i+n; }
 else { i=i+1; hi=i; }
 }
 if hi < lo { hi=lo; }
 let mut out: [u8] = alloc(hi-lo,0); let mut j: i64 = 0;
 while j < len(out)
 invariant 0 <= j && j <= len(out) && len(out) == hi-lo
 decreases len(out)-j
 { out[j]=b[lo+j]; j=j+1; }
 return out;
}
pub fn last_line(b: [u8]) -> [u8] ! alloc
 ensures len(result) <= len(b)
{
 let trimmed: [u8] = trim(b); let mut start: i64 = 0; let mut i: i64 = 0;
 while i < len(trimmed)
 invariant 0 <= start && start <= i && i <= len(trimmed)
 decreases len(trimmed)-i
 { if trimmed[i] == 10 { start=i+1; } i=i+1; }
 let mut out: [u8] = alloc(len(trimmed)-start,0); let mut j: i64 = 0;
 while j < len(out)
 invariant 0 <= j && j <= len(out) && len(out) == len(trimmed)-start
 decreases len(out)-j
 { out[j]=trimmed[start+j]; j=j+1; }
 return trim(out);
}
