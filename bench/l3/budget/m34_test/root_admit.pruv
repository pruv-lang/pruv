mod ent_u16;
mod bud_keys;
mod bud_store;
mod bud_map;
mod bud_admit;

// L3 P11 test root: import admission (bud_admit::admit, I0 + I1) on a built store and on one corruption per case
// (driver_admit.rs, run.py admit). Case 0 is the clean store; every other case breaks one header word, offset, link,
// key or count and expects admit's class code; 14, 19 and 20 are stores admit must accept (stale tag, slots left
// by removal, reused entry under a stale slot); 21 and 22 grow top and the free list (grow); 23 removes the middle of
// a deep chain (chain), which admit must accept too; 24 is case 19 with a payload (blob, v0..v3) on roots 0..2, which
// grow_copy must keep (root_pay_diff, L3 P13j); 25 and 26 are case 19 with values and an empty blob on root 0 whose
// offset is past the buffer (25) or -1 (26), which admit accepts and grow_copy must copy (P13j.5). entry_addr checks the entry base at the maximum slot count. Functional (I2) properties are not part of these cases.

fn fa(st: [i64], e: i64, f: i64) -> i64
  requires 0 <= f && f < 20
{ return crate::bud_store::field_at(st, e, f); }

fn poke(inout st: [i64], i: i64, v: i64) -> ()
{ crate::ent_u16::wr(inout st, i, v); }

// Entries 3..8 are keys 0..5 under root 0, 9 and 10 keys 6, 7 under entry 3; entry 4 gets a 3-word blob; entry 5 is
// removed (the free list is [5]). live 10, top 11.
fn build(inout st: [i64], keys: [i64]) -> i64
{
  let r0: i64 = crate::bud_store::init_store(inout st);
  if r0 != 0 { return -100; }
  let mut i: i64 = 0;
  while i < 6
    invariant 0 <= i && i <= 6
    decreases 6 - i
  {
    let r: i64 = crate::bud_map::add_w(inout st, 0, keys, i, 4);
    if r < 0 { return -101; }
    i = i + 1;
  }
  let r1: i64 = crate::bud_map::add_w(inout st, 3, keys, 6, 4);
  let r2: i64 = crate::bud_map::add_w(inout st, 3, keys, 7, 4);
  if r1 < 0 || r2 < 0 { return -102; }
  let r3: i64 = crate::bud_map::set_blob(inout st, 4, keys, 0, 3);
  if r3 != 0 { return -103; }
  crate::bud_map::remove(inout st, 5);
  return 0;
}

// The word each case breaks (-1: none) and its new value.
fn addr_of(st: [i64], case: i64) -> i64
{
  if case == 1 { return 0; }
  if case == 2 { return fa(st, 1, 1); }
  if case == 3 { return fa(st, 3, 0); }
  if case == 4 { return fa(st, 4, 1); }
  if case == 5 { return fa(st, 3, 18); }
  if case == 6 { return fa(st, 3, 4); }
  if case == 7 { return fa(st, 3, 5); }
  if case == 8 { return fa(st, 4, 13); }
  if case == 9 { return fa(st, 3, 7); }
  if case == 10 { return fa(st, 5, 8); }
  if case == 11 { return 16; }
  if case == 12 { return 12; }
  if case == 13 { return 13; }
  if case == 14 { return fa(st, 3, 6); }
  if case == 15 { return 14; }
  if case == 16 { return fa(st, 9, 1); }
  if case == 17 { return 8; }
  if case == 18 { return fa(st, 6, 8); }
  if case == 25 || case == 26 { return fa(st, 0, 12); }
  return -1;
}

fn val_of(st: [i64], case: i64) -> i64
{
  if case == 2 { return 4; }
  if case == 3 { return 2; }
  if case == 4 || case == 9 || case == 11 || case == 18 { return 999; }
  if case == 7 { return 3; }
  if case == 8 { return 1000; }
  if case == 10 || case == 16 { return 5; }
  if case == 12 { return crate::bud_store::c32(crate::bud_store::hd(st, 12)) + 1; }
  if case == 13 { return crate::bud_store::c32(crate::bud_store::hd(st, 13)) + 1; }
  if case == 14 {
    if ushr(crate::bud_store::ef(st, 3, 6), 34) == 0 { return 4611686018427387904; }
    return 0;
  }
  if case == 15 { return 1099511627776; }
  if case == 17 || case == 26 { return -1; }
  if case == 25 { return len(st) + 1; }
  return 0;
}

// Linearity case (L3 P12): 2n new entries under root 0 (key 0; add_w compares no keys, and key uniqueness is I2,
// not admission), then the entries 10+n..10+2n-1 removed. live 10 + n; top and the free list grow by about n each
// (the first adds reuse the free list), and run.py checks visits == top == live + free.
fn grow(inout st: [i64], keys: [i64], n: i64) -> i64
  requires 0 <= n && n <= 4096
{
  let mut j: i64 = 0;
  while j < 2 * n
    invariant 0 <= j && j <= 2 * n
    decreases 2 * n - j
  {
    let r: i64 = crate::bud_map::add_w(inout st, 0, keys, 0, 4);
    if r < 0 { return -105; }
    j = j + 1;
  }
  j = n;
  while j < 2 * n
    invariant n <= j && j <= 2 * n
    decreases 2 * n - j
  {
    crate::bud_map::remove(inout st, 10 + j);
    j = j + 1;
  }
  return 0;
}

// Depth case (L3 P13a): a chain of 2n entries, each the only child of the one before (the first under root 0), plus a
// leaf added under the n-th after its chain child (so the walk climbs from an internal node to a next sibling), then
// the n-th removed with its whole subtree, on the case-19 store (live 7). live 7 + n - 1; no live entry may keep a
// freed owner (admit class -4).
fn chain(inout st: [i64], keys: [i64], n: i64) -> i64
  requires 1 <= n && n <= 4096
{
  let mut o: i64 = 0;
  let mut mid: i64 = -1;
  let mut j: i64 = 0;
  while j < 2 * n
    invariant 0 <= j && j <= 2 * n
    decreases 2 * n - j
  {
    let r: i64 = crate::bud_map::add_w(inout st, o, keys, 0, 4);
    if r < 0 { return -106; }
    if j == n - 1 { mid = r; }
    o = r;
    j = j + 1;
  }
  let s: i64 = crate::bud_map::add_w(inout st, mid, keys, 1, 4);
  if s < 0 { return -107; }
  crate::bud_map::remove(inout st, mid);
  return 0;
}

// Grow after admission (L3 P13b): builds and admits case into st, then grow_copy into nxt. live[0..2] gets the live
// counts of st and nxt. Returns grow_copy's result, or -1000 if admission rejected st. A 0 result must keep every
// live entry; a tree deeper than grow_copy copies (entries 9, 10 under entry 3 under root 0) must give 2.
pub fn admit_grow(inout st: [i64], keys: [i64], case: i64, inout nxt: [i64], inout cnt: [i64], inout live: [i64]) -> i64
{
  let a: i64 = admit_case(inout st, keys, case, inout cnt);
  if a < 0 { return -1000; }
  let g: i64 = crate::bud_map::grow_copy(st, inout nxt);
  crate::ent_u16::wr(inout live, 0, crate::bud_store::hd(st, 12));
  crate::ent_u16::wr(inout live, 1, crate::bud_store::hd(nxt, 12));
  crate::ent_u16::wr(inout live, 2, root_pay_diff(st, nxt));
  return g;
}

// Root payload kept by grow_copy (L3 P13j): 1 if any of roots 0..2 differs in values v0..v3 (fields 14..17), blob
// length or blob units between prev and nxt, else 0 (returns on the first mismatch, so no counter to overflow).
pub fn root_pay_diff(prev: [i64], nxt: [i64]) -> i64
{
  let mut r: i64 = 0;
  while r < 3
    invariant 0 <= r && r <= 3
    decreases 3 - r
  {
    let mut f: i64 = 14;
    while f < 18
      invariant 14 <= f && f <= 18
      decreases 18 - f
    {
      if crate::bud_store::ef(prev, r, f) != crate::bud_store::ef(nxt, r, f) { return 1; }
      f = f + 1;
    }
    let n: i64 = crate::bud_map::blob_len(prev, r);
    if n != crate::bud_map::blob_len(nxt, r) { return 1; }
    let mut j: i64 = 0;
    while j < n
      invariant 0 <= j && j <= n
      decreases n - j
    {
      if crate::bud_map::blob_unit(prev, r, j) != crate::bud_map::blob_unit(nxt, r, j) { return 1; }
      j = j + 1;
    }
    r = r + 1;
  }
  return 0;
}

// L3 P13j: entry base at the maximum slot count.
pub fn entry_addr(st: [i64], e: i64) -> i64 { return crate::bud_store::field_at(st, e, 0); }

pub fn admit_case(inout st: [i64], keys: [i64], case: i64, inout cnt: [i64]) -> i64
{
  let b: i64 = build(inout st, keys);
  if b != 0 { return b; }
  if case >= 19 {
    // valid stores after lazy deletion: entry 3 and its children 9, 10 removed (only 3's slot is cleared; the slots
    // of 9 and 10 stay), free list 3 -> 10 -> 9 -> 5. Case 20 then adds two keys (reusing 3, then 10, whose stale
    // slot still names it) and removes the first again: 10 is live under a stale slot plus its own new slot.
    crate::bud_map::remove(inout st, 3);
    if case == 20 {
      let r1: i64 = crate::bud_map::add_w(inout st, 0, keys, 6, 4);
      let r2: i64 = crate::bud_map::add_w(inout st, 0, keys, 7, 4);
      if r1 != 3 || r2 != 10 { return -104; }
      crate::bud_map::remove(inout st, 3);
    }
  }
  if case == 21 || case == 22 {
    let mut n: i64 = 64;
    if case == 22 { n = 256; }
    let g: i64 = grow(inout st, keys, n);
    if g != 0 { return g; }
  }
  if case == 23 {
    let g: i64 = chain(inout st, keys, 64);
    if g != 0 { return g; }
  }
  if case == 24 {
    let mut r: i64 = 0;
    while r < 3
      invariant 0 <= r && r <= 3
      decreases 3 - r
    {
      let rb: i64 = crate::bud_map::set_blob(inout st, r, keys, r, 2);
      if rb != 0 { return -108; }
      crate::bud_store::set_vals(inout st, r, 100 + r, 200 + r, 300 + r, 400 + r);
      r = r + 1;
    }
  }
  if case == 25 || case == 26 {
    // values but an empty blob on root 0: its extension exists and the blob offset is free (P13j.5)
    crate::bud_store::set_vals(inout st, 0, 7, 8, 9, 10);
  }
  let a: i64 = addr_of(st, case);
  let v: i64 = val_of(st, case);
  if a >= 0 { poke(inout st, a, v); }
  return crate::bud_admit::admit(st, inout cnt);
}
