// Resident M4 state uses monotonic ordinals local to each map.
// Refuse insertion before incrementing a counter to 2^40.
pub struct Run { ordinal: i64, waiting: i64 }
pub struct Activity { ordinal: i64 }
pub struct Sess { ordinal: i64, blob: Vec<i64> }
pub struct Clock {
  ordinal: i64, owner: String, since_present: i64, since: i64, armed: i64, deadline: i64,
  runs: HashMap<String, Run>, next_runs: i64
}
pub struct Tool { ordinal: i64, activities: HashMap<String, Activity>, next_activities: i64 }
pub struct St {
  sessions: HashMap<String, Sess>, next_sessions: i64,
  clocks: HashMap<String, Clock>, next_clocks: i64,
  tools: HashMap<String, Tool>, next_tools: i64
}

// The Q reply shape determines where keys go in the output.
pub struct Reply { status: i64, words: Vec<i64>, keys: Vec<String> }

fn owned_text(key: str) -> String ! alloc {
  return string_push_str(string_new(), key);
}

fn empty_reply(status: i64) -> Reply ! alloc {
  return Reply { status: status, words: vec_new::<i64>(), keys: vec_new::<String>() };
}

fn emit(inout reply: Reply, value: i64) -> () ! alloc {
  if len(reply.words) < 1099511627776 {
    reply.words = vec_push::<i64>(move reply.words, value);
  }
}

fn emit_key(inout reply: Reply, key: str) -> () ! alloc {
  if len(reply.keys) < 1099511627776 {
    reply.keys = vec_push::<String>(move reply.keys, owned_text(key));
  }
}

fn one(value: i64) -> Reply ! alloc {
  let mut reply: Reply = empty_reply(0);
  emit(inout reply, value);
  return reply;
}

fn blob_copy(blob: [i64]) -> Vec<i64> ! alloc {
  let mut result: Vec<i64> = vec_new::<i64>();
  let mut i: i64 = 0;
  while i < len(blob)
    invariant 0 <= i && i <= len(blob) && len(result) == i
    decreases len(blob) - i
  {
    result = vec_push::<i64>(move result, blob[i]);
    i = i + 1;
  }
  return move result;
}

fn emit_blob(inout reply: Reply, session: Sess) -> () ! alloc {
  let n: i64 = len(session.blob);
  emit(inout reply, n);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n == len(session.blob)
    decreases n - i
  {
    emit(inout reply, vec_get::<i64>(session.blob, i));
    i = i + 1;
  }
}

fn emit_clock(inout reply: Reply, clock: Clock) -> () ! alloc {
  emit_key(inout reply, string_to_str(clock.owner));
  emit(inout reply, clock.since_present);
  emit(inout reply, clock.since);
  emit(inout reply, clock.armed);
  emit(inout reply, clock.deadline);
}

fn emit_runs(inout reply: Reply, clock: Clock) -> () ! alloc {
  emit(inout reply, len(clock.runs));
  for (key, item) in clock.runs {
    emit(inout reply, item.ordinal);
    emit_key(inout reply, key);
    emit(inout reply, item.waiting);
  }
}

fn emit_tools(inout reply: Reply, tool: Tool) -> () ! alloc {
  emit(inout reply, len(tool.activities));
  for (key, item) in tool.activities {
    emit(inout reply, item.ordinal);
    emit_key(inout reply, key);
  }
}

fn emit_sessions(inout reply: Reply, st: St, details: bool) -> () ! alloc {
  emit(inout reply, len(st.sessions));
  for (key, item) in st.sessions {
    emit(inout reply, item.ordinal);
    emit_key(inout reply, key);
    if details { emit_blob(inout reply, item); }
  }
}

fn emit_clocks(inout reply: Reply, st: St, details: bool) -> () ! alloc {
  emit(inout reply, len(st.clocks));
  for (key, item) in st.clocks {
    emit(inout reply, item.ordinal);
    emit_key(inout reply, key);
    if details { emit_clock(inout reply, item); emit_runs(inout reply, item); }
  }
}

fn count_runs(st: St) -> i64 {
  let mut count: i64 = 0;
  for (key, item) in st.clocks invariant 0 <= count {
    if count <= 9223370937343148031 {
      count = count + len(item.runs);
    }
  }
  return count;
}
fn emit_tools_map(inout reply: Reply, st: St, details: bool) -> () ! alloc {
  emit(inout reply, len(st.tools));
  for (key, item) in st.tools {
    emit(inout reply, item.ordinal);
    emit_key(inout reply, key);
    if details { emit_tools(inout reply, item); }
  }
}

fn count_activities(st: St) -> i64 {
  let mut count: i64 = 0;
  for (key, item) in st.tools invariant 0 <= count {
    if count <= 9223370937343148031 {
      count = count + len(item.activities);
    }
  }
  return count;
}
fn session_put(inout st: St, key: str, blob: [i64]) -> Reply ! alloc {
  let mut fresh: bool = false;
  match map_get_mut::<String, Sess>(inout st.sessions, key) {
    Some(session) => { session.blob = blob_copy(blob); }
    None => { fresh = true; }
  }
  if !fresh { return one(0); }
  let ordinal: i64 = st.next_sessions;
  if ordinal < 0 || ordinal >= 1099511627775 || len(st.sessions) >= 1099511627776 { return empty_reply(2); }
  st.next_sessions = ordinal + 1;
  st.sessions = map_insert::<String, Sess>(move st.sessions, owned_text(key),
    Sess { ordinal: ordinal, blob: blob_copy(blob) });
  return one(1);
}

fn session_get(st: St, key: str) -> Reply ! alloc {
  let mut reply: Reply = empty_reply(0);
  match map_get::<String, Sess>(st.sessions, key) {
    Some(session) => { emit(inout reply, 1); emit_blob(inout reply, session); }
    None => { emit(inout reply, 0); }
  }
  return reply;
}

fn clock_put(inout st: St, key: str, owner: str) -> Reply ! alloc {
  let mut fresh: bool = false;
  match map_get_mut::<String, Clock>(inout st.clocks, key) {
    Some(clock) => { clock.owner = owned_text(owner); }
    None => { fresh = true; }
  }
  if !fresh { return one(0); }
  let ordinal: i64 = st.next_clocks;
  if ordinal < 0 || ordinal >= 1099511627775 || len(st.clocks) >= 1099511627776 { return empty_reply(2); }
  st.next_clocks = ordinal + 1;
  st.clocks = map_insert::<String, Clock>(move st.clocks, owned_text(key),
    Clock { ordinal: ordinal, owner: owned_text(owner), since_present: 0, since: 0, armed: 0,
            deadline: 0, runs: map_new::<String, Run>(), next_runs: 0 });
  return one(1);
}

fn clock_set(inout st: St, key: str, present: i64, since: i64, armed: i64, deadline: i64) -> Reply ! alloc {
  if (present != 0 && present != 1) || (armed != 0 && armed != 1) { return empty_reply(2); }
  let mut found: i64 = 0;
  match map_get_mut::<String, Clock>(inout st.clocks, key) {
    Some(clock) => {
      clock.since_present = present;
      clock.since = since;
      clock.armed = armed;
      clock.deadline = deadline;
      found = 1;
    }
    None => {}
  }
  return one(found);
}

fn clock_read(st: St, code: i64, key: str) -> Reply ! alloc {
  let mut reply: Reply = empty_reply(0);
  match map_get::<String, Clock>(st.clocks, key) {
    Some(clock) => {
      emit(inout reply, 1);
      if code == 8 {
        emit_clock(inout reply, clock);
        emit(inout reply, len(clock.runs));
      } else {
        emit_runs(inout reply, clock);
      }
    }
    None => { emit(inout reply, 0); }
  }
  return reply;
}

fn run_set(inout clock: Clock, key: str, waiting: i64) -> i64 ! alloc
  requires waiting == 0 || waiting == 1
{
  let mut fresh: bool = false;
  match map_get_mut::<String, Run>(inout clock.runs, key) {
    Some(run) => { run.waiting = waiting; }
    None => { fresh = true; }
  }
  if !fresh { return 0; }
  let ordinal: i64 = clock.next_runs;
  if ordinal < 0 || ordinal >= 1099511627775 || len(clock.runs) >= 1099511627776 { return -1; }
  clock.next_runs = ordinal + 1;
  clock.runs = map_insert::<String, Run>(move clock.runs, owned_text(key), Run { ordinal: ordinal, waiting: waiting });
  return 1;
}

fn run_change(inout st: St, code: i64, key: str, run: str, waiting: i64) -> Reply ! alloc {
  if code == 9 && waiting != 0 && waiting != 1 { return empty_reply(2); }
  let mut value: i64 = 0;
  match map_get_mut::<String, Clock>(inout st.clocks, key) {
    Some(clock) => {
      if code == 9 {
        value = run_set(inout clock, run, waiting);
      } else {
        if map_remove::<String, Run>(inout clock.runs, run) {
          value = 1;
        }
      }
    }
    None => { if code == 9 { value = 2; } }
  }
  if value < 0 { return empty_reply(2); }
  return one(value);
}

// Activities are append-only until their entire turn is removed.
fn activity_note(inout tool: Tool, key: str) -> i64 ! alloc {
  let mut seen: bool = false;
  match map_get::<String, Activity>(tool.activities, key) {
    Some(item) => { seen = true; }
    None => {}
  }
  if seen { return 0; }
  let ordinal: i64 = tool.next_activities;
  if ordinal < 0 || ordinal >= 1099511627775 || len(tool.activities) >= 1099511627776 { return -1; }
  tool.next_activities = ordinal + 1;
  tool.activities = map_insert::<String, Activity>(move tool.activities, owned_text(key), Activity { ordinal: ordinal });
  return 1;
}

fn tool_note(inout st: St, key: str, activity: str) -> Reply ! alloc {
  let mut fresh: bool = false;
  let mut value: i64 = 0;
  match map_get_mut::<String, Tool>(inout st.tools, key) {
    Some(tool) => { value = activity_note(inout tool, activity); }
    None => { fresh = true; }
  }
  if value < 0 { return empty_reply(2); }
  if !fresh { return one(value); }
  let ordinal: i64 = st.next_tools;
  if ordinal < 0 || ordinal >= 1099511627775 || len(st.tools) >= 1099511627776 { return empty_reply(2); }
  let mut tool: Tool = Tool { ordinal: ordinal, activities: map_new::<String, Activity>(),
                              next_activities: 0 };
  let added: i64 = activity_note(inout tool, activity);
  st.next_tools = ordinal + 1;
  st.tools = map_insert::<String, Tool>(move st.tools, owned_text(key), move tool);
  return one(added);
}

fn tool_read(st: St, code: i64, key: str) -> Reply ! alloc {
  let mut reply: Reply = empty_reply(0);
  match map_get::<String, Tool>(st.tools, key) {
    Some(tool) => {
      if code == 15 { emit(inout reply, len(tool.activities)); }
      else { emit_tools(inout reply, tool); }
    }
    None => { emit(inout reply, 0); }
  }
  return reply;
}

fn removed(value: bool) -> Reply ! alloc {
  if value { return one(1); }
  return one(0);
}

pub fn m4_op(inout st: St, code: i64, key: str, other: str, data: [i64]) -> Reply ! alloc {
  if code == 1 { return session_put(inout st, key, data); }
  if code == 2 { return session_get(st, key); }
  if code == 3 {
    let found: bool = map_remove::<String, Sess>(inout st.sessions, key);
    return removed(found);
  }
  if code == 5 { return clock_put(inout st, key, other); }
  if code == 6 {
    let found: bool = map_remove::<String, Clock>(inout st.clocks, key);
    return removed(found);
  }
  if code == 7 && len(data) == 4 {
    return clock_set(inout st, key, data[0], data[1], data[2], data[3]);
  }
  if code == 8 || code == 11 { return clock_read(st, code, key); }
  if code == 9 && len(data) == 1 { return run_change(inout st, code, key, other, data[0]); }
  if code == 10 { return run_change(inout st, code, key, other, 0); }
  if code == 13 { return tool_note(inout st, key, other); }
  if code == 14 {
    let found: bool = map_remove::<String, Tool>(inout st.tools, key);
    return removed(found);
  }
  if code == 15 || code == 16 { return tool_read(st, code, key); }
  let mut reply: Reply = empty_reply(0);
  if code == 4 { emit_sessions(inout reply, st, false); }
  else if code == 12 { emit_clocks(inout reply, st, false); }
  else if code == 17 { emit_tools_map(inout reply, st, false); }
  else if code == 18 {
    let roots: i64 = len(st.sessions) + len(st.clocks) + len(st.tools);
    let runs: i64 = count_runs(st);
    let activities: i64 = count_activities(st);
    if 0 <= runs && runs <= 4611683819404132351 && 0 <= activities && activities <= 4611683819404132351 {
      emit(inout reply, roots + runs + activities);
    } else { reply.status = 2; }
  } else { reply.status = 2; }
  return reply;
}

pub fn m4_observe(inout st: St) -> Reply ! alloc {
  let mut reply: Reply = empty_reply(0);
  emit_sessions(inout reply, st, true);
  emit_clocks(inout reply, st, true);
  emit_tools_map(inout reply, st, true);
  return reply;
}
