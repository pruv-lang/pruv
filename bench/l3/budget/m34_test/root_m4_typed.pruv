// Resident M4 state uses monotonic ordinals local to each map.
// Refuse insertion before incrementing a counter to 2^40.
mod ent_u16;
mod bud_keys;

// Both inputs use UTF-8 with U+E000 as the escape marker for lone surrogates.
pub fn admit_key(inout key: crate::bud_keys::KeyAdmission, words: [i64]) -> i64 ! alloc {
  return crate::bud_keys::admit_key(inout key, words, false, true);
}

// Native UTF-8 already pairs supplementary characters. Escape literal U+E000
// the same way as packed admission does.
fn native_key(text: str) -> String ! alloc
  requires len(text) <= 549755813888
{
  let mut key: String = string_new();
  let mut start: i64 = 0;
  let mut i: i64 = 0;
  while i < len(text)
    invariant 0 <= start && start <= i && i <= len(text)
    invariant is_char_boundary(text, start) && len(key) <= 2 * start
    decreases len(text) - i
  {
    if i < len(text) - 2 && text[i] == 238 && text[i + 1] == 128 && text[i + 2] == 128
      && is_char_boundary(text, i) && is_char_boundary(text, i + 3) {
      key = string_push_str(move key, substr(text, start, i));
      key = string_push_str(move key, "");
      start = i + 3;
      i = start;
    } else {
      i = i + 1;
    }
  }
  key = string_push_str(move key, substr(text, start, len(text)));
  return move key;
}

// True when native text contains literal U+E000 and must be escaped.
fn needs_escape(text: str) -> bool {
  let mut i: i64 = 0;
  while i < len(text) - 2
    invariant 0 <= i && i <= len(text)
    decreases len(text) - i
  {
    if text[i] == 238 && text[i + 1] == 128 && text[i + 2] == 128 { return true; }
    i = i + 1;
  }
  return false;
}

pub fn frame_end(words: [i64]) -> bool {
  return len(words) == 0;
}

pub struct Run { ordinal: i64, waiting: bool }
pub struct Activity { ordinal: i64 }
pub struct Sess { ordinal: i64, blob: Vec<i64> }
pub struct Clock {
  ordinal: i64, owner: String, timing: ClockTiming,
  runs: HashMap<String, Run>, next_runs: i64
}
pub struct Tool { ordinal: i64, activities: HashMap<String, Activity>, next_activities: i64 }
pub struct St {
  sessions: HashMap<String, Sess>, next_sessions: i64,
  clocks: HashMap<String, Clock>, next_clocks: i64,
  tools: HashMap<String, Tool>, next_tools: i64
}

pub enum Outcome { Invalid, Changed(value: bool), Count(value: i64), Missing, MissingClock, Found }
pub struct ClockTiming { present: bool, since: i64, armed: bool, deadline: i64 }
pub enum ClockInput { Invalid, Valid(value: ClockTiming) }
pub enum WaitingInput { Invalid, Valid(value: bool) }
pub struct Named { ordinal: i64, key: String }
pub struct SessionView { ordinal: i64, key: String, blob: Vec<i64> }
pub struct RunView { parent: i64, ordinal: i64, key: String, waiting: bool }
pub struct ClockView {
  ordinal: i64, key: String, owner: String, timing: ClockTiming, run_count: i64
}
pub struct ActivityView { parent: i64, ordinal: i64, key: String }
pub struct Reply {
  outcome: Outcome, blob: Vec<i64>, names: Vec<Named>,
  sessions: Vec<SessionView>, clocks: Vec<ClockView>, runs: Vec<RunView>,
  activities: Vec<ActivityView>
}

fn reply(outcome: Outcome) -> Reply ! alloc
  ensures len(result.clocks) == 0
{
  return Reply { outcome: outcome, blob: vec_new::<i64>(), names: vec_new::<Named>(),
    sessions: vec_new::<SessionView>(), clocks: vec_new::<ClockView>(), runs: vec_new::<RunView>(),
    activities: vec_new::<ActivityView>() };
}

fn owned_text(key: str) -> String ! alloc {
  return string_push_str(string_new(), key);
}

fn blob_copy(blob: [i64]) -> Vec<i64> ! alloc {
  let mut result: Vec<i64> = vec_new::<i64>();
  let mut i: i64 = 0;
  while i < len(blob)
    invariant 0 <= i && i <= len(blob) && len(result) == i
    decreases len(blob) - i
  {
    result = vec_push::<i64>(move result, blob[i]);
    i = i + 1;
  }
  return move result;
}


fn clock_view(key: str, clock: Clock) -> ClockView ! alloc {
  return ClockView { ordinal: clock.ordinal, key: owned_text(key), owner: owned_text(string_to_str(clock.owner)),
    timing: clock.timing, run_count: len(clock.runs) };
}

fn append_runs(inout output: Reply, clock: Clock) -> () ! alloc {
  for (key, item) in clock.runs {
    if len(output.runs) < 1099511627776 {
      output.runs = vec_push::<RunView>(move output.runs,
        RunView { parent: clock.ordinal, ordinal: item.ordinal, key: owned_text(key), waiting: item.waiting });
    }
  }
}

fn append_name(inout output: Reply, ordinal: i64, key: str) -> () ! alloc {
  if len(output.names) < 1099511627776 {
    output.names = vec_push::<Named>(move output.names, Named { ordinal: ordinal, key: owned_text(key) });
  }
}

fn count_runs(st: St) -> i64 {
  let mut count: i64 = 0;
  for (key, item) in st.clocks invariant 0 <= count {
    if count <= 9223370937343148031 {
      count = count + len(item.runs);
    }
  }
  return count;
}
fn count_activities(st: St) -> i64 {
  let mut count: i64 = 0;
  for (key, item) in st.tools invariant 0 <= count {
    if count <= 9223370937343148031 {
      count = count + len(item.activities);
    }
  }
  return count;
}
pub fn session_put(inout st: St, key: str, blob: [i64]) -> Reply ! alloc {
  if len(key) > 549755813888 { return reply(Outcome::Invalid); }
  if !needs_escape(key) { return session_put_admitted(inout st, key, blob); }
  let key_key: String = native_key(key);
  return session_put_admitted(inout st, string_to_str(key_key), blob);
}

pub fn session_put_admitted(inout st: St, key: str, blob: [i64]) -> Reply ! alloc {
  let mut fresh: bool = false;
  match map_get_mut::<String, Sess>(inout st.sessions, key) {
    Some(session) => {
      // Replace in place: reuse the stored buffer instead of allocating a fresh copy.
      vec_clear::<i64>(inout session.blob);
      let mut i: i64 = 0;
      while i < len(blob)
        invariant 0 <= i && i <= len(blob) && len(session.blob) == i
        decreases len(blob) - i
      {
        session.blob = vec_push::<i64>(move session.blob, blob[i]);
        i = i + 1;
      }
    }
    None => { fresh = true; }
  }
  if !fresh { return reply(Outcome::Changed(false)); }
  let ordinal: i64 = st.next_sessions;
  if ordinal < 0 || ordinal >= 1099511627775 || len(st.sessions) >= 1099511627776 { return reply(Outcome::Invalid); }
  st.next_sessions = ordinal + 1;
  st.sessions = map_insert::<String, Sess>(move st.sessions, owned_text(key),
    Sess { ordinal: ordinal, blob: blob_copy(blob) });
  return reply(Outcome::Changed(true));
}

pub fn clock_put(inout st: St, key: str, owner: str) -> Reply ! alloc {
  if len(key) > 549755813888 || len(owner) > 549755813888 { return reply(Outcome::Invalid); }
  if !needs_escape(key) && !needs_escape(owner) { return clock_put_admitted(inout st, key, owner); }
  let key_key: String = native_key(key);
  let owner_key: String = native_key(owner);
  return clock_put_admitted(inout st, string_to_str(key_key), string_to_str(owner_key));
}

pub fn clock_put_admitted(inout st: St, key: str, owner: str) -> Reply ! alloc {
  let mut fresh: bool = false;
  match map_get_mut::<String, Clock>(inout st.clocks, key) {
    Some(clock) => { clock.owner = owned_text(owner); }
    None => { fresh = true; }
  }
  if !fresh { return reply(Outcome::Changed(false)); }
  let ordinal: i64 = st.next_clocks;
  if ordinal < 0 || ordinal >= 1099511627775 || len(st.clocks) >= 1099511627776 { return reply(Outcome::Invalid); }
  st.next_clocks = ordinal + 1;
  st.clocks = map_insert::<String, Clock>(move st.clocks, owned_text(key),
    Clock { ordinal: ordinal, owner: owned_text(owner),
            timing: ClockTiming { present: false, since: 0, armed: false, deadline: 0 },
            runs: map_new::<String, Run>(), next_runs: 0 });
  return reply(Outcome::Changed(true));
}

pub fn clock_set(inout st: St, key: str, timing: ClockTiming) -> Reply ! alloc {
  if len(key) > 549755813888 { return reply(Outcome::Invalid); }
  if !needs_escape(key) { return clock_set_admitted(inout st, key, timing); }
  let key_key: String = native_key(key);
  return clock_set_admitted(inout st, string_to_str(key_key), timing);
}

pub fn clock_set_admitted(inout st: St, key: str, timing: ClockTiming) -> Reply ! alloc {
  let mut found: i64 = 0;
  match map_get_mut::<String, Clock>(inout st.clocks, key) {
    Some(clock) => {
      clock.timing = timing;
      found = 1;
    }
    None => {}
  }
  return reply(Outcome::Changed(found == 1));
}

fn run_set(inout clock: Clock, key: str, waiting: bool) -> i64 ! alloc {
  let mut fresh: bool = false;
  match map_get_mut::<String, Run>(inout clock.runs, key) {
    Some(run) => { run.waiting = waiting; }
    None => { fresh = true; }
  }
  if !fresh { return 0; }
  let ordinal: i64 = clock.next_runs;
  if ordinal < 0 || ordinal >= 1099511627775 || len(clock.runs) >= 1099511627776 { return -1; }
  clock.next_runs = ordinal + 1;
  clock.runs = map_insert::<String, Run>(move clock.runs, owned_text(key), Run { ordinal: ordinal, waiting: waiting });
  return 1;
}

fn activity_note(inout tool: Tool, key: str) -> i64 ! alloc {
  let mut seen: bool = false;
  match map_get::<String, Activity>(tool.activities, key) {
    Some(item) => { seen = true; }
    None => {}
  }
  if seen { return 0; }
  let ordinal: i64 = tool.next_activities;
  if ordinal < 0 || ordinal >= 1099511627775 || len(tool.activities) >= 1099511627776 { return -1; }
  tool.next_activities = ordinal + 1;
  tool.activities = map_insert::<String, Activity>(move tool.activities, owned_text(key), Activity { ordinal: ordinal });
  return 1;
}

pub fn tool_note(inout st: St, key: str, activity: str) -> Reply ! alloc {
  if len(key) > 549755813888 || len(activity) > 549755813888 { return reply(Outcome::Invalid); }
  if !needs_escape(key) && !needs_escape(activity) { return tool_note_admitted(inout st, key, activity); }
  let key_key: String = native_key(key);
  let activity_key: String = native_key(activity);
  return tool_note_admitted(inout st, string_to_str(key_key), string_to_str(activity_key));
}

pub fn tool_note_admitted(inout st: St, key: str, activity: str) -> Reply ! alloc {
  let mut fresh: bool = false;
  let mut value: i64 = 0;
  match map_get_mut::<String, Tool>(inout st.tools, key) {
    Some(tool) => { value = activity_note(inout tool, activity); }
    None => { fresh = true; }
  }
  if value < 0 { return reply(Outcome::Invalid); }
  if !fresh { return reply(Outcome::Changed(value == 1)); }
  let ordinal: i64 = st.next_tools;
  if ordinal < 0 || ordinal >= 1099511627775 || len(st.tools) >= 1099511627776 { return reply(Outcome::Invalid); }
  let mut tool: Tool = Tool { ordinal: ordinal, activities: map_new::<String, Activity>(),
                              next_activities: 0 };
  let added: i64 = activity_note(inout tool, activity);
  st.next_tools = ordinal + 1;
  st.tools = map_insert::<String, Tool>(move st.tools, owned_text(key), move tool);
  return reply(Outcome::Changed(added == 1));
}


pub fn session_get(st: St, key: str) -> Reply ! alloc {
  if len(key) > 549755813888 { return reply(Outcome::Invalid); }
  if !needs_escape(key) { return session_get_admitted(st, key); }
  let key_key: String = native_key(key);
  return session_get_admitted(st, string_to_str(key_key));
}

pub fn session_get_admitted(st: St, key: str) -> Reply ! alloc {
  match map_get::<String, Sess>(st.sessions, key) {
    Some(session) => {
      let mut output: Reply = reply(Outcome::Found);
      output.blob = blob_copy(session.blob);
      return output;
    }
    None => { return reply(Outcome::Missing); }
  }
}

pub fn session_remove(inout st: St, key: str) -> Reply ! alloc {
  if len(key) > 549755813888 { return reply(Outcome::Invalid); }
  if !needs_escape(key) { return session_remove_admitted(inout st, key); }
  let key_key: String = native_key(key);
  return session_remove_admitted(inout st, string_to_str(key_key));
}

pub fn session_remove_admitted(inout st: St, key: str) -> Reply ! alloc {
  return reply(Outcome::Changed(map_remove::<String, Sess>(inout st.sessions, key)));
}

pub fn session_list(st: St) -> Reply ! alloc {
  let mut output: Reply = reply(Outcome::Found);
  for (key, item) in st.sessions { append_name(inout output, item.ordinal, key); }
  return output;
}

pub fn clock_remove(inout st: St, key: str) -> Reply ! alloc {
  if len(key) > 549755813888 { return reply(Outcome::Invalid); }
  if !needs_escape(key) { return clock_remove_admitted(inout st, key); }
  let key_key: String = native_key(key);
  return clock_remove_admitted(inout st, string_to_str(key_key));
}

pub fn clock_remove_admitted(inout st: St, key: str) -> Reply ! alloc {
  return reply(Outcome::Changed(map_remove::<String, Clock>(inout st.clocks, key)));
}

pub fn clock_get(st: St, key: str) -> Reply ! alloc {
  if len(key) > 549755813888 { return reply(Outcome::Invalid); }
  if !needs_escape(key) { return clock_get_admitted(st, key); }
  let key_key: String = native_key(key);
  return clock_get_admitted(st, string_to_str(key_key));
}

pub fn clock_get_admitted(st: St, key: str) -> Reply ! alloc {
  match map_get::<String, Clock>(st.clocks, key) {
    Some(clock) => {
      let mut output: Reply = reply(Outcome::Found);
      output.clocks = vec_push::<ClockView>(move output.clocks, clock_view(key, clock));
      return output;
    }
    None => { return reply(Outcome::Missing); }
  }
}

pub fn run_put(inout st: St, key: str, run: str, waiting: bool) -> Reply ! alloc {
  if len(key) > 549755813888 || len(run) > 549755813888 { return reply(Outcome::Invalid); }
  if !needs_escape(key) && !needs_escape(run) { return run_put_admitted(inout st, key, run, waiting); }
  let key_key: String = native_key(key);
  let run_key: String = native_key(run);
  return run_put_admitted(inout st, string_to_str(key_key), string_to_str(run_key), waiting);
}

pub fn run_put_admitted(inout st: St, key: str, run: str, waiting: bool) -> Reply ! alloc {
  let mut value: i64 = 2;
  match map_get_mut::<String, Clock>(inout st.clocks, key) {
    Some(clock) => { value = run_set(inout clock, run, waiting); }
    None => {}
  }
  if value < 0 { return reply(Outcome::Invalid); }
  if value == 2 { return reply(Outcome::MissingClock); }
  return reply(Outcome::Changed(value == 1));
}

// Q admission converts untyped fields into the arguments accepted by the entries.
pub fn clock_input(fields: [i64]) -> ClockInput {
  if len(fields) != 4 { return ClockInput::Invalid; }
  if (fields[0] != 0 && fields[0] != 1) || (fields[2] != 0 && fields[2] != 1) {
    return ClockInput::Invalid;
  }
  return ClockInput::Valid(ClockTiming { present: fields[0] == 1, since: fields[1],
    armed: fields[2] == 1, deadline: fields[3] });
}

pub fn waiting_input(fields: [i64]) -> WaitingInput {
  if len(fields) != 1 { return WaitingInput::Invalid; }
  if fields[0] != 0 && fields[0] != 1 { return WaitingInput::Invalid; }
  return WaitingInput::Valid(fields[0] == 1);
}

pub fn blob_frame(rest: [i64]) -> bool {
  if len(rest) < 1 { return false; }
  return rest[0] == len(rest) - 1;
}

pub fn run_remove(inout st: St, key: str, run: str) -> Reply ! alloc {
  if len(key) > 549755813888 || len(run) > 549755813888 { return reply(Outcome::Invalid); }
  if !needs_escape(key) && !needs_escape(run) { return run_remove_admitted(inout st, key, run); }
  let key_key: String = native_key(key);
  let run_key: String = native_key(run);
  return run_remove_admitted(inout st, string_to_str(key_key), string_to_str(run_key));
}

pub fn run_remove_admitted(inout st: St, key: str, run: str) -> Reply ! alloc {
  let mut found: bool = false;
  match map_get_mut::<String, Clock>(inout st.clocks, key) {
    Some(clock) => { found = map_remove::<String, Run>(inout clock.runs, run); }
    None => {}
  }
  return reply(Outcome::Changed(found));
}

pub fn run_list(st: St, key: str) -> Reply ! alloc {
  if len(key) > 549755813888 { return reply(Outcome::Invalid); }
  if !needs_escape(key) { return run_list_admitted(st, key); }
  let key_key: String = native_key(key);
  return run_list_admitted(st, string_to_str(key_key));
}

pub fn run_list_admitted(st: St, key: str) -> Reply ! alloc {
  match map_get::<String, Clock>(st.clocks, key) {
    Some(clock) => {
      let mut output: Reply = reply(Outcome::Found);
      append_runs(inout output, clock);
      return output;
    }
    None => { return reply(Outcome::Missing); }
  }
}

pub fn clock_list(st: St) -> Reply ! alloc {
  let mut output: Reply = reply(Outcome::Found);
  for (key, item) in st.clocks { append_name(inout output, item.ordinal, key); }
  return output;
}

pub fn tool_remove(inout st: St, key: str) -> Reply ! alloc {
  if len(key) > 549755813888 { return reply(Outcome::Invalid); }
  if !needs_escape(key) { return tool_remove_admitted(inout st, key); }
  let key_key: String = native_key(key);
  return tool_remove_admitted(inout st, string_to_str(key_key));
}

pub fn tool_remove_admitted(inout st: St, key: str) -> Reply ! alloc {
  return reply(Outcome::Changed(map_remove::<String, Tool>(inout st.tools, key)));
}

pub fn tool_count(st: St, key: str) -> Reply ! alloc {
  if len(key) > 549755813888 { return reply(Outcome::Invalid); }
  if !needs_escape(key) { return tool_count_admitted(st, key); }
  let key_key: String = native_key(key);
  return tool_count_admitted(st, string_to_str(key_key));
}

pub fn tool_count_admitted(st: St, key: str) -> Reply ! alloc {
  match map_get::<String, Tool>(st.tools, key) {
    Some(tool) => { return reply(Outcome::Count(len(tool.activities))); }
    None => { return reply(Outcome::Count(0)); }
  }
}

pub fn activity_list(st: St, key: str) -> Reply ! alloc {
  if len(key) > 549755813888 { return reply(Outcome::Invalid); }
  if !needs_escape(key) { return activity_list_admitted(st, key); }
  let key_key: String = native_key(key);
  return activity_list_admitted(st, string_to_str(key_key));
}

pub fn activity_list_admitted(st: St, key: str) -> Reply ! alloc {
  let mut output: Reply = reply(Outcome::Found);
  match map_get::<String, Tool>(st.tools, key) {
    Some(tool) => {
      for (activity, item) in tool.activities { append_name(inout output, item.ordinal, activity); }
    }
    None => {}
  }
  return output;
}

pub fn tool_list(st: St) -> Reply ! alloc {
  let mut output: Reply = reply(Outcome::Found);
  for (key, item) in st.tools { append_name(inout output, item.ordinal, key); }
  return output;
}

pub fn live_count(st: St) -> Reply ! alloc {
  let roots: i64 = len(st.sessions) + len(st.clocks) + len(st.tools);
  let runs: i64 = count_runs(st);
  let activities: i64 = count_activities(st);
  if 0 <= runs && runs <= 4611683819404132351 && 0 <= activities && activities <= 4611683819404132351 {
    return reply(Outcome::Count(roots + runs + activities));
  }
  return reply(Outcome::Invalid);
}

fn append_activities(inout output: Reply, tool: Tool) -> () ! alloc {
  for (key, item) in tool.activities {
    if len(output.activities) < 1099511627776 {
      output.activities = vec_push::<ActivityView>(move output.activities,
        ActivityView { parent: tool.ordinal, ordinal: item.ordinal, key: owned_text(key) });
    }
  }
}

pub fn m4_observe(st: St) -> Reply ! alloc {
  let mut output: Reply = reply(Outcome::Found);
  for (key, item) in st.sessions {
    if len(output.sessions) < 1099511627776 {
      output.sessions = vec_push::<SessionView>(move output.sessions,
        SessionView { ordinal: item.ordinal, key: owned_text(key), blob: blob_copy(item.blob) });
    }
  }
  for (key, item) in st.clocks {
    if len(output.clocks) < 1099511627776 {
      output.clocks = vec_push::<ClockView>(move output.clocks, clock_view(key, item));
    }
    append_runs(inout output, item);
  }
  for (key, item) in st.tools {
    append_name(inout output, item.ordinal, key);
    append_activities(inout output, item);
  }
  return output;
}
