pub struct Ordinal { value: i64 }
pub struct ToolTurn { ordinal: i64, activities: HashMap<String, i64> }
pub struct St {
  sessions: HashMap<String, crate::bud_tstate::Budget>,
  ordinals: HashMap<String, Ordinal>,
  next_session: i64,
  wire: Wire,
  clock_state: crate::bud_tstate::ClockState,
  clock_order: Vec<String>,
  clock_ordinals: Vec<i64>,
  tools: HashMap<String, ToolTurn>
}

trusted rust fn decode_admitted_key(words: [i64]) -> String ! alloc
  ensures true = "::m12_facts::decode_admitted_key";
trusted rust fn native_key(value: str) -> String ! alloc
  ensures true = "::m12_facts::native_key";

pub struct PackedKey { value: String }

fn packed_key_ok(words: [i64]) -> bool
{ return crate::bud_keys::rec_end(words, 0) == len(words); }

pub fn admit_packed_key(inout key: PackedKey, words: [i64], optional: bool) -> i64 ! alloc
{
  if len(words) == 0 {
    if !optional { return 2; }
    key.value = string_new();
    return 0;
  }
  if !packed_key_ok(words) { return 2; }
  key.value = decode_admitted_key(words);
  return 0;
}

fn decode_key(words: [i64]) -> String ! alloc
{
  if !packed_key_ok(words) { return string_new(); }
  return decode_admitted_key(words);
}

fn text(s: str) -> String ! alloc
{ return string_push_str(string_new(), s); }

fn words_array(words: Vec<i64>) -> [i64] ! alloc
{
  let n: i64 = len(words);
  let mut out: [i64] = alloc(n, 0);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n == len(words) && len(out) == n
    decreases n - i
  {
    out[i] = vec_get::<i64>(words, i);
    i = i + 1;
  }
  return out;
}


// A typed arena preserves duplicate keys and wire order. Links are node IDs,
// with 0 denoting an absent value. Text occupies one String per actual value.
pub struct WireNode {
  key: String, text: String, tag: i64, scalar: i64,
  children: i64, count: i64, next: i64
}
pub struct Wire {
  nodes: HashMap<i64, WireNode>, next: i64, prepared_budget: i64, prepared_ticket: i64
}

trusted rust fn v_units(words: [i64], at: i64, count: i64) -> String ! alloc
  ensures true = "::m12_facts::v_units";
trusted rust fn j_units(packet: [u8], at: i64, count: i64) -> String ! alloc
  ensures true = "::m12_facts::j_units";
trusted rust fn wire_units(s: str) -> Vec<i64> ! alloc
  ensures true = "::m12_facts::wire_units";

fn append_node(inout wire: Wire, take node: WireNode) -> i64 ! alloc
{
  let id: i64 = wire.next;
  if id <= 0 || id >= 9223372036854775807 || len(wire.nodes) >= 1099511627776 { return 0; }
  wire.next = id + 1;
  wire.nodes = map_insert::<i64, WireNode>(move wire.nodes, id, move node);
  return id;
}

fn j_count(packet: [u8], at: i64) -> i64
  ensures 0 <= result && result <= 4294967295
{
  if at < 0 || at > len(packet) - 4 { return 0; }
  return load_be(packet, at, 4);
}

fn j_bits(packet: [u8], at: i64) -> i64
{
  if at < 0 || at > len(packet) - 8 { return 0; }
  return load_be(packet, at, 8);
}

fn safe_int(bits: i64) -> bool
{
  if bits == 0 { return true; }
  let e: i64 = band(ushr(bits, 52), 2047);
  if e < 1023 || e > 1075 { return false; }
  if e == 1075 { return true; }
  return band(bits, ushr(-1, 12 + e - 1023)) == 0;
}

fn int_val(bits: i64) -> i64
{
  let e: i64 = band(ushr(bits, 52), 2047);
  if e < 1023 || e > 1075 { return 0; }
  let mag: i64 = ushr(band(bits, 4503599627370495) + 4503599627370496, 1075 - e);
  if bits < 0 { return 0 - mag; }
  return mag;
}

fn link(inout wire: Wire, at: i64, next: i64) -> ()
{
  match map_get_mut::<i64, WireNode>(inout wire.nodes, at) {
    Some(n) => { n.next = next; }
    None => {}
  }
}

// Both wire formats have already passed full admission at their entry point.
fn read_node(inout wire: Wire, v: [i64], j: [u8], jb: bool, at: i64,
             take key: String, depth: i64) -> i64 ! alloc
  requires 0 <= depth && depth <= 64
  decreases 64 - depth
{
  if depth >= 64 || at < 0 || at > 1099511627776 { return 0; }
  let mut tag: i64 = rd(v, at);
  if jb {
    if at >= len(j) { return 0; }
    tag = j[at];
  }
  let mut node: WireNode = WireNode {
    key: move key, text: string_new(), tag: tag, scalar: 0, children: 0, count: 0, next: 0
  };
  if tag == 6 {
    if jb { node.text = j_units(j, at + 5, j_count(j, at + 1)); }
    else { node.text = v_units(v, at + 2, rd(v, at + 1)); }
  }
  if tag == 5 || tag == 7 {
    if jb {
      let bits: i64 = j_bits(j, at + 1);
      if safe_int(bits) { node.tag = 5; node.scalar = int_val(bits); }
      else { node.scalar = bits; }
    } else { node.scalar = rd(v, at + 1); }
  }
  if tag == 8 || tag == 9 {
    let mut pos: i64 = at + 2;
    let mut count: i64 = crate::bud_store::c40(rd(v, at + 1));
    if jb { count = j_count(j, at + 1); pos = at + 5; }
    let mut i: i64 = 0;
    let mut last: i64 = 0;
    while i < count
      invariant 0 <= i && i <= count && 0 <= depth && depth < 64 && 0 <= pos && pos <= 1099511627781
      decreases count - i
    {
      if pos > 1099511627776 { return 0; }
      let mut name: String = string_new();
      if tag == 9 {
        if jb {
          let size: i64 = j_count(j, pos);
          name = j_units(j, pos + 4, size);
          pos = pos + 4 + size;
        } else {
          let size: i64 = crate::bud_store::c40(rd(v, pos));
          name = v_units(v, pos + 1, size);
          pos = pos + 1 + size;
        }
      }
      let child: i64 = read_node(inout wire, v, j, jb, pos, move name, depth + 1);
      if child == 0 { return 0; }
      if i == 0 { node.children = child; }
      else { link(inout wire, last, child); }
      last = child;
      let mut end: i64 = 0;
      if jb { end = crate::bud_card::j_end(j, pos); }
      else { end = crate::bud_card::v_end(v, pos); }
      if end <= pos || end > 1099511627776 { return 0; }
      pos = end;
      i = i + 1;
    }
    node.count = count;
  }
  return append_node(inout wire, move node);
}

fn delete_node(inout wire: Wire, id: i64, depth: i64) -> i64
  requires 0 <= depth && depth <= 64
  decreases depth
{
  if id == 0 || depth == 0 { return 0; }
  match map_take::<i64, WireNode>(inout wire.nodes, id) {
    Some(n) => {
      let mut at: i64 = n.children;
      let mut left: i64 = n.count;
      while at != 0 && left > 0
        invariant 0 < depth && depth <= 64
        decreases left
      {
        at = delete_node(inout wire, at, depth - 1);
        left = left - 1;
      }
      return n.next;
    }
    None => {}
  }
  return 0;
}

fn node_next(wire: Wire, id: i64) -> i64
{
  match map_get::<i64, WireNode>(wire.nodes, id) {
    Some(n) => { return n.next; }
    None => {}
  }
  return 0;
}

fn write_text(take incoming: Vec<i64>, s: str) -> Vec<i64> ! alloc
{
  let words: Vec<i64> = wire_units(s);
  let mut out: Vec<i64> = move incoming;
  let mut i: i64 = 0;
  while i < len(words) && len(out) < 1099511627776
    invariant 0 <= i && i <= len(words)
    decreases len(words) - i
  {
    out = vec_push::<i64>(move out, vec_get::<i64>(words, i));
    i = i + 1;
  }
  return move out;
}

// A synthetic stop always has a fixed shape. Its only variable field is
// sessionId, stored as text on the node.
fn synthetic_tag() -> i64 { return 10; }

fn push_word(take out: Vec<i64>, word: i64) -> Vec<i64> ! alloc
{
  if len(out) == 1099511627776 { return move out; }
  return vec_push::<i64>(move out, word);
}

fn write_synthetic(take incoming: Vec<i64>, sid: str) -> Vec<i64> ! alloc
{
  let mut out: Vec<i64> = move incoming;
  out = write_text(move out, "autoContinue");
  out = push_word(move out, 9);
  out = push_word(move out, 4);
  out = write_text(move out, "sessionId");
  out = push_word(move out, 6);
  out = write_text(move out, sid);
  out = write_text(move out, "userTurnId");
  out = push_word(move out, 6);
  out = push_word(move out, 0);
  out = write_text(move out, "count");
  out = push_word(move out, 5);
  out = push_word(move out, 0);
  out = write_text(move out, "stopped");
  return push_word(move out, 4);
}

fn write_node(wire: Wire, id: i64, keyed: bool, depth: i64,
              take incoming: Vec<i64>) -> Vec<i64> ! alloc
  requires 0 <= depth && depth <= 64
  decreases depth
{
  let mut out: Vec<i64> = move incoming;
  if depth == 0 || len(out) >= 1099511627774 { return move out; }
  match map_get::<i64, WireNode>(wire.nodes, id) {
    Some(n) => {
      if n.tag == synthetic_tag() { return write_synthetic(move out, string_to_str(n.text)); }
      if keyed { out = write_text(move out, string_to_str(n.key)); }
      if len(out) >= 1099511627774 { return move out; }
      out = vec_push::<i64>(move out, n.tag);
      if n.tag == 5 || n.tag == 7 { out = vec_push::<i64>(move out, n.scalar); }
      else if n.tag == 6 { out = write_text(move out, string_to_str(n.text)); }
      else if n.tag == 8 || n.tag == 9 {
        out = vec_push::<i64>(move out, n.count);
        let mut child: i64 = n.children;
        let mut left: i64 = n.count;
        while child != 0 && left > 0
          invariant 0 < depth && depth <= 64
          decreases left
        {
          out = write_node(wire, child, n.tag == 9, depth - 1, move out);
          child = node_next(wire, child);
          left = left - 1;
        }
      }
    }
    None => {}
  }
  return move out;
}

fn budget_words(wire: Wire, b: crate::bud_tstate::Budget) -> [i64] ! alloc
{ return words_array(write_node(wire, b.metadata, false, 64, vec_new::<i64>())); }

fn replace_wire(inout wire: Wire, old: i64, blob: [i64]) -> i64 ! alloc
{
  // Read the new tree first; keep the old root if the new one cannot be stored.
  let mut fresh: i64 = 0;
  if len(blob) != 0 {
    let empty: [u8] = alloc(0, 0);
    fresh = read_node(inout wire, blob, empty, false, 0, string_new(), 2);
    if fresh == 0 { return old; }
  }
  let ignored: i64 = delete_node(inout wire, old, 64);
  return fresh;
}
fn make_budget(wire: Wire, root: i64) -> crate::bud_tstate::Budget ! alloc
{
  let id: String = node_string(wire, find_field(wire, root, "id").id);
  let pos: i64 = find_field(wire, root, "state").id;
  let mut state: i64 = 2;
  if root == 0 { state = -1; }
  if node_text_is(wire, pos, "open") { state = 0; }
  if node_text_is(wire, pos, "halted") { state = 1; }
  let limits: i64 = find_field(wire, root, "limits").id;
  let used: i64 = find_field(wire, root, "used").id;
  let halt: i64 = find_field(wire, root, "halt").id;
  let reason: i64 = find_field(wire, halt, "reason").id;
  let mut code: i64 = 0;
  while code < 5 && !node_text_is(wire, reason, named(code))
    invariant 0 <= code && code <= 5
    decreases 5 - code
  { code = code + 1; }
  if code == 5 { code = -1; }
  return crate::bud_tstate::Budget {
    id: move id, state: state, unlimited: node_truthy(wire, find_field(wire, root, "unlimited").id), unlimited_kind: 0,
    limits: crate::bud_tstate::Limits { time: node_num(wire, find_field(wire, limits, "timeMinutes").id),
      delegations: node_num(wire, find_field(wire, limits, "delegations").id), commands: node_num(wire, find_field(wire, limits, "commands").id),
      reviews: node_num(wire, find_field(wire, limits, "reviews").id), checks: node_num(wire, find_field(wire, limits, "checks").id) },
    active_ms: node_num(wire, find_field(wire, used, "activeMs").id), active_since: -1, since_kind: -1,
    delegations: node_num(wire, find_field(wire, used, "delegations").id), commands: node_num(wire, find_field(wire, used, "commands").id),
    reviews: node_num(wire, find_field(wire, used, "reviews").id), checks: node_num(wire, find_field(wire, used, "checks").id),
    tools: node_num(wire, find_field(wire, used, "tools").id), failures: node_num(wire, find_field(wire, used, "failures").id),
    retries: node_num(wire, find_field(wire, used, "retries").id), metadata: root, origin: 0,
    opened_at: string_new(), since_text: string_new(), ended_at: string_new(), follows: string_new(),
    ended_how: 0, ended_kind: 0, ended_ms: 0, opened_ms: 0, follows_kind: 0,
    rest: string_new(), halt_reason: code,
    halt_kind: 0, halt_ms: 0,
    halt_text: string_new(), stopped: vec_new::<String>()
  };
}

pub struct Loaded { status: i64, fresh: bool }
pub struct BudgetInput { root: i64, ticket: i64, valid: bool }

trusted rust fn next_budget_ticket() -> i64 ! io
  ensures true = "::m12_facts::next_budget_ticket";

fn prepared(inout st: St, root: i64) -> BudgetInput ! alloc, io
{
  if root == 0 { return BudgetInput { root: 0, ticket: 0, valid: false }; }
  let ticket: i64 = next_budget_ticket();
  let previous: i64 = st.wire.prepared_budget;
  let ignored: i64 = delete_node(inout st.wire, previous, 64);
  st.wire.prepared_budget = root;
  st.wire.prepared_ticket = ticket;
  return BudgetInput { root: root, ticket: ticket, valid: true };
}

pub fn decode_budget(inout st: St, blob: [i64]) -> BudgetInput ! alloc, io
{
  if len(blob) == 0 { return BudgetInput { root: 0, ticket: 0, valid: true }; }
  if crate::bud_card::v_stored_end(blob, 0) != len(blob) { return BudgetInput { root: 0, ticket: 0, valid: false }; }
  let root: i64 = replace_wire(inout st.wire, 0, blob);
  return prepared(inout st, root);
}

pub fn prepare_budget(inout st: St, packet: [u8]) -> BudgetInput ! alloc, io
{
  if len(packet) == 0 { return BudgetInput { root: 0, ticket: 0, valid: true }; }
  if !crate::bud_card::j_ok_at(packet, 2) { return BudgetInput { root: 0, ticket: 0, valid: false }; }
  let root: i64 = read_node(inout st.wire, crate::ent_u16::empty(), packet, true, 0, string_new(), 2);
  return prepared(inout st, root);
}

pub fn load(inout st: St, sid: str, take input: BudgetInput) -> Loaded ! alloc
{
  return load_key(inout st, string_to_str(native_key(sid)), move input);
}

pub fn load_key(inout st: St, sid: str, take input: BudgetInput) -> Loaded ! alloc
{
  let bad: Loaded = Loaded { status: 2, fresh: false };
  if !input.valid || (input.root != 0 && (input.ticket != st.wire.prepared_ticket || input.root != st.wire.prepared_budget)) { return bad; }
  if len(st.sessions) >= 1099511627776 { return bad; }
  let mut fresh: i64 = 1;
  match map_get::<String, Ordinal>(st.ordinals, sid) {
    Some(o) => { fresh = 0; }
    None => {}
  }
  if fresh == 1 {
    if len(st.ordinals) >= 1099511627776 || st.next_session < 0 || st.next_session >= 1099511627775 { return bad; }
    let seq: i64 = st.next_session;
    st.next_session = seq + 1;
    st.ordinals = map_insert::<String, Ordinal>(move st.ordinals, text(sid), Ordinal { value: seq });
  }
  let mut old: i64 = 0;
  match map_get::<String, crate::bud_tstate::Budget>(st.sessions, sid) {
    Some(b) => { old = b.metadata; }
    None => {}
  }
  if input.root != 0 {
    st.wire.prepared_budget = 0;
    st.wire.prepared_ticket = 0;
  }
  let ignored: i64 = delete_node(inout st.wire, old, 64);
  let b: crate::bud_tstate::Budget = make_budget(st.wire, input.root);
  st.sessions = map_insert::<String, crate::bud_tstate::Budget>(move st.sessions, text(sid), move b);
  return Loaded { status: 0, fresh: fresh == 1 };
}

fn session_words(st: St, sid: str) -> [i64] ! alloc
{
  match map_get::<String, crate::bud_tstate::Budget>(st.sessions, sid) {
    Some(b) => { return crate::bud_vwords::cat(crate::ent_u16::one(1), budget_words(st.wire, b)); }
    None => {}
  }
  return crate::ent_u16::empty();
}
fn rd(v: [i64], i: i64) -> i64
{ return crate::ent_u16::rd(v, i); }

// the value at `at` is the string equal to the ASCII literal s
fn str_is(v: [i64], at: i64, s: str) -> bool
{
  if at < 0 || at > 1099511627776 { return false; }
  if rd(v, at) != 6 { return false; }
  let m: i64 = len(s);
  if rd(v, at + 1) != m { return false; }
  let mut j: i64 = 0;
  while j < m
    invariant 0 <= j && j <= m && m == len(s) && 0 <= at && at <= 1099511627776
    decreases m - j
  {
    if rd(v, at + 2 + j) != s[j] { return false; }
    j = j + 1;
  }
  return true;
}

// Last budgetId value in the admitted ref, without a string literal.
fn ref_budget_id(rf: [i64]) -> i64
{
  let n: i64 = len(rf);
  if n < 2 || rf[0] != 9 { return -1; }
  let cnt: i64 = rf[1];
  if cnt < 0 || cnt > n - 2 { return -1; }
  let mut pos: i64 = 2;
  let mut i: i64 = 0;
  let mut found: i64 = -1;
  while i < cnt
    invariant 0 <= i && i <= cnt && 2 <= pos && pos <= n && n == len(rf)
    decreases cnt - i
  {
    if pos >= n { return -1; }
    let kn: i64 = rf[pos];
    if kn < 0 || kn > n - pos - 1 { return -1; }
    let vs: i64 = pos + 1 + kn;
    let end: i64 = crate::bud_card::v_end(rf, vs);
    if end < 0 { return -1; }
    if kn == 8 && rf[pos + 1] == 98 && rf[pos + 2] == 117 && rf[pos + 3] == 100 && rf[pos + 4] == 103 &&
      rf[pos + 5] == 101 && rf[pos + 6] == 116 && rf[pos + 7] == 73 && rf[pos + 8] == 100 { found = vs; }
    pos = end;
    i = i + 1;
  }
  return found;
}

// value position of a JB packet (empty = absent)
fn at_b(b: [u8]) -> i64
{
  if len(b) == 0 { return -1; }
  return 0;
}

fn b01(b: bool) -> i64
  ensures 0 <= result && result <= 1
{
  if b { return 1; }
  return 0;
}

// The timer captures the position of the first reference key, even if a
// later duplicate supplies the budget ID used by the operation itself.
fn timer_budget_first(rf: [i64]) -> bool
{
  let n: i64 = len(rf);
  let count: i64 = rd(rf, 1);
  if rd(rf, 0) != 9 || count < 0 || count > n { return false; }
  let mut pos: i64 = 2;
  let mut i: i64 = 0;
  while i < count
    invariant 0 <= i && i <= count && 0 <= pos && pos <= n + 2
    decreases count - i
  {
    if pos >= n { return false; }
    let size: i64 = rf[pos];
    if size < 0 || size >= n - pos { return false; }
    let at: i64 = pos + 1 + size;
    if size == 8 && rd(rf, pos + 1) == 98 && rd(rf, pos + 2) == 117 &&
      rd(rf, pos + 3) == 100 && rd(rf, pos + 4) == 103 && rd(rf, pos + 5) == 101 &&
      rd(rf, pos + 6) == 116 && rd(rf, pos + 7) == 73 && rd(rf, pos + 8) == 100 { return true; }
    if size == 9 && rd(rf, pos + 1) == 115 && rd(rf, pos + 2) == 101 &&
      rd(rf, pos + 3) == 115 && rd(rf, pos + 4) == 115 && rd(rf, pos + 5) == 105 &&
      rd(rf, pos + 6) == 111 && rd(rf, pos + 7) == 110 && rd(rf, pos + 8) == 73 &&
      rd(rf, pos + 9) == 100 { return false; }
    let end: i64 = crate::bud_card::v_end(rf, at);
    if end <= pos || end > n { return false; }
    pos = end;
    i = i + 1;
  }
  return false;
}

// Build the wire reply before replacing the stored budget.
pub struct RefInput { valid: bool, ids: Vec<String>, has_id: bool, truthy: bool }

pub fn decode_ref(rf: [i64]) -> RefInput ! alloc
{
  let mut result: RefInput = RefInput { valid: false, ids: vec_new::<String>(), has_id: false, truthy: false };
  if len(rf) == 0 || crate::bud_card::v_end(rf, 0) != len(rf) { return result; }
  result.valid = true;
  result.truthy = crate::bud_card::truthy(rf, 0);
  let at: i64 = ref_budget_id(rf);
  if at >= 0 && at <= len(rf) - 2 && rf[at] == 6 && crate::bud_card::v_stored_end(rf, at) > at {
    result.has_id = true;
    result.ids = vec_push::<String>(move result.ids, v_units(rf, at + 2, rd(rf, at + 1)));
  }
  return result;
}

fn ref_id(ids: Vec<String>) -> String ! alloc
{
  if len(ids) > 0 { return text(vec_get::<String>(ids, 0)); }
  return string_new();
}

pub struct Session { present: bool, root: i64 }

pub fn session(st: St, sid: str) -> Session ! alloc
{
  return session_key(st, string_to_str(native_key(sid)));
}

pub fn session_key(st: St, sid: str) -> Session
{
  match map_get::<String, crate::bud_tstate::Budget>(st.sessions, sid) {
    Some(b) => { return Session { present: true, root: b.metadata }; }
    None => {}
  }
  return Session { present: false, root: 0 };
}

pub fn encode_budget(st: St, root: i64) -> [i64] ! alloc
{ return words_array(write_node(st.wire, root, false, 64, vec_new::<i64>())); }

fn current_root(st: St, sid: str, has_sid: bool, bid: str, has_bid: bool) -> i64 ! alloc
{
  if !has_sid || !has_bid { return 0; }
  let view: Session = session_key(st, sid);
  if node_text_is(st.wire, find_field(st.wire, view.root, "id").id, bid) { return view.root; }
  return 0;
}

fn ws_at(b: [u8], i: i64, e: i64) -> i64
  requires 0 <= i && i < e && e <= len(b)
  ensures 0 <= result && result <= e - i
{
  let c: i64 = b[i];
  if c == 32 || (c >= 9 && c <= 13) { return 1; }
  if c < 194 { return 0; }
  if i + 1 < e && c == 194 && b[i + 1] == 160 { return 2; }
  if i + 2 < e {
    let c1: i64 = b[i + 1];
    let c2: i64 = b[i + 2];
    if c == 225 && c1 == 154 && c2 == 128 { return 3; }
    if c == 226 && c1 == 128 && ((c2 >= 128 && c2 <= 138) || c2 == 168 || c2 == 169 || c2 == 175) { return 3; }
    if c == 226 && c1 == 129 && c2 == 159 { return 3; }
    if c == 227 && c1 == 128 && c2 == 128 { return 3; }
    if c == 239 && c1 == 187 && c2 == 191 { return 3; }
  }
  return 0;
}

// byte length of the trim unit ending at e inside [s, e), 0 if none. The lead bytes C2/E1/E2/E3/EF are never
// continuation bytes, so a match is a whole sequence.
fn ws_before(b: [u8], s: i64, e: i64) -> i64
  requires 0 <= s && s < e && e <= len(b)
  ensures 0 <= result && result <= e - s
{
  let c: i64 = b[e - 1];
  if c == 32 || (c >= 9 && c <= 13) { return 1; }
  if c < 128 { return 0; }
  if e - s >= 2 && c == 160 && b[e - 2] == 194 { return 2; }
  if e - s >= 3 && ws_at(b, e - 3, e) == 3 { return 3; }
  return 0;
}

fn tr_s(b: [u8], s: i64, e: i64) -> i64
  requires 0 <= s && s <= e && e <= len(b)
  ensures s <= result && result <= e
{
  let mut i: i64 = s;
  while i < e
    invariant s <= i && i <= e && e <= len(b)
    decreases e - i
  {
    let w: i64 = ws_at(b, i, e);
    if w == 0 { return i; }
    i = i + w;
  }
  return i;
}

fn tr_e(b: [u8], s: i64, e: i64) -> i64
  requires 0 <= s && s <= e && e <= len(b)
  ensures s <= result && result <= e
{
  let mut j: i64 = e;
  while j > s
    invariant s <= j && j <= e && e <= len(b) && 0 <= s
    decreases j - s
  {
    let w: i64 = ws_before(b, s, j);
    if w == 0 { return j; }
    j = j - w;
  }
  return j;
}

fn packet_tag(packet: [u8], at: i64) -> i64
{
  if at < 0 || at >= len(packet) { return 0; }
  return packet[at];
}

fn packet_field(packet: [u8], at: i64, key: str) -> i64 ! alloc
{
  if at < 0 || at > len(packet) - 5 || packet[at] != 9 { return -1; }
  let mut left: i64 = j_count(packet, at + 1);
  let mut pos: i64 = at + 5;
  let mut found: i64 = -1;
  while left > 0
    invariant 0 <= pos && pos <= len(packet)
    decreases left
  {
    if pos > len(packet) - 4 { return -1; }
    let n: i64 = j_count(packet, pos);
    if n > len(packet) - pos - 4 { return -1; }
    let value: i64 = pos + 4 + n;
    let name: String = j_units(packet, pos + 4, n);
    if string_eq(name, key) { found = value; }
    let end: i64 = crate::bud_card::j_end(packet, value);
    if end <= pos || end > len(packet) { return -1; }
    pos = end;
    left = left - 1;
  }
  return found;
}

fn packet_value(inout wire: Wire, packet: [u8], at: i64, key: str) -> i64 ! alloc
{
  if at < 0 { return atom(inout wire, key, 1, "", 0); }
  return read_node(inout wire, crate::ent_u16::empty(), packet, true, at, text(key), 4);
}

fn trimmed(inout wire: Wire, key: str, packet: [u8], at: i64) -> i64 ! alloc
{
  if at < 0 || at > len(packet) - 5 || packet[at] != 6 { return 0; }
  let n: i64 = j_count(packet, at + 1);
  let start: i64 = at + 5;
  if n > len(packet) - start { return 0; }
  let end: i64 = start + n;
  let first: i64 = tr_s(packet, start, end);
  let last: i64 = tr_e(packet, first, end);
  let value: String = j_units(packet, first, last - first);
  return atom(inout wire, key, 6, string_to_str(value), 0);
}

// Append normalized children in the order used by the reference card.
fn card_field(inout wire: Wire, parent: i64, key: str, child: i64) -> ()
{
  let slot: FieldLink = find_field(wire, parent, key);
  replace_field(inout wire, parent, slot, child);
}

fn card_list(inout wire: Wire, key: str, packet: [u8], at: i64, verify: bool) -> i64 ! alloc
{
  if at < 0 || at > len(packet) - 5 || packet[at] != 8 { return 0; }
  let list: i64 = atom(inout wire, key, 8, "", 0);
  let mut left: i64 = j_count(packet, at + 1);
  let mut pos: i64 = at + 5;
  let mut tail: i64 = 0;
  while left > 0
    invariant 0 <= pos && pos <= len(packet)
    decreases left
  {
    let mut item: i64 = 0;
    if verify {
      item = atom(inout wire, "", 9, "", 0);
      let label: i64 = trimmed(inout wire, "label", packet, packet_field(packet, pos, "label"));
      let status: i64 = packet_value(inout wire, packet, packet_field(packet, pos, "status"), "status");
      card_field(inout wire, item, "label", label);
      card_field(inout wire, item, "status", status);
    } else {
      item = trimmed(inout wire, "", packet, pos);
    }
    if item == 0 { return 0; }
    if tail != 0 { link(inout wire, tail, item); }
    match map_get_mut::<i64, WireNode>(inout wire.nodes, list) {
      Some(n) => {
        if tail == 0 { n.children = item; }
        if n.count < 4294967296 { n.count = n.count + 1; }
      }
      None => { return 0; }
    }
    tail = item;
    let end: i64 = crate::bud_card::j_end(packet, pos);
    if end <= pos || end > len(packet) { return 0; }
    pos = end;
    left = left - 1;
  }
  return list;
}

fn card_object(inout wire: Wire, packet: [u8], at: i64, key: str) -> i64 ! alloc
{
  let value: i64 = atom(inout wire, key, 9, "", 0);
  if string_eq(key, "targets") {
    let confirmed: i64 = packet_value(inout wire, packet, packet_field(packet, at, "confirmed"), "confirmed");
    let candidate: i64 = packet_value(inout wire, packet, packet_field(packet, at, "candidate"), "candidate");
    let unknown: i64 = packet_value(inout wire, packet, packet_field(packet, at, "unknown"), "unknown");
    card_field(inout wire, value, "confirmed", confirmed);
    card_field(inout wire, value, "candidate", candidate);
    card_field(inout wire, value, "unknown", unknown);
    let note: i64 = packet_field(packet, at, "note");
    if note >= 0 && note <= len(packet) - 5 && packet[note] == 6 && j_count(packet, note + 1) > 0 {
      let text_note: i64 = packet_value(inout wire, packet, note, "note");
      card_field(inout wire, value, "note", text_note);
    }
  } else {
    let session: i64 = packet_value(inout wire, packet, packet_field(packet, at, "sessionId"), "sessionId");
    let turn: i64 = packet_value(inout wire, packet, packet_field(packet, at, "turnId"), "turnId");
    card_field(inout wire, value, "sessionId", session);
    card_field(inout wire, value, "turnId", turn);
  }
  return value;
}

fn stored_card(inout wire: Wire, card: [u8], f: crate::bud_card::Keys, by: [u8], now: i64) -> i64 ! alloc
  requires -8640000000000000 <= now && now <= 8640000000000000
{
  let root: i64 = atom(inout wire, "card", 9, "", 0);
  let deliverable: i64 = trimmed(inout wire, "deliverable", card, f.p0);
  let done: i64 = card_list(inout wire, "done", card, f.p1, false);
  let iso: [u8] = crate::bud_date::iso(now);
  let date: String = j_units(iso, 0, len(iso));
  let updated: i64 = atom(inout wire, "updatedAt", 6, string_to_str(date), 0);
  card_field(inout wire, root, "deliverable", deliverable);
  card_field(inout wire, root, "done", done);
  card_field(inout wire, root, "updatedAt", updated);
  if packet_tag(card, f.p2) == 9 {
    let targets: i64 = card_object(inout wire, card, f.p2, "targets");
    card_field(inout wire, root, "targets", targets);
  }
  if packet_tag(card, f.p3) == 8 {
    let verify: i64 = card_list(inout wire, "verify", card, f.p3, true);
    card_field(inout wire, root, "verify", verify);
  }
  if packet_tag(card, f.p4) == 8 {
    let conflicts: i64 = card_list(inout wire, "conflicts", card, f.p4, false);
    card_field(inout wire, root, "conflicts", conflicts);
  }
  if packet_tag(card, f.p5) == 6 {
    let state: i64 = packet_value(inout wire, card, f.p5, "state");
    card_field(inout wire, root, "state", state);
  }
  if jb_truthy(by) {
    let owner: i64 = card_object(inout wire, by, at_b(by), "by");
    card_field(inout wire, root, "by", owner);
  }
  return root;
}

pub struct CardResult { status: i64, used_now: bool, root: i64, kind: i64, lang: i64 }

pub fn set_card_decoded(inout st: St, sid: str, has_sid: bool, bid: str, has_bid: bool,
                card: [u8], lang: [u8], by: [u8], now_ms: i64) -> CardResult ! alloc
{
  let bad: CardResult = CardResult { status: 2, used_now: false, root: 0, kind: 0, lang: 0 };
  if now_ms < -8640000000000000 || now_ms > 8640000000000000 { return bad; }
  if len(card) > 0 && !crate::bud_card::j_ok(card) { return bad; }
  if len(lang) > 0 && !crate::bud_card::j_ok(lang) { return bad; }
  if len(by) > 0 && !crate::bud_card::j_ok_at(by, 4) { return bad; }
  let root: i64 = current_root(st, sid, has_sid, bid, has_bid);
  let closed: bool = node_text_is(st.wire, find_field(st.wire, root, "state").id, "closed");
  let lc: i64 = crate::bud_card::lang_code(lang);
  let r: crate::bud_card::Judged = crate::bud_card::judge(root != 0, closed, card, at_b(card), lc);
  if r.kind >= 0 {
    return CardResult { status: 0, used_now: r.used_now, root: 0, kind: r.kind, lang: lc };
  }
  let slot: FieldLink = find_field(st.wire, root, "card");
  let fresh: i64 = stored_card(inout st.wire, card, r.f, by, now_ms);
  if fresh == 0 { return bad; }
  replace_field(inout st.wire, root, slot, fresh);
  return CardResult { status: 0, used_now: true, root: root, kind: 0, lang: 0 };
}

pub fn card_error(kind: i64, lang: i64) -> [u8] ! alloc
{
  if kind < 0 || kind > 6 || lang < 0 || lang > 1 { return alloc(0, 0); }
  return crate::bud_text::card_error(kind, lang);
}

pub struct QueryResult { status: i64, root: i64, value: bool }

pub fn query_decoded(st: St, op: i64, sid: str, has_sid: bool, bid: str, has_bid: bool) -> QueryResult ! alloc
{
  if op < 1 || op > 3 { return QueryResult { status: 2, root: 0, value: false }; }
  let root: i64 = current_root(st, sid, has_sid, bid, has_bid);
  let mut value: bool = false;
  if op == 2 { value = node_text_is(st.wire, find_field(st.wire, root, "state").id, "halted"); }
  if op == 3 { value = node_truthy(st.wire, find_field(st.wire, root, "card").id); }
  return QueryResult { status: 0, root: root, value: value };
}

struct FieldLink { id: i64, prev: i64, next: i64, tail: i64, hits: i64 }

fn find_field(wire: Wire, root: i64, key: str) -> FieldLink
{
  let mut found: FieldLink = FieldLink { id: 0, prev: 0, next: 0, tail: 0, hits: 0 };
  match map_get::<i64, WireNode>(wire.nodes, root) {
    Some(obj) => {
      if obj.tag == 9 {
        let mut at: i64 = obj.children;
        let mut prev: i64 = 0;
        let mut left: i64 = obj.count;
        while at != 0 && left > 0
          decreases left
        {
          match map_get::<i64, WireNode>(wire.nodes, at) {
            Some(n) => {
              if (n.tag != synthetic_tag() && string_eq(n.key, key)) ||
                (n.tag == synthetic_tag() && string_eq(key, "autoContinue")) {
                found.id = at;
                found.prev = prev;
                found.next = n.next;
                if found.hits < 2 { found.hits = found.hits + 1; }
              }
              prev = at;
              at = n.next;
            }
            None => { at = 0; }
          }
          left = left - 1;
        }
        found.tail = prev;
      }
    }
    None => {}
  }
  return found;
}

fn node_truthy(wire: Wire, id: i64) -> bool
{
  match map_get::<i64, WireNode>(wire.nodes, id) {
    Some(n) => {
      if n.tag == 4 || n.tag == 8 || n.tag == 9 || n.tag == synthetic_tag() { return true; }
      if n.tag == 5 { return n.scalar != 0; }
      if n.tag == 6 { return len(n.text) != 0; }
      if n.tag == 7 {
        return band(n.scalar, 9223372036854775807) != 0 && crate::bud_num::count_class(n.scalar) != 3;
      }
    }
    None => {}
  }
  return false;
}

fn node_text_is(wire: Wire, id: i64, text: str) -> bool
{
  match map_get::<i64, WireNode>(wire.nodes, id) {
    Some(n) => { return n.tag == 6 && string_eq(n.text, text); }
    None => {}
  }
  return false;
}

fn node_string(wire: Wire, at: i64) -> String ! alloc
{
  match map_get::<i64, WireNode>(wire.nodes, at) {
    Some(n) => { if n.tag == 6 { return text(string_to_str(n.text)); } }
    None => {}
  }
  return string_new();
}

fn node_num(wire: Wire, at: i64) -> i64
{
  match map_get::<i64, WireNode>(wire.nodes, at) {
    Some(n) => {
      if n.tag == 5 && n.scalar >= -9007199254740991 && n.scalar <= 9007199254740991 { return n.scalar; }
    }
    None => {}
  }
  return 0;
}

fn replace_field(inout wire: Wire, parent: i64, slot: FieldLink, fresh: i64) -> ()
{
  if fresh == 0 { return; }
  let mut prev: i64 = slot.prev;
  if slot.id == 0 { prev = slot.tail; }
  else {
    link(inout wire, fresh, slot.next);
    let ignored: i64 = delete_node(inout wire, slot.id, 64);
  }
  if prev != 0 { link(inout wire, prev, fresh); }
  match map_get_mut::<i64, WireNode>(inout wire.nodes, parent) {
    Some(obj) => {
      if prev == 0 { obj.children = fresh; }
      if slot.id == 0 && obj.count < 1099511627776 { obj.count = obj.count + 1; }
    }
    None => {}
  }
}

fn node_has_tag(wire: Wire, id: i64, tag: i64) -> bool
{
  match map_get::<i64, WireNode>(wire.nodes, id) {
    Some(n) => { return n.tag == tag; }
    None => {}
  }
  return false;
}

fn editable_number(wire: Wire, slot: FieldLink) -> bool
{
  return slot.hits <= 1 && (slot.id == 0 || node_has_tag(wire, slot.id, 5));
}

fn number_node(inout wire: Wire, key: str, value: i64) -> i64 ! alloc
{
  return append_node(inout wire, WireNode {
    key: text(key), text: string_new(), tag: 5, scalar: value,
    children: 0, count: 0, next: 0
  });
}

fn set_wire_number(inout wire: Wire, parent: i64, slot: FieldLink, key: str, value: i64) -> () ! alloc
{
  if slot.id == 0 {
    let fresh: i64 = number_node(inout wire, key, value);
    let tail: FieldLink = find_field(wire, parent, key);
    replace_field(inout wire, parent, tail, fresh);
    return;
  }
  match map_get_mut::<i64, WireNode>(inout wire.nodes, slot.id) {
    Some(n) => { n.scalar = value; }
    None => {}
  }
}

fn wire_room(wire: Wire, extra: i64) -> bool
  requires 0 <= extra && extra <= 1099511627776
{
  return wire.next > 0 && wire.next <= 9223372036854775807 - extra &&
         len(wire.nodes) <= 1099511627776 - extra;
}

fn delete_fields(inout wire: Wire, root: i64, key: str, first: FieldLink) -> () ! alloc
{
  let mut slot: FieldLink = first;
  let mut left: i64 = len(wire.nodes);
  while slot.id != 0 && left > 0
    decreases left
  {
    if slot.prev != 0 { link(inout wire, slot.prev, slot.next); }
    match map_get_mut::<i64, WireNode>(inout wire.nodes, root) {
      Some(obj) => {
        if slot.prev == 0 { obj.children = slot.next; }
        if obj.count > 0 { obj.count = obj.count - 1; }
      }
      None => {}
    }
    let ignored: i64 = delete_node(inout wire, slot.id, 64);
    if slot.hits == 1 { return; }
    slot = find_field(wire, root, key);
    left = left - 1;
  }
}

fn jb_truthy(packet: [u8]) -> bool
{
  if len(packet) == 0 { return false; }
  let tag: i64 = packet[0];
  if tag == 4 || tag == 8 || tag == 9 { return true; }
  if tag == 6 { return j_count(packet, 1) > 0; }
  if tag != 7 { return false; }
  let bits: i64 = j_bits(packet, 1);
  return band(bits, 9223372036854775807) != 0 && crate::bud_num::count_class(bits) != 3;
}

pub enum AutoOwner { NoOwner, Reference, Caller }
pub struct AutoResult { status: i64, finds: i64, value: i64, saved: bool, owner: AutoOwner }

fn auto_result(status: i64, finds: i64, value: i64, saved: bool, owner: AutoOwner) -> AutoResult
{
  return AutoResult { status: status, finds: finds, value: value, saved: saved, owner: owner };
}

fn atom(inout wire: Wire, key: str, tag: i64, text_value: str, next: i64) -> i64 ! alloc
{
  return append_node(inout wire, WireNode {
    key: text(key), text: text(text_value), tag: tag, scalar: 0,
    children: 0, count: 0, next: next
  });
}

fn stop_auto(inout wire: Wire, root: i64, caller_sid: str, finds: i64, owner: AutoOwner) -> AutoResult ! alloc
{
  let record: FieldLink = find_field(wire, root, "autoContinue");
  let record_sid: FieldLink = find_field(wire, record.id, "sessionId");
  if node_text_is(wire, record_sid.id, caller_sid) {
    let stopped: FieldLink = find_field(wire, record.id, "stopped");
    if node_truthy(wire, stopped.id) { return auto_result(0, finds, 1, false, owner); }
    if stopped.id == 0 {
      let fresh: i64 = atom(inout wire, "stopped", 4, "", 0);
      replace_field(inout wire, record.id, stopped, fresh);
    } else {
      match map_get_mut::<i64, WireNode>(inout wire.nodes, stopped.id) {
        Some(n) => {
          // A falsy value cannot have children.
          n.tag = 4;
          n.text = string_new();
        }
        None => {}
      }
    }
    return auto_result(0, finds, 1, true, owner);
  }
  if node_truthy(wire, record.id) { return auto_result(0, finds, 1, false, owner); }
  let card: FieldLink = find_field(wire, root, "card");
  if !node_text_is(wire, find_field(wire, card.id, "state").id, "working") { return auto_result(0, finds, 1, false, owner); }
  let by: FieldLink = find_field(wire, card.id, "by");
  if !node_text_is(wire, find_field(wire, by.id, "sessionId").id, caller_sid) { return auto_result(0, finds, 1, false, owner); }
  let fresh: i64 = append_node(inout wire, WireNode {
    key: string_new(), text: text(caller_sid), tag: synthetic_tag(), scalar: 0,
    children: 0, count: 0, next: 0
  });
  if fresh == 0 { return auto_result(2, finds, 1, false, AutoOwner::NoOwner); }
  replace_field(inout wire, root, record, fresh);
  return auto_result(0, finds, 1, true, owner);
}

fn stop_owner(inout st: St, sid: str, owner: AutoOwner, caller_sid: str, finds: i64) -> AutoResult ! alloc
{
  let mut root: i64 = 0;
  match map_get::<String, crate::bud_tstate::Budget>(st.sessions, sid) {
    Some(b) => {
      if b.state == 0 { root = b.metadata; }
    }
    None => {}
  }
  if root == 0 { return auto_result(0, finds, 1, false, owner); }
  return stop_auto(inout st.wire, root, caller_sid, finds, owner);
}

pub fn auto_decoded(inout st: St, op: i64, sid: str, has_sid: bool, bid: str, has_bid: bool,
            has_ref: bool, caller: str, has_caller: bool, packet: [u8]) -> AutoResult ! alloc
{
  if op < 1 || op > 3 { return auto_result(2, 0, 1, false, AutoOwner::NoOwner); }
  if op == 2 && len(packet) > 0 && !crate::bud_card::j_ok_at(packet, 3) {
    return auto_result(2, 0, 1, false, AutoOwner::NoOwner);
  }
  let root: i64 = current_root(st, sid, has_sid, bid, has_bid);
  if op == 3 {
    if !has_caller { return auto_result(2, 0, 1, false, AutoOwner::NoOwner); }
    let finds: i64 = 1 + b01(has_ref);
    if has_ref && root != 0 { return stop_owner(inout st, sid, AutoOwner::Reference, caller, finds); }
    return stop_owner(inout st, caller, AutoOwner::Caller, caller, finds);
  }
  let mut value: i64 = 1;
  if op == 2 { value = 3; }
  if root == 0 { return auto_result(0, 1, value, false, AutoOwner::NoOwner); }
  let slot: FieldLink = find_field(st.wire, root, "autoContinue");
  if op == 1 {
    if node_truthy(st.wire, slot.id) { delete_fields(inout st.wire, root, "autoContinue", slot); }
  } else {
    value = 4;
    if jb_truthy(packet) {
      if len(packet) > 4294967296 - 13 { return auto_result(2, 0, 1, false, AutoOwner::NoOwner); }
      let fresh: i64 = read_node(inout st.wire, crate::ent_u16::empty(), packet, true, 0, text("autoContinue"), 3);
      if fresh == 0 { return auto_result(2, 0, 1, false, AutoOwner::NoOwner); }
      replace_field(inout st.wire, root, slot, fresh);
    } else { delete_fields(inout st.wire, root, "autoContinue", slot); }
  }
  return auto_result(0, 1, value, false, AutoOwner::NoOwner);
}

pub fn legacy_effects(kind: i64, op: i64, rf: [i64], sid: [i64], selected: [i64], now: i64, w: [i64]) -> [i64] ! alloc
{
  let mut effects: Vec<i64> = vec_new::<i64>();
  let id: [i64] = crate::bud_vwords::part(rf, crate::bud_card::obj_get(rf, 0, "sessionId"));
  let mut owner: [i64] = crate::bud_vwords::unpack(sid);
  let mut saved: i64 = 0;
  let mut changed: i64 = 0;
  if kind == 1 {
    if op == 3 {
      if rd(w, 0) == 2 {
        effects = crate::bud_effect::value(move effects, 1, id);
      }
      owner = crate::bud_vwords::unpack(selected);
      effects = crate::bud_effect::value(move effects, 1, owner);
    } else {
      if rd(w, 0) == 1 { effects = crate::bud_effect::value(move effects, 1, id); }
    }
    saved = rd(w, 1);
    changed = rd(w, 2);
  } else if kind == 2 {
    if rd(w, 3) >= 1 { effects = crate::bud_effect::value(move effects, 1, id); }
    if rd(w, 3) == 2 { effects = crate::bud_effect::value(move effects, 1, id); }
    if rd(w, 0) == 1 {
      effects = crate::bud_effect::value(move effects, 2, crate::bud_vwords::pair(5, now));
    }
    saved = rd(w, 1);
    changed = rd(w, 2);
  } else {
    if rd(w, 0) == 1 { effects = crate::bud_effect::value(move effects, 1, id); }
  }
  if saved == 1 { effects = crate::bud_effect::value(move effects, 3, owner); }
  if changed == 1 { effects = crate::bud_effect::mark(move effects, 4); }
  return words_array(effects);
}

// Seed toolSeen for cleanup fixtures. The oracle uses noteTool on a stale ref,
// so fixture setup does not change any session's usage counter.
pub fn seed_tool(inout st: St, turn: str, activity: str) -> i64 ! alloc
{
  if len(st.tools) >= 1099511627776 { return -2; }
  let ordinal: i64 = len(st.tools);
  let mut fresh: i64 = 0;
  match map_get_mut::<String, ToolTurn>(inout st.tools, turn) {
    Some(t) => {
      match map_get::<String, i64>(t.activities, activity) {
        Some(a) => {}
        None => {
          if len(t.activities) < 1099511627776 {
            let pos: i64 = len(t.activities);
            t.activities = map_insert::<String, i64>(move t.activities, text(activity), pos);
            fresh = 1;
          } else { fresh = -2; }
        }
      }
    }
    None => {
      st.tools = map_insert::<String, ToolTurn>(move st.tools, text(turn), ToolTurn {
        ordinal: ordinal,
        activities: map_insert::<String, i64>(map_new::<String, i64>(), text(activity), 0)
      });
      fresh = 1;
    }
  }
  return fresh;
}


trusted rust fn unit(fxn: i64) -> Vec<i64> ! alloc, io
  ensures true
  = "::m12_facts::unit";

trusted rust fn uuid(fxn: i64) -> Vec<i64> ! alloc, io
  ensures true
  = "::m12_facts::uuid";

trusted rust fn observing() -> bool ! io
  ensures true
  = "::m12_facts::observing";

trusted rust fn observe_find(offset: i64, budget: [i64]) -> () ! io
  ensures true
  = "::m12_facts::observe_find";

fn get(a: [i64], p: i64, k: str) -> i64 { return crate::bud_vwords::get(a, p, k); }

fn part(a: [i64], p: i64) -> [i64] ! alloc { return crate::bud_vwords::part(a, p); }

fn cat(a: [i64], b: [i64]) -> [i64] ! alloc { return crate::bud_vwords::cat(a, b); }

fn num(a: [i64], p: i64) -> i64
  ensures -9007199254740991 <= result && result <= 9007199254740991
{
  if p < 0 || p > len(a) - 2 || rd(a, p) != 5 { return 0; }
  let x: i64 = rd(a, p + 1);
  if x < -9007199254740991 || x > 9007199254740991 { return 0; }
  return x;
}

fn number(n: i64) -> [i64] ! alloc { return crate::bud_vwords::pair(5, n); }

fn numeric(k: str, n: i64) -> [i64] ! alloc { return crate::bud_vwords::field(k, number(n)); }

fn named(i: i64) -> str ! alloc
{
  if i == 0 { return "time"; }
  if i == 1 { return "delegations"; }
  if i == 2 { return "commands"; }
  if i == 3 { return "reviews"; }
  if i == 4 { return "checks"; }
  if i == 5 { return "retries"; }
  if i == 6 { return "tools"; }
  return "failures";
}

fn reason_code(a: [i64], p: i64) -> i64 ! alloc
{
  let mut i: i64 = 0;
  while i <= 4
    invariant 0 <= i && i <= 5
    decreases 5 - i
  {
    if str_is(a, p, named(i)) { return i; }
    i = i + 1;
  }
  return -1;
}

// {sessionId, budgetId} with budgetId copied from a budget whose id is not a string (undefined when absent).
fn raw_ref(sid: [i64], budget: [i64]) -> [i64] ! alloc
{
  let p: i64 = get(budget, 0, "id");
  let mut bv: [i64] = crate::ent_u16::one(1);
  if p >= 0 { bv = crate::bud_vwords::part(budget, p); }
  let s: [i64] = crate::bud_vwords::field("sessionId", crate::bud_vwords::unpack(sid));
  return crate::bud_vwords::object(2, cat(s, crate::bud_vwords::field("budgetId", bv)));
}

fn ref_value(sid: [i64], bid: [i64], budget_first: bool) -> [i64] ! alloc
{
  let s: [i64] = crate::bud_vwords::field("sessionId", crate::bud_vwords::unpack(sid));
  let b: [i64] = crate::bud_vwords::field("budgetId", crate::bud_vwords::unpack(bid));
  if budget_first { return crate::bud_vwords::object(2, cat(b, s)); }
  return crate::bud_vwords::object(2, cat(s, b));
}

fn tick(take effects: Vec<i64>, now: i64) -> Vec<i64> ! alloc
{ return crate::bud_effect::value(move effects, 2, number(now)); }

fn no_active_since(a: [i64]) -> [i64] ! alloc
{
  let mut p: crate::bud_auto::Pair = crate::bud_auto::find_pair(a, 0, "activeSince");
  if p.k < 0 { return crate::ent_u16::slice(a, 0, len(a)); }
  let mut out: [i64] = cat(crate::ent_u16::slice(a, 0, p.k), crate::ent_u16::slice(a, p.end, len(a)));
  let mut left: i64 = crate::bud_store::c40(p.n) - 1;
  let count: i64 = crate::bud_store::c40(rd(a, 1));
  crate::bud_vwords::wr(inout out, 1, count - 1);
  while left > 0
    decreases left
  {
    p = crate::bud_auto::find_pair(out, 0, "activeSince");
    let remaining: i64 = crate::bud_store::c40(rd(out, 1));
    out = cat(crate::ent_u16::slice(out, 0, p.k), crate::ent_u16::slice(out, p.end, len(out)));
    left = left - 1;
    crate::bud_vwords::wr(inout out, 1, remaining - 1);
  }
  return out;
}

fn charged(ok: bool, reason: i64) -> [i64] ! alloc
{
  if ok { return crate::bud_vwords::object(1, crate::bud_vwords::field("ok", crate::ent_u16::one(4))); }
  let body: [i64] = crate::bud_vwords::field("ok", crate::ent_u16::one(3));
  return crate::bud_vwords::object(2, cat(body, crate::bud_vwords::field("reason", crate::bud_vwords::text(named(reason)))));
}

struct AttachOutcome { status: i64 }

fn object_node(inout wire: Wire, key: str, count: i64, first: i64) -> i64 ! alloc
{
  return append_node(inout wire, WireNode {
    key: text(key), text: string_new(), tag: 9, scalar: 0,
    children: first, count: count, next: 0
  });
}

fn fresh_budget_wire(inout wire: Wire, old: i64, bid: [i64], stamp: [i64],
                     arg: [i64], origin: i64, limits: [i64], unlimited: bool) -> i64 ! alloc
  requires len(limits) == 5
{
  let empty: [u8] = alloc(0, 0);
  let id: i64 = read_node(inout wire, bid, empty, false, 0, text("id"), 3);
  let opened: i64 = read_node(inout wire, stamp, empty, false, 0, text("openedAt"), 3);
  let source: i64 = read_node(inout wire, arg, empty, false, origin, text("origin"), 3);
  let state: i64 = atom(inout wire, "state", 6, "open", 0);
  link(inout wire, id, opened);
  link(inout wire, opened, source);
  link(inout wire, source, state);

  let first_limit: i64 = number_node(inout wire, "timeMinutes", limits[0]);
  let first_used: i64 = number_node(inout wire, "activeMs", 0);
  let mut last_limit: i64 = first_limit;
  let mut last_used: i64 = first_used;
  let mut i: i64 = 1;
  while i <= 4
    invariant 1 <= i && i <= 5 && len(limits) == 5
    decreases 5 - i
  {
    let key: str = named(i);
    let limit: i64 = number_node(inout wire, key, limits[i]);
    let used: i64 = number_node(inout wire, key, 0);
    link(inout wire, last_limit, limit);
    link(inout wire, last_used, used);
    last_limit = limit;
    last_used = used;
    i = i + 1;
  }
  let tools: i64 = number_node(inout wire, "tools", 0);
  let failures: i64 = number_node(inout wire, "failures", 0);
  let retries: i64 = number_node(inout wire, "retries", 0);
  link(inout wire, last_used, tools);
  link(inout wire, tools, failures);
  link(inout wire, failures, retries);
  let limit_object: i64 = object_node(inout wire, "limits", 5, first_limit);
  let used_object: i64 = object_node(inout wire, "used", 8, first_used);
  link(inout wire, state, limit_object);
  let mut fields: i64 = 6;
  if unlimited {
    let flag: i64 = atom(inout wire, "unlimited", 4, "", used_object);
    link(inout wire, limit_object, flag);
    fields = 7;
  } else { link(inout wire, limit_object, used_object); }
  let root: i64 = object_node(inout wire, "", fields, id);
  let ignored: i64 = delete_node(inout wire, old, 64);
  return root;
}

fn attach_fresh(inout st: St,
                sid: [i64], sid_text: str, stale: [i64], arg: [i64], now: i64,
                inout outcome: AttachOutcome, take incoming: Vec<i64>) -> Vec<i64> ! alloc, io
{
  let mut effects: Vec<i64> = move incoming;
  let u: [i64] = words_array(unit(len(effects)));
  effects = crate::bud_effect::value(move effects, 5, u);
  let s: i64 = get(arg, 0, "size");
  let mut unlimited: bool = str_is(arg, s, "unlimited");
  let mut times: i64 = 1;
  if s < 0 || rd(arg, s) == 1 || rd(arg, s) == 2 {
    unlimited = crate::bud_card::truthy(u, get(u, 0, "defaultUnlimited"));
  } else if !unlimited {
    times = num(arg, s);
    if times != 1 && times != 2 && times != 4 && times != 8 {
      outcome.status = 2;
      return crate::bud_effect::reply(2, false, crate::ent_u16::one(1), move effects);
    }
  }
  let bid: [i64] = words_array(uuid(len(effects)));
  let bid_value: [i64] = crate::bud_vwords::unpack(bid);
  effects = crate::bud_effect::value(move effects, 6, bid_value);
  effects = tick(move effects, now);

  let bid_text: String = decode_key(bid);
  let mut duplicate: bool = crate::ent_u16::eq(stale, bid);
  if !duplicate {
    match map_get::<String, crate::bud_tstate::Clock>(st.clock_state.clocks, string_to_str(bid_text)) {
      Some(c) => { duplicate = true; }
      None => {}
    }
  }
  if duplicate {
    outcome.status = 2;
    return crate::bud_effect::reply(2, false, crate::ent_u16::one(1), move effects);
  }
  let minutes: i64 = num(u, get(u, 0, "timeMinutes")) * times;
  if minutes < -9007199254740991 || minutes > 9007199254740991 {
    outcome.status = 5;
    return crate::bud_effect::reply(5, false, crate::ent_u16::one(1), move effects);
  }
  let mut values: [i64] = alloc(5, minutes);
  let mut i: i64 = 1;
  while i <= 4
    invariant 1 <= i && i <= 5 && len(values) == 5
    decreases 5 - i
  {
    let k: str = named(i);
    let limit: i64 = num(u, get(u, 0, k)) * times;
    if limit < -9007199254740991 || limit > 9007199254740991 {
      outcome.status = 5;
      return crate::bud_effect::reply(5, false, crate::ent_u16::one(1), move effects);
    }
    values[i] = limit;
    i = i + 1;
  }

  if len(st.sessions) >= 1099511627776 {
    outcome.status = 2;
    return crate::bud_effect::reply(2, false, crate::ent_u16::one(1), move effects);
  }
  let mut old: i64 = 0;
  match map_get::<String, crate::bud_tstate::Budget>(st.sessions, sid_text) {
    Some(b) => { old = b.metadata; }
    None => {}
  }
  let origin: i64 = get(arg, 0, "origin");
  let stamp: [i64] = crate::bud_vwords::iso(now);
  let mut root: i64 = old;
  // Scalar origins need one node and have the same depth as in replace_wire.
  if origin >= 0 && origin <= 1099511627776 && rd(arg, origin) >= 1 && rd(arg, origin) <= 7 &&
     crate::bud_card::v_end(arg, origin) > origin &&
     len(stamp) > 0 && rd(bid_value, 0) == 6 && wire_room(st.wire, 21) {
    root = fresh_budget_wire(inout st.wire, old, bid_value, stamp, arg, origin, values, unlimited);
  } else {
    let mut limits: [i64] = numeric("timeMinutes", minutes);
    let mut used: [i64] = numeric("activeMs", 0);
    i = 1;
    while i <= 4
      invariant 1 <= i && i <= 5 && len(values) == 5
      decreases 5 - i
    {
      let k: str = named(i);
      limits = cat(limits, numeric(k, values[i]));
      used = cat(used, numeric(k, 0));
      i = i + 1;
    }
    used = cat(used, numeric("tools", 0));
    used = cat(used, numeric("failures", 0));
    used = cat(used, numeric("retries", 0));
    let mut body: [i64] = crate::bud_vwords::field("id", bid_value);
    body = cat(body, crate::bud_vwords::field("openedAt", stamp));
    body = cat(body, crate::bud_vwords::field("origin", part(arg, origin)));
    body = cat(body, crate::bud_vwords::field("state", crate::bud_vwords::text("open")));
    body = cat(body, crate::bud_vwords::field("limits", crate::bud_vwords::object(5, limits)));
    let mut fields: i64 = 6;
    if unlimited {
      body = cat(body, crate::bud_vwords::field("unlimited", crate::ent_u16::one(4)));
      fields = 7;
    }
    body = cat(body, crate::bud_vwords::field("used", crate::bud_vwords::object(8, used)));
    let blob: [i64] = crate::bud_vwords::object(fields, body);

    root = replace_wire(inout st.wire, old, blob);
  }
  let replacement: crate::bud_tstate::Budget = make_budget(st.wire, root);
  st.sessions = map_insert::<String, crate::bud_tstate::Budget>(move st.sessions, text(sid_text), move replacement);
  effects = crate::bud_effect::mark(move effects, 4);
  return crate::bud_effect::reply(0, false, ref_value(sid, bid, false), move effects);
}

fn attach(inout st: St, sid: [i64], sid_text: str, arg: [i64], now: i64) -> Vec<i64> ! alloc, io
{
  let snapshot: [i64] = session_words(st, sid_text);
  let old_budget: [i64] = crate::ent_u16::slice(snapshot, 1, len(snapshot));
  let stale: [i64] = crate::bud_vwords::packed(old_budget, get(old_budget, 0, "id"));
  let mut effects: Vec<i64> = vec_new::<i64>();
  if len(snapshot) == 0 { return crate::bud_effect::reply(2, false, crate::ent_u16::one(1), move effects); }
  if len(old_budget) > 0 && !str_is(old_budget, get(old_budget, 0, "state"), "closed") {
    // The oracle returns the budget's own id value, undefined when absent (HC-10).
    if len(stale) == 0 { return crate::bud_effect::reply(0, false, raw_ref(sid, old_budget), move effects); }
    return crate::bud_effect::reply(0, false, ref_value(sid, stale, false), move effects);
  }

  // An armed clock precedes unit/UUID reads in the effect stream. Restore it
  // on a rejected replacement so the host keeps its existing timer.
  let mut outcome: AttachOutcome = AttachOutcome { status: 0 };
  if len(stale) > 0 {
    let key: String = decode_key(stale);
    match map_take::<String, crate::bud_tstate::Clock>(inout st.clock_state.clocks, string_to_str(key)) {
      Some(c) => {
        if c.armed { effects = crate::bud_effect::value(move effects, 13, stale); }
        let packet: Vec<i64> = attach_fresh(inout st, sid, sid_text,
                                           stale, arg, now, inout outcome, move effects);
        if outcome.status != 0 && len(st.clock_state.clocks) < 1099511627776 {
          st.clock_state.clocks = map_insert::<String, crate::bud_tstate::Clock>(move st.clock_state.clocks, move key, move c);
        }
        return move packet;
      }
      None => {}
    }
  }
  return attach_fresh(inout st, sid, sid_text,
                      stale, arg, now, inout outcome, move effects);
}

trusted rust fn encode_key(key: str) -> Vec<i64> ! alloc
  ensures true = "::m12_facts::encode_key";
trusted rust fn running_wire(rf: [i64], offset: i64) -> Vec<i64> ! alloc, io
  ensures true = "::m12_facts::running_wire";

fn drop_clock(inout clocks: HashMap<String, crate::bud_tstate::Clock>, key: str, take incoming: Vec<i64>) -> Vec<i64> ! alloc
{
  let mut effects: Vec<i64> = move incoming;
  match map_take::<String, crate::bud_tstate::Clock>(inout clocks, key) {
    Some(c) => {
      if c.armed { effects = crate::bud_effect::value(move effects, 13, words_array(encode_key(key))); }
    }
    None => {}
  }
  return move effects;
}

fn compact_clock_order(inout st: St) -> () ! alloc
{
  if len(st.clock_order) <= 2 * len(st.clock_state.clocks) + 64 { return; }
  let mut order: Vec<String> = vec_new::<String>();
  let mut ordinals: Vec<i64> = vec_new::<i64>();
  let n: i64 = len(st.clock_order);
  if n != len(st.clock_ordinals) { return; }
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n == len(st.clock_order) && n == len(st.clock_ordinals) && len(order) == len(ordinals) && len(order) <= i
    decreases n - i
  {
    let ordinal: i64 = vec_get::<i64>(st.clock_ordinals, i);
    match map_get::<String, crate::bud_tstate::Clock>(st.clock_state.clocks, vec_get::<String>(st.clock_order, i)) {
      Some(c) => {
        if c.ordinal == ordinal {
          order = vec_push::<String>(move order, text(vec_get::<String>(st.clock_order, i)));
          ordinals = vec_push::<i64>(move ordinals, ordinal);
        }
      }
      None => {}
    }
    i = i + 1;
  }
  st.clock_order = move order;
  st.clock_ordinals = move ordinals;
}

fn cleanup_clocks(inout clocks: HashMap<String, crate::bud_tstate::Clock>,
                  inout order: Vec<String>, inout ordinals: Vec<i64>,
                  op: i64, sid: str) -> Vec<i64> ! alloc
{
  let mut effects: Vec<i64> = vec_new::<i64>();
  let n: i64 = len(order);
  if n != len(ordinals) { return move effects; }
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n == len(order) && n == len(ordinals)
    decreases n - i
  {
    let ordinal: i64 = vec_get::<i64>(ordinals, i);
    let mut remove: bool = false;
    match map_get::<String, crate::bud_tstate::Clock>(clocks, vec_get::<String>(order, i)) {
      Some(c) => {
        if c.ordinal == ordinal && (op == 3 || string_eq(c.owner, sid)) {
          if c.armed { effects = crate::bud_effect::value(move effects, 13, words_array(encode_key(vec_get::<String>(order, i)))); }
          remove = true;
        }
      }
      None => {}
    }
    if op != 3 && remove {
      let removed: bool = map_remove::<String, crate::bud_tstate::Clock>(inout clocks, vec_get::<String>(order, i));
    }
    i = i + 1;
  }
  return move effects;
}

fn cleanup(inout st: St, op: i64, sid: str) -> Vec<i64> ! alloc
{
  let mut effects: Vec<i64> = vec_new::<i64>();
  if op == 1 {
    match map_get_mut::<String, crate::bud_tstate::Budget>(inout st.sessions, sid) {
      Some(b) => {
        if b.state >= 0 {
          let slot: FieldLink = find_field(st.wire, b.metadata, "activeSince");
          delete_fields(inout st.wire, b.metadata, "activeSince", slot);
          b.active_since = -1;
          b.since_kind = -1;
          effects = drop_clock(inout st.clock_state.clocks, string_to_str(b.id), move effects);
        }
      }
      None => {}
    }
  } else {
    effects = cleanup_clocks(inout st.clock_state.clocks, inout st.clock_order, inout st.clock_ordinals, op, sid);
    if op == 3 {
      st.clock_state.clocks = map_new::<String, crate::bud_tstate::Clock>();
      st.clock_state.next_clock = 0;
      vec_clear::<String>(inout st.clock_order);
      vec_clear::<i64>(inout st.clock_ordinals);
      st.tools = map_new::<String, ToolTurn>();
    }
  }
  compact_clock_order(inout st);
  return crate::bud_effect::reply(0, false, crate::ent_u16::one(1), move effects);
}

fn charge_budget(inout wire: Wire, inout b: crate::bud_tstate::Budget, what: [i64]) -> i64 ! alloc
{
  if b.state == 2 { return 1; }
  if b.state == 1 {
    if b.halt_reason < 0 { return 17; }
    if b.halt_reason > 4 { return 2; }
    return 16 + b.halt_reason;
  }
  if b.state != 0 { return 2; }
  let mut amounts: [i64] = alloc(10, 0);
  let mut i: i64 = 0;
  while i < 5
    invariant 0 <= i && i <= 5 && len(amounts) == 10
    decreases 5 - i
  {
    let p: i64 = get(what, 0, named(i + 1));
    if rd(what, p) == 5 {
      amounts[2 * i] = 2;
      amounts[2 * i + 1] = num(what, p);
    }
    i = i + 1;
  }
  let charged: i64 = crate::bud_tstate::charge(inout b, amounts);
  if charged < 0 { return 5; }
  if charged > 0 { return 32 + crate::bud_store::c32(charged); }

  let parent: FieldLink = find_field(wire, b.metadata, "used");
  if parent.hits == 1 && node_has_tag(wire, parent.id, 9) {
    let delegations: FieldLink = find_field(wire, parent.id, "delegations");
    let commands: FieldLink = find_field(wire, parent.id, "commands");
    let reviews: FieldLink = find_field(wire, parent.id, "reviews");
    let checks: FieldLink = find_field(wire, parent.id, "checks");
    let retries: FieldLink = find_field(wire, parent.id, "retries");
    if wire_room(wire, 5) && editable_number(wire, delegations) &&
       editable_number(wire, commands) && editable_number(wire, reviews) &&
       editable_number(wire, checks) && editable_number(wire, retries) {
      set_wire_number(inout wire, parent.id, delegations, "delegations", b.delegations);
      set_wire_number(inout wire, parent.id, commands, "commands", b.commands);
      set_wire_number(inout wire, parent.id, reviews, "reviews", b.reviews);
      set_wire_number(inout wire, parent.id, checks, "checks", b.checks);
      set_wire_number(inout wire, parent.id, retries, "retries", b.retries);
      return 0;
    }
  }

  let a: [i64] = budget_words(wire, b);
  let mut used: [i64] = part(a, get(a, 0, "used"));
  used = crate::bud_vwords::put(used, "delegations", number(b.delegations));
  used = crate::bud_vwords::put(used, "commands", number(b.commands));
  used = crate::bud_vwords::put(used, "reviews", number(b.reviews));
  used = crate::bud_vwords::put(used, "checks", number(b.checks));
  used = crate::bud_vwords::put(used, "retries", number(b.retries));
  let updated: i64 = replace_wire(inout wire, b.metadata, crate::bud_vwords::put(a, "used", used));
  b.metadata = updated;
  return 0;
}

fn running_list(ids: [i64]) -> [i64] ! alloc
{
  let n: i64 = crate::bud_store::c32(rd(ids, 0));
  if n > len(ids) || len(ids) > 274877906943 { return crate::ent_u16::empty(); }
  let mut list: [i64] = alloc(2 + 4 * len(ids), 0);
  crate::bud_vwords::wr(inout list, 0, 8);
  crate::bud_vwords::wr(inout list, 1, n);
  let mut used: i64 = 2;
  let mut p: i64 = 1;
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && 1 <= p && 0 <= used && used <= 1099511627776
    decreases n - i
  {
    let end: i64 = crate::bud_keys::rec_end(ids, p);
    if end < p || used > 4294967296 { return crate::ent_u16::empty(); }
    used = crate::ent_u16::put_all(inout list, used, crate::bud_vwords::unpack(crate::ent_u16::slice(ids, p, end)));
    p = end;
    i = i + 1;
  }
  return crate::ent_u16::slice(list, 0, used);
}

struct RunView { changed: bool, since: bool }

fn run_view(st: St, bid: str, sid: str, run: str, op: i64, waiting: bool) -> RunView
{
  let mut v: RunView = RunView { changed: op != 5 && op != 6, since: false };
  match map_get::<String, crate::bud_tstate::Clock>(st.clock_state.clocks, bid) {
    Some(c) => {
      v.since = c.has_since && string_eq(c.owner, sid);
      if op == 5 || op == 6 {
        match map_get::<String, i64>(c.runs, run) {
          Some(r) => { v.changed = op == 6 || (r < 0) != waiting; }
          None => {}
        }
      }
    }
    None => {}
  }
  return v;
}

fn edit_clock_wire(inout wire: Wire, b: crate::bud_tstate::Budget, settled: bool, began: bool, now: i64) -> bool ! alloc
{
  if !node_has_tag(wire, b.metadata, 9) || !wire_room(wire, 2) { return false; }
  let since: FieldLink = find_field(wire, b.metadata, "activeSince");
  if since.hits > 1 { return false; }
  let used: FieldLink = find_field(wire, b.metadata, "used");
  let active: FieldLink = find_field(wire, used.id, "activeMs");
  if settled && (used.hits != 1 || !node_has_tag(wire, used.id, 9) ||
                 !editable_number(wire, active)) { return false; }
  let mut iso: String = string_new();
  if began {
    let stamp: [i64] = crate::bud_vwords::iso(now);
    if len(stamp) == 0 { return false; }
    iso = v_units(stamp, 2, rd(stamp, 1));
  }
  if settled {
    delete_fields(inout wire, b.metadata, "activeSince", since);
    set_wire_number(inout wire, used.id, active, "activeMs", b.active_ms);
  }
  if began {
    let slot: FieldLink = find_field(wire, b.metadata, "activeSince");
    let fresh: i64 = append_node(inout wire, WireNode {
      key: text("activeSince"), text: move iso, tag: 6, scalar: 0,
      children: 0, count: 0, next: 0
    });
    replace_field(inout wire, b.metadata, slot, fresh);
  }
  return true;
}

fn after_clock(wire: Wire, b: crate::bud_tstate::Budget, settled: bool, began: bool, now: i64) -> [i64] ! alloc
{
  let mut a: [i64] = budget_words(wire, b);
  if settled {
    a = no_active_since(a);
    let used: [i64] = part(a, get(a, 0, "used"));
    a = crate::bud_vwords::put(a, "used", crate::bud_vwords::put(used, "activeMs", number(b.active_ms)));
  }
  if began { a = crate::bud_vwords::put(a, "activeSince", crate::bud_vwords::iso(now)); }
  return a;
}

fn halt_wire(inout st: St, sid_text: str, sid: [i64], bid: [i64], rf: [i64], now: i64,
             reason: i64, take incoming: Vec<i64>) -> Vec<i64> ! alloc, io
{
  let owner: [i64] = crate::bud_vwords::unpack(sid);
  let ids: [i64] = words_array(running_wire(rf, len(incoming)));
  let list: [i64] = running_list(ids);
  let mut effects: Vec<i64> = crate::bud_effect::value(move incoming, 7, cat(crate::bud_vwords::pair(8, 2), cat(rf, list)));
  effects = tick(move effects, now);
  let mut h: [i64] = crate::bud_vwords::field("reason", crate::bud_vwords::text(named(reason)));
  h = cat(h, crate::bud_vwords::field("at", crate::bud_vwords::iso(now)));
  h = cat(h, crate::bud_vwords::field("stoppedDelegationIds", list));
  match map_get_mut::<String, crate::bud_tstate::Budget>(inout st.sessions, sid_text) {
    Some(b) => {
      let a: [i64] = crate::bud_vwords::put(budget_words(st.wire, b), "state", crate::bud_vwords::text("halted"));
      let updated: i64 = replace_wire(inout st.wire, b.metadata, crate::bud_vwords::put(a, "halt", crate::bud_vwords::object(3, h)));
      b.metadata = updated;
    }
    None => {}
  }
  effects = crate::bud_effect::value(move effects, 8, owner);
  effects = crate::bud_effect::value(move effects, 9, owner);
  let n: i64 = crate::bud_store::c32(rd(ids, 0));
  let mut p: i64 = 1;
  let mut j: i64 = 0;
  while j < n
    invariant 0 <= j && j <= n && n <= 4294967296 && 1 <= p
    decreases n - j
  {
    let end: i64 = crate::bud_keys::rec_end(ids, p);
    if end < p { return move effects; }
    let id: [i64] = crate::bud_vwords::unpack(crate::ent_u16::slice(ids, p, end));
    effects = crate::bud_effect::value(move effects, 10, cat(crate::bud_vwords::pair(8, 2), cat(owner, id)));
    p = end;
    j = j + 1;
  }
  effects = crate::bud_effect::value(move effects, 11, rf);
  effects = crate::bud_effect::value(move effects, 15, cat(crate::bud_vwords::pair(8, 2), cat(owner, crate::bud_vwords::unpack(bid))));
  effects = crate::bud_effect::value(move effects, 3, owner);
  effects = crate::bud_effect::mark(move effects, 4);
  return crate::bud_effect::value(move effects, 16, owner);
}


pub struct LifeKeys { text: Vec<String>, bid: Vec<i64>, has_run: bool }

pub fn decode_life(rf: [i64], arg: [i64]) -> LifeKeys ! alloc
{
  let bid: [i64] = crate::bud_vwords::packed(rf, get(rf, 0, "budgetId"));
  let run: [i64] = crate::bud_vwords::packed(arg, get(arg, 0, "run"));
  let mut text: Vec<String> = vec_new::<String>();
  text = vec_push::<String>(move text, decode_key(bid));
  text = vec_push::<String>(move text, decode_key(run));
  let mut packed: Vec<i64> = vec_new::<i64>();
  let mut i: i64 = 0;
  while i < len(bid)
    invariant 0 <= i && i <= len(bid) && len(packed) == i
    decreases len(bid) - i
  {
    packed = vec_push::<i64>(move packed, bid[i]);
    i = i + 1;
  }
  return LifeKeys { text: move text, bid: move packed, has_run: len(run) != 0 };
}

struct LifeCharge { done: bool, status: i64, reason: i64, ok: bool, code: i64 }

// op 9 charge step. done=true means the caller returns the reply built from status/result now.
fn life_charge(inout st: St, found: bool, sid_text: str, arg: [i64]) -> LifeCharge ! alloc, io
{
  let mut status: i64 = 1;
  if found {
    match map_get_mut::<String, crate::bud_tstate::Budget>(inout st.sessions, sid_text) {
      Some(b) => { status = charge_budget(inout st.wire, inout b, arg); }
      None => {}
    }
  }
  if status >= 33 && status <= 36 {
    return LifeCharge { done: false, status: status, reason: status - 32, ok: false, code: status - 32 };
  }
  if status <= 1 { return LifeCharge { done: true, status: 0, reason: -1, ok: true, code: 0 }; }
  if status >= 16 && status <= 20 {
    return LifeCharge { done: true, status: 0, reason: -1, ok: false, code: status - 16 };
  }
  return LifeCharge { done: true, status: status, reason: -1, ok: false, code: 1 };
}

// Explicit halt (op 9, 10) or a run event (op 4..7). Returns the reply status.
fn life_step(inout st: St, inout out: crate::bud_tstate::Out, kind: i64, explicit: bool, open: bool,
             sid_text: str, bid_text: str, run: str, now: i64, reason: i64, waiting: bool) -> i64 ! alloc, io
{
  if explicit {
    if open {
      let reply: crate::bud_tstate::Reply = crate::bud_tlife::explicit_halt(inout st.sessions, inout st.clock_state.clocks, inout out, sid_text, bid_text, now, reason);
      return reply.status;
    }
    return 0;
  }
  let mut flag: i64 = 0;
  if waiting { flag = 1; }
  let ordinal: i64 = st.clock_state.next_clock;
  let reply: crate::bud_tstate::Reply = crate::bud_tlife::run_event(inout st.sessions, inout st.clock_state, inout out, sid_text, bid_text, run, kind, now, flag);
  if st.clock_state.next_clock != ordinal && len(st.clock_order) < 1099511627776 && len(st.clock_ordinals) < 1099511627776 {
    st.clock_order = vec_push::<String>(move st.clock_order, text(bid_text));
    st.clock_ordinals = vec_push::<i64>(move st.clock_ordinals, ordinal);
  }
  return reply.status;
}

// Clock wire update after the step, and its trace ticks.
fn life_settle(inout st: St, take effects: Vec<i64>, found: bool, since: bool, halted: bool, explicit: bool,
               op: i64, sid_text: str, id: [i64], now: i64) -> Vec<i64> ! alloc, io
{
  let mut settled: bool = false;
  let mut began: bool = false;
  let mut sync_fire: bool = false;
  let mut sync_start: [i64] = crate::ent_u16::empty();
  if found {
    match map_get_mut::<String, crate::bud_tstate::Budget>(inout st.sessions, sid_text) {
      Some(b) => {
        began = b.since_kind == 2;
        settled = since && b.since_kind != -1 && (!began || op == 7);
        sync_fire = halted && !explicit && op != 7 && !since;
        if sync_fire && observing() {
          sync_start = crate::bud_vwords::put(budget_words(st.wire, b), "activeSince", crate::bud_vwords::iso(now));
        }
        if settled || began || sync_fire {
          let edited: bool = edit_clock_wire(inout st.wire, b, settled || sync_fire, began, now);
          if !edited {
            let a: [i64] = after_clock(st.wire, b, settled || sync_fire, began, now);
            let updated: i64 = replace_wire(inout st.wire, b.metadata, a);
            b.metadata = updated;
          }
        }
      }
      None => {}
    }
  }
  let mut fx: Vec<i64> = move effects;
  if settled { fx = tick(move fx, now); }
  if began { fx = tick(move fx, now); }
  if sync_fire {
    fx = tick(move fx, now);
    if len(sync_start) > 0 { observe_find(len(fx), sync_start); }
    fx = crate::bud_effect::value(move fx, 1, id);
    fx = tick(move fx, now);
  }
  return move fx;
}

// Timer effects (tag 12) of the typed Out in the M12 trace ABI.
fn life_timers(take effects: Vec<i64>, out: crate::bud_tstate::Out, bid: [i64], rf: [i64]) -> Vec<i64> ! alloc
{
  let mut fx: Vec<i64> = move effects;
  let mut i: i64 = 0;
  while i < len(out.fx)
    invariant 0 <= i && i <= len(out.fx)
    decreases len(out.fx) - i
  {
    let e: crate::bud_tstate::Effect = vec_get::<crate::bud_tstate::Effect>(out.fx, i);
    if e.tag == 12 {
      fx = crate::bud_effect::push(move fx, 12, cat(bid, crate::ent_u16::one(b01(timer_budget_first(rf)))), e.a, e.b);
    }
    i = i + 1;
  }
  return move fx;
}

// Halt trace: the implicit halt snapshots, then the halt wire.
fn life_halted(inout st: St, take effects: Vec<i64>, explicit: bool, sid_text: str, sid: [i64], owner: [i64],
               bid: [i64], rf: [i64], now: i64, reason: i64) -> Vec<i64> ! alloc, io
{
  let mut fx: Vec<i64> = move effects;
  let mut r: i64 = reason;
  if !explicit {
    r = 0;
    if observing() {
      let snapshot: [i64] = session_words(st, sid_text);
      observe_find(len(fx), crate::ent_u16::slice(snapshot, 1, len(snapshot)));
    }
    fx = crate::bud_effect::value(move fx, 1, owner);
    if observing() {
      let snapshot: [i64] = session_words(st, sid_text);
      observe_find(len(fx), crate::ent_u16::slice(snapshot, 1, len(snapshot)));
    }
    fx = crate::bud_effect::value(move fx, 1, owner);
  }
  return halt_wire(inout st, sid_text, sid, bid, rf, now, r, move fx);
}

pub fn life(inout st: St, op: i64, rf: [i64], sid: [i64], sid_text: str, arg: [i64], now: i64,
            bid: [i64], bid_text: str, run: str, has_run: bool) -> [i64] ! alloc, io
{
  let mut effects: Vec<i64> = vec_new::<i64>();
  if op < 1 || op > 10 { return words_array(crate::bud_effect::reply(2, false, crate::ent_u16::one(1), move effects)); }
  if op <= 3 { return words_array(cleanup(inout st, op, sid_text)); }
  if op == 8 {
    let packet: Vec<i64> = attach(inout st, sid, sid_text, arg, now);
    compact_clock_order(inout st);
    return words_array(packet);
  }

  let undef: [i64] = crate::ent_u16::one(1);
  let waiting: bool = crate::bud_card::truthy(arg, get(arg, 0, "waiting"));
  let v: RunView = run_view(st, bid_text, sid_text, run, op, waiting);
  if !v.changed { return words_array(crate::bud_effect::reply(0, false, undef, move effects)); }

  let id: [i64] = part(rf, get(rf, 0, "sessionId"));
  let owner: [i64] = crate::bud_vwords::unpack(sid);
  let mut found: bool = false;
  let mut open: bool = false;
  match map_get_mut::<String, crate::bud_tstate::Budget>(inout st.sessions, sid_text) {
    Some(b) => {
      found = len(bid) > 0 && b.state >= 0 && string_eq(b.id, bid_text);
      open = found && b.state == 0;
      b.since_kind = -1;
    }
    None => {}
  }
  let mut reason: i64 = -1;
  let mut result: [i64] = crate::ent_u16::one(1);
  if op == 10 {
    reason = reason_code(arg, 0);
    if reason < 0 { return words_array(crate::bud_effect::reply(2, false, undef, move effects)); }
  } else {
    effects = crate::bud_effect::value(move effects, 1, id);
  }
  if op == 4 {
    // A non-string run key is the empty key, as in the oracle replay and the hand (HC-10).
    if !found { return words_array(crate::bud_effect::reply(0, false, undef, move effects)); }
    effects = crate::bud_effect::value(move effects, 1, id);
  }
  if op == 9 {
    let c: LifeCharge = life_charge(inout st, found, sid_text, arg);
    if c.done { return words_array(crate::bud_effect::reply(c.status, false, charged(c.ok, c.code), move effects)); }
    reason = c.reason;
    result = charged(c.ok, c.code);
  }

  let explicit: bool = op == 9 || op == 10;
  if explicit {
    effects = crate::bud_effect::value(move effects, 1, owner);
    effects = crate::bud_effect::value(move effects, 1, owner);
  } else {
    if op == 4 && (len(st.clock_order) >= 1099511627776 || len(st.clock_ordinals) >= 1099511627776) {
      return words_array(crate::bud_effect::reply(2, false, undef, move effects));
    }
  }
  let mut out: crate::bud_tstate::Out = crate::bud_tstate::Out { fx: vec_new::<crate::bud_tstate::Effect>() };
  let status: i64 = life_step(inout st, inout out, op + 4, explicit, open, sid_text, bid_text, run, now, reason, waiting);

  let mut halted: bool = false;
  // Expand typed timer and halt effects to the existing M12 trace ABI.
  let mut i: i64 = 0;
  while i < len(out.fx)
    invariant 0 <= i && i <= len(out.fx)
    decreases len(out.fx) - i
  {
    let e: crate::bud_tstate::Effect = vec_get::<crate::bud_tstate::Effect>(out.fx, i);
    if e.tag == 31 { halted = true; }
    if e.tag == 13 || e.tag == 14 { effects = crate::bud_effect::value(move effects, e.tag, bid); }
    i = i + 1;
  }
  effects = life_settle(inout st, move effects, found, v.since, halted, explicit, op, sid_text, id, now);
  effects = life_timers(move effects, out, bid, rf);
  if halted {
    effects = life_halted(inout st, move effects, explicit, sid_text, sid, owner, bid, rf, now, reason);
  }
  return words_array(crate::bud_effect::reply(status, false, result, move effects));
}

pub fn fire_timer(inout st: St, sid: [i64], sid_text: str, bid: [i64], budget_first: bool, now: i64) -> [i64] ! alloc, io
{
  let rf: [i64] = ref_value(sid, bid, budget_first);
  let key: String = decode_key(bid);
  return life(inout st, 7, rf, sid, sid_text, crate::ent_u16::empty(), now, bid, string_to_str(key), "", false);
}


// Native session and budget IDs use the same unit encoding as V/JB IDs.
pub fn query(st: St, op: i64, sid: str, has_sid: bool, bid: str, has_bid: bool) -> QueryResult ! alloc
{
  return query_decoded(st, op, string_to_str(native_key(sid)), has_sid, string_to_str(native_key(bid)), has_bid);
}

pub fn set_card(inout st: St, sid: str, has_sid: bool, bid: str, has_bid: bool,
                card: [u8], lang: [u8], by: [u8], now: i64) -> CardResult ! alloc
{
  return set_card_decoded(inout st, string_to_str(native_key(sid)), has_sid, string_to_str(native_key(bid)), has_bid, card, lang, by, now);
}

pub fn auto(inout st: St, op: i64, sid: str, has_sid: bool, bid: str, has_bid: bool,
            has_ref: bool, caller: str, has_caller: bool, packet: [u8]) -> AutoResult ! alloc
{
  return auto_decoded(inout st, op, string_to_str(native_key(sid)), has_sid, string_to_str(native_key(bid)), has_bid,
                      has_ref, string_to_str(native_key(caller)), has_caller, packet);
}

// The M12 fixture driver passes decoded session keys with its word packets.
pub fn load_packet(inout st: St, sid: str, blob: [i64]) -> Loaded ! alloc, io
{
  let input: BudgetInput = decode_budget(inout st, blob);
  return load_key(inout st, sid, move input);
}

pub fn query_packet(st: St, op: i64, rf: [i64], sid: str, has_sid: bool) -> QueryResult ! alloc
{
  let r: RefInput = decode_ref(rf);
  if !r.valid { return QueryResult { status: 2, root: 0, value: false }; }
  return query_decoded(st, op, sid, has_sid, string_to_str(ref_id(r.ids)), r.has_id);
}

pub fn set_card_packet(inout st: St, rf: [i64], sid: str, has_sid: bool,
                      card: [u8], lang: [u8], by: [u8], now: i64) -> CardResult ! alloc
{
  let r: RefInput = decode_ref(rf);
  if !r.valid { return CardResult { status: 2, used_now: false, root: 0, kind: 0, lang: 0 }; }
  return set_card_decoded(inout st, sid, has_sid, string_to_str(ref_id(r.ids)), r.has_id, card, lang, by, now);
}

pub fn auto_packet(inout st: St, op: i64, rf: [i64], sid: str, has_sid: bool,
                   caller: str, has_caller: bool, packet: [u8]) -> AutoResult ! alloc
{
  let r: RefInput = decode_ref(rf);
  if !r.valid { return auto_result(2, 0, 1, false, AutoOwner::NoOwner); }
  return auto_decoded(inout st, op, sid, has_sid, string_to_str(ref_id(r.ids)), r.has_id, r.truthy, caller, has_caller, packet);
}
