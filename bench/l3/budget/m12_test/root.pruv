pub fn m12_life(inout st: [i64], inout clocks: [i64], op: i64, rf: [i64], sid: [i64], arg: [i64], now: i64) -> [i64] ! alloc, io
{
  let effects: Vec<i64> = crate::bud_vlife::call(inout st, inout clocks, op, rf, sid, arg, now);
  return crate::bud_vlife::array(effects);
}

pub fn m12_fire(inout st: [i64], inout clocks: [i64], sid: [i64], bid: [i64], budget_first: bool, now: i64) -> [i64] ! alloc, io
{
  let rf: [i64] = crate::bud_vlife::ref_value(sid, bid, budget_first);
  let effects: Vec<i64> = crate::bud_vlife::call(inout st, inout clocks, 7, rf, sid, crate::ent_u16::empty(), now);
  return crate::bud_vlife::array(effects);
}

pub fn m12_session(st: [i64], sid: [i64]) -> [i64] ! alloc
{
  let e: i64 = crate::bud_auto::session_entry(st, sid);
  if e < 0 { return crate::ent_u16::empty(); }
  let at: i64 = crate::bud_map::blob_off(st, e);
  return crate::bud_vwords::cat(crate::ent_u16::one(1),
    crate::ent_u16::slice(st, at, at + crate::bud_map::blob_len(st, e)));
}

pub fn m12_observe(st: [i64], inout out: [i64]) -> i64
{
  return crate::bud_world::observe(st, inout out);
}

// Seed toolSeen for cleanup fixtures. The oracle uses noteTool on a stale ref,
// so fixture setup does not change any session's usage counter.
pub fn m12_seed_tool(inout st: [i64], turn: [i64], activity: [i64], inout out: [i64]) -> i64
{
  return crate::bud_world::tool_note(inout st, turn, 1, crate::bud_vwords::rd(turn, 0), activity, 1, crate::bud_vwords::rd(activity, 0), inout out);
}

// The legacy entry results also carry effect counts. Expand them in source order
// while leaving the compact ABI available to the hand differential and fixed checks.
pub fn m12_legacy_effects(st: [i64], kind: i64, op: i64, rf: [i64], sid: [i64], caller: [i64], now: i64, w: [i64]) -> [i64] ! alloc
{
  let mut effects: Vec<i64> = vec_new::<i64>();
  let id: [i64] = crate::bud_vwords::part(rf, crate::bud_card::obj_get(rf, 0, "sessionId"));
  let mut owner: [i64] = crate::bud_vwords::unpack(sid);
  let mut saved: i64 = 0;
  let mut changed: i64 = 0;
  if kind == 1 {
    if op == 3 {
      if rd(w, 0) == 2 {
        effects = crate::bud_effect::value(move effects, 1, id);
      }
      if rd(w, 0) == 1 || cur(st, rf, sid).e < 0 {
        owner = crate::bud_vwords::unpack(caller);
      }
      effects = crate::bud_effect::value(move effects, 1, owner);
      if rd(w, 1) == 1 {
        owner = crate::bud_vwords::unpack(crate::ent_u16::slice(w, 4, len(w)));
      }
    } else {
      if rd(w, 0) == 1 { effects = crate::bud_effect::value(move effects, 1, id); }
    }
    saved = rd(w, 1);
    changed = rd(w, 2);
  } else if kind == 2 {
    if rd(w, 3) >= 1 { effects = crate::bud_effect::value(move effects, 1, id); }
    if rd(w, 3) == 2 { effects = crate::bud_effect::value(move effects, 1, id); }
    if rd(w, 0) == 1 {
      effects = crate::bud_effect::value(move effects, 2, crate::bud_vwords::pair(5, now));
    }
    saved = rd(w, 1);
    changed = rd(w, 2);
  } else {
    if rd(w, 0) == 1 { effects = crate::bud_effect::value(move effects, 1, id); }
  }
  if saved == 1 { effects = crate::bud_effect::value(move effects, 3, owner); }
  if changed == 1 { effects = crate::bud_effect::mark(move effects, 4); }
  return crate::bud_vlife::array(effects);
}

// L3-10 M12 test root. STAND-IN for the session table of the real app (deps.findSession / deps.save): sessions live in
// the resident store st via bud_world::session_put_w / bud_map::find_w; key = session id as a packed key, blob = the budget V of
// the session (an empty blob = a session without a budget). All judgments (CURRENT, closed, validation, the card,
// the stored budget, the result value) are made here, in bud_card, or in bud_auto. The Rust host only moves words.
//
// Status of every entry: 0 ok (out[0] = number of words after out[0]), 1 Grow (out[0] = N; nothing written, the host
// grows st and retries the same call), 2 invalid input, 3 out too small.
// ref uses V words; card, lang and by use JB bytes. Empty packets are absent (undefined).

fn rd(v: [i64], i: i64) -> i64
{ return crate::ent_u16::rd(v, i); }

fn emit(inout out: [i64], pos: i64, v: i64) -> i64
  requires 0 <= pos && pos <= 1099511627776
  ensures 0 <= result && result <= 1099511627776 && len(out) == len(old(out))
{
  if pos >= 1099511627776 { return 1099511627776; }
  crate::ent_u16::wr(inout out, pos, v);
  return pos + 1;
}

fn emit_lit(inout out: [i64], pos: i64, s: str) -> i64
  requires 0 <= pos && pos <= 1099511627776
  ensures 0 <= result && result <= 1099511627776 && len(out) == len(old(out))
{
  let m: i64 = len(s);
  let mut p: i64 = emit(inout out, pos, m);
  let mut j: i64 = 0;
  while j < m
    invariant 0 <= j && j <= m && m == len(s) && 0 <= p && p <= 1099511627776 && len(out) == len(old(out))
    decreases m - j
  {
    p = emit(inout out, p, s[j]);
    j = j + 1;
  }
  return p;
}

fn emit_range(inout out: [i64], pos: i64, src: [i64], s: i64, e: i64) -> i64
  requires 0 <= pos && pos <= 1099511627776
  requires 0 <= s && s <= e && e <= len(src)
  ensures 0 <= result && result <= 1099511627776 && len(out) == len(old(out))
{
  let n: i64 = e - s;
  let mut p: i64 = pos;
  let mut j: i64 = 0;
  if n <= 1099511627776 - pos && pos + n <= len(out) {
    // the whole range is in bounds: one check for the loop (same writes as the per-word path below)
    while j < n
      invariant 0 <= j && j <= n && 0 <= s && s + n <= len(src) && 0 <= pos && pos + n <= len(out) && pos + n <= 1099511627776 && len(out) == len(old(out))
      decreases n - j
    {
      out[pos + j] = src[s + j];
      j = j + 1;
    }
    return pos + n;
  }
  while j < n
    invariant 0 <= j && j <= n && 0 <= s && s + n <= len(src) && 0 <= p && p <= 1099511627776 && len(out) == len(old(out))
    decreases n - j
  {
    p = emit(inout out, p, src[s + j]);
    j = j + 1;
  }
  return p;
}

fn emit_all(inout out: [i64], pos: i64, w: [i64]) -> i64
  requires 0 <= pos && pos <= 1099511627776
  ensures 0 <= result && result <= 1099511627776 && len(out) == len(old(out))
{
  return emit_range(inout out, pos, w, 0, len(w));
}

// `u, units` of the UTF-8 text b (a bud_text output, valid UTF-8; u = its UTF-16 unit count): a short decode loop, so the
// error branch of m12_set_card stays small (the WTF-8 put_units loop inlined there cost the success path ~48
// instructions per call, P27)
fn emit_utf8(inout out: [i64], pos: i64, b: [u8], u: i64) -> i64
  requires 0 <= pos && pos <= 1099511627776
  ensures 0 <= result && result <= 1099511627776 && len(out) == len(old(out))
{
  let n: i64 = len(b);
  let mut p: i64 = emit(inout out, pos, u);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n == len(b) && 0 <= p && p <= 1099511627776 && len(out) == len(old(out))
    decreases n - i
  {
    // one unit per lead byte (two emits only for a 4-byte lead), so the loop has two emit sites
    let c: i64 = b[i];
    let mut v: i64 = c;
    let mut k: i64 = 1;
    if c >= 192 && i + 1 < n { v = (c % 32) * 64 + b[i + 1] % 64; k = 2; }
    if c >= 224 && i + 2 < n { v = (c % 16) * 4096 + (b[i + 1] % 64) * 64 + b[i + 2] % 64; k = 3; }
    if c >= 240 && i + 3 < n {
      let mut x: i64 = (c % 8) * 262144 + (b[i + 1] % 64) * 4096 + (b[i + 2] % 64) * 64 + b[i + 3] % 64 - 65536;
      if x < 0 { x = 0; }
      p = emit(inout out, p, 55296 + x / 1024 % 1024);
      v = 56320 + x % 1024;
      k = 4;
    }
    p = emit(inout out, p, v);
    i = i + k;
  }
  return p;
}

// the value at `at` is the string equal to the ASCII literal s
fn str_is(v: [i64], at: i64, s: str) -> bool
{
  if at < 0 || at > 1099511627776 { return false; }
  if rd(v, at) != 6 { return false; }
  let m: i64 = len(s);
  if rd(v, at + 1) != m { return false; }
  let mut j: i64 = 0;
  while j < m
    invariant 0 <= j && j <= m && m == len(s) && 0 <= at && at <= 1099511627776
    decreases m - j
  {
    if rd(v, at + 2 + j) != s[j] { return false; }
    j = j + 1;
  }
  return true;
}

// Compare the state tags without allocating string literals.
fn is_halted(v: [i64], at: i64) -> bool
{
  if at < 0 || at > len(v) - 8 { return false; }
  return v[at] == 6 && v[at + 1] == 6 && v[at + 2] == 104 && v[at + 3] == 97 &&
    v[at + 4] == 108 && v[at + 5] == 116 && v[at + 6] == 101 && v[at + 7] == 100;
}

// Last budgetId value in the admitted ref, without a string literal.
fn ref_budget_id(rf: [i64]) -> i64
{
  let n: i64 = len(rf);
  if n < 2 || rf[0] != 9 { return -1; }
  let cnt: i64 = rf[1];
  if cnt < 0 || cnt > n - 2 { return -1; }
  let mut pos: i64 = 2;
  let mut i: i64 = 0;
  let mut found: i64 = -1;
  while i < cnt
    invariant 0 <= i && i <= cnt && 2 <= pos && pos <= n && n == len(rf)
    decreases cnt - i
  {
    if pos >= n { return -1; }
    let kn: i64 = rf[pos];
    if kn < 0 || kn > n - pos - 1 { return -1; }
    let vs: i64 = pos + 1 + kn;
    let end: i64 = crate::bud_card::v_end(rf, vs);
    if end < 0 { return -1; }
    if kn == 8 && rf[pos + 1] == 98 && rf[pos + 2] == 117 && rf[pos + 3] == 100 && rf[pos + 4] == 103 &&
      rf[pos + 5] == 101 && rf[pos + 6] == 116 && rf[pos + 7] == 73 && rf[pos + 8] == 100 { found = vs; }
    pos = end;
    i = i + 1;
  }
  return found;
}

// both values are strings with the same units
fn str_eq(a: [i64], pa: i64, b: [i64], pb: i64) -> bool
{
  if pa < 0 || pb < 0 || pa > 1099511627776 || pb > 1099511627776 { return false; }
  if rd(a, pa) != 6 || rd(b, pb) != 6 { return false; }
  let n: i64 = rd(a, pa + 1);
  if n != rd(b, pb + 1) || n < 0 || n > 1099511627776 { return false; }
  let mut j: i64 = 0;
  while j < n
    invariant 0 <= j && j <= n && n <= 1099511627776 && 0 <= pa && pa <= 1099511627776 && 0 <= pb && pb <= 1099511627776
    decreases n - j
  {
    if rd(a, pa + 2 + j) != rd(b, pb + 2 + j) { return false; }
    j = j + 1;
  }
  return true;
}

struct Cur { e: i64, o: i64, n: i64, state: i64, card: i64, card_end: i64 }

fn no_cur() -> Cur
  ensures result.e == -1
{
  return Cur { e: -1, o: 0, n: 0, state: -1, card: -1, card_end: -1 };
}

// CURRENT(ref): the resident budget whose id equals ref.budgetId.
fn cur(st: [i64], rf: [i64], sid: [i64]) -> Cur
  ensures result.e < 0 || (0 <= result.o && 2 <= result.n && result.n <= 1099511627776 && result.o + result.n <= len(st))
  ensures result.e < 0 || (result.card == -1 || (result.o <= result.card && result.card < result.card_end && result.card_end <= result.o + result.n))
{
  let e: i64 = crate::bud_auto::session_entry(st, sid);
  if e < 0 { return no_cur(); }
  let o: i64 = crate::bud_map::blob_off(st, e);
  let n: i64 = crate::bud_map::blob_len(st, e);
  if n == 0 || o + n > len(st) { return no_cur(); }
  let p: crate::bud_card::BudgetPos = crate::bud_card::budget_pos(st, o, o + n);
  if !p.ok { return no_cur(); }
  if !str_eq(st, p.id, rf, ref_budget_id(rf)) { return no_cur(); }
  return Cur { e: e, o: o, n: n, state: p.state, card: p.card, card_end: p.card_end };
}

// value position of a JB packet (empty = absent)
fn at_b(b: [u8]) -> i64
{
  if len(b) == 0 { return -1; }
  return 0;
}

fn b01(b: bool) -> i64
{
  if b { return 1; }
  return 0;
}

// ---- store ----

pub fn m12_init(inout st: [i64]) -> i64
{
  return crate::bud_store::init_store(inout st);
}

pub fn m12_grow(prev: [i64], inout next: [i64]) -> i64
{
  if !crate::bud_store::valid(prev) { return 2; }
  if len(next) < len(prev) { return 2; }
  let r: i64 = crate::bud_map::grow_copy(prev, inout next);
  if r != 0 { return 2; }
  return 0;
}

// world setup: session `key` (a framed packed key `n, words(n) packed words`, packed once by the host) with budget V
// `blob` (empty = no budget). out = [1, fresh]. rec_end is the whole key check (framing + canonical form); packed
// lanes are always valid u16 units, so the old per-unit 0..65535 loop is gone.
// The blob is checked by v_stored_end: shape, string/key units 0..65535, and depth from 2 (setCard returns it inside
// {ok, budget}), so the resident walks (budget_pos) never see an out-of-ABI budget.
pub fn m12_load(inout st: [i64], key: [i64], blob: [i64], inout out: [i64]) -> i64
{
  if !crate::bud_store::valid(st) { return 2; }
  if crate::bud_keys::rec_end(key, 0) != len(key) { return 2; }
  if len(blob) > 0 && crate::bud_card::v_stored_end(blob, 0) != len(blob) { return 2; }
  return crate::bud_world::session_put_w(inout st, key, 1, rd(key, 0), blob, 0, len(blob), inout out);
}

// ---- requests ----

// setCard(ref, card, lang?, by?). sid = packed key of ref.sessionId (empty = ref has none). out = [k, used_now, saved,
// changed, findSession, result V...] (k = 4 + |V|).
pub fn m12_set_card(inout st: [i64], rf: [i64], sid: [i64], card: [u8], lang: [u8], by: [u8], now_ms: i64, inout out: [i64]) -> i64 ! alloc
{
  if !crate::bud_store::valid(st) { return 2; }
  if now_ms < -8640000000000000 || now_ms > 8640000000000000 { return 2; }
  if len(rf) == 0 || crate::bud_card::v_end(rf, 0) != len(rf) { return 2; }
  if len(sid) > 0 && crate::bud_keys::rec_end(sid, 0) != len(sid) { return 2; }
  // card, lang, by: JB packets (empty = absent), admitted whole before any judgment
  if len(card) > 0 && !crate::bud_card::j_ok(card) { return 2; }
  if len(lang) > 0 && !crate::bud_card::j_ok(lang) { return 2; }
  // by is stored at budget.card.by (depth 3) and returned one level deeper: its top value sits at depth 4 of the result
  if len(by) > 0 && !crate::bud_card::j_ok_at(by, 4) { return 2; }
  let c: Cur = cur(st, rf, sid);
  let found: bool = c.e >= 0;
  let closed: bool = found && str_is(st, c.state, "closed");
  let lc: i64 = crate::bud_card::lang_code(lang);
  let r: crate::bud_card::Judged = crate::bud_card::judge(found, closed, card, at_b(card), lc);
  if r.kind >= 0 {
    // {ok: false, error}
    // the error text is a bud_text card error: its unit count is a generated constant (a count loop here was inlined
    // into every m12_set_card caller and pushed the m11 harness one 16 KiB code page over hand, P27)
    let eu: i64 = crate::bud_text::card_error_units(r.kind, lc);
    let need: i64 = 19 + eu;
    if len(out) < need { return 3; }
    let mut p: i64 = emit(inout out, 0, need - 1);
    p = emit(inout out, p, b01(r.used_now));
    p = emit(inout out, p, 0);
    p = emit(inout out, p, 0);
    p = emit(inout out, p, 2);
    p = emit(inout out, p, 9);
    p = emit(inout out, p, 2);
    p = emit_lit(inout out, p, "ok");
    p = emit(inout out, p, 3);
    p = emit_lit(inout out, p, "error");
    p = emit(inout out, p, 6);
    p = emit_utf8(inout out, p, r.error, eu);
    return 0;
  }
  if c.e < 0 { return 2; }
  let iso: crate::bud_date::IsoParts = crate::bud_date::iso_parts(now_ms);
  let mut dry: [i64] = crate::ent_u16::empty();
  let by_at: i64 = at_b(by);
  let cs: i64 = crate::bud_card::put_card_words(inout dry, 0, card, r.f, by, by_at, iso);
  let mut nbn: i64 = c.n + 5 + cs;
  if c.card >= 0 { nbn = c.n - (c.card_end - c.card) + cs; }
  let need2: i64 = 18 + nbn;
  if len(out) < need2 { return 3; }
  // set_blob clamps lengths at 2^32. A successful write must store the entire budget.
  if nbn > 4294967296 { return 2; }
  let mut words: i64 = nbn;
  if crate::bud_map::blob_fits(st, c.e, nbn) { words = 0; }
  let nd: i64 = crate::bud_map::make_room(inout st, 0, words);
  if nd != 0 {
    crate::ent_u16::wr(inout out, 0, nd);
    return 1;
  }
  // make_room rebuilds only the index.
  if crate::bud_map::blob_off(st, c.e) != c.o { return 2; }
  let end: i64 = c.o + c.n;
  let mut q: i64 = emit(inout out, 0, need2 - 1);
  q = emit(inout out, q, 1);
  q = emit(inout out, q, 1);
  q = emit(inout out, q, 1);
  q = emit(inout out, q, 2);
  q = emit(inout out, q, 9);
  q = emit(inout out, q, 2);
  q = emit_lit(inout out, q, "ok");
  q = emit(inout out, q, 4);
  q = emit_lit(inout out, q, "budget");
  if c.card >= 0 {
    q = emit_range(inout out, q, st, c.o, c.card);
    q = crate::bud_card::put_card_words(inout out, q, card, r.f, by, by_at, iso);
    q = emit_range(inout out, q, st, c.card_end, end);
  } else {
    q = emit_range(inout out, q, st, c.o, end);
    let cnt: i64 = rd(st, c.o + 1);
    if cnt < 0 || cnt > c.n - 2 { return 2; }
    crate::ent_u16::wr(inout out, 19, cnt + 1);
    q = emit_lit(inout out, q, "card");
    q = crate::bud_card::put_card_words(inout out, q, card, r.f, by, by_at, iso);
  }
  let wrote: i64 = crate::bud_map::set_blob(inout st, c.e, out, 18, nbn);
  if wrote < 0 { return 2; }
  return 0;
}

// op 1 current -> budget V or undefined; 2 isHalted -> bool; 3 hasCard -> bool. sid as in m12_set_card.
// out = [k, findSession, V...].
pub fn m12_query(st: [i64], op: i64, rf: [i64], sid: [i64], inout out: [i64]) -> i64
{
  if !crate::bud_store::valid(st) { return 2; }
  if op < 1 || op > 3 { return 2; }
  if len(rf) == 0 || crate::bud_card::v_end(rf, 0) != len(rf) { return 2; }
  if len(sid) > 0 && crate::bud_keys::rec_end(sid, 0) != len(sid) { return 2; }
  let c: Cur = cur(st, rf, sid);
  if op == 1 && c.e >= 0 {
    let need: i64 = 2 + c.n;
    if len(out) < need { return 3; }
    crate::ent_u16::wr(inout out, 0, need - 1);
    crate::ent_u16::wr(inout out, 1, 1);
    let p: i64 = emit_range(inout out, 2, st, c.o, c.o + c.n);
    return 0;
  }
  if len(out) < 3 { return 3; }
  let mut v: i64 = 1;
  if op != 1 {
    let mut t: bool = false;
    if c.e >= 0 {
      if op == 2 { t = is_halted(st, c.state); }
      else { t = c.card >= 0 && crate::bud_card::truthy(st, c.card); }
    }
    v = 3;
    if t { v = 4; }
  }
  crate::ent_u16::wr(inout out, 0, 2);
  crate::ent_u16::wr(inout out, 1, 1);
  crate::ent_u16::wr(inout out, 2, v);
  return 0;
}

// final dump: out = [k, count, (kn, key units, bn, blob words)*] in insertion order.
pub fn m12_dump(st: [i64], inout out: [i64]) -> i64
{
  if !crate::bud_store::valid(st) { return 2; }
  let lim: i64 = crate::bud_map::walk_limit(st);
  let mut pos: i64 = 2;
  let mut c: i64 = 0;
  let mut steps: i64 = 0;
  let mut e: i64 = crate::bud_map::head(st, 0);
  while e >= 0 && steps < lim
    invariant 0 <= steps && steps <= lim && lim <= 4294967296 && 0 <= pos && pos <= 1099511627776 && 0 <= c && c <= steps && len(out) == len(old(out))
    decreases lim - steps
  {
    let kn: i64 = crate::bud_map::key_len(st, e);
    pos = emit(inout out, pos, kn);
    let mut j: i64 = 0;
    while j < kn
      invariant 0 <= j && j <= kn && kn <= 4294967296 && 0 <= pos && pos <= 1099511627776 && len(out) == len(old(out))
      decreases kn - j
    {
      pos = emit(inout out, pos, crate::bud_map::key_unit(st, e, j));
      j = j + 1;
    }
    let bn: i64 = crate::bud_map::blob_len(st, e);
    pos = emit(inout out, pos, bn);
    let mut k: i64 = 0;
    while k < bn
      invariant 0 <= k && k <= bn && bn <= 1099511627776 && 0 <= pos && pos <= 1099511627776 && len(out) == len(old(out))
      decreases bn - k
    {
      pos = emit(inout out, pos, crate::bud_map::blob_unit(st, e, k));
      k = k + 1;
    }
    c = c + 1;
    steps = steps + 1;
    e = crate::bud_map::next(st, e);
  }
  if pos > len(out) { return 3; }
  crate::ent_u16::wr(inout out, 0, pos - 1);
  crate::ent_u16::wr(inout out, 1, c);
  return 0;
}


// op 1 clear, 2 record, 3 stop. Stop uses caller. Record uses packet.
pub fn m12_auto(inout st: [i64], op: i64, rf: [i64], sid: [i64], caller: [i64], packet: [u8], inout out: [i64]) -> i64 ! alloc
{
  if !crate::bud_store::valid(st) || op < 1 || op > 3 { return 2; }
  if len(rf) == 0 || crate::bud_card::v_end(rf, 0) != len(rf) { return 2; }
  if len(sid) > 0 && crate::bud_keys::rec_end(sid, 0) != len(sid) { return 2; }
  if op == 2 && len(packet) > 0 && !crate::bud_card::j_ok_at(packet, 3) { return 2; }
  if op == 3 {
    if len(caller) == 0 || crate::bud_keys::rec_end(caller, 0) != len(caller) { return 2; }
    let has_ref: bool = crate::bud_card::truthy(rf, 0);
    let mut pointed: i64 = -1;
    if has_ref { pointed = cur(st, rf, sid).e; }
    return crate::bud_auto::stop(inout st, pointed, has_ref, sid, caller, inout out);
  }
  let c: Cur = cur(st, rf, sid);
  if op == 1 { return crate::bud_auto::clear(inout st, c.e, inout out); }
  return crate::bud_auto::record(inout st, c.e, packet, inout out);
}
