mod ent_u16;
mod bud_num;
mod bud_text;
mod bud_date;
mod bud_card;
mod bud_keys;

// Preorder columns carry the typed property tree for open-ended budgets.
pub struct Sess {
  ordinal: i64,
  tags: Vec<i64>, ends: Vec<i64>, numbers: Vec<i64>, names: Vec<String>, texts: Vec<String>,
  id_index: i64, closed: bool, halted: bool, card_index: i64, has_card: bool,
  updated: bool, input: Vec<i64>, by: Vec<i64>, fields: crate::bud_card::Keys, now: i64
}
pub struct St { sessions: HashMap<String, Sess>, next_sessions: i64, incoming: HashMap<String, Sess> }
pub struct SetReply { status: i64, kind: i64, used_now: bool, lang: i64 }
pub struct QueryReply { status: i64, found: bool, flag: bool }
pub struct Dump { keys: Vec<String> }

pub fn admit_key(words: [i64]) -> i64 {
  if len(words) == 0 { return 1; }
  if crate::bud_keys::rec_end(words, 0) != len(words) { return 2; }
  return 0;
}

pub fn admit_wire_budget(blob: [i64]) -> bool {
  return len(blob) == 0 || crate::bud_card::v_stored_end(blob, 0) == len(blob);
}

fn own_bytes(bytes: [u8]) -> Vec<i64> ! alloc {
  let mut result: Vec<i64> = vec_new::<i64>();
  let mut i: i64 = 0;
  while i < len(bytes)
    invariant 0 <= i && i <= len(bytes) && len(result) == i
    decreases len(bytes) - i
  {
    result = vec_push::<i64>(move result, bytes[i]);
    i = i + 1;
  }
  return move result;
}

fn ref_budget_id(rf: [i64]) -> i64
{
  let n: i64 = len(rf);
  if n < 2 || rf[0] != 9 { return -1; }
  let cnt: i64 = rf[1];
  if cnt < 0 || cnt > n - 2 { return -1; }
  let mut pos: i64 = 2;
  let mut i: i64 = 0;
  let mut found: i64 = -1;
  while i < cnt
    invariant 0 <= i && i <= cnt && 2 <= pos && pos <= n && n == len(rf)
    decreases cnt - i
  {
    if pos >= n { return -1; }
    let kn: i64 = rf[pos];
    if kn < 0 || kn > n - pos - 1 { return -1; }
    let vs: i64 = pos + 1 + kn;
    let end: i64 = crate::bud_card::v_end(rf, vs);
    if end < 0 { return -1; }
    if kn == 8 && rf[pos + 1] == 98 && rf[pos + 2] == 117 && rf[pos + 3] == 100 && rf[pos + 4] == 103 &&
      rf[pos + 5] == 101 && rf[pos + 6] == 116 && rf[pos + 7] == 73 && rf[pos + 8] == 100 { found = vs; }
    pos = end;
    i = i + 1;
  }
  return found;
}

// V references admit arbitrary string words, but only UTF-16 units
// can equal an ID in a stored budget.
pub fn admit_ref(rf: [i64]) -> i64 {
  if len(rf) == 0 || crate::bud_card::v_end(rf, 0) != len(rf) { return -2; }
  let at: i64 = ref_budget_id(rf);
  let n: i64 = len(rf);
  if at < 0 || at > n - 2 || rf[at] != 6 { return -1; }
  let count: i64 = rf[at + 1];
  if count < 0 || count > n - at - 2 { return -1; }
  let mut j: i64 = 0;
  while j < count
    invariant 0 <= j && j <= count && 0 <= at && at + 2 + count <= len(rf)
    decreases count - j
  {
    let unit: i64 = rf[at + 2 + j];
    if unit < 0 || unit > 65535 { return -1; }
    j = j + 1;
  }
  return at;
}

fn valid_node(b: Sess, i: i64, n: i64) -> bool
  requires 0 <= i && i < n && n == len(b.tags) && n == len(b.ends) && n == len(b.numbers)
{
  let tag: i64 = vec_get::<i64>(b.tags, i);
  let end: i64 = vec_get::<i64>(b.ends, i);
  if tag < 1 || tag > 9 || end <= i || end > n { return false; }
  if tag < 8 { return end == i + 1; }
  let expected: i64 = vec_get::<i64>(b.numbers, i);
  let mut child: i64 = i + 1;
  let mut count: i64 = 0;
  while child < end
    invariant 0 <= i && i < child && child <= end && end <= n && n == len(b.ends)
    invariant 0 <= count && count < child
    decreases end - child
  {
    let next: i64 = vec_get::<i64>(b.ends, child);
    if next <= child || next > end { return false; }
    child = next;
    count = count + 1;
  }
  return count == expected;
}

fn admit_budget(inout b: Sess) -> bool ! alloc {
  let n: i64 = len(b.tags);
  if len(b.ends) != n || len(b.numbers) != n || len(b.names) != n || len(b.texts) != n { return false; }
  b.id_index = -1;
  b.closed = false;
  b.halted = false;
  b.card_index = -1;
  b.has_card = false;
  if n == 0 { return true; }
  if vec_get::<i64>(b.ends, 0) != n { return false; }
  let mut node: i64 = 0;
  while node < n
    invariant 0 <= node && node <= n && n == len(b.tags) && n == len(b.ends) && n == len(b.numbers)
    decreases n - node
  {
    if !valid_node(b, node, n) { return false; }
    node = node + 1;
  }
  if vec_get::<i64>(b.tags, 0) != 9 { return true; }
  let mut i: i64 = 1;
  while i < n
    invariant 1 <= i && i <= n && n == len(b.tags) && n == len(b.ends) && n == len(b.numbers) && n == len(b.names) && n == len(b.texts)
    decreases n - i
  {
    let tag: i64 = vec_get::<i64>(b.tags, i);
    let end: i64 = vec_get::<i64>(b.ends, i);
    if end <= i || end > n { return false; }
    if string_eq(vec_get::<String>(b.names, i), "id") {
      b.id_index = -1;
      if tag == 6 { b.id_index = i; }
    } else if string_eq(vec_get::<String>(b.names, i), "state") {
      b.closed = tag == 6 && string_eq(vec_get::<String>(b.texts, i), "closed");
      b.halted = tag == 6 && string_eq(vec_get::<String>(b.texts, i), "halted");
    } else if string_eq(vec_get::<String>(b.names, i), "card") {
      let value: i64 = vec_get::<i64>(b.numbers, i);
      b.card_index = i;
      b.has_card = tag == 4 || tag == 8 || tag == 9 ||
        (tag == 5 && value != 0) || (tag == 6 && !string_eq(vec_get::<String>(b.texts, i), "")) ||
        (tag == 7 && band(value, 9223372036854775807) != 0 && crate::bud_num::count_class(value) != 3);
    }
    i = end;
  }
  return true;
}

pub fn m11_load(inout st: St, key: str) -> i64 ! alloc {
  match map_take::<String, Sess>(inout st.incoming, key) {
    Some(incoming) => {
      let mut fresh: i64 = 0;
      let mut ordinal: i64 = st.next_sessions;
      match map_get::<String, Sess>(st.sessions, key) {
        Some(session) => { ordinal = session.ordinal; }
        None => {
          if ordinal < 0 || ordinal >= 1099511627775 || len(st.sessions) >= 1099511627776 { return -1; }
          fresh = 1;
        }
      }
      let mut next: Sess = move incoming;
      if !admit_budget(inout next) { return -1; }
      next.ordinal = ordinal;
      if fresh == 1 { st.next_sessions = ordinal + 1; }
      if len(st.sessions) >= 1099511627776 || len(key) > 1099511627776 { return -1; }
      st.sessions = map_insert::<String, Sess>(move st.sessions, string_from(key), move next);
      return fresh;
    }
    None => { return -1; }
  }
}

fn matches_budget(b: Sess, id: str, has_id: bool) -> bool {
  if !has_id || b.id_index < 0 || b.id_index >= len(b.texts) { return false; }
  return string_eq(vec_get::<String>(b.texts, b.id_index), id);
}

fn at_b(b: [u8]) -> i64 {
  if len(b) == 0 { return -1; }
  return 0;
}

// The wire codec escapes U+E000 and lone surrogates. Only U+E000
// can occur in native text, so double it before using the same lookup.
fn native_id(id: str) -> str ! alloc {
  let n: i64 = len(id);
  if n > 549755813888 { return copy(id); }
  let mut start: i64 = 0;
  let mut i: i64 = 0;
  let mut out: String = string_new();
  while i + 3 <= n
    invariant 0 <= start && start <= i && i <= n && n == len(id) && is_char_boundary(id, start)
    invariant n <= 549755813888 && len(out) <= 2 * start
    decreases n - i
  {
    if id[i] == 238 && id[i + 1] == 128 && id[i + 2] == 128 &&
        is_char_boundary(id, i) && is_char_boundary(id, i + 3) {
      out = string_push_str(move out, substr(id, start, i + 3));
      out = string_push_str(move out, "");
      start = i + 3;
      i = start;
    } else {
      i = i + 1;
    }
  }
  if start == 0 { return copy(id); }
  out = string_push_str(move out, substr(id, start, n));
  return string_to_str(out);
}

pub fn m11_set_card_id(inout st: St, id: str, has_id: bool, sid: str, has_sid: bool,
    card: [u8], lang: [u8], by: [u8], now: i64) -> SetReply ! alloc {
  let key: str = native_id(id);
  return m11_set_card_key(inout st, key, has_id, sid, has_sid, card, lang, by, now);
}

pub fn m11_query_id(st: St, op: i64, id: str, has_id: bool, sid: str, has_sid: bool) -> QueryReply ! alloc {
  let key: str = native_id(id);
  return m11_query_key(st, op, key, has_id, sid, has_sid);
}

pub fn m11_set_card_key(inout st: St, id: str, has_id: bool, sid: str, has_sid: bool,
    card: [u8], lang: [u8], by: [u8], now: i64) -> SetReply ! alloc {
  let invalid: SetReply = SetReply { status: 2, kind: 0, used_now: false, lang: 0 };
  if now < -8640000000000000 || now > 8640000000000000 { return invalid; }
  if len(card) > 0 && !crate::bud_card::j_ok(card) { return invalid; }
  if len(lang) > 0 && !crate::bud_card::j_ok(lang) { return invalid; }
  if len(by) > 0 && !crate::bud_card::j_ok_at(by, 4) { return invalid; }
  let lc: i64 = crate::bud_card::lang_code(lang);
  let mut reply: SetReply = SetReply { status: 0, kind: -2, used_now: false, lang: lc };
  if has_sid {
    match map_get_mut::<String, Sess>(inout st.sessions, sid) {
      Some(session) => {
        let found: bool = matches_budget(session, id, has_id);
        let r: crate::bud_card::Judged = crate::bud_card::judge(found, session.closed, card, at_b(card), lc);
        if r.kind < 0 {
          session.updated = true;
          session.input = own_bytes(card);
          session.by = own_bytes(by);
          session.fields = r.f;
          session.now = now;
        }
        reply.kind = r.kind;
        reply.used_now = r.used_now;
      }
      None => {}
    }
  }
  if reply.kind >= -1 { return reply; }
  let r: crate::bud_card::Judged = crate::bud_card::judge(false, false, card, at_b(card), lc);
  return SetReply { status: 0, kind: r.kind, used_now: r.used_now, lang: lc };
}

pub fn m11_query_key(st: St, op: i64, id: str, has_id: bool, sid: str, has_sid: bool) -> QueryReply {
  if op < 1 || op > 3 { return QueryReply { status: 2, found: false, flag: false }; }
  if has_sid {
    match map_get::<String, Sess>(st.sessions, sid) {
      Some(session) => {
        if matches_budget(session, id, has_id) {
          let flag: bool = (op == 2 && session.halted) ||
            (op == 3 && (session.updated || session.has_card));
          return QueryReply { status: 0, found: true, flag: flag };
        }
      }
      None => {}
    }
  }
  return QueryReply { status: 0, found: false, flag: false };
}

fn owned_text(key: str) -> String ! alloc { return string_from(key); }

pub fn m11_dump(st: St) -> Dump ! alloc {
  let mut keys: Vec<String> = vec_new::<String>();
  for (key, session) in st.sessions {
    if len(keys) < 1099511627776 {
      keys = vec_push::<String>(move keys, owned_text(key));
    }
  }
  return Dump { keys: move keys };
}

pub fn wire_card(card: [u8], fields: crate::bud_card::Keys, by: [u8], now: i64) -> [i64] ! alloc
  requires -8640000000000000 <= now && now <= 8640000000000000
{
  return crate::bud_card::build(card, fields, by, at_b(by), now);
}

pub fn wire_error(kind: i64, lang: i64) -> [u8] ! alloc
  requires 0 <= kind && kind <= 6 && 0 <= lang && lang <= 1
{
  return crate::bud_text::card_error(kind, lang);
}

fn rd(v: [i64], i: i64) -> i64 { return crate::ent_u16::rd(v, i); }

// perf item A: admit + validate + build one card (JB packet); returns a checksum of the stored card (or -kind on a
// validation error, -102 if the packet is not admitted).
pub fn m11_perf_card(card: [u8], now_ms: i64) -> i64 ! alloc
{
  if now_ms < -8640000000000000 || now_ms > 8640000000000000 { return -100; }
  if !crate::bud_card::j_ok(card) { return -102; }
  let f: crate::bud_card::Keys = crate::bud_card::card_at(card, 0);
  let k: i64 = crate::bud_card::validate(card, f);
  if k != 0 { return 0 - k; }
  let none: [u8] = alloc(0, 0);
  let w: [i64] = crate::bud_card::build(card, f, none, -1, now_ms);
  let n: i64 = len(w);
  if n > 1099511627776 { return -101; }
  return n + band(rd(w, n - 1), 1023) + band(rd(w, n / 2), 1023);
}

// perf item C (diagnostic split of B): n successive setCard judgments on one in-memory budget, no store and no out:
// set_card + put_card only, i.e. the bud_card part of B. Returns the final budget length (or < 0 on an error).
pub fn m11_perf_chain(budget: [i64], card: [u8], n: i64, now0: i64) -> i64 ! alloc
{
  if now0 < 0 || now0 > 8000000000000000 || n < 0 || n > 1000000 { return -100; }
  let none: [u8] = alloc(0, 0);
  let mut b: [i64] = copy(budget);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n <= 1000000
    decreases n - i
  {
    let r: crate::bud_card::SetCard = crate::bud_card::set_card(true, false, card, 0, 0, none, -1, now0 + i);
    if r.kind >= 0 { return -1; }
    b = crate::bud_card::put_card(b, 0, r.card);
    if len(b) == 0 { return -2; }
    i = i + 1;
  }
  return len(b);
}
