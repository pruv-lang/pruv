mod ent_u16;
mod bud_keys;

// M8 resident accounting state. Map entries carry insertion ordinals.
pub struct Budget {
  ordinal: i64,
  id: String,
  state: i64,
  unlimited: i64,
  reason: i64,
  limit_delegations: i64,
  limit_commands: i64,
  limit_reviews: i64,
  limit_checks: i64,
  delegations: i64,
  commands: i64,
  reviews: i64,
  checks: i64,
  tools: i64,
  failures: i64,
  retries: i64,
}
pub struct Turn { ordinal: i64, activities: HashMap<String, i64>, next_activity: i64 }
pub struct St {
  sessions: HashMap<String, Budget>, next_session: i64,
  turns: HashMap<String, Turn>, next_turn: i64
}
pub struct Reply { words: Vec<i64>, keys: Vec<String> }
// A decoded charge: the amount of each BUDGET_COUNT_KEYS key, then retries (a non-number amount is 0).
pub struct Charge { delegations: i64, commands: i64, reviews: i64, checks: i64, retries: i64 }
// A charge answer: the wire status (0 ok, 2 invalid, 5 ResourceBound, 6 halted at a limit) and the charge result.
pub struct Answer { status: i64, result: i64 }

fn owned_text(key: str) -> String ! alloc {
  return string_push_str(string_new(), key);
}

fn empty_reply() -> Reply ! alloc {
  return Reply { words: vec_new::<i64>(), keys: vec_new::<String>() };
}

fn emit(inout reply: Reply, value: i64) -> () ! alloc {
  if len(reply.words) < 1099511627776 {
    reply.words = vec_push::<i64>(move reply.words, value);
  }
}

fn emit_key(inout reply: Reply, key: str) -> () ! alloc {
  if len(reply.keys) < 1099511627776 {
    reply.keys = vec_push::<String>(move reply.keys, owned_text(key));
  }
}

// `what[key] ?? 0` for key slot k (0..4)
fn amount(what: [i64], k: i64) -> i64
  requires len(what) == 10 && 0 <= k && k <= 4
{
  if what[2 * k] != 2 { return 0; }
  return what[2 * k + 1];
}

// u + a when both and the sum are JS safe integers, else BAD (the ResourceBound signal)
fn bad() -> i64 { return -4611686018427387904; }

fn sum(u: i64, a: i64) -> i64
{
  if u < -9007199254740991 || u > 9007199254740991 { return bad(); }
  if a < -9007199254740991 || a > 9007199254740991 { return bad(); }
  let r: i64 = u + a;
  if r < -9007199254740991 || r > 9007199254740991 { return bad(); }
  return r;
}

fn charge(inout b: Budget, c: Charge) -> i64 {
  let s: i64 = b.state;
  if s == 2 { return 1; }
  if s == 1 {
    let r: i64 = b.reason;
    if r < 0 { return 17; }
    if r > 4 { return 2; }
    return 16 + r;
  }
  if s != 0 { return 2; }
  let unl: bool = b.unlimited == 1;
  let a0: i64 = c.delegations;
  let a1: i64 = c.commands;
  let a2: i64 = c.reviews;
  let a3: i64 = c.checks;
  let a4: i64 = c.retries;
  // limit checks: the first key over its limit refuses (32 + k); a ResourceBound on the way answers 5
  if !unl {
    if a0 > 0 { let t0: i64 = sum(b.delegations, a0); if t0 == bad() { return 5; } if t0 > b.limit_delegations { return 33; } }
    if a1 > 0 { let t1: i64 = sum(b.commands, a1); if t1 == bad() { return 5; } if t1 > b.limit_commands { return 34; } }
    if a2 > 0 { let t2: i64 = sum(b.reviews, a2); if t2 == bad() { return 5; } if t2 > b.limit_reviews { return 35; } }
    if a3 > 0 { let t3: i64 = sum(b.checks, a3); if t3 == bad() { return 5; } if t3 > b.limit_checks { return 36; } }
  }
  // all sums first, then the writes (atomic: a ResourceBound leaves the record untouched)
  let v0: i64 = sum(b.delegations, a0);
  let v1: i64 = sum(b.commands, a1);
  let v2: i64 = sum(b.reviews, a2);
  let v3: i64 = sum(b.checks, a3);
  let v4: i64 = sum(b.retries, a4);
  if v0 == bad() || v1 == bad() || v2 == bad() || v3 == bad() || v4 == bad() { return 5; }
  b.delegations = v0;
  b.commands = v1;
  b.reviews = v2;
  b.checks = v3;
  b.retries = v4;
  return 0;
}

// The charge words decoded once: [key tag, amount] x (delegations, commands, reviews, checks, retries).
pub fn t_charge_words(what: [i64]) -> Option<Charge> {
  if len(what) != 10 { return None::<Charge>; }
  return Some::<Charge>(Charge { delegations: amount(what, 0), commands: amount(what, 1), reviews: amount(what, 2),
                       checks: amount(what, 3), retries: amount(what, 4) });
}

// The wire status of a charge result: 2 / 5 pass through, a limit refusal 33..36 halts (6), the rest succeed.
fn answer(result: i64) -> Answer {
  let mut status: i64 = 0;
  if result == 2 || result == 5 { status = result; }
  if result >= 33 && result <= 36 { status = 6; }
  return Answer { status: status, result: result };
}

pub fn t_invalid() -> Answer {
  return Answer { status: 2, result: 0 };
}

pub fn t_admit_put(words: [i64]) -> i64 {
  // After the SID: declared length, fourteen counters and a packed budget ID.
  if len(words) < 16 || words[0] != len(words) - 1 { return 2; }
  return 0;
}

pub fn t_put(inout st: St, sid: str, bid: str, words: [i64]) -> i64 ! alloc {
  if len(words) != 14 { return 2; }
  if words[0] < -1 || words[0] > 2 || words[1] < 0 || words[1] > 1 ||
     words[2] < -1 || words[2] > 4 { return 2; }
  if len(st.sessions) >= 1099511627776 { return 5; }
  let mut ordinal: i64 = st.next_session;
  match map_get::<String, Budget>(st.sessions, sid) {
    Some(existing) => { ordinal = existing.ordinal; }
    None => {
      if st.next_session >= 1099511627776 { return 5; }
      st.next_session = st.next_session + 1;
    }
  }
  st.sessions = map_insert::<String, Budget>(move st.sessions, owned_text(sid), Budget {
    ordinal: ordinal,
    id: owned_text(bid),
    state: words[0],
    unlimited: words[1],
    reason: words[2],
    limit_delegations: words[3],
    limit_commands: words[4],
    limit_reviews: words[5],
    limit_checks: words[6],
    delegations: words[7],
    commands: words[8],
    reviews: words[9],
    checks: words[10],
    tools: words[11],
    failures: words[12],
    retries: words[13],
  });
  return 0;
}

fn emit_budget(inout reply: Reply, b: Budget) -> () ! alloc {
  emit(inout reply, b.ordinal);
  emit(inout reply, b.state);
  emit(inout reply, b.unlimited);
  emit(inout reply, b.reason);
  emit(inout reply, b.limit_delegations);
  emit(inout reply, b.limit_commands);
  emit(inout reply, b.limit_reviews);
  emit(inout reply, b.limit_checks);
  emit(inout reply, b.delegations);
  emit(inout reply, b.commands);
  emit(inout reply, b.reviews);
  emit(inout reply, b.checks);
  emit(inout reply, b.tools);
  emit(inout reply, b.failures);
  emit(inout reply, b.retries);
  emit_key(inout reply, string_to_str(b.id));
}

fn current(b: Budget, bid: str) -> bool {
  return b.state >= 0 && string_eq(b.id, bid);
}

fn charge_at(inout b: Budget, bid: str, c: Charge) -> i64 {
  if !current(b, bid) { return 1; }
  return charge(inout b, c);
}

pub fn t_charge(inout st: St, sid: str, bid: str, c: Charge) -> Answer {
  let mut result: i64 = 1;
  match map_get_mut::<String, Budget>(inout st.sessions, sid) {
    Some(b) => { result = charge_at(inout b, bid, c); }
    None => {}
  }
  return answer(result);
}

fn fail_at(inout b: Budget, bid: str) -> i64 {
  if !current(b, bid) { return 0; }
  let value: i64 = sum(b.failures, 1);
  if value == bad() { return 5; }
  b.failures = value;
  return 0;
}

pub fn t_fail(inout st: St, sid: str, bid: str) -> i64 {
  let mut status: i64 = 0;
  match map_get_mut::<String, Budget>(inout st.sessions, sid) {
    Some(b) => { status = fail_at(inout b, bid); }
    None => {}
  }
  return status;
}

pub fn t_fail_words(inout st: St, sid: str, bid: str, what: [i64]) -> Answer {
  if len(what) != 0 { return t_invalid(); }
  return Answer { status: t_fail(inout st, sid, bid), result: 0 };
}

// Test-only adapter for the account codes: decodes the words once and calls the direct entry; no budget decision.
pub fn t_call(inout st: St, code: i64, sid: str, bid: str, what: [i64]) -> Answer {
  if code == 1 {
    match t_charge_words(what) {
      Some(c) => { return t_charge(inout st, sid, bid, c); }
      None => { return t_invalid(); }
    }
  }
  if code == 2 { return t_fail_words(inout st, sid, bid, what); }
  return t_invalid();
}

// The caller checks deduplication before reaching either insertion path.
fn insert_activity(inout tool: Turn, key: str) -> i64 ! alloc {
  let ordinal: i64 = tool.next_activity;
  if ordinal >= 1099511627776 || len(tool.activities) >= 1099511627776 { return -1; }
  tool.next_activity = ordinal + 1;
  tool.activities = map_insert::<String, i64>(move tool.activities, owned_text(key), ordinal);
  return 1;
}

fn add_tool(inout st: St, key: str, activity: str) -> i64 ! alloc {
  let mut fresh: bool = false;
  let mut value: i64 = 0;
  match map_get_mut::<String, Turn>(inout st.turns, key) {
    Some(tool) => { value = insert_activity(inout tool, activity); }
    None => { fresh = true; }
  }
  if value < 0 { return 2; }
  if !fresh { return value; }
  let ordinal: i64 = st.next_turn;
  if ordinal >= 1099511627776 || len(st.turns) >= 1099511627776 { return 2; }
  let mut tool: Turn = Turn { ordinal: ordinal, activities: map_new::<String, i64>(),
                              next_activity: 0 };
  let added: i64 = insert_activity(inout tool, activity);
  if added != 1 { return 2; }
  st.next_turn = ordinal + 1;
  st.turns = map_insert::<String, Turn>(move st.turns, owned_text(key), move tool);
  return added;
}

fn emit_tools(inout reply: Reply, tool: Turn) -> () ! alloc {
  emit(inout reply, len(tool.activities));
  for (key, ordinal) in tool.activities {
    emit_key(inout reply, key);
    emit(inout reply, ordinal);
  }
}

fn emit_turns(inout reply: Reply, st: St) -> () ! alloc {
  emit(inout reply, len(st.turns));
  for (key, item) in st.turns {
    emit_key(inout reply, key);
    emit(inout reply, item.ordinal);
    emit_tools(inout reply, item);
  }
}

pub fn t_tool(inout st: St, sid: str, bid: str, key: str, activity: str) -> i64 ! alloc {
  match map_get::<String, Turn>(st.turns, key) {
    Some(turn) => {
      match map_get::<String, i64>(turn.activities, activity) {
        Some(existing) => { return 0; }
        None => {}
      }
    }
    None => {}
  }
  // Refuse before consuming the key. A stale budget still consumes it.
  let mut value: i64 = bad();
  match map_get::<String, Budget>(st.sessions, sid) {
    Some(b) => {
      if current(b, bid) {
        value = sum(b.tools, 1);
        if value == bad() { return 5; }
      }
    }
    None => {}
  }
  let added: i64 = add_tool(inout st, key, activity);
  if added != 1 { return 5; }
  if value != bad() {
    match map_get_mut::<String, Budget>(inout st.sessions, sid) {
      Some(b) => { b.tools = value; }
      None => {}
    }
  }
  return 0;
}

pub fn t_forget(inout st: St, key: str) -> i64 ! alloc {
  let removed: bool = map_remove::<String, Turn>(inout st.turns, key);
  return 0;
}

fn emit_sessions(inout reply: Reply, st: St) -> () ! alloc {
  emit(inout reply, len(st.sessions));
  for (key, budget) in st.sessions {
    emit_key(inout reply, key);
    emit_budget(inout reply, budget);
  }
}

pub fn t_observe(inout st: St) -> Reply ! alloc {
  let mut reply: Reply = empty_reply();
  emit_sessions(inout reply, st);
  emit(inout reply, 0); // No clocks in M8.
  emit_turns(inout reply, st);
  return reply;
}

pub fn t_admit_key(inout key: crate::bud_keys::KeyAdmission, words: [i64], last: bool) -> i64 ! alloc {
  return crate::bud_keys::admit_key(inout key, words, last, false);
}
