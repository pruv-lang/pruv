mod ent_u16;
mod bud_keys;
mod bud_store;
mod bud_map;
mod bud_world;
mod bud_charge;
mod bud_tools;

// L3-10 M8 test root (test only, not product): drives bud_charge / bud_tools over the M4 world.
// PLACEHOLDER budget record: until M7 defines the record, a session's blob holds
//   [state, unlimited, haltReason, limits x4, used x4, tools, failures, retries, budgetId length, budgetId units...]
// (14 words + 1 + budgetId; state -1 = the session has no budget). On the wire (P05) the budgetId is PACKED: word 14 is
// its unit count bn and words 15.. are words(bn) packed words, so the record has 15 + words(bn) words.
// Keys on the wire are packed u16 keys (bud_keys layout): `n, words(n) packed words`. Every i64 word is 4 valid u16
// lanes, so there is no per-unit range check; a key is canonical when n is in range, its words are inside the op and
// the lanes past n in the last word are zero (bud_keys::rec_end / slice_ok, O(1)).
// Validation split: t_put is the ingress. It checks framing and canonical form of the session key (rec_end), and the
// record (n >= 15, state in -1..2, unlimited in 0..1, reason in -1..4, word 14 = bn in 0..2^30 with
// n == 15 + words(bn), the id slice canonical via slice_ok; counters are not validated).
// t_call checks every key of the op on EVERY call with rec_end (framing + canonical form in O(1) per key), before
// anything is written. Any bad key answers 2 with nothing written.
// t_call also keeps the state / reason checks (bud_charge::charge) and the word-14 compare in load_cv.
// These checks stay because the store invariant I1 (every stored key and every stored record passed t_put
// validation) is NOT a checked invariant: st is a resident buffer the host may hand back in any content, and nothing
// in the code proves or re-validates I1 on entry. Erasing the per-call key checks, the state / reason rechecks or the
// word-14 compare needs I1 as a checked resident invariant (spec P06/P07/P11 and the typed-state representation of
// P03-P05); until then every input, including a corrupt st, gets the same answer as the fully checked code.
// CURRENT(ref) = the session exists, has a budget,
// and its budgetId equals ref.budgetId; cv[1..14] is filled from blob words 0..13 and written back after the call.
//
// t_call op, key = `n, words(n) packed words`:
//   [1, sessionId key, budgetId key, what x10]   charge      (what as in bud_charge.pruv)
//   [2, sessionId key, budgetId key]             noteFailure
//   [3, sessionId key, budgetId key, turnId key, activityId key]   noteTool
//   [4, turnId key]                              forgetTurn
// Status: 0 done, 1 Grow (out of t_call: fx[0] = N... see below), 2 invalid, 3 fx small, 5 ResourceBound,
//   6 HALT dispatched to a not-implemented sub-operation (M10): fx holds the halt frame and nothing was charged.
// fx (inout, >= 4 words): fx[0] = words used after it; fx[1] = charge status (bud_charge codes) for charge, else 0;
//   on status 6 the halt frame follows: [20, reason k, sessionId key, budgetId key] = the call halt(ref, k).
// Grow: a negative status -N (nothing written; the host grows the buffer to at least N words and retries).
// Scratch `cv` (>= 15 words) is caller-provided working memory; the host never reads it.

// The blob offset of ref's (sk, bk) budget record when CURRENT(ref) holds, else -1. Same tests as the copy in
// load_cv, which calls it.
fn cur_off(st: [i64], sk: [i64], ss: i64, sn: i64, bk: [i64], bs: i64, bn: i64) -> i64
  ensures -1 <= result && result <= 1099511627776
{
  let se: i64 = crate::bud_map::find_w(st, 0, sk, ss, sn);
  if se < 0 { return -1; }
  let a: i64 = crate::bud_store::field_addr(st, se);
  if a < 0 { return -1; }
  let mut n: i64 = 0;
  let mut off: i64 = 0;
  if a + 14 <= len(st) {
    // fields 12, 13 in range: read directly (rd gives the same words)
    n = crate::bud_store::c40(st[a + 13]);
    off = crate::bud_store::c40(st[a + 12]);
  } else {
    n = crate::bud_store::c40(crate::ent_u16::rd(st, a + 13));
    off = crate::bud_store::c40(crate::ent_u16::rd(st, a + 12));
  }
  // bn > 2^30 never matches: t_put rejects such a record, so no stored record has word 14 above 2^30.
  if bn < 0 || bn > 1073741824 || bs < 0 || bs > 1099511627776 { return -1; }
  let bm: i64 = crate::bud_keys::words(bn);
  if off + n <= len(st) && bs + bm <= len(bk) {
    // the whole blob and the budget id words in range: one check, then plain indexing. n == 15 + bm (bm >= 0)
    // gives n >= 15. st is not assumed valid: word 14 is compared with bn too, folded into one test with the state
    // word (both are 0 exactly when word 14 == bn and the state is not negative).
    if n != 15 + bm { return -1; }
    if bor(bxor(st[off + 14], bn), band(st[off], -9223372036854775807 - 1)) != 0 { return -1; }
    // id compare: bm packed words, one memcmp. Equal bn (just checked) and equal words are equal units (one encoding
    // per key); eq_range obligations: off + 15 >= 0, bs >= 0, bm >= 0, off + 15 + bm == off + n <= len(st),
    // bs + bm <= len(bk).
    if !eq_range(st, off + 15, bk, bs, bm) { return -1; }
    return off;
  }
  if crate::ent_u16::rd(st, off) < 0 { return -1; }
  if crate::ent_u16::rd(st, off + 14) != bn || n != 15 + bm { return -1; }
  let mut j: i64 = 0;
  while j < bm
    invariant 0 <= j && j <= bm && bm <= 268435456 && 0 <= off && off <= 1099511627776 && 0 <= bs && bs <= 1099511627776
    decreases bm - j
  {
    if crate::ent_u16::rd(st, off + 15 + j) != crate::ent_u16::rd(bk, bs + j) { return -1; }
    j = j + 1;
  }
  return off;
}

// Loads the charge view for ref (sk, bk) from the session blob into cv; cv[0] = 1 when current. Returns the blob
// offset of the session's budget record when current, else -1 (store_cv writes the counters back there; the state
// does not change between load_cv and store_cv). Only the out-of-range fallback of t_call uses it: when the record
// words lie in st, t_call works on them in place (bud_charge *_at).
fn load_cv(st: [i64], sk: [i64], ss: i64, sn: i64, bk: [i64], bs: i64, bn: i64, inout cv: [i64]) -> i64
{
  crate::ent_u16::wr(inout cv, 0, 0);
  let off: i64 = cur_off(st, sk, ss, sn, bk, bs, bn);
  return load_cv_at(st, off, inout cv);
}

// load_cv for a caller that already ran cur_off: off is its result (-1 or a blob offset), so CURRENT runs once.
fn load_cv_at(st: [i64], off: i64, inout cv: [i64]) -> i64
  requires -1 <= off && off <= 1099511627776
{
  if off < 0 { return -1; }
  let mut i: i64 = 0;
  while i < 14
    invariant 0 <= i && i <= 14 && 0 <= off && off <= 1099511627776
    decreases 14 - i
  {
    crate::ent_u16::wr(inout cv, 1 + i, crate::ent_u16::rd(st, off + i));
    i = i + 1;
  }
  crate::ent_u16::wr(inout cv, 0, 1);
  return off;
}

// Writes the counters cv[8..14] back into blob words 7..13 at the offset load_cv returned (in place: same length).
fn store_cv(inout st: [i64], off: i64, cv: [i64]) -> i64
{
  if off < 0 { return 0; }
  if off <= 1099511627776 && off + 14 <= len(st) && len(cv) >= 15 {
    // words off+7..off+13 and cv[8..14] in range: plain indexing (same writes as the total path below)
    let mut k: i64 = 7;
    while k < 14
      invariant 7 <= k && k <= 14 && 0 <= off && off + 14 <= len(st) && len(cv) >= 15
      decreases 14 - k
    {
      st[off + k] = cv[1 + k];
      k = k + 1;
    }
    return 0;
  }
  if off > 1099511627776 { return 2; }
  let mut i: i64 = 7;
  while i < 14
    invariant 7 <= i && i <= 14 && 0 <= off && off <= 1099511627776
    decreases 14 - i
  {
    crate::ent_u16::wr(inout st, off + i, crate::ent_u16::rd(cv, 1 + i));
    i = i + 1;
  }
  return 0;
}

pub fn t_init(inout st: [i64]) -> i64
{ return crate::bud_store::init_store(inout st); }

pub fn t_grow(prev: [i64], inout next: [i64]) -> i64
{
  if !crate::bud_store::valid(prev) { return 2; }
  if len(next) < len(prev) { return 2; }
  let r: i64 = crate::bud_map::grow_copy(prev, inout next);
  if r != 0 { return 2; }
  return 0;
}

// session put: [sessionId key, n, words...] (key packed, record as in the header); 0 ok, 1 Grow (out[0] = N),
// 2 invalid, 3 out small.
pub fn t_put(inout st: [i64], op: [i64], inout out: [i64]) -> i64
{
  if !crate::bud_store::valid(st) { return 2; }
  // ingress: framing and canonical form of the session key op[1 .. e1) in one O(1) test
  let e1: i64 = crate::bud_keys::rec_end(op, 0);
  if e1 < 0 || e1 >= len(op) { return 2; }
  let kn: i64 = crate::ent_u16::rd(op, 0);
  let n: i64 = crate::ent_u16::rd(op, e1);
  if n < 0 || n != len(op) - e1 - 1 { return 2; }
  // Ingress validation of the record words r = op[rs .. rs + n] (malformed host input -> InvalidInput, state
  // unchanged: nothing has been written yet). Counter words (limits / used / tools / failures / retries) are not
  // validated.
  let rs: i64 = e1 + 1;
  if n < 15 { return 2; }
  let r0: i64 = crate::ent_u16::rd(op, rs);
  if r0 < -1 || r0 > 2 { return 2; }
  let r1: i64 = crate::ent_u16::rd(op, rs + 1);
  if r1 < 0 || r1 > 1 { return 2; }
  let r2: i64 = crate::ent_u16::rd(op, rs + 2);
  if r2 < -1 || r2 > 4 { return 2; }
  // word 14 = bn, the id unit count, in 0..2^30 with n == 15 + words(bn)
  let bn: i64 = crate::ent_u16::rd(op, rs + 14);
  if bn < 0 || bn > 1073741824 { return 2; }
  if n != 15 + crate::bud_keys::words(bn) { return 2; }
  // record id words op[rs + 15 .. rs + 15 + words(bn)) = op[rs + 15 .. len(op)): canonical packed key
  if !crate::bud_keys::slice_ok(op, rs + 15, bn) { return 2; }
  return crate::bud_world::session_put_w(inout st, op, 1, kn, op, e1 + 1, n, inout out);
}

// halt frame [20, k, sessionId key, budgetId key] into fx after the status word; 6, or 3 when fx is too small.
fn halt_frame(op: [i64], e2: i64, k: i64, inout fx: [i64]) -> i64
  requires 0 <= e2 && e2 <= len(op)
{
  if e2 < 1 || e2 > 4294967296 || len(fx) < e2 + 3 { return 3; }
  crate::ent_u16::wr(inout fx, 2, 20);
  crate::ent_u16::wr(inout fx, 3, k);
  let mut i: i64 = 1;
  while i < e2
    invariant 1 <= i && i <= e2 && e2 <= 4294967296
    decreases e2 - i
  {
    crate::ent_u16::wr(inout fx, 3 + i, crate::ent_u16::rd(op, i));
    i = i + 1;
  }
  crate::ent_u16::wr(inout fx, 0, e2 + 2);
  return 6;
}

pub fn t_call(inout st: [i64], op: [i64], inout cv: [i64], inout fx: [i64]) -> i64
{
  if !crate::bud_store::valid(st) { return 2; }
  if len(op) < 2 || len(fx) < 2 || len(cv) < 15 { return 2; }
  fx[0] = 1;
  fx[1] = 0;
  let code: i64 = op[0];
  // rec_end is the whole per-key check (framing + canonical form); every word is 4 valid u16 lanes, so no unit range
  // check exists. Every key is checked before anything is written.
  let e1: i64 = crate::bud_keys::rec_end(op, 1);
  if e1 < 0 { return 2; }
  let sn: i64 = op[1];
  if code == 4 {
    if e1 != len(op) { return 2; }
    let fr: i64 = crate::bud_tools::forget_turn(inout st, op, 2, sn);
    return 0;
  }
  let e2: i64 = crate::bud_keys::rec_end(op, e1);
  if e2 < 0 { return 2; }
  let bn: i64 = crate::ent_u16::rd(op, e1);
  if code == 1 {
    if e2 + 10 != len(op) { return 2; }
    // e2 + 10 == len(op) and e2 >= 0 (rec_end): the what words are in op
    let bo: i64 = cur_off(st, op, 2, sn, op, e1 + 1, bn);
    let mut r: i64 = 1;
    if bo >= 0 && bo + 14 <= len(st) {
      // the record words in range: charge them in place (the writes come after every check, as in the frame path)
      r = crate::bud_charge::charge_at(inout st, bo, op, e2);
    } else if bo >= 0 {
      let b2: i64 = load_cv(st, op, 2, sn, op, e1 + 1, bn, inout cv);
      r = crate::bud_charge::charge(inout cv, op, e2);
      if r == 0 {
        let w: i64 = store_cv(inout st, b2, cv);
        if w != 0 { return 2; }
      }
    }
    fx[1] = r;
    if r == 2 || r == 5 { return r; }
    if r >= 33 && r <= 36 {
      let h: i64 = halt_frame(op, e2, r - 32, inout fx);
      return h;
    }
    return 0;
  }
  if code == 2 {
    if e2 != len(op) { return 2; }
    let bo: i64 = cur_off(st, op, 2, sn, op, e1 + 1, bn);
    if bo < 0 { return 0; }
    if bo + 14 <= len(st) { return crate::bud_charge::note_failure_at(inout st, bo); }
    let b2: i64 = load_cv(st, op, 2, sn, op, e1 + 1, bn, inout cv);
    let r: i64 = crate::bud_charge::note_failure(inout cv);
    if r != 0 { return r; }
    let w: i64 = store_cv(inout st, b2, cv);
    if w != 0 { return 2; }
    return 0;
  }
  if code == 3 {
    let e3: i64 = crate::bud_keys::rec_end(op, e2);
    if e3 < 0 { return 2; }
    let e4: i64 = crate::bud_keys::rec_end(op, e3);
    if e4 != len(op) { return 2; }
    // all four keys are canonical (rec_end) before anything is written
    // turn key (op, e2+1, op[e2]), activity key (op, e3+1, op[e3])
    let tn: i64 = crate::ent_u16::rd(op, e2);
    let an: i64 = crate::ent_u16::rd(op, e3);
    // a seen activity returns at once (the reference's seen.has, before CURRENT); seen() keeps each key's hash and
    // slot for the insert
    let s: crate::bud_tools::Seen = crate::bud_tools::seen(st, op, e2 + 1, tn, op, e3 + 1, an);
    if s.t.e >= 0 && s.a.e >= 0 { return 0; }
    // A new activity: commit at end (L3 P21). CURRENT runs once, every refusal (ResourceBound, KD-M8-1; Grow;
    // invalid) comes before the first write, and the tools counter is written last from the value read here. The
    // insert never moves session blobs on a well-formed store (room() only rebuilds the index, and a Grow result is
    // returned before any write), so b0 still addresses the record afterwards.
    let b0: i64 = cur_off(st, op, 2, sn, op, e1 + 1, bn);
    // in place only when the record lies in the arena below the arena top read now (new key words go at or above
    // st[10]). The cv path is safe only for a record entirely beyond st: its write-back cannot overlap the insert.
    if b0 >= 0 && b0 + 14 <= len(st) && len(st) >= 15 && b0 >= st[9] && b0 + 14 <= st[10] {
      let u: i64 = st[b0 + 11];
      if u < -9007199254740991 || u >= 9007199254740991 { return 5; }
      let t: i64 = crate::bud_tools::note_new(inout st, s, op, e2 + 1, tn, op, e3 + 1, an);
      if t != 1 { return t; }
      // kept(): same length, so the record words are still in range
      st[b0 + 11] = u + 1;
      return 0;
    }
    if b0 >= len(st) {
      // out-of-range record: the counters through the frame view, loaded before the insert
      let b1: i64 = load_cv_at(st, b0, inout cv);
      let room: i64 = crate::bud_charge::tool_room(cv);
      if room != 0 { return room; }
      let t: i64 = crate::bud_tools::note_new(inout st, s, op, e2 + 1, tn, op, e3 + 1, an);
      if t != 1 { return t; }
      // cv is the view tool_room() just passed, so add_tool() and store_cv() (b1 <= 2^40) cannot refuse
      let r: i64 = crate::bud_charge::add_tool(inout cv);
      if r != 0 { return r; }
      let w: i64 = store_cv(inout st, b1, cv);
      if w != 0 { return 2; }
      return 0;
    }
    if b0 >= 0 { return 2; }
    // no current budget: the dedup key is still consumed (§15 #6)
    let t: i64 = crate::bud_tools::note_new(inout st, s, op, e2 + 1, tn, op, e3 + 1, an);
    if t != 1 { return t; }
    return 0;
  }
  return 2;
}

pub fn t_observe(st: [i64], inout out: [i64]) -> i64
{
  if !crate::bud_store::valid(st) { return 2; }
  return crate::bud_world::observe(st, inout out);
}
