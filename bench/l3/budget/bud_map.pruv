// L3-10 M4: ordered keyed maps over the resident store (bud_store).
//
// A map is the set of children of an owner entry, kept in insertion order by prev/next links in their bases
// and head/tail/count in the owner's extension. One open-addressing hash index (linear probing, slot word 0
// empty, -1 tombstone, tag(h) * 2^32 + e + 1 entry e with stored hash h; see slot_word) covers all non-root entries.
// The hash mixes owner, owner generation and the packed key words. remove frees a subtree eagerly. M8 forget
// leaves state-1 children of its free turn dead until allocation reclaims them. They count toward arena words
// (14) until reclaimed, while word 12 counts only live entries. make_room rebuilds the index to discard stale slots.
//
// The base holds state, owner, generations, key offset/length/hash, sibling links, and packed key capacity/flag.
// The optional extension holds child count, blob offset/length, four scalars, child head/tail, and blob capacity.
// A freed entry keeps its arena regions so steady reuse can write back in place.
// Keys use the bud_keys big-endian codec: length counts units, while capacity and arena accounting count ceil(n/4)
// words. Blobs keep unit records. Key units outside 0..65535 retain their low 16 bits on write.
//
// All probing loops are bounded by the slot count and all list walks by a caller-supplied step budget, so
// termination never depends on the contents of the buffer.

fn gf(st: [i64], e: i64, f: i64) -> i64
  ensures (f == 12 && crate::bud_store::valid(st) && 0 <= e && e < st[6]) ==>
    (16 <= st[5] + 10 * e && st[5] + 10 * e + 10 <= st[5] + 10 * e + 10 * st[6] &&
    st[5] + 10 * e + 10 * st[6] + 10 <= st[9] && st[9] <= len(st))
  ensures (f == 12 && crate::bud_store::valid(st) && 0 <= e && e < st[6] &&
    crate::bud_store::has_x(st[st[5] + 10 * e + 9])) ==> result == st[st[5] + 10 * e + 10 * st[6] + 1]
{ return crate::bud_store::ef(st, e, f); }

fn sf(inout st: [i64], e: i64, f: i64, v: i64) -> ()
  ensures len(st) == len(old(st))
  ensures len(old(st)) >= 15 ==> crate::bud_store::hdr_same(st, old(st), -1)
  ensures crate::bud_store::kept(st, old(st))
  ensures ((f == 12 || f == 13 || f == 19) && crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6] &&
    crate::bud_store::has_x(old(st)[old(st)[5] + 10 * e + 9])) ==>
    (crate::bud_store::has_x(st[st[5] + 10 * e + 9]) &&
    (f == 12 ==> st[st[5] + 10 * e + 10 * st[6] + 1] == v) &&
    (f == 13 ==> st[st[5] + 10 * e + 10 * st[6] + 2] == v) &&
    (f != 12 ==> st[st[5] + 10 * e + 10 * st[6] + 1] == old(st)[old(st)[5] + 10 * e + 10 * old(st)[6] + 1]) &&
    (forall j in old(st)[9]..len(st): st[j] == old(st)[j]))
{
  reveal crate::bud_store::shape_w;
  crate::bud_store::set_ef(inout st, e, f, v);
}

fn hw(st: [i64], i: i64) -> i64
{ return crate::bud_store::hd(st, i); }

fn sh(inout st: [i64], i: i64, v: i64) -> ()
  ensures len(st) == len(old(st))
  ensures (0 <= i && i < len(st)) ==> st[i] == v
  ensures forall k in 0..len(old(st)): k == i || st[k] == old(st)[k]
  ensures len(old(st)) >= 15 ==> crate::bud_store::hdr_same(st, old(st), i)
  ensures crate::bud_store::wok(old(st), i, v) ==> crate::bud_store::kept(st, old(st))
{
  crate::bud_store::set_hd(inout st, i, v);
  // the header frame first, so the revealed bodies compare equal words
  assert len(old(st)) < 15 || crate::bud_store::hdr_same(st, old(st), i);
  reveal crate::bud_store::dyn_ok;
}

// ---- hashing ----

// One word into the hash: xor, then multiply by the 64-bit golden-ratio constant (odd). A multiply only carries bits
// upward, so the result is finished by fin(), which brings the high bits down to the slot mask.
fn mix(h: i64, v: i64) -> i64
{ return wrapping_mul(bxor(h, v), -7046029254386353131); }

// splitmix64 / murmur3 finalizer: every input bit reaches the low bits used by the slot mask.
fn fin(h: i64) -> i64
{
  let a: i64 = bxor(h, ushr(h, 33));
  let b: i64 = wrapping_mul(a, -49064778989728563);
  return bxor(b, ushr(b, 33));
}

// Absolute address of probe position i for hash h; -1 if the slot count is 0.
fn slot_pos(st: [i64], h: i64, i: i64) -> i64
{
  // len(st) < 5 reads header word 4 as 0 through hw (no slots, so -1); otherwise words 3, 4 are in range.
  if len(st) < 5 { return -1; }
  let slots: i64 = crate::bud_store::c32(st[4]);
  let sb: i64 = crate::bud_store::c32(st[3]);
  if slots < 1 { return -1; }
  return sb + band(wrapping_add(h, i), slots - 1);
}

// Slot tag of hash h: its top 30 bits (bits 34..63), so a tagged slot word stays positive.
fn tag(h: i64) -> i64
  ensures 0 <= result && result <= 1073741823
{ return ushr(h, 34); }

// Slot word of entry e with stored hash h: tag(h) above e + 1 (e < cap <= 2^31 on a valid buffer, so e + 1 fits the
// low 32 bits). A probe compares ushr(w, 32) with tag(h) before it reads the entry: every slot word is written from
// the entry's stored hash (put_key_h, rehash), so a different tag means a different stored hash, which
// entry_matches_w rejects anyway. The filter keeps unsuccessful probes off other entries' fields.
fn slot_word(e: i64, h: i64) -> i64
  requires 0 <= e && e <= 4294967296
  ensures result > 0
{ return tag(h) * 4294967296 + e + 1; }

// Entry of a positive slot word (its low 32 bits minus one).
fn slot_entry(w: i64) -> i64
{ return band(w, 4294967295) - 1; }

// ---- lookup ----

// Entry e is live and matches (owner, og, h) and the packed key (the words(kn) packed words key[ks ..], kn units).
// The key compare is one word-slice compare (memcmp) in range, a per-word total fallback otherwise. Both read the
// same words, so the result does not depend on the path. Equal n and equal words == equal units (one encoding per key).
fn entry_matches_w(st: [i64], e: i64, owner: i64, og: i64, h: i64, key: [i64], ks: i64, kn: i64) -> bool
{
  let a: i64 = crate::bud_store::eb(st, e);
  let n: i64 = crate::bud_store::c32(kn);
  let mut ko: i64 = 0;
  if a >= 0 {
    if st[a + 6] != h { return false; }
    if st[a] != 1 { return false; }
    if st[a + 1] != owner || st[a + 2] != og { return false; }
    if st[a + 5] != n { return false; }
    ko = crate::bud_store::c40(st[a + 4]);
  } else {
    if gf(st, e, 6) != h { return false; }
    if gf(st, e, 0) != 1 { return false; }
    if gf(st, e, 1) != owner || gf(st, e, 2) != og { return false; }
    if gf(st, e, 5) != n { return false; }
    ko = crate::bud_store::c40(gf(st, e, 4));
  }
  let s0: i64 = crate::bud_store::c40(ks);
  if n > 1073741824 { return false; }
  let m: i64 = crate::bud_keys::words(n);
  if ko + m <= len(st) && s0 + m <= len(key) {
    // eq_range obligations: ko >= 0, s0 >= 0 (c40), m >= 0 (words), ko + m <= len(st), s0 + m <= len(key)
    return eq_range(st, ko, key, s0, m);
  }
  let mut j: i64 = 0;
  while j < m
    invariant 0 <= j && j <= m && m <= 268435456 && 0 <= ko && ko <= 1099511627776 && 0 <= s0 && s0 <= 1099511627776
    decreases m - j
  {
    if crate::ent_u16::rd(st, ko + j) != crate::ent_u16::rd(key, s0 + j) { return false; }
    j = j + 1;
  }
  return true;
}

// Hash of a packed key (words(kn) words at key[ks ..], kn units), seeded with owner and owner generation. It equals
// bud_keys::hash_units on the same units with the same seed (P03), so the stored hash is independent of the layout.
pub fn hash_words(owner: i64, ogen: i64, key: [i64], ks: i64, kn: i64) -> i64
{
  return crate::bud_keys::hash(mix(1469598103934665603,
    wrapping_add(owner, wrapping_mul(ogen,4294967296))),key,ks,kn);
}

// Entry of the map owned by `owner` with the packed key, or -1. Caller contract: key[ks .. ks+words(kn)) is canonical
// (bud_keys::slice_ok); the function is total on any input (a non-canonical or out-of-range key can only miss or
// compare clamped words).
pub fn find_w(st: [i64], owner: i64, key: [i64], ks: i64, kn: i64) -> i64
{
  let og: i64 = gf(st, owner, 3);
  let h: i64 = hash_words(owner, og, key, ks, kn);
  return find_h_w(st, owner, og, h, key, ks, kn);
}

// find_w() with og = gf(st, owner, 3) and h = hash_words(..) already computed. A wrong h can only miss
// (entry_matches_w compares the stored hash and the key), never return another key's entry.
fn find_h_w(st: [i64], owner: i64, og: i64, h: i64, key: [i64], ks: i64, kn: i64) -> i64
{
  let slots: i64 = crate::bud_store::c32(hw(st, 4));
  let ht: i64 = tag(h);
  let mut i: i64 = 0;
  if len(st) >= 5 && slots >= 1 {
    let sb: i64 = crate::bud_store::c32(st[3]);
    let mask: i64 = slots - 1;
    let n: i64 = len(st);
    while i < slots
      invariant 0 <= i && i <= slots && slots <= 4294967296 && n == len(st)
      decreases slots - i
    {
      let p: i64 = sb + band(wrapping_add(h, i), mask);
      let mut w: i64 = 0;
      if p >= 0 && p < n { w = st[p]; }
      if w == 0 { return -1; }
      if w > 0 && ushr(w, 32) == ht {
        let e: i64 = slot_entry(w);
        if entry_matches_w(st, e, owner, og, h, key, ks, kn) { return e; }
      }
      i = i + 1;
    }
    return -1;
  }
  while i < slots
    invariant 0 <= i && i <= slots && slots <= 4294967296
    decreases slots - i
  {
    let w: i64 = crate::ent_u16::rd(st, slot_pos(st, h, i));
    if w == 0 { return -1; }
    if w > 0 && ushr(w, 32) == ht {
      let e: i64 = slot_entry(w);
      if entry_matches_w(st, e, owner, og, h, key, ks, kn) { return e; }
    }
    i = i + 1;
  }
  return -1;
}

// First empty or tombstone slot on the probe path of h (absolute address), or -1.
fn free_slot(st: [i64], h: i64) -> i64
{
  let slots: i64 = crate::bud_store::c32(hw(st, 4));
  let mut i: i64 = 0;
  while i < slots
    invariant 0 <= i && i <= slots && slots <= 4294967296
    decreases slots - i
  {
    let p: i64 = slot_pos(st, h, i);
    let w: i64 = crate::ent_u16::rd(st, p);
    if w == 0 || w == -1 { return p; }
    i = i + 1;
  }
  return -1;
}

// Absolute address of the slot that holds entry e (word slot_word(e, h)) on the probe path of h, or -1.
fn slot_of(st: [i64], e: i64, h: i64) -> i64
  requires 0 <= e && e <= 4294967296
{
  let slots: i64 = crate::bud_store::c32(hw(st, 4));
  let sw: i64 = slot_word(e, h);
  let mut i: i64 = 0;
  while i < slots
    invariant 0 <= i && i <= slots && slots <= 4294967296
    decreases slots - i
  {
    let p: i64 = slot_pos(st, h, i);
    let w: i64 = crate::ent_u16::rd(st, p);
    if w == sw { return p; }
    if w == 0 { return -1; }
    i = i + 1;
  }
  return -1;
}

// ---- iteration and field access ----

pub fn head(st: [i64], owner: i64) -> i64
{
  let x: i64 = crate::bud_store::xb(st, owner);
  if x < 0 { return -1; }
  return st[x + 7];
}

pub fn next(st: [i64], e: i64) -> i64
{ return gf(st, e, 8); }

pub fn count(st: [i64], owner: i64) -> i64
{ return crate::bud_store::c32(gf(st, owner, 11)); }

// Step budget for a list walk: the entry capacity (a walk over a valid list visits at most that many entries).
pub fn walk_limit(st: [i64]) -> i64
  ensures 0 <= result && result <= 4294967296
{ return crate::bud_store::c32(hw(st, 6)); }

pub fn key_len(st: [i64], e: i64) -> i64
  ensures 0 <= result && result <= 4294967296
{ return crate::bud_store::c32(gf(st, e, 5)); }

pub fn key_unit(st: [i64], e: i64, j: i64) -> i64
{
  let n: i64 = key_len(st, e);
  if j < 0 || j >= n { return 0; }
  return crate::bud_keys::unit(st, crate::bud_store::c40(gf(st, e, 4)), n, j);
}

pub fn blob_len(st: [i64], e: i64) -> i64
  ensures 0 <= result && result <= 1099511627776
{
  let x: i64 = crate::bud_store::xb(st, e);
  if x < 0 { return 0; }
  return crate::bud_store::c40(st[x + 2]);
}

pub fn blob_off(st: [i64], e: i64) -> i64
  ensures 0 <= result && result <= 1099511627776
{ return crate::bud_store::c40(gf(st, e, 12)); }

pub fn blob_unit(st: [i64], e: i64, j: i64) -> i64
{
  let n: i64 = blob_len(st, e);
  if j < 0 || j >= n { return 0; }
  return crate::ent_u16::rd(st, blob_off(st, e) + j);
}

// ---- insert / remove ----

// Can n units be written into the arena region [off, off+cap) of a freed entry? (The region must lie inside the
// used part of the arena; a fresh entry has cap 0.)
fn fits_region(st: [i64], off: i64, cap: i64, n: i64) -> bool
  ensures (result && crate::bud_store::valid(st) && 0 <= off && 0 < n) ==>
    (st[9] <= off && off <= 1099511627776 && off + n <= len(st))
{
  reveal crate::bud_store::shape_w;
  reveal crate::bud_store::dyn_ok;
  // header words 9, 10 are in range when len(st) >= 11; shorter buffers read them as 0 through hw
  let mut ab: i64 = 0;
  let mut at: i64 = 0;
  if len(st) >= 11 {
    ab = crate::bud_store::c40(st[9]);
    at = crate::bud_store::c40(st[10]);
  } else {
    ab = crate::bud_store::c40(hw(st, 9));
    at = crate::bud_store::c40(hw(st, 10));
  }
  let o: i64 = crate::bud_store::c40(off);
  let c: i64 = crate::bud_store::c32(cap);
  return n <= c && o >= ab && o + c <= at;
}

// Writes src[s0..s0+n) at absolute offset o (a region checked by fits_region) and adds n to the live arena words.
fn write_at(inout st: [i64], o: i64, src: [i64], s0: i64, n: i64) -> ()
  requires 0 <= o && o <= 1099511627776 && 0 <= s0 && s0 <= 1099511627776 && 0 <= n && n <= 4294967296
  ensures crate::bud_store::kept(st, old(st))
  ensures len(old(st)) >= 15 ==> crate::bud_store::shape_same(st, old(st))
  ensures (16 <= o && o + n <= len(st) && s0 + n <= len(src)) ==>
    ((forall j in 0..n: st[o + j] == src[s0 + j]) &&
    (forall j in 16..o: st[j] == old(st)[j]))
  ensures n == 0 ==> (forall j in 16..len(st): st[j] == old(st)[j])
{
  let mut k: i64 = 0;
  // o >= 16 on a valid store (the region lies in the arena); a lower o, only on a buffer that is not valid, takes the
  // total path, whose wr16 skips the header words.
  if o >= 16 && o + n <= len(st) && s0 + n <= len(src) {
    // both ranges in bounds: one check for the loop (same writes as the total path below)
    while k < n
      invariant 0 <= k && k <= n && n <= 4294967296 && 16 <= o && o + n <= len(st) && 0 <= s0 && s0 + n <= len(src)
      invariant len(st) == len(old(st)) && (len(st) < 15 || crate::bud_store::hdr_same(st, old(st), -1))
      invariant crate::bud_store::kept(st, old(st))
      invariant forall j in 0..k: st[o + j] == src[s0 + j]
      invariant forall j in 16..o: st[j] == old(st)[j]
      invariant n == 0 ==> (forall j in 16..len(st): st[j] == old(st)[j])
      decreases n - k
    {
      // one word past the header: dyn_ok reads only header words (this iteration only)
      reveal crate::bud_store::dyn_ok;
      st[o + k] = src[s0 + k];
      k = k + 1;
    }
  } else {
    while k < n
      invariant 0 <= k && k <= n && n <= 4294967296 && 0 <= o && o <= 1099511627776 && 0 <= s0 && s0 <= 1099511627776
      invariant len(st) == len(old(st)) && (len(st) < 15 || crate::bud_store::hdr_same(st, old(st), -1))
      invariant crate::bud_store::kept(st, old(st))
      invariant n == 0 ==> (forall j in 16..len(st): st[j] == old(st)[j])
      decreases n - k
    {
      crate::bud_store::wr16(inout st, o + k, crate::ent_u16::rd(src, s0 + k));
      k = k + 1;
    }
  }
  let lw: i64 = crate::bud_store::c40(hw(st, 14));
  sh(inout st, 14, lw + n);
}

// Stores src[s0..s0+n) for entry e in the region given by fields (fo, fc): in place when it fits there, otherwise
// appended to the arena (and the region becomes the new words). Sets field fo to the offset. 0 ok, -1 failure.
fn put_units(inout st: [i64], e: i64, fo: i64, fc: i64, src: [i64], s0: i64, n: i64) -> i64
  requires 0 <= s0 && s0 <= 1099511627776 && 0 <= n && n <= 4294967296
  ensures crate::bud_store::kept(st, old(st))
  ensures len(old(st)) >= 15 ==> crate::bud_store::shape_same(st, old(st))
  ensures (result == 0 && fo == 12 && fc == 19 &&
    crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6] && crate::bud_store::has_x(old(st)[old(st)[5] + 10 * e + 9]) && n > 0 && 0 <= old(st)[old(st)[5] + 10 * e + 10 * old(st)[6] + 1]) ==>
    (crate::bud_store::has_x(st[st[5] + 10 * e + 9]) && st[9] <= st[st[5] + 10 * e + 10 * st[6] + 1] &&
    st[st[5] + 10 * e + 10 * st[6] + 1] + n <= len(st) && s0 + n <= len(src) &&
    (forall j in 0..n: st[st[st[5] + 10 * e + 10 * st[6] + 1] + j] == src[s0 + j]))
  ensures result == 0 || result == -1
  ensures (result == 0 && fo == 12 && fc == 19 &&
    crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6] && crate::bud_store::has_x(old(st)[old(st)[5] + 10 * e + 9]) && n == 0) ==> crate::bud_store::has_x(st[st[5] + 10 * e + 9])
{
  let off: i64 = gf(st, e, fo);
  if s0 + n > len(src) { return -1; }
  if fits_region(st, off, gf(st, e, fc), n) {
    write_at(inout st, crate::bud_store::c40(off), src, s0, n);
    return 0;
  }
  let ko: i64 = crate::bud_store::arena_put(inout st, src, s0, s0 + n);
  if ko < 0 { return -1; }
  assert !(fo == 12 && fc == 19 && crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6] &&
    crate::bud_store::has_x(old(st)[old(st)[5] + 10 * e + 9])) || (crate::bud_store::has_x(st[st[5] + 10 * e + 9]) && st[9] <= ko && ko + n <= len(st));
  sf(inout st, e, fo, ko);
  assert !(fo == 12 && fc == 19 && crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6] &&
    crate::bud_store::has_x(old(st)[old(st)[5] + 10 * e + 9])) || (crate::bud_store::has_x(st[st[5] + 10 * e + 9]) && st[st[5] + 10 * e + 10 * st[6] + 1] == ko &&
    (forall j in 0..n: st[ko + j] == src[s0 + j]));
  sf(inout st, e, fc, n);
  return 0;
}

// Adds a packed key the caller knows is absent (caller contract as find_w: canonical words; total otherwise). Used
// by bud_world after its find_w and by grow (unique keys). Entry index, or -1 (nothing usable was added).
pub fn add_w(inout st: [i64], owner: i64, key: [i64], ks: i64, kn: i64) -> i64
  ensures crate::bud_store::kept(st, old(st))
{
  if gf(st, owner, 0) != 1 { return -1; }
  let og: i64 = gf(st, owner, 3);
  let h: i64 = hash_words(owner, og, key, ks, kn);
  return put_key_h(inout st, owner, og, h, key, ks, kn);
}

// add_w() with og = gf(st, owner, 3) and h = hash_words(owner, og, key, ks, kn) already computed (owner is live):
// the probe stops at the first empty or tombstone slot and compares no keys, then put_at() stores the entry there.
fn put_key_h(inout st: [i64], owner: i64, og: i64, h: i64, key: [i64], ks: i64, kn: i64) -> i64
  ensures crate::bud_store::kept(st, old(st))
{
  let slots: i64 = crate::bud_store::c32(hw(st, 4));
  // header words 3, 4 in range: slot base and mask read once (the same addresses slot_pos gives)
  let fast: bool = len(st) >= 5 && slots >= 1;
  let mut sb: i64 = 0;
  if fast { sb = crate::bud_store::c32(st[3]); }
  let mut i: i64 = 0;
  while i < slots
    invariant 0 <= i && i <= slots && slots <= 4294967296
    invariant crate::bud_store::kept(st, old(st))
    decreases slots - i
  {
    let mut p: i64 = -1;
    if fast { p = sb + band(wrapping_add(h, i), slots - 1); } else { p = slot_pos(st, h, i); }
    let w: i64 = crate::ent_u16::rd(st, p);
    if w == 0 || w == -1 { return put_at(inout st, owner, og, h, key, ks, kn, p); }
    i = i + 1;
  }
  return -1;
}

// Link the new entry using its base and the owner's extension. The owner needs an extension
// for the new tail and count, even if this is its first child.
fn link_fast(inout st: [i64], e: i64, n: i64, h: i64, be: i64, owner: i64) -> ()
  requires 16 <= be && be + 10 <= len(st)
  ensures crate::bud_store::kept(st, old(st))
{
  st[be + 5] = n;
  st[be + 6] = h;
  assert crate::bud_store::hdr_same(st, old(st), -1);
  reveal crate::bud_store::dyn_ok;
  let x: i64 = crate::bud_store::xbm(inout st, owner);
  let mut t: i64 = -1;
  if x >= 0 { t = st[x + 8]; }
  st[be + 7] = t;
  st[be + 8] = -1;
  if t >= 0 {
    let bt: i64 = crate::bud_store::eb(st, t);
    if bt >= 0 { st[bt + 8] = e; } else { sf(inout st, t, 8, e); }
  } else if x >= 0 {
    st[x + 7] = e;
  }
  if x >= 0 {
    st[x + 8] = e;
    let oc: i64 = crate::bud_store::c32(st[x]);
    st[x] = oc + 1;
  }
  assert len(st) == len(old(st)) && crate::bud_store::hdr_same(st, old(st), -1);
}

// A pending child of f. Its free-list link must be writable, so a truncated row cannot strand f.
fn reclaimable(st: [i64], f: i64, c: i64, top: i64) -> bool
{
  if c < 3 || c >= top || gf(st, c, 0) != 1 || gf(st, c, 1) != f ||
    gf(st, c, 2) == gf(st, f, 3) { return false; }
  return crate::bud_store::eb(st, c) >= 0;
}

// Exclude a newly dead child list from the live-entry count, saturating at zero.
fn uncount_children(inout st: [i64], e: i64) -> ()
  ensures crate::bud_store::kept(st, old(st))
  ensures len(st) >= 15 ==> crate::bud_store::hdr_same(st, old(st), 12)
{
  let live: i64 = crate::bud_store::c32(hw(st, 12));
  let kids: i64 = crate::bud_store::c32(gf(st, e, 11));
  if live > kids { sh(inout st, 12, live - kids); }
  else { sh(inout st, 12, 0); }
}

// Make a pending descendant available to entry_alloc, leaving its former owner on the free list.
// Fuel bounds the descent even on a malformed child list.
fn reclaim_head(inout st: [i64]) -> ()
  ensures crate::bud_store::kept(st, old(st))
{
  let top: i64 = crate::bud_store::c32(hw(st, 7));
  let cap: i64 = crate::bud_store::c32(hw(st, 6));
  let mut fuel: i64 = top + 1;
  while fuel > 0
    invariant 0 <= fuel && fuel <= 4294967297 && 0 <= top && top <= 4294967296
    invariant crate::bud_store::kept(st, old(st))
    invariant len(st) < 15 || st[7] == old(st)[7]
    decreases fuel
  {
    let f: i64 = hw(st, 8);
    if f < 3 || f >= top || f >= cap || gf(st, f, 0) != 0 { return; }
    let c: i64 = gf(st, f, 9);
    if !reclaimable(st, f, c, top) { return; }
    // A header shorter than 15 cannot have an in-range non-root entry.
    if len(st) < 15 || c < 3 || c >= st[7] || c >= cap { return; }
    let mut n: i64 = gf(st, c, 8);
    if n < 0 || n >= top { n = -1; }
    sf(inout st, f, 9, n);
    if n == -1 { sf(inout st, f, 10, -1); }
    let nc: i64 = crate::bud_store::c32(gf(st, f, 11));
    if nc > 0 { sf(inout st, f, 11, nc - 1); }
    let kw: i64 = crate::bud_keys::words(crate::bud_store::c32(gf(st, c, 5))) +
      crate::bud_store::c40(gf(st, c, 13));
    take_words(inout st, kw);
    // c was already excluded from word 12. Only its own children can become newly dead.
    sf(inout st, c, 0, 0);
    let next_gen: i64 = wrapping_add(gf(st, c, 3), 1);
    sf(inout st, c, 3, next_gen);
    sf(inout st, c, 8, f);
    sh(inout st, 8, c);
    if gf(st, c, 9) < 0 { return; }
    uncount_children(inout st, c);
    fuel = fuel - 1;
  }
}

// Detach c from the free head's existing extension. The next sibling lives in c's base.
fn detach_fast(inout st: [i64], xf: i64, bc: i64, top: i64) -> ()
  requires 16 <= xf && xf + 10 <= len(st) && 16 <= bc && bc + 10 <= len(st)
  ensures crate::bud_store::kept(st, old(st))
{
  let mut n: i64 = st[bc + 8];
  if n < 0 || n >= top { n = -1; }
  st[xf + 7] = n;
  if n == -1 { st[xf + 8] = -1; }
  let nc: i64 = crate::bud_store::c32(st[xf]);
  if nc > 0 { st[xf] = nc - 1; }
  assert len(st) == len(old(st)) && crate::bud_store::hdr_same(st, old(st), -1);
  reveal crate::bud_store::dyn_ok;
}

// The key-region put_units path for an entry with fast base be: the same reads and writes on
// direct words. arena_put changes no header word eb reads and keeps the length, so be stays e's base.
fn put_key_fast(inout st: [i64], be: i64, src: [i64], s0: i64, n: i64) -> i64
  requires 16 <= be && be + 10 <= len(st)
  requires 0 <= s0 && s0 <= 1099511627776 && 0 <= n && n <= 4294967296
  ensures crate::bud_store::kept(st, old(st))
{
  let off: i64 = st[be + 4];
  if s0 + n > len(src) { return -1; }
  if fits_region(st, off, crate::bud_store::kcap_of(st[be + 9]), n) {
    write_at(inout st, crate::bud_store::c40(off), src, s0, n);
    return 0;
  }
  let ko: i64 = crate::bud_store::arena_put(inout st, src, s0, s0 + n);
  if ko < 0 { return -1; }
  set_key_region(inout st, be, ko, n);
  return 0;
}

fn set_key_region(inout st: [i64], be: i64, ko: i64, n: i64) -> ()
  requires 16 <= be && be + 10 <= len(st) && 0 <= n && n <= 4294967296
  ensures crate::bud_store::kept(st, old(st))
{
  st[be + 4] = ko;
  let mut xk: i64 = 2 * n;
  if crate::bud_store::has_x(st[be + 9]) { xk = xk + 1; }
  st[be + 9] = xk;
  assert len(st) == len(old(st)) && crate::bud_store::hdr_same(st, old(st), -1);
  reveal crate::bud_store::dyn_ok;
}

// reclaim_head() then entry_alloc() (P21b). When the free head f is free and its head child c is a pending dead leaf
// (reclaimable, no child list) and both rows have fast bases, reclaim_head would detach c, take its key and blob
// words off word 14, free it (generation + 1) and push it, then return; entry_alloc would pop c, put f back as the
// head and fill c keeping that generation. That end state is written directly: f's list without c, word 14 less c's
// words, c filled with generation gen(c) + 1, head still f, word 12 + 1, with no push and pop.
// Every other case runs the two in order. O(1) on the fast path; reclaim_head's loop otherwise.
fn alloc_entry(inout st: [i64], owner: i64, og: i64) -> i64
  ensures crate::bud_store::kept(st, old(st))
{
  if len(st) >= 16 {
    let top: i64 = crate::bud_store::c32(st[7]);
    let f: i64 = st[8];
    if f >= 3 && f < top {
      let bf: i64 = crate::bud_store::eb(st, f);
      if bf >= 0 && st[bf] == 0 {
        let xf: i64 = crate::bud_store::xb(st, f);
        if xf >= 0 {
          let c: i64 = st[xf + 7];
          if c >= 3 && c < top {
            let bc: i64 = crate::bud_store::eb(st, c);
            if bc >= 0 && st[bc] == 1 && st[bc + 1] == f && st[bc + 2] != st[bf + 3] && head(st, c) < 0 {
              let g: i64 = wrapping_add(st[bc + 3], 1);
              let kw: i64 = crate::bud_keys::words(crate::bud_store::c32(st[bc + 5])) +
                blob_len(st, c);
              detach_fast(inout st, xf, bc, top);
              take_words(inout st, kw);
              crate::bud_store::fill_entry(inout st, c, owner, og, g, false);
              let live: i64 = crate::bud_store::c32(hw(st, 12));
              sh(inout st, 12, live + 1);
              return c;
            }
          }
        }
      }
    }
  }
  reclaim_head(inout st);
  return crate::bud_store::entry_alloc(inout st, owner, og);
}

// The insert half of put_key_h(): a new entry for the packed key in index slot `slot` (absolute address, the first
// empty or tombstone slot on h's probe path). The key words are stored by a plain word copy. Entry index, or -1
// (nothing linked or indexed).
fn put_at(inout st: [i64], owner: i64, og: i64, h: i64, key: [i64], ks: i64, kn: i64, slot: i64) -> i64
  ensures crate::bud_store::kept(st, old(st))
{
  let e: i64 = alloc_entry(inout st, owner, og);
  if e < 0 { return -1; }
  let n: i64 = crate::bud_store::c32(kn);
  let s0: i64 = crate::bud_store::c40(ks);
  let be: i64 = crate::bud_store::eb(st, e);
  let mut rk: i64 = 0;
  if be >= 0 {
    rk = put_key_fast(inout st, be, key, s0, crate::bud_keys::words(n));
  } else {
    rk = put_units(inout st,e,4,18,key,s0,crate::bud_keys::words(n));
  }
  if rk < 0 {
    crate::bud_store::entry_free(inout st, e);
    return -1;
  }
  let bo: i64 = crate::bud_store::eb(st, owner);
  if be >= 0 && bo >= 0 {
    link_fast(inout st, e, n, h, be, owner);
  } else {
    sf(inout st, e, 5, n);
    sf(inout st, e, 6, h);
    // append at the owner's tail
    let t: i64 = gf(st, owner, 10);
    sf(inout st, e, 7, t);
    sf(inout st, e, 8, -1);
    if t >= 0 {
      sf(inout st, t, 8, e);
    } else {
      sf(inout st, owner, 9, e);
    }
    sf(inout st, owner, 10, e);
    let oc: i64 = crate::bud_store::c32(gf(st, owner, 11));
    sf(inout st, owner, 11, oc + 1);
  }
  // index slot
  let old: i64 = crate::ent_u16::rd(st, slot);
  let used: i64 = crate::bud_store::c32(hw(st, 13));
  crate::bud_store::wr16(inout st, slot, slot_word(crate::bud_store::c32(e), h));
  if old == 0 { sh(inout st, 13, used + 1); }
  return e;
}

// Tombstones the slot of entry e, takes its key and blob off the live arena count and frees it (its arena regions
// stay with the entry for reuse). Links are the caller's.
fn drop_entry(inout st: [i64], e: i64) -> ()
  ensures crate::bud_store::kept(st, old(st))
{
  let top: i64 = crate::bud_store::c32(hw(st, 7));
  if e < 3 || e >= top { return; }
  let b: i64 = crate::bud_store::eb(st, e);
  let mut kw: i64 = 0;
  if b >= 0 {
    // gf on direct words, same order (bud_store::eb); the slot write may land on the entry's own fields on a corrupt
    // buffer, so the key and blob lengths are read after it as before. It never lands on the header (wr16), so b
    // stays the entry base.
    if st[b] != 1 { return; }
    let sl: i64 = slot_of(st, e, st[b + 6]);
    if sl >= 0 { crate::bud_store::wr16(inout st, sl, -1); }
    kw = crate::bud_keys::words(crate::bud_store::c32(st[b + 5])) + blob_len(st, e);
  } else {
    if gf(st, e, 0) != 1 { return; }
    let sl: i64 = slot_of(st, e, gf(st, e, 6));
    if sl >= 0 { crate::bud_store::wr16(inout st, sl, -1); }
    kw = crate::bud_keys::words(crate::bud_store::c32(gf(st, e, 5))) + crate::bud_store::c40(gf(st, e, 13));
  }
  let lw: i64 = crate::bud_store::c40(hw(st, 14));
  if lw > kw {
    sh(inout st, 14, lw - kw);
  } else {
    sh(inout st, 14, 0);
  }
  crate::bud_store::entry_free(inout st, e);
}

// Unlinks e from the ordered child list of owner.
fn unlink(inout st: [i64], e: i64, owner: i64) -> ()
  ensures crate::bud_store::kept(st, old(st))
{
  let p: i64 = gf(st, e, 7);
  let n: i64 = gf(st, e, 8);
  if p >= 0 {
    sf(inout st, p, 8, n);
  } else {
    sf(inout st, owner, 9, n);
  }
  if n >= 0 {
    sf(inout st, n, 7, p);
  } else {
    sf(inout st, owner, 10, p);
  }
  let oc: i64 = gf(st, owner, 11);
  if oc > 0 { sf(inout st, owner, 11, oc - 1); }
}

// M8 forgets a turn under root 2. Its activities become dead when the generation is bumped, and allocation
// reclaims them from the preserved child list. Work is independent of the number of activities.
pub fn forget_turn_entry(inout st: [i64], e: i64) -> ()
  ensures crate::bud_store::kept(st, old(st))
{
  let top: i64 = crate::bud_store::c32(hw(st, 7));
  if e < 3 || e >= top || gf(st, e, 0) != 1 { return; }
  unlink(inout st, e, 2);
  uncount_children(inout st, e);
  drop_entry(inout st, e);
}

// Unlinks entry e from its owner and frees it with its whole subtree (any depth), in post order without a stack: the
// walk descends to the head child while it is a live entry owned by the current node, frees a leaf and moves to its
// next sibling, and climbs to the owner (freeing it) when a list ends. On a store whose child lists are well formed
// (complete, mutually linked, acyclic: I2, which every store this module builds has and admission I0 + I1 does not
// check), every entry of the subtree is entered at most once and freed once, so the walk takes at most
// 2 * (subtree size) + 1 steps. Eager remove leaves no state-1 entry with a newly freed owner. M8 forget
// deliberately leaves dead children, excluded from word 12. On any other buffer the
// 2 * walk_limit + 2 step budget bounds the walk and every access stays total, but the walk may end a list early
// (a candidate not owned by u ends it) and leave entries behind. O(probe length + subtree): e's own slot is cleared,
// the descendants' slots are left for the next rehash (drop_child). Roots are never removed.
pub fn remove(inout st: [i64], e: i64) -> ()
  ensures crate::bud_store::kept(st, old(st))
{
  let top: i64 = crate::bud_store::c32(hw(st, 7));
  if e < 3 || e >= top { return; }
  if gf(st, e, 0) != 1 { return; }
  let owner: i64 = gf(st, e, 1);
  // A dead child of a forgotten M8 turn (its owner freed or reused) is already off word 12; removing it again would
  // count it twice. Callers reach entries by key lookup, which never returns one; this guards a stale index.
  if owner >= 3 && (gf(st, owner, 0) != 1 || gf(st, e, 2) != gf(st, owner, 3)) { return; }
  unlink(inout st, e, owner);
  let mut b: i64 = 2 * walk_limit(st) + 2;
  // u: the node whose list is walked (e or a live descendant not yet freed); c: the next candidate child of u.
  let mut u: i64 = e;
  let mut c: i64 = gf(st, e, 9);
  // Arena words of the entries dropped by drop_child() whose word-14 update is still pending (-1: none, else
  // saturated at 2^41).
  let mut pend: i64 = -1;
  while b > 0
    invariant 0 <= b && b <= 8589934594 && -1 <= pend && pend <= 2199023255552
    invariant crate::bud_store::kept(st, old(st))
    decreases b
  {
    b = b - 1;
    let mut cs: i64 = -1;
    let mut co: i64 = -1;
    let mut ch: i64 = -1;
    let mut nc: i64 = -1;
    if c >= 0 {
      let bc: i64 = crate::bud_store::eb(st, c);
      if bc >= 0 {
        cs = st[bc]; co = st[bc + 1]; nc = st[bc + 8]; ch = head(st, c);
      } else {
        cs = gf(st, c, 0); co = gf(st, c, 1); nc = gf(st, c, 8); ch = gf(st, c, 9);
      }
    }
    if cs == 1 && co == u {
      if ch >= 0 {
        // descend: c's list first, c itself when it ends
        u = c;
        c = ch;
      } else {
        pend = drop_desc(inout st, c, pend);
        c = nc;
      }
    } else {
      // u's list ends: done at e, else free u and go on with its next sibling under its owner
      if u == e { b = 0; } else {
        let up: i64 = gf(st, u, 1);
        let un: i64 = gf(st, u, 8);
        pend = drop_desc(inout st, u, pend);
        u = up;
        c = un;
      }
    }
  }
  if pend >= 0 { take_words(inout st, pend); }
  drop_entry(inout st, e);
}

// drop_child(c) with its word-14 update folded into the pending sum pend (-1: none pending): the new pending sum.
// When c has no fast base (drop_child gives -1) the pending update is applied first and drop_entry frees c, so the
// words written are those of one drop_entry per entry in the same order.
fn drop_desc(inout st: [i64], c: i64, pend: i64) -> i64
  requires -1 <= pend && pend <= 2199023255552
  ensures -1 <= result && result <= 2199023255552
  ensures crate::bud_store::kept(st, old(st))
{
  let kw: i64 = drop_child(inout st, c);
  if kw >= 0 {
    let mut s: i64 = kw;
    if pend > 0 { s = pend + kw; }
    if s > 2199023255552 { s = 2199023255552; }
    return s;
  }
  if kw == -1 {
    if pend >= 0 { take_words(inout st, pend); }
    drop_entry(inout st, c);
    return -1;
  }
  return pend;
}

// Word 14 (live arena words) minus kw, saturating at 0: drop_entry's update. Applying it once with the sum of several
// drops gives the same word as applying it per drop (each kw >= 0; after the first write the word is in 0..2^40, so
// c40 is the identity, and a sum saturated at 2^41 > 2^40 still yields 0).
fn take_words(inout st: [i64], kw: i64) -> ()
  requires 0 <= kw
  ensures crate::bud_store::kept(st, old(st))
  ensures len(st) >= 15 ==> crate::bud_store::hdr_same(st, old(st), 14)
{
  let lw: i64 = crate::bud_store::c40(hw(st, 14));
  if lw > kw {
    sh(inout st, 14, lw - kw);
  } else {
    sh(inout st, 14, 0);
  }
}

// drop_entry(c) for a descendant of an entry being removed, without its slot write and its word-14 update (the caller,
// remove via drop_desc, applies the latter afterwards with take_words): the returned arena words (>= 0), or -2 if drop_entry would
// have done nothing, or -1 (nothing written) when e has no fast base (the caller then applies the pending update and
// calls drop_entry).
// The slot is left in place (lazy deletion, as an open-addressing table with generation-stamped entries does): a
// slot word that names a free entry, a dead child of a forgotten turn, or an entry reused for another key, owner
// or owner generation never matches a
// lookup (state, owner, owner generation, hash and key are compared), is not reused by inserts, and is dropped by the
// next rehash, so it costs what a tombstone costs. A match therefore still names the live entry for the key, which is
// unique per owner. entry_free writes header words 8 and 12 and entry fields past word 16 (eb), never word 14, and
// nothing here reads word 14, so deferring its update leaves every other word as drop_entry would, except the slot.
fn drop_child(inout st: [i64], c: i64) -> i64
  ensures -2 <= result && result <= 1099780063232
  ensures crate::bud_store::kept(st, old(st))
{
  let b: i64 = crate::bud_store::eb(st, c);
  if b < 0 { return -1; }
  // b >= 16 and b + 10 <= len(st), so header word 7 is in range
  let top: i64 = crate::bud_store::c32(st[7]);
  if c < 3 || c >= top { return -2; }
  if st[b] != 1 { return -2; }
  let kw: i64 = crate::bud_keys::words(crate::bud_store::c32(st[b + 5])) + blob_len(st, c);
  crate::bud_store::entry_free(inout st, c);
  return kw;
}

// Replaces the blob of entry e by src[s..s+n), written over the old blob region when it fits, else appended to the
// arena. 0 ok, -1 failure (nothing changed).
pub fn set_blob(inout st: [i64], e: i64, src: [i64], s: i64, n: i64) -> i64
  ensures crate::bud_store::kept(st, old(st))
  ensures (result == 0 && crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6] && n == 0 &&
    !crate::bud_store::has_x(old(st)[old(st)[5] + 10 * e + 9])) ==> !crate::bud_store::has_x(st[st[5] + 10 * e + 9])
  ensures len(old(st)) >= 15 ==> crate::bud_store::shape_same(st, old(st))
  ensures (result == 0 && crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6] &&
    old(st)[old(st)[5] + 10 * e + 9] == 0 && 0 < n && n <= 4294967296) ==>
    crate::bud_store::has_x(st[st[5] + 10 * e + 9])
  ensures (result == 0 && crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6] &&
    !crate::bud_store::has_x(old(st)[old(st)[5] + 10 * e + 9]) && 0 < n && n <= 4294967296) ==>
    st[st[5] + 10 * e + 10 * st[6] + 2] == n
  ensures (result == 0 && crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6] &&
    !crate::bud_store::has_x(old(st)[old(st)[5] + 10 * e + 9]) && 0 < n && n <= 4294967296) ==>
    st[st[5] + 10 * e + 10 * st[6] + 1] == old(st)[10]
  ensures (result == 0 && crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6] &&
    !crate::bud_store::has_x(old(st)[old(st)[5] + 10 * e + 9]) && 0 < n && n <= 4294967296) ==>
    st[9] <= old(st)[10] && old(st)[10] + n <= len(st)
  ensures (result == 0 && crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6] &&
    !crate::bud_store::has_x(old(st)[old(st)[5] + 10 * e + 9]) && 0 < n && n <= 4294967296) ==>
    (0 <= s && s <= 1099511627776 ==> s + n <= len(src))
  ensures (result == 0 && crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6] &&
    !crate::bud_store::has_x(old(st)[old(st)[5] + 10 * e + 9]) && 0 < n && n <= 4294967296) ==>
    (0 <= s && s <= 1099511627776 ==> (forall j in 0..n: st[old(st)[10] + j] == src[s + j]))
  ensures result == 0 || result == -1
  ensures (result == 0 && crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6] &&
    old(st)[old(st)[5] + 10 * e + 9] == 0 && n == 0) ==> st[st[5] + 10 * e + 9] == 0
  ensures (result == 0 && crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6]) ==> (16 <= st[5] + 10 * e &&
    st[5] + 10 * e + 10 <= st[5] + 10 * e + 10 * st[6] && st[5] + 10 * e + 10 * st[6] + 10 <= st[9] && st[9] <= len(st))
  ensures (result == 0 && crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6] && crate::bud_store::has_x(old(st)[old(st)[5] + 10 * e + 9]) &&
    0 <= n && n <= 4294967296 && (n == 0 || 0 <= old(st)[old(st)[5] + 10 * e + 10 * old(st)[6] + 1])) ==>
    (crate::bud_store::has_x(st[st[5] + 10 * e + 9]) && st[st[5] + 10 * e + 10 * st[6] + 2] == n)
  ensures (result == 0 && crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6] && crate::bud_store::has_x(old(st)[old(st)[5] + 10 * e + 9]) &&
    0 < n && n <= 4294967296 && 0 <= old(st)[old(st)[5] + 10 * e + 10 * old(st)[6] + 1] && 0 <= s && s <= 1099511627776) ==>
    (st[9] <= st[st[5] + 10 * e + 10 * st[6] + 1] && st[st[5] + 10 * e + 10 * st[6] + 1] + n <= len(st) && s + n <= len(src) &&
    (forall j in 0..n: st[st[st[5] + 10 * e + 10 * st[6] + 1] + j] == src[s + j]))
{
  let s0: i64 = crate::bud_store::c40(s);
  let m: i64 = crate::bud_store::c32(n);
  let b: i64 = crate::bud_store::eb(st, e);
  let l: i64 = len(st);
  if b >= 0 {
    let top0: i64 = crate::bud_store::c32(st[7]);
    if e < 0 || e >= top0 { return -1; }
    if st[b] != 1 { return -1; }
  }
  let x: i64 = crate::bud_store::xb(st, e);
  if b >= 0 && x >= 0 && s0 + m <= len(src) {
    // An in-place copy must leave the header, extension and its flag intact on malformed buffers too.
    let off: i64 = st[x + 1];
    let o: i64 = crate::bud_store::c40(off);
    if fits_region(st, off, st[x + 9], m) && o >= 16 && o + m <= l &&
      (o + m <= x || o >= x + 10) && (o + m <= b + 9 || o >= b + 10) {
      let ob0: i64 = crate::bud_store::c40(st[x + 2]);
      let mut k: i64 = 0;
      while k < m
        invariant 0 <= k && k <= m && 16 <= o && o + m <= l && l == len(st) && 0 <= s0 && s0 + m <= len(src)
        invariant len(st) == len(old(st)) && crate::bud_store::hdr_same(st, old(st), -1)
        invariant crate::bud_store::kept(st, old(st))
        invariant 16 <= b && b + 10 <= l && 16 <= x && x + 10 <= l
        invariant (o + m <= x || o >= x + 10) && (o + m <= b + 9 || o >= b + 10)
        invariant st[b + 9] == old(st)[b + 9] && st[x + 1] == off && off == old(st)[x + 1]
        invariant forall j in 0..k: st[o + j] == src[s0 + j]
        decreases m - k
      {
        reveal crate::bud_store::dyn_ok;
        st[o + k] = src[s0 + k];
        k = k + 1;
      }
      let lw0: i64 = crate::bud_store::c40(st[14]) + m;
      st[14] = lw0;
      st[x + 2] = m;
      let lw1: i64 = crate::bud_store::c40(lw0);
      if lw1 > ob0 {
        st[14] = lw1 - ob0;
      } else {
        st[14] = 0;
      }
      // word 14 >= 0 and the blob length past the header: dyn_ok carried over from the copy loop
      reveal crate::bud_store::dyn_ok;
      return 0;
    }
  }
  let top: i64 = crate::bud_store::c32(hw(st, 7));
  if e < 0 || e >= top { return -1; }
  if gf(st, e, 0) != 1 { return -1; }
  // Copying an empty blob into a fresh entry needs neither arena space nor an extension.
  if x < 0 && m == 0 {
    if s0 > len(src) { return -1; }
    return 0;
  }
  let mut ob: i64 = 0;
  if x < 0 {
    // No extension: put_units would find the empty region (offset 0, capacity 0) too small, append to the arena and
    // then create the extension through its first field write. The same writes with one extension lookup.
    if s0 + m > len(src) { return -1; }
    let ko: i64 = crate::bud_store::arena_put(inout st, src, s0, s0 + m);
    if ko < 0 { return -1; }
    assert !(crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6]) ||
      st[st[5] + 10 * e + 9] == old(st)[old(st)[5] + 10 * e + 9];
    assert !(crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6]) ||
      (crate::bud_store::valid(st) && e < st[6] && b == st[5] + 10 * e);
    let nx: i64 = crate::bud_store::xbm(inout st, e);
    if nx >= 0 {
      assert !(crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6] && old(st)[old(st)[5] + 10 * e + 9] == 0) || (st[b + 9] == 1 && b + 9 < nx);
      crate::bud_store::wr16(inout st, nx + 1, ko);
      crate::bud_store::wr16(inout st, nx + 9, m);
      crate::bud_store::wr16(inout st, nx + 2, m);
      assert !(crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6] && old(st)[old(st)[5] + 10 * e + 9] == 0) || st[b + 9] == 1;
      assert !(crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6]) || (b == st[5] + 10 * e && nx == b + 10 * st[6]);
      assert st[nx + 1] == ko && st[nx + 2] == m;
      assert !(crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6]) ||
        (forall j in 0..m: st[ko + j] == src[s0 + j]);
    }
  } else {
    ob = crate::bud_store::c40(gf(st, e, 13));
    let rb: i64 = put_units(inout st, e, 12, 19, src, s0, m);
    if rb < 0 { return -1; }
    sf(inout st, e, 13, m);
  }
  assert !(crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6] &&
    old(st)[old(st)[5] + 10 * e + 9] == 0) ||
    (st[st[5] + 10 * e + 9] == 1 && st[st[5] + 10 * e + 10 * st[6] + 2] == m &&
    st[st[5] + 10 * e + 10 * st[6] + 1] == old(st)[10] &&
    (forall j in 0..m: st[old(st)[10] + j] == src[s0 + j]));
  assert !(crate::bud_store::valid(old(st)) && 0 <= e && e < old(st)[6] && !crate::bud_store::has_x(old(st)[old(st)[5] + 10 * e + 9])) ||
    (st[st[5] + 10 * e + 10 * st[6] + 2] == m && st[st[5] + 10 * e + 10 * st[6] + 1] == old(st)[10] &&
    (forall j in 0..m: st[old(st)[10] + j] == src[s0 + j]));
  let lw: i64 = crate::bud_store::c40(hw(st, 14));
  if lw > ob {
    sh(inout st, 14, lw - ob);
  } else {
    sh(inout st, 14, 0);
  }
  return 0;
}

// Would `words` more arena words for entry e's blob fit in its current blob region?
pub fn blob_fits(st: [i64], e: i64, words: i64) -> bool
{
  let x: i64 = crate::bud_store::xb(st, e);
  if x >= 0 { return fits_region(st, st[x + 1], st[x + 9], words); }
  return fits_region(st, 0, 0, words);
}

// ---- index maintenance ----

// rehash()'s test for entry e on the general path: live, and its owner is a root or live.
fn reinsert(st: [i64], e: i64) -> bool
{
  return gf(st, e, 0) == 1 && (gf(st, e, 1) < 3 || gf(st, gf(st, e, 1), 0) == 1);
}

// rehash()'s read of entry e: its stored hash when reinsert(st, e) and that hash is not -1, else -1 (then the caller
// asks reinsert, so a live entry whose hash is -1 is still reinserted). On direct words when e has a fast base.
fn rehash_hash(st: [i64], e: i64) -> i64
{
  let be: i64 = crate::bud_store::eb(st, e);
  if be < 0 {
    if reinsert(st, e) { return gf(st, e, 6); }
    return -1;
  }
  if st[be] != 1 { return -1; }
  let o: i64 = st[be + 1];
  if o >= 3 {
    let bo: i64 = crate::bud_store::eb(st, o);
    if bo >= 0 {
      if st[bo] != 1 { return -1; }
    } else {
      if gf(st, o, 0) != 1 { return -1; }
    }
  }
  return st[be + 6];
}

// Clears the slot table and reinserts live non-root entries by their stored hash, dropping tombstones and dead entries.
// O(slots + entry top).
fn rehash(inout st: [i64]) -> ()
  ensures crate::bud_store::kept(st, old(st))
{
  let slots: i64 = crate::bud_store::c32(hw(st, 4));
  let sb: i64 = crate::bud_store::c32(hw(st, 3));
  let top: i64 = crate::bud_store::c32(hw(st, 7));
  let mut i: i64 = 0;
  if sb >= 16 && sb + slots <= len(st) {
    // the whole table past the header and in range: wr16's checks hold for every slot (same writes)
    while i < slots
      invariant 0 <= i && i <= slots && 16 <= sb && sb + slots <= len(st)
      invariant len(st) == len(old(st)) && (len(st) < 15 || crate::bud_store::hdr_same(st, old(st), -1))
      invariant crate::bud_store::kept(st, old(st))
      decreases slots - i
    {
      reveal crate::bud_store::dyn_ok;
      st[sb + i] = 0;
      i = i + 1;
    }
  } else {
    while i < slots
      invariant 0 <= i && i <= slots && slots <= 4294967296 && 0 <= sb && sb <= 4294967296
      invariant len(st) == len(old(st)) && (len(st) < 15 || crate::bud_store::hdr_same(st, old(st), -1))
      invariant crate::bud_store::kept(st, old(st))
      decreases slots - i
    {
      crate::bud_store::wr16(inout st, sb + i, 0);
      i = i + 1;
    }
  }
  let mut used: i64 = 0;
  let mut e: i64 = 3;
  while e < top
    invariant 3 <= e && e <= 4294967297 && 0 <= used && used <= e && top <= 4294967296
    invariant len(st) == len(old(st)) && (len(st) < 15 || crate::bud_store::hdr_same(st, old(st), -1))
    invariant crate::bud_store::kept(st, old(st))
    decreases 4294967297 - e
  {
    // Reinsert live entries only: a dead child (state 1, owner freed) would make used exceed live. Read on direct
    // words when e (and its owner) have fast bases, the same fields gf reads otherwise.
    let h: i64 = rehash_hash(st, e);
    if h != -1 || reinsert(st, e) {
      let mut j: i64 = 0;
      let mut placed: bool = false;
      while j < slots
        invariant 0 <= j && j <= slots && slots <= 4294967296
        invariant len(st) == len(old(st)) && (len(st) < 15 || crate::bud_store::hdr_same(st, old(st), -1))
        invariant crate::bud_store::kept(st, old(st))
        decreases slots - j
      {
        let p: i64 = slot_pos(st, h, j);
        if crate::ent_u16::rd(st, p) == 0 {
          crate::bud_store::wr16(inout st, p, slot_word(e, h));
          placed = true;
          j = slots;
        } else {
          j = j + 1;
        }
      }
      if placed { used = used + 1; }
    }
    e = e + 1;
  }
  sh(inout st, 13, used);
}

// need() with tombstone recovery: when only the used-slot bound fails and the live entries and words would fit, the index is
// rebuilt in place first (amortized O(1) on a valid store: it runs after at least slots/8 - entries tombstones have
// accumulated).
// Same result convention as bud_store::need.
pub fn make_room(inout st: [i64], entries: i64, words: i64) -> i64
  ensures crate::bud_store::kept(st, old(st))
{
  let r: i64 = room(inout st, entries, words);
  if r == -1 { return 0; }
  return r;
}

// make_room() that tells whether it rehashed: 0 fits (nothing written), -1 rehashed and fits now, otherwise need()'s
// N > 0 (after a rehash too, only on a buffer outside the premise stated in room_plan). room_plan() decides, then
// room_apply() rehashes only when the plan says so.
fn room(inout st: [i64], entries: i64, words: i64) -> i64
  ensures crate::bud_store::kept(st, old(st))
{
  let p: i64 = room_plan(st, entries, words);
  return room_apply(inout st, p, entries, words);
}

// room()'s decision, write-free (P19a): 0 fits as the store is, -1 room() rebuilds the index first (then it fits on
// a store with a valid layout whose word 12 counts its live entries, see below), otherwise need()'s N > 0: Grow(N)
// with nothing rebuilt. A caller that must not change st before a later step (bud_lifecycle::maybe_close before its
// isQuiet answer) asks the plan first and passes it to room_apply() afterwards, on the unchanged st.
pub fn room_plan(st: [i64], entries: i64, words: i64) -> i64
  ensures result == 0 || result == -1 || (464 <= result && result <= 1099511627776)
{
  let r: i64 = crate::bud_store::need(st, entries, words);
  let ents: i64 = crate::bud_store::c32(entries);
  let live: i64 = crate::bud_store::c32(hw(st, 12));
  let used: i64 = crate::bud_store::c32(hw(st, 13));
  let slots: i64 = crate::bud_store::c32(hw(st, 4));
  if r == 0 {
    // Load policy: while the live entries take at most 3/8 of the slots, tombstones and the slots of dead entries are
    // dropped as soon as the index would pass half full, so probes stay short (P21b: at a quarter, a store whose live
    // entries were between 1/4 and 3/8 of the slots ran at up to 3/4 load until the bound below). A rehash costs
    // O(slots + entry top) passes (probe lengths depend on the hash spread) and, on a store with a valid layout whose
    // word 12 counts its live entries, leaves used = live - 3 (the roots are not in the index), so used + ents <=
    // 3/8 of the slots and the next early rehash is at least slots/8 inserts away (amortized O(1) in frequency).
    // On any other buffer the rehash can raise word 13 (P21b audit), so room_apply asks need() again and a Grow can
    // follow the rehash (same key set), as in the branch below.
    if used + ents > slots / 2 && live + ents <= slots * 3 / 8 { return -1; }
    return 0;
  }
  let cap: i64 = crate::bud_store::c32(hw(st, 6));
  let wds: i64 = crate::bud_store::c40(words);
  let top: i64 = crate::bud_store::c40(hw(st, 10));
  let ae: i64 = crate::bud_store::c40(hw(st, 11));
  // Rehash only when the slot bound is the sole failure, so a Grow result never follows a state change (§8.1).
  // On a store with a valid layout (cap = slots/2, as bud_store::valid checks) whose word 12 counts its
  // live entries, rehash skips dead entries, so used <= live, and with
  // live + ents <= cap = slots/2 the second need() returns 0. On any other buffer a Grow can follow the rehash
  // (the index was rebuilt with the same key set); room_w states the same scope.
  if used + ents > slots * 3 / 4 && live + ents <= cap && wds <= ae - top { return -1; }
  return r;
}

// Carries out plan p = room_plan(st, entries, words) of the same st (P19a): p != -1 writes nothing and returns p
// (word for word the same st); p == -1 rebuilds the index and returns -1 when need() then fits, else need()'s N > 0.
// The first ensures is what lets maybe_close skip this call when p == 0 and leave st untouched before its answer.
pub fn room_apply(inout st: [i64], p: i64, entries: i64, words: i64) -> i64
  ensures p != -1 ==> (result == p && len(st) == len(old(st)) && (forall k in 0..len(old(st)): st[k] == old(st)[k]))
  ensures crate::bud_store::kept(st, old(st))
{
  if p != -1 { return p; }
  rehash(inout st);
  let r1: i64 = crate::bud_store::need(st, entries, words);
  if r1 == 0 { return -1; }
  return r1;
}

// find_w(), and when the key is absent room(entries, words) and the insert, hashing the key once.
// key[ks .. ks+words(kn)) canonical (caller contract, bud_keys::slice_ok); total otherwise. `words` is the arena
// words to reserve (the key takes bud_keys::words(kn), plus any blob).
// 0 already present, 1 added, -N Grow(N) (nothing written), 2 invalid or the add failed.
// One probe pass serves both the lookup and the insert: probe_w() yields the slot put_key_h() would pick,
// and room() writes nothing unless it rehashes, in which case the insert probes the rebuilt index again.
pub fn add_absent_w(inout st: [i64], owner: i64, key: [i64], ks: i64, kn: i64, entries: i64, words: i64) -> i64
  ensures crate::bud_store::kept(st, old(st))
{
  let og: i64 = gf(st, owner, 3);
  let h: i64 = hash_words(owner, og, key, ks, kn);
  let slot: i64 = probe_w(st, owner, og, h, key, ks, kn);
  if slot == -2 { return 0; }
  let nd: i64 = room(inout st, entries, words);
  if nd > 0 { return -nd; }
  if nd < -1 { return 2; }
  if gf(st, owner, 0) != 1 { return 2; }
  let mut x: i64 = -1;
  if nd == -1 {
    x = put_key_h(inout st, owner, og, h, key, ks, kn);
  } else if slot >= 0 {
    x = put_at(inout st, owner, og, h, key, ks, kn, slot);
  }
  if x < 0 { return 2; }
  return 1;
}

// find_h_w() and put_key_h()'s slot choice in one probe pass: -2 if the key is
// present, else the first empty or tombstone slot on h's probe path (absolute address, >= 0), or -1 if there is none.
// Up to the first empty slot both loops read the same words; find_h_w stops there, put_key_h stops at the first free
// slot. With fewer than 5 words or no slots both see slot count 0 (hw reads 0), so neither probes.
fn probe_w(st: [i64], owner: i64, og: i64, h: i64, key: [i64], ks: i64, kn: i64) -> i64
{
  let slots: i64 = crate::bud_store::c32(hw(st, 4));
  if len(st) < 5 || slots < 1 { return -1; }
  let ht: i64 = tag(h);
  let sb: i64 = crate::bud_store::c32(st[3]);
  let mask: i64 = slots - 1;
  let n: i64 = len(st);
  let mut free: i64 = -1;
  let mut i: i64 = 0;
  while i < slots
    invariant 0 <= i && i <= slots && slots <= 4294967296 && n == len(st)
    decreases slots - i
  {
    let p: i64 = sb + band(wrapping_add(h, i), mask);
    let mut w: i64 = 0;
    if p >= 0 && p < n { w = st[p]; }
    if w == 0 {
      if free < 0 { free = p; }
      return free;
    }
    if w == -1 {
      if free < 0 { free = p; }
    } else if w > 0 && ushr(w, 32) == ht {
      let e: i64 = slot_entry(w);
      if entry_matches_w(st, e, owner, og, h, key, ks, kn) { return -2; }
    }
    i = i + 1;
  }
  return free;
}

// ---- grow ----

// Copies entry pe of prev (key, blob, scalars) as a new child of nowner in nxt. New entry index or -1.
fn copy_node(prev: [i64], inout nxt: [i64], pe: i64, nowner: i64) -> i64
  ensures crate::bud_store::kept(nxt, old(nxt))
{
  let ne: i64 = put_node(prev, inout nxt, pe, nowner);
  if ne < 0 { return -1; }
  let p: i64 = copy_pay(prev, inout nxt, pe, ne);
  if p != 0 { return -1; }
  return ne;
}

// The key of entry pe of prev as a new child of nowner in nxt (no payload). New entry index or -1.
fn put_node(prev: [i64], inout nxt: [i64], pe: i64, nowner: i64) -> i64
  ensures crate::bud_store::kept(nxt, old(nxt))
{
  let koff: i64 = crate::bud_store::c40(gf(prev, pe, 4));
  let klen: i64 = crate::bud_store::c32(gf(prev, pe, 5));
  let og: i64 = gf(nxt,nowner,3);
  let mut h: i64 = gf(prev,pe,6);
  // Reuse the stored hash unless compaction changed its owner seed.
  if gf(prev,pe,1) != nowner || gf(prev,pe,2) != og {
    h = crate::bud_keys::hash(mix(1469598103934665603,
      wrapping_add(nowner,wrapping_mul(og,4294967296))),prev,koff,klen);
  }
  return put_key_h(inout nxt,nowner,og,h,prev,koff,klen);
}

// Copies the payload of entry pe of prev (blob and values v0..v3) to entry ne of nxt: 0 ok, -1 failure. Without an
// extension the blob and scalars read as defaults (empty blob, 0), which a fresh ne (or a fresh root) already has.
fn copy_pay(prev: [i64], inout nxt: [i64], pe: i64, ne: i64) -> i64
  ensures crate::bud_store::kept(nxt, old(nxt))
  ensures (result == 0 && crate::bud_store::valid(prev) && 0 <= pe && pe < prev[6] &&
    !crate::bud_store::has_x(prev[prev[5] + 10 * pe + 9])) ==>
    (forall j in 0..len(nxt): nxt[j] == old(nxt)[j])
  ensures (result == 0 && crate::bud_store::valid(prev) && 0 <= pe && pe < prev[6] &&
    crate::bud_store::valid(old(nxt)) && 0 <= ne && ne < old(nxt)[6] && crate::bud_store::has_x(prev[prev[5] + 10 * pe + 9])) ==>
    (crate::bud_store::has_x(nxt[nxt[5] + 10 * ne + 9]) ==>
    (nxt[nxt[5] + 10 * ne + 10 * nxt[6] + 3] == prev[prev[5] + 10 * pe + 10 * prev[6] + 3] &&
    nxt[nxt[5] + 10 * ne + 10 * nxt[6] + 4] == prev[prev[5] + 10 * pe + 10 * prev[6] + 4] &&
    nxt[nxt[5] + 10 * ne + 10 * nxt[6] + 5] == prev[prev[5] + 10 * pe + 10 * prev[6] + 5] &&
    nxt[nxt[5] + 10 * ne + 10 * nxt[6] + 6] == prev[prev[5] + 10 * pe + 10 * prev[6] + 6]))
  ensures (result == 0 && crate::bud_store::valid(prev) && 0 <= pe && pe < prev[6] &&
    crate::bud_store::valid(old(nxt)) && 0 <= ne && ne < old(nxt)[6] &&
    crate::bud_store::has_x(prev[prev[5] + 10 * pe + 9]) && old(nxt)[old(nxt)[5] + 10 * ne + 9] == 0 &&
    0 < prev[prev[5] + 10 * pe + 10 * prev[6] + 2] && prev[prev[5] + 10 * pe + 10 * prev[6] + 2] <= 4294967296) ==>
    (crate::bud_store::has_x(nxt[nxt[5] + 10 * ne + 9]) && nxt[nxt[5] + 10 * ne + 10 * nxt[6] + 2] == prev[prev[5] + 10 * pe + 10 * prev[6] + 2])
  ensures (result == 0 && crate::bud_store::valid(prev) && 0 <= pe && pe < prev[6] &&
    crate::bud_store::valid(old(nxt)) && 0 <= ne && ne < old(nxt)[6] &&
    crate::bud_store::has_x(prev[prev[5] + 10 * pe + 9]) && old(nxt)[old(nxt)[5] + 10 * ne + 9] == 0 &&
    prev[prev[5] + 10 * pe + 10 * prev[6] + 2] == 0) ==>
    ((crate::bud_store::has_x(nxt[nxt[5] + 10 * ne + 9]) ==> nxt[nxt[5] + 10 * ne + 10 * nxt[6] + 2] == 0) &&
    (!crate::bud_store::has_x(nxt[nxt[5] + 10 * ne + 9]) ==> (
    prev[prev[5] + 10 * pe + 10 * prev[6] + 3] == 0 && prev[prev[5] + 10 * pe + 10 * prev[6] + 4] == 0 &&
    prev[prev[5] + 10 * pe + 10 * prev[6] + 5] == 0 && prev[prev[5] + 10 * pe + 10 * prev[6] + 6] == 0)))
  ensures (result == 0 && crate::bud_store::valid(prev) && 0 <= pe && pe < prev[6] &&
    crate::bud_store::valid(old(nxt)) && 0 <= ne && ne < old(nxt)[6] &&
    crate::bud_store::has_x(prev[prev[5] + 10 * pe + 9]) && old(nxt)[old(nxt)[5] + 10 * ne + 9] == 0 &&
    0 < prev[prev[5] + 10 * pe + 10 * prev[6] + 2] && prev[prev[5] + 10 * pe + 10 * prev[6] + 2] <= 4294967296 &&
    0 <= prev[prev[5] + 10 * pe + 10 * prev[6] + 1] && prev[prev[5] + 10 * pe + 10 * prev[6] + 1] <= 1099511627776) ==>
    (nxt[nxt[5] + 10 * ne + 10 * nxt[6] + 1] == old(nxt)[10] && old(nxt)[10] + prev[prev[5] + 10 * pe + 10 * prev[6] + 2] <= len(nxt) &&
    prev[prev[5] + 10 * pe + 10 * prev[6] + 1] + prev[prev[5] + 10 * pe + 10 * prev[6] + 2] <= len(prev) &&
    (forall j in 0..prev[prev[5] + 10 * pe + 10 * prev[6] + 2]:
      nxt[old(nxt)[10] + j] == prev[prev[prev[5] + 10 * pe + 10 * prev[6] + 1] + j]))
  ensures (result == 0 && crate::bud_store::valid(prev) && 0 <= pe && pe < prev[6] &&
    crate::bud_store::valid(old(nxt)) && 0 <= ne && ne < old(nxt)[6] &&
    crate::bud_store::has_x(prev[prev[5] + 10 * pe + 9]) && crate::bud_store::has_x(old(nxt)[old(nxt)[5] + 10 * ne + 9]) &&
    0 <= prev[prev[5] + 10 * pe + 10 * prev[6] + 2] && prev[prev[5] + 10 * pe + 10 * prev[6] + 2] <= 4294967296 &&
    (prev[prev[5] + 10 * pe + 10 * prev[6] + 2] == 0 || 0 <= old(nxt)[old(nxt)[5] + 10 * ne + 10 * old(nxt)[6] + 1])) ==>
    (crate::bud_store::has_x(nxt[nxt[5] + 10 * ne + 9]) && nxt[nxt[5] + 10 * ne + 10 * nxt[6] + 2] == prev[prev[5] + 10 * pe + 10 * prev[6] + 2])
  ensures (result == 0 && crate::bud_store::valid(prev) && 0 <= pe && pe < prev[6] &&
    crate::bud_store::valid(old(nxt)) && 0 <= ne && ne < old(nxt)[6] &&
    crate::bud_store::has_x(prev[prev[5] + 10 * pe + 9]) && crate::bud_store::has_x(old(nxt)[old(nxt)[5] + 10 * ne + 9]) &&
    0 <= old(nxt)[old(nxt)[5] + 10 * ne + 10 * old(nxt)[6] + 1] &&
    0 < prev[prev[5] + 10 * pe + 10 * prev[6] + 2] && prev[prev[5] + 10 * pe + 10 * prev[6] + 2] <= 4294967296 &&
    0 <= prev[prev[5] + 10 * pe + 10 * prev[6] + 1] && prev[prev[5] + 10 * pe + 10 * prev[6] + 1] <= 1099511627776) ==>
    (forall j in 0..prev[prev[5] + 10 * pe + 10 * prev[6] + 2]:
      nxt[nxt[nxt[5] + 10 * ne + 10 * nxt[6] + 1] + j] == prev[prev[prev[5] + 10 * pe + 10 * prev[6] + 1] + j])
  ensures (result == 0 && crate::bud_store::valid(prev) && 0 <= pe && pe < prev[6] &&
    crate::bud_store::valid(old(nxt)) && 0 <= ne && ne < old(nxt)[6] &&
    crate::bud_store::has_x(prev[prev[5] + 10 * pe + 9]) && prev[prev[5] + 10 * pe + 10 * prev[6] + 2] == 0 &&
    !crate::bud_store::has_x(old(nxt)[old(nxt)[5] + 10 * ne + 9]) && crate::bud_store::has_x(nxt[nxt[5] + 10 * ne + 9])) ==>
    nxt[nxt[5] + 10 * ne + 10 * nxt[6] + 2] == 0
{
  let px: i64 = crate::bud_store::xb(prev, pe);
  if px < 0 { return 0; }
  let blen: i64 = crate::bud_store::c32(prev[px + 2]);
  // An empty blob has no region: admission leaves its offset unchecked, so it is not passed on (L3 P13j.5).
  let mut boff: i64 = 0;
  if blen > 0 { boff = crate::bud_store::c40(prev[px + 1]); }
  assert 0 <= boff && boff <= 1099511627776;
  let rb: i64 = set_blob(inout nxt, ne, prev, boff, blen);
  if rb < 0 { return -1; }
  assert !(crate::bud_store::valid(old(nxt)) && 0 <= ne && ne < old(nxt)[6] &&
    old(nxt)[old(nxt)[5] + 10 * ne + 9] == 0 && 0 < blen) ||
    (crate::bud_store::has_x(nxt[nxt[5] + 10 * ne + 9]) && nxt[nxt[5] + 10 * ne + 10 * nxt[6] + 2] == blen &&
    nxt[nxt[5] + 10 * ne + 10 * nxt[6] + 1] == old(nxt)[10] && nxt[9] <= old(nxt)[10] &&
    old(nxt)[10] + blen <= len(nxt) && boff + blen <= len(prev));
  assert (crate::bud_store::valid(old(nxt)) && 0 <= ne && ne < old(nxt)[6] &&
    old(nxt)[old(nxt)[5] + 10 * ne + 9] == 0 && 0 < blen) ==>
    (forall j in 0..blen: nxt[old(nxt)[10] + j] == prev[boff + j]);
  crate::bud_store::set_vals(inout nxt, ne, prev[px + 3], prev[px + 4], prev[px + 5], prev[px + 6]);
  return 0;
}

// Copies the leaf children of pe (in order) under ne. Returns the remaining step budget, or -1 on failure.
fn copy_leaves(prev: [i64], inout nxt: [i64], pe: i64, ne: i64, budget: i64) -> i64
  requires 0 <= budget && budget <= 4294967296
  ensures result >= -1 && result <= budget
  ensures crate::bud_store::kept(nxt, old(nxt))
{
  let mut b: i64 = budget;
  let mut c: i64 = gf(prev, pe, 9);
  while c >= 0 && b > 0
    invariant 0 <= b && b <= budget
    invariant crate::bud_store::kept(nxt, old(nxt))
    decreases b
  {
    b = b - 1;
    let nc: i64 = copy_node(prev, inout nxt, c, ne);
    if nc < 0 { return -1; }
    c = gf(prev, c, 8);
  }
  return b;
}

// Copies the payload of root pr to root nr, then the children of pr (in order) under nr; with deep, each child's own
// children follow it. The root's payload goes through the same copy_pay site as each child's (first step, no budget;
// L3 P13j), so grow_copy adds no inlined set_blob. Returns the remaining step budget, or -1 on failure.
fn copy_kids(prev: [i64], inout nxt: [i64], pr: i64, nr: i64, budget: i64, deep: bool) -> i64
  requires 0 <= budget && budget <= 4294967296
  ensures result >= -1 && result <= budget
  ensures crate::bud_store::kept(nxt, old(nxt))
{
  let mut b: i64 = budget;
  let mut c: i64 = gf(prev, pr, 9);
  let mut first: i64 = 1;
  while first == 1 || (c >= 0 && b > 0)
    invariant 0 <= b && b <= budget && 0 <= first && first <= 1
    invariant crate::bud_store::kept(nxt, old(nxt))
    decreases b + first
  {
    let mut pe: i64 = pr;
    let mut ne: i64 = nr;
    if first == 0 {
      b = b - 1;
      ne = put_node(prev, inout nxt, c, nr);
      if ne < 0 { return -1; }
      pe = c;
    }
    let p: i64 = copy_pay(prev, inout nxt, pe, ne);
    if p != 0 { return -1; }
    if first == 0 {
      if deep {
        b = copy_leaves(prev, inout nxt, c, ne, b);
        if b < 0 { return -1; }
      }
      c = gf(prev, c, 8);
    }
    first = 0;
  }
  return b;
}

// Root r's blob of prev (n = prev[x+2] words at prev[x+1], x = st[5] + 10r + 10 st[6], the extension address ea gives
// on a valid store) is word for word the blob of root r of nxt, when prev has the extension. With root_carried both
// regions are in range and the lengths are equal (L3 P13j).
fn blob_same(prev: [i64], nxt: [i64], r: i64) -> bool
  ensures result ==> root_carried(prev, nxt, r)
  ensures result ==> (crate::bud_store::has_x(prev[prev[5] + 10 * r + 9]) ==>
    (forall j in 0..prev[prev[5] + 10 * r + 10 * prev[6] + 2]:
      nxt[nxt[nxt[5] + 10 * r + 10 * nxt[6] + 1] + j] == prev[prev[prev[5] + 10 * r + 10 * prev[6] + 1] + j]))
{
  if !root_carried(prev, nxt, r) { return false; }
  let pb: i64 = prev[5] + 10 * r;
  if !crate::bud_store::has_x(prev[pb + 9]) { return true; }
  let px: i64 = prev[5] + 10 * r + 10 * prev[6];
  let n: i64 = prev[px + 2];
  if n == 0 { return true; }
  let nx: i64 = nxt[5] + 10 * r + 10 * nxt[6];
  let po: i64 = prev[px + 1];
  let no: i64 = nxt[nx + 1];
  let mut j: i64 = 0;
  while j < n
    invariant 0 <= j && j <= n && 0 <= po && 0 <= no && n <= len(prev) - po && n <= len(nxt) - no
    invariant forall k in 0..j: nxt[no + k] == prev[po + k]
    decreases n - j
  {
    if nxt[no + j] != prev[po + j] { return false; }
    j = j + 1;
  }
  return true;
}

// Root r of nxt holds the payload root r of prev holds: the four values and the blob length (blob_same adds the blob
// words), read through the header words of each buffer as the accessors read them on a valid store. A missing
// extension reads as the defaults (values 0, empty blob), as ef and blob_len read it (L3 P13j).
pub fn root_carried(prev: [i64], nxt: [i64], r: i64) -> bool
{
  if len(prev) < 16 || len(nxt) < 16 || r < 0 || r >= 3 { return false; }
  if prev[5] < 0 || prev[5] > 1099511627776 || nxt[5] < 0 || nxt[5] > 1099511627776 { return false; }
  if prev[6] < 0 || prev[6] > 4294967296 || nxt[6] < 0 || nxt[6] > 4294967296 { return false; }
  let pb: i64 = prev[5] + 10 * r;
  let nb: i64 = nxt[5] + 10 * r;
  if pb < 16 || pb > len(prev) - 10 || nb < 16 || nb > len(nxt) - 10 { return false; }
  let px: i64 = pb + 10 * prev[6];
  let nx: i64 = nb + 10 * nxt[6];
  let ph: bool = crate::bud_store::has_x(prev[pb + 9]);
  let nh: bool = crate::bud_store::has_x(nxt[nb + 9]);
  if ph && (px < 16 || px > len(prev) - 10) { return false; }
  if nh && (nx < 16 || nx > len(nxt) - 10) { return false; }
  if !ph && !nh { return true; }
  if !ph { return nxt[nx + 2] == 0 && nxt[nx + 3] == 0 && nxt[nx + 4] == 0 && nxt[nx + 5] == 0 && nxt[nx + 6] == 0; }
  if !nh { return prev[px + 2] == 0 && prev[px + 3] == 0 && prev[px + 4] == 0 && prev[px + 5] == 0 && prev[px + 6] == 0; }
  let n: i64 = prev[px + 2];
  let po: i64 = prev[px + 1];
  let no: i64 = nxt[nx + 1];
  if nxt[nx + 2] != n || nxt[nx + 3] != prev[px + 3] || nxt[nx + 4] != prev[px + 4] ||
    nxt[nx + 5] != prev[px + 5] || nxt[nx + 6] != prev[px + 6] { return false; }
  // An empty blob reads nothing, whatever its offset. A nonempty one is in the c40 range, where the raw words equal
  // what blob_len / blob_unit read (L3 P13j.5).
  if n == 0 { return true; }
  return n > 0 && n <= 1099511627776 && 0 <= po && po <= 1099511627776 && 0 <= no && no <= 1099511627776 &&
    n <= len(prev) - po && n <= len(nxt) - no;
}

// Writes a fresh layout for len(nxt) into nxt and copies the reachable entries of prev: roots 0..2, each map in
// insertion order, children after their parent (two levels below the roots). Keys and blobs are re-appended to the
// new arena; a stored hash is reused when owner and generation are unchanged and recomputed from the packed words
// otherwise; tombstones and dead arena words are dropped. O(len(prev) + len(nxt)) with short probes; a colliding key
// set (see PERF_HEADROOM P04 threat model) can push reinsertion to O(entries x slots). 0 ok, 2 invalid prev,
// nxt too small, nxt cannot hold the copy, or prev holds entries outside those levels (live counts differ).
// A 0 result leaves the I0 header fact valid(nxt) (L3 P07): init_store proves valid(nxt) and every later write goes
// through writers that keep shape and dyn_ok (kept, L3 P13a.9), so the exit needs no check (L3 P13b). prev is read
// only, so any nonzero result (or a failed allocation of nxt in the host) leaves the old state valid and unchanged.
pub fn grow_copy(prev: [i64], inout nxt: [i64]) -> i64
  ensures len(nxt) == len(old(nxt))
  ensures result != 0 || crate::bud_store::valid(nxt)
  ensures result == 0 ==> (forall r in 0..3: root_carried(prev, nxt, r) &&
    (crate::bud_store::has_x(prev[prev[5] + 10 * r + 9]) ==>
      (forall j in 0..prev[prev[5] + 10 * r + 10 * prev[6] + 2]:
        nxt[nxt[nxt[5] + 10 * r + 10 * nxt[6] + 1] + j] == prev[prev[prev[5] + 10 * r + 10 * prev[6] + 1] + j])))
{
  if !crate::bud_store::valid(prev) { return 2; }
  if len(nxt) < len(prev) { return 2; }
  let r0: i64 = crate::bud_store::init_store(inout nxt);
  if r0 != 0 { return 2; }
  sh(inout nxt, 15, hw(prev, 15));
  let mut b: i64 = crate::bud_store::c32(hw(prev, 6));
  let mut r: i64 = 0;
  while r < 3
    invariant 0 <= r && r <= 3 && 0 <= b && b <= 4294967296
    invariant crate::bud_store::valid(nxt)
    decreases 3 - r
  {
    b = copy_kids(prev, inout nxt, r, r, b, r != 0);
    if b < 0 { return 2; }
    r = r + 1;
  }
  // The copy covers the shapes the world builds (root 0 flat, roots 1 and 2 two levels). Admission (bud_admit) also
  // accepts deeper trees; their extra entries would be dropped, so a live count that differs from prev's fails the
  // grow instead (2: the old state stays valid and unchanged, nothing is lost silently; L3 P13b).
  if hw(nxt, 12) != hw(prev, 12) { return 2; }
  // The writers keep valid(nxt) (kept); nxt is not written after this point, so a compare of the three root payloads
  // (linear in the summed blob lengths of the three roots) gives the ensures above without a frame proof over every arena write (L3 P13j).
  let mut q: i64 = 0;
  while q < 3
    invariant 0 <= q && q <= 3
    invariant forall k in 0..q: root_carried(prev, nxt, k)
    invariant forall k in 0..q:
      (crate::bud_store::has_x(prev[prev[5] + 10 * k + 9]) ==>
        (forall j in 0..prev[prev[5] + 10 * k + 10 * prev[6] + 2]:
          nxt[nxt[nxt[5] + 10 * k + 10 * nxt[6] + 1] + j] == prev[prev[prev[5] + 10 * k + 10 * prev[6] + 1] + j]))
    decreases 3 - q
  {
    if !blob_same(prev, nxt, q) { return 2; }
    q = q + 1;
  }
  return 0;
}

// ---- seek: one hash and one probe for a lookup that may become an insert (L3 P21) ----

// A packed key looked up under owner, with what an insert of the same key needs: og = gf(st, owner, 3) and
// h = hash_words(owner, og, key, ks, kn) (computed once), e = the key's entry or -1, and, when e < 0, slot = the
// slot put_key_h() would pick (the first tombstone or empty slot on h's probe path, absolute address) or -1.
pub struct Seek { og: i64, h: i64, e: i64, slot: i64 }

// find_w() and probe_w() in one pass that keeps the entry: e is find_h_w()'s result (both loops read the same words up
// to the first empty slot, find_h_w returns at a match or there), slot is probe_w()'s when the key is absent. Caller
// contract as find_w (canonical key words); total on any input.
pub fn seek_w(st: [i64], owner: i64, key: [i64], ks: i64, kn: i64) -> Seek
{
  let og: i64 = gf(st, owner, 3);
  let h: i64 = hash_words(owner, og, key, ks, kn);
  let slots: i64 = crate::bud_store::c32(hw(st, 4));
  if len(st) < 5 || slots < 1 { return Seek { og: og, h: h, e: -1, slot: -1 }; }
  let ht: i64 = tag(h);
  let sb: i64 = crate::bud_store::c32(st[3]);
  let mask: i64 = slots - 1;
  let n: i64 = len(st);
  let mut free: i64 = -1;
  let mut i: i64 = 0;
  while i < slots
    invariant 0 <= i && i <= slots && slots <= 4294967296 && n == len(st)
    decreases slots - i
  {
    let p: i64 = sb + band(wrapping_add(h, i), mask);
    let mut w: i64 = 0;
    if p >= 0 && p < n { w = st[p]; }
    if w == 0 {
      if free < 0 { free = p; }
      return Seek { og: og, h: h, e: -1, slot: free };
    }
    if w == -1 {
      if free < 0 { free = p; }
    } else if w > 0 && ushr(w, 32) == ht {
      let e: i64 = slot_entry(w);
      if entry_matches_w(st, e, owner, og, h, key, ks, kn) { return Seek { og: og, h: h, e: e, slot: -1 }; }
    }
    i = i + 1;
  }
  return Seek { og: og, h: h, e: -1, slot: free };
}

// room() for callers outside this module: 0 fits (nothing written), -1 the index was rebuilt and it fits now (every
// slot from an earlier seek_w is stale), otherwise N > 0: Grow(N); nothing written on a store whose header matches
// its tables (room's rehash omits dead entries, so the second need() returns 0); on a broken buffer the index may
// have been rebuilt first.
pub fn room_w(inout st: [i64], entries: i64, words: i64) -> i64
  ensures crate::bud_store::kept(st, old(st))
{ return room(inout st, entries, words); }

// Inserts the absent key that s = seek_w(st, owner, key, ks, kn) looked up, reusing s.og, s.h and s.slot. Caller
// contract: st changed since that seek_w only by room_w(), and rehashed says whether room_w() returned -1 (then the
// index is probed again with s.h, as add_absent_w does). Entry index, or -1 (nothing usable was added). Total on
// any input: a broken contract can only store an entry its later lookups miss (a stale og or h) or write a slot
// through wr16, never outside the store's non-header words.
pub fn put_seek_w(inout st: [i64], owner: i64, s: Seek, key: [i64], ks: i64, kn: i64, rehashed: bool) -> i64
  ensures crate::bud_store::kept(st, old(st))
{
  if gf(st, owner, 0) != 1 { return -1; }
  if rehashed { return put_key_h(inout st, owner, s.og, s.h, key, ks, kn); }
  if s.slot < 0 { return -1; }
  return put_at(inout st, owner, s.og, s.h, key, ks, kn, s.slot);
}

// Read-only, O(1): predicts whether the next one or two entry allocations can return entries. A reclaimed
// descendant leaves the old head available behind it. Otherwise use entry_alloc's free-head and top rules.
// k <= 0: true.
pub fn alloc_ok(st: [i64], k: i64) -> bool
{
  if k <= 0 { return true; }
  let cap: i64 = crate::bud_store::c32(hw(st, 6));
  let top: i64 = crate::bud_store::c32(hw(st, 7));
  let fh: i64 = hw(st, 8);
  if fh >= 3 && fh < top && fh < cap {
    if k < 2 { return true; }
    let c: i64 = gf(st, fh, 9);
    if len(st) >= 15 && gf(st, fh, 0) == 0 && c < cap && reclaimable(st, fh, c, top) { return true; }
    let nx: i64 = gf(st, fh, 8);
    return (nx >= 3 && nx < top && nx < cap) || top < cap;
  }
  if top >= cap { return false; }
  // On malformed buffers the top write can be out of range, or the old head can become eligible.
  return k < 2 || len(st) <= 7 || top + 1 < cap || (fh >= 3 && fh == top);
}
