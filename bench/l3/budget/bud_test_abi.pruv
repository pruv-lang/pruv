// L3-10 M3: the flat [i64] test codec (CONTRACT.md section M3): validators and writers.
// Rejections are plain negative statuses -(100*class + reason): class 3 InvalidInput (1 header, 2 length, 3 value,
// 4 op, 5 trailing, 6 depth, 8 resume), class 4 ResourceBound (1 input, 2 number). The literals below follow
// bud_api::reject. Every read of untrusted input and every write goes through crate::ent_u16::rd / wr, so no bounds
// proof depends on the input contents. No `mod` lines.

// ================= validators =================

// End offset of the units string "n, n units" that starts at p (no tag), or a negative rejection.
pub fn units_end(inp: [i64], p: i64) -> i64
  ensures result < 0 || (p < result && result <= len(inp))
{
  let n: i64 = len(inp);
  if p < 0 || p >= n { return -303; }
  let cnt: i64 = crate::ent_u16::rd(inp, p);
  if cnt < 0 || cnt > n - p - 1 { return -303; }
  let mut i: i64 = 0;
  while i < cnt
    invariant 0 <= i && i <= cnt && cnt <= n - p - 1 && 0 <= p && p < n && n == len(inp)
    decreases cnt - i
  {
    let u: i64 = crate::ent_u16::rd(inp, p + 1 + i);
    if u < 0 || u > 65535 { return -303; }
    i = i + 1;
  }
  return p + 1 + cnt;
}

// End offset of the tagged value at `at` (tag 0 is invalid here), or a negative rejection. depth: the top-level value is 1.
pub fn value_end(inp: [i64], at: i64, depth: i64) -> i64
  requires 0 <= depth && depth <= 33
  ensures result < 0 || (at < result && result <= len(inp))
  decreases 33 - depth
{
  if depth > 32 { return -306; }
  let n: i64 = len(inp);
  if at < 0 || at >= n { return -303; }
  let t: i64 = crate::ent_u16::rd(inp, at);
  if t >= 1 && t <= 4 { return at + 1; }
  if t == 5 {
    if n - at < 2 { return -303; }
    let v: i64 = crate::ent_u16::rd(inp, at + 1);
    let mi: i64 = crate::bud_api::max_int();
    if v < 0 - mi || v > mi { return -402; }
    return at + 2;
  }
  if t == 7 {
    if n - at < 2 { return -303; }
    return at + 2;
  }
  if t == 6 || t == 10 { return units_end(inp, at + 1); }
  if t == 8 {
    if at + 1 >= n { return -303; }
    let cnt: i64 = crate::ent_u16::rd(inp, at + 1);
    if cnt < 0 || cnt > n - at - 2 { return -303; }
    let mut pos: i64 = at + 2;
    let mut i: i64 = 0;
    while i < cnt
      invariant 0 <= i && i <= cnt && at < pos && pos <= n && n == len(inp) && 0 <= at && at < n && 0 <= depth && depth <= 32
      decreases cnt - i
    {
      let e: i64 = value_end(inp, pos, depth + 1);
      if e < 0 { return e; }
      pos = e;
      i = i + 1;
    }
    return pos;
  }
  if t == 9 {
    if at + 1 >= n { return -303; }
    let cnt: i64 = crate::ent_u16::rd(inp, at + 1);
    if cnt < 0 || cnt > n - at - 2 { return -303; }
    let mut pos: i64 = at + 2;
    let mut i: i64 = 0;
    while i < cnt
      invariant 0 <= i && i <= cnt && at < pos && pos <= n && n == len(inp) && 0 <= at && at < n && 0 <= depth && depth <= 32
      decreases cnt - i
    {
      let ke: i64 = units_end(inp, pos);
      if ke < 0 { return ke; }
      let e: i64 = value_end(inp, ke, depth + 1);
      if e < 0 { return e; }
      pos = e;
      i = i + 1;
    }
    return pos;
  }
  return -303;
}

// One top-level slot: like value_end at depth 1, but tag 0 (absent) is allowed when allow_absent.
pub fn slot_end(inp: [i64], at: i64, allow_absent: bool) -> i64
  ensures result < 0 || (at < result && result <= len(inp))
{
  if allow_absent && at >= 0 && at < len(inp) && crate::ent_u16::rd(inp, at) == 0 { return at + 1; }
  return value_end(inp, at, 1);
}

// End offset of argc consecutive slots starting at s.
pub fn args_end(inp: [i64], s: i64, argc: i64, allow_absent: bool) -> i64
  ensures result < 0 || (s <= result && result <= len(inp))
{
  let n: i64 = len(inp);
  if s < 0 || s > n { return -303; }
  if argc < 0 { return -303; }
  let mut p: i64 = s;
  let mut k: i64 = 0;
  while k < argc
    invariant 0 <= k && k <= argc && s <= p && p <= n && n == len(inp)
    decreases argc - k
  {
    let e: i64 = slot_end(inp, p, allow_absent);
    if e < 0 { return e; }
    p = e;
    k = k + 1;
  }
  return p;
}

// All m units at s.. are in 0..65535.
pub fn units_ok(inp: [i64], s: i64, m: i64) -> bool
  requires 0 <= s && s <= 4294967296 && 0 <= m && m <= 36
{
  let mut i: i64 = 0;
  while i < m
    invariant 0 <= i && i <= m && m <= 36 && 0 <= s && s <= 4294967296
    decreases m - i
  {
    let u: i64 = crate::ent_u16::rd(inp, s + i);
    if u < 0 || u > 65535 { return false; }
    i = i + 1;
  }
  return true;
}

// "code, argc, V..." with code checked by the caller flag: is_effect picks the effect or the query code set; argc 0..4.
pub fn coded_end(inp: [i64], s: i64, is_effect: bool) -> i64
  ensures result < 0 || (s < result && result <= len(inp))
{
  let n: i64 = len(inp);
  if s < 0 || s >= n { return -303; }
  let code: i64 = crate::ent_u16::rd(inp, s);
  if is_effect {
    if !crate::bud_api::effect_valid(code) { return -303; }
  } else {
    if !crate::bud_api::query_valid(code) { return -303; }
  }
  let argc: i64 = crate::ent_u16::rd(inp, s + 1);
  if argc < 0 || argc > 4 { return -303; }
  if s + 2 > n { return -303; }
  let e: i64 = args_end(inp, s + 2, argc, false);
  if e < 0 { return e; }
  return e;
}

pub fn effect_end(inp: [i64], s: i64) -> i64
  ensures result < 0 || (s < result && result <= len(inp))
{
  return coded_end(inp, s, true);
}

pub fn query_end(inp: [i64], s: i64) -> i64
  ensures result < 0 || (s < result && result <= len(inp))
{
  return coded_end(inp, s, false);
}

// "effect_count, effects" starting at s.
pub fn effects_end(inp: [i64], s: i64) -> i64
  ensures result < 0 || (s < result && result <= len(inp))
{
  let n: i64 = len(inp);
  if s < 0 || s >= n { return -303; }
  let cnt: i64 = crate::ent_u16::rd(inp, s);
  if cnt < 0 || cnt > n - s - 1 { return -303; }
  let mut p: i64 = s + 1;
  let mut i: i64 = 0;
  while i < cnt
    invariant 0 <= i && i <= cnt && s < p && p <= n && n == len(inp) && 0 <= s
    decreases cnt - i
  {
    let e: i64 = effect_end(inp, p);
    if e < 0 { return e; }
    p = e;
    i = i + 1;
  }
  return p;
}

// Header: ResourceBound(input) first (length, then declared total_len), then magic/version, then total_len == len.
pub fn header_check(inp: [i64], magic: i64, minlen: i64) -> i64
{
  let n: i64 = len(inp);
  let mx: i64 = crate::bud_api::max_words();
  if n > mx { return -401; }
  if n >= 3 && crate::ent_u16::rd(inp, 2) > mx { return -401; }
  if n < 3 { return -301; }
  if crate::ent_u16::rd(inp, 0) != magic { return -301; }
  if crate::ent_u16::rd(inp, 1) != crate::bud_api::version() { return -301; }
  if crate::ent_u16::rd(inp, 2) != n { return -302; }
  if n < minlen { return -302; }
  return 0;
}

// 0 if inp is a valid call, else a negative rejection.
pub fn check_call(inp: [i64]) -> i64
{
  let h: i64 = header_check(inp, crate::bud_api::magic_call(), 7);
  if h < 0 { return h; }
  let n: i64 = len(inp);
  let op: i64 = crate::ent_u16::rd(inp, 3);
  if !crate::bud_api::op_valid(op) { return -304; }
  let now: i64 = crate::ent_u16::rd(inp, 4);
  if now < 0 || now > crate::bud_api::max_now_ms() { return -402; }
  let ul: i64 = crate::ent_u16::rd(inp, 5);
  if ul != 0 && ul != 36 { return -303; }
  if 6 + ul >= n { return -303; }
  if !units_ok(inp, 6, ul) { return -303; }
  let argc: i64 = crate::ent_u16::rd(inp, 6 + ul);
  if argc < 0 || argc > 8 { return -303; }
  let e: i64 = args_end(inp, 7 + ul, argc, true);
  if e < 0 { return e; }
  if e != n { return -305; }
  return 0;
}

// 0 if inp is a valid resume, else a negative rejection.
pub fn check_resume(inp: [i64]) -> i64
{
  let h: i64 = header_check(inp, crate::bud_api::magic_resume(), 6);
  if h < 0 { return h; }
  let n: i64 = len(inp);
  if crate::ent_u16::rd(inp, 3) < 1 { return -308; }
  let now: i64 = crate::ent_u16::rd(inp, 4);
  if now < 0 || now > crate::bud_api::max_now_ms() { return -402; }
  let e: i64 = value_end(inp, 5, 1);
  if e < 0 { return e; }
  if e != n { return -305; }
  return 0;
}

// 0 if inp is a valid outcome, else a negative rejection.
pub fn check_outcome(inp: [i64]) -> i64
{
  let h: i64 = header_check(inp, crate::bud_api::magic_out(), 5);
  if h < 0 { return h; }
  let n: i64 = len(inp);
  let kind: i64 = crate::ent_u16::rd(inp, 3);
  if kind == 1 {
    let e: i64 = value_end(inp, 4, 1);
    if e < 0 { return e; }
    let f: i64 = effects_end(inp, e);
    if f < 0 { return f; }
    if f != n { return -305; }
    return 0;
  }
  if kind == 2 {
    let f: i64 = effects_end(inp, 4);
    if f < 0 { return f; }
    let q: i64 = query_end(inp, f);
    if q < 0 { return q; }
    if q >= n { return -303; }
    if crate::ent_u16::rd(inp, q) < 1 { return -303; }
    if q + 1 != n { return -305; }
    return 0;
  }
  let r: i64 = crate::ent_u16::rd(inp, 4);
  if kind == 3 {
    if r < 1 || r > 8 { return -303; }
    if n != 5 { return -305; }
    return 0;
  }
  if kind == 4 {
    if r < 1 || r > 3 { return -303; }
    if n != 5 { return -305; }
    return 0;
  }
  if kind == 5 {
    if r < 1 { return -303; }
    if n != 5 { return -305; }
    return 0;
  }
  return -303;
}

// ================= writers =================
// All writers return the new position, or -1 if out is too small (or, for put_value and friends, if the source is not
// a valid encoding; validate first). They never change len(out).

pub fn put_word(inout out: [i64], at: i64, v: i64) -> i64
  ensures len(out) == len(old(out)) && (result == -1 || (result == at + 1 && 0 <= result && result <= len(out)))
{
  if at < 0 || at >= len(out) { return -1; }
  crate::ent_u16::wr(inout out, at, v);
  return at + 1;
}

// magic, version, placeholder total_len; returns 3 (or -1).
pub fn put_header(inout out: [i64], magic: i64) -> i64
  ensures len(out) == len(old(out)) && -1 <= result && result <= len(out)
{
  let a: i64 = put_word(inout out, 0, magic);
  if a < 0 { return -1; }
  let b: i64 = put_word(inout out, a, crate::bud_api::version());
  if b < 0 { return -1; }
  let c: i64 = put_word(inout out, b, 0);
  return c;
}

// back-patch total_len (word 2) with the final end position
pub fn patch_len(inout out: [i64], end: i64) -> ()
  ensures len(out) == len(old(out))
{
  crate::ent_u16::wr(inout out, 2, end);
}

// tag word then one payload word
pub fn put_pair(inout out: [i64], at: i64, t: i64, v: i64) -> i64
  ensures len(out) == len(old(out)) && -1 <= result && result <= len(out)
{
  let p: i64 = put_word(inout out, at, t);
  if p < 0 { return -1; }
  let q: i64 = put_word(inout out, p, v);
  return q;
}

pub fn put_int(inout out: [i64], at: i64, v: i64) -> i64
  ensures len(out) == len(old(out)) && -1 <= result && result <= len(out)
{
  return put_pair(inout out, at, 5, v);
}

pub fn put_bits(inout out: [i64], at: i64, v: i64) -> i64
  ensures len(out) == len(old(out)) && -1 <= result && result <= len(out)
{
  return put_pair(inout out, at, 7, v);
}

// copy the units string "n, n units" found at s in inp (no tag)
pub fn put_units_from(inout out: [i64], at: i64, inp: [i64], s: i64) -> i64
  ensures len(out) == len(old(out)) && -1 <= result && result <= len(out)
{
  let s0: i64 = crate::ent_u16::clamp(s, 4294967296);
  let n: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(inp, s0), 16777216);
  let mut p: i64 = put_word(inout out, at, n);
  if p < 0 { return -1; }
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n <= 16777216 && 0 <= s0 && s0 <= 4294967296 && 0 <= p && p <= len(out) && len(out) == len(old(out))
    decreases n - i
  {
    let q: i64 = put_word(inout out, p, crate::ent_u16::rd(inp, s0 + 1 + i));
    if q < 0 { return -1; }
    p = q;
    i = i + 1;
  }
  return p;
}

// tag word then the units string found at s in inp
pub fn put_tagged_units(inout out: [i64], at: i64, t: i64, inp: [i64], s: i64) -> i64
  ensures len(out) == len(old(out)) && -1 <= result && result <= len(out)
{
  let p: i64 = put_word(inout out, at, t);
  if p < 0 { return -1; }
  let q: i64 = put_units_from(inout out, p, inp, s);
  return q;
}

// string value (tag 6) whose "n, units" start at s
pub fn put_str_from(inout out: [i64], at: i64, inp: [i64], s: i64) -> i64
  ensures len(out) == len(old(out)) && -1 <= result && result <= len(out)
{
  return put_tagged_units(inout out, at, 6, inp, s);
}

// Re-emit the value that starts at s in inp (tag at s), word by word through the tag writers.
// depth is the nesting level (top-level 1); recursion is bounded by 32.
fn put_value_d(inout out: [i64], at: i64, inp: [i64], s: i64, depth: i64) -> i64
  requires 0 <= depth && depth <= 33
  ensures len(out) == len(old(out)) && -1 <= result && result <= len(out)
  decreases 33 - depth
{
  if depth > 32 { return -1; }
  let s0: i64 = crate::ent_u16::clamp(s, 4294967296);
  let t: i64 = crate::ent_u16::rd(inp, s0);
  if t >= 0 && t <= 4 { return put_word(inout out, at, t); }
  if t == 5 { return put_int(inout out, at, crate::ent_u16::rd(inp, s0 + 1)); }
  if t == 7 { return put_bits(inout out, at, crate::ent_u16::rd(inp, s0 + 1)); }
  if t == 6 { return put_str_from(inout out, at, inp, s0 + 1); }
  if t == 10 { return put_tagged_units(inout out, at, 10, inp, s0 + 1); }
  if t == 8 {
    let cnt: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(inp, s0 + 1), 16777216);
    let a: i64 = put_word(inout out, at, 8);
    if a < 0 { return -1; }
    let mut p: i64 = put_word(inout out, a, cnt);
    if p < 0 { return -1; }
    let mut cs: i64 = crate::ent_u16::clamp(s0 + 2, 4294967296);
    let mut i: i64 = 0;
    while i < cnt
      invariant 0 <= i && i <= cnt && cnt <= 16777216 && 0 <= p && p <= len(out) && 0 <= cs && cs <= 4294967296 && len(out) == len(old(out)) && 0 <= depth && depth <= 32
      decreases cnt - i
    {
      let w: i64 = put_value_d(inout out, p, inp, cs, depth + 1);
      if w < 0 { return -1; }
      let e: i64 = value_end(inp, cs, depth + 1);
      if e < 0 { return -1; }
      p = w;
      cs = crate::ent_u16::clamp(e, 4294967296);
      i = i + 1;
    }
    return p;
  }
  if t == 9 {
    let cnt: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(inp, s0 + 1), 16777216);
    let a: i64 = put_word(inout out, at, 9);
    if a < 0 { return -1; }
    let mut p: i64 = put_word(inout out, a, cnt);
    if p < 0 { return -1; }
    let mut cs: i64 = crate::ent_u16::clamp(s0 + 2, 4294967296);
    let mut i: i64 = 0;
    while i < cnt
      invariant 0 <= i && i <= cnt && cnt <= 16777216 && 0 <= p && p <= len(out) && 0 <= cs && cs <= 4294967296 && len(out) == len(old(out)) && 0 <= depth && depth <= 32
      decreases cnt - i
    {
      let k: i64 = put_units_from(inout out, p, inp, cs);
      if k < 0 { return -1; }
      let ke: i64 = units_end(inp, cs);
      if ke < 0 { return -1; }
      let kc: i64 = crate::ent_u16::clamp(ke, 4294967296);
      let w: i64 = put_value_d(inout out, k, inp, kc, depth + 1);
      if w < 0 { return -1; }
      let e: i64 = value_end(inp, kc, depth + 1);
      if e < 0 { return -1; }
      p = w;
      cs = crate::ent_u16::clamp(e, 4294967296);
      i = i + 1;
    }
    return p;
  }
  return -1;
}

pub fn put_value(inout out: [i64], at: i64, inp: [i64], s: i64) -> i64
  ensures len(out) == len(old(out)) && -1 <= result && result <= len(out)
{
  return put_value_d(inout out, at, inp, s, 1);
}

// Re-emit argc consecutive slots starting at s (tag 0 passes through as one word).
pub fn put_args(inout out: [i64], at: i64, inp: [i64], s: i64, argc: i64, allow_absent: bool) -> i64
  ensures len(out) == len(old(out)) && -1 <= result && result <= len(out)
{
  let m: i64 = crate::ent_u16::clamp(argc, 8);
  if at < 0 { return -1; }
  let mut p: i64 = at;
  if p > len(out) { return -1; }
  let mut cs: i64 = crate::ent_u16::clamp(s, 4294967296);
  let mut k: i64 = 0;
  while k < m
    invariant 0 <= k && k <= m && m <= 8 && 0 <= p && p <= len(out) && 0 <= cs && cs <= 4294967296 && len(out) == len(old(out))
    decreases m - k
  {
    let w: i64 = put_value(inout out, p, inp, cs);
    if w < 0 { return -1; }
    let e: i64 = slot_end(inp, cs, allow_absent);
    if e < 0 { return -1; }
    p = w;
    cs = crate::ent_u16::clamp(e, 4294967296);
    k = k + 1;
  }
  return p;
}

// "code, argc, V..." re-emitted from s (argc clamped to 0..4)
pub fn put_coded(inout out: [i64], at: i64, inp: [i64], s: i64) -> i64
  ensures len(out) == len(old(out)) && -1 <= result && result <= len(out)
{
  let s0: i64 = crate::ent_u16::clamp(s, 4294967296);
  let argc: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(inp, s0 + 1), 4);
  let p: i64 = put_word(inout out, at, crate::ent_u16::rd(inp, s0));
  if p < 0 { return -1; }
  let q: i64 = put_word(inout out, p, argc);
  if q < 0 { return -1; }
  return put_args(inout out, q, inp, s0 + 2, argc, false);
}

pub fn put_effect(inout out: [i64], at: i64, inp: [i64], s: i64) -> i64
  ensures len(out) == len(old(out)) && -1 <= result && result <= len(out)
{
  return put_coded(inout out, at, inp, s);
}

pub fn put_query(inout out: [i64], at: i64, inp: [i64], s: i64) -> i64
  ensures len(out) == len(old(out)) && -1 <= result && result <= len(out)
{
  return put_coded(inout out, at, inp, s);
}

// "effect_count, effects" re-emitted from s
pub fn put_effects(inout out: [i64], at: i64, inp: [i64], s: i64) -> i64
  ensures len(out) == len(old(out)) && -1 <= result && result <= len(out)
{
  let s0: i64 = crate::ent_u16::clamp(s, 4294967296);
  let cnt: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(inp, s0), 16777216);
  let mut p: i64 = put_word(inout out, at, cnt);
  if p < 0 { return -1; }
  let mut cs: i64 = crate::ent_u16::clamp(s0 + 1, 4294967296);
  let mut i: i64 = 0;
  while i < cnt
    invariant 0 <= i && i <= cnt && cnt <= 16777216 && 0 <= p && p <= len(out) && 0 <= cs && cs <= 4294967296 && len(out) == len(old(out))
    decreases cnt - i
  {
    let w: i64 = put_effect(inout out, p, inp, cs);
    if w < 0 { return -1; }
    let e: i64 = effect_end(inp, cs);
    if e < 0 { return -1; }
    p = w;
    cs = crate::ent_u16::clamp(e, 4294967296);
    i = i + 1;
  }
  return p;
}

// patch total_len and return the end, or -1
fn finish(inout out: [i64], p: i64) -> i64
  ensures len(out) == len(old(out)) && -1 <= result && result <= len(out)
{
  if p < 0 || p > len(out) { return -1; }
  patch_len(inout out, p);
  return p;
}

// Re-emit a validated call.
pub fn put_call(inout out: [i64], inp: [i64]) -> i64
  ensures len(out) == len(old(out)) && -1 <= result && result <= len(out)
{
  let a: i64 = put_header(inout out, crate::bud_api::magic_call());
  if a < 0 { return -1; }
  let b: i64 = put_word(inout out, a, crate::ent_u16::rd(inp, 3));
  if b < 0 { return -1; }
  let c: i64 = put_word(inout out, b, crate::ent_u16::rd(inp, 4));
  if c < 0 { return -1; }
  let d: i64 = put_units_from(inout out, c, inp, 5);
  if d < 0 { return -1; }
  let ul: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(inp, 5), 36);
  let argc: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(inp, 6 + ul), 8);
  let e: i64 = put_word(inout out, d, argc);
  if e < 0 { return -1; }
  let f: i64 = put_args(inout out, e, inp, 7 + ul, argc, true);
  return finish(inout out, f);
}

// Re-emit a validated resume.
pub fn put_resume(inout out: [i64], inp: [i64]) -> i64
  ensures len(out) == len(old(out)) && -1 <= result && result <= len(out)
{
  let a: i64 = put_header(inout out, crate::bud_api::magic_resume());
  if a < 0 { return -1; }
  let b: i64 = put_word(inout out, a, crate::ent_u16::rd(inp, 3));
  if b < 0 { return -1; }
  let c: i64 = put_word(inout out, b, crate::ent_u16::rd(inp, 4));
  if c < 0 { return -1; }
  let d: i64 = put_value(inout out, c, inp, 5);
  return finish(inout out, d);
}

// Re-emit a validated outcome: header, kind, then per kind value / effects / query / seq / small payload.
pub fn put_outcome(inout out: [i64], inp: [i64]) -> i64
  ensures len(out) == len(old(out)) && -1 <= result && result <= len(out)
{
  let a: i64 = put_header(inout out, crate::bud_api::magic_out());
  if a < 0 { return -1; }
  let kind: i64 = crate::ent_u16::rd(inp, 3);
  let b: i64 = put_word(inout out, a, kind);
  if b < 0 { return -1; }
  if kind == 1 {
    let w: i64 = put_value(inout out, b, inp, 4);
    if w < 0 { return -1; }
    let e: i64 = value_end(inp, 4, 1);
    if e < 0 { return -1; }
    let x: i64 = put_effects(inout out, w, inp, e);
    return finish(inout out, x);
  }
  if kind == 2 {
    let w: i64 = put_effects(inout out, b, inp, 4);
    if w < 0 { return -1; }
    let e: i64 = effects_end(inp, 4);
    if e < 0 { return -1; }
    let x: i64 = put_query(inout out, w, inp, e);
    if x < 0 { return -1; }
    let qe: i64 = query_end(inp, e);
    if qe < 0 { return -1; }
    let y: i64 = put_word(inout out, x, crate::ent_u16::rd(inp, qe));
    return finish(inout out, y);
  }
  let z: i64 = put_word(inout out, b, crate::ent_u16::rd(inp, 4));
  return finish(inout out, z);
}
