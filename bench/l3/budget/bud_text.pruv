// pre + counter + " " + used + "/" + limit text + post in one allocation; t: 0 refusal, 1 continue.
// Time: used is activeMs, floored to minutes; limit is timeMinutes.
fn template(t: i64, reason: i64, unlimited: bool, used: i64, limit: i64, lang: i64) -> [i64] ! alloc
  requires 0 <= t && t <= 1
  requires 0 <= reason && reason <= 4
  requires -9007199254740991 <= used && used <= 9007199254740991
  requires -9007199254740991 <= limit && limit <= 9007199254740991
  requires 0 <= lang && lang <= 1
{
  let mut u: i64 = used;
  if reason == 0 { u = crate::bud_num::minutes_of(used); }
  let lp: i64 = len_pre(t, lang);
  let lc: i64 = len_cn(reason, lang);
  let lu: i64 = int_len(u);
  let mut ll: i64 = len_nl(lang);
  if !unlimited { ll = int_len(limit); }
  let lq: i64 = len_post(t, lang);
  let mut o: [i64] = alloc(lp + lc + 1 + lu + 1 + ll + lq, 0);
  let mut at: i64 = 0;
  put_pre(inout o, at, t, lang);
  at = at + lp;
  put_cn(inout o, at, reason, lang);
  at = at + lc;
  crate::ent_u16::wr(inout o, at, 32);
  at = at + 1;
  put_int(inout o, at, u, lu);
  at = at + lu;
  crate::ent_u16::wr(inout o, at, 47);
  at = at + 1;
  if unlimited { put_nl(inout o, at, lang); } else { put_int(inout o, at, limit, ll); }
  at = at + ll;
  put_post(inout o, at, t, lang);
  return o;
}

pub fn refusal(reason: i64, unlimited: bool, used: i64, limit: i64, lang: i64) -> [i64] ! alloc
  requires 0 <= reason && reason <= 4
  requires -9007199254740991 <= used && used <= 9007199254740991
  requires -9007199254740991 <= limit && limit <= 9007199254740991
  requires 0 <= lang && lang <= 1
{
  return template(0, reason, unlimited, used, limit, lang);
}

pub fn continue_text(reason: i64, unlimited: bool, used: i64, limit: i64, lang: i64) -> [i64] ! alloc
  requires 0 <= reason && reason <= 4
  requires -9007199254740991 <= used && used <= 9007199254740991
  requires -9007199254740991 <= limit && limit <= 9007199254740991
  requires 0 <= lang && lang <= 1
{
  return template(1, reason, unlimited, used, limit, lang);
}

pub fn card_missing(lang: i64) -> [i64] ! alloc
  requires 0 <= lang && lang <= 1
{
  if lang == 1 { return dec("Before delegating, write the deliverable and the done conditions with the work_card tool."); }
  return dec("위임 전에 work_card 도구로 산출물과 완료 조건을 먼저 적는다.");
}

fn card_error_ko(kind: i64) -> [i64] ! alloc
  requires 0 <= kind && kind <= 6
{
  if kind == 0 { return dec("지금 예산을 찾을 수 없어 작업 카드를 저장하지 못했다."); }
  if kind == 1 { return dec("deliverable 은 1~300자여야 한다."); }
  if kind == 2 { return dec("done 은 각 300자 이하 1~5줄이어야 한다."); }
  if kind == 3 { return dec("targets 의 수는 0 이상 정수여야 하고 note 는 300자 이하여야 한다."); }
  if kind == 4 { return dec("verify 는 label 1~300자와 status(planned·done·skipped)를 가진 0~5개 항목이어야 한다."); }
  if kind == 5 { return dec("conflicts 는 각 300자 이하 0~5줄이어야 한다."); }
  return dec("state 는 working·done·waiting-user·blocked 중 하나여야 한다.");
}

fn card_error_en(kind: i64) -> [i64] ! alloc
  requires 0 <= kind && kind <= 6
{
  if kind == 0 { return dec("The current budget was not found, so the work card was not saved."); }
  if kind == 1 { return dec("deliverable must be 1–300 characters."); }
  if kind == 2 { return dec("done must be 1–5 lines of at most 300 characters each."); }
  if kind == 3 { return dec("targets counts must be non-negative integers and note at most 300 characters."); }
  if kind == 4 { return dec("verify must be 0–5 items with a label of 1–300 characters and a status (planned, done or skipped)."); }
  if kind == 5 { return dec("conflicts must be 0–5 lines of at most 300 characters each."); }
  return dec("state must be one of working, done, waiting-user or blocked.");
}

pub fn card_error(kind: i64, lang: i64) -> [i64] ! alloc
  requires 0 <= kind && kind <= 6
  requires 0 <= lang && lang <= 1
{
  if lang == 1 { return card_error_en(kind); }
  return card_error_ko(kind);
}

pub struct Wire { key: [i64], used: i64, limit: i64 }

// {key: 'budget.refusal.' + reason, args: {used, limit}}; time used (activeMs) floored to minutes; limit as given.
pub fn refusal_wire(reason: i64, used: i64, limit: i64) -> Wire ! alloc
  requires 0 <= reason && reason <= 4
  requires -9007199254740991 <= used && used <= 9007199254740991
{
  let prefix: [i64] = dec("budget.refusal.");
  let name: [i64] = reason_name(reason);
  let key: [i64] = crate::ent_u16::cat(prefix, name);
  let mut u: i64 = used;
  if reason == 0 { u = crate::bud_num::minutes_of(used); }
  return Wire { key: copy(key), used: u, limit: limit };
}

// card validText: 1 <= trim(s).length <= 300 (UTF-16 units)
pub fn text_len_ok(s: [i64]) -> bool ! alloc
{
  let t: [i64] = crate::ent_u16::trim(s);
  let n: i64 = len(t);
  return n >= 1 && n <= 300;
}

// targets.note: untrimmed length <= 300
pub fn raw_len_ok(s: [i64]) -> bool
{
  return len(s) <= 300;
}
