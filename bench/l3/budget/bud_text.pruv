  let mut u: i64 = used;
  if reason == 0 { u = crate::bud_num::minutes_of(used); }
  let lp: i64 = len_pre(t, lang);
  let lc: i64 = len_cn(reason, lang);
  let lu: i64 = int_len(u);
  let mut ll: i64 = len_nl(lang);
  if !unlimited { ll = int_len(limit); }
  let lq: i64 = len_post(t, lang);
  let mut o: [u8] = alloc(lp + lc + 1 + lu + 1 + ll + lq, 0);
  let mut at: i64 = 0;
  put_pre(inout o, at, t, lang);
  at = at + lp;
  put_cn(inout o, at, reason, lang);
  at = at + lc;
  o[at] = 32;
  at = at + 1;
  put_int(inout o, at, u, lu);
  at = at + lu;
  o[at] = 47;
  at = at + 1;
  if unlimited { put_nl(inout o, at, lang); } else { put_int(inout o, at, limit, ll); }
  at = at + ll;
  put_post(inout o, at, t, lang);
  return o;
}

pub fn refusal(reason: i64, unlimited: bool, used: i64, limit: i64, lang: i64) -> [u8] ! alloc
  requires 0 <= reason && reason <= 4
  requires -9007199254740991 <= used && used <= 9007199254740991
  requires -9007199254740991 <= limit && limit <= 9007199254740991
  requires 0 <= lang && lang <= 1
{
  return template(0, reason, unlimited, used, limit, lang);
}

pub fn continue_text(reason: i64, unlimited: bool, used: i64, limit: i64, lang: i64) -> [u8] ! alloc
  requires 0 <= reason && reason <= 4
  requires -9007199254740991 <= used && used <= 9007199254740991
  requires -9007199254740991 <= limit && limit <= 9007199254740991
  requires 0 <= lang && lang <= 1
{
  return template(1, reason, unlimited, used, limit, lang);
}

pub fn card_missing(lang: i64) -> [u8] ! alloc
  requires 0 <= lang && lang <= 1
{
  let mut o: [u8] = alloc(len_cm(lang), 0);
  put_cm(inout o, 0, lang);
  return o;
}

fn refusal_key(reason: i64) -> [u8] ! alloc
  requires 0 <= reason && reason <= 4
{
  let mut o: [u8] = alloc(15 + len_cn(reason, 1), 0);
  put_wire_prefix(inout o, 0);
  put_cn(inout o, 15, reason, 1);
  return o;
}

pub struct Wire { key: [u8], used: i64, limit: i64 }

// {key: 'budget.refusal.' + reason, args: {used, limit}}; time used (activeMs) floored to minutes; limit as given.
pub fn refusal_wire(reason: i64, used: i64, limit: i64) -> Wire ! alloc
  requires 0 <= reason && reason <= 4
  requires -9007199254740991 <= used && used <= 9007199254740991
{
  let mut u: i64 = used;
  if reason == 0 { u = crate::bud_num::minutes_of(used); }
  return Wire { key: refusal_key(reason), used: u, limit: limit };
}

// card validText: 1 <= trim(s).length <= 300 (UTF-16 units)
pub fn text_len_ok(a: [i64]) -> bool
{
  let n: i64 = len(a);
  let mut s: i64 = 0;
  while s < n && crate::ent_u16::is_trim_unit(a[s])
    invariant 0 <= s && s <= n && n == len(a)
    decreases n - s
  { s = s + 1; }
  let mut e: i64 = n;
  while e > s && crate::ent_u16::is_trim_unit(a[e - 1])
    invariant s <= e && e <= n && 0 <= s && n == len(a)
    decreases e - s
  { e = e - 1; }
  return e > s && e - s <= 300;
}

// targets.note: untrimmed length <= 300
pub fn raw_len_ok(s: [i64]) -> bool
{
  return len(s) <= 300;
}
