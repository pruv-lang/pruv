// L3-10 M6: request-budget text helpers (backend-request-budget.ts lines 60-160, engineText).
// Strings are [i64] arrays of UTF-16 units. lang: 0 = ko, 1 = en. reason: 0 time, 1 delegations, 2 commands,
// 3 reviews, 4 checks. Card error kind: 0 missing, 1 deliverable, 2 done, 3 targets, 4 verify, 5 conflicts, 6 state.
// All texts are BMP only, so one UTF-8 character decodes to exactly one UTF-16 unit.

// Byte i of s, 0 outside the string (total accessor).
fn sb(s: str, i: i64) -> i64
  ensures 0 <= result && result <= 255
{
  if i < 0 || i >= len(s) { return 0; }
  return s[i];
}

// Decode a UTF-8 literal (BMP only) into UTF-16 units. Two linear passes: O(len(s)).
fn dec(s: str) -> [i64] ! alloc
{
  let n: i64 = len(s);
  let mut c: i64 = 0;
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n == len(s) && 0 <= c && c <= i
    decreases n - i
  {
    let b: i64 = s[i];
    if b < 128 || b >= 192 { c = c + 1; }
    i = i + 1;
  }
  let mut o: [i64] = crate::ent_u16::zeros(c);
  i = 0;
  let mut k: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n == len(s) && 0 <= k && k <= i
    decreases n - i
  {
    let b: i64 = s[i];
    if b < 128 {
      crate::ent_u16::wr(inout o, k, b);
      k = k + 1;
      i = i + 1;
    } else {
      if b >= 224 {
        let b1: i64 = sb(s, i + 1);
        let b2: i64 = sb(s, i + 2);
        crate::ent_u16::wr(inout o, k, band(b, 15) * 4096 + band(b1, 63) * 64 + band(b2, 63));
        k = k + 1;
        i = i + 3;
        if i > n { i = n; }
      } else {
        if b >= 192 {
          let d1: i64 = sb(s, i + 1);
          crate::ent_u16::wr(inout o, k, band(b, 31) * 64 + band(d1, 63));
          k = k + 1;
          i = i + 2;
          if i > n { i = n; }
        } else {
          // stray continuation byte (cannot occur in valid UTF-8): skipped
          i = i + 1;
        }
      }
    }
  }
  return o;
}

// engineText(entry, lang) for the typed domain: absent -> ko; exactly "en" -> en; everything else -> ko.
pub fn lang_of(present: bool, s: [i64]) -> i64
  ensures result == 0 || result == 1
{
  if !present { return 0; }
  if len(s) == 2 && s[0] == 101 && s[1] == 110 { return 1; }
  return 0;
}

// s equals an Object.prototype property name: JS would return the inherited property (outside the ko/en domain).
// Marked `! alloc` because the names are literals (a literal needs alloc in code).
pub fn lang_excluded(s: [i64]) -> bool ! alloc
{
  let n: i64 = len(s);
  if n < 7 || n > 20 { return false; }
  if crate::ent_u16::eq_lit(s, "constructor") { return true; }
  if crate::ent_u16::eq_lit(s, "__proto__") { return true; }
  if crate::ent_u16::eq_lit(s, "hasOwnProperty") { return true; }
  if crate::ent_u16::eq_lit(s, "isPrototypeOf") { return true; }
  if crate::ent_u16::eq_lit(s, "propertyIsEnumerable") { return true; }
  if crate::ent_u16::eq_lit(s, "toString") { return true; }
  if crate::ent_u16::eq_lit(s, "valueOf") { return true; }
  if crate::ent_u16::eq_lit(s, "toLocaleString") { return true; }
  if crate::ent_u16::eq_lit(s, "__defineGetter__") { return true; }
  if crate::ent_u16::eq_lit(s, "__defineSetter__") { return true; }
  if crate::ent_u16::eq_lit(s, "__lookupGetter__") { return true; }
  if crate::ent_u16::eq_lit(s, "__lookupSetter__") { return true; }
  return false;
}

// number of units of String(x) for a safe integer (1..17: at most 16 digits plus a sign)
fn int_len(x: i64) -> i64
  requires -9007199254740991 <= x && x <= 9007199254740991
  ensures 1 <= result && result <= 17
{
  let mut v: i64 = x;
  if x < 0 { v = -x; }
  let mut n: i64 = 1;
  let mut t: i64 = v / 10;
  while t > 0 && n < 16
    invariant 1 <= n && n <= 16 && t >= 0
    decreases 16 - n
  {
    n = n + 1;
    t = t / 10;
  }
  if x < 0 { n = n + 1; }
  return n;
}

// write String(x) (n = int_len(x) units) into o at at; digits go backwards from the end
fn put_int(inout o: [i64], at: i64, x: i64, n: i64) -> ()
  requires -9007199254740991 <= x && x <= 9007199254740991
  requires 0 <= at && at <= 1000000 && 1 <= n && n <= 17
  ensures len(o) == len(old(o))
{
  let mut v: i64 = x;
  let mut nd: i64 = n;
  if x < 0 {
    v = -x;
    nd = n - 1;
    crate::ent_u16::wr(inout o, at, 45);
  }
  let mut t: i64 = v;
  let mut k: i64 = 0;
  while k < nd
    invariant 0 <= k && k <= nd && nd <= 17 && t >= 0 && 0 <= at && at <= 1000000 && len(o) == len(old(o))
    decreases nd - k
  {
    crate::ent_u16::wr(inout o, at + n - 1 - k, 48 + t % 10);
    t = t / 10;
    k = k + 1;
  }
}

// String(x) for a safe integer, built in one allocation.
pub fn int_text(x: i64) -> [i64] ! alloc
  requires -9007199254740991 <= x && x <= 9007199254740991
  ensures len(result) <= 17
{
  let n: i64 = int_len(x);
  let mut o: [i64] = alloc(n, 0);
  put_int(inout o, 0, x, n);
  return o;
}

pub fn reason_name(reason: i64) -> [i64] ! alloc
  requires 0 <= reason && reason <= 4
{
  if reason == 0 { return dec("time"); }
  if reason == 1 { return dec("delegations"); }
  if reason == 2 { return dec("commands"); }
  if reason == 3 { return dec("reviews"); }
  return dec("checks");
}

pub fn counter_name(reason: i64, lang: i64) -> [i64] ! alloc
  requires 0 <= reason && reason <= 4
  requires 0 <= lang && lang <= 1
{
  if lang == 1 { return reason_name(reason); }
  if reason == 0 { return dec("시간"); }
  if reason == 1 { return dec("위임"); }
  if reason == 2 { return dec("빌드·명령"); }
  if reason == 3 { return dec("감사"); }
  return dec("실제 확인");
}

pub fn no_limit(lang: i64) -> [i64] ! alloc
  requires 0 <= lang && lang <= 1
{
  if lang == 1 { return dec("no limit"); }
  return dec("제한 없음");
}

pub fn limit_text(unlimited: bool, limit: i64, lang: i64) -> [i64] ! alloc
  requires -9007199254740991 <= limit && limit <= 9007199254740991
  requires 0 <= lang && lang <= 1
{
  if unlimited { return no_limit(lang); }
  return int_text(limit);
}

// `${used}/${limitText}`. Time: used is activeMs, floored to minutes; limit is timeMinutes.
pub fn amount_text(reason: i64, unlimited: bool, used: i64, limit: i64, lang: i64) -> [i64] ! alloc
  requires 0 <= reason && reason <= 4
  requires -9007199254740991 <= used && used <= 9007199254740991
  requires -9007199254740991 <= limit && limit <= 9007199254740991
  requires 0 <= lang && lang <= 1
{
  let mut u: i64 = used;
  if reason == 0 { u = crate::bud_num::minutes_of(used); }
  // sized once and written in place (one allocation, like template below) instead of int_text + one + limit_text + 2 cats
  let lu: i64 = int_len(u);
  let mut ll: i64 = len_nl(lang);
  if !unlimited { ll = int_len(limit); }
  let mut o: [i64] = alloc(lu + 1 + ll, 0);
  put_int(inout o, 0, u, lu);
  crate::ent_u16::wr(inout o, lu, 47);
  if unlimited { put_nl(inout o, lu + 1, lang); } else { put_int(inout o, lu + 1, limit, ll); }
  return o;
}

// Cold reference forms of the two templates. They hold the template texts (the single source gen_text.py reads) and
// are not on the hot path; refusal/continue_text below build the same text in one allocation from generated writers.
// pre + counter + " " + amount + post
fn frame(pre: [i64], counter: [i64], amount: [i64], post: [i64]) -> [i64] ! alloc
{
  let sp: [i64] = crate::ent_u16::one(32);
  let a: [i64] = crate::ent_u16::cat(pre, counter);
  let b: [i64] = crate::ent_u16::cat(a, sp);
  let c: [i64] = crate::ent_u16::cat(b, amount);
  return crate::ent_u16::cat(c, post);
}

fn refusal_cold(reason: i64, unlimited: bool, used: i64, limit: i64, lang: i64) -> [i64] ! alloc
  requires 0 <= reason && reason <= 4
  requires -9007199254740991 <= used && used <= 9007199254740991
  requires -9007199254740991 <= limit && limit <= 9007199254740991
  requires 0 <= lang && lang <= 1
{
  let counter: [i64] = counter_name(reason, lang);
  let amount: [i64] = amount_text(reason, unlimited, used, limit, lang);
  if lang == 1 {
    let pre_en: [i64] = dec("The request budget limit (");
    let post_en: [i64] = dec(") was reached, so work is paused until the user extends it or ends it. Do not try new delegations or commands; briefly report the results so far and what you could not verify.");
    return frame(pre_en, counter, amount, post_en);
  }
  let pre: [i64] = dec("예산 한도(");
  let post: [i64] = dec(")에 닿아 사용자가 늘리거나 끝내기를 고를 때까지 멈춘다. 새 위임·명령을 시도하지 않고 지금까지 결과와 확인하지 못한 것만 짧게 보고한다.");
  return frame(pre, counter, amount, post);
}

fn continue_cold(reason: i64, unlimited: bool, used: i64, limit: i64, lang: i64) -> [i64] ! alloc
  requires 0 <= reason && reason <= 4
  requires -9007199254740991 <= used && used <= 9007199254740991
  requires -9007199254740991 <= limit && limit <= 9007199254740991
  requires 0 <= lang && lang <= 1
{
  let counter: [i64] = counter_name(reason, lang);
  let amount: [i64] = amount_text(reason, unlimited, used, limit, lang);
  if lang == 1 {
    let pre_en: [i64] = dec("The user raised the request budget limit (");
    let post_en: [i64] = dec("). The tool call that was cut off earlier was stopped by the app at this budget limit, not by the user. Continue from where you stopped.");
    return frame(pre_en, counter, amount, post_en);
  }
  let pre: [i64] = dec("사용자가 예산 한도(");
  let post: [i64] = dec(")를 늘렸다. 앞서 끊긴 도구 호출은 사용자 중단이 아니라 이 예산 한도에 닿아 앱이 멈춘 것이다. 멈춘 지점에서 이어 간다.");
  return frame(pre, counter, amount, post);
}

fn put3(inout o: [i64], at: i64, w: i64) -> ()
  requires 0 <= at && at <= 2000000 && 0 <= w
  ensures len(o) == len(old(o))
{
  crate::ent_u16::wr(inout o, at, band(w, 65535));
  crate::ent_u16::wr(inout o, at + 1, band(ushr(w, 16), 65535));
  crate::ent_u16::wr(inout o, at + 2, ushr(w, 32));
}

