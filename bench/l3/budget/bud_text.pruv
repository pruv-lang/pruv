// text pre_0_0: 예산 한도(
// text post_0_0: )에 닿아 사용자가 늘리거나 끝내기를 고를 때까지 멈춘다. 새 위임·명령을 시도하지 않고 지금까지 결과와 확인하지 못한 것만 짧게 보고한다.
// text pre_1_1: The user raised the request budget limit (
// text post_1_1: ). The tool call that was cut off earlier was stopped by the app at this budget limit, not by the user. Continue from where you stopped.
// text pre_1_0: 사용자가 예산 한도(
// text post_1_0: )를 늘렸다. 앞서 끊긴 도구 호출은 사용자 중단이 아니라 이 예산 한도에 닿아 앱이 멈춘 것이다. 멈춘 지점에서 이어 간다.
// text nl_1: no limit
// text nl_0: 제한 없음
// text cm_1: Before delegating, write the deliverable and the done conditions with the work_card tool.
// text cm_0: 위임 전에 work_card 도구로 산출물과 완료 조건을 먼저 적는다.
// text cn_0_0: 시간
// text cn_1_0: 위임
// text cn_2_0: 빌드·명령
// text cn_3_0: 감사
// text cn_4_0: 실제 확인
// text cn_0_1: time
// text cn_1_1: delegations
// text cn_2_1: commands
// text cn_3_1: reviews
// text cn_4_1: checks
// text ce_0_0: 지금 예산을 찾을 수 없어 작업 카드를 저장하지 못했다.
// text ce_1_0: deliverable 은 1~300자여야 한다.
// text ce_2_0: done 은 각 300자 이하 1~5줄이어야 한다.
// text ce_3_0: targets 의 수는 0 이상 정수여야 하고 note 는 300자 이하여야 한다.
// text ce_4_0: verify 는 label 1~300자와 status(planned·done·skipped)를 가진 0~5개 항목이어야 한다.
// text ce_5_0: conflicts 는 각 300자 이하 0~5줄이어야 한다.
// text ce_6_0: state 는 working·done·waiting-user·blocked 중 하나여야 한다.
// text ce_0_1: The current budget was not found, so the work card was not saved.
// text ce_1_1: deliverable must be 1–300 characters.
// text ce_2_1: done must be 1–5 lines of at most 300 characters each.
// text ce_3_1: targets counts must be non-negative integers and note at most 300 characters.
// text ce_4_1: verify must be 0–5 items with a label of 1–300 characters and a status (planned, done or skipped).
// text ce_5_1: conflicts must be 0–5 lines of at most 300 characters each.
// text ce_6_1: state must be one of working, done, waiting-user or blocked.
// text wire_prefix: budget.refusal.

// engineText(entry, lang) for the typed domain: absent -> ko; exactly "en" -> en; everything else -> ko.
pub fn lang_of(present: bool, s: [i64]) -> i64
  ensures result == 0 || result == 1
{
  if !present { return 0; }
  if len(s) == 2 && s[0] == 101 && s[1] == 110 { return 1; }
  return 0;
}

// s equals an Object.prototype property name: JS would return the inherited property (outside the ko/en domain).
// Marked `! alloc` because the names are literals (a literal needs alloc in code).
pub fn lang_excluded(s: [i64]) -> bool ! alloc
{
  let n: i64 = len(s);
  if n < 7 || n > 20 { return false; }
  if crate::ent_u16::eq_lit(s, "constructor") { return true; }
  if crate::ent_u16::eq_lit(s, "__proto__") { return true; }
  if crate::ent_u16::eq_lit(s, "hasOwnProperty") { return true; }
  if crate::ent_u16::eq_lit(s, "isPrototypeOf") { return true; }
  if crate::ent_u16::eq_lit(s, "propertyIsEnumerable") { return true; }
  if crate::ent_u16::eq_lit(s, "toString") { return true; }
  if crate::ent_u16::eq_lit(s, "valueOf") { return true; }
  if crate::ent_u16::eq_lit(s, "toLocaleString") { return true; }
  if crate::ent_u16::eq_lit(s, "__defineGetter__") { return true; }
  if crate::ent_u16::eq_lit(s, "__defineSetter__") { return true; }
  if crate::ent_u16::eq_lit(s, "__lookupGetter__") { return true; }
  if crate::ent_u16::eq_lit(s, "__lookupSetter__") { return true; }
  return false;
}

// Decimal digit count using threshold comparisons.
fn digits(v: i64) -> i64
  requires 0 <= v && v <= 9007199254740991
  ensures 1 <= result && result <= 16
{
  if v < 100000000 {
    if v < 10000 {
      if v < 10 { return 1; }
      if v < 100 { return 2; }
      if v < 1000 { return 3; }
      return 4;
    }
    if v < 100000 { return 5; }
    if v < 1000000 { return 6; }
    if v < 10000000 { return 7; }
    return 8;
  }
  if v < 1000000000000 {
    if v < 1000000000 { return 9; }
    if v < 10000000000 { return 10; }
    if v < 100000000000 { return 11; }
    return 12;
  }
  if v < 10000000000000 { return 13; }
  if v < 100000000000000 { return 14; }
  if v < 1000000000000000 { return 15; }
  return 16;
}

fn int_len(x: i64) -> i64
  requires -9007199254740991 <= x && x <= 9007199254740991
  ensures 1 <= result && result <= 17
{
  if x < 0 { return 1 + digits(-x); }
  return digits(x);
}

// write String(x) (n = int_len(x) bytes) into o at at; digits go backwards from the end
fn put_int(inout o: [u8], at: i64, x: i64, n: i64) -> ()
  requires -9007199254740991 <= x && x <= 9007199254740991
  requires 0 <= at && at <= 1000000 && 1 <= n && n <= 17
  ensures len(o) == len(old(o))
{
  let mut v: i64 = x;
  if at + n > len(o) || (x < 0 && n < 2) { return; }
  let mut nd: i64 = n;
  if x < 0 {
    v = -x;
    nd = n - 1;
    o[at] = 45;
  }
  let mut t: i64 = v;
  let mut k: i64 = 0;
  while k < nd
    invariant 0 <= k && k <= nd && nd <= n && t >= 0 && at + n <= len(o) && len(o) == len(old(o))
    decreases nd - k
  {
    o[at + n - 1 - k] = 48 + t % 10;
    t = t / 10;
    k = k + 1;
  }
}

// String(x) for a safe integer, built in one allocation.
pub fn int_text(x: i64) -> [u8] ! alloc
  requires -9007199254740991 <= x && x <= 9007199254740991
  ensures len(result) <= 17
{
  let n: i64 = int_len(x);
  let mut o: [u8] = alloc(n, 0);
  put_int(inout o, 0, x, n);
  return o;
}

pub fn reason_name(reason: i64) -> [u8] ! alloc
  requires 0 <= reason && reason <= 4
{
  let mut o: [u8] = alloc(len_cn(reason, 1), 0);
  put_cn(inout o, 0, reason, 1);
  return o;
}

pub fn counter_name(reason: i64, lang: i64) -> [u8] ! alloc
  requires 0 <= reason && reason <= 4
  requires 0 <= lang && lang <= 1
{
  let mut o: [u8] = alloc(len_cn(reason, lang), 0);
  put_cn(inout o, 0, reason, lang);
  return o;
}

pub fn no_limit(lang: i64) -> [u8] ! alloc
  requires 0 <= lang && lang <= 1
{
  let mut o: [u8] = alloc(len_nl(lang), 0);
  put_nl(inout o, 0, lang);
  return o;
}

pub fn limit_text(unlimited: bool, limit: i64, lang: i64) -> [u8] ! alloc
  requires -9007199254740991 <= limit && limit <= 9007199254740991
  requires 0 <= lang && lang <= 1
{
  if unlimited { return no_limit(lang); }
  return int_text(limit);
}

// `${used}/${limitText}`. Time: used is activeMs, floored to minutes; limit is timeMinutes.
pub fn amount_text(reason: i64, unlimited: bool, used: i64, limit: i64, lang: i64) -> [u8] ! alloc
  requires 0 <= reason && reason <= 4
  requires -9007199254740991 <= used && used <= 9007199254740991
  requires -9007199254740991 <= limit && limit <= 9007199254740991
  requires 0 <= lang && lang <= 1
{
  let mut u: i64 = used;
  if reason == 0 { u = crate::bud_num::minutes_of(used); }
  let lu: i64 = int_len(u);
  let mut ll: i64 = len_nl(lang);
  if !unlimited { ll = int_len(limit); }
  let mut o: [u8] = alloc(lu + 1 + ll, 0);
  put_int(inout o, 0, u, lu);
  o[lu] = 47;
  if unlimited { put_nl(inout o, lu + 1, lang); } else { put_int(inout o, lu + 1, limit, ll); }
  return o;
}

