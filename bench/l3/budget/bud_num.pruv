// L3-10 M6: number helpers of the request budget.
// Safe integral domain: |x| <= 9007199254740991 (2^53 - 1). Arithmetic whose exact result leaves it is an
// excluded-domain result (NumR.ok == false): JS would round silently (accidental), Pruv reports it (spec 15.2).

pub fn safe_max() -> i64
  ensures result == 9007199254740991
{
  return 9007199254740991;
}

pub fn is_safe(x: i64) -> bool
{
  return x >= -9007199254740991 && x <= 9007199254740991;
}

// ok == false: the exact result is outside the safe domain; v is 0 then.
pub struct NumR { ok: bool, v: i64 }

pub fn add_safe(a: i64, b: i64) -> NumR
  requires -9007199254740991 <= a && a <= 9007199254740991
  requires -9007199254740991 <= b && b <= 9007199254740991
  ensures result.ok ==> (result.v == a + b && -9007199254740991 <= result.v && result.v <= 9007199254740991)
  ensures !result.ok ==> result.v == 0
{
  let s: i64 = a + b;
  if s > 9007199254740991 || s < -9007199254740991 { return NumR { ok: false, v: 0 }; }
  return NumR { ok: true, v: s };
}

pub fn sub_safe(a: i64, b: i64) -> NumR
  requires -9007199254740991 <= a && a <= 9007199254740991
  requires -9007199254740991 <= b && b <= 9007199254740991
  ensures result.ok ==> (result.v == a - b && -9007199254740991 <= result.v && result.v <= 9007199254740991)
  ensures !result.ok ==> result.v == 0
{
  let s: i64 = a - b;
  if s > 9007199254740991 || s < -9007199254740991 { return NumR { ok: false, v: 0 }; }
  return NumR { ok: true, v: s };
}

pub fn mul_safe(a: i64, b: i64) -> NumR
  requires -9007199254740991 <= a && a <= 9007199254740991
  requires -9007199254740991 <= b && b <= 9007199254740991
  ensures result.ok ==> (-9007199254740991 <= result.v && result.v <= 9007199254740991)
  ensures !result.ok ==> result.v == 0
{
  if a == 0 || b == 0 { return NumR { ok: true, v: 0 }; }
  let mut aa: i64 = a;
  if a < 0 { aa = -a; }
  let mut ab: i64 = b;
  if b < 0 { ab = -b; }
  // aa >= 1, ab >= 1: the quotient is well defined and aa <= SAFE / ab implies aa * ab <= SAFE
  let lim: i64 = 9007199254740991 / ab;
  if aa > lim { return NumR { ok: false, v: 0 }; }
  let p: i64 = aa * ab;
  if p > 9007199254740991 { return NumR { ok: false, v: 0 }; }
  if (a < 0) == (b < 0) { return NumR { ok: true, v: p }; }
  return NumR { ok: true, v: -p };
}

pub fn max2(a: i64, b: i64) -> i64
  ensures result >= a && result >= b
{
  if a >= b { return a; }
  return b;
}

// Math.floor(a / d) for safe a and 0 < d <= SAFE.
pub fn floor_div(a: i64, d: i64) -> i64
  requires -9007199254740991 <= a && a <= 9007199254740991
  requires 0 < d && d <= 9007199254740991
  ensures -9007199254740991 <= result && result <= 9007199254740991
{
  if a >= 0 {
    let q: i64 = a / d;
    if q > a { return a; }
    return q;
  }
  // a < 0: floor(a / d) = -((-a - 1) / d) - 1
  let x: i64 = -a - 1;
  let q2: i64 = x / d;
  if q2 > x { return -x - 1; }
  return -q2 - 1;
}

pub fn minutes_of(ms: i64) -> i64
  requires -9007199254740991 <= ms && ms <= 9007199254740991
  ensures -9007199254740991 <= result && result <= 9007199254740991
{
  return floor_div(ms, 60000);
}

// `bits` is the raw IEEE-754 double pattern in an i64 (two's complement).
// 0 = accepted by Number.isInteger(x) && x >= 0 (+0, -0, positive integers of any magnitude),
// 1 = negative integer, 2 = non-integer finite (fractions, subnormals), 3 = NaN, 4 = +-Infinity.
pub fn count_class(bits: i64) -> i64
  ensures 0 <= result && result <= 4
{
  let e: i64 = band(ushr(bits, 52), 2047);
  let m: i64 = band(bits, 4503599627370495);
  let sg: i64 = ushr(bits, 63);
  if e == 2047 {
    if m == 0 { return 4; }
    return 3;
  }
  if e == 0 {
    // zero (+0 / -0 are accepted) or subnormal
    if m == 0 { return 0; }
    return 2;
  }
  let unb: i64 = e - 1023;
  if unb < 0 { return 2; }
  if unb >= 52 {
    if sg == 1 { return 1; }
    return 0;
  }
  // 0 <= unb <= 51: the low (52 - unb) mantissa bits must be zero; mask = 2^(52 - unb) - 1 = ushr(-1, 12 + unb)
  let k: i64 = 12 + unb;
  let mask: i64 = ushr(-1, k);
  if band(m, mask) != 0 { return 2; }
  if sg == 1 { return 1; }
  return 0;
}

pub fn count_ok_bits(bits: i64) -> bool
{
  return count_class(bits) == 0;
}

pub fn count_ok_int(v: i64) -> bool
{
  return v >= 0;
}

pub struct Unit { time_minutes: i64, delegations: i64, commands: i64, reviews: i64, checks: i64, default_unlimited: bool }

// budgetUnitOf(undefined): DEFAULT_BUDGET numbers, marked default-unlimited
pub fn unit_default() -> Unit
{
  return Unit { time_minutes: 120, delegations: 24, commands: 3, reviews: 2, checks: 1, default_unlimited: true };
}

// budgetUnitOf(setting): projection of the five limit fields
pub fn unit_of(t: i64, d: i64, c: i64, r: i64, k: i64) -> Unit
{
  return Unit { time_minutes: t, delegations: d, commands: c, reviews: r, checks: k, default_unlimited: false };
}
