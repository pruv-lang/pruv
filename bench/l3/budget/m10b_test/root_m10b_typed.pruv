mod ent_u16;
mod bud_keys;

mod bud_tstate;
mod bud_tlife;
mod bud_tdecide;

pub struct Ordinal { value: i64 }

pub struct St {
  sessions: HashMap<String, crate::bud_tstate::Budget>,
  ordinals: HashMap<String, Ordinal>, next_session: i64,
  clock_state: crate::bud_tstate::ClockState, out: crate::bud_tstate::Out
}

fn take_budget(budget: crate::bud_tstate::Budget) -> crate::bud_tstate::Budget ! alloc
{ return budget; }

// Session insertion: Pruv decides the refusal (status 2 before an ordinal reaches 2^40) and keeps the order.
pub fn t_put(inout st: St, sid: str, budget: crate::bud_tstate::Budget) -> i64 ! alloc
{
  if len(st.sessions) >= 1099511627776 { return 2; }
  let mut new_session: bool = true;
  match map_get_mut::<String, Ordinal>(inout st.ordinals, sid) {
    Some(ordinal) => { new_session = false; }
    None => { }
  }
  if new_session {
    let ordinal: i64 = st.next_session;
    if len(st.ordinals) >= 1099511627776 || ordinal < 0 || ordinal >= 1099511627775 { return 2; }
    st.next_session = ordinal + 1;
    st.ordinals = map_insert::<String, Ordinal>(move st.ordinals, string_push_str(string_new(), sid), Ordinal { value: ordinal });
  }
  st.sessions = map_insert::<String, crate::bud_tstate::Budget>(move st.sessions, string_push_str(string_new(), sid), take_budget(budget));
  return 0;
}

pub fn t_charge(inout st: St, sid: str, bid: str, now: i64, charge: crate::bud_tstate::Charge) -> crate::bud_tstate::Reply ! alloc, io
{
  vec_clear::<crate::bud_tstate::Effect>(inout st.out.fx);
  let mut reply: crate::bud_tstate::Reply = crate::bud_tstate::Reply { status: 0, value: 5, a: 2, b: 0 };
  match map_get_mut::<String, crate::bud_tstate::Budget>(inout st.sessions, sid) {
    Some(b) => {
      if b.state >= 0 && string_eq(b.id, bid) {
        let mut reason: i64 = -1;
        if b.state == 1 {
          reason = b.halt_reason;
          if reason < 0 { reason = 1; }
        }
        if b.state == 0 {
          let charged: i64 = crate::bud_tstate::charge_typed(inout b, charge);
          if charged < 0 { reply.status = 2; }
          if charged > 0 {
            reason = charged;
            match map_get_mut::<String, crate::bud_tstate::Clock>(inout st.clock_state.clocks, bid) {
              Some(c) => { crate::bud_tstate::settle(inout b, inout c, sid, now, inout st.out); }
              None => { }
            }
            let status: i64 = crate::bud_tlife::halt(inout b, sid, bid, now, reason, inout st.out); reply.status = status;
          }
        }
        if reason >= 0 { reply.a = 1; reply.b = reason; }
      }
    }
    None => { }
  }
  return reply;
}

pub fn t_view(inout st: St, sid: str, bid: str, code: i64) -> crate::bud_tstate::Reply ! alloc
{
  vec_clear::<crate::bud_tstate::Effect>(inout st.out.fx);
  return crate::bud_tlife::view(inout st.sessions, inout st.out, sid, bid, code);
}

pub fn t_close(inout st: St, sid: str, now: i64) -> crate::bud_tstate::Reply ! alloc, io
{
  vec_clear::<crate::bud_tstate::Effect>(inout st.out.fx);
  return crate::bud_tlife::maybe_close(inout st.sessions, inout st.clock_state.clocks, inout st.out, sid, now);
}

pub fn t_run(inout st: St, sid: str, bid: str, run: str, code: i64, now: i64, flag: i64) -> crate::bud_tstate::Reply ! alloc, io
{
  vec_clear::<crate::bud_tstate::Effect>(inout st.out.fx);
  return crate::bud_tlife::run_event(inout st.sessions, inout st.clock_state, inout st.out, sid, bid, run, code, now, flag);
}

pub fn t_halt(inout st: St, sid: str, bid: str, now: i64, flag: i64) -> crate::bud_tstate::Reply ! alloc, io
{
  vec_clear::<crate::bud_tstate::Effect>(inout st.out.fx);
  return crate::bud_tlife::explicit_halt(inout st.sessions, inout st.clock_state.clocks, inout st.out, sid, bid, now, flag);
}

pub fn t_raise(inout st: St, sid: str, bid: str, now: i64, size: i64, unit: crate::bud_tstate::UnitAnswer) -> crate::bud_tstate::Reply ! alloc, io
{
  vec_clear::<crate::bud_tstate::Effect>(inout st.out.fx);
  return crate::bud_tdecide::raise(inout st.sessions, inout st.clock_state.clocks, inout st.out, sid, bid, now, size, unit);
}

pub fn t_decide(inout st: St, sid: str, bid: str, now: i64, flag: i64, unit: crate::bud_tstate::UnitAnswer) -> crate::bud_tstate::Reply ! alloc, io
{
  vec_clear::<crate::bud_tstate::Effect>(inout st.out.fx);
  return crate::bud_tdecide::decide(inout st.sessions, inout st.clock_state.clocks, inout st.out, sid, bid, now, flag, unit);
}

// Test-only packet decoding and rejection, shared with the direct-entry test lane.
pub fn t_charge_words(what: [i64]) -> Option<crate::bud_tstate::Charge>
{
  if len(what) != 10 { return None::<crate::bud_tstate::Charge>; }
  return Some::<crate::bud_tstate::Charge>(crate::bud_tstate::charge_words(what));
}

pub fn t_unit_answer(unit: [i64]) -> crate::bud_tstate::UnitAnswer
{
  return crate::bud_tstate::unit_answer(unit);
}

pub fn t_invalid(inout st: St) -> crate::bud_tstate::Reply ! alloc
{
  vec_clear::<crate::bud_tstate::Effect>(inout st.out.fx);
  return crate::bud_tstate::Reply { status: 2, value: 0, a: 0, b: 0 };
}

// Test-only adapter for the packet driver.
pub fn t_call(inout st: St, sid: str, bid: str, run: str, code: i64,
              now: i64, flag: i64, what: [i64], unit: [i64]) -> crate::bud_tstate::Reply ! alloc, io
{
  if code == 1 || code == 2 || code == 5 { return t_view(inout st, sid, bid, code); }
  if code == 6 { return t_close(inout st, sid, now); }
  if code == 7 {
    match t_charge_words(what) {
      Some(c) => { return t_charge(inout st, sid, bid, now, c); }
      None => { return t_invalid(inout st); }
    }
  }
  if code >= 8 && code <= 11 { return t_run(inout st, sid, bid, run, code, now, flag); }
  if code == 12 { return t_halt(inout st, sid, bid, now, flag); }
  if code == 13 { return t_raise(inout st, sid, bid, now, flag, t_unit_answer(unit)); }
  if code == 14 { return t_decide(inout st, sid, bid, now, flag, t_unit_answer(unit)); }
  return t_invalid(inout st);
}

pub fn t_admit_key(inout key: crate::bud_keys::KeyAdmission, words: [i64], last: bool) -> i64 ! alloc {
  return crate::bud_keys::admit_key(inout key, words, last, true);
}

fn text_bytes_ok(text: [u8], start: i64, count: i64) -> bool {
  if start < 0 || start > len(text) || count <= 0 || count > len(text) - start { return false; }
  let end: i64 = start + count;
  let mut i: i64 = start;
  // UTF-8 with surrogate code points, as used by the Q text wire.
  while i < end
    invariant start <= i && i <= end && end <= len(text)
    decreases end - i
  {
    let lead: i64 = text[i];
    if lead < 128 { i = i + 1; }
    else {
      if lead < 194 || lead >= 245 || end - i < 2 { return false; }
      let second: i64 = text[i + 1];
      if second < 128 || second >= 192 { return false; }
      if lead < 224 { i = i + 2; }
      else {
        if end - i < 3 || text[i + 2] < 128 || text[i + 2] >= 192 { return false; }
        if lead < 240 {
          if lead == 224 && second < 160 { return false; }
          i = i + 3;
        } else {
          if end - i < 4 || text[i + 3] < 128 || text[i + 3] >= 192 { return false; }
          if (lead == 240 && second < 144) || (lead == 244 && second >= 144) { return false; }
          i = i + 4;
        }
      }
    }
  }
  return true;
}

fn text_end(words: [i64], text: [u8], at: i64, end: i64) -> i64
  ensures result == -1 || (at < result && result <= end)
{
  if end > len(words) || at < 0 || at >= end { return -1; }
  if words[at] == 0 { return at + 1; }
  if words[at] != 2 || end - at < 3 { return -1; }
  if !text_bytes_ok(text, words[at + 2], words[at + 1]) { return -1; }
  return at + 3;
}

// The SID has already been admitted. The next word declares the remaining
// record length. Validate all text handles before the host codec dereferences them.
pub fn t_admit_put(words: [i64], text: [u8]) -> i64 {
  let end: i64 = len(words);
  if end < 2 || words[0] != end - 1 { return 2; }
  if end == 2 && words[1] == -1 { return 0; }
  if end < 31 || words[1] < 0 || words[1] > 2 { return 2; }
  let mut at: i64 = crate::bud_keys::rec_end(words, 25);
  at = text_end(words, text, at, end);
  at = text_end(words, text, at, end);
  at = text_end(words, text, at, end);
  if at < 0 { return 2; }
  at = crate::bud_keys::rec_end(words, at);
  if at < 0 || at >= end || words[at] != end - at - 1 { return 2; }
  if words[at] == 0 { return 0; }
  if words[at + 1] != -2 {
    if text_end(words, text, at, end) == end { return 0; }
    return 2;
  }
  if end - at < 7 { return 2; }
  if words[at + 2] < 0 || words[at + 2] > 4 || (words[at + 3] != 1 && words[at + 3] != 2) { return 2; }
  at = text_end(words, text, at + 5, end);
  if at < 0 || at >= end { return 2; }
  let mut count: i64 = words[at];
  if count < 0 || count > end - at - 1 { return 2; }
  at = at + 1;
  while count > 0
    invariant 0 <= count && 0 <= at && at <= end
    decreases count
  {
    at = crate::bud_keys::rec_end(words, at);
    if at < 0 { return 2; }
    count = count - 1;
  }
  if at == end { return 0; }
  if end - at != 2 || !text_bytes_ok(text, words[at + 1], words[at]) { return 2; }
  return 0;
}
