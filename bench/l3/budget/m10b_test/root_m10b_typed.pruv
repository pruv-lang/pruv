mod bud_tstate;
mod bud_tlife;
mod bud_tdecide;

pub struct St {
  sessions: HashMap<String, crate::bud_tstate::Budget>, clock_state: crate::bud_tstate::ClockState, out: crate::bud_tstate::Out
}

fn apply_charge(inout st: St, sid: str, bid: str, now: i64, what: [i64]) -> crate::bud_tstate::Reply ! alloc, io
{
  let mut reply: crate::bud_tstate::Reply = crate::bud_tstate::Reply { status: 0, value: 5, a: 2, b: 0 };
  match map_get_mut::<String, crate::bud_tstate::Budget>(inout st.sessions, sid) {
    Some(b) => {
      if b.state >= 0 && string_eq(b.id, bid) {
        let mut reason: i64 = -1;
        if b.state == 1 {
          reason = b.halt_reason;
          if reason < 0 { reason = 1; }
        }
        if b.state == 0 && len(what) == 10 {
          let charged: i64 = crate::bud_tstate::charge(inout b, what);
          if charged < 0 { reply.status = 2; }
          if charged > 0 {
            reason = charged;
            match map_get_mut::<String, crate::bud_tstate::Clock>(inout st.clock_state.clocks, bid) {
              Some(c) => { crate::bud_tstate::settle(inout b, inout c, sid, now, inout st.out); }
              None => { }
            }
            let status: i64 = crate::bud_tlife::halt(inout b, sid, bid, now, reason, inout st.out); reply.status = status;
          }
        }
        if reason >= 0 { reply.a = 1; reply.b = reason; }
      }
    }
    None => { }
  }
  return reply;
}

pub fn t_call(inout st: St, sid: str, bid: str, run: str, code: i64,
              now: i64, flag: i64, what: [i64]) -> crate::bud_tstate::Reply ! alloc, io
{
  vec_clear::<crate::bud_tstate::Effect>(inout st.out.fx);
  if code == 1 || code == 2 || code == 5 { return crate::bud_tlife::view(inout st.sessions, inout st.out, sid, bid, code); }
  if code == 6 { return crate::bud_tlife::maybe_close(inout st.sessions, inout st.clock_state.clocks, inout st.out, sid, now); }
  if code == 7 { return apply_charge(inout st, sid, bid, now, what); }
  if code >= 8 && code <= 11 { return crate::bud_tlife::run_event(inout st.sessions, inout st.clock_state, inout st.out, sid, bid, run, code, now, flag); }
  if code == 12 { return crate::bud_tlife::explicit_halt(inout st.sessions, inout st.clock_state.clocks, inout st.out, sid, bid, now, flag); }
  if code == 13 { return crate::bud_tdecide::raise(inout st.sessions, inout st.clock_state.clocks, inout st.out, sid, bid, now, flag); }
  if code == 14 { return crate::bud_tdecide::decide(inout st.sessions, inout st.clock_state.clocks, inout st.out, sid, bid, now, flag); }
  return crate::bud_tstate::Reply { status: 2, value: 0, a: 0, b: 0 };
}
