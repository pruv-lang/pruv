mod ent_u16;
mod bud_keys;
mod bud_store;
mod bud_map;
mod bud_world;
mod bud_clock;
mod bud_lifecycle;
mod bud_charge;
mod bud_halt;
mod bud_tx;
mod bud_decide;

// L3-10 M10b test root: drives raise and the M10 halt paths over the M7 record and M9 clock.
//
// t_call op: [code, now, reserved zero, what x10, flag, sessionId key, budgetId key, runKey key], key = `n, words(n)
// packed words` (bud_keys layout; the host packs every key once at ingress). halt asks runningDelegationIds itself,
// synchronously after SETTLE (bud_halt::running_ids, P24; the M10a prefetched answer and its [30] marker are retired).
// Every key is checked with bud_keys::rec_end (framing + canonical form, O(1) per key) before anything is read or
// written; a bad one answers 2. The sessionId stays framed in the op
// (op[14] = sn), which run_started needs for the clock's owner blob. Records hold the budget id and follows packed
// (bud_lifecycle.pruv header) and the stopped delegation ids packed (bud_halt.pruv header).
//   code 1 current(ref), 2 isHalted(ref), 5 reopen(ref), 6 maybeClose(session), 7 charge(ref, what),
//   8 runStarted(ref, runKey), 9 runWaiting(ref, runKey, flag == 1), 10 runEnded(ref, runKey),
//   11 FIRE (the ref the delivered timer captured when it was armed), 12 halt(ref, reason = flag), 13 raise(ref, size = flag),
//   14 decide(ref, flag): -1 end, else extend with size = flag (0 unlimited, 1, 2, 4, 8; the host maps an absent size to 1).
//   what[3..13) = bud_charge's [kind, value] x5 (delegations, commands, reviews, checks, retries).
// maybeClose consults isQuiet synchronously.
// out: lifecycle's tags (0 undef, 1 false, 2 true, 4 budget), charge [5, ok (1 false, 2 true), reason (0..4)],
// decide [6, code (0 ok, 1 not-found, 2 not-halted)]. decide asks releaseHeld synchronously (bud_decide.pruv).
// Status: 0 done, 2 invalid, 3 out/fx small, 6 halt's answer does not fit (terminal, bud_halt.pruv header), -N Grow
// (nothing written).

fn rd(a: [i64], i: i64) -> i64
{ return crate::ent_u16::rd(a, i); }

fn wr(inout a: [i64], i: i64, v: i64) -> ()
{ crate::ent_u16::wr(inout a, i, v); }

fn c32(x: i64) -> i64
  ensures 0 <= result && result <= 4294967296
{ return crate::bud_store::c32(x); }

pub fn t_init(inout st: [i64]) -> i64
{ return crate::bud_store::init_store(inout st); }

pub fn t_grow(prev: [i64], inout next: [i64]) -> i64
{
  if !crate::bud_store::valid(prev) { return 2; }
  if len(next) < len(prev) { return 2; }
  let r: i64 = crate::bud_map::grow_copy(prev, inout next);
  if r != 0 { return 2; }
  return 0;
}

// Session put: [sessionId key, n, record words...] with text offsets relative to txt.
// Status: 0 ok, 1 store Grow, 2 invalid, 3 out small, 4 text Grow. Grow sizes are in out[0].
pub fn t_put(inout st: [i64], inout tx: [u8], op: [i64], txt: [u8], inout out: [i64]) -> i64
{ return crate::bud_tx::put(inout st, inout tx, op, txt, inout out); }

pub fn t_tinit(inout tx: [u8]) -> i64
{ return crate::bud_tx::init(inout tx); }

pub fn t_tgrow(inout st: [i64], prev: [u8], inout next: [u8]) -> i64
{ return crate::bud_tx::grow(inout st, prev, inout next); }

pub fn t_text(tx: [u8], off: i64, n: i64, inout ob: [u8]) -> i64
{ return crate::bud_tx::text(tx, off, n, inout ob); }

// session remove: [sessionId key].
pub fn t_del(inout st: [i64], op: [i64], inout out: [i64]) -> i64
{
  if !crate::bud_store::valid(st) { return 2; }
  let e1: i64 = crate::bud_keys::rec_end(op, 0);
  if e1 < 0 { return 2; }
  let kn: i64 = crate::ent_u16::rd(op, 0);
  return crate::bud_world::session_del(inout st, op, 1, kn, inout out);
}

fn out3(inout out: [i64], a: i64, b: i64, c: i64) -> ()
{
  wr(inout out, 0, a);
  wr(inout out, 1, b);
  wr(inout out, 2, c);
}

// charge(ref, what) (B:244-262): CURRENT, the charge frame from the record, bud_charge, then the in-place counter
// writes, or halt(ref, key) for an over-limit key.
fn charge(inout st: [i64], op: [i64], sn: i64, bs: i64, bn: i64, now: i64, inout bv: [i64], inout fx: [i64], inout out: [i64]) -> i64 ! alloc, io
{
  if len(out) < 3 { return 3; }
  let mut cv: [i64] = alloc(15, 0);
  let se: i64 = crate::bud_lifecycle::current_entry(st, op, 15, sn, op, bs, bn);
  let mut off: i64 = 0;
  if se >= 0 {
    off = crate::bud_lifecycle::blob_at(st, se);
    wr(inout cv, 0, 1);
    wr(inout cv, 1, rd(st, off));
    let mut u: i64 = 0;
    if rd(st, off + 2) == 1 { u = 1; }
    wr(inout cv, 2, u);
    wr(inout cv, 3, crate::bud_halt::halt_reason(st, off));
    let mut i: i64 = 0;
    while i < 4
      invariant 0 <= i && i <= 4
      decreases 4 - i
    {
      wr(inout cv, 4 + i, rd(st, off + 4 + i));
      wr(inout cv, 8 + i, rd(st, off + 9 + i));
      i = i + 1;
    }
    wr(inout cv, 12, rd(st, off + 13));
    wr(inout cv, 13, rd(st, off + 14));
    wr(inout cv, 14, rd(st, off + 15));
  }
  let r: i64 = crate::bud_charge::charge(inout cv, op, 3);
  if r == 0 {
    let mut j: i64 = 0;
    while j < 4
      invariant 0 <= j && j <= 4
      decreases 4 - j
    {
      wr(inout st, off + 9 + j, rd(cv, 8 + j));
      j = j + 1;
    }
    wr(inout st, off + 15, rd(cv, 14));
    out3(inout out, 5, 2, 0);
    return 0;
  }
  if r == 1 {
    out3(inout out, 5, 2, 0);
    return 0;
  }
  if r >= 16 && r <= 20 {
    out3(inout out, 5, 1, r - 16);
    return 0;
  }
  if r >= 33 && r <= 36 {
    let k: i64 = r - 32;
    let h: i64 = crate::bud_halt::halt(inout st, op, 15, sn, op, bs, bn, k, now, inout bv, inout fx);
    if h != 0 { return h; }
    out3(inout out, 5, 1, k);
    return 0;
  }
  return 2;
}

// The run methods and FIRE (bud_clock keyed entries) on the M7 record: the clock frame bv is the record's view when
// the ref is CURRENT; afterwards the record takes the frame back (used.activeMs, activeSince), and HALT_TIME runs
// halt(ref, 'time'). Room for the clock entries, a rewritten record and halt's record without its id list is reserved
// before the first write, so a Grow can only happen with nothing written (the id list is reserved by halt after its
// query). The fx room for the nested halt's fixed part (5 clock words + 12) and the record check (rec_ok_in) are also
// done before the first write.
fn run_op(inout st: [i64], op: [i64], code: i64, sn: i64, bs: i64, bn: i64, rs: i64, rn: i64, flag: i64, now: i64, inout bv: [i64], inout fx: [i64], inout out: [i64]) -> i64 ! alloc, io
{
  if len(out) < 1 { return 3; }
  if !crate::bud_clock::fx_ok(fx) { return 3; }
  let se: i64 = crate::bud_lifecycle::current_entry(st, op, 15, sn, op, bs, bn);
  wr(inout bv, 0, 0);
  let mut k0: i64 = 0;
  let mut hw: i64 = 0;
  if se >= 0 {
    let off0: i64 = crate::bud_lifecycle::blob_at(st, se);
    if crate::bud_store::c40(rd(fx, 0)) + 5 + 12 > len(fx) { return 3; }
    if !crate::bud_halt::rec_ok_in(st, off0, crate::bud_lifecycle::blob_n(st, se)) { return 2; }
    crate::bud_lifecycle::view_in(st, off0, inout bv);
    k0 = rd(st, off0 + 16);
    hw = crate::bud_halt::halt_words(st, se);
    // a settled text activeSince is rewritten (at most the record's words) before a nested halt reserves its room
    if k0 == 1 { hw = crate::bud_store::c40(hw + crate::bud_lifecycle::blob_n(st, se)); }
  }
  // a new clock and run: their packed key words, the framed owner blob (1 + words(sn)), and halt's room
  let nd: i64 = crate::bud_map::make_room(inout st, 2, crate::bud_keys::words(bn) + 1 + crate::bud_keys::words(sn) + crate::bud_keys::words(rn) + hw);
  if nd != 0 { return crate::bud_lifecycle::grow(nd); }
  let mut r: i64 = 2;
  if code == 8 { r = crate::bud_clock::run_started(inout st, op, bs, bn, op, 15, sn, op, rs, rn, now, inout bv, inout fx); }
  if code == 9 { r = crate::bud_clock::run_waiting(inout st, op, bs, bn, op, 15, sn, op, rs, rn, flag == 1, now, inout bv, inout fx); }
  if code == 10 { r = crate::bud_clock::run_ended(inout st, op, bs, bn, op, 15, sn, op, rs, rn, now, inout bv, inout fx); }
  if code == 11 { r = crate::bud_clock::fire(inout st, op, bs, bn, op, 15, sn, now, inout bv, inout fx); }
  if r != 0 && r != 4 { return 2; }
  wr(inout out, 0, 0);
  if se < 0 { return 0; }
  let off: i64 = crate::bud_lifecycle::blob_at(st, se);
  wr(inout st, off + 8, rd(bv, 4));
  wr(inout st, off + 16, rd(bv, 5));
  wr(inout st, off + 17, rd(bv, 6));
  // SETTLE's record change is complete (activeSince text dropped) before a nested halt, so a halt that fails after
  // its own SETTLE keeps a consistent record (its k0 is this op's settled kind).
  if k0 == 1 && rd(bv, 5) != 1 {
    let b: [i64] = crate::bud_lifecycle::blob_copy(st, se);
    let h: [i64] = crate::ent_u16::slice(b, 0, 24);
    let p3: i64 = crate::bud_lifecycle::str_at(b, 3);
    let l3: i64 = c32(rd(b, p3));
    let nb: [i64] = crate::bud_lifecycle::rewrite(b, h, true, b, crate::bud_store::c40(p3 + 1), l3);
    let w: i64 = crate::bud_lifecycle::store(inout st, op, 15, sn, nb);
    if w != 0 { return 2; }
  }
  if r == 4 {
    let h: i64 = crate::bud_halt::halt(inout st, op, 15, sn, op, bs, bn, 0, now, inout bv, inout fx);
    if h == 6 { return 6; }
    if h != 0 { return 2; }
    return 0;
  }
  return 0;
}

pub fn t_call(inout st: [i64], op: [i64], inout bv: [i64], inout fx: [i64], inout out: [i64]) -> i64 ! alloc, io
{
  if !crate::bud_store::valid(st) { return 2; }
  let e1: i64 = crate::bud_keys::rec_end(op, 14);
  if e1 < 0 { return 2; }
  let e2: i64 = crate::bud_keys::rec_end(op, e1);
  if e2 < 0 { return 2; }
  let e3: i64 = crate::bud_keys::rec_end(op, e2);
  if e3 < 0 { return 2; }
  if e3 != len(op) { return 2; }
  let code: i64 = rd(op, 0);
  let now: i64 = rd(op, 1);
  let flag: i64 = rd(op, 13);
  let sn: i64 = rd(op, 14);
  let bn: i64 = rd(op, e1);
  let rn: i64 = rd(op, e2);
  let bs: i64 = e1 + 1;
  if code == 1 { return crate::bud_lifecycle::current(st, op, 15, sn, op, bs, bn, inout out); }
  if code == 2 { return crate::bud_lifecycle::is_halted(st, op, 15, sn, op, bs, bn, inout out); }
  if code == 5 { return crate::bud_lifecycle::reopen(inout st, op, 15, sn, op, bs, bn, inout fx, inout out); }
  if code == 6 { return crate::bud_lifecycle::maybe_close(inout st, op, 15, sn, now, inout bv, inout fx, inout out); }
  if code == 7 { return charge(inout st, op, sn, bs, bn, now, inout bv, inout fx, inout out); }
  if code >= 8 && code <= 11 { return run_op(inout st, op, code, sn, bs, bn, e2 + 1, rn, flag, now, inout bv, inout fx, inout out); }
  if code == 13 { return crate::bud_decide::raise(inout st, op, 15, sn, op, bs, bn, flag, now, inout bv, inout fx, inout out); }
  if code == 14 { return crate::bud_decide::decide(inout st, op, 15, sn, op, bs, bn, flag == -1, flag, now, inout bv, inout fx, inout out); }
  if code == 12 {
    if len(out) < 1 { return 3; }
    let h: i64 = crate::bud_halt::halt(inout st, op, 15, sn, op, bs, bn, flag, now, inout bv, inout fx);
    if h != 0 { return h; }
    wr(inout out, 0, 0);
    return 0;
  }
  return 2;
}

// Session blob read for the observation: [0] absent, or [1, n, words...].
pub fn t_get(st: [i64], op: [i64], inout out: [i64]) -> i64
{
  if !crate::bud_store::valid(st) { return 2; }
  let e1: i64 = crate::bud_keys::rec_end(op, 0);
  if e1 < 0 { return 2; }
  let kn: i64 = crate::ent_u16::rd(op, 0);
  return crate::bud_world::session_get(st, op, 1, kn, inout out);
}

pub fn t_observe(st: [i64], inout out: [i64]) -> i64
{
  if !crate::bud_store::valid(st) { return 2; }
  return crate::bud_world::observe(st, inout out);
}
