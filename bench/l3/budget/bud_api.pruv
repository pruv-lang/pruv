// status encoding: a rejection is -(100*class + reason)
pub fn reject(class: i64, reason: i64) -> i64
  requires 0 <= class && class <= 9 && 0 <= reason && reason <= 99
  ensures result == -(100 * class + reason)
{
  return -(100 * class + reason);
}
