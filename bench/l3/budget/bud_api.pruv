// L3-10 M3: public constants of the request-budget test encoding (CONTRACT.md, section M3).
// Every constant is a pub fn returning a literal, so the verifier knows its value from the `ensures`.
// No `mod` lines: this file is found as a library module and named crate::bud_api::x.

// ---- magic numbers and limits ----
pub fn magic_call() -> i64 ensures result == 1112884291 { return 1112884291; }     // 0x42554443
pub fn magic_resume() -> i64 ensures result == 1112884306 { return 1112884306; }   // 0x42554452
pub fn magic_out() -> i64 ensures result == 1112884303 { return 1112884303; }      // 0x4255444F
pub fn version() -> i64 ensures result == 1 { return 1; }
