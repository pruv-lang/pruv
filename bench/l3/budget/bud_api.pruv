pub fn max_depth() -> i64 ensures result == 32 { return 32; }
pub fn max_argc() -> i64 ensures result == 8 { return 8; }
pub fn max_effect_argc() -> i64 ensures result == 4 { return 4; }
pub fn max_unit() -> i64 ensures result == 65535 { return 65535; }
pub fn uuid_units() -> i64 ensures result == 36 { return 36; }

