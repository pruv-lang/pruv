// L3-10 M9: the run clock (spec §5.1-§5.7, §8.1). Run methods (runStarted / runWaiting / runEnded) and the clock
// sub-operations REFRESH, BEGIN, ARM, SETTLE, FIRE, DROP, CLOSE as named entries for lifecycle (M7) and halt/decide
// (M10). Interface and frames: bench/l3/budget/M9_NOTES.md, section "Sub-operation interface".
//
// Clock state lives in the bud_map world (root 1 = clocks keyed by budgetId, blob = owning sessionId as a framed
// packed key `n, words(n) packed words`, the same format bud_world::clock_put stores and owner_n / emit_owner read):
//   field 14 since-present (0/1), 15 since (ms), 16 armed (0/1: a timer is requested and not yet cleared or
//   delivered), 17 active runs (the number of runs with waiting = 0, kept by the run methods; REFRESH reads it
//   instead of scanning the runs).
// Runs are children of the clock entry keyed by runKey; field 14 = waiting (0/1). Runs change only through
// run_started / run_waiting / run_ended (and DROP, which removes the clock), so field 17 stays exact.
//
// Budget view frame `bv` (inout, the caller's budget record until the M7 record exists):
//   bv[0] current (1 when CURRENT(ref) found this budget, else 0), bv[1] state (0 open, 1 halted, 2 closed),
//   bv[2] unlimited (1 true), bv[3] limits.timeMinutes, bv[4] used.activeMs,
//   bv[5] activeSince (0 absent, 1 a persisted value the clock has not touched, 2 = ISO(bv[6]) set by BEGIN),
//   bv[6] since ms for bv[5] == 2.
// The caller formats activeSince text with bud_date when it writes the record back.
//
// Effect frame `fx` (inout): fx[0] = words used, records appended after it in order:
//   [12, requested delay, effective delay] timerSet(budgetId)   (effective = 1 when requested > 2147483647)
//   [13]                                   timerClear(budgetId)   cancel the budget's timer
//   [14]                                   timerForget(budgetId)  the budget no longer owns its timer; it stays
//                                          scheduled and runs FIRE with its captured ref when it elapses (FIRE only)
// The budgetId of every record is the addressed budget. One public sub-operation appends at most 4 words; it
// returns 3 without any write unless fx[0] + 5 <= len(fx).
//
// Status of every public entry: 0 done, 4 done + HALT_TIME (the caller must run halt(ref, 'time'); SETTLE already
// ran), 2 invalid (corrupt state), 3 fx too small, -N Grow(N) (nothing written; grow the buffer and retry).
// Keys are packed (bud_keys): (array, start, unit count n) names the words(n) packed words at array[start ..], canonical
// (validated by the caller with bud_keys::rec_end / slice_ok at ingress). run_started also needs the sessionId FRAMED:
// sk[ss - 1] == sn, because the frame `sn, words...` is stored as the clock's owner blob (status 2 otherwise).

//
// Proven indexing (P22, P13e): every clock and run access goes through one value-record base from bud_store::xb
// (reads) or bud_store::xbm (writes; it creates the record when the entry has none), whose ensures gives
// 16 <= x && x + 7 <= len(st); the words are then read and written as st[x + k] with no further check (k = field - 11:
// x + 0 child count, x + 1 / x + 2 blob off / len, x + 3 .. x + 6 fields 14..17). The base is -1 only for an entry
// outside the capacity or the buffer (never a live entry of a valid store); such an entry is treated as absent. The budget view frame needs len(bv) >= 7: every public entry that takes bv tests it (after the fx
// room check) before any write and returns 0 with nothing changed on a shorter frame. The active count (field 17, I2) is only a number here: no
// access depends on it, and I2 is checked by the functional model test of m9_test (t_i2), never assumed by a proof.

// x clamped into -2^53..2^53 (every clock number is a JS safe integer in the domain)
fn sc(x: i64) -> i64
  ensures -9007199254740992 <= result && result <= 9007199254740992
{
  if x < -9007199254740992 { return -9007199254740992; }
  if x > 9007199254740992 { return 9007199254740992; }
  return x;
}

// Adds d to the active-run count of the clock at base ca, clamped at 0; no other word changes.
fn add_active(inout st: [i64], ca: i64, d: i64) -> ()
  requires 16 <= ca && ca + 7 <= len(st) && -1 <= d && d <= 1
  ensures len(st) == len(old(st))
  ensures 0 <= st[ca + 6] && st[ca + 6] <= 4294967297
  ensures (0 <= old(st)[ca + 6] && old(st)[ca + 6] <= 4294967296 && 0 <= old(st)[ca + 6] + d) ==> st[ca + 6] == old(st)[ca + 6] + d
  ensures forall k in 0..len(st): k == ca + 6 || st[k] == old(st)[k]
{
  let mut n: i64 = crate::bud_store::c32(st[ca + 6]) + d;
  if n < 0 { n = 0; }
  st[ca + 6] = n;
}

// limits.timeMinutes * 60000 with timeMinutes clamped into -150000000000000..150000000000000 (product at most 9e18,
// and limit - activeMs stays inside i64 for activeMs in -2^53..2^53). Below the clamp the limit and every delay
// limit - activeMs are exact, so each delay that is a JS safe integer equals the source's; a clamped limit leaves a
// delay above 9e18 - 2^53 (no safe integer, effective delay 1 like the source's), and the halt and re-arm decisions
// (activeMs against the limit) are the same.
fn limit_ms(bv: [i64]) -> i64
  requires len(bv) >= 7
  ensures -9000000000000000000 <= result && result <= 9000000000000000000
{
  let mut t: i64 = bv[3];
  if t < -150000000000000 { t = -150000000000000; }
  if t > 150000000000000 { t = 150000000000000; }
  return t * 60000;
}

// ---- effect frame ----

pub fn fx_ok(fx: [i64]) -> bool
{
  if len(fx) < 1 { return false; }
  return crate::bud_store::c40(fx[0]) + 5 <= len(fx);
}

// Appends one word when it fits (always inside a public entry: fx_ok leaves room for 5).
fn push(inout fx: [i64], v: i64) -> ()
  ensures len(fx) == len(old(fx))
{
  if len(fx) < 1 { return; }
  let p: i64 = crate::bud_store::c40(fx[0]);
  if p + 1 >= len(fx) { return; }
  fx[p + 1] = v;
  fx[0] = p + 1;
}

// Appends a three-word record when it fits, else nothing (one room check for the timerSet record).
fn push3(inout fx: [i64], a: i64, b: i64, c: i64) -> ()
  ensures len(fx) == len(old(fx))
{
  if len(fx) < 1 { return; }
  let p: i64 = crate::bud_store::c40(fx[0]);
  if p + 3 >= len(fx) { return; }
  fx[p + 1] = a;
  fx[p + 2] = b;
  fx[p + 3] = c;
  fx[0] = p + 3;
}

fn grow_status(n: i64) -> i64
{
  return 0 - crate::bud_store::c40(n);
}

// ---- lookups ----

// Clock entry of the budget, or -1.
pub fn clock_of(st: [i64], bk: [i64], bs: i64, bn: i64) -> i64
{ return crate::bud_map::find_w(st, 1, bk, bs, bn); }

// Unit count of the framed owner key stored as the blob of the clock at base ca: blob word 0 when the blob is exactly
// 1 + words(n) words, else 0 (a corrupt blob names the empty key; same rule as bud_world::owner_n).
fn owner_len(st: [i64], ca: i64) -> i64
  requires 16 <= ca && ca + 7 <= len(st)
  ensures 0 <= result && result <= 1073741824
{
  let bl: i64 = crate::bud_store::c40(st[ca + 2]);
  if bl < 1 { return 0; }
  let n: i64 = crate::ent_u16::rd(st, crate::bud_store::c40(st[ca + 1]));
  if n < 0 || n > 1073741824 { return 0; }
  if crate::bud_keys::words(n) != bl - 1 { return 0; }
  return n;
}

// Copies the owning sessionId of the budget's clock into dst (from 0) as units and returns its unit count; -1 without
// a clock. (Observation helper. FIRE takes the ref its timer captured from the host, not this owner.)
pub fn clock_owner(st: [i64], bk: [i64], bs: i64, bn: i64, inout dst: [i64]) -> i64
{
  let ce: i64 = clock_of(st, bk, bs, bn);
  if ce < 0 { return -1; }
  let ca: i64 = crate::bud_store::xb(st, ce);
  let mut n: i64 = 0;
  if ca >= 0 { n = owner_len(st, ca); }
  let ko: i64 = crate::bud_map::blob_off(st, ce) + 1;
  let mut j: i64 = 0;
  while j < n
    invariant 0 <= j && j <= n && n <= 1073741824
    decreases n - j
  {
    crate::ent_u16::wr(inout dst, j, crate::bud_keys::unit(st, ko, n, j));
    j = j + 1;
  }
  return n;
}

// 1 when the budget's clock owns an armed timer, else 0 (observation; FIRE does not use it, see fire_at).
pub fn armed(st: [i64], bk: [i64], bs: i64, bn: i64) -> i64
{
  let ce: i64 = clock_of(st, bk, bs, bn);
  if ce < 0 { return 0; }
  if crate::bud_store::ef(st, ce, 16) == 1 { return 1; }
  return 0;
}

// Does the clock's owner blob (framed packed key `n, words(n)`) equal the packed sessionId key (sk, ss, sn)?
// Blob length 1 + words(sn), frame word sn, then the words(sn) words: one slice compare when both ranges are inside
// their buffers, a per-word total compare otherwise (both read the same words). Equal n and equal words are equal
// units (one encoding per key).
fn owner_is(st: [i64], ca: i64, sk: [i64], ss: i64, sn: i64) -> bool
  requires 16 <= ca && ca + 7 <= len(st)
{
  if sn < 0 || sn > 1073741824 { return false; }
  if ss < 0 || ss > 1099511627776 { return false; }
  let m: i64 = crate::bud_keys::words(sn);
  if crate::bud_store::c40(st[ca + 2]) != 1 + m { return false; }
  let off: i64 = crate::bud_store::c40(st[ca + 1]);
  if crate::ent_u16::rd(st, off) != sn { return false; }
  if off + 1 + m <= len(st) && ss + m <= len(sk) {
    // eq_range obligations: off + 1 >= 0, ss >= 0, m >= 0, both ranges in bounds
    return eq_range(st, off + 1, sk, ss, m);
  }
  let mut j: i64 = 0;
  while j < m
    invariant 0 <= j && j <= m && m <= 268435456 && 0 <= off && off <= 1099511627776 && 0 <= ss && ss <= 1099511627776
    decreases m - j
  {
    if crate::ent_u16::rd(st, off + 1 + j) != crate::ent_u16::rd(sk, ss + j) { return false; }
    j = j + 1;
  }
  return true;
}

// ---- sub-operations on a clock at base ca (proven range, len(bv) >= 7) ----

// SETTLE (§5.4): adds the open consuming interval to used.activeMs, clears the timer. Returns the added ms.
fn settle_in(inout st: [i64], ca: i64, sk: [i64], ss: i64, sn: i64, now: i64, inout bv: [i64], inout fx: [i64]) -> i64
  requires 16 <= ca && ca + 7 <= len(st) && len(bv) >= 7
  ensures len(st) == len(old(st)) && len(bv) == len(old(bv)) && len(fx) == len(old(fx))
{
  if !owner_is(st, ca, sk, ss, sn) { return 0; }
  if st[ca + 5] == 1 { push(inout fx, 13); }
  st[ca + 5] = 0;
  if st[ca + 3] != 1 { return 0; }
  let mut added: i64 = sc(now) - sc(st[ca + 4]);
  if added < 0 { added = 0; }
  st[ca + 3] = 0;
  st[ca + 4] = 0;
  bv[5] = 0;
  bv[6] = 0;
  bv[4] = sc(sc(bv[4]) + added);
  return added;
}

// BEGIN (§5.2): opens a consuming interval at now.
fn begin_in(inout st: [i64], ca: i64, now: i64, inout bv: [i64]) -> ()
  requires 16 <= ca && ca + 7 <= len(st) && len(bv) >= 7
  ensures len(st) == len(old(st)) && len(bv) == len(old(bv))
{
  let t: i64 = sc(now);
  st[ca + 3] = 1;
  st[ca + 4] = t;
  bv[5] = 2;
  bv[6] = t;
}

// ARM (§5.3). Nonpositive left: the source's synchronous FIRE right after BEGIN always ends in SETTLE (adding 0)
// followed by halt(ref, 'time') because activeMs >= limit; that is what this returns (status 4).
fn arm_in(inout st: [i64], ca: i64, sk: [i64], ss: i64, sn: i64, now: i64, inout bv: [i64], inout fx: [i64]) -> i64
  requires 16 <= ca && ca + 7 <= len(st) && len(bv) >= 7
  ensures len(st) == len(old(st)) && len(bv) == len(old(bv)) && len(fx) == len(old(fx))
{
  if bv[2] == 1 { return 0; }
  let left: i64 = limit_ms(bv) - sc(bv[4]);
  if left <= 0 {
    st[ca + 5] = 0;
    let a: i64 = settle_in(inout st, ca, sk, ss, sn, now, inout bv, inout fx);
    return 4;
  }
  let mut eff: i64 = left;
  if left > 2147483647 { eff = 1; }
  push3(inout fx, 12, left, eff);
  st[ca + 5] = 1;
  return 0;
}

// REFRESH (§5.1): reacts only when the consuming predicate differs from since-present. "Some run is not waiting"
// is the active-run count (field 17) > 0, which the run methods keep equal to that predicate (I2, tested by t_i2).
fn refresh_in(inout st: [i64], ca: i64, sk: [i64], ss: i64, sn: i64, now: i64, inout bv: [i64], inout fx: [i64]) -> i64
  requires 16 <= ca && ca + 7 <= len(st) && len(bv) >= 7
  ensures len(st) == len(old(st)) && len(bv) == len(old(bv)) && len(fx) == len(old(fx))
{
  if bv[0] != 1 { return 0; }
  let consuming: bool = bv[1] == 0 && st[ca + 6] > 0;
  let has: bool = st[ca + 3] == 1;
  if consuming == has { return 0; }
  if !consuming {
    let a: i64 = settle_in(inout st, ca, sk, ss, sn, now, inout bv, inout fx);
    return 0;
  }
  begin_in(inout st, ca, now, inout bv);
  return arm_in(inout st, ca, sk, ss, sn, now, inout bv, inout fx);
}

// ---- sub-operations on a clock entry (ce from clock_of; -1 = no clock) ----
// arm_at, refresh_at and fire_at (which may append a 3-word timerSet record) return 3 without any write unless
// fx_ok(fx). settle_at (returns the added ms) and drop_at (no status) append at most one word and need the caller's
// fx_ok check (bud_lifecycle and the by-key entries make it before the call); without room they drop the record.

pub fn settle_at(inout st: [i64], ce: i64, sk: [i64], ss: i64, sn: i64, now: i64, inout bv: [i64], inout fx: [i64]) -> i64
{
  if len(bv) < 7 { return 0; }
  let ca: i64 = crate::bud_store::xbm(inout st, ce);
  if ca < 0 { return 0; }
  return settle_in(inout st, ca, sk, ss, sn, now, inout bv, inout fx);
}

pub fn begin_at(inout st: [i64], ce: i64, now: i64, inout bv: [i64]) -> ()
{
  if len(bv) < 7 { return; }
  let ca: i64 = crate::bud_store::xbm(inout st, ce);
  if ca < 0 { return; }
  begin_in(inout st, ca, now, inout bv);
}

pub fn arm_at(inout st: [i64], ce: i64, sk: [i64], ss: i64, sn: i64, now: i64, inout bv: [i64], inout fx: [i64]) -> i64
{
  if !fx_ok(fx) { return 3; }
  if len(bv) < 7 { return 0; }
  let ca: i64 = crate::bud_store::xbm(inout st, ce);
  if ca < 0 { return 0; }
  return arm_in(inout st, ca, sk, ss, sn, now, inout bv, inout fx);
}

pub fn refresh_at(inout st: [i64], ce: i64, sk: [i64], ss: i64, sn: i64, now: i64, inout bv: [i64], inout fx: [i64]) -> i64
{
  if !fx_ok(fx) { return 3; }
  if len(bv) < 7 || bv[0] != 1 { return 0; }
  let ca: i64 = crate::bud_store::xbm(inout st, ce);
  if ca < 0 { return 0; }
  return refresh_in(inout st, ca, sk, ss, sn, now, inout bv, inout fx);
}

// FIRE (§5.5, §8.1): a timer callback ran with the ref it captured when armed (the host keeps that ref per token).
// Like the source it does not check that the delivered timer is the clock's current one: it forgets the clock's
// timer without cancelling it ([14] timerForget, the timer stays scheduled), then a budget that is no longer
// current, open and limited stops; else SETTLE (a no-op when the clock is gone or owned by another session), then
// re-arm while time is left and the clock has runs (field 11, the child count), or HALT_TIME (also when the clock
// is gone).
pub fn fire_at(inout st: [i64], ce: i64, sk: [i64], ss: i64, sn: i64, now: i64, inout bv: [i64], inout fx: [i64]) -> i64
{
  if !fx_ok(fx) { return 3; }
  if len(bv) < 7 { return 0; }
  let ca: i64 = crate::bud_store::xbm(inout st, ce);
  if ca >= 0 {
    if st[ca + 5] == 1 { push(inout fx, 14); }
    st[ca + 5] = 0;
  }
  if bv[0] != 1 || bv[1] != 0 || bv[2] == 1 { return 0; }
  if ca < 0 { return 4; }
  let a: i64 = settle_in(inout st, ca, sk, ss, sn, now, inout bv, inout fx);
  if sc(bv[4]) < limit_ms(bv) && crate::bud_store::c32(st[ca + 0]) > 0 {
    begin_in(inout st, ca, now, inout bv);
    return arm_in(inout st, ca, sk, ss, sn, now, inout bv, inout fx);
  }
  return 4;
}

// DROP (dropClock): clears an armed timer and removes the clock with its runs.
pub fn drop_at(inout st: [i64], ce: i64, inout fx: [i64]) -> ()
{
  if ce < 0 { return; }
  let ca: i64 = crate::bud_store::xb(st, ce);
  if ca >= 0 {
    if st[ca + 5] == 1 { push(inout fx, 13); }
  }
  crate::bud_map::remove(inout st, ce);
}

// ---- public entries by key ----

pub fn refresh(inout st: [i64], bk: [i64], bs: i64, bn: i64, sk: [i64], ss: i64, sn: i64, now: i64, inout bv: [i64], inout fx: [i64]) -> i64
{
  let ce: i64 = clock_of(st, bk, bs, bn);
  return refresh_at(inout st, ce, sk, ss, sn, now, inout bv, inout fx);
}

pub fn settle(inout st: [i64], bk: [i64], bs: i64, bn: i64, sk: [i64], ss: i64, sn: i64, now: i64, inout bv: [i64], inout fx: [i64]) -> i64
{
  if !fx_ok(fx) { return 3; }
  let ce: i64 = clock_of(st, bk, bs, bn);
  let a: i64 = settle_at(inout st, ce, sk, ss, sn, now, inout bv, inout fx);
  return 0;
}

pub fn fire(inout st: [i64], bk: [i64], bs: i64, bn: i64, sk: [i64], ss: i64, sn: i64, now: i64, inout bv: [i64], inout fx: [i64]) -> i64
{
  let ce: i64 = clock_of(st, bk, bs, bn);
  return fire_at(inout st, ce, sk, ss, sn, now, inout bv, inout fx);
}

pub fn drop(inout st: [i64], bk: [i64], bs: i64, bn: i64, inout fx: [i64]) -> i64
{
  if !fx_ok(fx) { return 3; }
  let ce: i64 = clock_of(st, bk, bs, bn);
  drop_at(inout st, ce, inout fx);
  return 0;
}

// CLOSE, clock part (§5.7): SETTLE, state closed, DROP. The caller writes `ended` and saves.
pub fn close(inout st: [i64], bk: [i64], bs: i64, bn: i64, sk: [i64], ss: i64, sn: i64, now: i64, inout bv: [i64], inout fx: [i64]) -> i64
{
  if !fx_ok(fx) { return 3; }
  if len(bv) < 7 { return 0; }
  let ce: i64 = clock_of(st, bk, bs, bn);
  let a: i64 = settle_at(inout st, ce, sk, ss, sn, now, inout bv, inout fx);
  bv[1] = 2;
  drop_at(inout st, ce, inout fx);
  return 0;
}

// runStarted (B:286): needs CURRENT(ref); creates the clock (owner = ref.sessionId) and the run if missing, sets the
// run not waiting, then REFRESH. Space for both entries is reserved before the first write. The sessionId must be
// framed (sk[ss - 1] == sn): the frame is the owner blob of a new clock (checked before anything is written; 2).
pub fn run_started(inout st: [i64], bk: [i64], bs: i64, bn: i64, sk: [i64], ss: i64, sn: i64, rk: [i64], rs: i64, rn: i64, now: i64, inout bv: [i64], inout fx: [i64]) -> i64
{
  if !fx_ok(fx) { return 3; }
  if len(bv) < 7 { return 0; }
  if bv[0] != 1 { return 0; }
  let ce0: i64 = clock_of(st, bk, bs, bn);
  let mut re: i64 = -1;
  let mut ents: i64 = 0;
  let mut words: i64 = 0;
  if ce0 < 0 {
    if ss < 1 || ss > len(sk) { return 2; }
    if sk[ss - 1] != sn { return 2; }
    ents = 2;
    // packed key words of the clock and the run, plus the framed owner blob
    words = crate::bud_keys::words(bn) + 1 + crate::bud_keys::words(sn) + crate::bud_keys::words(rn);
  } else {
    re = crate::bud_map::find_w(st, ce0, rk, rs, rn);
    if re < 0 {
      ents = 1;
      words = crate::bud_keys::words(rn);
    }
  }
  if ents > 0 {
    let nd: i64 = crate::bud_map::make_room(inout st, ents, words);
    if nd != 0 { return grow_status(nd); }
  }
  let mut ce: i64 = ce0;
  if ce < 0 {
    ce = crate::bud_map::add_w(inout st, 1, bk, bs, bn);
    if ce < 0 { return 2; }
    let r: i64 = crate::bud_map::set_blob(inout st, ce, sk, ss - 1, 1 + crate::bud_keys::words(sn));
    if r < 0 { return 2; }
  }
  // The run is absent exactly when ents > 0 (a new clock has no runs), so it is added without a second lookup;
  // make_room keeps entry numbers, so a run found before it stays valid.
  let mut became: bool = false;
  if re < 0 {
    re = crate::bud_map::add_w(inout st, ce, rk, rs, rn);
    if re < 0 { return 2; }
    became = true;
  }
  let ra: i64 = crate::bud_store::xbm(inout st, re);
  if ra >= 0 {
    if st[ra + 3] == 1 { became = true; }
    st[ra + 3] = 0;
  }
  let ca: i64 = crate::bud_store::xbm(inout st, ce);
  if ca < 0 { return 0; }
  if became { add_active(inout st, ca, 1); }
  return refresh_in(inout st, ca, sk, ss, sn, now, inout bv, inout fx);
}

// runWaiting (B:292): no CURRENT check before the run update (a stale ref still flips the run; its REFRESH then
// stops at CURRENT, §15.1). Unchanged waiting returns without REFRESH.
pub fn run_waiting(inout st: [i64], bk: [i64], bs: i64, bn: i64, sk: [i64], ss: i64, sn: i64, rk: [i64], rs: i64, rn: i64, waiting: bool, now: i64, inout bv: [i64], inout fx: [i64]) -> i64
{
  if !fx_ok(fx) { return 3; }
  if len(bv) < 7 { return 0; }
  let ce: i64 = clock_of(st, bk, bs, bn);
  if ce < 0 { return 0; }
  let re: i64 = crate::bud_map::find_w(st, ce, rk, rs, rn);
  if re < 0 { return 0; }
  let ra: i64 = crate::bud_store::xbm(inout st, re);
  let mut was: bool = false;
  if ra >= 0 { was = st[ra + 3] == 1; }
  if was == waiting { return 0; }
  let mut w: i64 = 0;
  let mut d: i64 = 1;
  if waiting { w = 1; d = -1; }
  if ra >= 0 { st[ra + 3] = w; }
  let ca: i64 = crate::bud_store::xbm(inout st, ce);
  if ca < 0 { return 0; }
  add_active(inout st, ca, d);
  return refresh_in(inout st, ca, sk, ss, sn, now, inout bv, inout fx);
}

// runEnded (B:299): removes the run; REFRESH only when a run was removed. bud_map::remove keeps the length and never
// writes header word 5, so the clock base found before it is the clock's base after it.
pub fn run_ended(inout st: [i64], bk: [i64], bs: i64, bn: i64, sk: [i64], ss: i64, sn: i64, rk: [i64], rs: i64, rn: i64, now: i64, inout bv: [i64], inout fx: [i64]) -> i64
{
  if !fx_ok(fx) { return 3; }
  if len(bv) < 7 { return 0; }
  let ce: i64 = clock_of(st, bk, bs, bn);
  if ce < 0 { return 0; }
  let re: i64 = crate::bud_map::find_w(st, ce, rk, rs, rn);
  if re < 0 { return 0; }
  let ca: i64 = crate::bud_store::xbm(inout st, ce);
  let ra: i64 = crate::bud_store::xb(st, re);
  let mut w: i64 = -1;
  if ra >= 0 { w = st[ra + 3]; }
  if ca >= 0 && w != 1 { add_active(inout st, ca, -1); }
  crate::bud_map::remove(inout st, re);
  if ca < 0 { return 0; }
  return refresh_in(inout st, ca, sk, ss, sn, now, inout bv, inout fx);
}
