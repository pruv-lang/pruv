trusted rust fn unit_at(position: i64, i: i64) -> i64 ! io
  ensures true = "::decide_facts::unit_at";

trusted rust fn release_held(sid: str, bid: str, position: i64) -> i64 ! io
  ensures true = "::decide_facts::release_held_text";

pub fn scaled(value: i64, size: i64) -> i64
  requires 1 <= size && size <= 8
  ensures result == -1 || (0 <= result && result <= 9007199254740991)
{
  if value < 0 || value > 9007199254740991 / size { return -1; }
  if value > 9007199254740991 { return -1; }
  let total: i64 = value * size;
  if total > 9007199254740991 { return -1; }
  return total;
}

pub fn next_limit(current: i64, amount: i64, extend: bool) -> i64
{
  if amount < 0 || amount > 9007199254740991 { return -1; }
  if !extend {
    if current > amount { return current; }
    return amount;
  }
  if current < 0 || current > 9007199254740991 - amount { return -1; }
  return current + amount;
}

// Limit changes are validated in full before any field is updated.
pub fn apply_limits(inout b: crate::bud_tstate::Budget, size: i64, extend: bool, position: i64) -> i64 ! io
{
  if size == 0 {
    if b.unlimited && !extend { return 0; }
    b.unlimited = true;
    b.unlimited_kind = 1;
    return 1;
  }
  if size != 1 && size != 2 && size != 4 && size != 8 { return -1; }
  if !extend && size == 1 { return 0; }
  if unit_at(position, 0) != 0 { return -1; }
  let time: i64 = next_limit(b.limits.time, scaled(unit_at(position, 1), size), extend);
  let delegations: i64 = next_limit(b.limits.delegations, scaled(unit_at(position, 2), size), extend);
  let commands: i64 = next_limit(b.limits.commands, scaled(unit_at(position, 3), size), extend);
  let reviews: i64 = next_limit(b.limits.reviews, scaled(unit_at(position, 4), size), extend);
  let checks: i64 = next_limit(b.limits.checks, scaled(unit_at(position, 5), size), extend);
  if time < 0 || delegations < 0 || commands < 0 || reviews < 0 || checks < 0 { return -1; }
  if !extend && time == b.limits.time && delegations == b.limits.delegations && commands == b.limits.commands && reviews == b.limits.reviews && checks == b.limits.checks { return 0; }
  let grew_time: bool = time > b.limits.time;
  b.limits = crate::bud_tstate::Limits { time: time, delegations: delegations, commands: commands, reviews: reviews, checks: checks };
  if grew_time { return 2; }
  return 1;
}

pub fn raise(inout sessions: HashMap<String, crate::bud_tstate::Budget>,
        inout clocks: HashMap<String, crate::bud_tstate::Clock>,
        inout out: crate::bud_tstate::Out,
        sid: str, bid: str, now: i64, flag: i64) -> crate::bud_tstate::Reply ! alloc, io
{
  let mut reply: crate::bud_tstate::Reply = crate::bud_tstate::Reply { status: 0, value: 1, a: 0, b: 0 };
  match map_get_mut::<String, crate::bud_tstate::Budget>(inout sessions, sid) {
    Some(b) => {
      if b.state >= 0 && b.state != 2 && string_eq(b.id, bid) {
        let changed: i64 = apply_limits(inout b, flag, false, len(out.fx));
        if changed < 0 { reply.status = 2; }
        if changed > 0 {
          match map_get_mut::<String, crate::bud_tstate::Clock>(inout clocks, bid) {
            Some(c) => {
              if flag == 0 { crate::bud_tstate::disarm(inout c, inout out); }
              else if changed == 2 && !b.unlimited && c.has_since {
                crate::bud_tstate::settle(inout b, inout c, sid, now, inout out);
                let status: i64 = crate::bud_tlife::refresh(inout b, inout c, sid, bid, now, inout out); reply.status = status;
              }
            }
            None => { }
          }
          if reply.status == 0 { crate::bud_tstate::emit(inout out, 20, 0, 0); reply.value = 2; }
        }
      }
    }
    None => { }
  }
  return reply;
}

pub fn decide(inout sessions: HashMap<String, crate::bud_tstate::Budget>,
        inout clocks: HashMap<String, crate::bud_tstate::Clock>,
        inout out: crate::bud_tstate::Out,
        sid: str, bid: str, now: i64, flag: i64) -> crate::bud_tstate::Reply ! alloc, io
{
  let mut reply: crate::bud_tstate::Reply = crate::bud_tstate::Reply { status: 0, value: 6, a: 1, b: 0 };
  let mut drop_clock: bool = false;
  match map_get_mut::<String, crate::bud_tstate::Budget>(inout sessions, sid) {
    Some(b) => {
      if b.state >= 0 && string_eq(b.id, bid) {
        reply.a = 2;
        if b.state == 1 && flag == -1 {
          match map_get_mut::<String, crate::bud_tstate::Clock>(inout clocks, bid) {
            Some(c) => {
              crate::bud_tstate::settle(inout b, inout c, sid, now, inout out);
              crate::bud_tstate::disarm(inout c, inout out);
            }
            None => { }
          }
          crate::bud_tstate::closed(inout b, 2, now);
          drop_clock = true;
          crate::bud_tstate::emit(inout out, 39, 0, 0);
          crate::bud_tstate::emit(inout out, 36, 0, 0);
          crate::bud_tstate::emit(inout out, 20, 0, 0);
          reply.a = 0;
        } else if b.state == 1 {
          let changed: i64 = apply_limits(inout b, flag, true, len(out.fx));
          if changed < 0 { reply.status = 2; }
          else {
            let reason: i64 = b.halt_reason;
            b.state = 0;
            b.halt_reason = -1;
            b.halt_kind = 0;
            b.halt_ms = 0;
            b.halt_text = string_new();
            vec_clear::<String>(inout b.stopped);
            crate::bud_tstate::emit(inout out, 36, 0, 0);
            crate::bud_tstate::emit(inout out, 20, 0, 0);
            match map_get_mut::<String, crate::bud_tstate::Clock>(inout clocks, bid) {
              Some(c) => { let status: i64 = crate::bud_tlife::refresh(inout b, inout c, sid, bid, now, inout out); reply.status = status; }
              None => { }
            }
            if reply.status == 0 {
              if reason >= 0 { crate::bud_tstate::emit(inout out, 38, reason, 0); }
              let held: i64 = release_held(sid, bid, len(out.fx));
              if held == 0 { crate::bud_tstate::emit(inout out, 38, -1, 1); }
              else if held != 1 { reply.status = 2; }
              reply.a = 0;
            }
          }
        }
      }
    }
    None => { }
  }
  if drop_clock { let removed: bool = map_remove::<String, crate::bud_tstate::Clock>(inout clocks, bid); }
  return reply;
}
