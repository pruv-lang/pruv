// L3-10 M7: budget lifecycle (spec §5.1-5.5, §5.7 CLOSE, §5.8 maybeClose; B:169-242, B:399-408).
// current, isHalted, attach (OPEN), replaceForUserMessage, reopen, CLOSE (lifecycle part), maybeClose.
//
// Budget record = the blob of the session entry (bud_world root 0). Layout (words):
//   header (24): 0 state (-1 = the session has no budget, blob is just [-1]; 0 open, 1 halted, 2 closed)
//                1 origin (0 user, 1 schedule, 2 direct, 3 release)
//                2 unlimited (0 key absent, 1 true, 2 key present with a non-true value, kept as stored)
//                3..7 limits (timeMinutes, delegations, commands, reviews, checks)
//                8..15 used (activeMs, delegations, commands, reviews, checks, tools, failures, retries)
//                16 activeSince kind (0 absent, 1 stored text, 2 instant in word 17), 17 activeSince ms
//                18 ended.how (0 no ended, 1 quiet, 2 user-end, 3 user-message)
//                19 ended.at kind (1 stored text, 2 instant in word 22)
//                20 openedAt kind (1 stored text, 2 instant in word 21), 21 openedAt ms, 22 ended.at ms
//                23 follows (0 key absent, 1 string, 2 key present with a non-string value, kept as stored)
//   then six strings: 0 id, 1 openedAt text, 2 activeSince text, 3 ended.at text, 4 follows, 5 rest (the other budget
//   properties - halt, card, autoContinue, ... - as an opaque unit string this module never reads; it is kept on every
//   in-place change and dropped when OPEN replaces the budget).
//   Strings 0 (id) and 4 (follows) are budget ids used as lookup keys (clock map, CURRENT compare, the next record's
//   follows), so they are stored as framed PACKED keys `n, words(n) packed words` (bud_keys layout: n units, four
//   big-endian lanes per word, tail lanes zero): a lookup or compare reads them in place with no re-packing.
//   Strings 1, 2, 3, 5 are plain text and stay `len, units` (one unit per word). The stride of string i is therefore
//   1 + str_words(i, len) (str_at / str_len_in).
// Keys passed in (sessionId, budgetId, uuid) are packed: (array, start, unit count n) names words(n) packed words,
// canonical (the caller validated them with bud_keys::rec_end / slice_ok at ingress).
// Instants this module writes are stored as numbers (kind 2); formatting them with toISOString is left to the
// boundary that renders the record (same choice as bud_clock's activeSince).
//
// Results are written to `out`: out[0] = 0 undefined, 1 false, 2 true, 3 ref (out[1] = budgetId length, units
// follow - unpacked from the packed id; the sessionId of the ref is the session argument), 4 budget view (out[1] = record length n, out[2] = its
// arena offset: the record is st[out[2] .. out[2] + n), valid until the next call that changes st - the counterpart
// of returning a reference to the stored budget, nothing is copied).
// A carryHeld effect puts the old budgetId after the ref: out[2 + len] = old length, units follow (unpacked).
// Effects are appended to `fx` (bud_clock frame, fx[0] = words used): bud_clock's [13] timerClear, and
//   [20] changed, [21] carryHeld (args: session, old id in out, the returned ref), [22] uuid (one id consumed),
//   [23] isQuiet consulted (maybeClose used the host's `quiet` input; it is always the first effect of the call).
// The host supplies the next isQuiet answer up front (like the next randomUUID value); it is consumed only when the
// effects hold [23], so the host still decides nothing.
// Status: 0 done, 2 invalid, 3 out/fx too small, 5 Need isQuiet (only when `quiet` is -1: nothing written; the host
// answers through the `quiet` argument of the retried call), -N Grow (nothing written).

fn rd(a: [i64], i: i64) -> i64
{ return crate::ent_u16::rd(a, i); }

fn c32(x: i64) -> i64
  ensures 0 <= result && result <= 4294967296
{ return crate::bud_store::c32(x); }

fn c40(x: i64) -> i64
  ensures 0 <= result && result <= 1099511627776
{ return crate::bud_store::c40(x); }

pub fn header_words() -> i64
  ensures result == 24
{ return 24; }

fn push(inout fx: [i64], v: i64) -> ()
{
  let p: i64 = c40(rd(fx, 0));
  if p + 1 >= len(fx) { return; }
  crate::ent_u16::wr(inout fx, p + 1, v);
  crate::ent_u16::wr(inout fx, 0, p + 1);
}

// ---- record access ----

// Session entry for the key, -1 if absent.
pub fn session_of(st: [i64], sk: [i64], ss: i64, sn: i64) -> i64
{ return crate::bud_map::find_w(st, 0, sk, ss, sn); }

// Data words of record string i whose length word is l: words(l) for the packed id strings 0 (id) and 4 (follows),
// else l (one unit per word), l clamped into 0..2^32.
pub fn str_words(i: i64, l: i64) -> i64
  ensures 0 <= result && result <= 4294967296
{
  if i == 0 || i == 4 { return crate::bud_keys::words(l); }
  return c32(l);
}

// Field address of session entry se (bud_store::field_addr), -1 if out of range. The blob offset is at a + 12 and
// its length at a + 13; callers read both through one address instead of one field_addr per word.
fn entry_addr(st: [i64], se: i64) -> i64
  ensures result >= -1 && result <= 1099511627776
{
  if se < 0 { return -1; }
  return crate::bud_store::field_addr(st, se);
}

fn at_off(st: [i64], a: i64) -> i64
  ensures 0 <= result && result <= 1099511627776
{
  if a < 0 || a > 1099511627776 { return 0; }
  return c40(rd(st, a + 12));
}

fn at_n(st: [i64], a: i64) -> i64
  ensures 0 <= result && result <= 1099511627776
{
  if a < 0 || a > 1099511627776 { return 0; }
  return c40(rd(st, a + 13));
}

// Arena offset and length of the session's blob.
pub fn blob_at(st: [i64], se: i64) -> i64
  ensures 0 <= result && result <= 1099511627776
{
  let a: i64 = crate::bud_store::field_addr(st, se);
  if a < 0 { return 0; }
  return c40(rd(st, a + 12));
}

pub fn blob_n(st: [i64], se: i64) -> i64
  ensures 0 <= result && result <= 1099511627776
{
  let a: i64 = crate::bud_store::field_addr(st, se);
  if a < 0 { return 0; }
  return c40(rd(st, a + 13));
}

// State word of the session's budget, -1 without a budget (or a blob too short to be a record).
pub fn state_of(st: [i64], off: i64, n: i64) -> i64
  requires 0 <= off && off <= 1099511627776
{
  if n < 30 { return -1; }
  let s: i64 = rd(st, off);
  if s < 0 || s > 2 { return -1; }
  return s;
}

// Does the record's budgetId (string 0: unit count at off + 24, packed words from off + 25) equal the packed key
// (k, ks, kn)? Equal unit counts and equal words(kn) words (one encoding per key). O(words(kn)).
pub fn id_is(st: [i64], off: i64, k: [i64], ks: i64, kn: i64) -> bool
  requires 0 <= off && off <= 1099511627776
{
  if kn < 0 || kn > 1073741824 || ks < 0 || ks > 1099511627776 { return false; }
  if rd(st, off + 24) != kn { return false; }
  let m: i64 = crate::bud_keys::words(kn);
  if off + 25 + m <= len(st) && ks + m <= len(k) {
    // Both ranges in bounds (checked once): one slice compare (memcmp). eq_range obligations: off + 25 >= 0, ks >= 0,
    // m >= 0, both ranges in bounds.
    return eq_range(st, off + 25, k, ks, m);
  }
  let mut j: i64 = 0;
  while j < m
    invariant 0 <= j && j <= m && m <= 268435456 && 0 <= off && off <= 1099511627776 && 0 <= ks && ks <= 1099511627776
    decreases m - j
  {
    if rd(st, off + 25 + j) != rd(k, ks + j) { return false; }
    j = j + 1;
  }
  return true;
}

// id_is for a record whose span st[off .. off + n) is known to lie in st (n >= 30): the id length word is read
// directly, and when the packed id lies inside the record and the key range inside k (one dynamic check each) the
// words are compared by one slice compare. An id whose declared words run past the record falls back to id_is (the
// same total reads as before). The unit-count compare and the word compare are the identity check; only the range
// checks are proved away.
fn id_at(st: [i64], off: i64, n: i64, k: [i64], ks: i64, kn: i64) -> bool
  requires 0 <= off && 30 <= n && off <= len(st) - n
{
  if kn < 0 || kn > 1073741824 || ks < 0 { return false; }
  if st[off + 24] != kn { return false; }
  let m: i64 = crate::bud_keys::words(kn);
  if 25 + m <= n && ks <= len(k) - m {
    return eq_range(st, off + 25, k, ks, m);
  }
  return id_is(st, off, k, ks, kn);
}

// CURRENT(ref) on session entry se: the entry's field address (bud_store::eb, so fields 0..19 lie in st) when the
// session has a budget (state 0..2 in a blob of >= 30 words) whose id is (bk, bs, bn); -1 when it has none or the id
// differs; -2 when the blob span st[off .. off + n) does not lie in st (a store that breaks I1; never for an admitted
// store). After one span check every header and id word is read by proven direct indexing; the state and identity
// checks stay dynamic.
fn found_at(st: [i64], se: i64, bk: [i64], bs: i64, bn: i64) -> i64
  ensures result == -1 || result == -2 || (16 <= result && result + 20 <= len(st) && 0 <= st[result + 12] && 30 <= st[result + 13] && st[result + 12] <= len(st) - st[result + 13] && 0 <= st[st[result + 12]] && st[st[result + 12]] <= 2)
{
  if se < 0 { return -1; }
  let a: i64 = crate::bud_store::eb(st, se);
  if a < 0 { return -1; }
  let off: i64 = st[a + 12];
  let n: i64 = st[a + 13];
  if n < 30 { return -1; }
  if off < 0 || off > len(st) - n { return -2; }
  let s: i64 = st[off];
  if s < 0 || s > 2 { return -1; }
  if !id_at(st, off, n, bk, bs, bn) { return -1; }
  return a;
}

// CURRENT(ref): the budget's session entry when the session has a budget whose id is ref.budgetId, else -1.
pub fn current_entry(st: [i64], sk: [i64], ss: i64, sn: i64, bk: [i64], bs: i64, bn: i64) -> i64
{
  let se: i64 = session_of(st, sk, ss, sn);
  if found_at(st, se, bk, bs, bn) < 0 { return -1; }
  return se;
}

// CURRENT(ref): found_at of the session's entry. One map lookup, one address computation.
fn current_at(st: [i64], sk: [i64], ss: i64, sn: i64, bk: [i64], bs: i64, bn: i64) -> i64
  ensures result == -1 || result == -2 || (16 <= result && result + 20 <= len(st) && 0 <= st[result + 12] && 30 <= st[result + 13] && st[result + 12] <= len(st) - st[result + 13] && 0 <= st[st[result + 12]] && st[st[result + 12]] <= 2)
{ return found_at(st, session_of(st, sk, ss, sn), bk, bs, bn); }

// Clock entry of the budget whose id is st[s..s+n), -1 without one. An empty clock map (root 1 has no children)
// answers -1 without hashing the id.
fn clock_in(st: [i64], k: [i64], s: i64, n: i64) -> i64
{
  if crate::bud_map::count(st, 1) == 0 { return -1; }
  return crate::bud_clock::clock_of(st, k, s, n);
}

// Start (the length word) of string k (0..5) of a record held in b (header at 0). Strings 0 and 4 are packed keys
// (stride 1 + words(len)), the others unit strings (stride 1 + len).
pub fn str_at(b: [i64], k: i64) -> i64
  ensures 0 <= result && result <= 1099511627776
{
  let mut p: i64 = 24;
  let mut i: i64 = 0;
  while i < k && i < 6
    invariant 0 <= i && i <= 6 && 0 <= p && p <= 1099511627776
    decreases 6 - i
  {
    p = c40(p + 1 + str_words(i, rd(b, p)));
    i = i + 1;
  }
  return p;
}

// Length word of string k (0..5) of the record stored in st at off (no copy): the unit count. O(k).
pub fn str_len_in(st: [i64], off: i64, k: i64) -> i64
  requires 0 <= off && off <= 1099511627776
  ensures 0 <= result && result <= 4294967296
{ return c32(rd(st, str_pos_in(st, off, k))); }

// Position (the length word) of string k (0..5) of the record stored in st at off: one walk over strings 0..k-1.
fn str_pos_in(st: [i64], off: i64, k: i64) -> i64
  requires 0 <= off && off <= 1099511627776
  ensures 0 <= result && result <= 1099511627776
{
  let mut p: i64 = c40(off + 24);
  let mut i: i64 = 0;
  while i < k && i < 6
    invariant 0 <= i && i <= 6 && 0 <= p && p <= 1099511627776
    decreases 6 - i
  {
    p = c40(p + 1 + str_words(i, rd(st, p)));
    i = i + 1;
  }
  return p;
}

fn str_len(b: [i64], p: i64) -> i64
  ensures 0 <= result && result <= 4294967296
{ return c32(rd(b, p)); }

// Copies src[s .. s + m) to o[at ..] (m clamped into 0..2^30, s into 0..2^40; a word outside src reads 0, a write
// outside o is dropped); returns at + m. One range check and direct indexing when both ranges are in bounds, else the
// per-word total path (ent_u16::put_range semantics; the source offset is kept to 40 bits, so a record above 2^32 in
// the arena is still read from its own place). Both paths write the same words.
fn copy_words(inout o: [i64], at: i64, src: [i64], s: i64, m: i64) -> i64
  requires 0 <= at && at <= 4294967296
  ensures len(o) == len(old(o)) && 0 <= result && result <= 1099511627776
{
  let mut mm: i64 = c32(m);
  if mm > 1073741824 { mm = 1073741824; }
  let ss: i64 = c40(s);
  if at + mm <= len(o) && ss + mm <= len(src) {
    let mut k: i64 = 0;
    while k < mm
      invariant 0 <= k && k <= mm && at + mm <= len(o) && ss + mm <= len(src) && 0 <= at && 0 <= ss && len(o) == len(old(o))
      decreases mm - k
    {
      o[at + k] = src[ss + k];
      k = k + 1;
    }
    return at + mm;
  }
  let mut j: i64 = 0;
  while j < mm
    invariant 0 <= j && j <= mm && mm <= 1073741824 && 0 <= at && at <= 4294967296 && 0 <= ss && ss <= 1099511627776 && len(o) == len(old(o))
    decreases mm - j
  {
    crate::ent_u16::wr(inout o, at + j, rd(src, ss + j));
    j = j + 1;
  }
  return at + mm;
}

// Writes the unit string `len, src[s..s+n)` at o[at]; returns the position after it.
pub fn put_str(inout o: [i64], at: i64, src: [i64], s: i64, n: i64) -> i64
  ensures len(o) == len(old(o)) && 0 <= result && result <= 1099511627776
{
  let a: i64 = crate::ent_u16::clamp(at, 4294967295);
  let m: i64 = c32(n);
  crate::ent_u16::wr(inout o, a, m);
  return copy_words(inout o, a + 1, src, s, m);
}

// Writes the framed packed key `n, k[s .. s + words(n))` at o[at] (n clamped into 0..2^30); returns the position
// after it. A packed-to-packed copy: no unit is looked at.
pub fn put_key(inout o: [i64], at: i64, k: [i64], s: i64, n: i64) -> i64
  ensures len(o) == len(old(o)) && 0 <= result && result <= 1099511627776
{
  let a: i64 = crate::ent_u16::clamp(at, 4294967295);
  let mut nn: i64 = c32(n);
  if nn > 1073741824 { nn = 1073741824; }
  crate::ent_u16::wr(inout o, a, nn);
  return copy_words(inout o, a + 1, k, s, crate::bud_keys::words(nn));
}

// Copy of the session's blob (O(blob)).
pub fn blob_copy(st: [i64], se: i64) -> [i64] ! alloc
{
  let off: i64 = blob_at(st, se);
  let n: i64 = blob_n(st, se);
  return crate::ent_u16::slice(st, off, c40(off + n));
}

// Upper bound of len(rewrite(b, ...)) when the ended.at text is empty: 30 + the six declared strings' data words
// (str_words; the declared lengths count even when they run past the blob, as rewrite copies them).
fn rec_bound(b: [i64]) -> i64
  ensures 0 <= result && result <= 30000000000
{
  let mut t: i64 = 30;
  let mut k: i64 = 0;
  while k < 6
    invariant 0 <= k && k <= 6 && 30 <= t && t <= 30 + k * 4294967296
    decreases 6 - k
  {
    t = t + str_words(k, str_len(b, str_at(b, k)));
    k = k + 1;
  }
  return t;
}

// The record b with header h and string 3 (ended.at text) replaced by e[es..es+en) and string 2 (activeSince text)
// dropped when drop_since. Strings 0, 1, 4, 5 are kept (0 and 4 as packed keys: words(len) data words). O(record).
pub fn rewrite(b: [i64], h: [i64], drop_since: bool, e: [i64], es: i64, en: i64) -> [i64] ! alloc
{
  let p0: i64 = str_at(b, 0);
  let p1: i64 = str_at(b, 1);
  let p2: i64 = str_at(b, 2);
  let p4: i64 = str_at(b, 4);
  let p5: i64 = str_at(b, 5);
  let l0: i64 = str_len(b, p0);
  let l1: i64 = str_len(b, p1);
  let mut l2: i64 = str_len(b, p2);
  if drop_since { l2 = 0; }
  let l4: i64 = str_len(b, p4);
  let l5: i64 = str_len(b, p5);
  let m3: i64 = c32(en);
  let total: i64 = 30 + crate::bud_keys::words(l0) + l1 + l2 + m3 + crate::bud_keys::words(l4) + l5;
  let mut o: [i64] = crate::ent_u16::zeros(total);
  let mut j: i64 = 0;
  while j < 24
    invariant 0 <= j && j <= 24
    decreases 24 - j
  {
    crate::ent_u16::wr(inout o, j, rd(h, j));
    j = j + 1;
  }
  let mut at: i64 = 24;
  at = put_key(inout o, at, b, c40(p0 + 1), l0);
  at = put_str(inout o, at, b, c40(p1 + 1), l1);
  at = put_str(inout o, at, b, c40(p2 + 1), l2);
  at = put_str(inout o, at, e, c40(es), m3);
  at = put_key(inout o, at, b, c40(p4 + 1), l4);
  at = put_str(inout o, at, b, c40(p5 + 1), l5);
  return o;
}

// Writes record r as the session's blob (packed session key). Room was reserved by the caller, so a Grow here is a
// defect (status 2).
pub fn store(inout st: [i64], sk: [i64], ss: i64, sn: i64, r: [i64]) -> i64 ! alloc
{
  let mut t: [i64] = alloc(2, 0);
  let w: i64 = crate::bud_world::session_put_w(inout st, sk, ss, sn, r, 0, len(r), inout t);
  if w != 0 { return 2; }
  return 0;
}

// Reserves room for a session blob of `words` words; 0, or the Grow size N.
pub fn reserve(inout st: [i64], words: i64) -> i64
{ return crate::bud_map::make_room(inout st, 0, c32(words)); }

pub fn grow(n: i64) -> i64
{ return 0 - c40(n); }

fn out_ok(out: [i64], words: i64) -> bool
{ return words >= 0 && words <= len(out); }

// Budget view frame of bud_clock from record header h: bv[1] state, [2] unlimited, [3] timeMinutes, [4] activeMs,
// [5] activeSince kind, [6] since ms.
pub fn view(h: [i64], inout bv: [i64]) -> ()
{
  crate::ent_u16::wr(inout bv, 0, 1);
  crate::ent_u16::wr(inout bv, 1, rd(h, 0));
  let mut u: i64 = 0;
  if rd(h, 2) == 1 { u = 1; }
  crate::ent_u16::wr(inout bv, 2, u);
  crate::ent_u16::wr(inout bv, 3, rd(h, 3));
  crate::ent_u16::wr(inout bv, 4, rd(h, 8));
  crate::ent_u16::wr(inout bv, 5, rd(h, 16));
  crate::ent_u16::wr(inout bv, 6, rd(h, 17));
}

// view() of the header stored in st at off (no copy).
pub fn view_in(st: [i64], off: i64, inout bv: [i64]) -> ()
  requires 0 <= off && off <= 1099511627776
{
  crate::ent_u16::wr(inout bv, 0, 1);
  crate::ent_u16::wr(inout bv, 1, rd(st, off));
  let mut u: i64 = 0;
  if rd(st, off + 2) == 1 { u = 1; }
  crate::ent_u16::wr(inout bv, 2, u);
  crate::ent_u16::wr(inout bv, 3, rd(st, off + 3));
  crate::ent_u16::wr(inout bv, 4, rd(st, off + 8));
  crate::ent_u16::wr(inout bv, 5, rd(st, off + 16));
  crate::ent_u16::wr(inout bv, 6, rd(st, off + 17));
}

// ---- queries ----

// current(ref): out = [4, n, off] (view of the stored record st[off..off+n)) for CURRENT(ref), else [0].
// O(key length); the record is not copied (hand Rust returns `Option<&Budget>`).
pub fn current(st: [i64], sk: [i64], ss: i64, sn: i64, bk: [i64], bs: i64, bn: i64, inout out: [i64]) -> i64
{
  if len(out) < 1 { return 3; }
  let a: i64 = current_at(st, sk, ss, sn, bk, bs, bn);
  if a == -2 { return 2; }
  if a < 0 {
    out[0] = 0;
    return 0;
  }
  if len(out) < 3 { return 3; }
  out[0] = 4;
  out[1] = st[a + 13];
  out[2] = st[a + 12];
  return 0;
}

// isHalted(ref): out = [2] when CURRENT(ref) is halted, else [1].  O(key length).
pub fn is_halted(st: [i64], sk: [i64], ss: i64, sn: i64, bk: [i64], bs: i64, bn: i64, inout out: [i64]) -> i64
{
  if len(out) < 1 { return 3; }
  let a: i64 = current_at(st, sk, ss, sn, bk, bs, bn);
  let mut r: i64 = 1;
  if a >= 0 && st[st[a + 12]] == 1 { r = 2; }
  out[0] = r;
  return 0;
}

// ---- OPEN ----

// The record of a fresh budget (B:203-219): id = the packed key (uk, us, un), openedAt = now, origin, state open,
// limits = unit * times, unlimited when size is unlimited, used all 0, follows = the packed key (f, fs, fl) when
// fk == 1. Both ids are copied as packed words (put_key).
// size: -1 absent (unit default), 0 unlimited, else the bundle count; unit[ut..ut+6) = [5 limits, defaultUnlimited].
fn fresh(origin: i64, size: i64, unit: [i64], ut: i64, uk: [i64], us: i64, un: i64, now: i64, fk: i64, f: [i64], fs: i64, fl: i64) -> [i64] ! alloc
{
  let uo: i64 = c40(ut);
  let mut chosen: i64 = size;
  if chosen < 0 {
    chosen = 1;
    if rd(unit, uo + 5) == 1 { chosen = 0; }
  }
  let mut times: i64 = chosen;
  if chosen == 0 { times = 1; }
  if times > 8 { times = 8; }
  let m: i64 = crate::bud_keys::words(c32(un));
  let mut g: i64 = 0;
  if fk == 1 { g = crate::bud_keys::words(c32(fl)); }
  let mut o: [i64] = crate::ent_u16::zeros(30 + m + g);
  crate::ent_u16::wr(inout o, 0, 0);
  crate::ent_u16::wr(inout o, 1, origin);
  if chosen == 0 { crate::ent_u16::wr(inout o, 2, 1); }
  let mut i: i64 = 0;
  while i < 5
    invariant 0 <= i && i <= 5 && 1 <= times && times <= 8
    decreases 5 - i
  {
    let u: i64 = crate::ent_u16::clamp(rd(unit, uo + i), 9007199254740991);
    crate::ent_u16::wr(inout o, 3 + i, u * times);
    i = i + 1;
  }
  crate::ent_u16::wr(inout o, 20, 2);
  crate::ent_u16::wr(inout o, 21, now);
  crate::ent_u16::wr(inout o, 23, fk);
  let mut at: i64 = put_key(inout o, 24, uk, c40(us), un);
  // strings 1..3 are empty (their length words are the zeros of o)
  at = c40(at + 3);
  if fk == 1 { at = put_key(inout o, at, f, c40(fs), fl); }
  return o;
}

// OPEN (B:201-221) on session entry se whose current blob is b (stale budget, if any). Writes the record and the
// effects [13]* (DROP of the stale clock), [22] uuid, [20] changed. Room was reserved by the caller.
fn open_in(inout st: [i64], sk: [i64], ss: i64, sn: i64, b: [i64], origin: i64, size: i64, unit: [i64], ut: i64, uk: [i64], us: i64, un: i64, now: i64, fk: i64, f: [i64], fs: i64, fl: i64, inout fx: [i64]) -> i64 ! alloc
{
  if rd(b, 0) >= 0 && len(b) >= 30 {
    let ce: i64 = crate::bud_clock::clock_of(st, b, 25, str_len(b, 24));
    crate::bud_clock::drop_at(inout st, ce, inout fx);
  }
  let r: [i64] = fresh(origin, size, unit, ut, uk, us, un, now, fk, f, fs, fl);
  push(inout fx, 22);
  let w: i64 = store(inout st, sk, ss, sn, r);
  if w != 0 { return w; }
  push(inout fx, 20);
  return 0;
}

fn valid_origin(o: i64) -> bool
{ return o >= 0 && o <= 3; }

fn valid_size(z: i64) -> bool
{ return z == -1 || z == 0 || z == 1 || z == 2 || z == 4 || z == 8; }

// Worst-case record words of an OPEN after a CLOSE of record b (the new id plus the old id as follows).
fn open_words(b: [i64], un: i64) -> i64
  ensures 0 <= result && result <= 8589934622
{ return 30 + c32(un) + c32(len(b)); }

// attach(session, origin, size) (B:181-185): the session's budget when it is not closed, else OPEN.
// out = ref = [3, n, packed id words (words(n))] (the id stays packed; the host unpacks it at egress).
// O(key length + U).
pub fn attach(inout st: [i64], sk: [i64], ss: i64, sn: i64, origin: i64, size: i64, unit: [i64], ut: i64, uk: [i64], us: i64, un: i64, now: i64, inout fx: [i64], inout out: [i64]) -> i64 ! alloc
{
  if !crate::bud_clock::fx_ok(fx) { return 3; }
  if !valid_origin(origin) || !valid_size(size) { return 2; }
  let se: i64 = session_of(st, sk, ss, sn);
  if se < 0 { return 2; }
  // The ref path reads the stored record in place; only OPEN copies it.
  let a: i64 = entry_addr(st, se);
  let off: i64 = at_off(st, a);
  let n: i64 = at_n(st, a);
  let mut s: i64 = 0;
  if n >= 1 { s = rd(st, off); }
  if s >= 0 && n < 30 { return 2; }
  if s == 0 || s == 1 {
    let il: i64 = c32(rd(st, off + 24));
    if !out_ok(out, 2 + crate::bud_keys::words(il)) { return 3; }
    crate::ent_u16::wr(inout out, 0, 3);
    let e: i64 = put_key(inout out, 1, st, c40(off + 25), il);
    return 0;
  }
  let b: [i64] = blob_copy(st, se);
  if !out_ok(out, 2 + crate::bud_keys::words(c32(un))) { return 3; }
  let g: i64 = reserve(inout st, open_words(b, un));
  if g != 0 { return grow(g); }
  let w: i64 = open_in(inout st, sk, ss, sn, b, origin, size, unit, ut, uk, us, un, now, 0, b, 0, 0, inout fx);
  if w != 0 { return w; }
  crate::ent_u16::wr(inout out, 0, 3);
  let e: i64 = put_key(inout out, 1, uk, c40(us), un);
  return 0;
}

// ---- CLOSE ----

// CLOSE (§5.7, B:233-238) of the session's budget record b: bud_clock's clock part (SETTLE, state closed, DROP),
// then ended = {how, at: now}. Returns the new record; effects are bud_clock's. Room was reserved by the caller.
pub fn close_rec(inout st: [i64], sk: [i64], ss: i64, sn: i64, b: [i64], how: i64, now: i64, inout bv: [i64], inout fx: [i64]) -> [i64] ! alloc
{
  let mut h: [i64] = crate::ent_u16::slice(b, 0, 24);
  view(h, inout bv);
  let c: i64 = crate::bud_clock::close(inout st, b, 25, str_len(b, 24), sk, ss, sn, now, inout bv, inout fx);
  crate::ent_u16::wr(inout h, 0, rd(bv, 1));
  crate::ent_u16::wr(inout h, 8, rd(bv, 4));
  let k: i64 = rd(bv, 5);
  crate::ent_u16::wr(inout h, 16, k);
  crate::ent_u16::wr(inout h, 17, rd(bv, 6));
  crate::ent_u16::wr(inout h, 18, how);
  crate::ent_u16::wr(inout h, 19, 2);
  crate::ent_u16::wr(inout h, 22, now);
  return rewrite(b, h, k != 1, b, 0, 0);
}

// replaceForUserMessage(session, size, origin) (B:192-200): a halted budget is closed ('user-message') and a new
// one opened; unless origin is schedule the new budget follows the old id (set before `changed`, KD-2) and the old
// id's held items are carried (effect [21]). Otherwise attach. origin -1 = absent (user).
// The closed record is replaced by the new one in the same step, so it is never built: only CLOSE's clock part
// (SETTLE, state closed, DROP; its effects and the bv frame) runs, then OPEN writes the new record, which is built
// from the stored old id in place before anything changes. O(key length + U + record).
pub fn replace(inout st: [i64], sk: [i64], ss: i64, sn: i64, origin: i64, size: i64, unit: [i64], ut: i64, uk: [i64], us: i64, un: i64, now: i64, inout bv: [i64], inout fx: [i64], inout out: [i64]) -> i64 ! alloc
{
  let mut o: i64 = origin;
  if o < 0 { o = 0; }
  if !crate::bud_clock::fx_ok(fx) { return 3; }
  if !valid_origin(o) || !valid_size(size) { return 2; }
  let se: i64 = session_of(st, sk, ss, sn);
  if se < 0 { return 2; }
  let a: i64 = entry_addr(st, se);
  let n: i64 = at_n(st, a);
  if n < 30 || rd(st, at_off(st, a)) != 1 {
    return attach(inout st, sk, ss, sn, o, size, unit, ut, uk, us, un, now, inout fx, inout out);
  }
  let ol: i64 = c32(rd(st, at_off(st, a) + 24));
  let ow: i64 = crate::bud_keys::words(ol);
  let m: i64 = c32(un);
  let mw: i64 = crate::bud_keys::words(m);
  // out = [3, m, new id words (mw)] then, unless o == 1, [ol, old id words (ow)].
  if !out_ok(out, 3 + mw + ow) { return 3; }
  // Room for the new record (30 + words(un) + words(ol) words, ol counted even when the old id's length word runs
  // past the blob) plus the old reservation; store's put then fits without Grow. make_room keeps entries and blob
  // offsets.
  let g: i64 = reserve(inout st, 30 + mw + ow + n + 64);
  if g != 0 { return grow(g); }
  let off: i64 = at_off(st, a);
  let mut fk: i64 = 1;
  if o == 1 { fk = 0; }
  // The old (packed) id is read in place when its words lie inside the blob; otherwise from a copy of the blob, whose
  // reads past the end give 0 (the same words the closed-record path read).
  let mut r: [i64] = crate::ent_u16::zeros(0);
  let mut ce: i64 = -1;
  if 25 + ow <= n {
    r = fresh(o, size, unit, ut, uk, us, un, now, fk, st, c40(off + 25), ol);
    ce = clock_in(st, st, c40(off + 25), ol);
  } else {
    let b: [i64] = blob_copy(st, se);
    r = fresh(o, size, unit, ut, uk, us, un, now, fk, b, 25, ol);
    ce = clock_in(st, b, 25, ol);
  }
  // CLOSE's clock part on the old record (bud_clock::close without the fx re-check, which passed above).
  view_in(st, off, inout bv);
  let sa: i64 = crate::bud_clock::settle_at(inout st, ce, sk, ss, sn, now, inout bv, inout fx);
  crate::ent_u16::wr(inout bv, 1, 2);
  crate::bud_clock::drop_at(inout st, ce, inout fx);
  // OPEN (the old clock is gone, so OPEN's stale-clock DROP finds nothing).
  push(inout fx, 22);
  let w: i64 = store(inout st, sk, ss, sn, r);
  if w != 0 { return w; }
  push(inout fx, 20);
  crate::ent_u16::wr(inout out, 0, 3);
  let e: i64 = put_key(inout out, 1, uk, c40(us), un);
  if o != 1 {
    // The old id is the new record's follows (string 4 at 28 + words(un): the packed id, then three empty strings),
    // written to out as a framed packed key (packed-to-packed copy).
    let e2: i64 = put_key(inout out, e, r, c40(29 + mw), ol);
    push(inout fx, 21);
  }
  return 0;
}

// reopen(ref) (B:224-231): CURRENT(ref) closed with ended.how quiet -> open, ended deleted, changed; out [2].
// Otherwise [1]. O(key length + record).
pub fn reopen(inout st: [i64], sk: [i64], ss: i64, sn: i64, bk: [i64], bs: i64, bn: i64, inout fx: [i64], inout out: [i64]) -> i64 ! alloc
{
  if !crate::bud_clock::fx_ok(fx) { return 3; }
  if len(out) < 1 { return 3; }
  let a: i64 = current_at(st, sk, ss, sn, bk, bs, bn);
  if a < 0 {
    crate::ent_u16::wr(inout out, 0, 1);
    return 0;
  }
  // current_at proved the record span st[off .. off + n) in st with n >= 30: header reads and writes are direct.
  let off: i64 = st[a + 12];
  let n: i64 = st[a + 13];
  if st[off] != 2 || st[off + 18] != 1 {
    out[0] = 1;
    return 0;
  }
  // No ended.at text: deleting `ended` keeps the record length, so the header words are rewritten in place.
  if str_len_in(st, off, 3) == 0 {
    st[off] = 0;
    st[off + 18] = 0;
    st[off + 19] = 0;
    st[off + 22] = 0;
    push(inout fx, 20);
    out[0] = 2;
    return 0;
  }
  let se: i64 = session_of(st, sk, ss, sn);
  let b: [i64] = blob_copy(st, se);
  if rd(b, 0) != 2 || rd(b, 18) != 1 {
    crate::ent_u16::wr(inout out, 0, 1);
    return 0;
  }
  let mut h: [i64] = crate::ent_u16::slice(b, 0, 24);
  crate::ent_u16::wr(inout h, 0, 0);
  crate::ent_u16::wr(inout h, 18, 0);
  crate::ent_u16::wr(inout h, 19, 0);
  crate::ent_u16::wr(inout h, 22, 0);
  let r: [i64] = rewrite(b, h, false, b, 0, 0);
  let g: i64 = reserve(inout st, len(r));
  if g != 0 { return grow(g); }
  let w: i64 = store(inout st, sk, ss, sn, r);
  if w != 0 { return w; }
  push(inout fx, 20);
  crate::ent_u16::wr(inout out, 0, 2);
  return 0;
}

// maybeClose(session) (B:399-408): only an open budget with no runs on its clock closes, and only when the session
// is quiet (quiet: the host's isQuiet answer supplied up front, 0 no, 1 yes; consulting it pushes [23] first; -1 not
// supplied -> status 5 with nothing written). Closing is CLOSE('quiet') then changed; out [2]. Otherwise [1].
// O(key length + U).
pub fn maybe_close(inout st: [i64], sk: [i64], ss: i64, sn: i64, quiet: i64, now: i64, inout bv: [i64], inout fx: [i64], inout out: [i64]) -> i64 ! alloc
{
  // Room for [23] plus CLOSE's effects (bud_clock::fx_ok bound after one push).
  if c40(rd(fx, 0)) + 6 > len(fx) { return 3; }
  if len(out) < 1 { return 3; }
  let se: i64 = session_of(st, sk, ss, sn);
  if se < 0 { return 2; }
  let a: i64 = entry_addr(st, se);
  let off: i64 = at_off(st, a);
  if state_of(st, off, at_n(st, a)) != 0 { crate::ent_u16::wr(inout out, 0, 1); return 0; }
  let ce: i64 = clock_in(st, st, c40(off + 25), c32(rd(st, off + 24)));
  if ce >= 0 && crate::bud_map::count(st, ce) > 0 { crate::ent_u16::wr(inout out, 0, 1); return 0; }
  if quiet < 0 { return 5; }
  // activeSince (string 2) and ended.at (string 3) both empty, from one walk: with string 2 empty, string 3's length
  // word is the next word (str_len_in(st, off, 3) == c32(rd(st, c40(p2 + 1))) when string 2 has length 0).
  let p2: i64 = str_pos_in(st, off, 2);
  let in_place: bool = c32(rd(st, p2)) == 0 && c32(rd(st, c40(p2 + 1))) == 0;
  if quiet != 0 && !in_place {
    // Room for the rewritten record before the first effect, so a Grow writes nothing. The same blob copy feeds
    // close_rec: reserve does not change the record, so it is not copied twice.
    let b: [i64] = blob_copy(st, se);
    let rw: i64 = rec_bound(b);
    let g: i64 = reserve(inout st, rw + 8);
    if g != 0 { return grow(g); }
    push(inout fx, 23);
    crate::ent_u16::wr(inout out, 0, 1);
    let r: [i64] = close_rec(inout st, sk, ss, sn, b, 1, now, inout bv, inout fx);
    let w: i64 = store(inout st, sk, ss, sn, r);
    if w != 0 { return w; }
    push(inout fx, 20);
    crate::ent_u16::wr(inout out, 0, 2);
    return 0;
  }
  push(inout fx, 23);
  crate::ent_u16::wr(inout out, 0, 1);
  if quiet == 0 { return 0; }
  // No activeSince text and no ended.at text: CLOSE keeps the record length, so only the header changes. The clock
  // part is bud_clock::close on the clock entry ce found above (SETTLE, state closed, DROP), then the header words
  // are written in place (the entry is found again after DROP, which may move entries).
  if in_place {
    if ce < 0 {
      // No clock entry: SETTLE and DROP do nothing and amounts / spent stay as stored, so only state, closed and the
      // end stamp change. The bv scratch frame is not loaded (nothing reads it on this path; Q compares st/fx/out).
      crate::ent_u16::wr(inout st, off, 2);
      crate::ent_u16::wr(inout st, off + 18, 1);
      crate::ent_u16::wr(inout st, off + 19, 2);
      crate::ent_u16::wr(inout st, off + 22, now);
      push(inout fx, 20);
      crate::ent_u16::wr(inout out, 0, 2);
      return 0;
    }
    view_in(st, off, inout bv);
    let sa: i64 = crate::bud_clock::settle_at(inout st, ce, sk, ss, sn, now, inout bv, inout fx);
    crate::ent_u16::wr(inout bv, 1, 2);
    crate::bud_clock::drop_at(inout st, ce, inout fx);
    let se2: i64 = session_of(st, sk, ss, sn);
    if se2 < 0 { return 2; }
    let o2: i64 = blob_at(st, se2);
    crate::ent_u16::wr(inout st, o2, 2);
    crate::ent_u16::wr(inout st, o2 + 8, rd(bv, 4));
    crate::ent_u16::wr(inout st, o2 + 16, rd(bv, 5));
    crate::ent_u16::wr(inout st, o2 + 17, rd(bv, 6));
    crate::ent_u16::wr(inout st, o2 + 18, 1);
    crate::ent_u16::wr(inout st, o2 + 19, 2);
    crate::ent_u16::wr(inout st, o2 + 22, now);
    push(inout fx, 20);
    crate::ent_u16::wr(inout out, 0, 2);
    return 0;
  }
  return 2;
}
