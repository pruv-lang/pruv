// Resident M9 state. Ordinals preserve insertion order for observation.
pub struct Budget {
  id: String, state: i64, unlimited: bool, minutes: i64,
  active_ms: i64, since_kind: i64, since: i64, ordinal: i64
}
pub struct Run { ordinal: i64, waiting: bool }
pub struct Clock {
  owner: String, ordinal: i64, has_since: bool, since: i64, armed: bool,
  active: i64, runs: HashMap<String, Run>, next_run: i64
}
pub struct St {
  sessions: HashMap<String, Budget>, next_session: i64,
  clocks: HashMap<String, Clock>, next_clock: i64, out: Out
}
pub struct Effect { tag: i64, requested: i64, effective: i64 }
pub struct Out { fx: Vec<Effect> }
pub struct Observation { words: Vec<i64>, keys: Vec<String> }

fn owned(s: str) -> String ! alloc {
  return string_push_str(string_new(), s);
}

pub fn t_put(inout st: St, sid: str, bid: str, state: i64, unlimited: bool,
             minutes: i64, active_ms: i64, since_kind: i64, since: i64) -> i64 ! alloc {
  let mut ordinal: i64 = st.next_session;
  match map_get::<String, Budget>(st.sessions, sid) {
    Some(b) => { ordinal = b.ordinal; }
    None => {
      if st.next_session >= 1099511627776 { return 2; }
      st.next_session = st.next_session + 1;
    }
  }
  if len(st.sessions) >= 1099511627776 { return 2; }
  st.sessions = map_insert::<String, Budget>(move st.sessions, owned(sid),
    Budget { id: owned(bid), state: state, unlimited: unlimited, minutes: minutes,
      active_ms: active_ms, since_kind: since_kind, since: since, ordinal: ordinal });
  return 0;
}

fn bounded(x: i64) -> i64
  ensures -9007199254740991 <= result && result <= 9007199254740991
{
  if x < -9007199254740991 { return -9007199254740991; }
  if x > 9007199254740991 { return 9007199254740991; }
  return x;
}

fn limit(b: Budget) -> i64
  ensures -9000000000000000000 <= result && result <= 9000000000000000000
{
  let mut minutes: i64 = b.minutes;
  if minutes < -150000000000000 { minutes = -150000000000000; }
  if minutes > 150000000000000 { minutes = 150000000000000; }
  return minutes * 60000;
}

fn effect(inout o: Out, tag: i64, requested: i64, effective: i64) -> () ! alloc {
  if len(o.fx) < 1099511627776 {
    o.fx = vec_push::<Effect>(move o.fx, Effect { tag: tag, requested: requested, effective: effective });
  }
}

fn disarm(inout c: Clock, inout o: Out, tag: i64) -> () ! alloc {
  if c.armed { effect(inout o, tag, 0, 0); }
  c.armed = false;
}

fn settle(inout b: Budget, inout c: Clock, sid: str, now: i64, inout o: Out) -> () ! alloc {
  if !string_eq(c.owner, sid) { return; }
  disarm(inout c, inout o, 13);
  if !c.has_since { return; }
  let elapsed: i64 = bounded(now) - bounded(c.since);
  if elapsed > 0 { b.active_ms = bounded(bounded(b.active_ms) + elapsed); }
  else { b.active_ms = bounded(b.active_ms); }
  c.has_since = false;
  c.since = 0;
  b.since_kind = 0;
  b.since = 0;
}

fn begin(inout b: Budget, inout c: Clock, now: i64) -> () {
  let t: i64 = bounded(now);
  c.has_since = true;
  c.since = t;
  b.since_kind = 2;
  b.since = t;
}

fn arm(inout b: Budget, inout c: Clock, sid: str, now: i64, inout o: Out) -> i64 ! alloc {
  if b.unlimited { return 0; }
  let left: i64 = limit(b) - bounded(b.active_ms);
  if left <= 0 {
    c.armed = false;
    settle(inout b, inout c, sid, now, inout o);
    return 4;
  }
  let mut delay: i64 = left;
  if left > 2147483647 { delay = 1; }
  c.armed = true;
  effect(inout o, 12, left, delay);
  return 0;
}

fn refresh(inout b: Budget, inout c: Clock, sid: str, now: i64, inout o: Out) -> i64 ! alloc {
  let consuming: bool = b.state == 0 && c.active > 0;
  if consuming == c.has_since { return 0; }
  if consuming {
    begin(inout b, inout c, now);
    return arm(inout b, inout c, sid, now, inout o);
  }
  settle(inout b, inout c, sid, now, inout o);
  return 0;
}

fn bump(inout c: Clock, delta: i64) -> () {
  if 0 <= c.active && c.active <= 1099511627776 && -1 <= delta && delta <= 1 {
    c.active = c.active + delta;
  }
}

// -1 means capacity exhausted, 1 requests a refresh.
fn change_run(inout c: Clock, code: i64, key: str, waiting: bool) -> i64 ! alloc {
  let mut delta: i64 = 0;
  let mut changed: bool = false;
  let mut found: bool = false;
  match map_get_mut::<String, Run>(inout c.runs, key) {
    Some(run) => {
      found = true;
      if code == 3 {
        if !run.waiting { delta = -1; }
        changed = true;
      } else if run.waiting != waiting {
        run.waiting = waiting;
        delta = 1;
        if waiting { delta = -1; }
        changed = true;
      }
    }
    None => {}
  }
  if code == 3 && found {
    let removed: bool = map_remove::<String, Run>(inout c.runs, key);
  }
  if code == 1 && !found {
    let ordinal: i64 = c.next_run;
    if ordinal >= 1099511627776 || len(c.runs) >= 1099511627776 { return -1; }
    c.next_run = ordinal + 1;
    c.runs = map_insert::<String, Run>(move c.runs, owned(key), Run { ordinal: ordinal, waiting: false });
    delta = 1;
  }
  bump(inout c, delta);
  if code == 1 || changed { return 1; }
  return 0;
}

fn current(st: St, sid: str, bid: str) -> bool {
  match map_get::<String, Budget>(st.sessions, sid) {
    Some(b) => { return b.state >= 0 && string_eq(b.id, bid); }
    None => { return false; }
  }
}

pub fn t_call(inout st: St, code: i64, sid: str, bid: str, run: str,
              waiting: bool, now: i64) -> i64 ! alloc {
  vec_clear::<Effect>(inout st.out.fx);
  let mut status: i64 = 0;
  if code < 1 || code > 7 { return 2; }
  let valid: bool = current(st, sid, bid);
  if code == 1 && !valid { return 0; }
  if code == 1 {
    let mut missing: bool = false;
    match map_get::<String, Clock>(st.clocks, bid) {
      Some(c) => {}
      None => { missing = true; }
    }
    if missing {
      let ordinal: i64 = st.next_clock;
      if ordinal >= 1099511627776 || len(st.clocks) >= 1099511627776 { return 2; }
      st.next_clock = ordinal + 1;
      st.clocks = map_insert::<String, Clock>(move st.clocks, owned(bid),
        Clock { owner: owned(sid), ordinal: ordinal, has_since: false, since: 0, armed: false,
          active: 0, runs: map_new::<String, Run>(), next_run: 0 });
    }
  }
  match map_get_mut::<String, Clock>(inout st.clocks, bid) {
    Some(c) => {
      let mut update: bool = code == 7;
      if code == 1 || code == 2 || code == 3 {
        let change: i64 = change_run(inout c, code, run, code == 2 && waiting);
        if change < 0 { status = 2; }
        update = change == 1;
      }
      if code == 4 { disarm(inout c, inout st.out, 14); }
      if valid {
        match map_get_mut::<String, Budget>(inout st.sessions, sid) {
          Some(b) => {
            if update { status = refresh(inout b, inout c, sid, now, inout st.out); }
            if code == 4 && b.state == 0 && !b.unlimited {
              settle(inout b, inout c, sid, now, inout st.out);
              if bounded(b.active_ms) < limit(b) && len(c.runs) > 0 {
                begin(inout b, inout c, now);
                status = arm(inout b, inout c, sid, now, inout st.out);
              } else { status = 4; }
            }
            if code == 6 {
              settle(inout b, inout c, sid, now, inout st.out);
              b.state = 2;
            }
          }
          None => {}
        }
      }
      if code == 5 || code == 6 { disarm(inout c, inout st.out, 13); }
    }
    None => {
      if valid && (code == 4 || code == 6) {
        match map_get_mut::<String, Budget>(inout st.sessions, sid) {
          Some(b) => {
            if code == 6 { b.state = 2; }
            else if b.state == 0 && !b.unlimited { status = 4; }
          }
          None => {}
        }
      }
    }
  }
  if code == 5 || code == 6 {
    let removed: bool = map_remove::<String, Clock>(inout st.clocks, bid);
  }
  return status;
}

fn word(inout o: Observation, value: i64) -> () ! alloc {
  if len(o.words) < 1099511627776 {
    o.words = vec_push::<i64>(move o.words, value);
  }
}

fn key(inout o: Observation, value: str) -> () ! alloc {
  if len(o.keys) < 1099511627776 {
    o.keys = vec_push::<String>(move o.keys, owned(value));
  }
}

pub fn t_observe(inout st: St) -> Observation ! alloc {
  let mut o: Observation = Observation { words: vec_new::<i64>(), keys: vec_new::<String>() };
  word(inout o, len(st.sessions));
  for (sid, b) in st.sessions {
    key(inout o, sid);
    key(inout o, string_to_str(b.id));
    word(inout o, b.ordinal);
    word(inout o, b.state);
    if b.unlimited { word(inout o, 1); } else { word(inout o, 0); }
    word(inout o, b.minutes);
    word(inout o, b.active_ms);
    word(inout o, b.since_kind);
    word(inout o, b.since);
  }
  word(inout o, len(st.clocks));
  for (bid, c) in st.clocks {
    key(inout o, bid);
    key(inout o, string_to_str(c.owner));
    word(inout o, c.ordinal);
    if c.has_since { word(inout o, 1); } else { word(inout o, 0); }
    word(inout o, c.since);
    if c.armed { word(inout o, 1); } else { word(inout o, 0); }
    word(inout o, c.active);
    word(inout o, len(c.runs));
    for (run_key, run) in c.runs {
      key(inout o, run_key);
      word(inout o, run.ordinal);
      if run.waiting { word(inout o, 1); } else { word(inout o, 0); }
    }
  }
  return o;
}

fn recount(c: Clock) -> i64
  ensures 0 <= result && result <= 1099511627776
{
  let mut active: i64 = 0;
  for (run_key, run) in c.runs
    invariant 0 <= active && active <= 1099511627776
  {
    if !run.waiting && active < 1099511627776 { active = active + 1; }
  }
  return active;
}

pub fn t_i2(inout st: St) -> i64 {
  let mut bad: i64 = 0;
  for (bid, c) in st.clocks
    invariant 0 <= bad && bad <= 1099511627776
  {
    if recount(c) != c.active && bad < 1099511627776 { bad = bad + 1; }
  }
  return bad;
}
