mod bud_tstate;
mod bud_tlife;
mod bud_tdecide;

pub struct SessionOrdinal { seq: i64 }

pub struct St {
  sessions: HashMap<String, crate::bud_tstate::Budget>,
  session_ordinals: HashMap<String, SessionOrdinal>, next_session: i64,
  clock_state: crate::bud_tstate::ClockState, out: crate::bud_tstate::Out,
  charge_reason: String
}

fn reason_text(reason: i64) -> String ! alloc
{
  if reason == 0 { return string_push_str(string_new(), "time"); }
  if reason == 1 { return string_push_str(string_new(), "delegations"); }
  if reason == 2 { return string_push_str(string_new(), "commands"); }
  if reason == 3 { return string_push_str(string_new(), "reviews"); }
  if reason == 4 { return string_push_str(string_new(), "checks"); }
  return string_new();
}

fn apply_charge(inout st: St, sid: str, bid: str, now: i64, charge: crate::bud_tstate::Charge) -> crate::bud_tstate::Reply ! alloc, io
{
  let mut reply: crate::bud_tstate::Reply = crate::bud_tstate::Reply { status: 0, value: 5, a: 2, b: 0 };
  match map_get_mut::<String, crate::bud_tstate::Budget>(inout st.sessions, sid) {
    Some(b) => {
      if b.state >= 0 && string_eq(b.id, bid) {
        let mut reason: i64 = -1;
        if b.state == 1 {
          reason = b.halt_reason;
          if reason < 0 { reason = 1; }
        }
        if b.state == 0 {
          let charged: i64 = crate::bud_tstate::charge_typed(inout b, charge);
          if charged < 0 { reply.status = 2; }
          if charged > 0 {
            reason = charged;
            match map_get_mut::<String, crate::bud_tstate::Clock>(inout st.clock_state.clocks, bid) {
              Some(c) => { crate::bud_tstate::settle(inout b, inout c, sid, now, inout st.out); }
              None => { }
            }
            let status: i64 = crate::bud_tlife::halt(inout b, sid, bid, now, reason, inout st.out); reply.status = status;
          }
        }
        if reason >= 0 { reply.a = 1; reply.b = reason; }
      }
    }
    None => { }
  }
  return reply;
}

pub fn t_view(inout st: St, sid: str, bid: str, code: i64) -> crate::bud_tstate::Reply ! alloc
{
  vec_clear::<crate::bud_tstate::Effect>(inout st.out.fx);
  return crate::bud_tlife::view(inout st.sessions, inout st.out, sid, bid, code);
}

pub fn t_close(inout st: St, sid: str, now: i64) -> crate::bud_tstate::Reply ! alloc, io
{
  vec_clear::<crate::bud_tstate::Effect>(inout st.out.fx);
  return crate::bud_tlife::maybe_close(inout st.sessions, inout st.clock_state.clocks, inout st.out, sid, now);
}

pub fn t_charge(inout st: St, sid: str, bid: str, now: i64, charge: crate::bud_tstate::Charge) -> crate::bud_tstate::Reply ! alloc, io
{
  vec_clear::<crate::bud_tstate::Effect>(inout st.out.fx);
  let reply: crate::bud_tstate::Reply = apply_charge(inout st, sid, bid, now, charge);
  st.charge_reason = string_new();
  if reply.a == 1 { st.charge_reason = reason_text(reply.b); }
  return reply;
}

pub fn t_run(inout st: St, sid: str, bid: str, run: str, code: i64, now: i64, flag: i64) -> crate::bud_tstate::Reply ! alloc, io
{
  vec_clear::<crate::bud_tstate::Effect>(inout st.out.fx);
  return crate::bud_tlife::run_event(inout st.sessions, inout st.clock_state, inout st.out, sid, bid, run, code, now, flag);
}

pub fn t_halt(inout st: St, sid: str, bid: str, now: i64, flag: i64) -> crate::bud_tstate::Reply ! alloc, io
{
  vec_clear::<crate::bud_tstate::Effect>(inout st.out.fx);
  return crate::bud_tlife::explicit_halt(inout st.sessions, inout st.clock_state.clocks, inout st.out, sid, bid, now, flag);
}

// Test-only packet decoding and rejection, shared with the direct-entry test lane.
pub fn t_charge_words(what: [i64]) -> Option<crate::bud_tstate::Charge>
{
  if len(what) != 10 { return None::<crate::bud_tstate::Charge>; }
  return Some::<crate::bud_tstate::Charge>(crate::bud_tstate::charge_words(what));
}

pub fn t_invalid(inout st: St) -> crate::bud_tstate::Reply ! alloc
{
  vec_clear::<crate::bud_tstate::Effect>(inout st.out.fx);
  return crate::bud_tstate::Reply { status: 2, value: 0, a: 0, b: 0 };
}

// Test-only adapter for the packet driver: decodes once and calls the direct entry.
pub fn t_call(inout st: St, sid: str, bid: str, run: str, code: i64,
              now: i64, flag: i64, what: [i64]) -> crate::bud_tstate::Reply ! alloc, io
{
  if code == 1 || code == 2 || code == 5 { return t_view(inout st, sid, bid, code); }
  if code == 6 { return t_close(inout st, sid, now); }
  if code == 7 {
    match t_charge_words(what) {
      Some(c) => { return t_charge(inout st, sid, bid, now, c); }
      None => { return t_invalid(inout st); }
    }
  }
  if code >= 8 && code <= 11 { return t_run(inout st, sid, bid, run, code, now, flag); }
  if code == 12 { return t_halt(inout st, sid, bid, now, flag); }
  return t_invalid(inout st);
}

// Replacement preserves the insertion ordinal.
pub fn t_put(inout st: St, sid: str, budget: crate::bud_tstate::Budget) -> i64 ! alloc
{
  if len(st.sessions) >= 1099511627776 { return 2; }
  match map_get::<String, SessionOrdinal>(st.session_ordinals, sid) {
    Some(entry) => {}
    None => {
      if st.next_session < 0 || st.next_session >= 1099511627775 ||
         len(st.session_ordinals) >= 1099511627776 { return 2; }
      let seq: i64 = st.next_session;
      st.next_session = seq + 1;
      st.session_ordinals = map_insert::<String, SessionOrdinal>(move st.session_ordinals,
        string_push_str(string_new(), sid), SessionOrdinal { seq: seq });
    }
  }
  // Replace the value in its existing slot, keeping the map key and ordinal.
  let mut done: bool = false;
  match map_get_mut::<String, crate::bud_tstate::Budget>(inout st.sessions, sid) {
    Some(b) => {
      let copy: crate::bud_tstate::Budget = budget;
      *b = move copy;
      done = true;
    }
    None => {}
  }
  if !done {
    let copy: crate::bud_tstate::Budget = budget;
    st.sessions = map_insert::<String, crate::bud_tstate::Budget>(move st.sessions, string_push_str(string_new(), sid), move copy);
  }
  return 0;
}

pub fn t_del(inout st: St, sid: str) -> bool
{
  let removed: bool = map_remove::<String, SessionOrdinal>(inout st.session_ordinals, sid);
  return map_remove::<String, crate::bud_tstate::Budget>(inout st.sessions, sid);
}

// Identifies the resident record to serialize without cloning the Budget.
pub fn t_get(inout st: St, sid: str) -> i64
{
  match map_get::<String, SessionOrdinal>(st.session_ordinals, sid) {
    Some(entry) => { return entry.seq; }
    None => { return -1; }
  }
}

pub struct Observation {
  sessions: Vec<String>, clocks: Vec<String>
}

pub fn t_observe(inout st: St) -> Observation ! alloc
{
  let mut sessions: Vec<String> = vec_new::<String>();
  let mut clocks: Vec<String> = vec_new::<String>();
  for (sid, entry) in st.session_ordinals {
    if len(sessions) < 1099511627776 {
      sessions = vec_push::<String>(move sessions, string_push_str(string_new(), string_to_str(sid)));
    }
  }
  for (bid, clock) in st.clock_state.clocks {
    if len(clocks) < 1099511627776 {
      clocks = vec_push::<String>(move clocks, string_push_str(string_new(), string_to_str(bid)));
    }
  }
  return Observation { sessions: move sessions, clocks: move clocks };
}
