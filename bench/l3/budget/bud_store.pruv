// L3-10 M4: resident buffer store (header, layout, capacity, arena, entry allocation).
// Layout and field meaning: bench/l3/budget/m34_test/CONTRACT.md, section "M4".
//
// Header words (16): 0 magic, 1 version, 2 total words, 3 slot base, 4 slot count, 5 entry base, 6 entry capacity,
// 7 entry top, 8 free-list head (-1 none), 9 arena base, 10 arena top, 11 arena end, 12 live entries (table
// occupancy: roots + live), 13 used slots, 14 live arena words, 15 pending-Need sequence.
//
// Every access to the buffer goes through crate::ent_u16::rd / wr (total), and every value read from the buffer is
// clamped before it is used in arithmetic. A corrupt buffer can therefore give wrong answers but never an
// out-of-bounds access, an arithmetic overflow, or a non-terminating loop.

pub fn magic() -> i64
  ensures result == 1112884307
{ return 1112884307; }

pub fn entry_words() -> i64
  ensures result == 20
{ return 20; }

// layout(8 slots) = 16 + 8 + 4*20 + 4*32
pub fn min_words() -> i64
  ensures result == 232
{ return 232; }

// x clamped into 0..2^32
pub fn c32(x: i64) -> i64
  ensures 0 <= result && result <= 4294967296
  ensures (0 <= x && x <= 4294967296) ==> result == x
  ensures x > 4294967296 ==> result == 4294967296
{ return crate::ent_u16::clamp(x, 4294967296); }

// x clamped into 0..2^40
pub fn c40(x: i64) -> i64
  ensures 0 <= result && result <= 1099511627776
  ensures (0 <= x && x <= 1099511627776) ==> result == x
  ensures x > 1099511627776 ==> result == 1099511627776
{ return crate::ent_u16::clamp(x, 1099511627776); }

// Header word i (0 out of range).
pub fn hd(st: [i64], i: i64) -> i64
  ensures (0 <= i && i < len(st)) ==> result == st[i]
{ return crate::ent_u16::rd(st, i); }

// st[i] = v when i is in range; every other word keeps its value.
pub fn set_hd(inout st: [i64], i: i64, v: i64) -> ()
  ensures len(st) == len(old(st))
  ensures (0 <= i && i < len(st)) ==> st[i] == v
  ensures forall k in 0..len(old(st)): k == i || st[k] == old(st)[k]
{ crate::ent_u16::wr(inout st, i, v); }

// Number of hash slots of layout(l): the largest power of two s >= 8 with 16 + 27*s <= l; 0 if l < 232.
pub fn layout_slots(l: i64) -> i64
  ensures result == 0 || (result >= 8 && result <= 4294967296)
{
  if l < 232 { return 0; }
  let mut s: i64 = 8;
  while s <= 2147483648 && 54 * s + 16 <= l
    invariant 8 <= s && s <= 4294967296
    decreases 4294967296 - s
  {
    s = s * 2;
  }
  return s;
}

// O(1) header check against layout(len(st)): the shape of the fixed header words and the linear conditions on the
// words the mutators write (L3 P13a). Every mutator ensures kept(st, old(st)), so valid(old) ==> valid(st) chains
// through callers without expanding shape_w or dyn_ok (both opaque; L3 P13a.9).
pub fn valid(st: [i64]) -> bool
{
  return len(st) >= 232 && shape(st) && dyn_ok(st);
}

// Fixed header words 0..6, 9, 11 against layout(len(st)); no mutator writes them. A transparent read of those words
// into the opaque shape_w: a mutator that keeps the length and the shape words (shape_same) keeps shape by congruence,
// without ever expanding the layout test (its power-of-two term is the costly one).
pub fn shape(st: [i64]) -> bool
{
  return len(st) >= 232 && shape_w(len(st), st[0], st[1], st[2], st[3], st[4], st[5], st[6], st[9], st[11]);
}

// The layout test on the shape words of a buffer of length l (l >= 232). s == layout_slots(l) without the doubling
// loop: a power of two in 8..2^32 with 54*(s/2)+16 <= l, and either s > 2^31 or 54*s+16 > l (the loop stops at exactly
// that s).
pub opaque fn shape_w(l: i64, w0: i64, w1: i64, w2: i64, w3: i64, s: i64, w5: i64, w6: i64, w9: i64, w11: i64) -> bool
{
  if s < 8 || s > 4294967296 { return false; }
  if band(s, s - 1) != 0 { return false; }
  if 54 * (s / 2) + 16 > l { return false; }
  if s <= 2147483648 && 54 * s + 16 <= l { return false; }
  let cap: i64 = s / 2;
  if w0 != 1112884307 || w1 != 1 || w2 != l { return false; }
  if w3 != 16 || w5 != 16 + s || w6 != cap { return false; }
  if w9 != 16 + 11 * s || w11 != l { return false; }
  return true;
}

// Linear conditions on the header words the mutators write: entry top 7, free head 8, arena top 10, live entries 12,
// used slots 13, live words 14 (against the fixed words 6, 9, 11).
pub opaque fn dyn_ok(st: [i64]) -> bool
{
  if len(st) < 15 { return false; }
  let top: i64 = st[7];
  if top < 0 || top > st[6] { return false; }
  let fh: i64 = st[8];
  if fh < -1 || fh >= top { return false; }
  if st[10] < st[9] || st[10] > st[11] { return false; }
  if st[12] < 0 || st[13] < 0 || st[14] < 0 { return false; }
  return true;
}

// Writing v to word i of o keeps kept(st, o). True when o is shorter than 15 (shape(o) and dyn_ok(o) are false
// there) or i is outside the header words 0..14; on words 7, 8, 10, 12..14 when v meets the bound dyn_ok checks on
// word i against the other words of o; false on the shape words and on 6, 9, 11. Small and transparent: header writers
// prove it with linear facts and get kept from bud_map::sh's ensures, without revealing dyn_ok.
pub fn wok(o: [i64], i: i64, v: i64) -> bool
{
  if len(o) < 15 || i < 0 || i >= 15 { return true; }
  if i == 12 || i == 13 || i == 14 { return v >= 0; }
  if i == 10 { return o[9] <= v && v <= o[11]; }
  if i == 8 { return -1 <= v && v < o[7]; }
  if i == 7 { return o[8] < v && v <= o[6]; }
  return false;
}

// Header words 0..14 of a and b are equal except word w (w = -1: all of them); false if either is shorter than 15.
pub fn hdr_same(a: [i64], b: [i64], w: i64) -> bool
{
  if len(a) < 15 || len(b) < 15 { return false; }
  return (w == 0 || a[0] == b[0]) && (w == 1 || a[1] == b[1]) && (w == 2 || a[2] == b[2]) &&
    (w == 3 || a[3] == b[3]) && (w == 4 || a[4] == b[4]) && (w == 5 || a[5] == b[5]) &&
    (w == 6 || a[6] == b[6]) && (w == 7 || a[7] == b[7]) && (w == 8 || a[8] == b[8]) &&
    (w == 9 || a[9] == b[9]) && (w == 10 || a[10] == b[10]) && (w == 11 || a[11] == b[11]) &&
    (w == 12 || a[12] == b[12]) && (w == 13 || a[13] == b[13]) && (w == 14 || a[14] == b[14]);
}

// The shape words (0..6, 9, 11) and the length of a and b are equal; false if either is shorter than 15.
pub fn shape_same(a: [i64], b: [i64]) -> bool
{
  if len(a) < 15 || len(a) != len(b) { return false; }
  return a[0] == b[0] && a[1] == b[1] && a[2] == b[2] && a[3] == b[3] && a[4] == b[4] && a[5] == b[5] &&
    a[6] == b[6] && a[9] == b[9] && a[11] == b[11];
}

// st after a mutator applied to o, as a proposition: the same length, shape(o) carried over to st and dyn_ok(o) carried
// over to st. So valid(o) gives valid(st), and kept chains through a sequence of mutators. Writers prove the shape term
// by congruence (shape_same, then shape_w applied to equal words) and the dyn_ok term with one `reveal dyn_ok` at
// each write exit, after asserting the header words it reads.
pub fn kept(st: [i64], o: [i64]) -> bool
{
  return len(st) == len(o) && (!shape(o) || shape(st)) && (!dyn_ok(o) || dyn_ok(st));
}

// st[p] = v when p is past the 16 header words and in range, else nothing (ent_u16::wr with the header excluded). The
// index slot writers use it: on a valid store every slot address is >= 16, so the low bound only matters on a buffer
// that is not valid, and it gives the header frame on any buffer. Same cost as wr (two compares).
pub fn wr16(inout st: [i64], p: i64, v: i64) -> ()
  ensures len(st) == len(old(st))
  ensures (16 <= p && p < len(st)) ==> st[p] == v
  ensures forall k in 0..len(old(st)): k == p || st[k] == old(st)[k]
  ensures len(old(st)) >= 15 ==> hdr_same(st, old(st), -1)
  ensures kept(st, old(st))
{
  reveal dyn_ok;
  if p < 16 || p >= len(st) { return; }
  st[p] = v;
}

// ---- entry fields ----

// Absolute word address of field f of entry e; -1 if e is outside the entry capacity or f is not in 0..20.
fn ea(st: [i64], e: i64, f: i64) -> i64
  ensures result >= -1 && result <= 1099511627776
  ensures (valid(st) && 0 <= e && e < st[6] && 0 <= f && f < 20) ==> (16 <= result && result - f + 20 <= len(st))
  ensures (valid(st) && !(0 <= e && e < st[6] && 0 <= f && f < 20)) ==> result == -1
{
  // the valid premise of the ensures reads header words 5, 6 and the length through shape_w
  reveal shape_w;
  // len(st) < 7 reads header words 5, 6 as 0 through hd (cap 0, so -1); otherwise both are in range.
  if len(st) < 7 { return -1; }
  let cap: i64 = c32(st[6]);
  if e < 0 || e >= cap || f < 0 || f >= 20 { return -1; }
  return c32(st[5]) + e * 20 + f;
}

// Address of field 0 of entry e (fields 0..19 follow it); -1 if e is outside the entry capacity.
pub fn field_addr(st: [i64], e: i64) -> i64
  ensures result >= -1 && result <= 1099511627776
{ return ea(st, e, 0); }

// Fast-path base of entry e: the address of field 0 when the whole entry (fields 0..19) lies in st past the 16 header
// words, else -1. When it is not -1, ef(st, e, f) == st[result + f] and set_ef(st, e, f, v) is st[result + f] = v for
// every f in 0..20, on any buffer: ea gives the same address, rd/wr are in range, and entry writes never reach the
// header words 5/6 that ea reads, so the base stays valid across the run (header writes to other words do not move
// it). Callers use it for one range check per run of field accesses and keep the ef/set_ef code as the fallback.
pub fn eb(st: [i64], e: i64) -> i64
  ensures result == -1 || (16 <= result && result + 20 <= len(st))
  ensures (valid(st) && 0 <= e && e < st[6]) ==> result >= 16
{
  let a: i64 = ea(st, e, 0);
  if a < 16 || a > len(st) - 20 { return -1; }
  return a;
}

// Field f of entry e; -1 if e or f is out of range (so a bad link reads as "none").
pub fn ef(st: [i64], e: i64, f: i64) -> i64
{
  let a: i64 = ea(st, e, f);
  if a < 0 { return -1; }
  return crate::ent_u16::rd(st, a);
}

// Writes past the 16 header words only (ea is >= 16 on a valid store; a lower address is skipped like -1), so the
// header frame holds on any buffer.
pub fn set_ef(inout st: [i64], e: i64, f: i64, v: i64) -> ()
  ensures len(st) == len(old(st))
  ensures len(old(st)) >= 15 ==> hdr_same(st, old(st), -1)
  ensures kept(st, old(st))
{
  reveal dyn_ok;
  let a: i64 = ea(st, e, f);
  if a < 16 { return; }
  crate::ent_u16::wr(inout st, a, v);
}

// Writes a live entry with no key, no blob, no children, no links and zero scalars. With fresh, the arena regions
// (key off 4 / key cap 18, blob off 12 / blob cap 19) are cleared too; a reused entry keeps them so that a new key or
// blob that fits is written back into its old region (no arena growth under steady churn).
fn fill_entry(inout st: [i64], e: i64, owner: i64, ogen: i64, egen: i64, fresh: bool) -> ()
  ensures len(st) == len(old(st))
  ensures len(old(st)) >= 15 ==> hdr_same(st, old(st), -1)
  ensures kept(st, old(st))
{
  let b: i64 = eb(st, e);
  if b >= 0 {
    // Same words in the same order as the wr path below (see eb).
    st[b] = 1; st[b + 1] = owner; st[b + 2] = ogen; st[b + 3] = egen;
    st[b + 5] = 0; st[b + 6] = 0;
    st[b + 7] = -1; st[b + 8] = -1; st[b + 9] = -1; st[b + 10] = -1;
    st[b + 11] = 0; st[b + 13] = 0; st[b + 14] = 0; st[b + 15] = 0; st[b + 16] = 0; st[b + 17] = 0;
    if fresh { st[b + 4] = 0; st[b + 12] = 0; st[b + 18] = 0; st[b + 19] = 0; }
    // the header frame first, so dyn_ok's body reads equal words (no store chain in the dyn_ok goal)
    assert len(old(st)) < 15 || hdr_same(st, old(st), -1);
    reveal dyn_ok;
    return;
  }
  let a: i64 = ea(st, e, 0);
  // below 16 only on a buffer that is not valid (see set_ef): skipped so the header frame holds on any buffer
  if a < 16 { reveal dyn_ok; return; }
  crate::ent_u16::wr(inout st, a, 1);
  crate::ent_u16::wr(inout st, a + 1, owner);
  crate::ent_u16::wr(inout st, a + 2, ogen);
  crate::ent_u16::wr(inout st, a + 3, egen);
  crate::ent_u16::wr(inout st, a + 5, 0);
  crate::ent_u16::wr(inout st, a + 6, 0);
  crate::ent_u16::wr(inout st, a + 7, -1);
  crate::ent_u16::wr(inout st, a + 8, -1);
  crate::ent_u16::wr(inout st, a + 9, -1);
  crate::ent_u16::wr(inout st, a + 10, -1);
  crate::ent_u16::wr(inout st, a + 11, 0);
  crate::ent_u16::wr(inout st, a + 13, 0);
  crate::ent_u16::wr(inout st, a + 14, 0);
  crate::ent_u16::wr(inout st, a + 15, 0);
  crate::ent_u16::wr(inout st, a + 16, 0);
  crate::ent_u16::wr(inout st, a + 17, 0);
  if fresh {
    crate::ent_u16::wr(inout st, a + 4, 0);
    crate::ent_u16::wr(inout st, a + 12, 0);
    crate::ent_u16::wr(inout st, a + 18, 0);
    crate::ent_u16::wr(inout st, a + 19, 0);
  }
  assert len(old(st)) < 15 || hdr_same(st, old(st), -1);
  reveal dyn_ok;
}

// ---- init ----

// Writes an empty state (header, slot table cleared, roots 0..2). Returns 0, or min_words() if st is too small
// (nothing written).
// Writes an empty state (header, slot table cleared, roots 0..2). Returns 0, or min_words() if st is too small
// (nothing written). A 0 result establishes the I0 header fact valid(st) (L3 P07). The power-of-two test on header
// word 4 is a bit operation the solver does not decide for a symbolic s, so the constructor closes with one O(1)
// valid check (never false for s = layout_slots(l); it runs once per store, not per call).
pub fn init_store(inout st: [i64]) -> i64
  ensures len(st) == len(old(st))
  ensures result == 0 || result == 232
  ensures result != 0 || valid(st)
{
  let l: i64 = len(st);
  let s: i64 = layout_slots(l);
  if s == 0 { return 232; }
  let ab: i64 = 16 + 11 * s;
  set_hd(inout st, 0, 1112884307);
  set_hd(inout st, 1, 1);
  set_hd(inout st, 2, l);
  set_hd(inout st, 3, 16);
  set_hd(inout st, 4, s);
  set_hd(inout st, 5, 16 + s);
  set_hd(inout st, 6, s / 2);
  set_hd(inout st, 7, 3);
  set_hd(inout st, 8, -1);
  set_hd(inout st, 9, ab);
  set_hd(inout st, 10, ab);
  set_hd(inout st, 11, l);
  set_hd(inout st, 12, 3);
  set_hd(inout st, 13, 0);
  set_hd(inout st, 14, 0);
  set_hd(inout st, 15, 0);
  let mut i: i64 = 0;
  while i < s
    invariant 0 <= i && i <= s && s <= 4294967296 && len(st) == l
    decreases s - i
  {
    crate::ent_u16::wr(inout st, 16 + i, 0);
    i = i + 1;
  }
  fill_entry(inout st, 0, -1, 0, 0, true);
  fill_entry(inout st, 1, -1, 0, 0, true);
  fill_entry(inout st, 2, -1, 0, 0, true);
  if !valid(st) { return 232; }
  return 0;
}

// ---- capacity ----

// Would a fresh layout(n) hold the given counts?
fn fits_fresh(n: i64, live: i64, used: i64, lw: i64, ents: i64, wds: i64) -> bool
  requires 0 <= n && n <= 2199023255552
  requires 0 <= live && live <= 4294967296 && 0 <= used && used <= 4294967296
  requires 0 <= lw && lw <= 1099511627776 && 0 <= ents && ents <= 4294967296
  requires 0 <= wds && wds <= 1099511627776
{
  let s: i64 = layout_slots(n);
  if s == 0 { return false; }
  if live + ents > s / 2 { return false; }
  if used + ents > s * 3 / 4 { return false; }
  return lw + wds <= n - (16 + 11 * s);
}

// 0 if `entries` more entries and `words` more arena words fit now; otherwise the smallest N (doubling from
// 2*len(st), at least 464) whose fresh layout fits the counts, capped at 2^40 words (the array length bound, SPEC
// arrays). The growth size is decided here: the host allocates exactly N words (L3 P13b); the ensures give the
// geometric step (N >= 2*len below 2^39 words) that makes growth amortized linear. At the cap a layout that still
// does not fit makes grow_copy return 2 (or the host refuse N <= len), so the op fails with the old state kept.
pub fn need(st: [i64], entries: i64, words: i64) -> i64
  ensures result == 0 || (464 <= result && result <= 1099511627776)
  ensures result == 0 || len(st) > 549755813888 || result >= 2 * len(st)
{
  let ents: i64 = c32(entries);
  let wds: i64 = c40(words);
  // Header words 4..14 are in range when len(st) >= 15; shorter buffers read them as 0 through hd.
  let mut live: i64 = 0;
  let mut used: i64 = 0;
  let mut lw: i64 = 0;
  let mut cap: i64 = 0;
  let mut slots: i64 = 0;
  let mut top: i64 = 0;
  let mut ae: i64 = 0;
  if len(st) >= 15 {
    live = c32(st[12]); used = c32(st[13]); lw = c40(st[14]); cap = c32(st[6]);
    slots = c32(st[4]); top = c40(st[10]); ae = c40(st[11]);
  } else {
    live = c32(hd(st, 12)); used = c32(hd(st, 13)); lw = c40(hd(st, 14)); cap = c32(hd(st, 6));
    slots = c32(hd(st, 4)); top = c40(hd(st, 10)); ae = c40(hd(st, 11));
  }
  if live + ents <= cap && used + ents <= slots * 3 / 4 && wds <= ae - top { return 0; }
  let mut n: i64 = c40(len(st));
  if n < 232 { n = 232; }
  n = n * 2;
  while n < 1099511627776 && !fits_fresh(n, live, used, lw, ents, wds)
    invariant 464 <= n && n <= 2199023255552
    invariant len(st) > 1099511627776 || n >= 2 * len(st)
    decreases 2199023255552 - n
  {
    n = n * 2;
  }
  if n > 1099511627776 { n = 1099511627776; }
  return n;
}

// Words a grow copy wrote into a fresh store (copy accounting, L3 P13b): 20 per entry up to the entry top plus the
// arena words in use. Read from the header only (0 for a buffer shorter than the header); O(1).
pub fn copy_words(st: [i64]) -> i64
  ensures 0 <= result
{
  if len(st) < 15 { return 0; }
  let a: i64 = c40(st[10]) - c40(st[9]);
  let mut w: i64 = 20 * c32(st[7]);
  if a > 0 { w = w + a; }
  return w;
}

// ---- arena ----

// Appends src[s..e) to the arena. Returns its absolute offset, or -1 (nothing written) if the range is invalid or the
// arena is full. Adds the words to the live count. The arena top and end are checked against 16 <= top <= end <=
// len(st) (true on a valid store), so the copy never reaches the header and the new top stays in the arena bounds.
pub fn arena_put(inout st: [i64], src: [i64], s: i64, e: i64) -> i64
  ensures len(st) == len(old(st))
  ensures len(old(st)) >= 15 ==> (shape_same(st, old(st)) && st[7] == old(st)[7] && st[8] == old(st)[8] &&
    st[12] == old(st)[12] && st[13] == old(st)[13])
  ensures dyn_ok(old(st)) ==> dyn_ok(st)
  ensures kept(st, old(st))
{
  if s < 0 || e < s || e > len(src) { return -1; }
  let n: i64 = e - s;
  let top: i64 = hd(st, 10);
  let aend: i64 = hd(st, 11);
  if top < 16 || aend > len(st) || top > aend { return -1; }
  if n > aend - top { return -1; }
  // Proof that the per-word rd/wr is redundant: the checks above give 16 <= top <= aend <= len(st) and
  // n <= aend - top, so top + n <= aend <= len(st); and s >= 0, e <= len(src), n == e - s give s + n == e <= len(src).
  // Every st[top + k] and src[s + k] with 0 <= k < n is therefore in range, and past the header words.
  let mut k: i64 = 0;
  while k < n
    invariant 0 <= k && k <= n && n == e - s && 0 <= s && s <= e && e <= len(src) && 16 <= top && top + n <= len(st)
    invariant len(st) == len(old(st))
    invariant forall j in 0..16: st[j] == old(st)[j]
    decreases n - k
  {
    st[top + k] = src[s + k];
    k = k + 1;
  }
  let lw: i64 = c40(hd(st, 14));
  set_hd(inout st, 10, top + n);
  set_hd(inout st, 14, lw + n);
  // the written words first, so the revealed bodies read plain equalities (no store chain in their goals)
  assert len(old(st)) < 15 || (shape_same(st, old(st)) && st[7] == old(st)[7] && st[8] == old(st)[8] &&
    st[12] == old(st)[12] && st[13] == old(st)[13] && st[10] == top + n && st[14] == lw + n);
  reveal dyn_ok;
  return top;
}

// ---- entry allocation ----

// Takes an entry from the free list or the entry top and fills it (live, owner, owner generation, zero fields; the
// generation of a reused entry is kept, a fresh one starts at 1). Returns the entry index or -1 if the table is full.
pub fn entry_alloc(inout st: [i64], owner: i64, ogen: i64) -> i64
  ensures len(st) == len(old(st))
  ensures len(old(st)) >= 15 ==> (shape_same(st, old(st)) && st[10] == old(st)[10] && st[13] == old(st)[13] &&
    st[14] == old(st)[14])
  ensures dyn_ok(old(st)) ==> dyn_ok(st)
  ensures kept(st, old(st))
{
  let cap: i64 = c32(hd(st, 6));
  let top: i64 = c32(hd(st, 7));
  let fh: i64 = hd(st, 8);
  let live: i64 = c32(hd(st, 12));
  if fh >= 3 && fh < top && fh < cap {
    let b: i64 = eb(st, fh);
    let mut g: i64 = 0;
    let mut nx: i64 = 0;
    if b >= 0 { g = st[b + 3]; nx = st[b + 8]; } else { g = ef(st, fh, 3); nx = ef(st, fh, 8); }
    if nx < -1 || nx >= top { nx = -1; }
    set_hd(inout st, 8, nx);
    fill_entry(inout st, fh, owner, ogen, g, false);
    set_hd(inout st, 12, live + 1);
    assert len(old(st)) < 15 || (shape_same(st, old(st)) && st[7] == old(st)[7] && st[10] == old(st)[10] &&
      st[13] == old(st)[13] && st[14] == old(st)[14] && st[8] == nx && st[12] == live + 1);
    reveal dyn_ok;
    return fh;
  }
  if top < cap {
    fill_entry(inout st, top, owner, ogen, 1, true);
    set_hd(inout st, 7, top + 1);
    set_hd(inout st, 12, live + 1);
    assert len(old(st)) < 15 || (shape_same(st, old(st)) && st[8] == old(st)[8] && st[10] == old(st)[10] &&
      st[13] == old(st)[13] && st[14] == old(st)[14] && st[7] == top + 1 && st[12] == live + 1);
    reveal dyn_ok;
    return top;
  }
  return -1;
}

// Puts a live non-root entry on the free list and bumps its generation (bud_map::remove frees the children first). The
// key and blob regions (fields 4/18, 12/19) stay with the entry for reuse.
pub fn entry_free(inout st: [i64], e: i64) -> ()
  ensures len(st) == len(old(st))
  ensures len(old(st)) >= 15 ==> (shape_same(st, old(st)) && st[7] == old(st)[7] && st[10] == old(st)[10] &&
    st[13] == old(st)[13] && st[14] == old(st)[14])
  ensures dyn_ok(old(st)) ==> dyn_ok(st)
  ensures kept(st, old(st))
{
  if e < 3 { return; }
  let top: i64 = c32(hd(st, 7));
  if e >= top { return; }
  let b: i64 = eb(st, e);
  if b >= 0 {
    // Same reads and writes as the ef/set_ef path below (see eb); len(st) >= 36 here, so header word 8 is st[8].
    if st[b] != 1 { return; }
    let g: i64 = st[b + 3];
    let head: i64 = st[8];
    st[b] = 0;
    st[b + 3] = wrapping_add(g, 1);
    st[b + 8] = head;
    st[8] = e;
    let live: i64 = c32(st[12]);
    if live > 0 { st[12] = live - 1; }
    assert len(old(st)) < 15 || (shape_same(st, old(st)) && st[7] == old(st)[7] && st[10] == old(st)[10] &&
      st[13] == old(st)[13] && st[14] == old(st)[14] && st[8] == e && (st[12] == old(st)[12] || st[12] >= 0));
    reveal dyn_ok;
    return;
  }
  if ef(st, e, 0) != 1 { return; }
  let g: i64 = ef(st, e, 3);
  let head: i64 = hd(st, 8);
  set_ef(inout st, e, 0, 0);
  set_ef(inout st, e, 3, wrapping_add(g, 1));
  set_ef(inout st, e, 8, head);
  set_hd(inout st, 8, e);
  let live: i64 = c32(hd(st, 12));
  if live > 0 { set_hd(inout st, 12, live - 1); }
  assert len(old(st)) < 15 || (shape_same(st, old(st)) && st[7] == old(st)[7] && st[10] == old(st)[10] &&
    st[13] == old(st)[13] && st[14] == old(st)[14] && st[8] == e && (st[12] == old(st)[12] || st[12] >= 0));
  reveal dyn_ok;
}
