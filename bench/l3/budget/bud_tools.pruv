// L3-10 M8: the per-turn tool activity sets (spec §4.3 noteTool / forgetTurn, §9). toolSeen lives in the bud_map world:
// root 2 holds one entry per turnId (in insertion order), whose children are the activityIds seen in that turn
// (in insertion order). Keys are (array, start, length) and have been validated by the caller.
//
// note_tool status: 0 already seen (noteTool returns without CURRENT), 1 inserted (the caller runs CURRENT and then
// bud_charge::add_tool), -N Grow(N) (nothing written; grow the buffer and retry), 2 invalid.
// The turn entry is created together with its first activity, so a turn set is never left empty; a missing or stale
// budget still consumes the dedup key (§15 #6).

pub fn note_tool(inout st: [i64], tkey: [i64], tks: i64, tkn: i64, akey: [i64], aks: i64, akn: i64) -> i64
{
  let t: i64 = crate::bud_map::find(st, 2, tkey, tks, tkn);
  // known turn: one hash of the activity key for both the lookup and the insert
  if t >= 0 { return crate::bud_map::add_absent(inout st, t, akey, aks, akn, 1, crate::bud_store::c32(akn)); }
  // new turn: the turn and its first activity together
  let words: i64 = crate::bud_store::c32(tkn) + crate::bud_store::c32(akn);
  let nd: i64 = crate::bud_map::make_room(inout st, 2, words);
  if nd != 0 {
    if nd < 0 { return 2; }
    return -nd;
  }
  let tt: i64 = crate::bud_map::add(inout st, 2, tkey, tks, tkn);
  if tt < 0 { return 2; }
  let x: i64 = crate::bud_map::add(inout st, tt, akey, aks, akn);
  if x < 0 { return 2; }
  return 1;
}

// forgetTurn(turnId): removes the turn and frees its activities, O(turnId length + activities of the turn).
// 1 removed, 0 absent.
pub fn forget_turn(inout st: [i64], tkey: [i64], tks: i64, tkn: i64) -> i64
{
  let t: i64 = crate::bud_map::find(st, 2, tkey, tks, tkn);
  if t < 0 { return 0; }
  crate::bud_map::remove(inout st, t);
  return 1;
}
