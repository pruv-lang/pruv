// Budget raise (B:410–446) and the person's decision on a halted budget, decide extend / end (B:449–477).
trusted rust fn unit(fxn: i64) -> Vec<i64> ! alloc, io
  ensures true
  = "::bud_facts::unit";

pub fn unit_ok(v: Vec<i64>) -> bool
  ensures result ==> len(v) == 6
{
  if len(v) != 6 { return false; }
  if vec_get::<i64>(v, 0) != 0 { return false; }
  let mut i: i64 = 1;
  while i < 6
    invariant 1 <= i && i <= 6 && len(v) == 6
    decreases 6 - i
  {
    let value: i64 = vec_get::<i64>(v, i);
    if value < 0 || value > 9007199254740991 { return false; }
    i = i + 1;
  }
  return true;
}

fn rd(a: [i64], i: i64) -> i64
{ return crate::ent_u16::rd(a, i); }

fn wr(inout a: [i64], i: i64, v: i64) -> ()
{ crate::ent_u16::wr(inout a, i, v); }

fn emit(inout fx: [i64], tag: i64) -> ()
{
  let n: i64 = crate::bud_store::c40(rd(fx, 0));
  wr(inout fx, n + 1, tag);
  wr(inout fx, 0, n + 1);
}

fn raise_unlimited(inout st: [i64], off: i64, ce: i64, inout fx: [i64], inout out: [i64]) -> i64
  requires 0 <= off && off <= 1099511627776
{
  if rd(st, off + 2) == 1 {
    wr(inout out, 0, 1);
    return 0;
  }
  let armed: bool = ce >= 0 && crate::bud_store::ef(st, ce, 16) == 1;
  let mut words: i64 = 2;
  if armed { words = 3; }
  if crate::bud_store::c40(rd(fx, 0)) + words > len(fx) { return 3; }
  wr(inout st, off + 2, 1);
  if armed {
    // bud_clock has no disarm-only operation. Field 16 is armed; the since fields stay intact.
    crate::bud_store::set_ef(inout st, ce, 16, 0);
    emit(inout fx, 13);
  }
  emit(inout fx, 20);
  wr(inout out, 0, 2);
  return 0;
}

// SETTLE (raise only; decide's extend refreshes without it, B:466), REFRESH, the header write-back, the activeSince
// text drop when the interval kind left 1, and HALT_TIME's nested halt. Room was reserved by the caller.
fn refresh_raised(inout st: [i64], se: i64, ce: i64, sk: [i64], ss: i64, sn: i64, bk: [i64], bs: i64, bn: i64, settle: bool, now: i64, inout bv: [i64], inout fx: [i64]) -> i64 ! alloc, io
{
  let off: i64 = crate::bud_lifecycle::blob_at(st, se);
  let old_kind: i64 = rd(st, off + 16);
  crate::bud_lifecycle::view_in(st, off, inout bv);
  if settle {
    let _added: i64 = crate::bud_clock::settle_at(inout st, ce, sk, ss, sn, now, inout bv, inout fx);
  }
  let r: i64 = crate::bud_clock::refresh_at(inout st, ce, sk, ss, sn, now, inout bv, inout fx);
  if r != 0 && r != 4 { return 2; }
  wr(inout st, off + 8, rd(bv, 4));
  wr(inout st, off + 16, rd(bv, 5));
  wr(inout st, off + 17, rd(bv, 6));
  if old_kind == 1 && rd(bv, 5) != 1 {
    let b: [i64] = crate::bud_lifecycle::blob_copy(st, se);
    let header: [i64] = crate::ent_u16::slice(b, 0, 24);
    let p: i64 = crate::bud_lifecycle::str_at(b, 3);
    let n: i64 = crate::bud_store::c32(rd(b, p));
    let next: [i64] = crate::bud_lifecycle::rewrite(b, header, true, b, crate::bud_store::c40(p + 1), n);
    let stored: i64 = crate::bud_lifecycle::store(inout st, sk, ss, sn, next);
    if stored != 0 { return 2; }
  }
  if r == 4 {
    // halt reserves one word of slack beyond its 7 + 2D effect words.
    let h: i64 = crate::bud_halt::halt(inout st, sk, ss, sn, bk, bs, bn, 0, now, inout bv, inout fx);
    if h == 6 { return 6; }
    if h != 0 { return 2; }
  }
  return 0;
}

// Checked before any record write. The scalar guard also proves the multiplication fits i64.
fn scaled(v: Vec<i64>, i: i64, size: i64) -> i64
  requires 0 <= i && i < len(v) && 2 <= size && size <= 8
{
  let value: i64 = vec_get::<i64>(v, i);
  if value < 0 || value > 9007199254740991 { return -1; }
  let product: i64 = value * size;
  if product > 9007199254740991 { return -1; }
  return product;
}

pub fn raise(inout st: [i64], sk: [i64], ss: i64, sn: i64, bk: [i64], bs: i64, bn: i64, size: i64, now: i64, inout bv: [i64], inout fx: [i64], inout out: [i64]) -> i64 ! alloc, io
{
  if len(out) < 1 { return 3; }
  let se: i64 = crate::bud_lifecycle::current_entry(st, sk, ss, sn, bk, bs, bn);
  if se < 0 {
    wr(inout out, 0, 1);
    return 0;
  }
  let off: i64 = crate::bud_lifecycle::blob_at(st, se);
  let state: i64 = rd(st, off);
  if state == 2 || size == 1 {
    wr(inout out, 0, 1);
    return 0;
  }
  if len(fx) < 1 || rd(fx, 0) < 0 || rd(fx, 0) >= len(fx) { return 3; }
  if size != 0 && size != 2 && size != 4 && size != 8 { return 2; }
  let ce: i64 = crate::bud_clock::clock_of(st, bk, bs, bn);
  if size == 0 { return raise_unlimited(inout st, off, ce, inout fx, inout out); }
  let may_refresh: bool = ce >= 0 && crate::bud_store::ef(st, ce, 14) == 1 && rd(st, off + 2) != 1;
  let mut room: i64 = 0;
  let mut plan: i64 = 0;
  // Plan Grow before asking unit. Delay any rehash until the answer is valid and the refresh is needed.
  if may_refresh {
    if state == 0 { room = crate::bud_halt::halt_words(st, se); }
    if rd(st, off + 16) == 1 { room = crate::bud_store::c40(room + crate::bud_lifecycle::blob_n(st, se)); }
    if room > 0 {
      plan = crate::bud_map::room_plan(st, 0, room);
      if plan > 0 { return crate::bud_lifecycle::grow(plan); }
    }
  }
  let v: Vec<i64> = unit(rd(fx, 0));
  if !unit_ok(v) { return 2; }
  let mut time_raised: bool = false;
  let mut changed: bool = false;
  let mut i: i64 = 1;
  while i < 6
    invariant 1 <= i && i <= 6 && len(v) == 6
    decreases 6 - i
  {
    let next: i64 = scaled(v, i, size);
    if next < 0 { return 2; }
    if next > rd(st, off + 2 + i) {
      changed = true;
      if i == 1 { time_raised = true; }
    }
    i = i + 1;
  }
  if !changed {
    wr(inout out, 0, 1);
    return 0;
  }
  let refresh: bool = time_raised && may_refresh;
  let fxn: i64 = crate::bud_store::c40(rd(fx, 0));
  if fxn + 2 > len(fx) { return 3; }
  if refresh {
    if len(bv) < 7 || fxn + 18 > len(fx) { return 3; }
    if !crate::bud_halt::rec_ok_in(st, off, crate::bud_lifecycle::blob_n(st, se)) { return 2; }
    if room > 0 {
      let reserved: i64 = crate::bud_map::room_apply(inout st, plan, 0, room);
      if reserved > 0 { return 2; }
    }
  }
  let mut j: i64 = 1;
  while j < 6
    invariant 1 <= j && j <= 6 && len(v) == 6
    decreases 6 - j
  {
    let next: i64 = scaled(v, j, size);
    let at: i64 = off + 2 + j;
    if next > rd(st, at) { wr(inout st, at, next); }
    j = j + 1;
  }
  if refresh {
    let r: i64 = refresh_raised(inout st, se, ce, sk, ss, sn, bk, bs, bn, true, now, inout bv, inout fx);
    if r != 0 { return r; }
    // A nested halt may use its slack word; changed must still fit, else the halt capacity status.
    if crate::bud_store::c40(rd(fx, 0)) + 2 > len(fx) { return 6; }
  }
  emit(inout fx, 20);
  wr(inout out, 0, 2);
  return 0;
}

// ---- decide(sessionId, budgetId, choice, size) (B:449-477) ----
//
// out = [6, code]: 0 {ok: true}, 1 {ok: false, code: 'not-found'}, 2 {ok: false, code: 'not-halted'}.
// Effects beyond the shared ones: [36] save, [38, reason (-1 null, 0..4), wake (0, 1)] queueContinue, [39] dropHeld.
// releaseHeld(session, budgetId) is a synchronous host fact asked at its place among the effects; the host answers
// 0 (nothing held) or 1 (released). Any other answer is invalid: status 2, by then the record is already stored (the
// fact is the host's own side effect, so the call cannot be undone; KD-P31-3).
trusted rust fn release_held(k: [i64], ks: i64, kn: i64, bk: [i64], bs: i64, bn: i64, fxn: i64) -> i64 ! io
  ensures true
  = "::decide_facts::release_held";

fn emit3(inout fx: [i64], a: i64, b: i64, c: i64) -> ()
{
  emit(inout fx, a);
  emit(inout fx, b);
  emit(inout fx, c);
}

fn decided(inout out: [i64], code: i64) -> i64
{
  wr(inout out, 0, 6);
  wr(inout out, 1, code);
  return 0;
}

// Position of string 5's length word, relative to the record start at off. O(1): five strides.
fn rest_rel(st: [i64], off: i64) -> i64
  requires 0 <= off && off <= 1099511627776
  ensures 0 <= result && result <= 1099511627776
{
  let mut p: i64 = 24;
  let mut i: i64 = 0;
  while i < 5
    invariant 0 <= i && i <= 5 && 0 <= p && p <= 1099511627776
    decreases 5 - i
  {
    p = crate::bud_store::c40(p + 1 + crate::bud_lifecycle::str_words(i, rd(st, crate::bud_store::c40(off + p))));
    i = i + 1;
  }
  return p;
}

// Checked before any write: limit + size * unit for one key stays a safe integer, else -1 (KD-P31-2).
fn added(cur: i64, value: i64, size: i64) -> i64
  requires 1 <= size && size <= 8
{
  if cur < 0 || cur > 9007199254740991 { return -1; }
  if value < 0 || value > 9007199254740991 { return -1; }
  let product: i64 = value * size;
  if product > 9007199254740991 - cur { return -1; }
  return cur + product;
}

// extend: limits[k] += size * unit[k] for every key (or the unlimited mark, no unit query), state open, halt
// deleted, save, changed, REFRESH (no SETTLE), queueContinue(reason, no wake) when the halt had a reason, then
// releaseHeld and, when nothing was held, queueContinue(null, wake). Room for the stripped record, a since-text
// rewrite and a nested halt is planned before the unit query (Grow: nothing written, no query); the sums are checked
// before the first write. O(key length + record) plus a nested halt's cost.
fn extend(inout st: [i64], se: i64, sk: [i64], ss: i64, sn: i64, bk: [i64], bs: i64, bn: i64, size: i64, now: i64, inout bv: [i64], inout fx: [i64], inout out: [i64]) -> i64 ! alloc, io
{
  if size != 0 && size != 1 && size != 2 && size != 4 && size != 8 { return 2; }
  if len(bv) < 7 { return 3; }
  let fxn: i64 = crate::bud_store::c40(rd(fx, 0));
  // save + changed (2), REFRESH's timerSet (3) or a nested halt (12 at its entry), two queueContinue records (6).
  // A nested halt's own capacity check may still leave too little for the records: then status 6, as in raise.
  if fxn + 20 > len(fx) { return 3; }
  let off: i64 = crate::bud_lifecycle::blob_at(st, se);
  let n: i64 = crate::bud_lifecycle::blob_n(st, se);
  let f: crate::bud_halt::TextFrame = crate::bud_halt::text_frame(st, off, n);
  if !f.valid { return 2; }
  let p5: i64 = rest_rel(st, off);
  let mut t: i64 = 0;
  if f.tail != 0 { t = 2; }
  let m: i64 = crate::bud_store::c40(p5 + 1 + t);
  if m > n { return 2; }
  let ce: i64 = crate::bud_clock::clock_of(st, bk, bs, bn);
  let mut room: i64 = m;
  if ce >= 0 {
    // An unlimited budget never re-halts for time (arm_in skips it), so only a limited extend reserves halt room.
    if size != 0 { room = crate::bud_store::c40(room + crate::bud_halt::halt_words(st, se)); }
    if rd(st, off + 16) == 1 { room = crate::bud_store::c40(room + n); }
  }
  let plan: i64 = crate::bud_map::room_plan(st, 0, room);
  if plan > 0 { return crate::bud_lifecycle::grow(plan); }
  // The valid frame already proved the halt prefix (rest length other than 0 and 2), so its reason word is read
  // directly instead of re-walking the stopped ids.
  let rl: i64 = rd(st, crate::bud_store::c40(off + p5));
  let mut reason: i64 = -1;
  if rl != 0 && rl != 2 {
    reason = rd(st, crate::bud_store::c40(off + p5 + 2));
    if reason < 0 || reason > 4 { reason = -1; }
  }
  let mut o: [i64] = crate::ent_u16::slice(st, off, crate::bud_store::c40(off + m));
  if size == 0 {
    wr(inout o, 2, 1);
  } else {
    let v: Vec<i64> = unit(fxn);
    if !unit_ok(v) { return 2; }
    let mut i: i64 = 1;
    while i < 6
      invariant 1 <= i && i <= 6 && len(v) == 6
      decreases 6 - i
    {
      let next: i64 = added(rd(o, 2 + i), vec_get::<i64>(v, i), size);
      if next < 0 { return 2; }
      wr(inout o, 2 + i, next);
      i = i + 1;
    }
  }
  wr(inout o, 0, 0);
  wr(inout o, p5, t);
  if t == 2 {
    wr(inout o, p5 + 1, rd(st, off + f.tail));
    wr(inout o, p5 + 2, rd(st, off + f.tail + 1));
  }
  let reserved: i64 = crate::bud_map::room_apply(inout st, plan, 0, room);
  if reserved > 0 { return 2; }
  let stored: i64 = crate::bud_lifecycle::store(inout st, sk, ss, sn, o);
  if stored != 0 { return 2; }
  emit(inout fx, 36);
  emit(inout fx, 20);
  if ce >= 0 {
    let se2: i64 = crate::bud_lifecycle::current_entry(st, sk, ss, sn, bk, bs, bn);
    let ce2: i64 = crate::bud_clock::clock_of(st, bk, bs, bn);
    if se2 < 0 || ce2 < 0 { return 2; }
    let r: i64 = refresh_raised(inout st, se2, ce2, sk, ss, sn, bk, bs, bn, false, now, inout bv, inout fx);
    if r != 0 { return r; }
  }
  // A nested halt may use its slack word; both queueContinue records must still fit, else the halt capacity status.
  if crate::bud_store::c40(rd(fx, 0)) + 6 > len(fx) { return 6; }
  if reason >= 0 { emit3(inout fx, 38, reason, 0); }
  let held: i64 = release_held(sk, ss, sn, bk, bs, bn, rd(fx, 0));
  if held != 0 && held != 1 { return 2; }
  if held == 0 { emit3(inout fx, 38, -1, 1); }
  return decided(inout out, 0);
}

// end: CLOSE('user-end') (SETTLE, closed, ended = {user-end, now}, DROP; the halt section stays), dropHeld, save,
// changed. The closed record is never longer than the stored one, so its room is reserved before CLOSE (Grow:
// nothing written). O(key length + record).
fn end_budget(inout st: [i64], se: i64, sk: [i64], ss: i64, sn: i64, now: i64, inout bv: [i64], inout fx: [i64], inout out: [i64]) -> i64 ! alloc
{
  if len(bv) < 7 { return 3; }
  // CLOSE's clock part (2 words) and dropHeld + save + changed (3)
  if crate::bud_store::c40(rd(fx, 0)) + 6 > len(fx) { return 3; }
  let b: [i64] = crate::bud_lifecycle::blob_copy(st, se);
  if !crate::bud_halt::rec_ok_in(b, 0, len(b)) { return 2; }
  let g: i64 = crate::bud_lifecycle::reserve(inout st, len(b) + 8);
  if g != 0 { return crate::bud_lifecycle::grow(g); }
  let r: [i64] = crate::bud_lifecycle::close_rec(inout st, sk, ss, sn, b, 2, now, inout bv, inout fx);
  let w: i64 = crate::bud_lifecycle::store(inout st, sk, ss, sn, r);
  if w != 0 { return w; }
  emit(inout fx, 39);
  emit(inout fx, 36);
  emit(inout fx, 20);
  return decided(inout out, 0);
}

// decide: extend with size 0 (unlimited) or 1, 2, 4, 8 (an absent size is 1); end when `end`. Not the session's
// current budget (absent session or budget, other id): not-found; current but not halted: not-halted.
pub fn decide(inout st: [i64], sk: [i64], ss: i64, sn: i64, bk: [i64], bs: i64, bn: i64, end: bool, size: i64, now: i64, inout bv: [i64], inout fx: [i64], inout out: [i64]) -> i64 ! alloc, io
{
  if len(out) < 2 { return 3; }
  if len(fx) < 1 || rd(fx, 0) < 0 || rd(fx, 0) >= len(fx) { return 3; }
  let se: i64 = crate::bud_lifecycle::current_entry(st, sk, ss, sn, bk, bs, bn);
  if se < 0 { return decided(inout out, 1); }
  let off: i64 = crate::bud_lifecycle::blob_at(st, se);
  if rd(st, off) != 1 { return decided(inout out, 2); }
  if end { return end_budget(inout st, se, sk, ss, sn, now, inout bv, inout fx, inout out); }
  return extend(inout st, se, sk, ss, sn, bk, bs, bn, size, now, inout bv, inout fx, inout out);
}
