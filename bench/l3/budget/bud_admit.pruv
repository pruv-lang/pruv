// L3 P11: import admission for the resident budget store (bud_store layout, bud_map slot words).
// Separate module so that roots which never import a buffer (root_m4) do not carry its proof.

// A link field: -1 (none) or an entry below top.
fn link_ok(v: i64, top: i64) -> bool
{ return v >= -1 && v < top; }

// The packed key of a live entry: kn units in words(kn) words at off, lanes past kn in the last word zero.
fn key_pad_ok(st: [i64], off: i64, kn: i64) -> bool
  requires 0 <= kn && kn <= 1073741824
{
  if off < 0 || off > 1099511627776 { return false; }
  let r: i64 = kn - (kn / 4) * 4;
  if r == 0 { return true; }
  let w: i64 = crate::ent_u16::rd(st, off + crate::bud_keys::words(kn) - 1);
  if r == 1 { return band(w, 281474976710655) == 0; }
  if r == 2 { return band(w, 4294967295) == 0; }
  return band(w, 65535) == 0;
}

// A region of cap words at off lies inside the arena [ab, at) (cap 0 needs no place: nothing is ever written there).
// No requires, so that ent_i1 can use it in a contract; the bounds on ab and at are tested first.
fn span_w(off: i64, cap: i64, ab: i64, at: i64) -> bool
{
  return cap == 0 || (cap > 0 && cap <= 4294967296 && 0 <= ab && at <= 1099511627776 && ab <= off && off <= at &&
    cap <= at - off);
}

// I1 checks the base and any flagged extension. The addresses use the same clamped
// header words as bud_store. Owner state and key padding are checked by entry_ok.
pub opaque fn ent_i1(st: [i64], e: i64, top: i64, ab: i64, at: i64) -> bool
{
  if len(st) < 16 || e < 0 || e > 4294967296 || st[5] < 0 || st[5] > 4294967312 { return false; }
  // Admission checks the header first, so capacity is already in the c32 range.
  if st[6] < 0 || st[6] > 4294967296 { return false; }
  let ext_delta: i64 = 10 * st[6];
  if st[5] > 4294967296 {
    let b: i64 = 4294967296 + 10 * e;
    return ent_w(st, b, b + ext_delta, e, top, ab, at);
  }
  let b: i64 = st[5] + 10 * e;
  return ent_w(st, b, b + ext_delta, e, top, ab, at);
}

// I1 word checks given the base and extension addresses.
pub fn ent_w(st: [i64], b: i64, x: i64, e: i64, top: i64, ab: i64, at: i64) -> bool
{
  if b < 16 || b > len(st) - 10 { return false; }
  let f0: i64 = st[b];
  if f0 != 0 && f0 != 1 { return false; }
  if e < 3 && (f0 != 1 || st[b + 1] != -1) { return false; }
  let xk: i64 = st[b + 9];
  // Express the quantified span check on xk itself. A nonempty key region must
  // fit even with either flag value, so xk is at most 2 * remaining_words + 1.
  if xk < 0 || xk > 8589934593 { return false; }
  let ko: i64 = st[b + 4];
  if xk >= 2 && !(0 <= ab && at <= 1099511627776 && ab <= ko && ko <= at && xk <= 2 * (at - ko) + 1) { return false; }
  let has_ext: bool = crate::bud_store::has_x(xk);
  if has_ext && (x < 16 || x > len(st) - 10 || !span_w(st[x + 1], st[x + 9], ab, at)) { return false; }
  if f0 == 0 { return link_ok(st[b + 8], top); }
  if e >= 3 && (st[b + 1] < 0 || st[b + 1] >= top) { return false; }
  let kn: i64 = st[b + 5];
  // Twice xk counts key units plus two when the flag is set.
  if kn < 0 || kn > 1073741824 || kn > 2 * xk || (has_ext && kn > 2 * xk - 2) { return false; }
  if !link_ok(st[b + 7], top) || !link_ok(st[b + 8], top) { return false; }
  if !has_ext { return link_ok(-1, top); }
  if x < 16 || x > len(st) - 10 { return false; }
  if st[x + 2] < 0 || st[x + 2] > st[x + 9] { return false; }
  return link_ok(st[x + 7], top) && link_ok(st[x + 8], top) && st[x] >= 0;
}

// One entry of admit(): 2 dead, 1 live, 0 free, or a negative class code.
// An absent extension has an empty blob span, no children, and zero count.
fn entry_ok(st: [i64], e: i64, top: i64, ab: i64, at: i64) -> i64
  requires 0 <= ab && ab <= at && at <= 1099511627776
  requires 0 <= e && e < top && top <= 4294967296
  ensures result <= 2
  ensures result >= 0 ==> ent_i1(st, e, top, ab, at)
{
  reveal ent_i1;
  if len(st) < 16 || st[5] < 0 || st[5] > 4294967312 || st[6] < 0 || st[6] > 4294967296 { return -3; }
  let eb: i64 = crate::bud_store::c32(st[5]);
  let cap: i64 = crate::bud_store::c32(st[6]);
  let b: i64 = eb + 10 * e;
  let x: i64 = b + 10 * cap;
  if b < 16 || b > len(st) - 10 { return -3; }
  let f0: i64 = st[b];
  if f0 != 0 && f0 != 1 { return -3; }
  if e < 3 && (f0 != 1 || st[b + 1] != -1) { return -2; }
  let xk: i64 = st[b + 9];
  if xk < 0 || xk > 8589934593 { return -5; }
  let kc: i64 = crate::bud_store::kcap_of(xk);
  let ko: i64 = st[b + 4];
  if !span_w(ko, kc, ab, at) { return -5; }
  let has_ext: bool = crate::bud_store::has_x(xk);
  if has_ext && (x < 16 || x > len(st) - 10 || !span_w(st[x + 1], st[x + 9], ab, at)) { return -6; }
  if f0 == 0 {
    if !link_ok(st[b + 8], top) { return -8; }
    assert ent_w(st, b, x, e, top, ab, at);
    return 0;
  }
  let mut kind: i64 = 1;
  if e >= 3 {
    let ow: i64 = st[b + 1];
    if ow < 0 || ow >= top { return -4; }
    let bo: i64 = eb + 10 * ow;
    if bo < 16 || bo > len(st) - 10 { return -4; }
    if st[bo] != 1 {
      if st[bo] != 0 || st[b + 2] == st[bo + 3] { return -4; }
      // A pending owner must still have a child list (M4 admission case 16).
      if !crate::bud_store::has_x(st[bo + 9]) { return -4; }
      let xo: i64 = bo + 10 * cap;
      if xo < 16 || xo > len(st) - 10 { return -4; }
      if st[xo + 7] < 3 || st[xo + 7] >= top || st[xo] <= 0 { return -4; }
      kind = 2;
    }
  }
  let kn: i64 = st[b + 5];
  if kn < 0 || kn > 1073741824 || kn > 4 * kc { return -5; }
  if kn > 0 && !key_pad_ok(st, ko, kn) { return -5; }
  if has_ext && (st[x + 2] < 0 || st[x + 2] > st[x + 9]) { return -6; }
  if !link_ok(st[b + 7], top) || !link_ok(st[b + 8], top) { return -7; }
  if has_ext && (!link_ok(st[x + 7], top) || !link_ok(st[x + 8], top) || st[x] < 0) { return -7; }
  assert ent_w(st, b, x, e, top, ab, at);
  return kind;
}

// Import admission: I0 (bud_store::valid) and the I1 per-entry facts the accessors rely on, in one linear pass over
// the entries, the free list and the slot table. Returns the number of live entries (roots included, pending dead
// children excluded), or the first
// failed class: -1 header, -2 roots/top, -3 entry state, -4 owner, -5 key span/padding, -6 blob span, -7 links,
// -8 free list, -9 slot word, -10 header counts (words 12, 13, 14). cnt[0..3] gets the entries, free-list steps and
// slots visited (admission work is linear in top + slots). Functional properties (I2: index completeness, child
// lists, key uniqueness) are model tests, not admission.
//
// On success the header words admit bounds by are plain words (0 <= st[5] <= 2^32 + 16, top = st[7] <= 2^32,
// 0 <= st[9] <= st[10] <= 2^40) and every entry below top meets ent_i1 against them (I1, L3 P13a.10).
pub fn admit(st: [i64], inout cnt: [i64]) -> i64
  ensures result >= 0 ==> (crate::bud_store::valid(st) && result <= 4294967296)
  ensures result >= 0 ==> (len(st) >= 232 && 0 <= st[5] && st[5] <= 4294967312 && 3 <= st[7] && st[7] <= 4294967296 &&
    0 <= st[9] && st[9] <= st[10] && st[10] <= 1099511627776)
  ensures result >= 0 ==> (forall e in 0..st[7]: ent_i1(st, e, st[7], st[9], st[10]))
{
  crate::ent_u16::wr(inout cnt, 0, 0);
  crate::ent_u16::wr(inout cnt, 1, 0);
  crate::ent_u16::wr(inout cnt, 2, 0);
  if !crate::bud_store::valid(st) { return -1; }
  let s: i64 = crate::bud_store::c32(crate::bud_store::hd(st, 4));
  let sb: i64 = crate::bud_store::c32(crate::bud_store::hd(st, 3));
  // valid gives len(st) >= 232 and these bounds (shape_w, dyn_ok); they are tested here as plain words so that the
  // ensures can name them without revealing either predicate. No valid store fails them.
  let top: i64 = st[7];
  let ab: i64 = st[9];
  let at: i64 = st[10];
  if st[5] < 0 || st[5] > 4294967312 || top > 4294967296 || ab < 0 || at < ab || at > 1099511627776 { return -1; }
  if top < 3 { return -2; }
  let mut live: i64 = 0;
  let mut dead: i64 = 0;
  let mut e: i64 = 0;
  while e < top
    invariant 0 <= e && e <= top && top <= 4294967296 && 0 <= live && 0 <= dead && live + dead <= e
    invariant 0 <= ab && ab <= at && at <= 1099511627776
    invariant forall j in 0..e: ent_i1(st, j, top, ab, at)
    decreases top - e
  {
    let r: i64 = entry_ok(st, e, top, ab, at);
    if r < 0 { return r; }
    // entry_ok's ensures gives ent_i1 at e as the opaque symbol; the invariant's forall expands it, so equate the two
    reveal ent_i1;
    if r == 1 { live = live + 1; }
    if r == 2 { dead = dead + 1; }
    e = e + 1;
  }
  crate::ent_u16::wr(inout cnt, 0, top);
  let mut free: i64 = 0;
  let mut f: i64 = crate::bud_store::hd(st, 8);
  while f >= 0
    invariant 0 <= free && free <= top && top <= 4294967296
    decreases top - free
  {
    if free >= top || f < 3 || f >= top { return -8; }
    if crate::bud_store::ef(st, f, 0) != 0 { return -8; }
    free = free + 1;
    f = crate::bud_store::ef(st, f, 8);
  }
  crate::ent_u16::wr(inout cnt, 1, free);
  if f != -1 || free + live + dead != top { return -8; }
  let mut used: i64 = 0;
  let mut i: i64 = 0;
  while i < s
    invariant 0 <= i && i <= s && s <= 4294967296 && 0 <= used && used <= i && 0 <= sb && sb <= 4294967296
    decreases s - i
  {
    let w: i64 = crate::ent_u16::rd(st, sb + i);
    if w != 0 {
      used = used + 1;
      if w != -1 {
        if w < 0 { return -9; }
        let se: i64 = band(w, 4294967295) - 1;
        // Only the entry index is an I1 fact. Descendant slots can remain after eager and lazy removal.
        // Lookups re-check state, owner, owner generation, hash and key (bud_map::entry_matches_w).
        if se < 0 || se >= top { return -9; }
      }
    }
    i = i + 1;
  }
  crate::ent_u16::wr(inout cnt, 2, s);
  if crate::bud_store::hd(st, 12) != live || crate::bud_store::hd(st, 13) != used { return -10; }
  if crate::bud_store::hd(st, 14) < 0 || crate::bud_store::hd(st, 14) > at - ab { return -10; }
  return live;
}
