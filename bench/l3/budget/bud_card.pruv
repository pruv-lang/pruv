// L3-10 M11: work cards (RequestBudgets.setCard / hasCard, reference/backend-request-budget.ts 140-160, 476-518;
// REQUEST_BUDGET_SPEC §4.7, §9, §15 rows 18-21).
// Two encodings meet here:
//  - stored values (the budget and the built card) are tagged V words (ABI.md): 1 undefined, 2 null, 3 false, 4 true,
//    5 int [5,v], 6 string [6,n,units], 7 number bits [7,bits], 8 array [8,n,V..], 9 object [9,n,(kn,units,V)*];
//  - the setCard inputs (card, lang, by) are JB byte packets (see the JB section): strings stay WTF-8 and numbers stay
//    raw f64 bits, so validation reads UTF-16 lengths at the semantic edges and never widens a unit to a word.
// Every V read goes through rd/nx and every write through crate::ent_u16::wr, so all functions are total whatever the
// words or bytes contain. No `mod` lines (the root declares ent_u16, bud_num, bud_text, bud_date).
//
// Named sub-operations (all pub):
//   v_end(v, at) -> i64                     end offset of the V value at `at`, -1 if malformed / out of range (depth <= 32)
//   obj_get(v, at, key: str) -> i64         offset of the value of the LAST pair with key `key` in the V object at `at`
//   budget_pos(v, at, end) -> BudgetPos    offsets of id, state and card in an exact budget V region (last pair wins)
//   j_ok(b) -> bool                         admission: b is exactly one well-formed JB value (canonical WTF-8, depth <= 32)
//   j_end(b, at) -> i64                     end of the JB value at `at`, -1 if malformed
//   card_at(b, at) -> Keys                  value positions of the card fields, one pass over the pairs (last pair wins)
//   text_ok(b, p) -> bool                   validText: string whose trimmed length (UTF-16 units) is 1..300; no allocation
//   lines_ok(b, p, min, max) -> bool        validLines: array, count in min..max (checked first), every element text_ok
//   check_required(b, f) -> i64             0 ok, 1 deliverable, 2 done
//   check_optional(b, f) -> i64             0 ok, else the first failing of 3 targets, 4 verify, 5 conflicts, 6 state
//   validate(b, f) -> i64                   required then optional
//   put_card_words(inout o, p0, b, f, by, by_at, iso: bud_date::IsoParts) -> i64   write at p0 and return the end (empty o: size pass)
//   build(b, f, by, by_at, now_ms) -> [i64] the stored card (deliverable, done, updatedAt, targets?, verify?, conflicts?, state?, by?)
//   lang_code(lang) -> i64                  1 iff the packet is the string "en" (empty packet = absent -> 0)
//   truthy(v, at) -> bool                   JS truthiness of a V value
//   judge(found, closed, card, at, lang) -> Judged   setCard checks and error text
//   set_card(found, closed, card, at, lang, by, by_at, now_ms) -> SetCard
//   has_card(budget, at) -> bool            Boolean(budget.card)
//   put_card(budget, at, card) -> [i64]     budget object with "card" replaced in place, or appended at the end

pub struct SetCard { kind: i64, used_now: bool, card: [i64], error: [i64] }

// ================= V words (stored budget) =================

fn rd(v: [i64], i: i64) -> i64
{ return crate::ent_u16::rd(v, i); }

// the word after the tag at `at` (0 if at is out of range)
fn nx(v: [i64], at: i64) -> i64
{
  if at < 0 || at >= len(v) { return 0; }
  return rd(v, at + 1);
}

// ================= structure =================

fn v_end_d(v: [i64], at: i64, depth: i64) -> i64
  requires 0 <= depth && depth <= 33
  ensures result == -1 || (at < result && result <= len(v))
  decreases 33 - depth
{
  if depth > 32 { return -1; }
  let n: i64 = len(v);
  if at < 0 || at >= n { return -1; }
  let t: i64 = v[at];
  if t >= 1 && t <= 4 { return at + 1; }
  if t == 5 || t == 7 {
    if n - at < 2 { return -1; }
    return at + 2;
  }
  if t == 6 {
    if n - at < 2 { return -1; }
    let c: i64 = v[at + 1];
    if c < 0 || c > n - at - 2 { return -1; }
    return at + 2 + c;
  }
  if t == 8 || t == 9 {
    if n - at < 2 { return -1; }
    let cnt: i64 = v[at + 1];
    if cnt < 0 || cnt > n - at - 2 { return -1; }
    let mut pos: i64 = at + 2;
    let mut i: i64 = 0;
    while i < cnt
      invariant 0 <= i && i <= cnt && at < pos && pos <= n && n == len(v) && 0 <= at && at < n && 0 <= depth && depth <= 32
      decreases cnt - i
    {
      let mut vs: i64 = pos;
      if t == 9 {
        if pos >= n { return -1; }
        let kn: i64 = v[pos];
        if kn < 0 || kn > n - pos - 1 { return -1; }
        vs = pos + 1 + kn;
      }
      let mut e: i64 = -1;
      if depth <= 31 && vs < n && v[vs] == 6 && n - vs >= 2 {
        // a string element: its end inline (the same result as the recursive call below)
        let c: i64 = v[vs + 1];
        if c < 0 || c > n - vs - 2 { return -1; }
        e = vs + 2 + c;
      } else {
        e = v_end_d(v, vs, depth + 1);
      }
      if e < 0 { return -1; }
      if e <= pos { return -1; }
      pos = e;
      i = i + 1;
    }
    return pos;
  }
  return -1;
}

pub fn v_end(v: [i64], at: i64) -> i64
  ensures result == -1 || (at < result && result <= len(v))
{
  return v_end_d(v, at, 1);
}

// every unit of v[s .. s+n) is in 0..65535 (u is iff band(u, -65536) == 0, and OR keeps that over all units)
fn units_ok(v: [i64], s: i64, n: i64) -> bool
  requires 0 <= s && 0 <= n && s + n <= len(v)
{
  let mut acc: i64 = 0;
  let mut j: i64 = 0;
  while j < n
    invariant 0 <= j && j <= n && 0 <= s && s + n <= len(v)
    decreases n - j
  {
    acc = bor(acc, v[s + j]);
    j = j + 1;
  }
  return band(acc, -65536) == 0;
}

// v_end_d plus the ABI unit range of every string and key (tag 6: units 0..65535). Load-time only: the resident
// walks (budget_pos) take the stored words as checked here and skip strings in O(1).
fn v_end_u(v: [i64], at: i64, depth: i64) -> i64
  requires 0 <= depth && depth <= 33
  ensures result == -1 || (at < result && result <= len(v))
  decreases 33 - depth
{
  if depth > 32 { return -1; }
  let n: i64 = len(v);
  if at < 0 || at >= n { return -1; }
  let t: i64 = v[at];
  if t >= 1 && t <= 4 { return at + 1; }
  if t == 5 || t == 7 {
    if n - at < 2 { return -1; }
    return at + 2;
  }
  if t == 6 {
    if n - at < 2 { return -1; }
    let c: i64 = v[at + 1];
    if c < 0 || c > n - at - 2 { return -1; }
    if !units_ok(v, at + 2, c) { return -1; }
    return at + 2 + c;
  }
  if t == 8 || t == 9 {
    if n - at < 2 { return -1; }
    let cnt: i64 = v[at + 1];
    if cnt < 0 || cnt > n - at - 2 { return -1; }
    let mut pos: i64 = at + 2;
    let mut i: i64 = 0;
    while i < cnt
      invariant 0 <= i && i <= cnt && at < pos && pos <= n && n == len(v) && 0 <= at && at < n && 0 <= depth && depth <= 32
      decreases cnt - i
    {
      let mut vs: i64 = pos;
      if t == 9 {
        if pos >= n { return -1; }
        let kn: i64 = v[pos];
        if kn < 0 || kn > n - pos - 1 { return -1; }
        if !units_ok(v, pos + 1, kn) { return -1; }
        vs = pos + 1 + kn;
      }
      let e: i64 = v_end_u(v, vs, depth + 1);
      if e < 0 { return -1; }
      if e <= pos { return -1; }
      pos = e;
      i = i + 1;
    }
    return pos;
  }
  return -1;
}

// End of a stored budget V (-1 = refused): the shape, the unit range, and depth counted from 2, because setCard
// returns the stored budget inside {ok, budget} (ABI depth <= 32 for that result).
pub fn v_stored_end(v: [i64], at: i64) -> i64
  ensures result == -1 || (at < result && result <= len(v))
{
  return v_end_u(v, at, 2);
}

fn tag(v: [i64], at: i64) -> i64
{
  if at < 0 { return 0; }
  return rd(v, at);
}

// the key `kn, units` at pos equals the ASCII literal s
fn key_is(v: [i64], pos: i64, s: str) -> bool
  requires 0 <= pos && pos <= 1099511627776
{
  let m: i64 = len(s);
  if m > 1024 { return false; }
  let n: i64 = len(v);
  let mut j: i64 = 0;
  if pos < n && m <= n - pos - 1 {
    // the whole key is in range: one check (same comparisons as the total path below)
    if v[pos] != m { return false; }
    while j < m
      invariant 0 <= j && j <= m && m == len(s) && 0 <= pos && pos < n && m <= n - pos - 1 && n == len(v)
      decreases m - j
    {
      if v[pos + 1 + j] != s[j] { return false; }
      j = j + 1;
    }
    return true;
  }
  if rd(v, pos) != m { return false; }
  while j < m
    invariant 0 <= j && j <= m && m == len(s) && m <= 1024 && 0 <= pos && pos <= 1099511627776
    decreases m - j
  {
    if rd(v, pos + 1 + j) != s[j] { return false; }
    j = j + 1;
  }
  return true;
}

// the value at `at` is the string equal to the ASCII literal s (candidate for ent_value)
fn str_is(v: [i64], at: i64, s: str) -> bool
{
  if at < 0 || at >= 1099511627776 { return false; }
  if rd(v, at) != 6 { return false; }
  return key_is(v, at + 1, s);
}

pub fn obj_get(v: [i64], at: i64, key: str) -> i64
  ensures result == -1 || (0 <= result && result < len(v))
{
  let n: i64 = len(v);
  if n > 1099511627776 { return -1; }
  if at < 0 || n - at < 2 { return -1; }
  if v[at] != 9 { return -1; }
  let cnt: i64 = v[at + 1];
  if cnt < 0 || cnt > n - at - 2 { return -1; }
  let mut pos: i64 = at + 2;
  let mut i: i64 = 0;
  let mut found: i64 = -1;
  while i < cnt
    invariant 0 <= i && i <= cnt && at < pos && pos <= n && n == len(v) && n <= 1099511627776 && 0 <= at && (found == -1 || (0 <= found && found < n))
    decreases cnt - i
  {
    if pos >= n { return -1; }
    let kn: i64 = v[pos];
    if kn < 0 || kn > n - pos - 1 { return -1; }
    let vs: i64 = pos + 1 + kn;
    let e: i64 = v_end(v, vs);
    if e < 0 { return -1; }
    if key_is(v, pos, key) { found = vs; }
    pos = e;
    i = i + 1;
  }
  return found;
}

pub struct BudgetPos { ok: bool, id: i64, state: i64, card: i64, card_end: i64 }

fn no_budget_pos() -> BudgetPos
  ensures !result.ok
{
  return BudgetPos { ok: false, id: -1, state: -1, card: -1, card_end: -1 };
}

pub fn budget_pos(v: [i64], at: i64, end: i64) -> BudgetPos
  ensures !result.ok || (0 <= at && at + 2 <= end && end <= len(v))
  ensures !result.ok || ((result.card == -1 && result.card_end == -1) || (at <= result.card && result.card < result.card_end && result.card_end <= end))
{
  if end > len(v) || at < 0 || end < 2 || at > end - 2 { return no_budget_pos(); }
  if v[at] != 9 { return no_budget_pos(); }
  let cnt: i64 = v[at + 1];
  if cnt < 0 || cnt > end - at - 2 { return no_budget_pos(); }
  let mut pos: i64 = at + 2;
  let mut i: i64 = 0;
  let mut id: i64 = -1;
  let mut state: i64 = -1;
  let mut card: i64 = -1;
  let mut card_end: i64 = -1;
  while i < cnt
    invariant 0 <= i && i <= cnt && 0 <= at && at + 2 <= pos && pos <= end && end <= len(v)
    invariant (card == -1 && card_end == -1) || (at <= card && card < card_end && card_end <= pos)
    decreases cnt - i
  {
    if pos >= end { return no_budget_pos(); }
    let kn: i64 = v[pos];
    if kn < 0 || kn > end - pos - 1 { return no_budget_pos(); }
    let vs: i64 = pos + 1 + kn;
    // field values sit at depth 3 of the setCard result {ok, budget: {.., key: value}} (the bound of v_stored_end)
    let e: i64 = v_end_d(v, vs, 3);
    if e < 0 || e > end { return no_budget_pos(); }
    // ASCII keys: id, state, card.
    if kn == 2 && v[pos + 1] == 105 && v[pos + 2] == 100 { id = vs; }
    else if kn == 5 && v[pos + 1] == 115 && v[pos + 2] == 116 && v[pos + 3] == 97 && v[pos + 4] == 116 && v[pos + 5] == 101 { state = vs; }
    else if kn == 4 && v[pos + 1] == 99 && v[pos + 2] == 97 && v[pos + 3] == 114 && v[pos + 4] == 100 {
      card = vs;
      card_end = e;
    }
    pos = e;
    i = i + 1;
  }
  if pos != end { return no_budget_pos(); }
  return BudgetPos { ok: true, id: id, state: state, card: card, card_end: card_end };
}

// present = the key exists and its value is not undefined (TS `input.x !== undefined`)
fn present(v: [i64], p: i64) -> bool
{
  return p >= 0 && rd(v, p) != 1;
}
// ================= JB byte packets (card, lang, by) =================
// The setCard inputs card, lang and by are JB packets ([u8], big-endian): 1 undefined, 2 null, 3 false, 4 true,
// 7 + 8 bytes raw f64 bits (every JS number), 6 + u32 byte length + WTF-8 bytes, 8 + u32 count + values,
// 9 + u32 count + (u32 key byte length + key WTF-8 + value)*. Depth <= 32, one value, no trailing bytes.
// Strings stay WTF-8 (canonical: no overlongs, <= U+10FFFF, lone surrogates as ED A0..BF xx, a lead surrogate is
// never directly followed by a trail surrogate), so the UTF-16 length is 1 unit per 1..3-byte sequence and 2 per
// 4-byte sequence: lengths, trim and the projection to UTF-16 V words all work on the bytes at the edges.

fn bt(b: [u8], i: i64) -> i64
  ensures 0 <= result && result <= 255 && (result == 0 || (0 <= i && i < len(b)))
{
  if i < 0 || i >= len(b) { return 0; }
  return b[i];
}

fn cont(x: i64) -> bool
{
  return x >= 128 && x <= 191;
}

// the 8 bytes b[i..i+8) are all ASCII (one word load; the hand baseline's `is_ascii` fast path)
fn ascii8(b: [u8], i: i64) -> bool
  requires 0 <= i && i <= len(b) - 8
{
  return band(load_be(b, i, 8), -9187201950435737472) == 0;
}

// the 32 bytes b[i..i+32) are all ASCII (four word loads, one test)
fn ascii32(b: [u8], i: i64) -> bool
  requires 0 <= i && i <= len(b) - 32
{
  let w: i64 = bor(bor(load_be(b, i, 8), load_be(b, i + 8, 8)), bor(load_be(b, i + 16, 8), load_be(b, i + 24, 8)));
  return band(w, -9187201950435737472) == 0;
}

// canonical WTF-8 over b[s..e)
fn wtf8_ok(b: [u8], s: i64, e: i64) -> bool
  requires 0 <= s && s <= e && e <= len(b)
{
  let mut i: i64 = s;
  let mut lead: bool = false;
  while i < e
    invariant s <= i && i <= e && e <= len(b)
    decreases e - i
  {
    let c: i64 = b[i];
    if c < 128 {
      i = i + 1;
      lead = false;
      let i0: i64 = i;
      while i <= e - 32 && ascii32(b, i)
        invariant i0 <= i && s <= i && i <= e && e <= len(b)
        decreases e - i
      { i = i + 32; }
      while i <= e - 8 && ascii8(b, i)
        invariant i0 <= i && s <= i && i <= e && e <= len(b)
        decreases e - i
      { i = i + 8; }
    } else if c < 194 {
      return false;
    } else if c < 224 {
      if i + 1 >= e || !cont(b[i + 1]) { return false; }
      i = i + 2;
      lead = false;
    } else if c < 240 {
      if i + 2 >= e { return false; }
      let c1: i64 = b[i + 1];
      if !cont(c1) || !cont(b[i + 2]) { return false; }
      if c == 224 && c1 < 160 { return false; }
      if c == 237 {
        // ED A0..AF = lead surrogate, ED B0..BF = trail surrogate; a lead directly before a trail is a pair
        if c1 >= 176 && lead { return false; }
        lead = c1 >= 160 && c1 <= 175;
      } else {
        lead = false;
      }
      i = i + 3;
    } else if c < 245 {
      if i + 3 >= e { return false; }
      let d1: i64 = b[i + 1];
      if !cont(d1) || !cont(b[i + 2]) || !cont(b[i + 3]) { return false; }
      if c == 240 && d1 < 144 { return false; }
      if c == 244 && d1 > 143 { return false; }
      i = i + 4;
      lead = false;
    } else {
      return false;
    }
  }
  return true;
}

// end of the `u32 length + bytes` run at p (a string body or an object key), -1 if out of range or (chk) not WTF-8
fn s_end(b: [u8], p: i64, chk: bool) -> i64
  ensures result == -1 || (0 <= p && p + 4 <= result && result <= len(b))
{
  let n: i64 = len(b);
  if n > 1099511627776 { return -1; }
  if p < 0 || p > n - 4 { return -1; }
  let m: i64 = load_be(b, p, 4);
  if m > n - p - 4 { return -1; }
  let e: i64 = p + 4 + m;
  if chk && !wtf8_ok(b, p + 4, e) { return -1; }
  return e;
}

fn j_end_d(b: [u8], at: i64, depth: i64, chk: bool) -> i64
  requires 0 <= depth && depth <= 33
  ensures result == -1 || (0 <= at && at < result && result <= len(b))
  decreases 33 - depth
{
  if depth > 32 { return -1; }
  let n: i64 = len(b);
  if n > 1099511627776 { return -1; }
  if at < 0 || at >= n { return -1; }
  let t: i64 = b[at];
  if t >= 1 && t <= 4 { return at + 1; }
  if t == 7 {
    if n - at < 9 { return -1; }
    return at + 9;
  }
  if t == 6 { return s_end(b, at + 1, chk); }
  if t == 8 || t == 9 {
    if n - at < 5 { return -1; }
    let cnt: i64 = load_be(b, at + 1, 4);
    let mut pos: i64 = at + 5;
    // every element takes at least one byte
    if cnt > n - pos { return -1; }
    let mut i: i64 = 0;
    while i < cnt
      invariant 0 <= i && i <= cnt && at < pos && pos <= n && n == len(b) && 0 <= at && 0 <= depth && depth <= 32
      decreases cnt - i
    {
      let mut vs: i64 = pos;
      if t == 9 {
        vs = s_end(b, pos, chk);
        if vs < 0 { return -1; }
      }
      let e: i64 = j_end_d(b, vs, depth + 1, chk);
      if e < 0 { return -1; }
      pos = e;
      i = i + 1;
    }
    return pos;
  }
  return -1;
}

// end of the (admitted) value at `at`, structure only; -1 if malformed
pub fn j_end(b: [u8], at: i64) -> i64
  ensures result == -1 || (0 <= at && at < result && result <= len(b))
{
  return j_end_d(b, at, 1, false);
}

// admission: b is exactly one well-formed value (structure, depth, canonical WTF-8)
pub fn j_ok(b: [u8]) -> bool
{
  return len(b) > 0 && j_end_d(b, 0, 1, true) == len(b);
}

// admission of a packet whose top value will sit at depth d of a stored / returned V (depth <= 32 overall)
pub fn j_ok_at(b: [u8], d: i64) -> bool
  requires 1 <= d && d <= 32
{
  return len(b) > 0 && j_end_d(b, 0, d, true) == len(b);
}

// b[ks..ks+kn) equals the ASCII literal s
fn kb_is(b: [u8], ks: i64, kn: i64, s: str) -> bool
  requires 0 <= ks && 0 <= kn && ks + kn <= len(b)
{
  if kn != len(s) { return false; }
  let mut j: i64 = 0;
  while j < kn
    invariant 0 <= j && j <= kn && kn == len(s) && 0 <= ks && ks + kn <= len(b)
    decreases kn - j
  {
    if b[ks + j] != s[j] { return false; }
    j = j + 1;
  }
  return true;
}

// the value at p is the string equal to the ASCII literal s
fn b_str_is(b: [u8], p: i64, s: str) -> bool
{
  if bt(b, p) != 6 { return false; }
  let e: i64 = s_end(b, p + 1, false);
  if e < 0 { return false; }
  return kb_is(b, p + 5, e - p - 5, s);
}

// Value positions of up to six keys of the object at `at` (LAST pair wins, -1 = no such key), found in one pass over
// the pairs. Unused slots repeat an earlier key (the first matching slot takes the pair).
pub struct Keys { p0: i64, p1: i64, p2: i64, p3: i64, p4: i64, p5: i64 }

fn no_keys() -> Keys
{
  return Keys { p0: -1, p1: -1, p2: -1, p3: -1, p4: -1, p5: -1 };
}

fn scan(b: [u8], at: i64, k0: str, k1: str, k2: str, k3: str, k4: str, k5: str) -> Keys
{
  let n: i64 = len(b);
  if n > 1099511627776 || at < 0 || n - at < 5 { return no_keys(); }
  if b[at] != 9 { return no_keys(); }
  let cnt: i64 = load_be(b, at + 1, 4);
  let mut p0: i64 = -1;
  let mut p1: i64 = -1;
  let mut p2: i64 = -1;
  let mut p3: i64 = -1;
  let mut p4: i64 = -1;
  let mut p5: i64 = -1;
  let mut pos: i64 = at + 5;
  let mut i: i64 = 0;
  while i < cnt
    invariant 0 <= i && i <= cnt && 0 <= pos && pos <= n && n == len(b)
    decreases cnt - i
  {
    let vs: i64 = s_end(b, pos, false);
    if vs < 0 { return no_keys(); }
    let e: i64 = j_end(b, vs);
    if e < 0 { return no_keys(); }
    let ks: i64 = pos + 4;
    let kn: i64 = vs - ks;
    if kb_is(b, ks, kn, k0) { p0 = vs; }
    else if kb_is(b, ks, kn, k1) { p1 = vs; }
    else if kb_is(b, ks, kn, k2) { p2 = vs; }
    else if kb_is(b, ks, kn, k3) { p3 = vs; }
    else if kb_is(b, ks, kn, k4) { p4 = vs; }
    else if kb_is(b, ks, kn, k5) { p5 = vs; }
    pos = e;
    i = i + 1;
  }
  return Keys { p0: p0, p1: p1, p2: p2, p3: p3, p4: p4, p5: p5 };
}

// present = the key exists and its value is not undefined (TS `input.x !== undefined`)
fn b_present(b: [u8], p: i64) -> bool
{
  return p >= 0 && bt(b, p) != 1;
}

// ================= text (WTF-8 bytes) =================

// byte length of the ECMAScript trim unit (WhiteSpace + LineTerminator) starting at i inside [i, e), 0 if none
fn ws_at(b: [u8], i: i64, e: i64) -> i64
  requires 0 <= i && i < e && e <= len(b)
  ensures 0 <= result && result <= e - i
{
  let c: i64 = b[i];
  if c == 32 || (c >= 9 && c <= 13) { return 1; }
  if c < 194 { return 0; }
  if i + 1 < e && c == 194 && b[i + 1] == 160 { return 2; }
  if i + 2 < e {
    let c1: i64 = b[i + 1];
    let c2: i64 = b[i + 2];
    if c == 225 && c1 == 154 && c2 == 128 { return 3; }
    if c == 226 && c1 == 128 && ((c2 >= 128 && c2 <= 138) || c2 == 168 || c2 == 169 || c2 == 175) { return 3; }
    if c == 226 && c1 == 129 && c2 == 159 { return 3; }
    if c == 227 && c1 == 128 && c2 == 128 { return 3; }
    if c == 239 && c1 == 187 && c2 == 191 { return 3; }
  }
  return 0;
}

// byte length of the trim unit ending at e inside [s, e), 0 if none. The lead bytes C2/E1/E2/E3/EF are never
// continuation bytes, so a match is a whole sequence.
fn ws_before(b: [u8], s: i64, e: i64) -> i64
  requires 0 <= s && s < e && e <= len(b)
  ensures 0 <= result && result <= e - s
{
  let c: i64 = b[e - 1];
  if c == 32 || (c >= 9 && c <= 13) { return 1; }
  if c < 128 { return 0; }
  if e - s >= 2 && c == 160 && b[e - 2] == 194 { return 2; }
  if e - s >= 3 && ws_at(b, e - 3, e) == 3 { return 3; }
  return 0;
}

fn tr_s(b: [u8], s: i64, e: i64) -> i64
  requires 0 <= s && s <= e && e <= len(b)
  ensures s <= result && result <= e
{
  let mut i: i64 = s;
  while i < e
    invariant s <= i && i <= e && e <= len(b)
    decreases e - i
  {
    let w: i64 = ws_at(b, i, e);
    if w == 0 { return i; }
    i = i + w;
  }
  return i;
}

fn tr_e(b: [u8], s: i64, e: i64) -> i64
  requires 0 <= s && s <= e && e <= len(b)
  ensures s <= result && result <= e
{
  let mut j: i64 = e;
  while j > s
    invariant s <= j && j <= e && e <= len(b) && 0 <= s
    decreases j - s
  {
    let w: i64 = ws_before(b, s, j);
    if w == 0 { return j; }
    j = j - w;
  }
  return j;
}

// first unit start in [s, e) at which the UTF-16 length of b[s..) would pass cap, or e; [s, result) has <= cap units
fn cut(b: [u8], s: i64, e: i64, cap: i64) -> i64
  requires 0 <= s && s <= e && e <= len(b) && 8 <= cap && cap <= 1000000
  ensures s <= result && result <= e
{
  let mut u: i64 = 0;
  let mut i: i64 = s;
  while i < e
    invariant s <= i && i <= e && e <= len(b) && 0 <= u && u <= cap
    decreases e - i
  {
    let c: i64 = b[i];
    let mut w: i64 = 0;
    if c < 128 || c >= 192 { w = 1; }
    if c >= 240 { w = 2; }
    if u + w > cap { return i; }
    u = u + w;
    i = i + 1;
    if c < 128 {
      let i0: i64 = i;
      while i <= e - 8 && u <= cap - 8 && ascii8(b, i)
        invariant i0 <= i && s <= i && i <= e && e <= len(b) && 0 <= u && u <= cap
        decreases e - i
      { u = u + 8; i = i + 8; }
    }
  }
  return i;
}

// UTF-16 length of b[s..e); stops once it passes cap (then the result is > cap)
fn units(b: [u8], s: i64, e: i64, cap: i64) -> i64
  requires 0 <= s && s <= e && e <= len(b) && 0 <= cap
  ensures 0 <= result && result <= 2 * (e - s)
{
  let mut u: i64 = 0;
  let mut i: i64 = s;
  if e - s <= cap {
    // a unit takes at least one byte: no early exit needed
    while i < e
      invariant s <= i && i <= e && e <= len(b) && 0 <= u && u <= 2 * (i - s)
      decreases e - i
    {
      let c: i64 = b[i];
      i = i + 1;
      if c < 128 {
        u = u + 1;
        let i0: i64 = i;
        while i <= e - 8 && ascii8(b, i)
          invariant i0 <= i && s <= i && i <= e && e <= len(b) && 0 <= u && u <= 2 * (i - s)
          decreases e - i
        { u = u + 8; i = i + 8; }
      } else {
        if c >= 192 { u = u + 1; }
        if c >= 240 { u = u + 1; }
      }
    }
    return u;
  }
  while i < e && u <= cap
    invariant s <= i && i <= e && e <= len(b) && 0 <= u && u <= 2 * (i - s)
    decreases e - i
  {
    let c: i64 = b[i];
    i = i + 1;
    if c < 128 {
      u = u + 1;
      let i0: i64 = i;
      while i <= e - 8 && u <= cap && ascii8(b, i)
        invariant i0 <= i && s <= i && i <= e && e <= len(b) && 0 <= u && u <= 2 * (i - s)
        decreases e - i
      { u = u + 8; i = i + 8; }
    } else {
      if c >= 192 { u = u + 1; }
      if c >= 240 { u = u + 1; }
    }
  }
  return u;
}

// validText: string whose trimmed UTF-16 length is 1..300; no allocation
pub fn text_ok(b: [u8], p: i64) -> bool
{
  if bt(b, p) != 6 { return false; }
  let e: i64 = s_end(b, p + 1, false);
  if e < 0 { return false; }
  let ts: i64 = tr_s(b, p + 5, e);
  // [ts, q) holds at most 300 units; a non-trim unit at or after q makes the trimmed text longer than 300, found
  // without reading past it. Otherwise everything from q on is trim and the trimmed text ends inside [ts, q).
  let q: i64 = cut(b, ts, e, 300);
  if q < e && tr_s(b, q, e) < e { return false; }
  return tr_e(b, ts, q) > ts;
}

// validLines: array, count in min..max (checked first), every element text_ok
pub fn lines_ok(b: [u8], p: i64, min: i64, max: i64) -> bool
{
  let n: i64 = len(b);
  if n > 1099511627776 || p < 0 || n - p < 5 { return false; }
  if b[p] != 8 { return false; }
  let cnt: i64 = load_be(b, p + 1, 4);
  if cnt < min || cnt > max { return false; }
  let mut pos: i64 = p + 5;
  let mut i: i64 = 0;
  while i < cnt
    invariant 0 <= i && i <= cnt && 0 <= pos && pos <= n && n == len(b)
    decreases cnt - i
  {
    if !text_ok(b, pos) { return false; }
    let e: i64 = s_end(b, pos + 1, false);
    if e < 0 { return false; }
    pos = e;
    i = i + 1;
  }
  return true;
}

// ================= validation =================

// the raw f64 bits of the number at p (0 if not a number)
fn bits_at(b: [u8], p: i64) -> i64
{
  if p < 0 || p > len(b) - 9 { return 0; }
  return load_be(b, p + 1, 8);
}

// Number.isInteger(x) && x >= 0 for a count value
fn count_ok(b: [u8], p: i64) -> bool
{
  if bt(b, p) != 7 || p > len(b) - 9 { return false; }
  return crate::bud_num::count_class(bits_at(b, p)) == 0;
}

fn targets_ok(b: [u8], t: i64) -> bool ! alloc
{
  if bt(b, t) != 9 { return false; }
  let k: Keys = scan(b, t, "confirmed", "candidate", "unknown", "note", "note", "note");
  if !count_ok(b, k.p0) || !count_ok(b, k.p1) || !count_ok(b, k.p2) { return false; }
  let np: i64 = k.p3;
  if !b_present(b, np) { return true; }
  if bt(b, np) != 6 { return false; }
  let e: i64 = s_end(b, np + 1, false);
  if e < 0 { return false; }
  // the raw note length (not trimmed)
  return units(b, np + 5, e, 300) <= 300;
}

fn status_ok(b: [u8], p: i64) -> bool ! alloc
{
  return b_str_is(b, p, "planned") || b_str_is(b, p, "done") || b_str_is(b, p, "skipped");
}

fn verify_ok(b: [u8], p: i64) -> bool ! alloc
{
  let n: i64 = len(b);
  if n > 1099511627776 || p < 0 || n - p < 5 { return false; }
  if b[p] != 8 { return false; }
  let cnt: i64 = load_be(b, p + 1, 4);
  if cnt > 5 { return false; }
  let mut pos: i64 = p + 5;
  let mut i: i64 = 0;
  while i < cnt
    invariant 0 <= i && i <= cnt && 0 <= pos && pos <= n && n == len(b)
    decreases cnt - i
  {
    if bt(b, pos) != 9 { return false; }
    let k: Keys = scan(b, pos, "label", "status", "status", "status", "status", "status");
    if !text_ok(b, k.p0) { return false; }
    if !status_ok(b, k.p1) { return false; }
    let e: i64 = j_end(b, pos);
    if e < 0 { return false; }
    pos = e;
    i = i + 1;
  }
  return true;
}

fn state_ok(b: [u8], p: i64) -> bool ! alloc
{
  return b_str_is(b, p, "working") || b_str_is(b, p, "done") || b_str_is(b, p, "waiting-user") || b_str_is(b, p, "blocked");
}

// Field positions of the card: p0 deliverable, p1 done, p2 targets, p3 verify, p4 conflicts, p5 state.
pub fn card_at(b: [u8], at: i64) -> Keys ! alloc
{
  return scan(b, at, "deliverable", "done", "targets", "verify", "conflicts", "state");
}

// 0 ok, 1 deliverable, 2 done
pub fn check_required(b: [u8], f: Keys) -> i64
  ensures 0 <= result && result <= 2
{
  if !text_ok(b, f.p0) { return 1; }
  if !lines_ok(b, f.p1, 1, 5) { return 2; }
  return 0;
}

// some optional key (targets, verify, conflicts, state) was found; when none was, check_optional (out of line, cold
// for such cards) is not entered (P26b: fewer touched code pages)
fn any_optional(f: Keys) -> bool
{
  return f.p2 >= 0 || f.p3 >= 0 || f.p4 >= 0 || f.p5 >= 0;
}

// 0 ok, else the first failing of 3 targets, 4 verify, 5 conflicts, 6 state
pub fn check_optional(b: [u8], f: Keys) -> i64 ! alloc
  ensures result == 0 || (3 <= result && result <= 6)
{
  if b_present(b, f.p2) && !targets_ok(b, f.p2) { return 3; }
  if b_present(b, f.p3) && !verify_ok(b, f.p3) { return 4; }
  if b_present(b, f.p4) && !lines_ok(b, f.p4, 0, 5) { return 5; }
  if b_present(b, f.p5) && !state_ok(b, f.p5) { return 6; }
  return 0;
}

pub fn validate(b: [u8], f: Keys) -> i64 ! alloc
  ensures 0 <= result && result <= 6
{
  let r: i64 = check_required(b, f);
  if r != 0 { return r; }
  if !any_optional(f) { return 0; }
  return check_optional(b, f);
}

// ================= projection (JB bytes -> stored V words) =================

// `count, UTF-16 units` of the WTF-8 bytes b[s..e)
fn put_units(inout o: [i64], q: i64, b: [u8], s: i64, e: i64) -> i64
  requires 0 <= q && q <= 1099511627776
  requires 0 <= s && s <= e && e <= len(b)
  ensures 0 <= result && result <= 1099511627776 && len(o) == len(old(o))
{
  let u: i64 = units(b, s, e, e - s);
  let r: i64 = put(inout o, q, u);
  if u > len(o) - r {
    // size pass (or no room): only the position moves
    if u >= 1099511627776 - r { return 1099511627776; }
    return r + u;
  }
  let mut i: i64 = s;
  let mut k: i64 = 0;
  while i < e && k < u
    invariant s <= i && i <= e && e <= len(b) && 0 <= k && k <= u && 0 <= r && r + u <= len(o) && len(o) == len(old(o))
    decreases e - i
  {
    let c: i64 = b[i];
    if c < 128 {
      o[r + k] = c;
      i = i + 1;
      k = k + 1;
      let i0: i64 = i;
      while i <= e - 8 && k <= u - 8 && ascii8(b, i)
        invariant i0 <= i && s <= i && i <= e && e <= len(b) && 0 <= k && k <= u && 0 <= r && r + u <= len(o) && len(o) == len(old(o))
        decreases e - i
      {
        o[r + k] = b[i];
        o[r + k + 1] = b[i + 1];
        o[r + k + 2] = b[i + 2];
        o[r + k + 3] = b[i + 3];
        o[r + k + 4] = b[i + 4];
        o[r + k + 5] = b[i + 5];
        o[r + k + 6] = b[i + 6];
        o[r + k + 7] = b[i + 7];
        i = i + 8;
        k = k + 8;
      }
    } else if c < 224 {
      if i + 1 >= e { return r + u; }
      o[r + k] = band(c, 31) * 64 + band(b[i + 1], 63);
      i = i + 2;
      k = k + 1;
    } else if c < 240 {
      if i + 2 >= e { return r + u; }
      o[r + k] = band(c, 15) * 4096 + band(b[i + 1], 63) * 64 + band(b[i + 2], 63);
      i = i + 3;
      k = k + 1;
    } else {
      if i + 3 >= e || k + 1 >= u { return r + u; }
      let cp: i64 = band(c, 7) * 262144 + band(b[i + 1], 63) * 4096 + band(b[i + 2], 63) * 64 + band(b[i + 3], 63) - 65536;
      o[r + k] = 55296 + band(ushr(cp, 10), 1023);
      o[r + k + 1] = 56320 + band(cp, 1023);
      i = i + 4;
      k = k + 2;
    }
  }
  return r + u;
}

// the string at p verbatim (undefined if not a string)
fn put_text(inout o: [i64], q: i64, b: [u8], p: i64) -> i64
  requires 0 <= q && q <= 1099511627776
  ensures 0 <= result && result <= 1099511627776 && len(o) == len(old(o))
{
  if bt(b, p) != 6 { return put(inout o, q, 1); }
  let e: i64 = s_end(b, p + 1, false);
  if e < 0 { return put(inout o, q, 1); }
  let r: i64 = put(inout o, q, 6);
  return put_units(inout o, r, b, p + 5, e);
}

// the string at p, trimmed
fn put_trimmed(inout o: [i64], q: i64, b: [u8], p: i64) -> i64
  requires 0 <= q && q <= 1099511627776
  ensures 0 <= result && result <= 1099511627776 && len(o) == len(old(o))
{
  if bt(b, p) != 6 { return put(inout o, q, 1); }
  let e: i64 = s_end(b, p + 1, false);
  if e < 0 { return put(inout o, q, 1); }
  let ts: i64 = tr_s(b, p + 5, e);
  let te: i64 = tr_e(b, ts, e);
  let r: i64 = put(inout o, q, 6);
  return put_units(inout o, r, b, ts, te);
}

// the f64 with these bits is an integer with |x| <= 2^53 - 1 and not -0 (the stored [5, v] form, as run_m11 to_v)
fn safe_int(bits: i64) -> bool
{
  if bits == 0 { return true; }
  let e: i64 = band(ushr(bits, 52), 2047);
  if e < 1023 || e > 1075 { return false; }
  if e == 1075 { return true; }
  let mask: i64 = ushr(-1, 12 + (e - 1023));
  return band(bits, mask) == 0;
}

fn int_val(bits: i64) -> i64
{
  let e: i64 = band(ushr(bits, 52), 2047);
  if e < 1023 || e > 1075 { return 0; }
  let m: i64 = band(bits, 4503599627370495) + 4503599627370496;
  let mag: i64 = ushr(m, 1075 - e);
  if bits < 0 { return 0 - mag; }
  return mag;
}

fn put_num(inout o: [i64], q: i64, bits: i64) -> i64
  requires 0 <= q && q <= 1099511627776
  ensures 0 <= result && result <= 1099511627776 && len(o) == len(old(o))
{
  if safe_int(bits) {
    let r: i64 = put(inout o, q, 5);
    return put(inout o, r, int_val(bits));
  }
  let r2: i64 = put(inout o, q, 7);
  return put(inout o, r2, bits);
}

// any value at p (undefined if p < 0 or malformed)
fn put_jv(inout o: [i64], q: i64, b: [u8], p: i64, depth: i64) -> i64
  requires 0 <= q && q <= 1099511627776
  requires 0 <= depth && depth <= 33
  ensures 0 <= result && result <= 1099511627776 && len(o) == len(old(o))
  decreases 33 - depth
{
  if depth > 32 { return put(inout o, q, 1); }
  let t: i64 = bt(b, p);
  if t >= 1 && t <= 4 { return put(inout o, q, t); }
  if t == 7 {
    if p > len(b) - 9 { return put(inout o, q, 1); }
    return put_num(inout o, q, bits_at(b, p));
  }
  if t == 6 { return put_text(inout o, q, b, p); }
  if t == 8 || t == 9 {
    let n: i64 = len(b);
    if n > 1099511627776 || p < 0 || n - p < 5 { return put(inout o, q, 1); }
    let cnt: i64 = load_be(b, p + 1, 4);
    let mut r: i64 = put(inout o, q, t);
    r = put(inout o, r, cnt);
    let mut pos: i64 = p + 5;
    let mut i: i64 = 0;
    while i < cnt
      invariant 0 <= i && i <= cnt && 0 <= r && r <= 1099511627776 && 0 <= depth && depth <= 32 && len(o) == len(old(o))
      decreases cnt - i
    {
      let mut vs: i64 = pos;
      if t == 9 {
        let ke: i64 = s_end(b, pos, false);
        if ke < 0 { return r; }
        r = put_units(inout o, r, b, pos + 4, ke);
        vs = ke;
      }
      r = put_jv(inout o, r, b, vs, depth + 1);
      let e: i64 = j_end(b, vs);
      if e < 0 { return r; }
      pos = e;
      i = i + 1;
    }
    return r;
  }
  return put(inout o, q, 1);
}

// array of trimmed strings (validated by lines_ok)
fn put_lines(inout o: [i64], q: i64, b: [u8], p: i64) -> i64
  requires 0 <= q && q <= 1099511627776
  ensures 0 <= result && result <= 1099511627776 && len(o) == len(old(o))
{
  let n: i64 = len(b);
  let mut cnt: i64 = 0;
  let mut pos: i64 = 0;
  if n <= 1099511627776 && p >= 0 && n - p >= 5 && b[p] == 8 { cnt = load_be(b, p + 1, 4); pos = p + 5; }
  let mut r: i64 = put(inout o, q, 8);
  r = put(inout o, r, cnt);
  let mut i: i64 = 0;
  while i < cnt
    invariant 0 <= i && i <= cnt && 0 <= r && r <= 1099511627776 && 0 <= pos && pos <= n && n == len(b) && len(o) == len(old(o))
    decreases cnt - i
  {
    r = put_trimmed(inout o, r, b, pos);
    let e: i64 = s_end(b, pos + 1, false);
    if e < 0 { return r; }
    pos = e;
    i = i + 1;
  }
  return r;
}

fn put_verify(inout o: [i64], q: i64, b: [u8], p: i64) -> i64 ! alloc
  requires 0 <= q && q <= 1099511627776
  ensures 0 <= result && result <= 1099511627776 && len(o) == len(old(o))
{
  let n: i64 = len(b);
  let mut cnt: i64 = 0;
  let mut pos: i64 = 0;
  if n <= 1099511627776 && p >= 0 && n - p >= 5 && b[p] == 8 { cnt = load_be(b, p + 1, 4); pos = p + 5; }
  let mut r: i64 = put(inout o, q, 8);
  r = put(inout o, r, cnt);
  let mut i: i64 = 0;
  while i < cnt
    invariant 0 <= i && i <= cnt && 0 <= r && r <= 1099511627776 && 0 <= pos && pos <= n && n == len(b) && len(o) == len(old(o))
    decreases cnt - i
  {
    let k: Keys = scan(b, pos, "label", "status", "status", "status", "status", "status");
    r = put(inout o, r, 9);
    r = put(inout o, r, 2);
    r = put_key(inout o, r, "label");
    r = put_trimmed(inout o, r, b, k.p0);
    r = put_key(inout o, r, "status");
    r = put_text(inout o, r, b, k.p1);
    let e: i64 = j_end(b, pos);
    if e < 0 { return r; }
    pos = e;
    i = i + 1;
  }
  return r;
}

fn put_targets(inout o: [i64], q: i64, b: [u8], t: i64) -> i64 ! alloc
  requires 0 <= q && q <= 1099511627776
  ensures 0 <= result && result <= 1099511627776 && len(o) == len(old(o))
{
  let k: Keys = scan(b, t, "confirmed", "candidate", "unknown", "note", "note", "note");
  let np: i64 = k.p3;
  // the note is kept only if it is a non-empty string
  let mut with_note: bool = false;
  if bt(b, np) == 6 {
    let ne: i64 = s_end(b, np + 1, false);
    with_note = ne > np + 5;
  }
  let mut r: i64 = put(inout o, q, 9);
  if with_note { r = put(inout o, r, 4); } else { r = put(inout o, r, 3); }
  r = put_key(inout o, r, "confirmed");
  r = put_jv(inout o, r, b, k.p0, 1);
  r = put_key(inout o, r, "candidate");
  r = put_jv(inout o, r, b, k.p1, 1);
  r = put_key(inout o, r, "unknown");
  r = put_jv(inout o, r, b, k.p2, 1);
  if with_note {
    r = put_key(inout o, r, "note");
    r = put_text(inout o, r, b, np);
  }
  return r;
}

fn put_by(inout o: [i64], q: i64, by: [u8], by_at: i64) -> i64 ! alloc
  requires 0 <= q && q <= 1099511627776
  ensures 0 <= result && result <= 1099511627776 && len(o) == len(old(o))
{
  let k: Keys = scan(by, by_at, "sessionId", "turnId", "turnId", "turnId", "turnId", "turnId");
  let mut r: i64 = put(inout o, q, 9);
  r = put(inout o, r, 2);
  r = put_key(inout o, r, "sessionId");
  r = put_jv(inout o, r, by, k.p0, 1);
  r = put_key(inout o, r, "turnId");
  r = put_jv(inout o, r, by, k.p1, 1);
  return r;
}

// JS truthiness of the value at p
fn truthy_b(b: [u8], p: i64) -> bool
{
  let t: i64 = bt(b, p);
  if t == 4 || t == 8 || t == 9 { return true; }
  if t == 7 {
    if p > len(b) - 9 { return false; }
    let x: i64 = bits_at(b, p);
    if band(x, 9223372036854775807) == 0 { return false; }
    return crate::bud_num::count_class(x) != 3;
  }
  if t == 6 {
    let e: i64 = s_end(b, p + 1, false);
    return e > p + 5;
  }
  return false;
}

// the optional fields of a card (targets, verify, conflicts, state, by), shared by put_card_words and put_card_words0:
// one body out of the hot path, so a card with none of them runs only the header, deliverable, done and updatedAt code
// (P26b: fewer touched code pages, one copy of the optional writers).
fn put_card_opt(inout o: [i64], q0: i64, b: [u8], f: Keys, by: [u8], by_at: i64, has_by: bool) -> i64 ! alloc
  requires 0 <= q0 && q0 <= 1099511627776
  ensures 0 <= result && result <= 1099511627776 && len(o) == len(old(o))
{
  let mut q: i64 = q0;
  if b_present(b, f.p2) {
    q = put_key(inout o, q, "targets");
    q = put_targets(inout o, q, b, f.p2);
  }
  if b_present(b, f.p3) {
    q = put_key(inout o, q, "verify");
    q = put_verify(inout o, q, b, f.p3);
  }
  if b_present(b, f.p4) {
    q = put_key(inout o, q, "conflicts");
    q = put_lines(inout o, q, b, f.p4);
  }
  if b_present(b, f.p5) {
    q = put_key(inout o, q, "state");
    q = put_text(inout o, q, b, f.p5);
  }
  if has_by {
    q = put_key(inout o, q, "by");
    q = put_by(inout o, q, by, by_at);
  }
  return q;
}

fn put_date(inout o: [i64], q: i64, iso: crate::bud_date::IsoParts) -> i64
  requires 0 <= q && q <= 1099511627776
  requires crate::bud_date::valid_iso_parts(iso.y, iso.m, iso.d, iso.h, iso.mi, iso.sec, iso.f, iso.n)
  ensures 0 <= result && result <= 1099511627776 && len(o) == len(old(o))
{
  let end: i64 = q + iso.n;
  if q < len(o) && len(o) < end {
    crate::bud_date::put_iso_prefix(inout o, q, iso);
  } else {
    crate::bud_date::put_iso(inout o, q, iso);
  }
  if end > 1099511627776 { return 1099511627776; }
  return end;
}

pub fn put_card_words(inout o: [i64], p0: i64, b: [u8], f: Keys, by: [u8], by_at: i64, iso: crate::bud_date::IsoParts) -> i64 ! alloc
  requires 0 <= p0 && p0 <= 1099511627776
  requires crate::bud_date::valid_iso_parts(iso.y, iso.m, iso.d, iso.h, iso.mi, iso.sec, iso.f, iso.n)
  ensures 0 <= result && result <= 1099511627776 && len(o) == len(old(o))
{
  let has_by: bool = by_at >= 0 && truthy_b(by, by_at);
  let mut k: i64 = 3;
  if b_present(b, f.p2) { k = k + 1; }
  if b_present(b, f.p3) { k = k + 1; }
  if b_present(b, f.p4) { k = k + 1; }
  if b_present(b, f.p5) { k = k + 1; }
  if has_by { k = k + 1; }
  let mut q: i64 = put(inout o, p0, 9);
  q = put(inout o, q, k);
  q = put_key(inout o, q, "deliverable");
  q = put_trimmed(inout o, q, b, f.p0);
  q = put_key(inout o, q, "done");
  q = put_lines(inout o, q, b, f.p1);
  q = put_key(inout o, q, "updatedAt");
  q = put(inout o, q, 6);
  q = put(inout o, q, iso.n);
  q = put_date(inout o, q, iso);
  if k > 3 { q = put_card_opt(inout o, q, b, f, by, by_at, has_by); }
  return q;
}

// put_card_words at p0 = 0 for build (perf A/C): the constant start lets the writers' positions fold; the p0 form
// alone measured A/C 2-6% slower on median (P26 appendix). Same words as put_card_words(o, 0, ...).
fn put_card_words0(inout o: [i64], b: [u8], f: Keys, by: [u8], by_at: i64, iso: crate::bud_date::IsoParts) -> i64 ! alloc
  requires crate::bud_date::valid_iso_parts(iso.y, iso.m, iso.d, iso.h, iso.mi, iso.sec, iso.f, iso.n)
  ensures 0 <= result && result <= 1099511627776 && len(o) == len(old(o))
{
  let has_by: bool = by_at >= 0 && truthy_b(by, by_at);
  let mut k: i64 = 3;
  if b_present(b, f.p2) { k = k + 1; }
  if b_present(b, f.p3) { k = k + 1; }
  if b_present(b, f.p4) { k = k + 1; }
  if b_present(b, f.p5) { k = k + 1; }
  if has_by { k = k + 1; }
  let mut q: i64 = put(inout o, 0, 9);
  q = put(inout o, q, k);
  q = put_key(inout o, q, "deliverable");
  q = put_trimmed(inout o, q, b, f.p0);
  q = put_key(inout o, q, "done");
  q = put_lines(inout o, q, b, f.p1);
  q = put_key(inout o, q, "updatedAt");
  q = put(inout o, q, 6);
  q = put(inout o, q, iso.n);
  q = put_date(inout o, q, iso);
  if k > 3 { q = put_card_opt(inout o, q, b, f, by, by_at, has_by); }
  return q;
}

// The stored card (V words) for a card that passed validate. O(size of the card): size pass, then write pass.
pub fn build(b: [u8], f: Keys, by: [u8], by_at: i64, now_ms: i64) -> [i64] ! alloc
  requires -8640000000000000 <= now_ms && now_ms <= 8640000000000000
{
  let iso: crate::bud_date::IsoParts = crate::bud_date::iso_parts(now_ms);
  let mut dry: [i64] = crate::ent_u16::empty();
  let size: i64 = put_card_words0(inout dry, b, f, by, by_at, iso);
  let mut o: [i64] = crate::ent_u16::zeros(size);
  let w: i64 = put_card_words0(inout o, b, f, by, by_at, iso);
  return o;
}

// 1 iff the lang packet is the string "en"
pub fn lang_code(lang: [u8]) -> i64 ! alloc
  ensures result == 0 || result == 1
{
  if len(lang) > 0 && b_str_is(lang, 0, "en") { return 1; }
  return 0;
}

// ================= writing =================
// Writers return the next position; positions saturate at 2^40 and out-of-range writes are dropped (wr), so the same
// code is the size pass (into an empty array) and the write pass (into zeros(size)).

fn put(inout o: [i64], p: i64, x: i64) -> i64
  requires 0 <= p && p <= 1099511627776
  ensures 0 <= result && result <= 1099511627776 && len(o) == len(old(o))
{
  if p >= 1099511627776 { return 1099511627776; }
  crate::ent_u16::wr(inout o, p, x);
  return p + 1;
}

// key `len, units` of an ASCII literal
fn put_key(inout o: [i64], p: i64, s: str) -> i64
  requires 0 <= p && p <= 1099511627776
  ensures 0 <= result && result <= 1099511627776 && len(o) == len(old(o))
{
  let m: i64 = len(s);
  let mut q: i64 = put(inout o, p, m);
  let mut j: i64 = 0;
  while j < m
    invariant 0 <= j && j <= m && m == len(s) && 0 <= q && q <= 1099511627776 && len(o) == len(old(o))
    decreases m - j
  {
    q = put(inout o, q, s[j]);
    j = j + 1;
  }
  return q;
}

// words v[s..e)
fn put_words(inout o: [i64], p: i64, v: [i64], s: i64, e: i64) -> i64
  requires 0 <= p && p <= 1099511627776
  ensures 0 <= result && result <= 1099511627776 && len(o) == len(old(o))
{
  let mut i: i64 = s;
  if i < 0 { i = 0; }
  let mut hi: i64 = e;
  if hi > len(v) { hi = len(v); }
  let mut q: i64 = p;
  if hi <= i { return q; }
  let olen: i64 = len(o);
  // fast path: the whole range fits, copy directly
  if q + (hi - i) <= olen {
    let mut k: i64 = 0;
    let m: i64 = hi - i;
    while k < m
      invariant 0 <= k && k <= m && 0 <= i && i + m <= len(v) && 0 <= q && q + m <= olen && olen == len(o) && len(o) == len(old(o))
      decreases m - k
    {
      o[q + k] = v[i + k];
      k = k + 1;
    }
    return q + m;
  }
  // size pass (nothing fits from q on): only the position moves
  if q >= olen {
    if hi - i >= 1099511627776 - q { return 1099511627776; }
    return q + (hi - i);
  }
  while i < hi
    invariant 0 <= i && i <= hi && hi <= len(v) && 0 <= q && q <= 1099511627776 && len(o) == len(old(o))
    decreases hi - i
  {
    q = put(inout o, q, v[i]);
    i = i + 1;
  }
  return q;
}
// ================= small judgments =================

pub fn truthy(v: [i64], at: i64) -> bool
{
  let t: i64 = tag(v, at);
  if t == 4 || t == 8 || t == 9 { return true; }
  if t == 5 { return nx(v, at) != 0; }
  if t == 6 { return nx(v, at) > 0; }
  if t == 7 {
    let b: i64 = nx(v, at);
    if band(b, 9223372036854775807) == 0 { return false; }
    return crate::bud_num::count_class(b) != 3;
  }
  return false;
}
pub fn has_card(budget: [i64], at: i64) -> bool ! alloc
{
  return truthy(budget, obj_get(budget, at, "card"));
}

// The budget object at `at` with the value of "card" replaced in place, or the pair appended at the end.
// A malformed budget gives an empty array.
pub fn put_card(budget: [i64], at: i64, card: [i64]) -> [i64] ! alloc
{
  if len(budget) > 1099511627776 || len(card) > 1099511627776 { return crate::ent_u16::empty(); }
  if at < 0 { return crate::ent_u16::empty(); }
  let c0: i64 = nx(budget, at);
  if c0 < 0 || c0 > 1099511627776 { return crate::ent_u16::empty(); }
  let be: i64 = v_end(budget, at);
  if be < 0 || rd(budget, at) != 9 { return crate::ent_u16::empty(); }
  let cp: i64 = obj_get(budget, at, "card");
  let mut size: i64 = 0;
  let mut ce: i64 = 0;
  if cp >= 0 {
    ce = v_end(budget, cp);
    if ce < 0 { return crate::ent_u16::empty(); }
    size = (cp - at) + len(card) + (be - ce);
  } else {
    size = (be - at) + 5 + len(card);
  }
  if size < 0 || size > 1099511627776 { return crate::ent_u16::empty(); }
  let mut o: [i64] = crate::ent_u16::zeros(size);
  let mut q: i64 = 0;
  if cp >= 0 {
    q = put_words(inout o, q, budget, at, cp);
    q = put_words(inout o, q, card, 0, len(card));
    q = put_words(inout o, q, budget, ce, be);
  } else {
    q = put_words(inout o, q, budget, at, be);
    crate::ent_u16::wr(inout o, 1, c0 + 1);
    q = put_key(inout o, q, "card");
    q = put_words(inout o, q, card, 0, len(card));
  }
  return o;
}
// ================= setCard =================

// kind: -1 ok (card set), 0 missing (no session / stale ref / closed), 1..6 the first failing field.
// used_now: deps.now() was read (KD-1, §15 row 18: right after `done` passes, before the optional fields).
// card / by are admitted JB packets (j_ok) with the value at `at` / `by_at` (-1 = absent).
pub struct Judged { kind: i64, used_now: bool, f: Keys, error: [i64] }

pub fn judge(found: bool, closed: bool, card: [u8], at: i64, lang: i64) -> Judged ! alloc
  requires 0 <= lang && lang <= 1
  ensures -1 <= result.kind && result.kind <= 6
  ensures result.kind >= 0 || found
{
  if !found || closed {
    return Judged { kind: 0, used_now: false, f: no_keys(), error: crate::bud_text::card_error(0, lang) };
  }
  let f: Keys = card_at(card, at);
  let r: i64 = check_required(card, f);
  if r != 0 {
    return Judged { kind: r, used_now: false, f: f, error: crate::bud_text::card_error(r, lang) };
  }
  let mut o: i64 = 0;
  if any_optional(f) { o = check_optional(card, f); }
  if o != 0 {
    return Judged { kind: o, used_now: true, f: f, error: crate::bud_text::card_error(o, lang) };
  }
  return Judged { kind: -1, used_now: true, f: f, error: crate::ent_u16::empty() };
}

pub fn set_card(found: bool, closed: bool, card: [u8], at: i64, lang: i64, by: [u8], by_at: i64, now_ms: i64) -> SetCard ! alloc
  requires 0 <= lang && lang <= 1
  requires -8640000000000000 <= now_ms && now_ms <= 8640000000000000
  ensures -1 <= result.kind && result.kind <= 6
{
  let j: Judged = judge(found, closed, card, at, lang);
  if j.kind >= 0 {
    return SetCard { kind: j.kind, used_now: j.used_now, card: crate::ent_u16::empty(), error: copy(j.error) };
  }
  return SetCard { kind: j.kind, used_now: j.used_now, card: build(card, j.f, by, by_at, now_ms), error: crate::ent_u16::empty() };
}
