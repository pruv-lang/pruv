// L3-8 entry: JS value semantics over value slots (VS = [tag, a, b] at an absolute position p of a packet w).
// Truthiness, strict equality (===), nullish test and the template-literal stringification used for bound keys.
// Every accessor is total (u16::rd), so a bad position reads zeros; packets are validated before use.

pub fn tag_at(w: [i64], p: i64) -> i64
  ensures 0 <= result || result < 0
{
  return crate::ent_u16::rd(w, p);
}

// tag with 10 (absent own property) folded into 0 (undefined)
pub fn ntag(w: [i64], p: i64) -> i64
{
  let t: i64 = crate::ent_u16::rd(w, p);
  if t == 10 { return 0; }
  return t;
}

// undefined, null or absent (the ?? test)
pub fn nullish(w: [i64], p: i64) -> bool
{
  let t: i64 = crate::ent_u16::rd(w, p);
  return t == 0 || t == 1 || t == 10;
}

pub fn is_nan_bits(lo: i64, hi: i64) -> bool
{
  let e: i64 = band(ushr(hi, 20), 2047);
  if e != 2047 { return false; }
  return band(hi, 1048575) != 0 || lo != 0;
}

pub fn is_zero_bits(lo: i64, hi: i64) -> bool
{
  return lo == 0 && (hi == 0 || hi == 2147483648);
}

// JS truthiness of a slot
pub fn truthy(w: [i64], p0: i64) -> bool
{
  let p: i64 = crate::ent_u16::clamp(p0, 4294967296);
  let t: i64 = crate::ent_u16::rd(w, p);
  if t == 3 || t == 9 || t == 11 { return true; }
  if t == 5 {
    let lo: i64 = crate::ent_u16::rd(w, p + 1);
    let hi: i64 = crate::ent_u16::rd(w, p + 2);
    if is_zero_bits(lo, hi) { return false; }
    if is_nan_bits(lo, hi) { return false; }
    return true;
  }
  if t == 6 { return crate::ent_u16::rd(w, p + 2) > 0; }
  return false;
}

// absolute start of the units of the string slot at p (tag 6) and its length; both clamped
pub fn str_start(w: [i64], p0: i64) -> i64
  ensures 0 <= result && result <= 67108864
{
  let p: i64 = crate::ent_u16::clamp(p0, 4294967296);
  return crate::ent_u16::clamp(crate::ent_packet::sec_start(w, 0) + crate::ent_u16::clamp(crate::ent_u16::rd(w, p + 1), 33554432), 67108864);
}

pub fn str_len(w: [i64], p0: i64) -> i64
  ensures 0 <= result && result <= 16777216
{
  let p: i64 = crate::ent_u16::clamp(p0, 4294967296);
  return crate::ent_u16::clamp(crate::ent_u16::rd(w, p + 2), 16777216);
}

// the string slot at p as a unit array
pub fn str_units(w: [i64], p: i64) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let s: i64 = str_start(w, p);
  return crate::ent_u16::slice(w, s, s + str_len(w, p));
}

// the string slot at p equals the unit array lit
pub fn str_eq_arr(w: [i64], p: i64, lit: [i64]) -> bool
{
  if crate::ent_u16::rd(w, p) != 6 { return false; }
  let n: i64 = str_len(w, p);
  if n != len(lit) { return false; }
  let s: i64 = str_start(w, p);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n == len(lit) && 0 <= s && s <= 67108864
    decreases n - i
  {
    if crate::ent_u16::rd(w, s + i) != crate::ent_u16::rd(lit, i) { return false; }
    i = i + 1;
  }
  return true;
}

// the string slot at p equals an ASCII literal
pub fn str_eq_lit(w: [i64], p: i64, s: str) -> bool
{
  if crate::ent_u16::rd(w, p) != 6 { return false; }
  let n: i64 = len(s);
  if n != str_len(w, p) { return false; }
  let st: i64 = str_start(w, p);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n == len(s) && 0 <= st && st <= 67108864
    decreases n - i
  {
    if crate::ent_u16::rd(w, st + i) != s[i] { return false; }
    i = i + 1;
  }
  return true;
}

// units of two string slots (possibly in different packets) are equal
pub fn str_eq(w1: [i64], p1: i64, w2: [i64], p2: i64) -> bool
{
  let n: i64 = str_len(w1, p1);
  if n != str_len(w2, p2) { return false; }
  let s1: i64 = str_start(w1, p1);
  let s2: i64 = str_start(w2, p2);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && 0 <= s1 && s1 <= 67108864 && 0 <= s2 && s2 <= 67108864
    decreases n - i
  {
    if crate::ent_u16::rd(w1, s1 + i) != crate::ent_u16::rd(w2, s2 + i) { return false; }
    i = i + 1;
  }
  return true;
}

// strict equality (===) of two slots. Tags 0 and 10 are equal; numbers: NaN is unequal, +0 equals -0; refs by id.
// Other tag pairings (arrays, objects, inspected objects) are unequal.
pub fn strict_eq(w1: [i64], p10: i64, w2: [i64], p20: i64) -> bool
{
  let p1: i64 = crate::ent_u16::clamp(p10, 4294967296);
  let p2: i64 = crate::ent_u16::clamp(p20, 4294967296);
  let t1: i64 = ntag(w1, p1);
  let t2: i64 = ntag(w2, p2);
  if t1 != t2 { return false; }
  if t1 == 0 || t1 == 1 || t1 == 2 || t1 == 3 { return true; }
  if t1 == 4 { return crate::ent_u16::rd(w1, p1 + 1) == crate::ent_u16::rd(w2, p2 + 1); }
  if t1 == 5 {
    let lo1: i64 = crate::ent_u16::rd(w1, p1 + 1);
    let hi1: i64 = crate::ent_u16::rd(w1, p1 + 2);
    let lo2: i64 = crate::ent_u16::rd(w2, p2 + 1);
    let hi2: i64 = crate::ent_u16::rd(w2, p2 + 2);
    if is_nan_bits(lo1, hi1) || is_nan_bits(lo2, hi2) { return false; }
    if is_zero_bits(lo1, hi1) && is_zero_bits(lo2, hi2) { return true; }
    return lo1 == lo2 && hi1 == hi2;
  }
  if t1 == 6 { return str_eq(w1, p1, w2, p2); }
  if t1 == 9 { return crate::ent_u16::rd(w1, p1 + 1) == crate::ent_u16::rd(w2, p2 + 1); }
  return false;
}

// ---- bound-key stringification (template literal `${v}`) ----

// 2^53, the "not a safe integer" sentinel of num_int
pub fn int_bad() -> i64 ensures result == 9007199254740992 { return 9007199254740992; }

// A JS Number (low, high 32 bits) that is a safe integer gives its signed value (-0 gives 0); anything else gives int_bad().
pub fn num_int(lo0: i64, hi0: i64) -> i64
  ensures result == 9007199254740992 || (-9007199254740991 <= result && result <= 9007199254740991)
{
  let lo: i64 = crate::ent_u16::clamp(lo0, 4294967295);
  let hi: i64 = crate::ent_u16::clamp(hi0, 4294967295);
  let er: i64 = band(ushr(hi, 20), 2047);
  let mh: i64 = band(hi, 1048575);
  if er == 0 {
    if mh == 0 && lo == 0 { return 0; }
    return int_bad();
  }
  let e: i64 = er - 1023;
  if e < 0 || e > 52 { return int_bad(); }
  let full: i64 = 4503599627370496 + mh * 4294967296 + lo;
  let sh: i64 = 52 - e;
  let n: i64 = ushr(full, sh);
  if wrapping_shl(n, sh) != full { return int_bad(); }
  if n > 9007199254740991 || n < 0 { return int_bad(); }
  if ushr(hi, 31) == 1 { return 0 - n; }
  return n;
}

// number of decimal digits of n (0 <= n <= 2^53; 0 has one digit)
pub fn dec_digits(n0: i64) -> i64
  ensures 1 <= result && result <= 17
{
  let mut n: i64 = n0;
  if n < 0 { n = 0; }
  if n > 9007199254740992 { n = 9007199254740992; }
  let mut d: i64 = 1;
  let mut i: i64 = 0;
  while i < 16
    invariant 0 <= i && i <= 16 && 1 <= d && d <= i + 1 && 0 <= n
    decreases 16 - i
  {
    if n >= 10 {
      n = n / 10;
      d = d + 1;
    }
    i = i + 1;
  }
  return d;
}

// Length of the template-literal string of the slot at p, or -1 when outside the supported domain
// (refs, non-safe-integer Numbers, non-primitive tags).
pub fn key_len(w: [i64], p0: i64) -> i64
  ensures -1 <= result && result <= 16777216
{
  let p: i64 = crate::ent_u16::clamp(p0, 4294967296);
  let t: i64 = ntag(w, p);
  if t == 0 { return 9; }
  if t == 1 { return 4; }
  if t == 2 { return 5; }
  if t == 3 { return 4; }
  if t == 6 { return str_len(w, p); }
  if t == 5 {
    let v: i64 = num_int(crate::ent_u16::rd(w, p + 1), crate::ent_u16::rd(w, p + 2));
    if v == int_bad() { return -1; }
    if v < 0 { return 1 + dec_digits(0 - v); }
    return dec_digits(v);
  }
  return -1;
}

// write the units of a literal at o[at..]; returns the position after
pub fn put_lit(inout o: [i64], at0: i64, s: str) -> i64 ! alloc
  ensures len(o) == len(old(o))
{
  let at: i64 = crate::ent_u16::clamp(at0, 4294967296);
  let n: i64 = len(s);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n == len(s) && len(o) == len(old(o)) && 0 <= at && at <= 4294967296
    decreases n - i
  {
    crate::ent_u16::wr(inout o, at + i, s[i]);
    i = i + 1;
  }
  return at + n;
}

// Write the template-literal string of the slot at p into o at `at`; returns the position after it (key_len(w,p) units).
// Numbers are written as signed decimal. Unsupported slots write nothing and return `at`.
pub fn key_put(w: [i64], p0: i64, inout o: [i64], at0: i64) -> i64 ! alloc
  ensures len(o) == len(old(o))
{
  let p: i64 = crate::ent_u16::clamp(p0, 4294967296);
  let at: i64 = crate::ent_u16::clamp(at0, 4294967296);
  let t: i64 = ntag(w, p);
  if t == 0 {
    let r: i64 = put_lit(inout o, at, "undefined");
    return r;
  }
  if t == 1 {
    let r: i64 = put_lit(inout o, at, "null");
    return r;
  }
  if t == 2 {
    let r: i64 = put_lit(inout o, at, "false");
    return r;
  }
  if t == 3 {
    let r: i64 = put_lit(inout o, at, "true");
    return r;
  }
  if t == 6 {
    let r: i64 = crate::ent_u16::put_range(inout o, at, w, str_start(w, p), str_len(w, p));
    return r;
  }
  if t == 5 {
    let v: i64 = num_int(crate::ent_u16::rd(w, p + 1), crate::ent_u16::rd(w, p + 2));
    if v == int_bad() { return at; }
    let mut n: i64 = v;
    let mut pos: i64 = at;
    if v < 0 {
      crate::ent_u16::wr(inout o, pos, 45);
      pos = pos + 1;
      n = 0 - v;
    }
    let d: i64 = dec_digits(n);
    let mut k: i64 = d;
    let mut m: i64 = n;
    while k > 0
      invariant 0 <= k && k <= d && d <= 17 && 0 <= m && 0 <= pos && pos <= 4294967298 && len(o) == len(old(o))
      decreases k
    {
      crate::ent_u16::wr(inout o, pos + k - 1, 48 + m % 10);
      m = m / 10;
      k = k - 1;
    }
    return pos + d;
  }
  return at;
}
