// L3-8 entry: JS value semantics over value slots (VS = [tag, a, b] at an absolute position p of a packet w).
// Truthiness, strict equality (===), nullish test and the template-literal stringification used for bound keys.
// Every accessor is total (u16::rd), so a bad position reads zeros; packets are validated before use.

pub fn tag_at(w: [i64], p: i64) -> i64
  ensures 0 <= result || result < 0
{
  return crate::ent_u16::rd(w, p);
}

// tag with 10 (absent own property) folded into 0 (undefined)
pub fn ntag(w: [i64], p: i64) -> i64
{
  let t: i64 = crate::ent_u16::rd(w, p);
  if t == 10 { return 0; }
  return t;
}

// undefined, null or absent (the ?? test)
pub fn nullish(w: [i64], p: i64) -> bool
{
  let t: i64 = crate::ent_u16::rd(w, p);
  return t == 0 || t == 1 || t == 10;
}

pub fn is_nan_bits(lo: i64, hi: i64) -> bool
{
  let e: i64 = band(ushr(hi, 20), 2047);
  if e != 2047 { return false; }
  return band(hi, 1048575) != 0 || lo != 0;
}

pub fn is_zero_bits(lo: i64, hi: i64) -> bool
{
  return lo == 0 && (hi == 0 || hi == 2147483648);
}

// JS truthiness of a slot
pub fn truthy(w: [i64], p0: i64) -> bool
{
  let p: i64 = crate::ent_u16::clamp(p0, 4294967296);
  let t: i64 = crate::ent_u16::rd(w, p);
  if t == 3 || t == 9 || t == 11 { return true; }
  if t == 5 {
    let lo: i64 = crate::ent_u16::rd(w, p + 1);
    let hi: i64 = crate::ent_u16::rd(w, p + 2);
    if is_zero_bits(lo, hi) { return false; }
    if is_nan_bits(lo, hi) { return false; }
    return true;
  }
  if t == 6 { return crate::ent_u16::rd(w, p + 2) > 0; }
  return false;
}

// A packed pool is [units, bytes, W_1..W_m], seven bytes per word, high byte first. Every reader below takes one
// borrowed view of the pool words (hand `&w[s..]`, `pool_at`) and reads bytes with `byte`; positions are clamped
// once where they enter, not per byte.

// The pool that starts at word s of w, to the end of w (hand `&w[s..]`; s past the end gives an empty view).
pub fn pool_at(w: [i64], s: i64) -> ref [i64] from(w)
{
  return subview(w, crate::ent_u16::clamp(s, len(w)), len(w));
}

// The byte count of a pool view (hand `nbytes`).
fn nbytes(pool: [i64]) -> i64
  ensures 0 <= result && result <= 1073741823
{
  return crate::ent_u16::clamp(crate::ent_u16::rd(pool, 1), 1073741823);
}

// Byte k of a pool view (hand `byte`); words past the view read as zero.
fn byte(pool: [i64], k: i64) -> i64
  requires 0 <= k && k <= 4294967296
  ensures 0 <= result && result <= 255
{
  return (crate::ent_u16::rd(pool, 2 + k / 7) >> (8 * (6 - k % 7))) & 255;
}

pub fn pool_bytes(w: [i64], pool0: i64) -> i64
  ensures 0 <= result && result <= 1073741823
{
  return nbytes(pool_at(w, pool0));
}

fn cont(b: i64) -> bool { return b >= 128 && b < 192; }

// A string span of the pool at word `pool` of w: inside the stream, on form boundaries, not covering the 0xFF
// separator. The ensures carries the span range to the callers (ent_packet `vs` adds a + b).
pub fn span_ok(w: [i64], pool: i64, off: i64, n: i64) -> bool
  ensures result ==> (0 <= off && 0 <= n && off + n <= 1073741823)
{
  let pv: ref [i64] = pool_at(w, pool);
  let nb: i64 = nbytes(pv);
  if off < 0 || n < 0 || off > nb || n > nb - off { return false; }
  let end: i64 = off + n;
  if (off != nb && cont(byte(pv, off))) || (end != nb && cont(byte(pv, end))) { return false; }
  // the 0xFF separator is never part of a string: a span that covers it is refused
  let mut k: i64 = off;
  while k < end
    invariant off <= k && k <= end && end <= 1073741823
    decreases end - k
  {
    if byte(pv, k) == 255 { return false; }
    k = k + 1;
  }
  return true;
}

fn form_width(b: i64) -> i64 ensures 1 <= result && result <= 4
{
  // 255 is the separator byte between a lone high and a lone low slot: one byte, no unit.
  if b == 255 { return 1; }
  if b < 192 { return 1; }
  if b < 224 { return 2; }
  if b < 240 { return 3; }
  return 4;
}

// The code point of the form of the given width at byte k of a pool view.
fn form_code(pool: [i64], k: i64, width: i64) -> i64
  requires 0 <= k && k <= 2147483647
  ensures 0 <= result && result <= 2097151
{
  let b: i64 = byte(pool, k);
  if width == 1 { return b; }
  let b1: i64 = byte(pool, k + 1) % 64;
  if width == 2 { return b % 32 * 64 + b1; }
  let b2: i64 = byte(pool, k + 2) % 64;
  if width == 3 { return b % 16 * 4096 + b1 * 64 + b2; }
  return b % 8 * 262144 + b1 * 4096 + b2 * 64 + byte(pool, k + 3) % 64;
}

// UTF-16 units of the complete forms in bytes off..off + n of a pool view (n is cut to the stream).
fn units_in(pool: [i64], off0: i64, n0: i64) -> i64
  ensures 0 <= result && result <= 1073741823
{
  let off: i64 = crate::ent_u16::clamp(off0, 1073741823);
  let n: i64 = crate::ent_u16::clamp(n0, crate::ent_u16::clamp(nbytes(pool) - off, 1073741823));
  let mut k: i64 = 0;
  let mut u: i64 = 0;
  while k < n
    invariant 0 <= k && k <= n + 3 && 0 <= u && u <= k && 0 <= off && off <= 1073741823 && n <= 1073741823
    decreases n - k
  {
    let b: i64 = byte(pool, off + k);
    let width: i64 = form_width(b);
    if width > n - k { return u; }
    if width == 4 { u = u + 2; } else if b != 255 { u = u + 1; }
    k = k + width;
  }
  return crate::ent_u16::clamp(u, 1073741823);
}

pub fn span_units(w: [i64], pool: i64, off0: i64, n0: i64) -> i64
  ensures 0 <= result && result <= 1073741823
{
  return units_in(pool_at(w, pool), off0, n0);
}

// Byte length of a complete prefix containing at most the requested number of units.
fn prefix_in(pool: [i64], off0: i64, n0: i64, limit0: i64) -> i64
  ensures 0 <= result && result <= 1073741823
{
  let off: i64 = crate::ent_u16::clamp(off0, 1073741823);
  let n: i64 = crate::ent_u16::clamp(n0, crate::ent_u16::clamp(nbytes(pool) - off, 1073741823));
  let limit: i64 = crate::ent_u16::clamp(limit0, 1073741823);
  let mut k: i64 = 0;
  let mut u: i64 = 0;
  while k < n && u < limit
    invariant 0 <= k && k <= n && n <= 1073741823 && 0 <= u && u <= limit && limit <= 1073741823 && 0 <= off && off <= 1073741823
    decreases n - k
  {
    let b: i64 = byte(pool, off + k);
    let width: i64 = form_width(b);
    if width > n - k { return k; }
    if width == 4 {
      if u + 2 > limit { return k; }
      u = u + 2;
    } else if b != 255 { u = u + 1; }
    k = k + width;
  }
  return k;
}

pub fn prefix_bytes(w: [i64], pool: i64, off0: i64, n0: i64, limit0: i64) -> i64
  ensures 0 <= result && result <= 1073741823
{
  return prefix_in(pool_at(w, pool), off0, n0, limit0);
}

// Decode bytes off..off + n of a pool view into o at `at`; returns the position after the units.
fn decode_into(pool: [i64], off0: i64, n0: i64, inout o: [i64], at: i64) -> i64
  requires 0 <= at && at <= 4294967296
  ensures len(o) == len(old(o)) && at <= result && result <= at + 1073741824
{
  let off: i64 = crate::ent_u16::clamp(off0, 1073741823);
  let n: i64 = crate::ent_u16::clamp(n0, crate::ent_u16::clamp(nbytes(pool) - off, 1073741823));
  let mut k: i64 = 0;
  let mut u: i64 = 0;
  while k < n
    invariant 0 <= k && k <= n && 0 <= u && u <= k && n <= 1073741823 && 0 <= off && off <= 1073741823 && 0 <= at && at <= 4294967296 && len(o) == len(old(o))
    decreases n - k
  {
    let b: i64 = byte(pool, off + k);
    let width: i64 = form_width(b);
    if width > n - k { return at + u; }
    let cp: i64 = form_code(pool, off + k, width);
    if b == 255 {
    } else if width == 4 {
      let scalar: i64 = crate::ent_u16::clamp(cp - 65536, 1048575);
      crate::ent_u16::wr(inout o, at + u, 55296 + scalar / 1024);
      crate::ent_u16::wr(inout o, at + u + 1, 56320 + scalar % 1024);
      u = u + 2;
    } else {
      crate::ent_u16::wr(inout o, at + u, cp);
      u = u + 1;
    }
    k = k + width;
  }
  return at + u;
}

fn decode_span(pool: [i64], off: i64, n: i64) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let mut o: [i64] = alloc(units_in(pool, off, n), 0);
  let end: i64 = decode_into(pool, off, n, inout o, 0);
  return o;
}

fn slot_off(w: [i64], p: i64) -> i64
  ensures 0 <= result && result <= 1073741823
{
  return crate::ent_u16::clamp(pstr_off(w, crate::ent_u16::clamp(p, 4294967296)), 1073741823);
}

pub fn slot_bytes(w: [i64], p: i64) -> i64
  ensures 0 <= result && result <= 1073741823
{
  return crate::ent_u16::clamp(pstr_raw_len(w, crate::ent_u16::clamp(p, 4294967296)), 1073741823);
}

pub fn str_len(w: [i64], p: i64) -> i64
  ensures 0 <= result && result <= 16777216
{
  return crate::ent_u16::clamp(units_in(pool_at(w, crate::ent_packet::sec_start(w, 0)), slot_off(w, p), slot_bytes(w, p)), 16777216);
}

pub fn str_units(w: [i64], p: i64) -> [i64] ! alloc
  ensures len(result) >= 0
{
  return decode_span(pool_at(w, crate::ent_packet::sec_start(w, 0)), slot_off(w, p), slot_bytes(w, p));
}

pub fn str_eq_arr(w: [i64], p: i64, lit: [i64]) -> bool ! alloc
{
  if tag_at(w, p) != 6 { return false; }
  let expected: [i64] = encode_pool(lit);
  let n: i64 = slot_bytes(w, p);
  return n == nbytes(expected) &&
    span_eq(pool_at(w, crate::ent_packet::sec_start(w, 0)), slot_off(w, p), expected, 0, n);
}

pub fn str_eq_lit(w: [i64], p: i64, s: str) -> bool
{
  return pstr_eq_lit(pool_at(w, crate::ent_packet::sec_start(w, 0)), w, p, s);
}

pub fn str_eq(w1: [i64], p1: i64, w2: [i64], p2: i64) -> bool
{
  return pstr_eq(pool_at(w1, crate::ent_packet::sec_start(w1, 0)), w1, p1,
                 pool_at(w2, crate::ent_packet::sec_start(w2, 0)), w2, p2);
}

// strict equality (===) of two slots. Tags 0 and 10 are equal; numbers: NaN is unequal, +0 equals -0; refs by id.
// Other tag pairings (arrays, objects, inspected objects) are unequal.
pub fn strict_eq(w1: [i64], p10: i64, w2: [i64], p20: i64) -> bool
{
  let p1: i64 = crate::ent_u16::clamp(p10, 4294967296);
  let p2: i64 = crate::ent_u16::clamp(p20, 4294967296);
  let t1: i64 = ntag(w1, p1);
  let t2: i64 = ntag(w2, p2);
  if t1 != t2 { return false; }
  if t1 == 0 || t1 == 1 || t1 == 2 || t1 == 3 { return true; }
  if t1 == 4 { return crate::ent_u16::rd(w1, p1 + 1) == crate::ent_u16::rd(w2, p2 + 1); }
  if t1 == 5 {
    let lo1: i64 = crate::ent_u16::rd(w1, p1 + 1);
    let hi1: i64 = crate::ent_u16::rd(w1, p1 + 2);
    let lo2: i64 = crate::ent_u16::rd(w2, p2 + 1);
    let hi2: i64 = crate::ent_u16::rd(w2, p2 + 2);
    if is_nan_bits(lo1, hi1) || is_nan_bits(lo2, hi2) { return false; }
    if is_zero_bits(lo1, hi1) && is_zero_bits(lo2, hi2) { return true; }
    return lo1 == lo2 && hi1 == hi2;
  }
  if t1 == 6 { return str_eq(w1, p1, w2, p2); }
  if t1 == 9 { return crate::ent_u16::rd(w1, p1 + 1) == crate::ent_u16::rd(w2, p2 + 1); }
  return false;
}

// ---- bound-key stringification (template literal `${v}`) ----

// 2^53, the "not a safe integer" sentinel of num_int
pub fn int_bad() -> i64 ensures result == 9007199254740992 { return 9007199254740992; }

// A JS Number (low, high 32 bits) that is a safe integer gives its signed value (-0 gives 0); anything else gives int_bad().
pub fn num_int(lo0: i64, hi0: i64) -> i64
  ensures result == 9007199254740992 || (-9007199254740991 <= result && result <= 9007199254740991)
{
  let lo: i64 = crate::ent_u16::clamp(lo0, 4294967295);
  let hi: i64 = crate::ent_u16::clamp(hi0, 4294967295);
  let er: i64 = band(ushr(hi, 20), 2047);
  let mh: i64 = band(hi, 1048575);
  if er == 0 {
    if mh == 0 && lo == 0 { return 0; }
    return int_bad();
  }
  let e: i64 = er - 1023;
  if e < 0 || e > 52 { return int_bad(); }
  let full: i64 = 4503599627370496 + mh * 4294967296 + lo;
  let sh: i64 = 52 - e;
  let n: i64 = ushr(full, sh);
  if wrapping_shl(n, sh) != full { return int_bad(); }
  if n > 9007199254740991 || n < 0 { return int_bad(); }
  if ushr(hi, 31) == 1 { return 0 - n; }
  return n;
}

// number of decimal digits of n (0 <= n <= 2^53; 0 has one digit)
pub fn dec_digits(n0: i64) -> i64
  ensures 1 <= result && result <= 17
{
  let mut n: i64 = n0;
  if n < 0 { n = 0; }
  if n > 9007199254740992 { n = 9007199254740992; }
  let mut d: i64 = 1;
  let mut i: i64 = 0;
  while i < 16
    invariant 0 <= i && i <= 16 && 1 <= d && d <= i + 1 && 0 <= n
    decreases 16 - i
  {
    if n >= 10 {
      n = n / 10;
      d = d + 1;
    }
    i = i + 1;
  }
  return d;
}

// Length of the template-literal string of the slot at p, or -1 when outside the supported domain
// (refs, non-safe-integer Numbers, non-primitive tags).
pub fn key_len(w: [i64], p0: i64) -> i64
  ensures -1 <= result && result <= 16777216
{
  let p: i64 = crate::ent_u16::clamp(p0, 4294967296);
  let t: i64 = ntag(w, p);
  if t == 0 { return 9; }
  if t == 1 { return 4; }
  if t == 2 { return 5; }
  if t == 3 { return 4; }
  if t == 6 { return str_len(w, p); }
  if t == 5 {
    let v: i64 = num_int(crate::ent_u16::rd(w, p + 1), crate::ent_u16::rd(w, p + 2));
    if v == int_bad() { return -1; }
    if v < 0 { return 1 + dec_digits(0 - v); }
    return dec_digits(v);
  }
  return -1;
}

// write the units of a literal at o[at..]; returns the position after
pub fn put_lit(inout o: [i64], at0: i64, s: str) -> i64 ! alloc
  ensures len(o) == len(old(o))
{
  let at: i64 = crate::ent_u16::clamp(at0, 4294967296);
  let n: i64 = len(s);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n == len(s) && len(o) == len(old(o)) && 0 <= at && at <= 4294967296
    decreases n - i
  {
    crate::ent_u16::wr(inout o, at + i, s[i]);
    i = i + 1;
  }
  return at + n;
}

// Write the template-literal string of the slot at p into o at `at`; returns the position after it (key_len(w,p) units).
// Numbers are written as signed decimal. Unsupported slots write nothing and return `at`.
pub fn key_put(w: [i64], p0: i64, inout o: [i64], at0: i64) -> i64 ! alloc
  ensures len(o) == len(old(o))
{
  let r: i64 = key_put_at(w, p0, crate::ent_packet::sec_start(w, 0), inout o, at0);
  return r;
}

pub fn key_put_at(w: [i64], p0: i64, pool: i64, inout o: [i64], at0: i64) -> i64 ! alloc
  ensures len(o) == len(old(o))
{
  let p: i64 = crate::ent_u16::clamp(p0, 4294967296);
  let at: i64 = crate::ent_u16::clamp(at0, 4294967296);
  let t: i64 = ntag(w, p);
  if t == 0 {
    let r: i64 = put_lit(inout o, at, "undefined");
    return r;
  }
  if t == 1 {
    let r: i64 = put_lit(inout o, at, "null");
    return r;
  }
  if t == 2 {
    let r: i64 = put_lit(inout o, at, "false");
    return r;
  }
  if t == 3 {
    let r: i64 = put_lit(inout o, at, "true");
    return r;
  }
  if t == 6 {
    let r: i64 = decode_into(pool_at(w, pool), slot_off(w, p), slot_bytes(w, p), inout o, at);
    return r;
  }
  if t == 5 {
    let v: i64 = num_int(crate::ent_u16::rd(w, p + 1), crate::ent_u16::rd(w, p + 2));
    if v == int_bad() { return at; }
    let mut n: i64 = v;
    let mut pos: i64 = at;
    if v < 0 {
      crate::ent_u16::wr(inout o, pos, 45);
      pos = pos + 1;
      n = 0 - v;
    }
    let d: i64 = dec_digits(n);
    let mut k: i64 = d;
    let mut m: i64 = n;
    while k > 0
      invariant 0 <= k && k <= d && d <= 17 && 0 <= m && 0 <= pos && pos <= 4294967298 && len(o) == len(old(o))
      decreases k
    {
      crate::ent_u16::wr(inout o, pos + k - 1, 48 + m % 10);
      m = m / 10;
      k = k - 1;
    }
    return pos + d;
  }
  return at;
}

// ---- DB17: entry slot helpers ----

// Read the stored span without clamping, so validators can reject invalid coordinates.
pub fn pstr_off(w: [i64], p: i64) -> i64
  requires 0 <= p && p <= 4294967296
{
  return crate::ent_u16::rd(w, p + 1);
}

pub fn pstr_raw_len(w: [i64], p: i64) -> i64
  requires 0 <= p && p <= 4294967296
{
  return crate::ent_u16::rd(w, p + 2);
}

// Rebase a slot already written into the destination.
pub fn pstr_set_off(inout o: [i64], p: i64, off: i64) -> ()
  requires 0 <= p && p + 1 < len(o)
  ensures len(o) == len(old(o))
{
  o[p + 1] = off;
}

// Write a prefix slot that shares its source pool.
pub fn pstr_put_prefix(inout o: [i64], at: i64, w: [i64], p: i64, n: i64) -> ()
  requires 0 <= p && p <= 4294967296
  ensures len(o) == len(old(o))
{
  crate::ent_packet::put_vs(inout o, at, 6, pstr_off(w, p), n);
}

// Copy the units of a byte prefix into a preallocated key buffer.
pub fn pool_copy_into(w: [i64], pool: i64, p: i64, n: i64, inout o: [i64], at: i64) -> i64
  requires 0 <= at && at <= 4294967296
  ensures len(o) == len(old(o)) && at <= result && result <= at + 1073741824
{
  return decode_into(pool_at(w, pool), slot_off(w, p), n, inout o, at);
}

pub fn pstr_find_byte(w: [i64], p: i64, pool: i64, b: i64) -> i64
  ensures 0 <= result && result <= 1073741823
{
  let pv: ref [i64] = pool_at(w, pool);
  let off: i64 = slot_off(w, p);
  let n: i64 = crate::ent_u16::clamp(slot_bytes(w, p), crate::ent_u16::clamp(nbytes(pv) - off, 1073741823));
  let mut i: i64 = 0;
  // MUTANT M14: keep the last match.
  while i < n
    invariant 0 <= i && i <= n && n <= 1073741823 && 0 <= off && off <= 1073741823
    decreases n - i
  {
    if byte(pv, off + i) == b { return i; }
    i = i + 1;
  }
  return n;
}

pub fn pool_eq(pool: [i64], a: i64, b: i64, n: i64) -> bool
{
  let mut i: i64 = 0;
  let nn: i64 = crate::ent_u16::clamp(n, 16777216);
  let aa: i64 = crate::ent_u16::clamp(a, 4294967296);
  let bb: i64 = crate::ent_u16::clamp(b, 4294967296);
  while i < nn
    invariant 0 <= i && i <= nn && nn <= 16777216 && 0 <= aa && aa <= 4294967296 && 0 <= bb && bb <= 4294967296
    decreases nn - i
  {
    if crate::ent_u16::rd(pool, aa + i) != crate::ent_u16::rd(pool, bb + i) { return false; }
    i = i + 1;
  }
  return true;
}

pub fn pool_hash(keys: [i64], fo: i64, fl: i64) -> i64
  ensures 0 <= result && result < 2147483629
{
  let fln: i64 = crate::ent_u16::clamp(fl, 16777216);
  let fo0: i64 = crate::ent_u16::clamp(fo, 4294967296);
  // hash of the key units (clamped into 0..2^32 so the arithmetic stays far from overflow)
  let mut hh: i64 = fln;
  let mut q: i64 = 0;
  while q < fln
    invariant 0 <= q && q <= fln && fln <= 16777216 && 0 <= hh && hh < 2147483629 && 0 <= fo0 && fo0 <= 4294967296
    decreases fln - q
  {
    hh = (hh * 1000003 + crate::ent_u16::clamp(crate::ent_u16::rd(keys, fo0 + q), 4294967296)) % 2147483629;
    q = q + 1;
  }
  return hh;
}

// Append a slot to a zeroed pool builder; the source can be an embedded packet.
pub fn append_slot(inout pool: [i64], start: i64, src: [i64], ps: i64, slots: [i64], p: i64, inout out: [i64], at: i64) -> ()
  requires 0 <= start && start <= 2147483647
  ensures len(pool) == len(old(pool)) && len(out) == len(old(out))
{
  let off: i64 = slot_off(slots, p);
  let nb: i64 = crate::ent_u16::clamp(slot_bytes(slots, p), crate::ent_u16::clamp(pool_bytes(src, ps) - off, 1073741823));
  let base: i64 = append_span(inout pool, start, src, ps, off, nb, span_units(src, ps, off, nb));
  crate::ent_packet::put_vs(inout out, at, 6, base, nb);
}

// A whole-form cut can reuse the source span when the source pool is retained.
pub fn put_prefix(inout pool: [i64], inout tab: [i64], at: i64, w: [i64], ps: i64, off0: i64, n: i64, cut: i64, reuse: bool) -> ()
  ensures len(pool) == len(old(pool)) && len(tab) == len(old(tab))
{
  let src: ref [i64] = pool_at(w, ps);
  let off: i64 = crate::ent_u16::clamp(off0, 1073741823);
  let nb: i64 = prefix_in(src, off, n, cut);
  let nu: i64 = units_in(src, off, nb);
  let split: bool = nb < n && nu < cut && form_width(byte(src, off + nb)) == 4;
  write_prefix(inout pool, inout tab, at, src, off, nb, nu, split, reuse);
}

fn write_prefix(inout pool: [i64], inout tab: [i64], at: i64, src: [i64], off: i64, nb: i64, nu: i64, split: bool, reuse: bool) -> ()
  requires 0 <= off && off <= 1073741823 && 0 <= nb && nb <= 1073741823
  ensures len(pool) == len(old(pool)) && len(tab) == len(old(tab))
{
  if !split && reuse {
    crate::ent_packet::put_vs(inout tab, at, 6, off, nb);
    return;
  }
  let base: i64 = append_span(inout pool, 0, src, 0, off, nb, nu);
  if split {
    let cp: i64 = form_code(src, off + nb, 4);
    let hi: i64 = 55296 + crate::ent_u16::clamp(cp - 65536, 1048575) / 1024;
    let end: i64 = nbytes(pool);
    emit(inout pool, 0, end, 237);
    emit(inout pool, 0, end + 1, 128 + (hi / 64) % 64);
    emit(inout pool, 0, end + 2, 128 + hi % 64);
    let units: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(pool, 0), 1073741823);
    crate::ent_u16::wr(inout pool, 0, units + 1);
    crate::ent_u16::wr(inout pool, 1, end + 3);
    crate::ent_packet::put_vs(inout tab, at, 6, base, nb + 3);
  } else {
    crate::ent_packet::put_vs(inout tab, at, 6, base, nb);
  }
}

// 0 means the title fits. Otherwise the magnitude is one plus the retained byte count;
// a negative result means the cut keeps only the high surrogate of the next form.
pub fn title_cut(w: [i64], ps: i64, p: i64, cut: i64) -> i64
{
  let pv: ref [i64] = pool_at(w, ps);
  let off: i64 = slot_off(w, p);
  let n: i64 = crate::ent_u16::clamp(slot_bytes(w, p), crate::ent_u16::clamp(nbytes(pv) - off, 1073741823));
  let limit: i64 = crate::ent_u16::clamp(cut, 200);
  let mut k: i64 = 0;
  let mut u: i64 = 0;
  while k < n && u < limit
    invariant 0 <= k && k <= n && n <= 1073741823 && 0 <= u && u <= limit && limit <= 200 && 0 <= off && off <= 1073741823
    decreases n - k
  {
    let b: i64 = byte(pv, off + k);
    let width: i64 = form_width(b);
    if width > n - k { return 0; }
    if width == 4 {
      if u + 2 > limit { return 0 - (k + 1); }
      u = u + 2;
    } else if b != 255 { u = u + 1; }
    k = k + width;
  }
  if k == n { return 0; }
  return k + 1;
}

pub fn put_title_prefix(inout pool: [i64], inout tab: [i64], at: i64, w: [i64], p: i64, clip0: i64, cut: i64, reuse: bool) -> ()
  ensures len(pool) == len(old(pool)) && len(tab) == len(old(tab))
{
  let clip: i64 = clip0;
  if clip < 0 - 601 || clip > 601 || clip == 0 { return; }
  let mut nb: i64 = crate::ent_u16::clamp(clip - 1, 600);
  let mut nu: i64 = cut;
  let split: bool = clip < 0;
  if split {
    nb = 0 - clip - 1;
    nu = crate::ent_u16::clamp(cut, 200) - 1;
  }
  write_prefix(inout pool, inout tab, at, pool_at(w, crate::ent_packet::sec_start(w, 0)), slot_off(w, p), nb, nu, split, reuse);
}

// Units of the first cut0 bytes. Separator bytes (255) count no unit.
pub fn prefix_pool_units(w: [i64], pool: i64, cut0: i64) -> i64
  ensures 0 <= result && result <= 1073741823
{
  let pv: ref [i64] = pool_at(w, pool);
  let nb: i64 = nbytes(pv);
  let cut: i64 = crate::ent_u16::clamp(cut0, nb);
  if cut == nb { return crate::ent_u16::clamp(crate::ent_u16::rd(pv, 0), nb); }
  return units_in(pv, 0, cut);
}

pub fn logical_pool_words(w: [i64]) -> i64
  ensures 0 <= result && result <= 16777216
{
  return crate::ent_u16::clamp(crate::ent_u16::rd(w, crate::ent_packet::sec_start(w, 0)), 16777216);
}

pub fn pkt_size(w: [i64]) -> i64
  ensures 0 <= result
{
  let l0: i64 = crate::ent_packet::sec_len(w, 0);
  if l0 < 2 || l0 > len(w) { return len(w); }
  let rest: i64 = len(w) - l0;
  if rest > 16777216 { return rest; }
  return rest + logical_pool_words(w);
}

pub fn pool_new() -> [i64] ! alloc
  ensures len(result) == 2
{
  return alloc(2, 0);
}

pub fn pool_words(pool: [i64]) -> i64
  ensures result == len(pool)
{
  return len(pool);
}

pub fn pool_capacity(nb: i64) -> i64
  requires 0 <= nb && nb <= 2147483647
  ensures result == 2 + (nb + 6) / 7
{
  return 2 + (nb + 6) / 7;
}

// A zeroed preallocated pool can take multiple appends before trimming its unused words.
pub fn pool_finish(pool: [i64], start: i64) -> [i64] ! alloc
  requires 0 <= start && start <= 2147483647
  ensures len(result) >= 0
{
  return crate::ent_u16::slice(pool, start, start + pool_capacity(pool_bytes(pool, start)));
}

// Shorten a standalone pool at a complete form, keeping its packed prefix.
pub fn pool_keep_prefix(inout pool: [i64], nb0: i64, nu0: i64) -> () ! alloc
{
  let nb: i64 = crate::ent_u16::clamp(nb0, nbytes(pool));
  let nu: i64 = crate::ent_u16::clamp(nu0, nb);
  let words: i64 = pool_capacity(nb);
  if nb % 7 != 0 {
    let at: i64 = 2 + nb / 7;
    let shift: i64 = 8 * (7 - nb % 7);
    let word: i64 = crate::ent_u16::rd(pool, at);
    crate::ent_u16::wr(inout pool, at, word & ~((1 << shift) - 1));
  }
  crate::ent_u16::wr(inout pool, 0, nu);
  crate::ent_u16::wr(inout pool, 1, nb);
  if words < len(pool) { pool = truncate(pool, words); }
}

fn emit(inout o: [i64], pool: i64, k: i64, byte: i64) -> ()
  requires 0 <= pool && pool <= 2147483647 && 0 <= k && k <= 2147483647 && 0 <= byte && byte <= 255
  ensures len(o) == len(old(o))
{
  let at: i64 = pool + 2 + k / 7;
  let bits: i64 = byte << (8 * (6 - k % 7));
  let word: i64 = crate::ent_u16::rd(o, at);
  crate::ent_u16::wr(inout o, at, word | bits);
}

pub fn starts_low(pool: [i64], off: i64, n: i64) -> bool
  requires 0 <= off && off <= 1073741823
{
  if n < 3 || byte(pool, off) != 237 { return false; }
  let second: i64 = byte(pool, off + 1);
  return 176 <= second && second <= 191;
}

pub fn ends_high(pool: [i64], end: i64) -> bool
  requires 0 <= end && end <= 1073741823
{
  if end < 3 || byte(pool, end - 3) != 237 { return false; }
  let second: i64 = byte(pool, end - 2);
  return 160 <= second && second <= 175;
}

// Append a range of complete encoded forms, preserving string boundaries.
pub fn append_span(inout o: [i64], dest: i64, w: [i64], src: i64, off0: i64, n0: i64, units0: i64) -> i64
  requires 0 <= dest && dest <= 2147483647
  ensures len(o) == len(old(o)) && 0 <= result && result <= 1073741824
{
  let sv: ref [i64] = pool_at(w, src);
  let dv: ref [i64] = pool_at(o, dest);
  let nb: i64 = nbytes(dv);
  let off: i64 = crate::ent_u16::clamp(off0, 1073741823);
  let n: i64 = crate::ent_u16::clamp(n0, crate::ent_u16::clamp(nbytes(sv) - off, 1073741823));
  let mut base: i64 = nb;
  if ends_high(dv, nb) && starts_low(sv, off, n) { base = nb + 1; }
  if n > 1073741823 - base { return nb; }
  if base > nb { emit(inout o, dest, nb, 255); }
  let mut k: i64 = 0;
  while k < n
    invariant 0 <= k && k <= n && 0 <= base && base + n <= 1073741823 && 0 <= off && off <= 1073741823 && 0 <= dest && dest <= 2147483647 && len(o) == len(old(o))
    decreases n - k
  {
    emit(inout o, dest, base + k, byte(sv, off + k));
    k = k + 1;
  }
  let nu: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(o, dest), 1073741823);
  let units: i64 = crate::ent_u16::clamp(units0, n);
  crate::ent_u16::wr(inout o, dest, nu + units);
  crate::ent_u16::wr(inout o, dest + 1, base + n);
  return base;
}

// Copy an aligned pool prefix and clear only the final partial word's unused bytes.
pub fn copy_pool_prefix(inout o: [i64], dest0: i64, w: [i64], src0: i64, n0: i64, units: i64) -> ()
  ensures len(o) == len(old(o))
{
  let dest: i64 = crate::ent_u16::clamp(dest0, 2147483647);
  let src: i64 = crate::ent_u16::clamp(src0, 2147483647);
  let n: i64 = crate::ent_u16::clamp(n0, pool_bytes(w, src));
  let full: i64 = n / 7;
  let rest: i64 = n % 7;
  crate::ent_u16::wr(inout o, dest, units);
  crate::ent_u16::wr(inout o, dest + 1, n);
  let end: i64 = crate::ent_u16::put_range(inout o, dest + 2, w, src + 2, full);
  if rest != 0 {
    let word: i64 = crate::ent_u16::rd(w, src + 2 + full);
    let shift: i64 = 8 * (7 - rest);
    crate::ent_u16::wr(inout o, dest + 2 + full, word & ~((1 << shift) - 1));
  }
}

pub fn pool_head(w: [i64], src: i64, n0: i64, units: i64) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let n: i64 = crate::ent_u16::clamp(n0, pool_bytes(w, src));
  let mut o: [i64] = alloc(pool_capacity(n), 0);
  copy_pool_prefix(inout o, 0, w, src, n, units);
  return o;
}

pub fn pool_starts_with(pool: [i64], prefix: [i64]) -> bool
{
  let n: i64 = nbytes(prefix);
  if n > nbytes(pool) { return false; }
  let full: i64 = n / 7;
  if 2 + full > len(pool) || 2 + full > len(prefix) || !eq_range(pool, 2, prefix, 2, full) { return false; }
  let rest: i64 = n % 7;
  if rest == 0 { return true; }
  let shift: i64 = 8 * (7 - rest);
  return (crate::ent_u16::rd(pool, 2 + full) >> shift) == (crate::ent_u16::rd(prefix, 2 + full) >> shift);
}

fn high(c: i64) -> bool { return 55296 <= c && c <= 56319; }
fn low(c: i64) -> bool { return 56320 <= c && c <= 57343; }

fn unit_width(s: [i64], i: i64, n: i64) -> i64
  requires 0 <= i && i <= 1073741823 && 0 <= n && n <= 1073741823
  ensures 1 <= result && result <= 4
{
  let c: i64 = crate::ent_u16::rd(s, i);
  if c < 128 { return 1; }
  if c < 2048 { return 2; }
  if high(c) && i + 1 < n && low(crate::ent_u16::rd(s, i + 1)) { return 4; }
  return 3;
}

pub fn slot_len_of(s: [i64]) -> i64
  ensures 0 <= result && result <= 1073741823
{
  let n: i64 = crate::ent_u16::clamp(len(s), 1073741823);
  let mut nb: i64 = 0;
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n + 1 && n <= 1073741823 && 0 <= nb && nb <= 3 * i
    decreases n - i
  {
    let width: i64 = unit_width(s, i, n);
    nb = nb + width;
    if width == 4 { i = i + 2; } else { i = i + 1; }
  }
  return crate::ent_u16::clamp(nb, 1073741823);
}

pub fn encode_pool(s: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let n: i64 = crate::ent_u16::clamp(len(s), 357913941);
  let nb: i64 = slot_len_of(s);
  let mut o: [i64] = alloc(pool_capacity(nb), 0);
  let mut i: i64 = 0;
  let mut k: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n + 1 && n <= 357913941 && 0 <= k && k <= 3 * i
    decreases n - i
  {
    let c: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(s, i), 65535);
    let width: i64 = unit_width(s, i, n);
    if width == 1 { emit(inout o, 0, k, crate::ent_u16::clamp(c, 127)); }
    if width == 2 {
      emit(inout o, 0, k, 192 + (c / 64) % 32);
      emit(inout o, 0, k + 1, 128 + c % 64);
    }
    if width == 3 {
      emit(inout o, 0, k, 224 + c / 4096);
      emit(inout o, 0, k + 1, 128 + (c / 64) % 64);
      emit(inout o, 0, k + 2, 128 + c % 64);
    }
    if width == 4 {
      let d: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(s, i + 1), 65535);
      let cp: i64 = 65536 + crate::ent_u16::clamp(c - 55296, 1023) * 1024 + crate::ent_u16::clamp(d - 56320, 1023);
      emit(inout o, 0, k, 240 + cp / 262144);
      emit(inout o, 0, k + 1, 128 + (cp / 4096) % 64);
      emit(inout o, 0, k + 2, 128 + (cp / 64) % 64);
      emit(inout o, 0, k + 3, 128 + cp % 64);
      i = i + 1;
    }
    i = i + 1;
    k = k + width;
  }
  crate::ent_u16::wr(inout o, 0, n);
  crate::ent_u16::wr(inout o, 1, nb);
  return o;
}

// DB22 (D-DB18-3 P3): encode UTF-16 units straight into an existing pool, with the same bytes, separator and header
// as append_span(o, dest, encode_pool(s), 0, 0, pool_bytes(encode_pool(s), 0), len(s)), without the temp pool.
// The equivalence holds for len(s) <= 16777216 (units past that are not encoded); the only caller (ent_bound) caps
// every key at 16000000 units.
pub fn append_units(inout o: [i64], dest: i64, s: [i64]) -> i64
  requires 0 <= dest && dest <= 2147483647
  ensures len(o) == len(old(o)) && 0 <= result && result <= 1073741824
{
  let dv: ref [i64] = pool_at(o, dest);
  let nb: i64 = nbytes(dv);
  let n: i64 = crate::ent_u16::clamp(len(s), 16777216);
  let kb: i64 = slot_len_of(s);
  let mut base: i64 = nb;
  if n > 0 && ends_high(dv, nb) && low(crate::ent_u16::rd(s, 0)) { base = nb + 1; }
  if kb > 1073741823 - base { return nb; }
  if base > nb { emit(inout o, dest, nb, 255); }
  let mut i: i64 = 0;
  let mut k: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n + 1 && n <= 16777216 && 0 <= k && k <= 3 * i && 0 <= base && base <= 1073741824 && 0 <= dest && dest <= 2147483647 && len(o) == len(old(o))
    decreases n - i
  {
    let c: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(s, i), 65535);
    let width: i64 = unit_width(s, i, n);
    let at: i64 = base + k;
    if width == 1 { emit(inout o, dest, at, crate::ent_u16::clamp(c, 127)); }
    if width == 2 {
      emit(inout o, dest, at, 192 + (c / 64) % 32);
      emit(inout o, dest, at + 1, 128 + c % 64);
    }
    if width == 3 {
      emit(inout o, dest, at, 224 + c / 4096);
      emit(inout o, dest, at + 1, 128 + (c / 64) % 64);
      emit(inout o, dest, at + 2, 128 + c % 64);
    }
    if width == 4 {
      let d: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(s, i + 1), 65535);
      let cp: i64 = 65536 + crate::ent_u16::clamp(c - 55296, 1023) * 1024 + crate::ent_u16::clamp(d - 56320, 1023);
      emit(inout o, dest, at, 240 + cp / 262144);
      emit(inout o, dest, at + 1, 128 + (cp / 4096) % 64);
      emit(inout o, dest, at + 2, 128 + (cp / 64) % 64);
      emit(inout o, dest, at + 3, 128 + cp % 64);
      i = i + 1;
    }
    i = i + 1;
    k = k + width;
  }
  let nu: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(o, dest), 1073741823);
  crate::ent_u16::wr(inout o, dest, nu + crate::ent_u16::clamp(crate::ent_u16::clamp(len(s), 1073741823), kb));
  crate::ent_u16::wr(inout o, dest + 1, base + kb);
  return base;
}

pub fn pool_base(a: [i64], b: [i64]) -> i64
  ensures 0 <= result && result <= 1073741824
{
  let nb: i64 = nbytes(a);
  if ends_high(a, nb) && starts_low(b, 0, nbytes(b)) { return nb + 1; }
  return nb;
}

pub fn pool_cat(a: [i64], b: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let an: i64 = nbytes(a);
  let bn: i64 = nbytes(b);
  let base: i64 = pool_base(a, b);
  if bn > 1073741823 - base { return pool_new(); }
  let mut o: [i64] = alloc(pool_capacity(base + bn), 0);
  // Copy aligned words from the prefix, then add just the suffix bytes.
  let end: i64 = crate::ent_u16::put_range(inout o, 0, a, 0, pool_capacity(an));
  let at: i64 = append_span(inout o, 0, b, 0, 0, bn, crate::ent_u16::rd(b, 0));
  return o;
}

pub fn pool_add(inout pool: [i64], s: [i64]) -> i64 ! alloc
  ensures 0 <= result && result <= 1073741824
{
  let suffix: [i64] = encode_pool(s);
  let off: i64 = pool_base(pool, suffix);
  pool = pool_cat(pool, suffix);
  return off;
}

pub fn pool_put(inout pool: [i64], inout o: [i64], at: i64, s: [i64]) -> () ! alloc
  ensures len(o) == len(old(o))
{
  let off: i64 = pool_add(inout pool, s);
  crate::ent_packet::put_vs(inout o, at, 6, off, nbytes(pool) - off);
}

pub fn pool_put_lit(inout pool: [i64], inout o: [i64], at: i64, s: str) -> () ! alloc
  ensures len(o) == len(old(o))
{
  pool_put(inout pool, inout o, at, crate::ent_u16::lit(s));
}

pub fn pstr_len(pool: [i64], w: [i64], p: i64) -> i64
  ensures 0 <= result && result <= 1073741823
{
  return units_in(pool, slot_off(w, p), slot_bytes(w, p));
}

// DB22 (D-DB18-3 P5): read a string slot in form-aligned parts so a caller that needs only a head of the text does
// not decode the whole span. Parts that start at form boundaries decode to the same units as the whole span.
pub fn pstr_part_bytes(w: [i64], p: i64) -> i64
  ensures 0 <= result && result <= 1073741823
{
  if tag_at(w, p) != 6 { return 0; }
  return slot_bytes(w, p);
}

pub fn pstr_chunk_bytes(pool: [i64], w: [i64], p: i64, from: i64, limit: i64) -> i64
  ensures 0 <= result && result <= 1073741823
{
  if tag_at(w, p) != 6 { return 0; }
  let at: i64 = crate::ent_u16::clamp(from, 1073741823);
  return prefix_in(pool, slot_off(w, p) + at, slot_bytes(w, p) - at, limit);
}

pub fn pstr_part(pool: [i64], w: [i64], p: i64, from: i64, n: i64) -> [i64] ! alloc
  ensures len(result) >= 0
{
  if tag_at(w, p) != 6 { return crate::ent_u16::empty(); }
  return decode_span(pool, slot_off(w, p) + crate::ent_u16::clamp(from, 1073741823), crate::ent_u16::clamp(n, 1073741823));
}

pub fn pstr_units(pool: [i64], w: [i64], p: i64) -> [i64] ! alloc
  ensures len(result) >= 0
{
  if tag_at(w, p) != 6 { return crate::ent_u16::empty(); }
  return decode_span(pool, slot_off(w, p), slot_bytes(w, p));
}

pub fn pstr_eq_lit(pool: [i64], w: [i64], p: i64, s: str) -> bool
{
  if tag_at(w, p) != 6 { return false; }
  let n: i64 = slot_bytes(w, p);
  if n != len(s) { return false; }
  let off: i64 = slot_off(w, p);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n == len(s) && n <= 1073741823 && 0 <= off && off <= 1073741823
    decreases n - i
  {
    if byte(pool, off + i) != s[i] { return false; }
    i = i + 1;
  }
  return true;
}

fn span_eq(pa: [i64], oa: i64, pb: [i64], ob: i64, n: i64) -> bool
  requires 0 <= n && n <= 1073741823 && 0 <= oa && oa <= 1073741823 && 0 <= ob && ob <= 1073741823
{
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n <= 1073741823 && 0 <= oa && oa <= 1073741823 && 0 <= ob && ob <= 1073741823
    decreases n - i
  {
    if byte(pa, oa + i) != byte(pb, ob + i) { return false; }
    i = i + 1;
  }
  return true;
}

pub fn pstr_eq(pa: [i64], a: [i64], ia: i64, pb: [i64], b: [i64], ib: i64) -> bool
{
  let n: i64 = slot_bytes(a, ia);
  return n == slot_bytes(b, ib) && span_eq(pa, slot_off(a, ia), pb, slot_off(b, ib), n);
}

fn compare(a: i64, b: i64) -> i64 ensures -1 <= result && result <= 1
{
  if a < b { return -1; }
  if a > b { return 1; }
  return 0;
}

// Compare the UTF-16 units when a four-byte form meets a lone surrogate.
fn pair_cmp(pool: [i64], pair: i64, lone: i64, left: i64) -> i64
  requires 0 <= pair && pair <= 2147483647 && 0 <= lone && lone <= 2147483647
  ensures -1 <= result && result <= 1
{
  let scalar: i64 = crate::ent_u16::clamp(form_code(pool, pair, 4) - 65536, 1048575);
  let lead: i64 = 55296 + scalar / 1024;
  let c: i64 = compare(lead, form_code(pool, lone, 3));
  if c != 0 { return c; }
  if left <= 3 { return 1; }
  let next: i64 = crate::ent_u16::clamp(lone + 3, 2147483647);
  let width: i64 = form_width(byte(pool, next));
  let cp: i64 = form_code(pool, next, width);
  let trail: i64 = 56320 + scalar % 1024;
  if width == 4 { return 1; }
  // The next complete form cannot be the same low surrogate: that would
  // have formed a pair with the lone high surrogate in a canonical stream.
  return compare(trail, cp);
}

// Compare bytes, except across the UTF-16 ordering boundary at surrogate forms.
pub fn pstr_cmp(pool: [i64], w: [i64], p: i64, q: i64) -> i64
  ensures -1 <= result && result <= 1
{
  let na: i64 = slot_bytes(w, p);
  let nb: i64 = slot_bytes(w, q);
  let oa: i64 = slot_off(w, p);
  let ob: i64 = slot_off(w, q);
  let mut i: i64 = 0;
  while i < na && i < nb
    invariant 0 <= i && i <= na && i <= nb && na <= 1073741823 && nb <= 1073741823 && 0 <= oa && oa <= 1073741823 && 0 <= ob && ob <= 1073741823
    decreases na - i
  {
    let a: i64 = byte(pool, oa + i);
    let b: i64 = byte(pool, ob + i);
    let wa: i64 = form_width(a);
    let wb: i64 = form_width(b);
    if wa != wb {
      if wa == 4 && wb == 3 && b >= 237 {
        if b >= 238 { return -1; }
        if byte(pool, ob + i + 1) >= 160 {
          return pair_cmp(pool, oa + i, ob + i, nb - i);
        }
      }
      if wb == 4 && wa == 3 && a >= 237 {
        if a >= 238 { return 1; }
        if byte(pool, oa + i + 1) >= 160 {
          return 0 - pair_cmp(pool, ob + i, oa + i, na - i);
        }
      }
      return compare(a, b);
    }
    let mut j: i64 = 0;
    while j < wa
      invariant 0 <= j && j <= wa && wa <= 4 && 0 <= i && i <= 1073741823 && 0 <= oa && oa <= 1073741823 && 0 <= ob && ob <= 1073741823
      decreases wa - j
    {
      let c: i64 = compare(byte(pool, oa + i + j), byte(pool, ob + i + j));
      if c != 0 { return c; }
      j = j + 1;
    }
    if wa > na - i || wa > nb - i { return compare(na, nb); }
    i = i + wa;
  }
  return compare(na, nb);
}

// ---- DB17: req slot helpers ----

// Copy a whole pool into a preallocated packet.
pub fn pool_copy_all(inout o: [i64], at: i64, pool: [i64]) -> ()
  requires 0 <= at && at <= 4294967296
  ensures len(o) == len(old(o))
{
  let end: i64 = crate::ent_u16::put_range(inout o, at, pool, 0, pool_words(pool));
}

pub fn pool_clamp_base(base: i64) -> i64
  ensures 0 <= result && result <= 1073741823
{
  return crate::ent_u16::clamp(base, 1073741823);
}

pub fn pool_prefix(pool: [i64], base: i64) -> [i64] ! alloc
  ensures len(result) >= 0
{
  return pool_head(pool, 0, base, prefix_pool_units(pool, 0, base));
}

// A stored pack places its pool word count immediately before the pool.
pub fn packed_pool_write_size(inout w: [i64], size_at: i64, words: i64) -> ()
  ensures len(w) == len(old(w))
{
  crate::ent_u16::wr(inout w, size_at, words);
}

pub fn packed_pool_words(w: [i64], size_at: i64) -> i64
  ensures 0 <= result && result <= 1073741823
{
  return crate::ent_u16::clamp(crate::ent_u16::rd(w, size_at), 1073741823);
}

pub fn packed_pool_ends_at(w: [i64], size_at: i64, end: i64) -> bool
{
  return 0 <= size_at && size_at < end && crate::ent_u16::rd(w, size_at) == end - size_at - 1;
}

pub fn packed_pool_read(w: [i64], size_at: i64) -> [i64] ! alloc
  requires 0 <= size_at && size_at <= 1000000000
  ensures len(result) >= 0
{
  let start: i64 = size_at + 1;
  return crate::ent_u16::slice(w, start, start + packed_pool_words(w, size_at));
}

pub fn pslot_empty(inout o: [i64], at: i64) -> ()
  ensures len(o) == len(old(o))
{
  crate::ent_packet::put_vs(inout o, at, 6, 0, 0);
}

// Test the stored length exactly, including for an unvalidated slot.
pub fn pslot_is_empty(w: [i64], p: i64) -> bool
  requires 0 <= p && p <= 1000000000
{
  return tag_at(w, p) == 6 && crate::ent_u16::rd(w, p + 2) == 0;
}

// Copy the two slot coordinates into a host call without copying the pool.
pub fn pslot_host_words(inout call: [i64], at: i64, w: [i64], p: i64) -> ()
  requires 0 <= at && at <= 1000000000 && 0 <= p && p <= 1000000000
  ensures len(call) == len(old(call))
{
  crate::ent_u16::wr(inout call, at, crate::ent_u16::rd(w, p + 1));
  crate::ent_u16::wr(inout call, at + 1, crate::ent_u16::rd(w, p + 2));
}

// Same-pool copies preserve all slot words, including incomplete slots.
pub fn pslot_copy(inout o: [i64], q: i64, w: [i64], p: i64) -> ()
  requires 0 <= q && q <= 1000000000 && 0 <= p && p <= 1000000000
  ensures len(o) == len(old(o))
{
  crate::ent_packet::put_vs(inout o, q, tag_at(w, p), crate::ent_u16::rd(w, p + 1), crate::ent_u16::rd(w, p + 2));
}

fn rebased_pool_off(off: i64, base: i64) -> i64
{
  return crate::ent_u16::clamp(off, 1073741823) + pool_clamp_base(base);
}

// Copy any slot, rebasing the offset of a string without changing its length word.
pub fn pslot_copy_off(inout o: [i64], q: i64, w: [i64], p: i64, base: i64) -> ()
  requires 0 <= q && q <= 1000000000 && 0 <= p && p <= 1000000000
  ensures len(o) == len(old(o))
{
  let t: i64 = tag_at(w, p);
  let mut a: i64 = crate::ent_u16::rd(w, p + 1);
  if t == 6 { a = rebased_pool_off(a, base); }
  crate::ent_packet::put_vs(inout o, q, t, a, crate::ent_u16::rd(w, p + 2));
}

// Copy a string slot from a reply whose length was historically clamped.
pub fn pslot_copy_off_clamped(inout o: [i64], q: i64, w: [i64], p: i64, base: i64) -> ()
  requires 0 <= p && p <= 1000000000
  ensures len(o) == len(old(o))
{
  let off: i64 = rebased_pool_off(crate::ent_u16::rd(w, p + 1), base);
  crate::ent_packet::put_vs(inout o, q, 6, off, slot_bytes(w, p));
}

// Copy a slot array and rebase its string offsets in place.
pub fn pslots_rebase(w: [i64], base: i64) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let mut o: [i64] = crate::ent_u16::slice(w, 0, len(w));
  let n: i64 = len(o);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n + 2 && n == len(o)
    decreases n + 2 - i
  {
    if tag_at(o, i) == 6 {
      let off: i64 = rebased_pool_off(crate::ent_u16::rd(o, i + 1), base);
      crate::ent_u16::wr(inout o, i + 1, off);
    }
    i = i + 3;
  }
  return o;
}

pub fn pslot_needs_clip(pool: [i64], w: [i64], p: i64) -> bool
  requires 0 <= p && p <= 1000000000
{
  let off: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(w, p + 1), 1073741823);
  return off + slot_bytes(w, p) > nbytes(pool);
}

// A complete string slot whose raw span is within the pool.
pub fn pslot_ok(pool: [i64], w: [i64], p: i64) -> bool
  requires 0 <= p && p <= 1000000000
{
  if p + 3 > len(w) || tag_at(w, p) != 6 { return false; }
  let a: i64 = crate::ent_u16::rd(w, p + 1);
  let b: i64 = crate::ent_u16::rd(w, p + 2);
  return span_ok(pool, 0, a, b);
}
