// L3-8 entry: UTF-16 unit buffers ([i64], every element 0..65535) and total accessors.
// Hand Rust baseline: hand/ent_u16.rs (`&[u16]` / `Vec<u16>`); the one-unit-per-`i64` element type is gap U
// (consumer API), see RESHAPE.md step 3.1.
// Total accessors (rd/wr/slice) make every index in-bounds by construction: an out-of-range read gives 0 and an
// out-of-range write is dropped. Validation of packets happens before use, so these are defence in depth, not control flow.

pub fn rd(a: [i64], i: i64) -> i64
  ensures (0 <= i && i < len(a)) ==> result == a[i]
{
  if i < 0 || i >= len(a) { return 0; }
  return a[i];
}

pub fn wr(inout a: [i64], i: i64, v: i64) -> ()
  ensures len(a) == len(old(a))
  ensures (0 <= i && i < len(a)) ==> a[i] == v
  ensures forall k in 0..len(old(a)): k == i || a[k] == old(a)[k]
{
  if i < 0 || i >= len(a) { return; }
  a[i] = v;
}

pub fn max_alloc() -> i64 ensures result == 1099511627776 { return 1099511627776; }

// zero array of n words (n clamped into 0..2^40)
pub fn zeros(n: i64) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let mut k: i64 = n;
  if k < 0 || k > 1099511627776 { k = 0; }
  let o: [i64] = alloc(k, 0);
  return o;
}

pub fn empty() -> [i64] ! alloc
  ensures len(result) == 0
{
  let o: [i64] = alloc(0, 0);
  return o;
}

// a[s..e) with s,e clamped
pub fn slice(a: [i64], s: i64, e: i64) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let n: i64 = len(a);
  let mut lo: i64 = s;
  let mut hi: i64 = e;
  if lo < 0 { lo = 0; }
  if hi > n { hi = n; }
  if hi <= lo { return empty(); }
  return copy(subview(a, lo, hi));
}

pub fn cat(a: [i64], b: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let na: i64 = len(a);
  let nb: i64 = len(b);
  if na > 1073741823 || nb > 1073741823 { return empty(); }
  let mut o: [i64] = alloc(0, 0);
  arr_reserve(inout o, na + nb);
  arr_append(inout o, a, 0, na);
  arr_append(inout o, b, 0, nb);
  return o;
}

// ASCII text literal as units
pub fn lit(s: str) -> [i64] ! alloc
  ensures len(result) == len(s)
{
  let n: i64 = len(s);
  let mut o: [i64] = alloc(0, 0);
  arr_reserve(inout o, n);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n == len(s) && len(o) == i
    decreases n - i
  { arr_push(inout o, s[i]); i = i + 1; }
  return o;
}

pub fn one(u: i64) -> [i64] ! alloc
  ensures len(result) == 1
{
  let o: [i64] = alloc(1, u);
  return o;
}

pub fn eq(a: [i64], b: [i64]) -> bool
{
  let n: i64 = len(a);
  if n != len(b) { return false; }
  return eq_range(a, 0, b, 0, n);
}

// a equals the ASCII literal s
pub fn eq_lit(a: [i64], s: str) -> bool
{
  let n: i64 = len(s);
  if n != len(a) { return false; }
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n == len(s) && n == len(a)
    decreases n - i
  {
    if a[i] != s[i] { return false; }
    i = i + 1;
  }
  return true;
}

// first index >= from where a[i] == u, or -1
pub fn index_of(a: [i64], u: i64, from: i64) -> i64
  ensures result >= -1 && result < len(a)
{
  let n: i64 = len(a);
  let mut i: i64 = from;
  if i < 0 { i = 0; }
  if i > n { i = n; }
  while i < n
    invariant 0 <= i && i <= n && n == len(a)
    decreases n - i
  {
    if a[i] == u { return i; }
    i = i + 1;
  }
  return -1;
}

// ECMAScript WhiteSpace + LineTerminator set of String.prototype.trim. 0085 and 200B are not members.
pub fn is_trim_unit(u: i64) -> bool
{
  if u >= 9 && u <= 13 { return true; }   // MUTANT M01
  if u == 32 || u == 160 { return true; }
  if u == 5760 || u == 65279 { return true; }
  if u >= 8192 && u <= 8202 { return true; }
  if u == 8232 || u == 8233 || u == 8239 || u == 8287 || u == 12288 { return true; }
  return false;
}

pub fn trim(a: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let n: i64 = len(a);
  let mut s: i64 = 0;
  while s < n && is_trim_unit(a[s])
    invariant 0 <= s && s <= n && n == len(a)
    decreases n - s
  { s = s + 1; }
  let mut e: i64 = n;
  while e > s && is_trim_unit(a[e - 1])
    invariant s <= e && e <= n && 0 <= s && n == len(a)
    decreases e - s
  { e = e - 1; }
  return copy(subview(a, s, e));
}

// ---- W4core additions (new helpers only; nothing above is changed) ----

// x clamped into 0..hi (hi >= 0)
pub fn clamp(x: i64, hi: i64) -> i64
  requires 0 <= hi
  ensures 0 <= result && result <= hi
  ensures (0 <= x && x <= hi) ==> result == x
  ensures x > hi ==> result == hi
  ensures x < 0 ==> result == 0
{
  if x < 0 { return 0; }
  if x > hi { return hi; }
  return x;
}

// copy m units of src starting at s into o at position at; every index is total (out of range reads give 0, writes are dropped).
// Returns at + m' where m' is m clamped into 0..2^30. at must be in 0..2^32.
pub fn put_range(inout o: [i64], at: i64, src: [i64], s: i64, m: i64) -> i64
  requires 0 <= at && at <= 4294967296 && 0 <= s && s <= 4294967296
  ensures len(o) == len(old(o)) && at <= result && result <= at + 1073741824
{
  let mm: i64 = clamp(m, 1073741824);
  // room: the part of [at, at + mm) inside o; k: the part of that with a source unit; the rest of room writes 0
  let room: i64 = clamp(len(o) - at, mm);
  if room > 0 {
    let k: i64 = clamp(len(src) - s, room);
    if k > 0 { copy_range(inout o, at, src, s, k); }
    let mut j: i64 = at + k;
    while j < at + room
      invariant at + k <= j && j <= at + room && at + room <= len(o) && len(o) == len(old(o))
      decreases at + room - j
    { o[j] = 0; j = j + 1; }
  }
  return at + mm;
}

// copy all of src into o at at; returns the position after it
pub fn put_all(inout o: [i64], at: i64, src: [i64]) -> i64
  requires 0 <= at && at <= 4294967296
  ensures len(o) == len(old(o)) && at <= result && result <= at + 1073741824
{
  return put_range(inout o, at, src, 0, len(src));
}
