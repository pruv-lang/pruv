// L3-8 entry: exact port of Node v26.4.0 path.posix over UTF-16 unit buffers ([i64], each element 0..65535; '/' = 47, '.' = 46).
// Pure functions: is_abs, normalize_string (Node internal, '/' separator), normalize, join2/3/4, join_segs, dirname, basename.
//
// resolve with ONE argument p is split around the process.cwd() observation. Node 26.4.0 calls cwd:
//   p absolute ('/' first)            : 0 times; result = "/" + normalizeString(p + "/", false)
//   p == "" or p == "."  (fast path)  : cwd1 first. If cwd1 starts with '/', the result is cwd1 verbatim (1 call).
//                                       Otherwise the general path calls cwd a 2nd time (cwd2); resolved = cwd2 + "/" + ("" or "./").
//   any other relative p              : exactly 1 call (cwd1); resolved = cwd1 + "/" + p + "/".
// In the general path the result is "/" + normalizeString(resolved, false) when the used cwd starts with '/', else
// normalizeString(resolved, true) or "." when empty (relative or empty cwd).
// API (ncwd = number of cwd results already obtained, cwd1/cwd2 their values; unused ones may be empty):
//   resolve_needs_first_cwd(p)               true iff ncwd == 0 needs a call (== !is_abs(p))
//   resolve_need(p, ncwd, cwd1, cwd2)        true iff one more cwd call is needed after ncwd calls (ncwd 0, 1, 2)
//   resolve_finish(p, ncwd, cwd1, cwd2)      the result once resolve_need is false
// A cwd call that throws escapes resolve in Node; the caller handles that before calling these.
// Hand Rust baseline: hand/ent_path.rs (`&[u16]` in, `Vec<u16>` out, one growing buffer per result); the
// one-unit-per-`i64` element type is gap U (consumer API), see RESHAPE.md step 3.1.

pub fn is_abs(p: [i64]) -> bool
{
  return len(p) > 0 && p[0] == 47;
}

// last index of '/' in a, or -1 (hand `rposition`)
fn last_slash_idx(a: [i64]) -> i64
  ensures result >= -1 && result < len(a)
{
  let mut k: i64 = len(a);
  while k > 0
    invariant 0 <= k && k <= len(a)
    decreases k
  {
    if a[k - 1] == 47 { return k - 1; }
    k = k - 1;
  }
  return -1;
}

// Node internal normalizeString(path, allowAboveRoot, '/', isPosixPathSeparator)
pub fn normalize_string(p: [i64], allow_above_root: bool) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let n: i64 = len(p);
  let mut res: [i64] = alloc(0, 0);
  if n > 1073741823 { return res; }
  arr_reserve(inout res, n);
  let mut lsl: i64 = 0;        // lastSegmentLength
  let mut last_slash: i64 = -1;
  let mut dots: i64 = 0;
  let mut code: i64 = 0;
  for i in 0..n + 1
    invariant n == len(p) && n <= 1073741823 && -1 <= last_slash && last_slash < i
      && len(res) <= last_slash + 3 && -1 <= dots && (dots >= 0 ==> last_slash + dots < i)
  {
    if i < n { code = p[i]; }
    else if code == 47 { break; }
    else { code = 47; }
    if code == 47 {
      if last_slash == i - 1 || dots == 1 {
        // NOOP
      } else if dots == 2 {
        let u: i64 = len(res);
        if u < 2 || lsl != 2 || res[u - 1] != 46 || res[u - 2] != 46 {
          if u > 2 {
            let li: i64 = last_slash_idx(res);
            if li == -1 {
              res = truncate(res, 0);
              lsl = 0;
            } else {
              res = truncate(res, li);
              lsl = li - 1 - last_slash_idx(res);
            }
            last_slash = i;
            dots = 0;
            continue;
          } else if u != 0 {
            res = truncate(res, 0);
            lsl = 0;
            last_slash = i;
            dots = 0;
            continue;
          }
        }
        if allow_above_root {
          if len(res) > 0 { arr_push(inout res, 47); }
          arr_push(inout res, 46, 46);
          lsl = 2;
        }
      } else {
        if len(res) > 0 { arr_push(inout res, 47); }
        arr_append(inout res, p, last_slash + 1, i - last_slash - 1);
        lsl = i - last_slash - 1;
      }
      last_slash = i;
      dots = 0;
    } else if code == 46 && dots != -1 {
      dots = dots + 1;
    } else {
      dots = -1;
    }
  }
  return res;
}

pub fn normalize(p: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  if len(p) == 0 { return crate::ent_u16::one(46); }
  let absolute: bool = is_abs(p);
  let trailing: bool = p[len(p) - 1] == 47;
  let r: [i64] = normalize_string(p, !absolute);
  if len(r) == 0 {
    if absolute { return crate::ent_u16::one(47); }
    if trailing { return crate::ent_u16::lit("./"); }
    return crate::ent_u16::one(46);
  }
  let mut out: [i64] = alloc(0, 0);
  if len(r) > 1073741823 { return r; }
  arr_reserve(inout out, len(r) + 2);
  if absolute { arr_push(inout out, 47); }
  arr_append(inout out, r, 0, len(r));
  if trailing { arr_push(inout out, 47); }
  return out;
}

// Node join: a non-empty part goes after a '/' when joined is not empty (hand `push_part`)
fn push_part(inout joined: [i64], part: [i64]) -> () ! alloc
  requires len(joined) <= 4294967296 && len(part) <= 1073741823
  ensures len(joined) <= len(old(joined)) + len(part) + 1
{
  if len(part) == 0 { return; }
  if len(joined) > 0 { arr_push(inout joined, 47); }
  arr_append(inout joined, part, 0, len(part));
}

pub fn join2(a: [i64], b: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let mut joined: [i64] = alloc(0, 0);
  if len(a) > 1073741823 || len(b) > 1073741823 { return normalize(joined); }
  arr_reserve(inout joined, len(a) + len(b) + 2);
  push_part(inout joined, a);
  push_part(inout joined, b);
  return normalize(joined);
}

pub fn join3(a: [i64], b: [i64], c: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let mut joined: [i64] = alloc(0, 0);
  if len(a) > 1073741823 || len(b) > 1073741823 || len(c) > 1073741823 { return normalize(joined); }
  arr_reserve(inout joined, len(a) + len(b) + len(c) + 3);
  push_part(inout joined, a);
  push_part(inout joined, b);
  push_part(inout joined, c);
  return normalize(joined);
}

pub fn join4(a: [i64], b: [i64], c: [i64], d: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let mut joined: [i64] = alloc(0, 0);
  if len(a) > 1073741823 || len(b) > 1073741823 || len(c) > 1073741823 || len(d) > 1073741823 { return normalize(joined); }
  arr_reserve(inout joined, len(a) + len(b) + len(c) + len(d) + 4);
  push_part(inout joined, a);
  push_part(inout joined, b);
  push_part(inout joined, c);
  push_part(inout joined, d);
  return normalize(joined);
}

// join(base, ...segments) where segs holds non-empty '/'-free segments joined by '/' (empty segs: join(base))
pub fn join_segs(base: [i64], segs: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let mut joined: [i64] = alloc(0, 0);
  if len(base) > 1073741823 || len(segs) > 1073741823 { return normalize(joined); }
  arr_reserve(inout joined, len(base) + len(segs) + 2);
  push_part(inout joined, base);
  push_part(inout joined, segs);
  return normalize(joined);
}

pub fn dirname(p: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let n: i64 = len(p);
  if n == 0 { return crate::ent_u16::one(46); }
  let root: bool = p[0] == 47;
  let mut endp: i64 = -1;
  let mut matched: bool = true;
  let mut i: i64 = n - 1;
  while i >= 1
    invariant 0 <= i && i <= n - 1 && n == len(p) && endp == -1
    decreases i
  {
    if p[i] == 47 {
      if !matched { endp = i; break; }
    } else {
      matched = false;
    }
    i = i - 1;
  }
  if endp == -1 {
    if root { return crate::ent_u16::one(47); }
    return crate::ent_u16::one(46);
  }
  if root && endp == 1 { return crate::ent_u16::lit("//"); }
  return copy(subview(p, 0, endp));
}

pub fn basename(p: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let n: i64 = len(p);
  let mut start: i64 = 0;
  let mut endp: i64 = -1;
  let mut matched: bool = true;
  let mut i: i64 = n - 1;
  while i >= 0
    invariant -1 <= i && i <= n - 1 && n == len(p) && start == 0 && (endp == -1 || (i < endp && endp <= n))
    decreases i + 1
  {
    if p[i] == 47 {
      if !matched {
        start = i + 1;
        break;
      }
    } else if endp == -1 {
      matched = false;
      endp = i + 1;
    }
    i = i - 1;
  }
  if endp == -1 { return crate::ent_u16::empty(); }
  return copy(subview(p, start, endp));
}

// ---- resolve(p) with one argument, split around process.cwd() ----
pub fn resolve_needs_first_cwd(p: [i64]) -> bool
{
  return !is_abs(p);
}

fn is_fast(p: [i64]) -> bool
{
  return len(p) == 0 || (len(p) == 1 && p[0] == 46);
}

pub fn resolve_need(p: [i64], ncwd: i64, cwd1: [i64], cwd2: [i64]) -> bool
{
  if is_abs(p) { return false; }
  if ncwd <= 0 { return true; }
  if ncwd == 1 { return is_fast(p) && !is_abs(cwd1); }
  return false;
}

// the cwd result the resolve uses (hand `let c = if ncwd >= 2 { cwd2 } else { cwd1 };`)
fn used_cwd(ncwd: i64, cwd1: [i64], cwd2: [i64]) -> ref [i64] from(cwd1, cwd2)
  ensures len(result) <= len(cwd1) || len(result) <= len(cwd2)
{
  if ncwd >= 2 { return subview(cwd2, 0, len(cwd2)); }
  return subview(cwd1, 0, len(cwd1));
}

pub fn resolve_finish(p: [i64], ncwd: i64, cwd1: [i64], cwd2: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let mut resolved: [i64] = alloc(0, 0);
  let mut absolute: bool = true;
  if len(p) > 1073741823 || len(cwd1) > 1073741823 || len(cwd2) > 1073741823 { return resolved; }
  if is_abs(p) {
    arr_reserve(inout resolved, len(p) + 1);
    arr_append(inout resolved, p, 0, len(p));
    arr_push(inout resolved, 47);
  } else {
    if ncwd == 1 && is_fast(p) && is_abs(cwd1) { return copy(cwd1); }
    let c: ref [i64] = used_cwd(ncwd, cwd1, cwd2);
    arr_reserve(inout resolved, len(c) + len(p) + 2);
    arr_append(inout resolved, c, 0, len(c));
    arr_push(inout resolved, 47);
    if len(p) > 0 {
      arr_append(inout resolved, p, 0, len(p));
      arr_push(inout resolved, 47);
    }
    absolute = is_abs(c);
  }
  let r: [i64] = normalize_string(resolved, !absolute);
  if absolute {
    let mut out: [i64] = alloc(0, 0);
    if len(r) > 1073741823 { return r; }
    arr_reserve(inout out, len(r) + 1);
    arr_push(inout out, 47);
    arr_append(inout out, r, 0, len(r));
    return out;
  }
  if len(r) == 0 { return crate::ent_u16::one(46); }
  return r;
}
