// L3-8 entry API (shared lib module): packet layer and the simple ops. See ent_state.pruv for the replay architecture.
// The root (bench/l3/entry/root.pruv) forwards entry_begin / entry_step here.

fn bad_pkt(w: [i64], code: i64) -> [i64] ! alloc
{
  let mut c: i64 = 0;
  if code == 2 { c = 1; }
  return crate::ent_packet::boundary(crate::ent_u16::rd(w, 5), crate::ent_u16::rd(w, 2), c);
}

fn run_item(inout cx: crate::ent_state::Ctx) -> Result<(), crate::ent_state::Halt> ! alloc
{
  if cx.op == 2 {
    crate::ent_dispatch::find_source(inout cx);
    return Ok::<(), crate::ent_state::Halt>(());
  }
  if cx.op == 3 { return crate::ent_dispatch::list_external(inout cx); }
  if cx.op == 4 { return crate::ent_dispatch::read_external(inout cx); }
  if cx.op == 7 { return crate::ent_bound::session_threads(inout cx); }
  if cx.op == 8 { return crate::ent_bound::excluded_from_bound(inout cx); }
  return crate::ent_state::stop_fail(inout cx);
}

pub fn entry_begin(input: [i64]) -> [i64] ! alloc
{
  return entry_begin_with_env(input, crate::ent_packet::env_check(input));
}

pub fn entry_begin_with_env(input: [i64], ec: i64) -> [i64] ! alloc
{
  if ec != 0 { return bad_pkt(input, ec); }
  let op: i64 = crate::ent_u16::rd(input, 5);
  let id: i64 = crate::ent_u16::rd(input, 2);
  if crate::ent_u16::rd(input, 1) != 0 || crate::ent_u16::rd(input, 3) != 0 || op == 9 { return bad_pkt(input, 1); }
  if op == 1 { return crate::ent_sources::import_begin(input); }
  if op == 5 { return crate::ent_accounts::account_home_begin(input); }
  if op == 6 { return crate::ent_canon::codex_folder_begin(input); }
  let hi: i64 = crate::ent_packet::input_check(input);
  if hi < 0 { return bad_pkt(input, 1); }
  // TM: a take parameter needs a named local (`move x`); the hand passes the call results directly.
  let blob: [i64] = crate::ent_state::repack(input, hi);
  let lg: [i64] = crate::ent_u16::empty();
  let mut cx: crate::ent_state::Ctx = crate::ent_state::ctx_new(op, id, move blob, move lg, crate::ent_u16::empty());
  let r: Result<(), crate::ent_state::Halt> = run_item(inout cx);
  return crate::ent_state::finish(cx, 1, 0);
}

pub fn entry_step(prev: [i64], completion: [i64]) -> [i64] ! alloc
{
  return entry_step_at(prev, completion, false);
}

pub fn entry_step_at(prev: [i64], completion: [i64], wire: bool) -> [i64] ! alloc
{
  let e1: i64 = if wire { crate::ent_packet::env_check_wire(prev) } else { crate::ent_packet::env_check(prev) };
  if e1 != 0 { return bad_pkt(prev, e1); }
  let e2: i64 = if wire { crate::ent_packet::env_check_wire(completion) } else { crate::ent_packet::env_check(completion) };
  if e2 != 0 { return bad_pkt(prev, e2); }
  let op: i64 = crate::ent_u16::rd(prev, 5);
  let id: i64 = crate::ent_u16::rd(prev, 2);
  let seq: i64 = crate::ent_u16::rd(prev, 3);
  if crate::ent_u16::rd(prev, 1) != 1 || crate::ent_u16::rd(completion, 1) != 2 { return bad_pkt(prev, 1); }
  if crate::ent_u16::rd(completion, 2) != id || crate::ent_u16::rd(completion, 3) != seq || crate::ent_u16::rd(completion, 5) != op ||
     seq >= 9007199254740992 { return bad_pkt(prev, 1); }
  if op == 1 { return crate::ent_sources::import_step(prev, completion); }
  if op == 6 { return crate::ent_canon::codex_folder_step(prev, completion); }
  if op == 2 || op == 5 || op == 7 || op == 9 { return bad_pkt(prev, 1); }
  let s2: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(prev, 2), 33554432);
  let s3: i64 = crate::ent_u16::clamp(s2 + crate::ent_u16::clamp(crate::ent_packet::sec_len(prev, 2), 16777216), len(prev));
  let st: ref [i64] = subview(prev, crate::ent_u16::clamp(s2, s3), s3);
  // One view of the state words (hand: State::parse(..).filter(replay_ok) -> Option<State>, row OR).
  let s: crate::ent_state::State = crate::ent_state::state_view(st);
  if !crate::ent_state::state_ok(st, s, op, id) || !crate::ent_state::replay_ok(s, op, seq) { return bad_pkt(prev, 1); }
  let hi: i64 = crate::ent_packet::comp_check(completion, s.code, s.aux);
  if hi < 0 { return bad_pkt(prev, 1); }
  let lg: [i64] = crate::ent_state::log_append(s.log, s.code, s.aux, completion, hi);
  if crate::ent_state::log_words(lg) > 16777216 { return bad_pkt(prev, 2); }
  let blob: [i64] = copy(s.blob);
  let mut cx: crate::ent_state::Ctx = crate::ent_state::ctx_new(op, id, move blob, move lg, s.ck);
  crate::ent_state::use_prev(inout cx, prev, true);
  let r: Result<(), crate::ent_state::Halt> = run_item(inout cx);
  return crate::ent_state::finish(cx, seq + 1, seq);
}

// Op 9 issues at most one await. Its state section retains the v1 wire format.
// The caller keeps input after the call and passes it to index_step (the await does not copy it).
pub fn index_begin(inout progress: [i64], input: [i64]) -> [i64] ! alloc
{
  crate::ent_u16::wr(inout progress, 0, 0);
  let ec: i64 = crate::ent_packet::env_check_wire(input);
  if ec != 0 { return bad_pkt(input, ec); }
  if crate::ent_u16::rd(input, 1) != 0 || crate::ent_u16::rd(input, 3) != 0 || crate::ent_u16::rd(input, 5) != 9 {
    return bad_pkt(input, 1);
  }
  let hi: i64 = crate::ent_packet::input_check(input);
  if hi < 0 { return bad_pkt(input, 1); }
  let raw: i64 = crate::ent_value::pkt_size(input);
  if hi != crate::ent_value::pool_bytes(input, crate::ent_packet::sec_start(input, 0)) {
    let blob: [i64] = crate::ent_state::repack(input, hi);
    return index_begin_checked(inout progress, blob, raw);
  }
  return index_begin_checked(inout progress, input, raw);
}

// Store the expanded pool high-water and input size in the v1 await state.
fn index_begin_checked(inout progress: [i64], blob: [i64], raw: i64) -> [i64] ! alloc
{
  let rec: i64 = crate::ent_packet::sec_start(blob, 1);
  let sec: i64 = crate::ent_u16::rd(blob, rec + 1);
  let ns: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(blob, rec + 2), 559240);
  if len(progress) <= ns { return bad_pkt(blob, 1); }
  let base: i64 = crate::ent_packet::sec_start(blob, sec);
  let mut tab: [i64] = crate::ent_bound::index_collect(blob, base, ns, inout progress);
  let nt: i64 = crate::ent_u16::rd(progress, 0);
  let id: i64 = crate::ent_u16::rd(blob, 2);
  if nt == 0 {
    return crate::ent_bound::index_complete(blob, 0, id, 0, crate::ent_u16::empty(), progress);
  }
  let pool: i64 = crate::ent_packet::sec_start(blob, 0);
  let pl: i64 = crate::ent_value::logical_pool_words(blob);
  let lb: i64 = crate::ent_value::pkt_size(blob);
  let lt: i64 = len(tab);
  if lb > 16777216 || lt > 16777216 || 30 + pl + lb + lt > 16777216 { return bad_pkt(blob, 2); }
  // Keep the compact/full choice in UTF-16 units.
  let mut units: i64 = 0;
  let mut i: i64 = 0;
  while units <= pl && i + 2 < lt
    invariant 0 <= i && i <= lt && lt == len(tab) && lt <= 16777216 && 0 <= pl && pl <= 16777216 && 0 <= units && units <= 2 * pl
    decreases lt - i
  {
    if tab[i] == 6 {
      let off: i64 = crate::ent_value::pstr_off(tab, i);
      let n: i64 = crate::ent_value::pstr_raw_len(tab, i);
      if !crate::ent_value::span_ok(blob, pool, off, n) { return bad_pkt(blob, 1); }
      let u: i64 = crate::ent_value::span_units(blob, pool, off, n);
      if u > pl { return bad_pkt(blob, 1); }
      units = units + u;
    }
    i = i + 3;
  }
  // VB: the hand binds `strings` with a value if whose arms are blocks; a value if arm is one expression (R-6w-1).
  let mut strings: [i64] = crate::ent_u16::empty();
  // DB22 (D-DB18-3 P2): rewrite the ID table slots in place instead of cloning it (same steps as append_slot).
  if units <= pl {
    let mut compact: [i64] = alloc(crate::ent_value::pool_capacity(4 * units), 0);
    let mut j: i64 = 0;
    while j + 2 < lt
      invariant 0 <= j && j <= lt && lt == len(tab) && lt <= 16777216
      decreases lt - j
    {
      if tab[j] == 6 {
        let off: i64 = crate::ent_u16::clamp(crate::ent_value::pstr_off(tab, crate::ent_u16::clamp(j, 4294967296)), 1073741823);
        let nb: i64 = crate::ent_u16::clamp(crate::ent_value::slot_bytes(tab, j), crate::ent_u16::clamp(crate::ent_value::pool_bytes(blob, pool) - off, 1073741823));
        let at: i64 = crate::ent_value::append_span(inout compact, 0, blob, pool, off, nb, crate::ent_value::span_units(blob, pool, off, nb));
        crate::ent_packet::put_vs(inout tab, j, 6, at, nb);
      }
      j = j + 3;
    }
    strings = crate::ent_value::pool_finish(compact, 0);
  } else { strings = copy(crate::ent_value::blob_pool(blob)); }
  let mut st: [i64] = alloc(14, 0);
  st[0] = crate::ent_state::magic();
  st[1] = 9;
  st[2] = 8;
  st[3] = nt;
  st[4] = base + pl - crate::ent_packet::sec_len(blob, 0);
  st[12] = pl;
  st[13] = raw;
  let empty: [i64] = crate::ent_u16::empty();
  return crate::ent_packet::mk_packet(1, id, 1, 9, strings, crate::ent_bound::index_request(nt), st, empty, tab, 1);
}

// The caller keeps the actual emitted packet and the input given to index_begin. Read the input in place,
// or its repack when begin repacked it. The caller supplies prev separately so even changes outside the state are rejected.
pub fn index_step(inout progress: [i64], input: [i64], prev: [i64], emitted: [i64], completion: [i64]) -> [i64] ! alloc
{
  let nt: i64 = crate::ent_u16::rd(progress, 0);
  let n: i64 = len(emitted);
  if nt <= 0 || nt > 559240 || nt >= len(progress) ||
     !crate::ent_wire::same_packet(prev, emitted) { return bad_pkt(emitted, 1); }
  if n < 30 || crate::ent_value::pkt_size(emitted) > 16777216 || emitted[6] != 5 { return bad_pkt(emitted, 1); }
  let st: i64 = crate::ent_packet::sec_start(emitted, 2);
  let ls: i64 = crate::ent_packet::sec_len(emitted, 2);
  if ls != 14 || st > 16777216 || st + ls > n { return bad_pkt(emitted, 1); }
  let raw: i64 = crate::ent_value::pkt_size(input);
  if raw > 16777216 || emitted[st + 13] != raw { return bad_pkt(emitted, 1); }
  if emitted[8] != 4 || crate::ent_u16::rd(emitted, st - 1) != nt || emitted[11] != 3 * nt {
    return bad_pkt(emitted, 1);
  }
  let hi: i64 = emitted[st + 12];
  if hi != crate::ent_value::logical_pool_words(input) {
    let cut: i64 = crate::ent_packet::input_check(input);
    if cut < 0 { return bad_pkt(emitted, 1); }
    let blob: [i64] = crate::ent_state::repack(input, cut);
    if hi != crate::ent_value::logical_pool_words(blob) { return bad_pkt(emitted, 1); }
    return index_step_on(inout progress, blob, emitted, st, nt, completion);
  }
  return index_step_on(inout progress, input, emitted, st, nt, completion);
}

fn index_step_on(inout progress: [i64], blob: [i64], emitted: [i64], st: i64, nt: i64, completion: [i64]) -> [i64] ! alloc
  requires 0 < nt && nt <= 559240 && 0 <= st && st <= 16777216
{
  let lb: i64 = crate::ent_value::pkt_size(blob);
  if lb > 16777216 { return bad_pkt(emitted, 1); }
  let base: i64 = crate::ent_u16::rd(emitted, st + 4);
  if !crate::ent_bound::index_progress_ok(blob, 0, lb, base, progress, nt) {
    return bad_pkt(emitted, 1);
  }
  let ec: i64 = crate::ent_packet::env_check_wire(completion);
  if ec != 0 { return bad_pkt(emitted, ec); }
  let id: i64 = crate::ent_u16::rd(emitted, 2);
  if crate::ent_u16::rd(completion, 1) != 2 || crate::ent_u16::rd(completion, 2) != id ||
     crate::ent_u16::rd(completion, 3) != 1 || crate::ent_u16::rd(completion, 5) != 9 { return bad_pkt(emitted, 1); }
  let hi0: i64 = crate::ent_packet::comp_check(completion, 8, nt);
  if hi0 < 0 { return bad_pkt(emitted, 1); }
  let hi: i64 = crate::ent_value::prefix_pool_units(completion, crate::ent_packet::sec_start(completion, 0), hi0);
  let l: i64 = crate::ent_u16::clamp(crate::ent_value::pkt_size(completion), 16777216);
  if l - crate::ent_value::logical_pool_words(completion) + hi + 3 > 16777216 { return bad_pkt(emitted, 2); }
  let done: [i64] = crate::ent_bound::index_complete(blob, 0, id, 1, completion, progress);
  crate::ent_u16::wr(inout progress, 0, 0);
  return done;
}
