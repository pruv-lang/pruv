// L3-8 entry: ops 7 session_threads, 8 excluded_from_bound, 9 bound_session_index.
// Session record (30 words, slots of 3 at position p): id p, temporary p+3, engine p+6, externalThread p+9 (tag 11 object:
// engine p+12, thread p+15, forks p+18), terminal p+21 (tag 11: cliSession p+24), engineThreads p+27 (rows of 9: key, bound, threadId).

// one pair descriptor: engine slot position e (-1 = the literal "codex"), engine length cut l (-1 = whole slot), thread slot t
fn add_pair(inout ep: [i64], inout el: [i64], inout tp: [i64], k: i64, fill: i64, e: i64, l: i64, t: i64) -> ()
  ensures len(ep) == len(old(ep)) && len(el) == len(old(el)) && len(tp) == len(old(tp))
{
  if fill != 0 {
    crate::ent_u16::wr(inout ep, k, e);
    crate::ent_u16::wr(inout el, k, l);
    crate::ent_u16::wr(inout tp, k, t);
  }
}

// The ASCII colon is itself a valid byte boundary for the sub-slot.
fn colon_at(w: [i64], p: i64, pool: i64) -> i64
{
  return crate::ent_value::pstr_find_byte(w, p, pool, 58);
}

// starts = packet::section_starts(w, head): section starts in O(1) (sessions are many, sections are many).
// the (engine, thread) pairs of the session at p, in order, starting at index k0; with fill != 0 they are recorded.
// returns the index after the last pair
fn ses_pairs(w: [i64], starts: [i64], p0: i64, inout ep: [i64], inout el: [i64], inout tp: [i64], k0: i64, fill: i64) -> i64
  ensures 0 <= result && result <= 100000000 && len(ep) == len(old(ep)) && len(el) == len(old(el)) && len(tp) == len(old(tp))
{
  let p: i64 = crate::ent_u16::clamp(p0, 100000000);
  let mut k: i64 = crate::ent_u16::clamp(k0, 16777216);
  let kk: i64 = k;
  if crate::ent_value::tag_at(w, p + 9) == 11 {
    add_pair(inout ep, inout el, inout tp, k, fill, p + 12, 0 - 1, p + 15);
    k = k + 1;
    if crate::ent_value::tag_at(w, p + 18) == 7 {
      let sec: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(w, p + 19), 1000000);
      let cnt: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(w, p + 20), 16777216);
      let base: i64 = crate::ent_packet::start_in(starts, sec);
      let k1: i64 = k;
      let mut i: i64 = 0;
      while i < cnt
        invariant 0 <= i && i <= cnt && cnt <= 16777216 && 0 <= base && base <= 33554432 && k == k1 + i && k1 <= 16777217 && 0 <= p && p <= 100000000 && len(ep) == len(old(ep)) && len(el) == len(old(el)) && len(tp) == len(old(tp))
        decreases cnt - i
      {
        add_pair(inout ep, inout el, inout tp, k, fill, p + 12, 0 - 1, base + 3 * i);
        k = k + 1;
        i = i + 1;
      }
    }
  }
  if crate::ent_value::tag_at(w, p + 21) == 11 && crate::ent_value::truthy(w, p + 24) {
    // MUTANT M13: the engine fallback uses || (falsy engines also give codex) instead of ?? (undefined/null/absent only)
    if crate::ent_value::nullish(w, p + 6) {
      add_pair(inout ep, inout el, inout tp, k, fill, 0 - 1, 0 - 1, p + 24);
    } else {
      add_pair(inout ep, inout el, inout tp, k, fill, p + 6, 0 - 1, p + 24);
    }
    k = k + 1;
  }
  if crate::ent_value::tag_at(w, p + 27) == 8 {
    let sec: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(w, p + 28), 1000000);
    let cnt: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(w, p + 29), 16777216);
    let base: i64 = crate::ent_packet::start_in(starts, sec);
    let ps: i64 = crate::ent_packet::start_in(starts, 0);
    let k2: i64 = k;
    let mut i: i64 = 0;
    while i < cnt
      invariant 0 <= i && i <= cnt && cnt <= 16777216 && 0 <= base && base <= 33554432 && k2 <= k && k <= k2 + i && k2 <= 33554436 && 0 <= p && p <= 100000000 && len(ep) == len(old(ep)) && len(el) == len(old(el)) && len(tp) == len(old(tp))
      decreases cnt - i
    {
      let q: i64 = base + 9 * i;
      if crate::ent_value::tag_at(w, q + 3) == 11 && crate::ent_value::truthy(w, q + 6) {
        if fill != 0 { add_pair(inout ep, inout el, inout tp, k, fill, q, colon_at(w, q, ps), q + 6); }
        k = k + 1;
      }
      i = i + 1;
    }
  }
  return k;
}

// ---- helpers ----
fn throw_existing_at(cx: crate::ent_state::Ctx, p0: i64) -> crate::ent_state::Ctx ! alloc
{
  return throw_at(cx, cx.ent, p0);
}

fn throw_at(cx: crate::ent_state::Ctx, answer: [i64], p0: i64) -> crate::ent_state::Ctx ! alloc
{
  let p: i64 = crate::ent_u16::clamp(p0, 4294967296);
  let mut rec: [i64] = crate::ent_u16::zeros(4);
  crate::ent_u16::wr(inout rec, 0, 1);
  let a: i64 = crate::ent_u16::put_range(inout rec, 1, answer, p, 3);
  let e: [i64] = crate::ent_u16::empty();
  return crate::ent_state::set_done(cx, e, rec, e, 0);
}

// copy the id slot at p of w into a request table row at `at` (an absent id is sent as undefined)
fn put_id(inout tab: [i64], at: i64, w: [i64], p: i64) -> ()
  ensures len(tab) == len(old(tab))
{
  let a: i64 = crate::ent_u16::put_range(inout tab, crate::ent_u16::clamp(at, 4294967296), w, crate::ent_u16::clamp(p, 4294967296), 3);
  if crate::ent_u16::rd(w, p) == 10 { crate::ent_u16::wr(inout tab, at, 0); }
}

// the temporary slot is exactly true
fn temp_true(w: [i64], p: i64) -> bool
{
  // MUTANT M15: the check is truthiness instead of === true
  return crate::ent_value::tag_at(w, crate::ent_u16::clamp(p, 4294967296) + 3) == 3;
}

// ---- op 7 ----
pub fn threads_item(cx: crate::ent_state::Ctx) -> crate::ent_state::Ctx ! alloc
{
  let starts: [i64] = crate::ent_packet::section_starts(cx.blob, 0);
  let r0: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(cx.blob, 1), 33554432);
  let mut ep: [i64] = crate::ent_u16::empty();
  let mut el: [i64] = crate::ent_u16::empty();
  let mut tp: [i64] = crate::ent_u16::empty();
  let n: i64 = ses_pairs(cx.blob, starts, r0, inout ep, inout el, inout tp, 0, 0);
  if n > 2796202 { return crate::ent_state::too_big(cx); }
  let mut ep2: [i64] = alloc(n, 0);
  let mut el2: [i64] = alloc(n, 0);
  let mut tp2: [i64] = alloc(n, 0);
  let n2: i64 = ses_pairs(cx.blob, starts, r0, inout ep2, inout el2, inout tp2, 0, 1);
  let mut pool: [i64] = crate::ent_dispatch::blob_pool(cx.blob);
  let codex: [i64] = crate::ent_u16::lit("codex");
  let codex_off: i64 = crate::ent_value::pool_add(inout pool, codex);
  let codex_len: i64 = crate::ent_value::slot_len_of(codex);
  let mut tab: [i64] = alloc(6 * n, 0);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n <= 2796202 && len(tab) == 6 * n && len(ep2) == n && len(el2) == n && len(tp2) == n
    decreases n - i
  {
    let e: i64 = crate::ent_u16::rd(ep2, i);
    let l: i64 = crate::ent_u16::rd(el2, i);
    let t: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(tp2, i), 4294967296);
    if e < 0 {
      crate::ent_packet::put_vs(inout tab, 6 * i, 6, codex_off, codex_len);
    } else if l >= 0 {
      crate::ent_value::pstr_put_prefix(inout tab, 6 * i, cx.blob, crate::ent_u16::clamp(e, 4294967296), l);
    } else {
      let a: i64 = crate::ent_u16::put_range(inout tab, 6 * i, cx.blob, crate::ent_u16::clamp(e, 4294967296), 3);
    }
    let b: i64 = crate::ent_u16::put_range(inout tab, 6 * i + 3, cx.blob, t, 3);
    i = i + 1;
  }
  let mut rec: [i64] = crate::ent_u16::zeros(4);
  crate::ent_packet::put_vs(inout rec, 1, 7, 4, n);
  let e: [i64] = crate::ent_u16::empty();
  return crate::ent_state::set_done(cx, pool, rec, tab, 1);
}

// ---- op 8 ----
pub fn excluded_item(cx0: crate::ent_state::Ctx) -> crate::ent_state::Ctx ! alloc
{
  let r0: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(cx0.blob, 1), 33554432);
  let e: [i64] = crate::ent_u16::empty();
  if temp_true(cx0.blob, r0) {
    let mut rec: [i64] = crate::ent_u16::zeros(4);
    crate::ent_packet::put_vs(inout rec, 1, 3, 0, 0);
    return crate::ent_state::set_done(cx0, e, rec, e, 0);
  }
  let mut tab: [i64] = alloc(3, 0);
  put_id(inout tab, 0, cx0.blob, r0);
  let mut rq: [i64] = crate::ent_u16::zeros(4);
  crate::ent_u16::wr(inout rq, 0, 8);
  crate::ent_packet::put_vs(inout rq, 1, 7, 4, 1);
  let cx: crate::ent_state::Ctx = crate::ent_state::obs(cx0, 8, 1, crate::ent_dispatch::blob_pool(cx0.blob), rq, tab, 1);
  if cx.stalled != 0 || cx.bad != 0 { return cx; }
  let rp: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(cx.ent, 1), 33554432);
  if crate::ent_u16::rd(cx.ent, rp + 4) == 1 { return throw_existing_at(cx, rp + 5); }
  let sec: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(cx.ent, rp + 2), 1000000);
  let base: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(cx.ent, sec), 33554432);
  let mut rec: [i64] = crate::ent_u16::zeros(4);
  let a: i64 = crate::ent_u16::put_range(inout rec, 1, cx.ent, base, 3);
  let pool: [i64] = crate::ent_dispatch::blob_pool(cx.ent);
  return crate::ent_state::set_done(cx, pool, rec, e, 0);
}

// ---- op 9 ----
// units of the engine part of the key
fn eng_len(w: [i64], pool: i64, e: i64, l: i64) -> i64
  ensures -1 <= result && result <= 16777216
{
  if e < 0 { return 5; }
  if l >= 0 {
    let p: i64 = crate::ent_u16::clamp(e, 4294967296);
    let off: i64 = crate::ent_value::pstr_off(w, p);
    return crate::ent_u16::clamp(crate::ent_value::span_units(w, pool, off, l), 16777216);
  }
  return crate::ent_value::key_len(w, e);
}

fn eng_put(w: [i64], pool: i64, e: i64, l: i64, inout o: [i64], at: i64) -> i64 ! alloc
  ensures len(o) == len(old(o))
{
  if e < 0 {
    let r: i64 = crate::ent_value::put_lit(inout o, at, "codex");
    return r;
  }
  if l >= 0 {
    let r: i64 = crate::ent_value::pool_copy_into(w, pool, e, l, inout o, crate::ent_u16::clamp(at, 4294967296));
    return r;
  }
  let r: i64 = crate::ent_value::key_put_at(w, e, pool, inout o, at);
  return r;
}

// One slot for each possible session plus the predicate count at position 0.
pub fn index_collect(w: [i64], base: i64, ns: i64, inout progress: [i64]) -> [i64] ! alloc
  requires 0 <= base && base <= 33554432 && 0 <= ns && ns <= 559240 && ns < len(progress)
  ensures len(result) >= 0
{
  // Collect predicate IDs in session order, then use only the populated prefix.
  let delta: i64 = crate::ent_value::logical_pool_words(w) - crate::ent_packet::sec_len(w, 0);
  let mut ids: [i64] = alloc(3 * ns, 0);
  let mut nt: i64 = 0;
  let mut i: i64 = 0;
  while i < ns
    invariant 0 <= i && i <= ns && ns <= 559240 && 0 <= nt && nt <= i && 0 <= base && base <= 33554432 && len(ids) == 3 * ns && ns < len(progress)
    decreases ns - i
  {
    let p: i64 = base + 30 * i;
    if !temp_true(w, p) {
      put_id(inout ids, 3 * nt, w, p);
      progress[nt + 1] = p + delta;
      nt = nt + 1;
    }
    i = i + 1;
  }
  progress[0] = nt;
  return truncate(ids, 3 * nt);
}

pub fn index_progress_ok(w: [i64], head: i64, lb: i64, base: i64, progress: [i64], nt: i64) -> bool
  requires 0 <= head && head <= 16777216 && 0 <= lb && lb <= 16777216 && 0 < nt && nt <= 559240
{
  let nsec: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(w, head + 6), 1000000);
  let pool: i64 = 7 + nsec;
  let words: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(w, head + 7), 16777216);
  let units: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(w, head + pool), 16777216);
  let delta: i64 = units - words;
  let rec: i64 = pool + units;
  if rec + 3 > lb || base < rec + 3 || base > lb { return false; }
  let ns: i64 = crate::ent_u16::rd(w, head + pool + words + 2);
  if ns < nt || ns > (lb - base) / 30 { return false; }
  let end: i64 = base + 30 * ns;
  let mut last: i64 = base - 1;
  let mut a: i64 = 0;
  while a < nt
    invariant 0 <= a && a <= nt && nt <= 559240 && 0 <= head && head <= 16777216 && 0 <= base && base <= end && end <= 16777216
    decreases nt - a
  {
    let p: i64 = crate::ent_u16::rd(progress, a + 1);
    if p <= last || p < base || p >= end || (p - base) % 30 != 0 { return false; }
    if temp_true(w, head + p - delta) { return false; }
    last = p;
    a = a + 1;
  }
  return true;
}

pub fn index_request(nt: i64) -> [i64] ! alloc
{
  let mut rq: [i64] = crate::ent_u16::zeros(4);
  crate::ent_u16::wr(inout rq, 0, 8);
  crate::ent_packet::put_vs(inout rq, 1, 7, 4, nt);
  return rq;
}

pub fn index_complete(w: [i64], head: i64, id: i64, seq: i64, answer: [i64], progress: [i64]) -> [i64] ! alloc
  requires 0 <= head && head <= 16777216
{
  let nt: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(progress, 0), 559240);
  let mut rbase: i64 = 0;
  if nt > 0 {
    let rp: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(answer, 1), 33554432);
    if crate::ent_u16::rd(answer, rp + 4) == 1 {
      let e: [i64] = crate::ent_u16::empty();
      let cx: crate::ent_state::Ctx = crate::ent_state::ctx_new(9, id, e, e, e);
      return crate::ent_state::finish(throw_at(cx, answer, rp + 5), 0, seq);
    }
    let rsec: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(answer, rp + 2), 1000000);
    rbase = crate::ent_u16::clamp(crate::ent_packet::sec_start(answer, rsec), 33554432);
  }
  let starts: [i64] = crate::ent_packet::section_starts(w, head);
  let ps: i64 = crate::ent_packet::start_in(starts, 0);
  let pl: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(w, ps), 16777216);
  let nb: i64 = crate::ent_value::pool_bytes(w, ps);
  let delta: i64 = pl - crate::ent_u16::clamp(crate::ent_u16::rd(w, head + 7), 16777216);
  // pass 1: count the candidate pairs of the sessions that are not excluded
  let mut ep: [i64] = crate::ent_u16::empty();
  let mut el: [i64] = crate::ent_u16::empty();
  let mut tp: [i64] = crate::ent_u16::empty();
  let mut total: i64 = 0;
  let mut a: i64 = 0;
  while a < nt
    invariant 0 <= a && a <= nt && nt <= 559240 && 0 <= total && total <= 16777216 && 0 <= rbase && rbase <= 33554432
    decreases nt - a
  {
    if !crate::ent_value::truthy(answer, rbase + 3 * a) {
      let p: i64 = head + crate::ent_u16::clamp(crate::ent_u16::rd(progress, a + 1), 16777216) - delta;
      total = ses_pairs(w, starts, p, inout ep, inout el, inout tp, total, 0);
      if total > 16777216 { return crate::ent_packet::boundary(9, id, 1); }
    }
    a = a + 1;
  }
  if total > 2796202 { return crate::ent_packet::boundary(9, id, 1); }
  let n: i64 = total;
  let mut ep2: [i64] = alloc(n, 0);
  let mut el2: [i64] = alloc(n, 0);
  let mut tp2: [i64] = alloc(n, 0);
  let mut sp: [i64] = alloc(n, 0);
  let mut t2: i64 = 0;
  let mut b: i64 = 0;
  while b < nt
    invariant 0 <= b && b <= nt && nt <= 559240 && 0 <= t2 && t2 <= 100000000 && 0 <= rbase && rbase <= 33554432 && len(ep2) == n && len(el2) == n && len(tp2) == n && len(sp) == n
    decreases nt - b
  {
    if !crate::ent_value::truthy(answer, rbase + 3 * b) {
      let p: i64 = head + crate::ent_u16::clamp(crate::ent_u16::rd(progress, b + 1), 16777216) - delta;
      let from: i64 = t2;
      t2 = ses_pairs(w, starts, p, inout ep2, inout el2, inout tp2, t2, 1);
      let mut q: i64 = crate::ent_u16::clamp(from, n);
      while q < t2 && q < n
        invariant 0 <= q && q <= n && len(sp) == n
        decreases t2 - q
      {
        crate::ent_u16::wr(inout sp, q, p);
        q = q + 1;
      }
    }
    b = b + 1;
  }
  // key lengths and offsets (relative to the key pool)
  let mut ko: [i64] = alloc(n, 0);
  let mut kl: [i64] = alloc(n, 0);
  let mut sum: i64 = 0;
  let mut c: i64 = 0;
  while c < n
    invariant 0 <= c && c <= n && n <= 2796202 && 0 <= sum && sum <= 16000000 && len(ko) == n && len(kl) == n && len(ep2) == n && len(el2) == n && len(tp2) == n
    decreases n - c
  {
    let a1: i64 = eng_len(w, ps, crate::ent_u16::rd(ep2, c), crate::ent_u16::rd(el2, c));
    let a2: i64 = crate::ent_value::key_len(w, crate::ent_u16::rd(tp2, c));
    if a1 < 0 || a2 < 0 { return crate::ent_packet::boundary(9, id, 0); }
    let ln: i64 = a1 + 1 + a2;
    crate::ent_u16::wr(inout ko, c, sum);
    crate::ent_u16::wr(inout kl, c, ln);
    sum = sum + ln;
    if sum > 16000000 { return crate::ent_packet::boundary(9, id, 1); }
    c = c + 1;
  }
  let mut keys: [i64] = alloc(sum, 0);
  let mut d: i64 = 0;
  while d < n
    invariant 0 <= d && d <= n && n <= 2796202 && len(keys) == sum && len(ko) == n && len(kl) == n && len(ep2) == n && len(el2) == n && len(tp2) == n && 0 <= sum && sum <= 16000000
    decreases n - d
  {
    let at: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(ko, d), 16000000);
    let x0: i64 = eng_put(w, ps, crate::ent_u16::rd(ep2, d), crate::ent_u16::rd(el2, d), inout keys, at);
    let x: i64 = crate::ent_u16::clamp(x0, 4294967296);
    crate::ent_u16::wr(inout keys, x, 58);
    let y: i64 = crate::ent_value::key_put_at(w, crate::ent_u16::rd(tp2, d), ps, inout keys, x + 1);
    d = d + 1;
  }
  // first write wins: keep[i] = the entry index holding key i's value; the first occurrence is the entry.
  // Keys are looked up through an open-addressing hash index (slot = position g in keep, -1 empty), built as the entries are
  // visited in order, so each key costs O(its length) expected instead of a scan over all kept keys. A hash hit is confirmed
  // by comparing length and units, so the result equals the first-occurrence scan exactly.
  let mut keep: [i64] = alloc(n, 0 - 1);
  let mut val: [i64] = alloc(n, 0);
  let tsz: i64 = 2 * n + 1;
  let mut tbl: [i64] = alloc(tsz, 0 - 1);
  let mut m: i64 = 0;
  let mut f: i64 = 0;
  while f < n
    invariant 0 <= f && f <= n && n <= 2796202 && 0 <= m && m <= f && len(keep) == n && len(val) == n && len(ko) == n && len(kl) == n && len(sp) == n && len(keys) == sum && 0 <= sum && tsz == 2 * n + 1 && len(tbl) == tsz
    decreases n - f
  {
    let fo: i64 = crate::ent_u16::rd(ko, f);
    let fl: i64 = crate::ent_u16::rd(kl, f);
    let hh: i64 = crate::ent_value::pool_hash(keys, fo, fl);
    let mut s: i64 = hh % tsz;
    let mut hit: i64 = 0 - 1;
    let mut done: bool = false;
    let mut stp: i64 = 0;
    while !done && stp < tsz
      invariant 0 <= s && s < tsz && 0 <= stp && stp <= tsz && len(tbl) == tsz && len(keep) == n && len(kl) == n && len(ko) == n && -1 <= hit && 0 <= m && m <= f && f <= n
      decreases tsz - stp
    {
      let g: i64 = crate::ent_u16::rd(tbl, s);
      if g < 0 {
        done = true;
      } else {
        let e2: i64 = crate::ent_u16::rd(keep, g);
        if crate::ent_u16::rd(kl, e2) == fl && crate::ent_value::pool_eq(keys, crate::ent_u16::rd(ko, e2), fo, fl) {
          hit = g;
          done = true;
        } else {
          s = s + 1;
          if s >= tsz { s = 0; }
        }
      }
      stp = stp + 1;
    }
    // the table is never full (m < tsz), so a probe always ends on a hit or an empty slot
    if !done { return crate::ent_packet::boundary(9, id, 0); }
    if hit < 0 {
      crate::ent_u16::wr(inout tbl, s, m);
      crate::ent_u16::wr(inout keep, m, f);
      crate::ent_u16::wr(inout val, m, crate::ent_u16::rd(sp, f));
      m = m + 1;
    } else {
      // MUTANT M16: a later write overwrites the stored session (last write wins)
    }
    f = f + 1;
  }
  // Keep the old expanded-word limit and compact/full choice for the value pool.
  if 16 + pl + sum + 6 * m > 16777216 { return crate::ent_packet::boundary(9, id, 1); }
  let mut vsum: i64 = 0;
  let mut bytes: i64 = 0;
  let mut full: bool = false;
  let mut h0: i64 = 0;
  while h0 < m && !full
    invariant 0 <= h0 && h0 <= m && m <= n && n <= 2796202 && 0 <= vsum && vsum <= pl && len(val) == n && 0 <= pl && pl <= 16777216 && 0 <= bytes && bytes <= 4 * vsum
    decreases m - h0
  {
    let vp: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(val, h0), 4294967296);
    if crate::ent_u16::rd(w, vp) == 6 {
      let va: i64 = crate::ent_value::pstr_off(w, vp);
      let vb: i64 = crate::ent_value::pstr_raw_len(w, vp);
      if !crate::ent_value::span_ok(w, ps, va, vb) { return crate::ent_packet::boundary(9, id, 0); }
      let vu: i64 = crate::ent_value::span_units(w, ps, va, vb);
      if vu > pl - vsum { full = true; }
      else {
        bytes = bytes + 4 * vu;
        vsum = vsum + vu;
      }
    }
    h0 = h0 + 1;
  }

  let mut values: [i64] = crate::ent_u16::empty();
  if full { values = crate::ent_value::pool_head(w, ps, nb, pl); }
  else { values = alloc(crate::ent_value::pool_capacity(crate::ent_u16::clamp(bytes, 67108864)), 0); }
  let mut key_pool: [i64] = alloc(crate::ent_value::pool_capacity(3 * sum + m), 0);
  let mut tab: [i64] = alloc(6 * m, 0);
  let mut h: i64 = 0;
  while h < m
    invariant 0 <= h && h <= m && m <= n && n <= 2796202 && len(keep) == n && len(val) == n && len(ko) == n && len(kl) == n && len(tab) == 6 * m
    decreases m - h
  {
    let e3: i64 = crate::ent_u16::rd(keep, h);
    let start: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(ko, e3), 16000000);
    let nk: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(kl, e3), 16000000);
    if start + nk > len(keys) { return crate::ent_packet::boundary(9, id, 0); }
    // DB22 (D-DB18-3 P3): encode the key straight into key_pool; no temp pool per key.
    let at: i64 = crate::ent_value::append_units(inout key_pool, 0, subview(keys, start, start + nk));
    crate::ent_packet::put_vs(inout tab, 6 * h, 6, at, crate::ent_value::pool_bytes(key_pool, 0) - at);

    let vp: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(val, h), 4294967296);
    if !full && crate::ent_u16::rd(w, vp) == 6 {
      crate::ent_value::append_slot(inout values, 0, w, ps, w, vp, inout tab, 6 * h + 3);
    } else {
      let z: i64 = crate::ent_u16::put_range(inout tab, 6 * h + 3, w, vp, 3);
    }
    h = h + 1;
  }
  let base: i64 = crate::ent_value::pool_base(values, key_pool);
  let mut j: i64 = 0;
  while j < m
    invariant 0 <= j && j <= m && m <= 2796202 && len(tab) == 6 * m && 0 <= base && base <= 1073741824
    decreases m - j
  {
    let off: i64 = crate::ent_u16::clamp(crate::ent_value::pstr_off(tab, 6 * j), 1073741823);
    crate::ent_value::pstr_set_off(inout tab, 6 * j, off + base);
    j = j + 1;
  }
  let mut rec: [i64] = alloc(4, 0);
  crate::ent_packet::put_vs(inout rec, 1, 7, 4, m);
  let empty: [i64] = crate::ent_u16::empty();
  return crate::ent_packet::mk_packet(3, id, seq, 9, crate::ent_value::pool_cat(values, key_pool), rec, empty, empty, tab, 1);
}
