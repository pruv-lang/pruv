// L3-8 entry: ops 7 session_threads, 8 excluded_from_bound, 9 bound_session_index.
// Ops 7 and 8 are replay steps over the shared context: `inout cx: Ctx`, and an observation that stalls or breaks the
// replay returns through `?` (hand shape: bench/l3/lib/hand/ent_bound.rs). threads_item and excluded_item are by-value
// adapters for entry_api::run_item (RESHAPE.md row AD). Op 9 is driven by entry_api (index_collect, index_request,
// index_progress_ok, index_complete).
// Session record (30 words, slots of 3 at position p): id p, temporary p+3, engine p+6, externalThread p+9 (tag 11 object:
// engine p+12, thread p+15, forks p+18), terminal p+21 (tag 11: cliSession p+24), engineThreads p+27 (rows of 9: key, bound, threadId).
// A pair is three parallel arrays ep/el/tp (hand: Vec<Pair>): an array of structs is not supported (RESHAPE.md row SA).

// one pair: engine slot position e (-1 = the literal "codex"), engine byte cut l (-1 = whole slot), thread slot t
fn add_pair(inout ep: [i64], inout el: [i64], inout tp: [i64], e: i64, l: i64, t: i64) -> () ! alloc
  requires len(ep) <= 100000000 && len(el) == len(ep) && len(tp) == len(ep)
  ensures len(ep) == len(old(ep)) + 1 && len(el) == len(ep) && len(tp) == len(ep)
{
  arr_push(inout ep, e);
  arr_push(inout el, l);
  arr_push(inout tp, t);
}

// The ASCII colon is itself a valid byte boundary for the sub-slot.
fn colon_at(w: [i64], p: i64, pool: i64) -> i64
{
  if crate::ent_value::tag_at(w, p) != 6 { return 0; }
  return crate::ent_value::pstr_find_byte(w, p, pool, 58);
}

// starts = packet::section_starts(w, head): section starts in O(1) (sessions are many, sections are many).
// The (engine, thread) pairs of the session at p, in order, appended to ep/el/tp.
fn ses_pairs(w: [i64], starts: [i64], p0: i64, inout ep: [i64], inout el: [i64], inout tp: [i64]) -> () ! alloc
  requires len(ep) <= 16777216 && len(el) == len(ep) && len(tp) == len(ep)
  ensures len(old(ep)) <= len(ep) && len(ep) <= len(old(ep)) + 33554434 && len(el) == len(ep) && len(tp) == len(ep)
{
  let p: i64 = crate::ent_u16::clamp(p0, 100000000);
  let n0: i64 = len(ep);
  if crate::ent_value::tag_at(w, p + 9) == 11 {
    add_pair(inout ep, inout el, inout tp, p + 12, 0 - 1, p + 15);
    if crate::ent_value::tag_at(w, p + 18) == 7 {
      let sec: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(w, p + 19), 1000000);
      let cnt: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(w, p + 20), 16777216);
      let base: i64 = crate::ent_packet::start_in(starts, sec);
      let mut i: i64 = 0;
      while i < cnt
        invariant 0 <= i && i <= cnt && cnt <= 16777216 && 0 <= base && base <= 33554432 && len(ep) == n0 + 1 + i && n0 <= 16777216 && len(el) == len(ep) && len(tp) == len(ep) && 0 <= p && p <= 100000000
        decreases cnt - i
      {
        add_pair(inout ep, inout el, inout tp, p + 12, 0 - 1, base + 3 * i);
        i = i + 1;
      }
    }
  }
  if crate::ent_value::tag_at(w, p + 21) == 11 && crate::ent_value::truthy(w, p + 24) {
    // MUTANT M13: the engine fallback uses || (falsy engines also give codex) instead of ?? (undefined/null/absent only)
    if crate::ent_value::nullish(w, p + 6) {
      add_pair(inout ep, inout el, inout tp, 0 - 1, 0 - 1, p + 24);
    } else {
      add_pair(inout ep, inout el, inout tp, p + 6, 0 - 1, p + 24);
    }
  }
  if crate::ent_value::tag_at(w, p + 27) == 8 {
    let sec: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(w, p + 28), 1000000);
    let cnt: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(w, p + 29), 16777216);
    let base: i64 = crate::ent_packet::start_in(starts, sec);
    let ps: i64 = crate::ent_packet::start_in(starts, 0);
    let n1: i64 = len(ep);
    let mut i: i64 = 0;
    while i < cnt
      invariant 0 <= i && i <= cnt && cnt <= 16777216 && 0 <= base && base <= 33554432 && n1 <= len(ep) && len(ep) <= n1 + i && n1 <= n0 + 16777218 && n0 <= 16777216 && len(el) == len(ep) && len(tp) == len(ep)
      decreases cnt - i
    {
      let q: i64 = base + 9 * i;
      if crate::ent_value::tag_at(w, q + 3) == 11 && crate::ent_value::truthy(w, q + 6) {
        add_pair(inout ep, inout el, inout tp, q, colon_at(w, q, ps), q + 6);
      }
      i = i + 1;
    }
  }
}

// ---- helpers ----
// the done record of a thrown answer: [1, E] with E the thrown value slot at p
fn throw_rec(answer: [i64], p0: i64) -> [i64] ! alloc
{
  let p: i64 = crate::ent_u16::clamp(p0, 4294967296);
  let mut rec: [i64] = crate::ent_u16::zeros(4);
  crate::ent_u16::wr(inout rec, 0, 1);
  let a: i64 = crate::ent_u16::put_range(inout rec, 1, answer, p, 3);
  return rec;
}

// the id slot at p of w as a request table row (an absent id is sent as undefined)
fn put_id(inout tab: [i64], w: [i64], p: i64) -> () ! alloc
  requires len(tab) <= 16777216
  ensures len(tab) == len(old(tab)) + 3
{
  let q: i64 = crate::ent_u16::clamp(p, 4294967296);
  let mut t: i64 = crate::ent_u16::rd(w, q);
  if t == 10 { t = 0; }
  arr_push(inout tab, t, crate::ent_u16::rd(w, q + 1), crate::ent_u16::rd(w, q + 2));
}

// the temporary slot is exactly true
fn temp_true(w: [i64], p: i64) -> bool
{
  // MUTANT M15: the check is truthiness instead of === true
  return crate::ent_value::tag_at(w, crate::ent_u16::clamp(p, 4294967296) + 3) == 3;
}

// ---- op 7 ----
pub fn session_threads(inout cx: crate::ent_state::Ctx) -> Result<(), crate::ent_state::Halt> ! alloc
{
  let starts: [i64] = crate::ent_packet::section_starts(cx.blob, 0);
  let r0: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(cx.blob, 1), 33554432);
  let mut ep: [i64] = alloc(0, 0);
  let mut el: [i64] = alloc(0, 0);
  let mut tp: [i64] = alloc(0, 0);
  ses_pairs(cx.blob, starts, r0, inout ep, inout el, inout tp);
  let n: i64 = len(ep);
  if n > 2796202 { return crate::ent_state::stop_too_big(inout cx); }
  let mut pool: [i64] = copy(crate::ent_value::blob_pool(cx.blob));
  let codex: [i64] = crate::ent_u16::lit("codex");
  let codex_off: i64 = crate::ent_value::pool_add(inout pool, codex);
  let codex_len: i64 = crate::ent_value::slot_len_of(codex);
  let mut tab: [i64] = alloc(0, 0);
  arr_reserve(inout tab, 6 * n);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n <= 2796202 && len(tab) == 6 * i && len(ep) == n && len(el) == n && len(tp) == n
    decreases n - i
  {
    let e0: i64 = ep[i];
    let e: i64 = crate::ent_u16::clamp(e0, 4294967296);
    let l: i64 = el[i];
    let t: i64 = crate::ent_u16::clamp(tp[i], 4294967296);
    if e0 < 0 {
      arr_push(inout tab, 6, codex_off, codex_len);
    } else if l >= 0 {
      arr_push(inout tab, 6, crate::ent_value::pstr_off(cx.blob, e), l);
    } else {
      arr_push(inout tab, crate::ent_u16::rd(cx.blob, e), crate::ent_u16::rd(cx.blob, e + 1), crate::ent_u16::rd(cx.blob, e + 2));
    }
    arr_push(inout tab, crate::ent_u16::rd(cx.blob, t), crate::ent_u16::rd(cx.blob, t + 1), crate::ent_u16::rd(cx.blob, t + 2));
    i = i + 1;
  }
  let mut rec: [i64] = crate::ent_u16::zeros(4);
  crate::ent_packet::put_vs(inout rec, 1, 7, 4, n);
  crate::ent_state::put_done(inout cx, pool, rec, tab, 1);
  return Ok::<(), crate::ent_state::Halt>(());
}

// AD (3.7): by-value adapter for entry_api::run_item
pub fn threads_item(cx0: crate::ent_state::Ctx) -> crate::ent_state::Ctx ! alloc
{
  let mut cx: crate::ent_state::Ctx = cx0;
  let r: Result<(), crate::ent_state::Halt> = session_threads(inout cx);
  return cx;
}

// ---- op 8 ----
pub fn excluded_from_bound(inout cx: crate::ent_state::Ctx) -> Result<(), crate::ent_state::Halt> ! alloc
{
  let r0: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(cx.blob, 1), 33554432);
  let e: ref [i64] = [];
  if temp_true(cx.blob, r0) {
    let mut rec: [i64] = crate::ent_u16::zeros(4);
    crate::ent_packet::put_vs(inout rec, 1, 3, 0, 0);
    crate::ent_state::put_done(inout cx, e, rec, e, 0);
    return Ok::<(), crate::ent_state::Halt>(());
  }
  let mut tab: [i64] = alloc(0, 0);
  put_id(inout tab, cx.blob, r0);
  let rq: [i64] = index_request(1);
  let pool: [i64] = copy(crate::ent_value::blob_pool(cx.blob));
  crate::ent_state::observe(inout cx, 8, 1, pool, rq, tab, 1)?;
  let rp: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(cx.ent, 1), 33554432);
  if crate::ent_u16::rd(cx.ent, rp + 4) == 1 {
    let rec: [i64] = throw_rec(cx.ent, rp + 5);
    crate::ent_state::put_done(inout cx, e, rec, e, 0);
    return Ok::<(), crate::ent_state::Halt>(());
  }
  let sec: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(cx.ent, rp + 2), 1000000);
  let base: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(cx.ent, sec), 33554432);
  let mut rec: [i64] = crate::ent_u16::zeros(4);
  let a: i64 = crate::ent_u16::put_range(inout rec, 1, cx.ent, base, 3);
  let out: [i64] = copy(crate::ent_value::blob_pool(cx.ent));
  crate::ent_state::put_done(inout cx, out, rec, e, 0);
  return Ok::<(), crate::ent_state::Halt>(());
}

// AD (3.7): by-value adapter for entry_api::run_item
pub fn excluded_item(cx0: crate::ent_state::Ctx) -> crate::ent_state::Ctx ! alloc
{
  let mut cx: crate::ent_state::Ctx = cx0;
  let r: Result<(), crate::ent_state::Halt> = excluded_from_bound(inout cx);
  return cx;
}

// ---- op 9 ----
// units of the engine part of the key
fn eng_len(w: [i64], pool: i64, e: i64, l: i64) -> i64
  ensures -1 <= result && result <= 16777216
{
  if e < 0 { return 5; }
  if l >= 0 {
    let p: i64 = crate::ent_u16::clamp(e, 4294967296);
    let off: i64 = crate::ent_value::pstr_off(w, p);
    return crate::ent_u16::clamp(crate::ent_value::span_units(w, pool, off, l), 16777216);
  }
  return crate::ent_value::key_len(w, e);
}

fn eng_put(w: [i64], pool: i64, e: i64, l: i64, inout o: [i64], at: i64) -> i64 ! alloc
  ensures len(o) == len(old(o))
{
  if e < 0 {
    let r: i64 = crate::ent_value::put_lit(inout o, at, "codex");
    return r;
  }
  if l >= 0 {
    let r: i64 = crate::ent_value::pool_copy_into(w, pool, e, l, inout o, crate::ent_u16::clamp(at, 4294967296));
    return r;
  }
  let r: i64 = crate::ent_value::key_put_at(w, e, pool, inout o, at);
  return r;
}

// One slot for each possible session plus the predicate count at position 0.
pub fn index_collect(w: [i64], base: i64, ns: i64, inout progress: [i64]) -> [i64] ! alloc
  requires 0 <= base && base <= 33554432 && 0 <= ns && ns <= 559240 && ns < len(progress)
  ensures len(result) >= 0
{
  // Collect predicate IDs in session order.
  let delta: i64 = crate::ent_value::logical_pool_words(w) - crate::ent_packet::sec_len(w, 0);
  let mut ids: [i64] = alloc(0, 0);
  arr_reserve(inout ids, 3 * ns);
  let mut nt: i64 = 0;
  let mut i: i64 = 0;
  while i < ns
    invariant 0 <= i && i <= ns && ns <= 559240 && 0 <= nt && nt <= i && 0 <= base && base <= 33554432 && len(ids) == 3 * nt && ns < len(progress)
    decreases ns - i
  {
    let p: i64 = base + 30 * i;
    if !temp_true(w, p) {
      put_id(inout ids, w, p);
      progress[nt + 1] = p + delta;
      nt = nt + 1;
    }
    i = i + 1;
  }
  progress[0] = nt;
  return ids;
}

pub fn index_progress_ok(w: [i64], head: i64, lb: i64, base: i64, progress: [i64], nt: i64) -> bool
  requires 0 <= head && head <= 16777216 && 0 <= lb && lb <= 16777216 && 0 < nt && nt <= 559240
{
  let nsec: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(w, head + 6), 1000000);
  let pool: i64 = 7 + nsec;
  let words: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(w, head + 7), 16777216);
  let units: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(w, head + pool), 16777216);
  let delta: i64 = units - words;
  let rec: i64 = pool + units;
  if rec + 3 > lb || base < rec + 3 || base > lb { return false; }
  let ns: i64 = crate::ent_u16::rd(w, head + pool + words + 2);
  if ns < nt || ns > (lb - base) / 30 { return false; }
  let end: i64 = base + 30 * ns;
  let mut last: i64 = base - 1;
  let mut a: i64 = 0;
  while a < nt
    invariant 0 <= a && a <= nt && nt <= 559240 && 0 <= head && head <= 16777216 && 0 <= base && base <= end && end <= 16777216
    decreases nt - a
  {
    let p: i64 = crate::ent_u16::rd(progress, a + 1);
    if p <= last || p < base || p >= end || (p - base) % 30 != 0 { return false; }
    if temp_true(w, head + p - delta) { return false; }
    last = p;
    a = a + 1;
  }
  return true;
}

pub fn index_request(nt: i64) -> [i64] ! alloc
{
  let mut rq: [i64] = crate::ent_u16::zeros(4);
  crate::ent_u16::wr(inout rq, 0, 8);
  crate::ent_packet::put_vs(inout rq, 1, 7, 4, nt);
  return rq;
}

pub fn index_complete(w: [i64], head: i64, id: i64, seq: i64, answer: [i64], progress: [i64]) -> [i64] ! alloc
  requires 0 <= head && head <= 16777216
{
  let nt: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(progress, 0), 559240);
  let e: ref [i64] = [];
  let mut rbase: i64 = 0;
  if nt > 0 {
    let rp: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(answer, 1), 33554432);
    if crate::ent_u16::rd(answer, rp + 4) == 1 {
      return crate::ent_packet::mk_packet(3, id, seq, 9, e, throw_rec(answer, rp + 5), e, e, e, 0);
    }
    let rsec: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(answer, rp + 2), 1000000);
    rbase = crate::ent_u16::clamp(crate::ent_packet::sec_start(answer, rsec), 33554432);
  }
  let starts: [i64] = crate::ent_packet::section_starts(w, head);
  let ps: i64 = crate::ent_packet::start_in(starts, 0);
  let pl: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(w, ps), 16777216);
  let nb: i64 = crate::ent_value::pool_bytes(w, ps);
  let delta: i64 = pl - crate::ent_u16::clamp(crate::ent_u16::rd(w, head + 7), 16777216);
  // the candidate pairs of the sessions that are not excluded, each with its session position sp
  let mut ep: [i64] = alloc(0, 0);
  let mut el: [i64] = alloc(0, 0);
  let mut tp: [i64] = alloc(0, 0);
  let mut sp: [i64] = alloc(0, 0);
  let mut a: i64 = 0;
  while a < nt
    invariant 0 <= a && a <= nt && nt <= 559240 && 0 <= rbase && rbase <= 33554432 && len(ep) <= 16777216 && len(el) == len(ep) && len(tp) == len(ep) && len(sp) == len(ep)
    decreases nt - a
  {
    if !crate::ent_value::truthy(answer, rbase + 3 * a) {
      let p: i64 = head + crate::ent_u16::clamp(crate::ent_u16::rd(progress, a + 1), 16777216) - delta;
      let from: i64 = len(ep);
      ses_pairs(w, starts, p, inout ep, inout el, inout tp);
      let to: i64 = len(ep);
      // proof bound for ses_pairs only: past it the count check after the loop fails the same way
      if to > 16777216 { return crate::ent_packet::boundary(9, id, 1); }
      let mut q: i64 = from;
      while q < to
        invariant from <= q && q <= to && to <= 16777216 && len(sp) == q && len(ep) == to && len(el) == to && len(tp) == to
        decreases to - q
      {
        arr_push(inout sp, p);
        q = q + 1;
      }
    }
    a = a + 1;
  }
  let n: i64 = len(ep);
  if n > 2796202 { return crate::ent_packet::boundary(9, id, 1); }
  // first write wins: one pass per candidate (hand: entry().or_insert). The candidate key is written at the end of keys and
  // looked up through an open-addressing hash index (slot = kept position g, -1 empty, RESHAPE.md row HK); a hit drops it
  // again, so keys holds the kept keys only. Kept entries are the parallel arrays ko/kl/val (row SA).
  let mut keys: [i64] = alloc(0, 0);
  let mut ko: [i64] = alloc(0, 0);
  let mut kl: [i64] = alloc(0, 0);
  let mut val: [i64] = alloc(0, 0);
  let tsz: i64 = 2 * n + 1;
  let mut tbl: [i64] = alloc(tsz, 0 - 1);
  let mut sum: i64 = 0;
  let mut m: i64 = 0;
  let mut f: i64 = 0;
  while f < n
    invariant 0 <= f && f <= n && n <= 2796202 && 0 <= m && m <= f && len(ko) == m && len(kl) == m && len(val) == m && len(ep) == n && len(el) == n && len(tp) == n && len(sp) == n && 0 <= sum && sum <= 16000000 && len(keys) <= sum && tsz == 2 * n + 1 && len(tbl) == tsz
    invariant forall g in 0..m: (0 <= ko[g] && 0 <= kl[g] && ko[g] + kl[g] <= len(keys))
    decreases n - f
  {
    let a1: i64 = eng_len(w, ps, crate::ent_u16::rd(ep, f), crate::ent_u16::rd(el, f));
    let a2: i64 = crate::ent_value::key_len(w, crate::ent_u16::rd(tp, f));
    if a1 < 0 || a2 < 0 { return crate::ent_packet::boundary(9, id, 0); }
    let fl: i64 = a1 + 1 + a2;
    sum = sum + fl;
    if sum > 16000000 { return crate::ent_packet::boundary(9, id, 1); }
    let fo: i64 = len(keys);
    let mut z: i64 = 0;
    while z < fl
      invariant 0 <= z && z <= fl && len(keys) == fo + z && len(ko) == m && len(kl) == m
      invariant forall g in 0..m: (0 <= ko[g] && 0 <= kl[g] && ko[g] + kl[g] <= fo)
      decreases fl - z
    {
      arr_push(inout keys, 0);
      z = z + 1;
    }
    let x0: i64 = eng_put(w, ps, crate::ent_u16::rd(ep, f), crate::ent_u16::rd(el, f), inout keys, fo);
    let x: i64 = crate::ent_u16::clamp(x0, 4294967296);
    crate::ent_u16::wr(inout keys, x, 58);
    let y: i64 = crate::ent_value::key_put_at(w, crate::ent_u16::rd(tp, f), ps, inout keys, x + 1);
    let hh: i64 = crate::ent_value::pool_hash(keys, fo, fl);
    let mut s: i64 = hh % tsz;
    let mut hit: i64 = 0 - 1;
    let mut done: bool = false;
    let mut stp: i64 = 0;
    while !done && stp < tsz
      invariant 0 <= s && s < tsz && 0 <= stp && stp <= tsz && len(tbl) == tsz && len(ko) == m && len(kl) == m && -1 <= hit && hit < m && 0 <= m && m <= f && f <= n
      decreases tsz - stp
    {
      let g: i64 = crate::ent_u16::rd(tbl, s);
      if g < 0 {
        done = true;
      } else if g < m && crate::ent_u16::rd(kl, g) == fl && crate::ent_value::pool_eq(keys, crate::ent_u16::rd(ko, g), fo, fl) {
        hit = g;
        done = true;
      } else {
        s = s + 1;
        if s >= tsz { s = 0; }
      }
      stp = stp + 1;
    }
    // the table is never full (m < tsz), so a probe always ends on a hit or an empty slot
    if !done { return crate::ent_packet::boundary(9, id, 0); }
    if hit < 0 {
      crate::ent_u16::wr(inout tbl, s, m);
      arr_push(inout ko, fo);
      arr_push(inout kl, fl);
      arr_push(inout val, crate::ent_u16::rd(sp, f));
      m = m + 1;
    } else {
      keys = truncate(keys, fo);
      // MUTANT M16: a later write overwrites the stored session (last write wins)
    }
    f = f + 1;
  }
  if 16 + pl + sum + 6 * m > 16777216 { return crate::ent_packet::boundary(9, id, 1); }
  // the session id strings go to a compact pool when their units fit in the input pool's units, else the whole input pool
  // is kept and the id slots point into it. Every string span is checked; once past pl the sum no longer matters.
  let mut vsum: i64 = 0;
  let mut bytes: i64 = 0;
  let mut full: bool = false;
  let mut h0: i64 = 0;
  while h0 < m
    invariant 0 <= h0 && h0 <= m && m <= n && n <= 2796202 && 0 <= vsum && vsum <= pl && len(val) == m && 0 <= pl && pl <= 16777216 && 0 <= bytes && bytes <= 4 * vsum
    decreases m - h0
  {
    let vp: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(val, h0), 4294967296);
    if crate::ent_u16::rd(w, vp) == 6 {
      let va: i64 = crate::ent_value::pstr_off(w, vp);
      let vb: i64 = crate::ent_value::pstr_raw_len(w, vp);
      if !crate::ent_value::span_ok(w, ps, va, vb) { return crate::ent_packet::boundary(9, id, 0); }
      let vu: i64 = crate::ent_value::span_units(w, ps, va, vb);
      if !full {
        if vu > pl - vsum { full = true; }
        else {
          bytes = bytes + 4 * vu;
          vsum = vsum + vu;
        }
      }
    }
    h0 = h0 + 1;
  }

  let mut values: [i64] = crate::ent_u16::empty();
  if full { values = crate::ent_value::pool_head(w, ps, nb, pl); }
  else { values = alloc(crate::ent_value::pool_capacity(crate::ent_u16::clamp(bytes, 67108864)), 0); }
  let mut key_pool: [i64] = alloc(crate::ent_value::pool_capacity(3 * len(keys) + m), 0);
  // rows in order; the key slot offsets are rebased once the key pool's place is known (hand: kslots)
  let mut tab: [i64] = alloc(0, 0);
  let mut kat: [i64] = alloc(0, 0);
  let mut kb: [i64] = alloc(0, 0);
  arr_reserve(inout tab, 6 * m);
  arr_reserve(inout kat, m);
  arr_reserve(inout kb, m);
  let mut h: i64 = 0;
  while h < m
    invariant 0 <= h && h <= m && m <= n && n <= 2796202 && len(ko) == m && len(kl) == m && len(val) == m && len(tab) == 6 * h && len(kat) == h && len(kb) == h
    invariant forall g in 0..m: (0 <= ko[g] && 0 <= kl[g] && ko[g] + kl[g] <= len(keys))
    decreases m - h
  {
    let start: i64 = ko[h];
    // DB22 (D-DB18-3 P3): encode the key straight into key_pool; no temp pool per key.
    let at: i64 = crate::ent_value::append_units(inout key_pool, 0, subview(keys, start, start + kl[h]));
    arr_push(inout kat, at);
    arr_push(inout kb, crate::ent_value::pool_bytes(key_pool, 0) - at);
    arr_push(inout tab, 0, 0, 0, 0, 0, 0);
    let vp: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(val, h), 4294967296);
    if !full && crate::ent_u16::rd(w, vp) == 6 {
      crate::ent_value::append_slot(inout values, 0, w, ps, w, vp, inout tab, 6 * h + 3);
    } else {
      let z: i64 = crate::ent_u16::put_range(inout tab, 6 * h + 3, w, vp, 3);
    }
    h = h + 1;
  }
  let base: i64 = crate::ent_value::pool_base(values, key_pool);
  let mut j: i64 = 0;
  while j < m
    invariant 0 <= j && j <= m && m <= 2796202 && len(tab) == 6 * m && len(kat) == m && len(kb) == m && 0 <= base && base <= 1073741824
    decreases m - j
  {
    crate::ent_packet::put_vs(inout tab, 6 * j, 6, base + crate::ent_u16::clamp(kat[j], 1073741824), kb[j]);
    j = j + 1;
  }
  let mut rec: [i64] = alloc(4, 0);
  crate::ent_packet::put_vs(inout rec, 1, 7, 4, m);
  let empty: [i64] = crate::ent_u16::empty();
  return crate::ent_packet::mk_packet(3, id, seq, 9, crate::ent_value::pool_cat(values, key_pool), rec, empty, empty, tab, 1);
}
