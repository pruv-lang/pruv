// Section 0 is [nu, nb, W_1..W_m] on both sides of the entry boundary.
// Validate WTF-8 in place, including zero byte padding and optional trailing zero words.
// Return -1 past the stream or for a word outside the seven-byte range.
fn byte_at(w: [i64], p: i64, k: i64, nb: i64) -> i64
  requires 0 <= p && p <= 33554432 && 0 <= k && k <= 4294967296
  ensures -1 <= result && result <= 255
{
  if k >= nb { return -1; }
  let x: i64 = crate::ent_u16::rd(w, p + 2 + k / 7);
  if x < 0 || x > 72057594037927935 { return -1; }
  return crate::ent_value::pool_byte(w, p, k);
}

fn cont(b: i64) -> bool
{
  return b >= 128 && b <= 191;
}

// section table shape: 2 <= nsec, every length >= 0, lengths sum to the words after the table, at most 2^24 words
fn shape_ok(w: [i64]) -> bool
{
  let n: i64 = len(w);
  if n > 16777216 || n < 8 { return false; }
  let ns: i64 = w[6];
  if ns < 2 || ns > n - 7 { return false; }
  let mut rest: i64 = n - 7 - ns;
  let mut i: i64 = 0;
  while i < ns
    invariant 0 <= i && i <= ns && ns <= n - 7 && n == len(w) && 0 <= rest
    decreases ns - i
  {
    let l: i64 = w[7 + i];
    if l < 0 || l > rest { return false; }
    rest = rest - l;
    i = i + 1;
  }
  return rest == 0;
}

// w with section 0 replaced by the l-word pool held in o's prefix layout: allocate, copy the header, the tail and fix the lengths
fn with_pool_len(w: [i64], l: i64) -> [i64] ! alloc
  requires 0 <= l && l <= 16777216
  ensures len(result) >= 0
{
  let n: i64 = len(w);
  if n < 8 || n > 16777216 { return copy(w); }
  let ns: i64 = w[6];
  if ns < 2 || ns > n - 7 { return copy(w); }
  let p0: i64 = 7 + ns;
  let l0: i64 = w[7];
  if l0 < 0 || l0 > n - p0 { return copy(w); }
  let m: i64 = n - l0 + l;
  let mut o: [i64] = alloc(m, 0);
  let a: i64 = crate::ent_u16::put_range(inout o, 0, w, 0, p0);
  let b: i64 = crate::ent_u16::put_range(inout o, p0 + l, w, p0 + l0, n - p0 - l0);
  crate::ent_u16::wr(inout o, 4, m - 5);
  crate::ent_u16::wr(inout o, 7, l);
  return o;
}

// the packet with the rejected pool [-1]
pub fn poison(w: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let mut o: [i64] = with_pool_len(w, 1);
  crate::ent_u16::wr(inout o, 7 + crate::ent_u16::clamp(crate::ent_u16::rd(w, 6), 16777216), -1);
  // env_check looks for the pool at 7 + min(nsec, 1000000); above that cap also break the version so it still rejects
  if crate::ent_u16::rd(w, 6) > 1000000 { crate::ent_u16::wr(inout o, 0, 0); }
  return o;
}

// Malformed outer envelopes go to the packet layer for the existing error classification.
pub fn wire_in(w: [i64]) -> bool
{
  if !shape_ok(w) { return true; }
  let n: i64 = len(w);
  if n < 8 || n > 16777216 || w[4] != n - 5 { return true; }
  let ns: i64 = w[6];
  if ns < 2 || ns > n - 7 { return true; }
  return pool_ok(w, 7 + ns, w[7]);
}

pub fn pool_ok(w: [i64], p0: i64, l0: i64) -> bool
{
  if p0 < 0 || p0 > 33554432 || l0 < 2 || l0 > 16777216 || l0 > len(w) - p0 { return false; }
  let nu: i64 = crate::ent_u16::rd(w, p0);
  let nb: i64 = crate::ent_u16::rd(w, p0 + 1);
  let cap: i64 = 7 * (l0 - 2);
  if nu < 0 || nu > 16777216 || nb < nu || nb > cap || nb > 3 * nu + nu / 2 { return false; }
  // Equal counts imply an ASCII-only stream. Check all seven high bits in each word.
  if nb == nu { return ascii_pool_ok(w, p0, l0, nb); }
  let mut u: i64 = 0;
  let mut k: i64 = 0;
  let mut hi3: bool = false;
  while k < nb
    invariant 0 <= nb && nb <= 58720256 && 0 <= k && k <= nb + 3 && 0 <= u && u <= k && 0 <= p0 && p0 <= 33554432
    decreases nb - k
  {
    let b0: i64 = byte_at(w, p0, k, nb);
    if b0 < 0 { return false; }
    if b0 < 128 {
      k = k + 1; u = u + 1; hi3 = false;
    } else if b0 == 255 {
      // The separator byte: only between a lone high and a lone low, and it counts no unit.
      if !hi3 || !crate::ent_value::starts_low(w, p0, k + 1, nb - k - 1) { return false; }
      k = k + 1; hi3 = false;
    } else if b0 < 194 {
      return false;
    } else if b0 < 224 {
      let b1: i64 = byte_at(w, p0, k + 1, nb);
      if !cont(b1) { return false; }
      k = k + 2; u = u + 1; hi3 = false;
    } else if b0 < 240 {
      let b1: i64 = byte_at(w, p0, k + 1, nb);
      let b2: i64 = byte_at(w, p0, k + 2, nb);
      if !cont(b1) || !cont(b2) { return false; }
      if b0 == 224 && b1 < 160 { return false; }
      let v: i64 = (b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128);
      if hi3 && v >= 56320 && v <= 57343 { return false; }
      hi3 = v >= 55296 && v <= 56319;
      k = k + 3; u = u + 1;
    } else if b0 < 245 {
      let b1: i64 = byte_at(w, p0, k + 1, nb);
      let b2: i64 = byte_at(w, p0, k + 2, nb);
      let b3: i64 = byte_at(w, p0, k + 3, nb);
      if !cont(b1) || !cont(b2) || !cont(b3) { return false; }
      if b0 == 240 && b1 < 144 { return false; }
      if b0 == 244 && b1 > 143 { return false; }
      k = k + 4; u = u + 2; hi3 = false;
    } else {
      return false;
    }
  }
  if k != nb || u != nu { return false; }
  return padding_ok(w, p0, l0, nb);
}

fn ascii_pool_ok(w: [i64], p0: i64, l0: i64, nb: i64) -> bool
  requires 0 <= p0 && p0 <= 33554432 && 0 <= nb && nb <= 58720256 && 2 <= l0 && l0 <= 16777216 && nb <= 7 * (l0 - 2)
{
  let used: i64 = (nb + 6) / 7;
  let mut i: i64 = 0;
  while i < used
    invariant 0 <= i && i <= used && used <= 16777216 && 0 <= p0 && p0 <= 33554432
    decreases used - i
  {
    let word: i64 = crate::ent_u16::rd(w, p0 + 2 + i);
    // 0x80808080808080: the same high-bit mask in every packed byte.
    if word < 0 || word > 72057594037927935 || (word & 36170086419038336) != 0 { return false; }
    i = i + 1;
  }
  return padding_ok(w, p0, l0, nb);
}

fn padding_ok(w: [i64], p0: i64, l0: i64, nb: i64) -> bool
  requires 0 <= p0 && p0 <= 33554432 && 0 <= nb && nb <= 58720256 && 2 <= l0 && l0 <= 16777216 && nb <= 7 * (l0 - 2)
{
  let used: i64 = (nb + 6) / 7;
  let end: i64 = used * 7;
  let mut k: i64 = nb;
  while k < end
    invariant 0 <= k && k <= end && end <= 58720262 && 0 <= p0 && p0 <= 33554432
    decreases end - k
  {
    if byte_at(w, p0, k, end) != 0 { return false; }
    k = k + 1;
  }
  let mut j: i64 = 2 + used;
  while j < l0
    invariant 2 <= j && j <= l0 && l0 <= 16777216 && 0 <= p0 && p0 <= 33554432
    decreases l0 - j
  {
    if crate::ent_u16::rd(w, p0 + j) != 0 { return false; }
    j = j + 1;
  }
  return true;
}

// Ignore the optional all-zero words accepted by wire_in when comparing awaits.
pub fn same_packet(a: [i64], b: [i64]) -> bool
{
  let na: i64 = len(a);
  let nb: i64 = len(b);
  if na == nb && eq_range(a, 0, b, 0, na) { return wire_in(b); }
  if !shape_ok(a) || !shape_ok(b) { return false; }
  if na < 9 || nb < 9 || a[4] != na - 5 || b[4] != nb - 5 { return false; }
  let sa: i64 = a[6];
  let sb: i64 = b[6];
  if sa < 2 || sa > na - 7 || sb != sa || sb > nb - 7 { return false; }
  let p: i64 = 7 + sa;
  let la: i64 = a[7];
  let lb: i64 = b[7];
  if la < 2 || la > na - p || lb < 2 || lb > nb - p { return false; }
  if na - la != nb - lb || !pool_ok(a, p, la) || !pool_ok(b, p, lb) { return false; }
  if !eq_range(a, 0, b, 0, 4) || !eq_range(a, 5, b, 5, 2) || !eq_range(a, 8, b, 8, sa - 1) { return false; }
  let bytes: i64 = crate::ent_value::pool_bytes(a, p);
  let words: i64 = crate::ent_value::pool_capacity(bytes);
  if words > la || words > lb || !eq_range(a, p, b, p, words) { return false; }
  return eq_range(a, p + la, b, p + lb, na - p - la);
}
