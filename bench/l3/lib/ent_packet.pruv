// L3-8 entry packet layer, in the shape of lib/hand/ent_packet.rs (Rust-shape reset step 3.2).
// DESIGN.md section 2 and 3; host.rs is the wire authority. The packet is the external input and output format, so it
// stays [i64] words in and out:
//   packet  = [1, kind, op_id, seq, len, op, nsec, len_0..len_{nsec-1}, section data...]       total words = 5 + len
//   section 0 = packed WTF-8 pool, section 1 = record, sections >= 2 = tables (input/completion) or
//   state (2) / emitted rows (3) / request or result tables (>= 4) in await and done packets.
//   VS (value slot) = [tag, a, b], 3 words (see the tag list in DESIGN 2.2).
// A record check borrows the packet once in a Check (section starts built once, claimed sections, pool high-water,
// a bad flag) and walks the record slots; nothing is copied out of the packet. Reads of record words are total
// (u16::rd): the envelope was checked first, so they are defence in depth.

// ---- tag masks (bit t set = tag t allowed). No module constants in Pruv (RESHAPE.md row K): nullary functions. ----
pub fn m_any() -> i64 ensures result == 1647 { return 1647; }       // 0 1 2 3 5 6 9 10
pub fn m_thread() -> i64 ensures result == 3075 { return 3075; }    // 0 1 10 11
pub fn m_forks() -> i64 ensures result == 1155 { return 1155; }     // 0 1 10 7
pub fn m_ets() -> i64 ensures result == 1283 { return 1283; }       // 0 1 10 8
pub fn m_bound() -> i64 ensures result == 3183 { return 3183; }     // 0 1 2 3 5 6 10 11
pub fn m_bool() -> i64 ensures result == 12 { return 12; }          // 2 3
pub fn m_str() -> i64 ensures result == 64 { return 64; }           // 6
pub fn m_arr() -> i64 ensures result == 128 { return 128; }         // 7
pub fn m_ref() -> i64 ensures result == 512 { return 512; }         // 9
pub fn m_undef() -> i64 ensures result == 1 { return 1; }           // 0
pub fn m_ustr() -> i64 ensures result == 65 { return 65; }          // 0 6

// ---- sections (total over any words, also used on packets this process built) ----
pub fn nsec(w: [i64]) -> i64
  ensures 0 <= result && result <= 1000000
{
  return crate::ent_u16::clamp(crate::ent_u16::rd(w, 6), 1000000);
}

// length of section i (0 for an index out of range)
pub fn sec_len(w: [i64], i: i64) -> i64
  ensures 0 <= result && result <= 16777216
{
  if i < 0 || i >= nsec(w) { return 0; }
  return crate::ent_u16::clamp(crate::ent_u16::rd(w, 7 + i), 16777216);
}

// absolute index in w of the first word of section i (0 <= i <= nsec); clamped into 0..2^25 (a valid packet never
// reaches the clamp). One walk of the table per call (RESHAPE.md row 3.2-S: the consumers own their 56 calls).
pub fn sec_start(w: [i64], i: i64) -> i64
  ensures 0 <= result && result <= 33554432
{
  let ns: i64 = nsec(w);
  let top: i64 = crate::ent_u16::clamp(i, ns);
  let mut at: i64 = 7 + ns;
  let mut j: i64 = 0;
  while j < top
    invariant 0 <= j && j <= top && top <= ns && ns <= 1000000 && 0 <= at && at <= 1000007 + 16777216 * j
    decreases top - j
  {
    at = at + crate::ent_u16::clamp(crate::ent_u16::rd(w, 7 + j), 16777216);
    j = j + 1;
  }
  return crate::ent_u16::clamp(at, 33554432);
}

// starts[j] = absolute start of section j of the packet at `head`, for 0 <= j <= nsec (hand `section_starts`).
pub fn section_starts(w: [i64], head: i64) -> [i64] ! alloc
  requires 0 <= head && head <= 16777216
  ensures len(result) >= 1
{
  let ns: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(w, head + 6), 1000000);
  let mut starts: [i64] = alloc(0, 0);
  arr_reserve(inout starts, ns + 1);
  let mut at: i64 = head + 7 + ns;
  let mut j: i64 = 0;
  while j <= ns
    invariant 0 <= j && j <= ns + 1 && ns <= 1000000 && len(starts) == j && 0 <= at && at <= head + 1000007 + 16777216 * j
    decreases ns + 1 - j
  {
    arr_push(inout starts, crate::ent_u16::clamp(at, 33554432));
    if j < ns { at = at + crate::ent_u16::clamp(crate::ent_u16::rd(w, head + 7 + j), 16777216); }
    j = j + 1;
  }
  return starts;
}

// the start of section i from a section_starts table (the index is clamped into the table)
pub fn start_in(starts: [i64], i: i64) -> i64
  ensures 0 <= result && result <= 33554432
{
  let n: i64 = len(starts);
  if n == 0 { return 0; }
  return crate::ent_u16::clamp(starts[crate::ent_u16::clamp(i, n - 1)], 33554432);
}

// ---- envelope ----
// 0 ok, 1 InvalidPacket, 2 InputTooLarge (RESHAPE.md row 3.2-E; hand Result<(), Reject>). Structure only: version, kind,
// ids, section header, packed pool validation.
pub fn env_check(w: [i64]) -> i64
{
  return env_check_at(w, false);
}

// Preserve wire rejection before the logical size check, including the poisoned envelope's size.
pub fn env_check_wire(w: [i64]) -> i64 ! alloc
{
  if !crate::ent_wire::wire_in(w) { return env_check_at(crate::ent_wire::poison(w), false); }
  return env_check_at(w, len(w) <= 16777216);
}

fn env_check_at(w: [i64], pool_checked: bool) -> i64
{
  // the logical size is ent_value's (step 3.3 boundary)
  if crate::ent_value::pkt_size(w) > 16777216 { return 2; }
  let n: i64 = len(w);
  if n < 7 { return 1; }
  if w[0] != 1 || w[1] < 0 || w[1] > 3 || w[2] < 1 || w[3] < 0 || w[4] != n - 5 || w[5] < 1 || w[5] > 9 { return 1; }
  let ns: i64 = w[6];
  if ns < 2 || ns > n - 7 { return 1; }
  let mut rest: i64 = n - 7 - ns;
  let mut i: i64 = 0;
  while i < ns
    invariant 0 <= i && i <= ns && ns <= n - 7 && n == len(w) && 0 <= rest
    decreases ns - i
  {
    let l: i64 = w[7 + i];
    if l < 0 || l > rest { return 1; }
    rest = rest - l;
    i = i + 1;
  }
  if rest != 0 || ns > 1000000 || (!pool_checked && !crate::ent_wire::pool_ok(w, 7 + ns, w[7])) { return 1; }
  return 0;
}

// ---- value slots ----
pub fn in_mask(mask: i64, tag: i64) -> bool
{
  if tag < 0 || tag > 11 { return false; }
  return band(ushr(mask, tag), 1) == 1;
}

// n words from p are zero (words past the end read as zero)
pub fn zero_run(w: [i64], p0: i64, n0: i64) -> bool
{
  let p: i64 = crate::ent_u16::clamp(p0, 1000000000);
  let n: i64 = crate::ent_u16::clamp(n0, 1000000);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && 0 <= p && p <= 1000000000 && n <= 1000000
    decreases n - i
  {
    if crate::ent_u16::rd(w, p + i) != 0 { return false; }
    i = i + 1;
  }
  return true;
}

// One record check over a borrowed packet (hand `Check<'a>`). claimed[s] once table section s was claimed by a table
// slot; a table section must be claimed exactly once.
pub struct Check { w: ref [i64], starts: [i64], claimed: [bool], pool_hi: i64, bad: bool }

pub fn checker(w: [i64]) -> Check from(w) ! alloc
{
  let starts: [i64] = section_starts(w, 0);
  let claimed: [bool] = alloc(nsec(w), false);
  return Check { w: w, starts: move starts, claimed: move claimed, pool_hi: 0, bad: false };
}

// Check the slot at absolute position p against a tag mask. width > 0: a table slot (tag 7/8) whose section must hold
// exactly count * width words; the section is claimed. width == 0: table tags are rejected. A failed check only sets
// the flag; the callers go on and the flag is read once at the end.
pub fn vs(inout c: Check, p0: i64, mask: i64, width0: i64) -> ()
{
  let p: i64 = crate::ent_u16::clamp(p0, 1000000000);
  let width: i64 = crate::ent_u16::clamp(width0, 64);
  let tag: i64 = crate::ent_u16::rd(c.w, p);
  let a: i64 = crate::ent_u16::rd(c.w, p + 1);
  let b: i64 = crate::ent_u16::rd(c.w, p + 2);
  let mut ok: bool = false;
  if !in_mask(mask, tag) {
    ok = false;
  } else if tag <= 3 || tag == 10 || tag == 11 {
    ok = a == 0 && b == 0;
  } else if tag == 4 {
    ok = b == 0;
  } else if tag == 5 {
    ok = a >= 0 && a <= 4294967295 && b >= 0 && b <= 4294967295;
  } else if tag == 6 {
    ok = crate::ent_value::span_ok(c.w, start_in(c.starts, 0), a, b);
    if ok {
      let hi: i64 = crate::ent_u16::clamp(a, 4294967296) + crate::ent_u16::clamp(b, 4294967296);
      if hi > c.pool_hi { c.pool_hi = hi; }
    }
  } else if tag == 9 {
    ok = a >= 1 && b == 0;
  } else {
    // tags 7 and 8
    ok = width > 0 && a >= 2 && a < len(c.claimed) && b >= 0 && b <= 16777216 && crate::ent_u16::rd(c.w, 7 + a) == b * width && !c.claimed[a];
    if ok { c.claimed[a] = true; }
  }
  if !ok { c.bad = true; }
}

// The pool high-water, or -1 when a slot failed or a table section (>= 2) was not claimed (RESHAPE.md row 3.2-O; hand
// Option<i64>).
pub fn finish(c: Check) -> i64
{
  if c.bad { return -1; }
  let mut s: i64 = 2;
  while s < len(c.claimed)
    invariant 2 <= s
    decreases len(c.claimed) - s
  {
    if !c.claimed[s] { return -1; }
    s = s + 1;
  }
  return c.pool_hi;
}

// ---- record checks ----

// rows of width 3 (one VS each, tags in mask) in the table slot at p; the slot itself was already checked
fn rows1(inout c: Check, p0: i64, mask: i64) -> ()
{
  let p: i64 = crate::ent_u16::clamp(p0, 1000000000);
  if crate::ent_u16::rd(c.w, p) != 7 { return; }
  let base: i64 = start_in(c.starts, crate::ent_u16::rd(c.w, p + 1));
  let cnt: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(c.w, p + 2), 16777216);
  let mut i: i64 = 0;
  while i < cnt
    invariant 0 <= i && i <= cnt && cnt <= 16777216 && 0 <= base && base <= 33554432
    decreases cnt - i
  {
    vs(inout c, base + 3 * i, mask, 0);
    i = i + 1;
  }
}

// engineThreads entry rows: key {6}, bound {0,1,2,3,5,6,10,11}, threadId (any if bound is 11, else a zero slot)
fn ets(inout c: Check, p0: i64) -> ()
{
  let p: i64 = crate::ent_u16::clamp(p0, 1000000000);
  if crate::ent_u16::rd(c.w, p) != 8 { return; }
  let base: i64 = start_in(c.starts, crate::ent_u16::rd(c.w, p + 1));
  let cnt: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(c.w, p + 2), 16777216);
  let mut i: i64 = 0;
  while i < cnt
    invariant 0 <= i && i <= cnt && cnt <= 16777216 && 0 <= base && base <= 33554432
    decreases cnt - i
  {
    let q: i64 = base + 9 * i;
    vs(inout c, q, m_str(), 0);
    vs(inout c, q + 3, m_bound(), 0);
    if crate::ent_u16::rd(c.w, q + 3) == 11 {
      vs(inout c, q + 6, m_any(), 0);
    } else if !zero_run(c.w, q + 6, 3) {
      c.bad = true;
    }
    i = i + 1;
  }
}

// one session record (10 slots = 30 words) at absolute position p
fn session(inout c: Check, p0: i64) -> ()
{
  let p: i64 = crate::ent_u16::clamp(p0, 1000000000);
  vs(inout c, p, m_any(), 0);
  vs(inout c, p + 3, m_any(), 0);
  vs(inout c, p + 6, m_any(), 0);
  vs(inout c, p + 9, m_thread(), 0);
  if crate::ent_u16::rd(c.w, p + 9) == 11 {
    vs(inout c, p + 12, m_any(), 0);
    vs(inout c, p + 15, m_any(), 0);
    vs(inout c, p + 18, m_forks(), 3);
    rows1(inout c, p + 18, m_any());
  } else if !zero_run(c.w, p + 12, 9) {
    c.bad = true;
  }
  vs(inout c, p + 21, m_thread(), 0);
  if crate::ent_u16::rd(c.w, p + 21) == 11 {
    vs(inout c, p + 24, m_any(), 0);
  } else if !zero_run(c.w, p + 24, 3) {
    c.bad = true;
  }
  vs(inout c, p + 27, m_ets(), 9);
  ets(inout c, p + 27);
}

// error observation E (6 slots = 18 words) at p: valueRef {9}, isEngineImportError {2,3}, isError {2,3}, name any,
// message ({6} if isError is true, else {0}), code any
fn err(inout c: Check, p0: i64) -> ()
{
  let p: i64 = crate::ent_u16::clamp(p0, 1000000000);
  vs(inout c, p, m_ref(), 0);
  vs(inout c, p + 3, m_bool(), 0);
  vs(inout c, p + 6, m_bool(), 0);
  vs(inout c, p + 9, m_any(), 0);
  if crate::ent_u16::rd(c.w, p + 6) == 3 {
    vs(inout c, p + 12, m_str(), 0);
  } else {
    vs(inout c, p + 12, m_undef(), 0);
  }
  vs(inout c, p + 15, m_any(), 0);
}

// Input record check for ops 2,3,4,7,8,9 (kind 0, envelope already ok): the pool high-water, or -1.
pub fn input_check(w: [i64]) -> i64 ! alloc
{
  let mut c: Check = checker(w);
  let op: i64 = crate::ent_u16::rd(w, 5);
  let r0: i64 = start_in(c.starts, 1);
  let rl: i64 = sec_len(w, 1);
  if op == 2 && rl == 6 {
    vs(inout c, r0, m_any(), 0);
    vs(inout c, r0 + 3, m_arr(), 3);
    rows1(inout c, r0 + 3, m_any());
  } else if op == 3 && rl == 12 {
    vs(inout c, r0, m_any(), 0);
    vs(inout c, r0 + 3, m_ref(), 0);
    vs(inout c, r0 + 6, m_any(), 0);
    vs(inout c, r0 + 9, m_ref(), 0);
  } else if op == 4 && rl == 15 {
    vs(inout c, r0, m_any(), 0);
    vs(inout c, r0 + 3, m_ref(), 0);
    vs(inout c, r0 + 6, m_any(), 0);
    vs(inout c, r0 + 9, m_any(), 0);
    vs(inout c, r0 + 12, m_ref(), 0);
  } else if (op == 7 || op == 8) && rl == 30 {
    session(inout c, r0);
  } else if op == 9 && rl == 3 {
    vs(inout c, r0, m_arr(), 30);
    let cnt: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(w, r0 + 2), 16777216);
    let base: i64 = start_in(c.starts, crate::ent_u16::rd(w, r0 + 1));
    let mut i: i64 = 0;
    while i < cnt
      invariant 0 <= i && i <= cnt && cnt <= 16777216 && 0 <= base && base <= 33554432
      decreases cnt - i
    {
      session(inout c, base + 30 * i);
      i = i + 1;
    }
  } else {
    return -1;
  }
  return finish(c);
}

// Completion record check for the outstanding request `rcode` (1..9). aux: for 8 the number of ids sent, for 9 the
// opKind (0 list / 1 read). Envelope already ok: the pool high-water, or -1. host.rs is the layout authority.
pub fn comp_check(w: [i64], rcode: i64, aux: i64) -> i64 ! alloc
{
  let mut c: Check = checker(w);
  let r0: i64 = start_in(c.starts, 1);
  let rl: i64 = sec_len(w, 1);
  if rl < 1 { return -1; }
  let st: i64 = crate::ent_u16::rd(w, r0);
  if rcode != 8 && st != 0 && st != 1 { return -1; }
  // a failed request answers with the error observation E
  if st == 1 && (rcode == 1 || rcode == 4 || rcode == 5 || rcode == 6 || rcode == 7 || rcode == 9) {
    if rl != 19 { return -1; }
    err(inout c, r0 + 1);
    return finish(c);
  }
  if rcode == 1 {
    let cnt: i64 = crate::ent_u16::rd(w, r0 + 1);
    if rl != 2 || cnt < 0 || cnt > 16777216 { return -1; }
  } else if rcode == 2 {
    let kind: i64 = crate::ent_u16::rd(w, r0 + 1);
    if st != 0 || rl != 8 || (kind != 0 && kind != 1) { return -1; }
    vs(inout c, r0 + 2, m_any(), 0);
    vs(inout c, r0 + 5, m_any(), 0);
  } else if rcode == 3 {
    if st != 0 || rl != 4 { return -1; }
    vs(inout c, r0 + 1, m_ustr(), 0);
  } else if rcode == 4 || rcode == 5 || rcode == 6 {
    if rl != 4 { return -1; }
    vs(inout c, r0 + 1, m_str(), 0);
  } else if rcode == 7 {
    if rl != 7 { return -1; }
    vs(inout c, r0 + 1, m_str(), 0);
    vs(inout c, r0 + 4, m_str(), 0);
  } else if rcode == 8 {
    // [0, results {7} rows of one any, thrown 0/1, E (18 words)]
    if rl != 23 || st != 0 { return -1; }
    vs(inout c, r0 + 1, m_arr(), 3);
    rows1(inout c, r0 + 1, m_any());
    let n: i64 = crate::ent_u16::rd(w, r0 + 3);
    let thrown: i64 = crate::ent_u16::rd(w, r0 + 4);
    if thrown == 0 && n == aux && zero_run(w, r0 + 5, 18) {
      // no error observation
    } else if thrown == 1 && n < aux {
      err(inout c, r0 + 5);
    } else {
      return -1;
    }
  } else if rcode == 9 {
    if rl != 4 { return -1; }
    if aux == 0 {
      vs(inout c, r0 + 1, m_arr(), 6);
      // rows [rowRef {9}, title {6}]
      let base: i64 = start_in(c.starts, crate::ent_u16::rd(w, r0 + 2));
      let cnt: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(w, r0 + 3), 16777216);
      let mut i: i64 = 0;
      while i < cnt
        invariant 0 <= i && i <= cnt && cnt <= 16777216 && 0 <= base && base <= 33554432
        decreases cnt - i
      {
        vs(inout c, base + 6 * i, m_ref(), 0);
        vs(inout c, base + 6 * i + 3, m_str(), 0);
        i = i + 1;
      }
    } else {
      vs(inout c, r0 + 1, m_ref(), 0);
    }
  } else {
    return -1;
  }
  return finish(c);
}

// ---- builders ----
pub fn put_vs(inout o: [i64], at0: i64, tag: i64, a: i64, b: i64) -> ()
  ensures len(o) == len(old(o))
{
  let at: i64 = crate::ent_u16::clamp(at0, 1000000000);
  crate::ent_u16::wr(inout o, at, tag);
  crate::ent_u16::wr(inout o, at + 1, a);
  crate::ent_u16::wr(inout o, at + 2, b);
}

// A boundary done packet: [5, code] with an empty pool; sections pool, record, state, rows (4, host minimum).
// code 0 InvalidPacket, 1 InputTooLarge, 2 InternalInvariant. op 0 when unknown.
pub fn boundary(op: i64, op_id: i64, code: i64) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let mut id: i64 = op_id;
  if id < 1 { id = 1; }
  let mut c: i64 = code;
  if c < 0 || c > 2 { c = 2; }
  let mut p: i64 = op;
  if p < 0 || p > 9 { p = 0; }
  let mut o: [i64] = alloc(0, 0);
  arr_reserve(inout o, 15);
  arr_push(inout o, 1, 3, id, 0, 10, p, 4, 2, 2, 0, 0, 0, 0, 5, c);
  return o;
}

// Assemble a packet. Sections: pool, rec, state, rows, then one table when ntab != 0 (else tab is ignored).
// An output that would exceed 16,777,216 words becomes a done packet with InputTooLarge, never a truncation.
pub fn mk_packet(kind: i64, op_id: i64, seq: i64, op: i64, pool: [i64], rec: [i64], state: [i64], rows: [i64], tab: [i64], ntab: i64) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let mut lp: i64 = len(pool);
  if lp == 0 { lp = 2; }
  let lr: i64 = len(rec);
  let ls: i64 = len(state);
  let lw: i64 = len(rows);
  let mut lt: i64 = len(tab);
  let mut ns: i64 = 5;
  if ntab == 0 { lt = 0; ns = 4; }
  if lp > 16777216 || lr > 16777216 || ls > 16777216 || lw > 16777216 || lt > 16777216 { return boundary(op, op_id, 1); }
  let total: i64 = 5 + 2 + ns + lp + lr + ls + lw + lt;
  if total > 16777216 || total - lp + crate::ent_u16::clamp(crate::ent_u16::rd(pool, 0), 16777216) > 16777216 { return boundary(op, op_id, 1); }
  let mut o: [i64] = alloc(0, 0);
  arr_reserve(inout o, total);
  arr_push(inout o, 1, kind, op_id, seq, total - 5, op, ns, lp, lr, ls, lw);
  if ns == 5 { arr_push(inout o, lt); }
  if len(pool) == 0 {
    arr_push(inout o, 0, 0);
  } else {
    arr_append(inout o, pool, 0, lp);
  }
  arr_append(inout o, rec, 0, lr);
  arr_append(inout o, state, 0, ls);
  arr_append(inout o, rows, 0, lw);
  if ns == 5 { arr_append(inout o, tab, 0, lt); }
  return o;
}

pub fn empty_state() -> [i64] ! alloc ensures len(result) == 0 { return alloc(0, 0); }
