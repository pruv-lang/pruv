// L3-8 entry: canonicalPath / isHostCodexHome / codexAccountFolder (reference/backend-codex-home.ts) and op 6.
// Every step works on the shared replay context: `inout cx: Ctx`, and an observation that stalls or breaks the replay returns
// through `?` (Result<.., Halt>). A thrown homedir / cwd answer is rethrown as the item result (rethrow_answer: output set,
// Halt::Done). A 0/1 result is Result<bool, Halt>; a string result stays in cx.opool with Result<(), Halt> (hand Rust returns
// Result<Vec<u16>, Halt>; row RA: Result<[i64], Halt> is rejected). Hand baseline: hand/ent_canon.rs.

// units of the string slot at record offset k of the last answer
pub fn ent_str(cx: crate::ent_state::Ctx, k: i64) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let p: i64 = crate::ent_packet::sec_start(cx.ent, 1) + crate::ent_u16::clamp(k, 4294967296);
  if crate::ent_value::tag_at(cx.ent, p) != 6 { return alloc(0, 0); }
  return crate::ent_value::str_units(cx.ent, p);
}

// a + "/" + b in one buffer (the length guard is the bound of ent_u16::cat; a packet string is far shorter)
fn slash_cat(a: [i64], b: [i64]) -> [i64] ! alloc
{
  if len(a) > 1073741823 || len(b) > 1073741823 { return alloc(0, 0); }
  let mut o: [i64] = alloc(0, 0);
  arr_reserve(inout o, len(a) + 1 + len(b));
  arr_append(inout o, a, 0, len(a));
  arr_push(inout o, 47);
  arr_append(inout o, b, 0, len(b));
  return o;
}

// the thrown value of the last (throw) answer is rethrown as it is: the item is done
pub fn rethrow_answer(inout cx: crate::ent_state::Ctx) -> crate::ent_state::Halt ! alloc
{
  let rp: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(cx.ent, 1), 33554432);
  let mut rec: [i64] = crate::ent_u16::zeros(4);
  crate::ent_u16::wr(inout rec, 0, 1);
  let a: i64 = crate::ent_u16::put_range(inout rec, 1, cx.ent, rp + 1, 3);
  let e: ref [i64] = [];
  crate::ent_state::put_done(inout cx, e, rec, e, 0);
  return crate::ent_state::Halt::Done;
}

// wire error: key 0 invalidId, 1 codexHostExecution
fn wire_done(inout cx: crate::ent_state::Ctx, key: i64) -> () ! alloc
{
  let e: ref [i64] = [];
  crate::ent_state::put_done(inout cx, e, [3, key], e, 0);
}

fn plain_done(inout cx: crate::ent_state::Ctx) -> () ! alloc
{
  let e: ref [i64] = [];
  crate::ent_state::put_done(inout cx, e, [4, 0], e, 0);
}

// homedir(): opool = the string; a throw is rethrown
pub fn home_dir(inout cx: crate::ent_state::Ctx) -> Result<(), crate::ent_state::Halt> ! alloc
{
  crate::ent_state::homedir(inout cx)?;
  if crate::ent_state::ent_r(cx, 0) == 1 {
    let h: crate::ent_state::Halt = rethrow_answer(inout cx);
    return Err::<(), crate::ent_state::Halt>(h);
  }
  cx.opool = ent_str(cx, 1);
  return Ok::<(), crate::ent_state::Halt>(());
}

// join(homedir(), seg); opool = the result
pub fn home_join(inout cx: crate::ent_state::Ctx, seg: str) -> Result<(), crate::ent_state::Halt> ! alloc
{
  home_dir(inout cx)?;
  cx.opool = crate::ent_path::join2(cx.opool, crate::ent_u16::lit(seg));
  return Ok::<(), crate::ent_state::Halt>(());
}

// path.resolve(p): process.cwd() requests as the path module asks for them; opool = the result
pub fn resolve_cwd(inout cx: crate::ent_state::Ctx, p: [i64]) -> Result<(), crate::ent_state::Halt> ! alloc
{
  let mut ncwd: i64 = 0;
  let mut c1: [i64] = crate::ent_u16::empty();
  let mut c2: [i64] = crate::ent_u16::empty();
  while ncwd < 2 && crate::ent_path::resolve_need(p, ncwd, c1, c2)
    invariant 0 <= ncwd && ncwd <= 2
    decreases 2 - ncwd
  {
    crate::ent_state::cwd(inout cx)?;
    if crate::ent_state::ent_r(cx, 0) == 1 {
      let h: crate::ent_state::Halt = rethrow_answer(inout cx);
      return Err::<(), crate::ent_state::Halt>(h);
    }
    let s: [i64] = ent_str(cx, 1);
    if ncwd == 0 { c1 = copy(s); } else { c2 = copy(s); }
    ncwd = ncwd + 1;
  }
  cx.opool = crate::ent_path::resolve_finish(p, ncwd, c1, c2);
  return Ok::<(), crate::ent_state::Halt>(());
}

// R3 helpers. r is a resolved path; a "normalized absolute" path starts with '/', has no "//" and no trailing '/' (except "/").
// A normalized relative path is nonempty with no leading '/', no "//" and no trailing '/'. Its climb levels are the path with
// its last d segments cut off for d = 1..k (k = number of '/'), then "." (d = k + 1), whose parent is itself.
fn has_double_slash(r: [i64]) -> bool
{
  let n: i64 = len(r);
  let mut i: i64 = 1;
  while i < n
    invariant 1 <= i && n == len(r)
    decreases n - i
  {
    if crate::ent_u16::rd(r, i) == 47 && crate::ent_u16::rd(r, i - 1) == 47 { return true; }
    i = i + 1;
  }
  return false;
}

fn norm_abs(r: [i64]) -> bool
{
  let n: i64 = len(r);
  if n < 1 || crate::ent_u16::rd(r, 0) != 47 { return false; }
  if n == 1 { return true; }
  return crate::ent_u16::rd(r, n - 1) != 47 && !has_double_slash(r);
}

fn norm_rel(r: [i64]) -> bool
{
  let n: i64 = len(r);
  if n < 1 || crate::ent_u16::rd(r, 0) == 47 || crate::ent_u16::rd(r, n - 1) == 47 { return false; }
  return !has_double_slash(r);
}

fn count_slash(r: [i64]) -> i64
  ensures result >= 0 && result <= len(r)
{
  let mut i: i64 = 0;
  let mut k: i64 = 0;
  while i < len(r)
    invariant 0 <= i && i <= len(r) && 0 <= k && k <= i
    decreases len(r) - i
  {
    if crate::ent_u16::rd(r, i) == 47 { k = k + 1; }
    i = i + 1;
  }
  return k;
}

// index of the d-th '/' counted from the end of r (d >= 1), or -1 (hand: Option<usize>; row O)
fn slash_from_end(r: [i64], d: i64) -> i64
  ensures result >= -1 && result < len(r)
{
  let mut i: i64 = len(r) - 1;
  let mut seen: i64 = 0;
  while i >= 0
    invariant -1 <= i && i < len(r) && 0 <= seen && seen <= len(r) - 1 - i
    decreases i + 1
  {
    if crate::ent_u16::rd(r, i) == 47 {
      seen = seen + 1;
      if seen == d { return i; }
    }
    i = i - 1;
  }
  return -1;
}

// canonicalPath(path): opool = the canonical string. Realpath and stat answers are observations.
//
// Climb checkpoint (R3). The climb walks from the resolved path up to the first existing ancestor, one request per level. A
// level that fails and moves on to its parent is DROPPED from the log and counted in the checkpoint words, so a resumed step
// continues at that level instead of replaying the whole climb: the log stays constant-size and a step costs O(path), not
// O(levels). Checkpoint words of an item (ck0..2 belong to op 1 phases, see sources.pruv; op 6 keeps them 0):
//   ck3, ck4, ck5 = levels already climbed (dropped) by canonical call 0, 1, 2 of the item (is_codex_home makes 3 calls)
//   ck6           = reserved, must be 0
//   ck7           = total log entries dropped in the item (1 per level, 2 when the level also issued a stat)
// The words are cleared by sources::adv at every op 1 item boundary. Only the first 3 calls of an item compact, and only
// when the resolved path is normalized (absolute, or relative as for a relative cwd; then level d is the path with its last d
// segments cut off, found by scanning slashes instead of d dirname calls; a relative path ends with level k + 1 = "."); otherwise the climb is the plain full replay and the words stay 0.
// state::log_cont and state::ck_ok validate the words and the seq gaps they imply.
pub fn canonical(inout cx: crate::ent_state::Ctx, path: [i64]) -> Result<(), crate::ent_state::Halt> ! alloc
{
  let ci: i64 = crate::ent_u16::clamp(cx.ncan, 1000);
  cx.ncan = ci + 1;
  resolve_cwd(inout cx, path)?;
  let r: [i64] = copy(cx.opool);
  let slot: i64 = 3 + ci;
  let isabs: bool = norm_abs(r);
  let cmp: bool = ci < 3 && (isabs || norm_rel(r));
  let mut d: i64 = 0;
  if ci < 3 { d = crate::ent_u16::clamp(crate::ent_u16::rd(cx.ck, slot), 33554432); }
  if d > 0 && (!cmp || len(r) < 2 || d > len(r) + 1) { return crate::ent_state::stop_fail(inout cx); }
  let mut current: [i64] = copy(r);
  let mut raw: [i64] = crate::ent_u16::empty();
  let mut jn: [i64] = crate::ent_u16::empty();
  if d > 0 {
    if isabs {
      let q: i64 = slash_from_end(r, d);
      if q < 0 { return crate::ent_state::stop_fail(inout cx); }
      let mut cp: i64 = q;
      if q == 0 { cp = 1; }
      current = crate::ent_u16::slice(r, 0, cp);
      raw = crate::ent_u16::slice(r, q + 1, len(r));
      jn = copy(raw);
    } else {
      // relative: levels 1..k cut at a slash, level k + 1 is "." with every segment still missing
      let k: i64 = count_slash(r);
      if d > k + 1 { return crate::ent_state::stop_fail(inout cx); }
      if d == k + 1 {
        current = crate::ent_u16::lit(".");
        raw = copy(r);
        jn = copy(r);
      } else {
        let q: i64 = slash_from_end(r, d);
        if q < 0 { return crate::ent_state::stop_fail(inout cx); }
        current = crate::ent_u16::slice(r, 0, q);
        raw = crate::ent_u16::slice(r, q + 1, len(r));
        jn = copy(raw);
      }
    }
  }
  let mut nmiss: i64 = d;
  let f0: i64 = len(r) + 3;
  let mut fuel: i64 = f0 - d;
  while fuel > 0
    invariant 0 <= fuel && 0 <= nmiss && nmiss + fuel == f0
    decreases fuel
  {
    let a0: i64 = cx.pos;
    let mut ne: i64 = 1;
    crate::ent_state::realpath(inout cx, current)?;
    if crate::ent_state::ent_r(cx, 0) == 0 {
      let real: [i64] = ent_str(cx, 1);
      if nmiss == 0 { cx.opool = copy(real); } else { cx.opool = crate::ent_path::join_segs(real, jn); }
      return Ok::<(), crate::ent_state::Halt>(());
    }
    let rp: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(cx.ent, 1), 33554432);
    // MUTANT M06: ENOENT also issues stat (the condition becomes true)
    if !crate::ent_value::str_eq_lit(cx.ent, rp + 16, "ENOENT") {
      crate::ent_state::stat(inout cx, current)?;
      ne = 2;
      if crate::ent_state::ent_r(cx, 0) == 0 {
        let dev: [i64] = ent_str(cx, 1);
        let ino: [i64] = ent_str(cx, 4);
        // proof bound only: a packet string is far shorter
        if len(dev) > 1073741823 || len(ino) > 1073741823 || len(raw) > 1073741823 { return crate::ent_state::stop_fail(inout cx); }
        let mut id: [i64] = alloc(0, 0);
        arr_reserve(inout id, len(dev) + len(ino) + len(raw) + 10);
        arr_push(inout id, 100, 101, 118, 58);
        arr_append(inout id, dev, 0, len(dev));
        arr_push(inout id, 58, 105, 110, 111, 58);
        arr_append(inout id, ino, 0, len(ino));
        if nmiss > 0 {
          arr_push(inout id, 47);
          arr_append(inout id, raw, 0, len(raw));
        }
        cx.opool = move id;
        return Ok::<(), crate::ent_state::Halt>(());
      }
    }
    let parent: [i64] = crate::ent_path::dirname(current);
    if crate::ent_u16::eq(parent, current) { return resolve_cwd(inout cx, path); }
    // this level failed and the climb moves on: its entries are dropped and counted (R3)
    if cmp && slot < 8 { crate::ent_state::drop_entries(inout cx, a0, slot, ne); }
    let base: [i64] = crate::ent_path::basename(current);
    if nmiss == 0 {
      raw = copy(base);
      jn = copy(base);
    } else {
      raw = slash_cat(base, raw);
      if len(base) > 0 {
        if len(jn) > 0 { jn = slash_cat(base, jn); } else { jn = copy(base); }
      }
    }
    nmiss = nmiss + 1;
    current = copy(parent);
    fuel = fuel - 1;
  }
  return crate::ent_state::stop_fail(inout cx);
}

// sameFile(left, right): both stat and the dev / ino strings are equal; any throw gives false
fn same_file(inout cx: crate::ent_state::Ctx, left: [i64], right: [i64]) -> Result<bool, crate::ent_state::Halt> ! alloc
{
  crate::ent_state::stat(inout cx, left)?;
  if crate::ent_state::ent_r(cx, 0) == 1 { return Ok::<bool, crate::ent_state::Halt>(false); }
  let dev1: [i64] = ent_str(cx, 1);
  let ino1: [i64] = ent_str(cx, 4);
  crate::ent_state::stat(inout cx, right)?;
  if crate::ent_state::ent_r(cx, 0) == 1 { return Ok::<bool, crate::ent_state::Halt>(false); }
  return Ok::<bool, crate::ent_state::Halt>(crate::ent_u16::eq(dev1, ent_str(cx, 1)) && crate::ent_u16::eq(ino1, ent_str(cx, 4)));
}

// hostCodexHome(): the ambient CODEX_HOME (trimmed) or join(homedir(), '.codex'); opool = the result
pub fn codex_home(inout cx: crate::ent_state::Ctx) -> Result<(), crate::ent_state::Halt> ! alloc
{
  crate::ent_state::ambient(inout cx)?;
  let t: [i64] = crate::ent_u16::trim(ent_str(cx, 1));
  if len(t) > 0 {
    cx.opool = copy(t);
    return Ok::<(), crate::ent_state::Halt>(());
  }
  return home_join(inout cx, ".codex");
}

// isHostCodexHome(home): every call asks the host again; nothing is cached
pub fn is_codex_home(inout cx: crate::ent_state::Ctx, home: [i64]) -> Result<bool, crate::ent_state::Halt> ! alloc
{
  canonical(inout cx, home)?;
  let target: [i64] = copy(cx.opool);
  codex_home(inout cx)?;
  let h0: [i64] = copy(cx.opool);
  canonical(inout cx, h0)?;
  let host: [i64] = copy(cx.opool);
  home_join(inout cx, ".codex")?;
  let d0: [i64] = copy(cx.opool);
  canonical(inout cx, d0)?;
  let dot: [i64] = copy(cx.opool);
  if crate::ent_u16::eq(target, host) { return Ok::<bool, crate::ent_state::Halt>(true); }
  // MUTANT M07: the comparison with dot (and the second sameFile below) is omitted
  if crate::ent_u16::eq(target, dot) { return Ok::<bool, crate::ent_state::Halt>(true); }
  codex_home(inout cx)?;
  let h1: [i64] = copy(cx.opool);
  if same_file(inout cx, home, h1)? { return Ok::<bool, crate::ent_state::Halt>(true); }
  // MUTANT M07: the second sameFile is omitted (returns false here)
  home_join(inout cx, ".codex")?;
  let d1: [i64] = copy(cx.opool);
  return same_file(inout cx, home, d1);
}

// ---- by-value adapters for ent_sources (row AD, removed in step 3.6) ----
// A caller checks early(cx) after each call: stalled, bad or done (a rethrown answer) means it returns the Ctx unchanged.

// AD (3.6)
pub fn early(cx: crate::ent_state::Ctx) -> bool
{
  return cx.stalled != 0 || cx.bad != 0 || cx.done != 0;
}

// AD (3.6)
pub fn with_pool(cx0: crate::ent_state::Ctx, s: [i64]) -> crate::ent_state::Ctx ! alloc
{
  let mut cx: crate::ent_state::Ctx = cx0;
  cx.opool = copy(s);
  return cx;
}

// AD (3.6)
pub fn throw_existing(cx0: crate::ent_state::Ctx) -> crate::ent_state::Ctx ! alloc
{
  let mut cx: crate::ent_state::Ctx = cx0;
  let h: crate::ent_state::Halt = rethrow_answer(inout cx);
  return cx;
}

// AD (3.6)
pub fn homedir_units(cx0: crate::ent_state::Ctx) -> crate::ent_state::Ctx ! alloc
{
  let mut cx: crate::ent_state::Ctx = cx0;
  let r: Result<(), crate::ent_state::Halt> = home_dir(inout cx);
  return cx;
}

// AD (3.6)
pub fn home_sub(cx0: crate::ent_state::Ctx, seg: str) -> crate::ent_state::Ctx ! alloc
{
  let mut cx: crate::ent_state::Ctx = cx0;
  let r: Result<(), crate::ent_state::Halt> = home_join(inout cx, seg);
  return cx;
}

// AD (3.6)
pub fn host_home(cx0: crate::ent_state::Ctx) -> crate::ent_state::Ctx ! alloc
{
  let mut cx: crate::ent_state::Ctx = cx0;
  let r: Result<(), crate::ent_state::Halt> = codex_home(inout cx);
  return cx;
}

// AD (3.6): ontab = the 0/1 result
pub fn is_host_codex_home(cx0: crate::ent_state::Ctx, home: [i64]) -> crate::ent_state::Ctx ! alloc
{
  let mut cx: crate::ent_state::Ctx = cx0;
  let r: Result<bool, crate::ent_state::Halt> = is_codex_home(inout cx, home);
  match r {
    Ok(b) => {
      cx.ontab = 0;
      if b { cx.ontab = 1; }
    }
    Err(h) => {}
  }
  return cx;
}

// ---- op 6 state check (state::state_ok covers only ops 3, 4, 8, 9) ----

// request code / aux of an await emitted for op 1 (codes 1..7) or op 6 (codes 3..7); aux is always 0
fn pair_ie(op: i64, code: i64, aux: i64) -> bool
{
  if aux != 0 { return false; }
  if op == 1 { return code >= 1 && code <= 7; }
  if op == 6 { return code >= 3 && code <= 7; }
  return false;
}

// the state of an op 1 / op 6 await is well-formed (hand: Option<State>; row OA, a struct with views is no Option payload)
pub fn state_ok_ie(st: [i64], op: i64, op_id: i64) -> bool ! alloc
{
  let n: i64 = len(st);
  if n < 14 || n > 16777216 { return false; }
  if st[0] != crate::ent_state::magic() || st[1] != op { return false; }
  if !pair_ie(op, st[2], st[3]) { return false; }
  let mut i: i64 = 4;
  while i < 12
    invariant 4 <= i && i <= 12 && n == len(st) && n >= 14
    decreases 12 - i
  {
    if st[i] < 0 || st[i] > 4294967296 { return false; }
    i = i + 1;
  }
  let l: i64 = st[12];
  let g: i64 = st[13];
  if l < 13 || g < 0 || l > n || g > n { return false; }
  if 14 + l + g != n { return false; }
  let s: crate::ent_state::State = crate::ent_state::state_view(st);
  let blob: ref [i64] = s.blob;
  if crate::ent_packet::env_check(blob) != 0 { return false; }
  if crate::ent_u16::rd(blob, 1) != 0 || crate::ent_u16::rd(blob, 3) != 0 { return false; }
  if crate::ent_u16::rd(blob, 5) != op || crate::ent_u16::rd(blob, 2) != op_id { return false; }
  let hi: i64 = crate::ent_accounts::io_check(blob);
  if hi < 0 || hi != crate::ent_value::pool_bytes(blob, crate::ent_packet::sec_start(blob, 0)) { return false; }
  return crate::ent_state::log_ok(s.log, op_id);
}

// ---- op 6: codexAccountFolder(dataDir, { id, home }) ----
fn folder_item(inout cx: crate::ent_state::Ctx) -> Result<(), crate::ent_state::Halt> ! alloc
{
  let r0: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(cx.blob, 1), 33554432);
  if !crate::ent_accounts::valid_account_id(cx.blob, r0 + 3) {
    wire_done(inout cx, 0);
    return Ok::<(), crate::ent_state::Halt>(());
  }
  let expected: [i64] = crate::ent_accounts::account_home(crate::ent_value::str_units(cx.blob, r0), crate::ent_u16::lit("codex"), crate::ent_value::str_units(cx.blob, r0 + 3));
  if crate::ent_value::tag_at(cx.blob, r0 + 6) != 6 || !crate::ent_u16::eq(crate::ent_value::str_units(cx.blob, r0 + 6), expected) {
    plain_done(inout cx);
    return Ok::<(), crate::ent_state::Halt>(());
  }
  if is_codex_home(inout cx, expected)? {
    wire_done(inout cx, 1);
    return Ok::<(), crate::ent_state::Halt>(());
  }
  let mut rec: [i64] = crate::ent_u16::zeros(4);
  crate::ent_u16::wr(inout rec, 0, 0);
  let mut pool: [i64] = crate::ent_value::pool_new();
  crate::ent_value::pool_put(inout pool, inout rec, 1, expected);
  let e: ref [i64] = [];
  crate::ent_state::put_done(inout cx, pool, rec, e, 0);
  return Ok::<(), crate::ent_state::Halt>(());
}

pub fn codex_folder_begin(input: [i64]) -> [i64] ! alloc
{
  let id: i64 = crate::ent_u16::rd(input, 2);
  let hi: i64 = crate::ent_accounts::io_check(input);
  if hi < 0 { return crate::ent_packet::boundary(6, id, 0); }
  let blob: [i64] = crate::ent_state::repack(input, hi);
  let mut cx: crate::ent_state::Ctx = crate::ent_state::ctx_new(6, id, blob, crate::ent_u16::empty(), crate::ent_u16::zeros(8));
  let r: Result<(), crate::ent_state::Halt> = folder_item(inout cx);
  return crate::ent_state::finish(cx, 1, 0);
}

pub fn codex_folder_step(prev: [i64], completion: [i64]) -> [i64] ! alloc
{
  let id: i64 = crate::ent_u16::rd(prev, 2);
  let seq: i64 = crate::ent_u16::rd(prev, 3);
  if seq < 0 || seq >= 9007199254740992 { return crate::ent_packet::boundary(6, id, 0); }
  let s2: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(prev, 2), 33554432);
  let s3: i64 = crate::ent_u16::clamp(s2 + crate::ent_u16::clamp(crate::ent_packet::sec_len(prev, 2), 16777216), len(prev));
  let st: ref [i64] = subview(prev, crate::ent_u16::clamp(s2, s3), s3);
  if !state_ok_ie(st, 6, id) { return crate::ent_packet::boundary(6, id, 0); }
  if !crate::ent_state::st_replay_ok(st, 6, seq) { return crate::ent_packet::boundary(6, id, 0); }
  let s: crate::ent_state::State = crate::ent_state::state_view(st);
  let hi: i64 = crate::ent_packet::comp_check(completion, s.code, s.aux);
  if hi < 0 { return crate::ent_packet::boundary(6, id, 0); }
  let lg: [i64] = crate::ent_state::log_append(s.log, s.code, s.aux, completion, hi);
  if crate::ent_state::log_words(lg) > 16777216 { return crate::ent_packet::boundary(6, id, 1); }
  let mut cx: crate::ent_state::Ctx = crate::ent_state::ctx_new(6, id, s.blob, lg, s.ck);
  crate::ent_state::use_prev(inout cx, prev, true);
  let r: Result<(), crate::ent_state::Halt> = folder_item(inout cx);
  return crate::ent_state::finish(cx, seq + 1, seq);
}
