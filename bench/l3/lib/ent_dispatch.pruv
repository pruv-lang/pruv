// L3-8 entry: ops 2 find_source, 3 list_external, 4 read_external and the rethrow classification.
// Each item is a replay step over the shared context: `inout cx: Ctx`, and an observation that stalls or breaks the replay
// returns through `?` (see ent_state.pruv for the observation API; hand shape: bench/l3/lib/hand/ent_dispatch.rs).
// find_item, list_item and read_item are by-value adapters for entry_api::run_item (RESHAPE.md row AD).

// ---- op 2: first row whose source strictly equals the query ----
pub fn find_source(inout cx: crate::ent_state::Ctx) -> () ! alloc
{
  let r0: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(cx.blob, 1), 33554432);
  let sec: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(cx.blob, r0 + 4), 8);
  let cnt: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(cx.blob, r0 + 5), 16777216);
  let base: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(cx.blob, sec), 33554432);
  let mut found: i64 = 0 - 1;
  let mut i: i64 = 0;
  while i < cnt
    invariant 0 <= i && i <= cnt && cnt <= 16777216 && 0 <= base && base <= 33554432 && 0 - 1 <= found && found < i
    decreases cnt - i
  {
    if crate::ent_value::strict_eq(cx.blob, r0, cx.blob, base + 3 * i) {
      // MUTANT M08: if found < 0 { found = i; } becomes found = i; (the last match wins)
      if found < 0 { found = i; }
    }
    i = i + 1;
  }
  let mut rec: [i64] = crate::ent_u16::zeros(4);
  crate::ent_u16::wr(inout rec, 0, 0);
  if found >= 0 { crate::ent_packet::put_vs(inout rec, 1, 4, found, 0); }
  let e: ref [i64] = [];
  crate::ent_state::put_done(inout cx, e, rec, e, 0);
}

pub fn find_item(cx0: crate::ent_state::Ctx) -> crate::ent_state::Ctx ! alloc
{
  let mut cx: crate::ent_state::Ctx = cx0;
  find_source(inout cx);
  return cx;
}

// ---- route ----
// 0 claude, 1 codex, 2 opencode, 3 qwen, else grok (4); the check order is fixed
pub fn route(w: [i64], p: i64) -> i64 ! alloc
  ensures 0 <= result && result <= 4
{
  if crate::ent_value::str_eq_lit(w, p, "claude") { return 0; }
  if crate::ent_value::str_eq_lit(w, p, "codex") { return 1; }
  if crate::ent_value::str_eq_lit(w, p, "opencode") { return 2; }
  if crate::ent_value::str_eq_lit(w, p, "qwen") { return 3; }
  // MUTANT M09: return 4; becomes return 1; (an unknown engine routes to codex)
  return 4;
}

// invoke_engine request record: [9, route, opKind, source, folder, thread, options]; list has no thread (tag 10)
fn invoke(blob: [i64], read: bool) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let r0: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(blob, 1), 33554432);
  let mut o: [i64] = crate::ent_u16::zeros(15);
  crate::ent_u16::wr(inout o, 0, 9);
  crate::ent_u16::wr(inout o, 1, route(blob, r0));
  let a: i64 = crate::ent_u16::put_range(inout o, 3, blob, r0 + 3, 3);
  let b: i64 = crate::ent_u16::put_range(inout o, 6, blob, r0 + 6, 3);
  if read {
    crate::ent_u16::wr(inout o, 2, 1);
    let c: i64 = crate::ent_u16::put_range(inout o, 9, blob, r0 + 9, 3);
    let d: i64 = crate::ent_u16::put_range(inout o, 12, blob, r0 + 12, 3);
  } else {
    crate::ent_packet::put_vs(inout o, 9, 10, 0, 0);
    let d: i64 = crate::ent_u16::put_range(inout o, 12, blob, r0 + 9, 3);
  }
  return o;
}

// ---- rethrow: classification of the thrown value (E at record offset 1 of a throw answer) ----
pub fn rethrow(inout cx: crate::ent_state::Ctx) -> () ! alloc
{
  let rp: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(cx.ent, 1), 33554432);
  let is_eie: bool = crate::ent_value::tag_at(cx.ent, rp + 4) == 3;
  let is_err: bool = crate::ent_value::tag_at(cx.ent, rp + 7) == 3;
  // MUTANT M11: AbortError passes through on name === 'AbortError' only; the mutant also requires is_err
  let is_abort: bool = crate::ent_value::str_eq_lit(cx.ent, rp + 10, "AbortError");
  let e: ref [i64] = [];
  if is_eie || is_abort {
    let mut rec: [i64] = crate::ent_u16::zeros(4);
    crate::ent_u16::wr(inout rec, 0, 1);
    let a: i64 = crate::ent_u16::put_range(inout rec, 1, cx.ent, rp + 1, 3);
    crate::ent_state::put_done(inout cx, e, rec, e, 0);
    return;
  }
  // MUTANT M12: has_detail is true (a non-Error detail is the stringified value "undefined")
  let has_detail: bool = is_err;
  let mut pool: [i64] = crate::ent_value::pool_new();
  let mut rec: [i64] = crate::ent_u16::zeros(10);
  crate::ent_u16::wr(inout rec, 0, 2);
  crate::ent_value::pool_put_lit(inout pool, inout rec, 1, "read-failed");
  if has_detail {
    if is_err {
      crate::ent_value::pool_put(inout pool, inout rec, 4, crate::ent_value::str_units(cx.ent, rp + 13));
    } else {
      crate::ent_value::pool_put_lit(inout pool, inout rec, 4, "undefined");
    }
  } else {
    crate::ent_packet::put_vs(inout rec, 4, 0, 0, 0);
  }
  let c: i64 = crate::ent_u16::put_range(inout rec, 7, cx.ent, rp + 1, 3);
  crate::ent_state::put_done(inout cx, pool, rec, e, 0);
}

// ---- op 3: list_external ----
fn list_recipe(inout cx: crate::ent_state::Ctx) -> Result<(), crate::ent_state::Halt> ! alloc
{
  let rp: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(cx.ent, 1), 33554432);
  let sec: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(cx.ent, rp + 2), 8);
  let cnt: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(cx.ent, rp + 3), 16777216);
  if cnt > 2396745 || 16 + 7 * cnt > 16777216 { return crate::ent_state::stop_too_big(inout cx); }
  let base: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(cx.ent, sec), 33554432);
  let ps: i64 = crate::ent_packet::sec_start(cx.ent, 0);
  let cut: i64 = 200;
  let mut tab: [i64] = alloc(7 * cnt, 0);
  let mut copies: i64 = 0;
  let mut i: i64 = 0;
  while i < cnt
    invariant 0 <= i && i <= cnt && cnt <= 2396745 && 0 <= copies && copies <= i && 0 <= base && base <= 33554432 && len(tab) == 7 * cnt
    decreases cnt - i
  {
    let clip: i64 = crate::ent_value::title_cut(cx.ent, ps, base + 6 * i + 3, cut);
    if clip != 0 {
      tab[7 * i + 4] = clip;
      copies = copies + 1;
    }
    i = i + 1;
  }
  if copies > 83886 || 16 + 7 * cnt + 200 * copies > 16777216 { return crate::ent_state::stop_too_big(inout cx); }
  let nu: i64 = crate::ent_value::logical_pool_words(cx.ent);
  let reuse: bool = copies > 0 && 16 + 7 * cnt + nu + 201 * copies <= 16777216;
  let mut nb: i64 = 0;
  if reuse { nb = crate::ent_value::pool_bytes(cx.ent, ps); }
  let cap: i64 = crate::ent_u16::clamp(nb + 601 * copies, 1073741823);
  let mut pool: [i64] = alloc(crate::ent_value::pool_capacity(cap), 0);
  if reuse {
    // DB22 (D-DB18-3 P1): the retained source pool is copied by whole words, not byte by byte (same header and bytes
    // as an append into the empty pool: nb bytes, clamp(nu, nb) units, cleared padding).
    crate::ent_value::copy_pool_prefix(inout pool, 0, cx.ent, ps, nb, crate::ent_u16::clamp(nu, nb));
  }
  let mut j: i64 = 0;
  while j < cnt
    invariant 0 <= j && j <= cnt && cnt <= 2396745 && copies <= 83886 && 0 <= base && base <= 33554432 && len(tab) == 7 * cnt
    decreases cnt - j
  {
    let rb: i64 = base + 6 * j;
    let tb: i64 = 7 * j;
    let a: i64 = crate::ent_u16::put_range(inout tab, tb + 1, cx.ent, rb, 3);
    let clip: i64 = tab[tb + 4];
    if clip != 0 {
      crate::ent_u16::wr(inout tab, tb, 1);
      // MUTANT M10: the cut backs off a trailing high surrogate.
      crate::ent_value::put_title_prefix(inout pool, inout tab, tb + 4, cx.ent, rb + 3, clip, cut, reuse);
    } else {
      crate::ent_u16::wr(inout tab, tb, 0);
    }
    j = j + 1;
  }
  let mut rec: [i64] = crate::ent_u16::zeros(4);
  crate::ent_u16::wr(inout rec, 0, 0);
  crate::ent_packet::put_vs(inout rec, 1, 7, 4, cnt);
  let out: [i64] = crate::ent_value::pool_finish(pool, 0);
  crate::ent_state::put_done(inout cx, out, rec, tab, 1);
  return Ok::<(), crate::ent_state::Halt>(());
}

pub fn list_external(inout cx: crate::ent_state::Ctx) -> Result<(), crate::ent_state::Halt> ! alloc
{
  let rq: [i64] = invoke(cx.blob, false);
  let pool: [i64] = copy(crate::ent_value::blob_pool(cx.blob));
  let e: ref [i64] = [];
  crate::ent_state::observe(inout cx, 9, 0, pool, rq, e, 0)?;
  if crate::ent_state::ent_r(cx, 0) == 1 {
    rethrow(inout cx);
    return Ok::<(), crate::ent_state::Halt>(());
  }
  return list_recipe(inout cx);
}

pub fn list_item(cx0: crate::ent_state::Ctx) -> crate::ent_state::Ctx ! alloc
{
  let mut cx: crate::ent_state::Ctx = cx0;
  let r: Result<(), crate::ent_state::Halt> = list_external(inout cx);
  return cx;
}

// ---- op 4: read_external ----
pub fn read_external(inout cx: crate::ent_state::Ctx) -> Result<(), crate::ent_state::Halt> ! alloc
{
  let rq: [i64] = invoke(cx.blob, true);
  let pool: [i64] = copy(crate::ent_value::blob_pool(cx.blob));
  let e: ref [i64] = [];
  crate::ent_state::observe(inout cx, 9, 1, pool, rq, e, 0)?;
  if crate::ent_state::ent_r(cx, 0) == 1 {
    rethrow(inout cx);
    return Ok::<(), crate::ent_state::Halt>(());
  }
  let mut rec: [i64] = crate::ent_u16::zeros(4);
  crate::ent_u16::wr(inout rec, 0, 0);
  let rp: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(cx.ent, 1), 33554432);
  let a: i64 = crate::ent_u16::put_range(inout rec, 1, cx.ent, rp + 1, 3);
  crate::ent_state::put_done(inout cx, e, rec, e, 0);
  return Ok::<(), crate::ent_state::Halt>(());
}

pub fn read_item(cx0: crate::ent_state::Ctx) -> crate::ent_state::Ctx ! alloc
{
  let mut cx: crate::ent_state::Ctx = cx0;
  let r: Result<(), crate::ent_state::Halt> = read_external(inout cx);
  return cx;
}
