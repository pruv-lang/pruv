// L3-8 entry: op 1 import_sources (reference/backend-engine-import.ts importSources). Hand baseline: hand/ent_sources.rs.
//
// The work is a chain of items (ck0 phase 0..9, ck1 account index, ck2 account count). An item re-runs from scratch against
// the log of its own answers (see ent_state.pruv); every item takes the replay context `inout cx: Ctx` and the rows of this
// step `inout rows: Rows` and returns Result<(), Halt>: Ok means the item is complete (its row, if any, is in rows, ck names
// the next item), Err stops the step (a stall, a protocol error, or Done: the import result is set). A completed item is
// followed by the next one in the same Ctx (next_item: the log is dropped). Rows are appended straight to one pool; their
// string offsets are placed after the request / output pool once, when the packet is built. Cost of a step = O(input blob +
// current item log + request + rows completed in this step).
// A string result (homedir, codex home) stays in cx.opool with Result<(), Halt> (hand Rust: Result<Vec<u16>, Halt>; row RA).

// The rows completed in this step: one pool and the 18-word records.
struct Rows { pool: [i64], rec: [i64] }

// The account name: a string or any other value slot (tag, a, b).
enum Name { Str(units: [i64]), Raw(tag: i64, a: i64, b: i64) }

struct Account { id: [i64], name: Name }

// The item is complete: ck names the next one (the climb words ck3..7 belong to one item and start cleared).
fn advance(inout cx: crate::ent_state::Ctx, ph: i64, idx: i64, cnt: i64) -> ()
{
  crate::ent_state::put_ck(inout cx, 0, ph);
  crate::ent_state::put_ck(inout cx, 1, idx);
  crate::ent_state::put_ck(inout cx, 2, cnt);
  for i in 3..8 {
    crate::ent_state::put_ck(inout cx, i, 0);
  }
}

// ck word i as a loop bound
fn ck_word(cx: crate::ent_state::Ctx, i: i64) -> i64
  ensures 0 <= result && result <= 16777216
{
  return crate::ent_u16::clamp(crate::ent_state::get_ck(cx, i), 16777216);
}

fn rec0(cx: crate::ent_state::Ctx) -> i64
  ensures 0 <= result && result <= 33554432
{
  return crate::ent_u16::clamp(crate::ent_packet::sec_start(cx.blob, 1), 33554432);
}

// trimmed env slot (empty for a non-string slot); slot k is at record offset 3k
fn env_trim(cx: crate::ent_state::Ctx, k: i64) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let p: i64 = rec0(cx) + 3 * crate::ent_u16::clamp(k, 16);
  if crate::ent_value::tag_at(cx.blob, p) == 6 { return crate::ent_u16::trim(crate::ent_value::str_units(cx.blob, p)); }
  return crate::ent_u16::empty();
}

// the start of a row: source | engine | kind
fn row_head(inout rows: Rows, inout rec: [i64], src: [i64], eng: str, kind: str) -> () ! alloc
{
  crate::ent_value::pool_put(inout rows.pool, inout rec, 0, src);
  crate::ent_value::pool_put(inout rows.pool, inout rec, 3, crate::ent_u16::lit(eng));
  crate::ent_value::pool_put(inout rows.pool, inout rec, 6, crate::ent_u16::lit(kind));
}

// rows.rec ++ rec (the bound is the array limit of arr_append, far above any packet; row LB)
fn push_row(inout rows: Rows, rec: [i64]) -> () ! alloc
{
  if len(rows.rec) > 1099511627776 - len(rec) { return; }
  arr_append(inout rows.rec, rec, 0, len(rec));
}

// a home row: no account and no name
fn home_row(inout rows: Rows, src: str, eng: str, home: [i64]) -> () ! alloc
{
  let mut rec: [i64] = alloc(18, 0);
  row_head(inout rows, inout rec, crate::ent_u16::lit(src), eng, "home");
  crate::ent_packet::put_vs(inout rec, 9, 10, 0, 0);
  crate::ent_packet::put_vs(inout rec, 12, 10, 0, 0);
  crate::ent_value::pool_put(inout rows.pool, inout rec, 15, home);
  push_row(inout rows, rec);
}

fn account_row(inout rows: Rows, src: [i64], eng: str, a: Account, home: [i64]) -> () ! alloc
{
  let mut rec: [i64] = alloc(18, 0);
  row_head(inout rows, inout rec, src, eng, "account");
  crate::ent_value::pool_put(inout rows.pool, inout rec, 9, a.id);
  match a.name {
    Name::Str(u) => { crate::ent_value::pool_put(inout rows.pool, inout rec, 12, u); }
    Name::Raw(t, x, y) => { crate::ent_packet::put_vs(inout rec, 12, t, x, y); }
  }
  crate::ent_value::pool_put(inout rows.pool, inout rec, 15, home);
  push_row(inout rows, rec);
}

// trimmed env slot, else join(homedir(), seg); opool = the result
fn env_or_home(inout cx: crate::ent_state::Ctx, slot: i64, seg: str) -> Result<(), crate::ent_state::Halt> ! alloc
{
  let t: [i64] = env_trim(cx, slot);
  if len(t) > 0 {
    cx.opool = move t;
    return Ok::<(), crate::ent_state::Halt>(());
  }
  return crate::ent_canon::home_join(inout cx, seg);
}

fn home_item(inout cx: crate::ent_state::Ctx, inout rows: Rows, slot: i64, seg: str, src: str, eng: str, next: i64) -> Result<(), crate::ent_state::Halt> ! alloc
{
  env_or_home(inout cx, slot, seg)?;
  home_row(inout rows, src, eng, cx.opool);
  advance(inout cx, next, 0, 0);
  return Ok::<(), crate::ent_state::Halt>(());
}

// accounts(eng): the count goes to the next phase; a throw is rethrown
fn accounts_item(inout cx: crate::ent_state::Ctx, eng: i64, next: i64) -> Result<(), crate::ent_state::Halt> ! alloc
{
  crate::ent_state::accounts(inout cx, eng)?;
  if crate::ent_state::ent_r(cx, 0) == 1 {
    let h: crate::ent_state::Halt = crate::ent_canon::rethrow_answer(inout cx);
    return Err::<(), crate::ent_state::Halt>(h);
  }
  let cnt: i64 = crate::ent_u16::clamp(crate::ent_state::ent_r(cx, 1), 16777216);
  advance(inout cx, next, 0, cnt);
  return Ok::<(), crate::ent_state::Halt>(());
}

// the account row of the last account_at answer: a nullish row or an invalid id is skipped
fn account_ok(cx: crate::ent_state::Ctx) -> bool ! alloc
{
  return crate::ent_state::ent_r(cx, 1) != 0
    && crate::ent_accounts::valid_account_id(cx.ent, crate::ent_u16::clamp(crate::ent_packet::sec_start(cx.ent, 1), 33554432) + 2);
}

// id and name of the last account_at answer
fn account_of(cx: crate::ent_state::Ctx) -> Account ! alloc
{
  let rp: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(cx.ent, 1), 33554432);
  let id: [i64] = crate::ent_value::str_units(cx.ent, rp + 2);
  if crate::ent_value::tag_at(cx.ent, rp + 5) == 6 {
    return Account { id: move id, name: Name::Str(crate::ent_value::str_units(cx.ent, rp + 5)) };
  }
  return Account { id: move id, name: Name::Raw(crate::ent_value::tag_at(cx.ent, rp + 5), crate::ent_u16::rd(cx.ent, rp + 6), crate::ent_u16::rd(cx.ent, rp + 7)) };
}

// ---- Claude accounts: one account_at per item ----
fn claude_acct(inout cx: crate::ent_state::Ctx, inout rows: Rows) -> Result<(), crate::ent_state::Halt> ! alloc
{
  let idx: i64 = ck_word(cx, 1);
  let cnt: i64 = ck_word(cx, 2);
  if idx >= cnt {
    advance(inout cx, 3, 0, 0);
    return Ok::<(), crate::ent_state::Halt>(());
  }
  crate::ent_state::account_at(inout cx, 0, idx)?;
  // MUTANT M05: an invalid id (or nullish row) aborts the import (throws) instead of being skipped
  if !account_ok(cx) { advance(inout cx, 2, idx + 1, cnt); return Ok::<(), crate::ent_state::Halt>(()); }
  let a: Account = account_of(cx);
  let home: [i64] = crate::ent_accounts::account_home(crate::ent_value::str_units(cx.blob, rec0(cx)), crate::ent_u16::lit("claude"), a.id);
  account_row(inout rows, crate::ent_u16::cat(crate::ent_u16::lit("claude:"), a.id), "claude", a, home);
  advance(inout cx, 2, idx + 1, cnt);
  return Ok::<(), crate::ent_state::Halt>(());
}

// ---- Codex accounts: the body (codexAccountFolder) may observe several times; any throw in it skips the account ----
fn codex_acct(inout cx: crate::ent_state::Ctx, inout rows: Rows) -> Result<(), crate::ent_state::Halt> ! alloc
{
  let idx: i64 = ck_word(cx, 1);
  let cnt: i64 = ck_word(cx, 2);
  if idx >= cnt {
    advance(inout cx, 6, 0, 0);
    return Ok::<(), crate::ent_state::Halt>(());
  }
  crate::ent_state::account_at(inout cx, 1, idx)?;
  if !account_ok(cx) { advance(inout cx, 5, idx + 1, cnt); return Ok::<(), crate::ent_state::Halt>(()); }
  // everything needed from the account_at answer is taken before the body observes again
  let a: Account = account_of(cx);
  let expected: [i64] = crate::ent_accounts::account_home(crate::ent_value::str_units(cx.blob, rec0(cx)), crate::ent_u16::lit("codex"), a.id);
  let r: Result<bool, crate::ent_state::Halt> = crate::ent_canon::is_codex_home(inout cx, expected);
  match r {
    Ok(host) => {
      if host { advance(inout cx, 5, idx + 1, cnt); return Ok::<(), crate::ent_state::Halt>(()); }
    }
    Err(h) => {
      // a throw in the body (rethrown as a result that this item drops) skips the account
      match h {
        crate::ent_state::Halt::Done => { advance(inout cx, 5, idx + 1, cnt); return Ok::<(), crate::ent_state::Halt>(()); }
        crate::ent_state::Halt::Stalled => { return Err::<(), crate::ent_state::Halt>(crate::ent_state::Halt::Stalled); }
        crate::ent_state::Halt::Bad => { return Err::<(), crate::ent_state::Halt>(crate::ent_state::Halt::Bad); }
      }
    }
  }
  // MUTANT M04: a Codex row whose id equals the previously emitted Codex id is skipped (deduplicated; id hash in ck6)
  account_row(inout rows, crate::ent_u16::cat(crate::ent_u16::lit("codex:"), a.id), "codex", a, expected);
  advance(inout cx, 5, idx + 1, cnt);
  return Ok::<(), crate::ent_state::Halt>(());
}

// ---- Codex home: hostCodexHome() reads the AMBIENT CODEX_HOME ----
fn codex_home_item(inout cx: crate::ent_state::Ctx, inout rows: Rows) -> Result<(), crate::ent_state::Halt> ! alloc
{
  // MUTANT M02: reads the input env slot CODEX_HOME (record offset 18) instead of the ambient request
  crate::ent_canon::codex_home(inout cx)?;
  home_row(inout rows, "codex:home", "codex", cx.opool);
  advance(inout cx, 4, 0, 0);
  return Ok::<(), crate::ent_state::Halt>(());
}

fn opencode_item(inout cx: crate::ent_state::Ctx, inout rows: Rows) -> Result<(), crate::ent_state::Halt> ! alloc
{
  let xdg: [i64] = env_trim(cx, 3);
  // MUTANT M03: the starts-with '/' check is dropped (a relative XDG_DATA_HOME is used)
  if len(xdg) > 0 && crate::ent_u16::rd(xdg, 0) == 47 {
    home_row(inout rows, "opencode:home", "opencode", crate::ent_path::join2(xdg, crate::ent_u16::lit("opencode")));
  } else {
    crate::ent_canon::home_dir(inout cx)?;
    home_row(inout rows, "opencode:home", "opencode", crate::ent_path::join4(cx.opool, crate::ent_u16::lit(".local"), crate::ent_u16::lit("share"), crate::ent_u16::lit("opencode")));
  }
  advance(inout cx, 8, 0, 0);
  return Ok::<(), crate::ent_state::Halt>(());
}

// Qwen: homedir() is evaluated first (eager argument), even when QWEN_RUNTIME_DIR is set
fn qwen_item(inout cx: crate::ent_state::Ctx, inout rows: Rows) -> Result<(), crate::ent_state::Halt> ! alloc
{
  crate::ent_canon::home_dir(inout cx)?;
  let rt: [i64] = env_trim(cx, 4);
  let qh: [i64] = env_trim(cx, 5);
  if len(rt) > 0 {
    home_row(inout rows, "qwen:home", "qwen", rt);
  } else if len(qh) > 0 {
    home_row(inout rows, "qwen:home", "qwen", qh);
  } else {
    home_row(inout rows, "qwen:home", "qwen", crate::ent_path::join2(cx.opool, crate::ent_u16::lit(".qwen")));
  }
  advance(inout cx, 9, 0, 0);
  return Ok::<(), crate::ent_state::Halt>(());
}

fn phase_item(inout cx: crate::ent_state::Ctx, inout rows: Rows) -> Result<(), crate::ent_state::Halt> ! alloc
{
  let ph: i64 = crate::ent_state::get_ck(cx, 0);
  if ph == 0 { return home_item(inout cx, inout rows, 1, ".claude", "claude:home", "claude", 1); }
  if ph == 1 { return accounts_item(inout cx, 0, 2); }
  if ph == 2 { return claude_acct(inout cx, inout rows); }
  if ph == 3 { return codex_home_item(inout cx, inout rows); }
  if ph == 4 { return accounts_item(inout cx, 1, 5); }
  if ph == 5 { return codex_acct(inout cx, inout rows); }
  if ph == 6 { return home_item(inout cx, inout rows, 2, ".grok", "grok:home", "grok", 7); }
  if ph == 7 { return opencode_item(inout cx, inout rows); }
  if ph == 8 { return qwen_item(inout cx, inout rows); }
  if ph == 9 {
    let e: ref [i64] = [];
    crate::ent_state::put_done(inout cx, e, [0], e, 0);
    return Err::<(), crate::ent_state::Halt>(crate::ent_state::Halt::Done);
  }
  return crate::ent_state::stop_fail(inout cx);
}

// add to the pool offset of every string slot of the rows (3-word slots)
fn rebase(inout rec: [i64], add: i64) -> ()
  ensures len(rec) == len(old(rec))
{
  let n: i64 = len(rec);
  let a: i64 = crate::ent_u16::clamp(add, 1073741824);
  let mut i: i64 = 0;
  while i + 2 < n
    invariant 0 <= i && i <= n && n == len(rec) && 0 <= a && a <= 1073741824
    decreases n - i
  {
    if crate::ent_u16::rd(rec, i) == 6 {
      let nv: i64 = crate::ent_u16::clamp(crate::ent_u16::rd(rec, i + 1), 1073741824) + a;
      crate::ent_u16::wr(inout rec, i + 1, nv);
    }
    i = i + 3;
  }
}

// front ++ the rows' pool; the row records are rebased to their place in it
fn place_rows(front: [i64], inout rows: Rows) -> [i64] ! alloc
{
  rebase(inout rows.rec, crate::ent_value::pool_base(front, rows.pool));
  return crate::ent_value::pool_cat(front, rows.pool);
}

// s0 = the seq of the first request of the current item (R1: the await state keeps it in ck0 as phase + 16 * s0, so that the
// continuity of start seq + dropped entries + kept log + current request can be checked). An item that completes in this step
// is followed by one whose first request is the one this step emits (aseq).
fn drive(inout cx: crate::ent_state::Ctx, aseq: i64, dseq: i64, s00: i64) -> [i64] ! alloc
{
  let mut s0: i64 = s00;
  let mut rows: Rows = Rows { pool: crate::ent_value::pool_new(), rec: alloc(0, 0) };
  for iter in 0..64 {
    let r: Result<(), crate::ent_state::Halt> = phase_item(inout cx, inout rows);
    // R1(c): an item that ends without a stall or a fault has consumed the whole log
    if cx.stalled == 0 && cx.bad == 0 && crate::ent_u16::clamp(cx.pos, 4294967296) != len(cx.lg) {
      let f: Result<(), crate::ent_state::Halt> = crate::ent_state::stop_fail(inout cx);
      break;
    }
    let Ok(()) = r else { break; };
    crate::ent_state::next_item(inout cx);
    s0 = aseq;
  }
  if cx.bad == 2 { return crate::ent_packet::boundary(1, cx.op_id, 1); }
  if cx.bad != 0 { return crate::ent_packet::boundary(1, cx.op_id, 0); }
  if cx.stalled != 0 {
    if aseq >= 268435456 || s0 >= 268435456 { return crate::ent_packet::boundary(1, cx.op_id, 1); }
    let ck0: i64 = crate::ent_u16::clamp(crate::ent_state::get_ck(cx, 0), 15) + 16 * crate::ent_u16::clamp(s0, 268435455);
    crate::ent_state::put_ck(inout cx, 0, ck0);
    let pool: [i64] = place_rows(cx.rpool, inout rows);
    return crate::ent_state::replay_await(cx, aseq, pool, rows.rec);
  }
  if cx.done != 0 {
    let pool: [i64] = place_rows(cx.opool, inout rows);
    let e: ref [i64] = [];
    return crate::ent_packet::mk_packet(3, cx.op_id, dseq, 1, pool, cx.orec, e, rows.rec, cx.otab, cx.ontab);
  }
  return crate::ent_packet::boundary(1, cx.op_id, 2);
}

pub fn import_begin(input: [i64]) -> [i64] ! alloc
{
  let id: i64 = crate::ent_u16::rd(input, 2);
  let hi: i64 = crate::ent_accounts::io_check(input);
  if hi < 0 { return crate::ent_packet::boundary(1, id, 0); }
  let blob: [i64] = crate::ent_state::repack(input, hi);
  let lg: [i64] = crate::ent_u16::empty();
  let mut cx: crate::ent_state::Ctx = crate::ent_state::ctx_new(1, id, move blob, move lg, crate::ent_u16::empty());
  return drive(inout cx, 1, 0, 1);
}

pub fn import_step(prev: [i64], completion: [i64]) -> [i64] ! alloc
{
  let id: i64 = crate::ent_u16::rd(prev, 2);
  let seq: i64 = crate::ent_u16::rd(prev, 3);
  if seq < 0 || seq >= 9007199254740992 { return crate::ent_packet::boundary(1, id, 0); }
  let s2: i64 = crate::ent_u16::clamp(crate::ent_packet::sec_start(prev, 2), 33554432);
  let s3: i64 = crate::ent_u16::clamp(s2 + crate::ent_u16::clamp(crate::ent_packet::sec_len(prev, 2), 16777216), len(prev));
  let st: ref [i64] = subview(prev, crate::ent_u16::clamp(s2, s3), s3);
  let s: crate::ent_state::State = crate::ent_state::state_view(st);
  if !crate::ent_canon::state_ok_ie(st, s, 1, id) || !crate::ent_state::replay_ok(s, 1, seq) { return crate::ent_packet::boundary(1, id, 0); }
  let hi: i64 = crate::ent_packet::comp_check(completion, s.code, s.aux);
  if hi < 0 { return crate::ent_packet::boundary(1, id, 0); }
  let lg: [i64] = crate::ent_state::log_append(s.log, s.code, s.aux, completion, hi);
  if crate::ent_state::log_words(lg) > 16777216 { return crate::ent_packet::boundary(1, id, 1); }
  let blob: [i64] = copy(s.blob);
  let mut cx: crate::ent_state::Ctx = crate::ent_state::ctx_new(1, id, move blob, move lg, crate::ent_state::set_ck_arr0(s.ck));
  crate::ent_state::use_prev(inout cx, prev, false);
  return drive(inout cx, seq + 1, seq, crate::ent_state::st_s0(1, s.ck));
}
