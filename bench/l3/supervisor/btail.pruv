// R10 C: byte tail. Two WHATWG UTF-8 decoders (one per stream) feed one buffer of valid UTF-8 bytes; the UTF-16
// length of the buffer is cached, so no code point is widened to UTF-16 units (G4).
//
// State (DB9): `Tail` holds the counters `acc` (T, bytes in buf, UTF-16 units of the bytes in buf) and one `Dec` per
// stream (needed, seen, cp, lower, upper). buf has 6T+4 slots and holds at most 6T bytes between calls. Because
// len(buf) never changes, `len(buf) == 6 * acc.t + 4` in every ensures also pins acc.t to its entry value.
// When an appended code point takes the units past 2T (or the bytes past 6T), whole code points leave the front
// until at most T units and 3T bytes remain. The output is the longest suffix of whole code points with at most
// T units: the TS tail (last T units, a cut low surrogate dropped, policy P5), since a suffix of at most T units
// only ever loses its front when more text arrives.

pub struct Dec { need: i64, seen: i64, cp: i64, lo: i64, hi: i64 }
pub struct Acc { t: i64, n: i64, u: i64 }
pub struct Tail { acc: Acc, d1: Dec, d2: Dec }

pub fn tail_state(t: i64) -> Tail
  requires 1 <= t && t <= 65536
  ensures result.acc.t == t && result.acc.n == 0 && result.acc.u == 0
{
  let d: Dec = Dec { need: 0, seen: 0, cp: 0, lo: 128, hi: 191 };
  return Tail { acc: Acc { t: t, n: 0, u: 0 }, d1: d, d2: d };
}

pub fn tail_buf(t: i64) -> [u8] ! alloc
  requires 1 <= t && t <= 65536
  ensures len(result) == 6 * t + 4
{
  let b: [u8] = alloc(6 * t + 4, 0);
  return b;
}

// Start of the longest front-trimmed rest of buf[0..n] with at most T units and 3T bytes; u becomes the units of
// the rest. The width of a code point comes from its lead byte (buf holds valid UTF-8); the last step is clamped.
fn drop_front(buf: [u8], n: i64, t: i64, inout u: i64) -> i64
  requires 1 <= t && t <= 65536
  requires 0 <= n && n <= len(buf)
  requires 0 <= u && u <= 4611686018427387904
  ensures 0 <= result && result <= n
  ensures n - result <= 3 * t
  ensures 0 <= u && u <= t
{
  let u0: i64 = u;
  let mut v: i64 = u;
  let mut i: i64 = 0;
  while i < n && (v > t || n - i > 3 * t)
    invariant 0 <= i && i <= n
    invariant u0 - 2 * i <= v && v <= u0
    decreases n - i
  {
    let b: i64 = buf[i];
    let mut w: i64 = 1;
    let mut d: i64 = 1;
    if b >= 240 {
      w = 4;
      d = 2;
    } else if b >= 224 {
      w = 3;
    } else if b >= 192 {
      w = 2;
    }
    if w > n - i { w = n - i; }
    i = i + w;
    v = v - d;
  }
  if i == n || v < 0 { v = 0; }
  u = v;
  return i;
}

// Drops the front as above and moves the rest to the start of buf. n may be up to 6T+4 (one code point past 6T).
fn trim(inout buf: [u8], t: i64, inout n: i64, inout u: i64) -> ()
  requires 1 <= t && t <= 65536
  requires len(buf) == 6 * t + 4
  requires 0 <= n && n <= len(buf)
  requires 0 <= u && u <= 2 * t + 2
  ensures 0 <= n && n <= 3 * t && 0 <= u && u <= t
{
  let m: i64 = n;
  let s: i64 = drop_front(buf, m, t, inout u);
  copy_within(inout buf, 0, s, m - s);
  n = m - s;
}

// Writes scalar value v (not a surrogate) as UTF-8 at buf[n..]; returns the end.
fn enc(inout buf: [u8], n: i64, v: i64) -> i64
  requires 0 <= n && n + 4 <= len(buf)
  requires 0 <= v && v <= 1114111
  ensures n + 1 <= result && result <= n + 4
{
  if v < 128 {
    buf[n] = v;
    return n + 1;
  }
  if v < 2048 {
    buf[n] = 192 + v / 64;
    buf[n + 1] = 128 + v % 64;
    return n + 2;
  }
  if v < 65536 {
    buf[n] = 224 + v / 4096;
    buf[n + 1] = 128 + (v / 64) % 64;
    buf[n + 2] = 128 + v % 64;
    return n + 3;
  }
  buf[n] = 240 + v / 262144;
  buf[n + 1] = 128 + (v / 4096) % 64;
  buf[n + 2] = 128 + (v / 64) % 64;
  buf[n + 3] = 128 + v % 64;
  return n + 4;
}

fn reset(inout d: Dec) -> ()
  ensures d.need == 0
{
  d.need = 0;
  d.seen = 0;
  d.cp = 0;
  d.lo = 128;
  d.hi = 191;
}

// Decodes data[from..to] through the WHATWG UTF-8 decoder d (maximal-subpart replacement). The counters and the
// decoder live in locals for the whole range and go back to `a` and `d` once at the end (struct field writes are
// whole-struct stores on the LLVM backend, G-DB9-1). The trim check runs only after a byte is appended.
fn push_dec(inout buf: [u8], inout a: Acc, inout d: Dec, data: [u8], from: i64, to: i64) -> ()
  requires 1 <= a.t && a.t <= 65536
  requires len(buf) == 6 * a.t + 4
  requires 0 <= a.n && a.n <= 6 * a.t && 0 <= a.u && a.u <= 2 * a.t
  requires 0 <= from && from <= to && to <= len(data)
  ensures 1 <= a.t && a.t <= 65536 && len(buf) == 6 * a.t + 4
  ensures 0 <= a.n && a.n <= 6 * a.t && 0 <= a.u && a.u <= 2 * a.t
{
  let t: i64 = a.t;
  let mut n: i64 = a.n;
  let mut u: i64 = a.u;
  let mut need: i64 = d.need;
  let mut seen: i64 = d.seen;
  let mut cp: i64 = d.cp;
  let mut lo: i64 = d.lo;
  let mut hi: i64 = d.hi;
  let mut i: i64 = from;
  while i < to
    invariant from <= i && i <= to
    invariant len(buf) == 6 * t + 4
    invariant 0 <= n && n <= 6 * t && 0 <= u && u <= 2 * t
    decreases to - i
  {
    let b: i64 = data[i];
    if need != 0 && (b < lo || b > hi) {
      // Not a continuation here: one U+FFFD for the pending sequence, then the byte starts over.
      need = 0;
      seen = 0;
      cp = 0;
      lo = 128;
      hi = 191;
      buf[n] = 239;
      buf[n + 1] = 191;
      buf[n + 2] = 189;
      n = n + 3;
      u = u + 1;
      if u > 2 * t || n > 6 * t { trim(inout buf, t, inout n, inout u); }
    }
    if need != 0 {
      lo = 128;
      hi = 191;
      // A pending code point has at most 15 bits (3 lead bits + two continuations), so the mask is a no-op.
      let c: i64 = band(cp, 32767) * 64 + band(b, 63);
      let s1: i64 = band(seen, 3) + 1;
      if s1 >= need {
        need = 0;
        seen = 0;
        cp = 0;
        let mut v: i64 = c;
        // Valid decoder state already excludes non-scalars. Keep replacement for externally supplied state.
        if c > 1114111 || (c >= 55296 && c <= 57343) { v = 65533; }
        n = enc(inout buf, n, v);
        u = u + 1;
        if v >= 65536 { u = u + 1; }
        if u > 2 * t || n > 6 * t { trim(inout buf, t, inout n, inout u); }
      } else {
        seen = s1;
        cp = c;
      }
    } else if b <= 127 {
      buf[n] = b;
      n = n + 1;
      u = u + 1;
      if u > 2 * t || n > 6 * t { trim(inout buf, t, inout n, inout u); }
    } else if b >= 194 && b <= 223 {
      need = 1;
      seen = 0;
      cp = band(b, 31);
    } else if b >= 224 && b <= 239 {
      if b == 224 { lo = 160; }
      if b == 237 { hi = 159; }
      need = 2;
      seen = 0;
      cp = band(b, 15);
    } else if b >= 240 && b <= 244 {
      if b == 240 { lo = 144; }
      if b == 244 { hi = 143; }
      need = 3;
      seen = 0;
      cp = band(b, 7);
    } else {
      buf[n] = 239;
      buf[n + 1] = 191;
      buf[n + 2] = 189;
      n = n + 3;
      u = u + 1;
      if u > 2 * t || n > 6 * t { trim(inout buf, t, inout n, inout u); }
    }
    i = i + 1;
  }
  a.n = n;
  a.u = u;
  d.need = need;
  d.seen = seen;
  d.cp = cp;
  d.lo = lo;
  d.hi = hi;
}

// Decodes data[lo..hi] of stream s (1 or 2) into the tail. The decoder is copied out and back so one loop serves
// both streams.
pub fn tail_push_range(inout buf: [u8], inout ts: Tail, s: i64, data: [u8], lo: i64, hi: i64) -> ()
  requires 1 <= ts.acc.t && ts.acc.t <= 65536
  requires len(buf) == 6 * ts.acc.t + 4
  requires 0 <= ts.acc.n && ts.acc.n <= 6 * ts.acc.t && 0 <= ts.acc.u && ts.acc.u <= 2 * ts.acc.t
  requires s == 1 || s == 2
  requires 0 <= lo && lo <= hi && hi <= len(data)
  ensures 1 <= ts.acc.t && ts.acc.t <= 65536 && len(buf) == 6 * ts.acc.t + 4
  ensures 0 <= ts.acc.n && ts.acc.n <= 6 * ts.acc.t && 0 <= ts.acc.u && ts.acc.u <= 2 * ts.acc.t
{
  let mut d: Dec = ts.d1;
  if s == 2 { d = ts.d2; }
  push_dec(inout buf, inout ts.acc, inout d, data, lo, hi);
  if s == 1 { ts.d1 = d; } else { ts.d2 = d; }
}

pub fn tail_push(inout buf: [u8], inout ts: Tail, s: i64, data: [u8]) -> ()
  requires 1 <= ts.acc.t && ts.acc.t <= 65536
  requires len(buf) == 6 * ts.acc.t + 4
  requires 0 <= ts.acc.n && ts.acc.n <= 6 * ts.acc.t && 0 <= ts.acc.u && ts.acc.u <= 2 * ts.acc.t
  requires s == 1 || s == 2
  ensures 1 <= ts.acc.t && ts.acc.t <= 65536 && len(buf) == 6 * ts.acc.t + 4
  ensures 0 <= ts.acc.n && ts.acc.n <= 6 * ts.acc.t && 0 <= ts.acc.u && ts.acc.u <= 2 * ts.acc.t
{
  let n: i64 = len(data);
  tail_push_range(inout buf, inout ts, s, data, 0, n);
}

// End of input: an incomplete sequence becomes one U+FFFD, stream 1 first.
pub fn tail_flush(inout buf: [u8], inout ts: Tail) -> ()
  requires 1 <= ts.acc.t && ts.acc.t <= 65536
  requires len(buf) == 6 * ts.acc.t + 4
  requires 0 <= ts.acc.n && ts.acc.n <= 6 * ts.acc.t && 0 <= ts.acc.u && ts.acc.u <= 2 * ts.acc.t
  ensures 1 <= ts.acc.t && ts.acc.t <= 65536 && len(buf) == 6 * ts.acc.t + 4
  ensures 0 <= ts.acc.n && ts.acc.n <= 6 * ts.acc.t && 0 <= ts.acc.u && ts.acc.u <= 2 * ts.acc.t
{
  let t: i64 = ts.acc.t;
  let mut n: i64 = ts.acc.n;
  let mut u: i64 = ts.acc.u;
  if ts.d1.need != 0 {
    reset(inout ts.d1);
    n = enc(inout buf, n, 65533);
    u = u + 1;
    if u > 2 * t || n > 6 * t { trim(inout buf, t, inout n, inout u); }
  }
  if ts.d2.need != 0 {
    reset(inout ts.d2);
    n = enc(inout buf, n, 65533);
    u = u + 1;
    if u > 2 * t || n > 6 * t { trim(inout buf, t, inout n, inout u); }
  }
  ts.acc.n = n;
  ts.acc.u = u;
}

// The longest suffix of whole code points with at most T units, as UTF-8 bytes.
pub fn tail_bytes(buf: [u8], ts: Tail) -> [u8] ! alloc
  requires 1 <= ts.acc.t && ts.acc.t <= 65536
  requires len(buf) == 6 * ts.acc.t + 4
  requires 0 <= ts.acc.n && ts.acc.n <= 6 * ts.acc.t && 0 <= ts.acc.u && ts.acc.u <= 2 * ts.acc.t
  ensures len(result) <= 3 * ts.acc.t
{
  let n: i64 = ts.acc.n;
  let mut u: i64 = ts.acc.u;
  let s: i64 = drop_front(buf, n, ts.acc.t, inout u);
  let mut out: [u8] = alloc(n - s, 0);
  copy_range(inout out, 0, buf, s, n - s);
  return out;
}
