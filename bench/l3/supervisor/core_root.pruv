// R10 core lane root (hand `core_hand::core`): data split into consecutive chunk-byte pieces, piece k to stream
// k % 2, each pushed as a view (no copy), then finished; returns the tail bytes. The hand's `assert!(t > 0 && chunk
// > 0)` is the precondition; `t <= 65536` is the pkgs/tail `new` contract (the hand's Tail takes any usize).
mod tail;

pub fn core(t: i64, data: [u8], chunk: i64) -> [u8] ! alloc
  requires 1 <= t && t <= 65536 && chunk >= 1
{
  let mut tl: crate::tail::Tail = crate::tail::new(t);
  let n: i64 = len(data);
  let mut lo: i64 = 0;
  let mut index: i64 = 0;
  while lo < n
    invariant 0 <= lo && lo <= n
    invariant 0 <= index && index <= lo
    invariant crate::tail::tail_ok(tl) && tl.limit == t
    decreases n - lo
  {
    let mut hi: i64 = n;
    if n - lo > chunk { hi = lo + chunk; }
    crate::tail::push(inout tl, index % 2, subview(data, lo, hi));
    index = index + 1;
    lo = hi;
  }
  return crate::tail::finish(move tl);
}
