// L3-2 A1 root. script = repeated [stream, n, n bytes] with stream 1 (stdout) or 2 (stderr); returns the final tail
// bytes, or [-1] on a malformed script. The tail is the shared package (hand `core_hand::Tail`, streams 0/1).
mod tail;

pub fn run(t: i64, script: [i64]) -> [i64] ! alloc
{
  let mut bad: [i64] = alloc(1, -1);
  if t < 1 || t > 65536 { return bad; }
  let mut tl: crate::tail::Tail = crate::tail::new(t);
  let mut i: i64 = 0;
  while i < len(script)
    invariant 0 <= i && i <= len(script)
    invariant crate::tail::tail_ok(tl) && tl.limit == t
    decreases len(script) - i
  {
    if i + 2 > len(script) { return bad; }
    let s: i64 = script[i];
    let n: i64 = script[i + 1];
    if (s != 1 && s != 2) || n < 0 || n > len(script) - i - 2 { return bad; }
    let mut chunk: [u8] = alloc(n, 0);
    let mut k: i64 = 0;
    while k < n
      invariant 0 <= k && k <= n
      invariant len(chunk) == n
      decreases n - k
    {
      let v: i64 = script[i + 2 + k];
      if v < 0 || v > 255 { return bad; }
      chunk[k] = v;
      k = k + 1;
    }
    crate::tail::push(inout tl, s - 1, chunk);
    i = i + 2 + n;
  }
  let tb: [u8] = crate::tail::finish(move tl);
  let mut out: [i64] = alloc(0, 0);
  arr_reserve(inout out, len(tb));
  arr_append(inout out, tb, 0, len(tb));
  return out;
}
