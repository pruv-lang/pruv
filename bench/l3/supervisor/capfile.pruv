// L3-2 capped output file (hand `supervise_hand.rs::write` and `close`). The state lives in the result packet as in
// the hand: p[6] truncated, p[7] file error (0 none, 1 create, 2 write), p[10] bytes written. The hand keeps
// `Option<File>`; a File cannot sit in an Option or an inout parameter (gap FO), so the handle is threaded through
// `take` and "Some" is `file_writable`.

// One chunk: write the prefix that fits with one write; count it only if the write succeeded.
pub fn write(take f: File, inout p: [i64], file_limit: i64, bytes: [u8]) -> File ! fs
  requires len(p) >= 12
  requires 0 <= file_limit && file_limit <= 1099511627776
  requires 0 <= p[10] && p[10] <= file_limit
  requires 0 <= p[6] && p[6] <= 1
  requires 0 <= p[7] && p[7] <= 2
  ensures len(p) == len(old(p))
  ensures old(p)[10] <= p[10] && p[10] <= file_limit
  ensures 0 <= p[6] && p[6] <= 1
  ensures 0 <= p[7] && p[7] <= 2
  ensures p[9] == old(p)[9]
{
  if !file_writable(f) { return move f; }
  let mut n: i64 = file_limit - p[10];
  if len(bytes) < n { n = len(bytes); }
  if n < len(bytes) { p[6] = 1; }
  if n == 0 { return move f; }
  let g: File = write_all(move f, subview(bytes, 0, n));
  if file_writable(g) { p[10] = p[10] + n; } else { p[7] = 2; }
  return move g;
}

// hand `output.write_all(&bytes[..n])`. A builtin argument cannot be a `subview` (view_context, gap FV), so the
// prefix view goes through this one-line Pruv call; no copy, as the hand.
fn write_all(take f: File, part: [u8]) -> File ! fs
  requires file_writable(f)
{
  return file_write_bytes(move f, part);
}

// Close the file; a failed close is a write error unless an error is already set (P4). The hand drops the File.
pub fn close(take f: File, inout p: [i64]) -> () ! fs
  requires len(p) >= 12
  requires 0 <= p[7] && p[7] <= 2
  ensures len(p) == len(old(p))
  ensures 0 <= p[7] && p[7] <= 2
  ensures p[6] == old(p)[6] && p[9] == old(p)[9] && p[10] == old(p)[10]
{
  let ok: bool = file_close(move f);
  if !ok && p[7] == 0 { p[7] = 2; }
  return;
}
