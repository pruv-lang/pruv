// L3-2 A0 root: host wrappers for argument spans and packets (root pub fns return [i64] only).
mod args;
mod packet;

pub fn spans(argv: str) -> [i64] ! alloc
{
  return crate::args::arg_spans(argv);
}

// Builds the arguments and reports their count; -1 when the blob is malformed.
pub fn arg_count(argv: str) -> [i64] ! alloc
{
  let sp: [i64] = crate::args::arg_spans(argv);
  let a: ProcessArgs = crate::args::build_args(argv);
  let mut out: [i64] = alloc(1, -1);
  if sp[0] == 0 { out[0] = proc_args_len(a); }
  return out;
}

pub fn pack(h: [i64], tail: [u8]) -> [i64] ! alloc
{
  if len(h) != 11 || len(tail) > 1048576 {
    let mut e: [i64] = alloc(1, -1);
    return e;
  }
  return crate::packet::packet(h, tail);
}

pub fn bad() -> [i64] ! alloc
{
  return crate::packet::bad_input();
}
