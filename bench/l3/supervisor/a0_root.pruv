// L3-2 A0 root: host wrappers for argument spans and packets (root pub fns return [i64] only). The arguments are the
// shared package; the packet is built as the supervisor and the hand build it (12 words, then the widened tail).
mod args;

pub fn spans(argv: str) -> [i64] ! alloc
{
  return crate::args::arg_spans(argv);
}

// Builds the arguments and reports their count; -1 when the blob is malformed.
pub fn arg_count(argv: str) -> [i64] ! alloc
{
  let mut out: [i64] = alloc(1, -1);
  let sp: [i64] = crate::args::arg_spans(argv);
  if sp[0] != 0 { return out; }
  let a: ProcessArgs = crate::args::build_args(argv);
  out[0] = proc_args_len(a);
  return out;
}

pub fn pack(h: [i64], tail: [u8]) -> [i64] ! alloc
{
  if len(h) != 11 || len(tail) > 1048576 {
    let mut e: [i64] = alloc(1, -1);
    return e;
  }
  let mut p: [i64] = alloc(12, 0);
  for k in 0..11
    invariant len(p) == 12
  {
    p[k] = h[k];
  }
  p[11] = len(tail);
  arr_append(inout p, tail, 0, len(tail));
  return p;
}

pub fn bad() -> [i64] ! alloc
{
  let mut p: [i64] = alloc(12, 0);
  p[0] = 1;
  p[1] = 5;
  return p;
}
