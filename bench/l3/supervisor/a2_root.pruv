// L3-2 A2 root. script = repeated [n, n bytes]; returns [written, truncated, error, limit, total, file_open],
// or [-1] on a malformed script or limit. The file state lives in the packet slots the supervisor uses.
mod capfile;

pub fn run(path: str, limit: i64, script: [i64]) -> [i64] ! fs, alloc
{
  let bad: [i64] = alloc(1, -1);
  if limit < 0 || limit > 1099511627776 { return bad; }
  let mut p: [i64] = alloc(12, 0);
  let mut f: File = file_create(path);
  if file_writable(f) { p[8] = 1; } else { p[7] = 1; }
  let mut i: i64 = 0;
  while i < len(script)
    invariant 0 <= i && i <= len(script)
    invariant len(p) == 12
    invariant 0 <= p[10] && p[10] <= limit
    invariant 0 <= p[9] && p[9] <= i
    invariant 0 <= p[6] && p[6] <= 1
    invariant 0 <= p[7] && p[7] <= 2
    decreases len(script) - i
  {
    let n: i64 = script[i];
    if n < 0 || n > 65536 || n > len(script) - i - 1 { return bad; }
    let mut chunk: [u8] = alloc(n, 0);
    let mut k: i64 = 0;
    while k < n
      invariant 0 <= k && k <= n
      invariant len(chunk) == n
      decreases n - k
    {
      let v: i64 = script[i + 1 + k];
      if v < 0 || v > 255 { return bad; }
      chunk[k] = v;
      k = k + 1;
    }
    p[9] = p[9] + n;
    f = crate::capfile::write(move f, inout p, limit, chunk);
    i = i + 1 + n;
  }
  crate::capfile::close(move f, inout p);
  let mut out: [i64] = alloc(6, 0);
  out[0] = p[10];
  out[1] = p[6];
  out[2] = p[7];
  out[3] = limit;
  out[4] = p[9];
  out[5] = p[8];
  return out;
}
