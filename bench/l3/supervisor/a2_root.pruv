// L3-2 A2 root. script = repeated [n, n bytes]; returns [written, truncated, error, limit, total, file_open],
// or [-1] on a malformed script or limit.
mod capfile;

pub fn run(path: str, limit: i64, script: [i64]) -> [i64] ! fs, alloc
{
  let bad: [i64] = alloc(1, -1);
  if limit < 0 || limit > 1099511627776 { return bad; }
  let mut f: File = file_create(path);
  let failed: bool = !file_writable(f);
  let mut cw: [i64] = crate::capfile::cap_state(limit, failed);
  let mut i: i64 = 0;
  while i < len(script)
    invariant 0 <= i && i <= len(script)
    invariant len(cw) == 5 && cw[3] == limit
    invariant 0 <= cw[0] && cw[0] <= cw[3]
    invariant 0 <= cw[4] && cw[4] <= i
    invariant 0 <= cw[1] && cw[1] <= 1
    invariant 0 <= cw[2] && cw[2] <= 2
    decreases len(script) - i
  {
    let n: i64 = script[i];
    if n < 0 || n > 65536 || n > len(script) - i - 1 { return bad; }
    let mut chunk: [u8] = alloc(n, 0);
    let mut k: i64 = 0;
    while k < n
      invariant 0 <= k && k <= n
      invariant len(chunk) == n
      decreases n - k
    {
      let v: i64 = script[i + 1 + k];
      if v < 0 || v > 255 { return bad; }
      chunk[k] = v;
      k = k + 1;
    }
    f = crate::capfile::cap_take(move f, inout cw, chunk);
    i = i + 1 + n;
  }
  crate::capfile::cap_finish(move f, inout cw);
  let mut out: [i64] = alloc(6, 0);
  let mut j: i64 = 0;
  while j < 5
    invariant 0 <= j && j <= 5
    invariant len(out) == 6 && len(cw) == 5
    decreases 5 - j
  {
    out[j] = cw[j];
    j = j + 1;
  }
  if !failed { out[5] = 1; }
  return out;
}
