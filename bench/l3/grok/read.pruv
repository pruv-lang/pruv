// Grok history read: phases 400-499 of the step protocol, and read::window (framing events -> collector -> read packet).
// NOT compiled or verified (no shell).
//
// Flow (all requests on slot 0, one outstanding at a time; the history path is rebuilt from cfg wherever it is needed):
//   400 (empty event)  lstat(history)                              -> 401   stage 5
//   401 lstat done     regular non-symlink file, keep dev/ino      -> realpath                -> 402   stage 6
//   402 realpath done  path::inside(homeReal, real)                -> open(O_NOFOLLOW)        -> 403   stage 7
//   403 open done      handle                                      -> fstat (identity)        -> 404   stage 8
//   404 fstat done     dev/ino equal to the lstat ones, else close then read-failed
//                                                                  -> fstat (window size)     -> 405   stage 9
//   405 fstat done     size -> start = max(0,size-8388608), bank 7 resized to size-start (patch)
//                      size 0: close (errors propagate)            -> 407
//                      else positioned read of min(262144,left)    -> 406   stage 10
//   406 read done      chunk copied into bank 7 (patch); another read, or (EOF/short end) bank 7 cut to the bytes really read + close -> 407
//   407 close done     close errors are swallowed (except for size 0): read::window over bank 7, done
//   408 close done     after an error: done with the pending error stored in ctl[26] (stage*100 + class*10 + code)
// Unknown phase or a completion of the wrong slot/opcode: done_internal.
//
// ctl words used (DESIGN s1): 10 window start, 11 window end (size), 12 next read offset (absolute; at the end = start + bytes really
// read), 14 omittedBefore (start > 0), 26 pending error (PACKED NUMBER, not a ref: this module is its only reader), 29 close policy
// (0 propagate (size 0), 1 swallow); slot 0 record: +4 (ctl[132]) handle, +7..+10 (ctl[135..138]) lstat dev hi/lo, ino hi/lo.
// Inputs expected from the previous module at phase 400 (hand-off by a continue packet with ctl[2] = 400): ctl[16,17] homeReal ref,
// ctl[20,21] title ref, ctl[22,23] model ref (bank 2; absent (-1,0) = empty), cfg words 4-9 as in root.
//
// UNSURE / for the main agent:
//  1. Hand-off contract is my assumption (above). summary.pruv must put the read title/model into ctl[20..23] and continue with phase 400.
//  2. Resolved: summary delivers the final title (one_line 120) and trimmed model, so p_finish uses the refs as-is.
//  3. Stages for the not-found/read-failed errors are my reading of DESIGN s2: history lstat/regular check 5, realpath/containment 6,
//     open 7, identity fstat 8, size fstat 9, read 10, close 11 (size 0 only), window problems 12.
//  4. path::* signatures are used as listed in the task (encode_folder, join, inside); their requires are not visible to me, so I guard
//     every length I pass (<= 1000000) and treat an empty/oversized path as InternalInvariant (stage 5).
//  5. realpath success is taken as "the whole completion is the path" (DESIGN s1); non-UTF-8 or > 1000000 bytes counts as outside (not-found).
//  6. TS closes the handle with .catch(() => undefined) in every path except the size-0 early return; that is the policy above.
//  7. window() has no requires; it returns packet errors for len(win) > 8388608 (InputTooLarge, stage 12) and for any internal surprise
//     (class 6 code 2, stage 12). InternalInvariant from the JSON parser (error kind 18) is NOT swallowed as malformed input.
//  8. Every Failed parse other than kind 18 (P1: bad UTF-8, depth, records) is a skipped line, like parseLine returning undefined.

fn code_of(eno: i64) -> i64
  ensures result == 3 || result == 7
{
  if eno == 1 { return 3; }
  return 7;
}

// The completion is for slot 0 and for the outstanding request with this opcode.
fn comp_ok(ctl: [i64], event: [i64], opcode: i64) -> bool
  requires len(ctl) == 256 && len(event) >= 24
{
  if event[2] != 0 { return false; }
  if ctl[130] < 1 || event[1] != ctl[130] { return false; }
  if event[3] != opcode || ctl[131] != opcode { return false; }
  return true;
}

// <source home>/sessions/<encodeURIComponent(folder)>/<thread>/chat_history.jsonl; "" when something is empty or oversized.
fn history_path(cfg: [i64], cfg_text: [u8]) -> str ! alloc
  requires len(cfg) == 24
  ensures len(result) <= 1000000
{
  let none: str = "";
  let home: str = crate::util::cfg_str(cfg_text, cfg[4], cfg[5]);
  let folder: str = crate::util::cfg_str(cfg_text, cfg[6], cfg[7]);
  let thread: str = crate::util::cfg_str(cfg_text, cfg[8], cfg[9]);
  if len(home) == 0 || len(folder) == 0 || len(thread) == 0 { return copy(none); }
  let enc: [u8] = crate::path::encode_folder(folder);
  if len(enc) == 0 || len(enc) > 1000000 { return copy(none); }
  let es: str = crate::jstr::adapter_probe(enc);
  if len(es) != len(enc) { return copy(none); }
  let a: str = crate::path::join(home, "sessions");
  if len(a) > 1000000 { return copy(none); }
  let b: str = crate::path::join(a, es);
  if len(b) > 1000000 { return copy(none); }
  let c: str = crate::path::join(b, thread);
  if len(c) > 1000000 { return copy(none); }
  let d: str = crate::path::join(c, "chat_history.jsonl");
  if len(d) > 1000000 { return copy(none); }
  return copy(d);
}

// Consume the completion (if any) and issue one request on slot 0. patches are applied by the host before the primitive runs.
fn issue(ctl: [i64], phase: i64, op: i64, flags: i64, handle: i64, offset: i64, count: i64, stage: i64, path: str, patches: [i64]) -> [i64] ! alloc
  requires len(ctl) == 256 && 1 <= ctl[3] && ctl[3] <= 1000000000
  requires 0 <= phase && phase <= 999 && 1 <= op && op <= 13 && 0 <= flags && flags <= 3
  requires -1 <= handle && 0 <= offset && 0 <= count && 0 <= stage && stage <= 30
  requires len(path) <= 1000000 && len(patches) <= 4096
  ensures len(result) >= 268
{
  let id: i64 = ctl[3];
  let mut c: [i64] = copy(ctl);
  c[2] = phase;
  c[3] = id + 1;
  c[4] = bor(ctl[4], 1);
  c[130] = id;
  c[131] = op;
  let e8: [u8] = alloc(0, 0);
  let pool: [u8] = crate::packet::append_str(e8, path);
  let mut ps: i64 = -1;
  if len(path) > 0 { ps = 0; }
  let req: [i64] = crate::packet::request(id, 0, op, flags, handle, offset, count, 0, ps, len(path), -1, 0, -1, 0, stage);
  let ew: [i64] = alloc(0, 0);
  return crate::packet::step_packet(c, patches, req, ew, pool, ew, 0);
}

// Close the handle, then finish with the pending error (stage, class, code) at phase 408. The close result is ignored.
fn close_then(ctl: [i64], handle: i64, stage: i64, cls: i64, code: i64) -> [i64] ! alloc
  requires len(ctl) == 256 && 1 <= ctl[3] && ctl[3] <= 1000000000
  requires 0 <= stage && stage <= 30 && 1 <= cls && cls <= 7 && 0 <= code && code <= 8
  ensures len(result) >= 268
{
  if handle < 0 { return crate::packet::done_internal(ctl, 11); }
  let mut c: [i64] = copy(ctl);
  c[26] = stage * 100 + cls * 10 + code;
  let np: [i64] = alloc(0, 0);
  return issue(c, 408, 7, 0, handle, 0, 0, 11, "", np);
}

// 400: first request.
fn p_start(cfg: [i64], cfg_text: [u8], ctl: [i64]) -> [i64] ! alloc
  requires len(cfg) == 24 && len(ctl) == 256 && 1 <= ctl[3] && ctl[3] <= 1000000000
  ensures len(result) >= 268
{
  let path: str = history_path(cfg, cfg_text);
  if len(path) == 0 { return crate::packet::done_internal(ctl, 5); }
  let mut c: [i64] = copy(ctl);
  c[10] = 0;
  c[11] = 0;
  c[12] = 0;
  c[14] = 0;
  c[26] = 0;
  c[29] = 0;
  c[132] = -1;
  let np: [i64] = alloc(0, 0);
  return issue(c, 401, 2, 0, -1, 0, 0, 5, path, np);
}

// 401: lstat done: must be a regular file (not a symlink); keep its identity.
fn p_lstat(cfg: [i64], cfg_text: [u8], ctl: [i64], event: [i64]) -> [i64] ! alloc
  requires len(cfg) == 24 && len(ctl) == 256 && len(event) >= 24 && 1 <= ctl[3] && ctl[3] <= 1000000000
  ensures len(result) >= 268
{
  if !comp_ok(ctl, event, 2) { return crate::packet::done_internal(ctl, 5); }
  if event[4] != 0 || event[7] != 1 { return crate::packet::done_simple(ctl, 5, 1, 3); }
  let path: str = history_path(cfg, cfg_text);
  if len(path) == 0 { return crate::packet::done_internal(ctl, 5); }
  let mut c: [i64] = copy(ctl);
  c[135] = event[9];
  c[136] = event[10];
  c[137] = event[11];
  c[138] = event[12];
  let np: [i64] = alloc(0, 0);
  return issue(c, 402, 3, 0, -1, 0, 0, 6, path, np);
}

// 402: realpath done: inside the real home (separator-aware), else not-found.
fn p_real(cfg: [i64], cfg_text: [u8], ctl: [i64], event: [i64], bank2: [u8], completion: [u8]) -> [i64] ! alloc
  requires len(cfg) == 24 && len(ctl) == 256 && len(event) >= 24 && 1 <= ctl[3] && ctl[3] <= 1000000000
  ensures len(result) >= 268
{
  if !comp_ok(ctl, event, 3) { return crate::packet::done_internal(ctl, 6); }
  if event[4] != 0 { return crate::packet::done_simple(ctl, 6, 1, 3); }
  let real: str = crate::jstr::adapter_probe(completion);
  if len(real) != len(completion) || len(real) > 1000000 { return crate::packet::done_simple(ctl, 6, 1, 3); }
  let home_real: str = crate::util::cfg_str(bank2, ctl[16], ctl[17]);
  if len(home_real) == 0 { return crate::packet::done_internal(ctl, 6); }
  if !crate::path::inside(home_real, real) { return crate::packet::done_simple(ctl, 6, 1, 3); }
  let path: str = history_path(cfg, cfg_text);
  if len(path) == 0 { return crate::packet::done_internal(ctl, 6); }
  let np: [i64] = alloc(0, 0);
  return issue(ctl, 403, 4, 1, -1, 0, 0, 7, path, np);
}

// 403: open done: ENOENT -> not-found, any other error -> read-failed; else the identity fstat.
fn p_open(ctl: [i64], event: [i64]) -> [i64] ! alloc
  requires len(ctl) == 256 && len(event) >= 24 && 1 <= ctl[3] && ctl[3] <= 1000000000
  ensures len(result) >= 268
{
  if !comp_ok(ctl, event, 4) { return crate::packet::done_internal(ctl, 7); }
  if event[4] != 0 { return crate::packet::done_simple(ctl, 7, 1, code_of(event[5])); }
  let h: i64 = event[13];
  if h < 0 { return crate::packet::done_internal(ctl, 7); }
  let mut c: [i64] = copy(ctl);
  c[132] = h;
  let np: [i64] = alloc(0, 0);
  return issue(c, 404, 5, 0, h, 0, 0, 8, "", np);
}

// 404: identity fstat done: mismatch or failure closes the handle and gives read-failed; else the size fstat.
fn p_ident(ctl: [i64], event: [i64]) -> [i64] ! alloc
  requires len(ctl) == 256 && len(event) >= 24 && 1 <= ctl[3] && ctl[3] <= 1000000000
  ensures len(result) >= 268
{
  if !comp_ok(ctl, event, 5) { return crate::packet::done_internal(ctl, 8); }
  let h: i64 = ctl[132];
  if h < 0 { return crate::packet::done_internal(ctl, 8); }
  if event[4] != 0 { return close_then(ctl, h, 8, 1, 7); }
  if event[9] != ctl[135] || event[10] != ctl[136] || event[11] != ctl[137] || event[12] != ctl[138] {  // MUT:M03 => if false {
    return close_then(ctl, h, 8, 1, 7);
  }
  let np: [i64] = alloc(0, 0);
  return issue(ctl, 405, 5, 0, h, 0, 0, 9, "", np);
}

// 405: size fstat done: fix the window, size bank 7, first read (or close for an empty file).
fn p_size(ctl: [i64], event: [i64]) -> [i64] ! alloc
  requires len(ctl) == 256 && len(event) >= 24 && 1 <= ctl[3] && ctl[3] <= 1000000000
  ensures len(result) >= 268
{
  if !comp_ok(ctl, event, 5) { return crate::packet::done_internal(ctl, 9); }
  let h: i64 = ctl[132];
  if h < 0 { return crate::packet::done_internal(ctl, 9); }
  if event[4] != 0 { return close_then(ctl, h, 9, 1, code_of(event[5])); }
  let size: i64 = event[8];
  if size < 0 || size > 9007199254740991 { return close_then(ctl, h, 9, 6, 2); }
  let mut start: i64 = 0;
  if size > 8388608 { start = size - 8388608; }
  let wlen: i64 = size - start;
  let mut c: [i64] = copy(ctl);
  c[10] = start;
  c[11] = size;
  c[12] = start;
  c[14] = 0;
  if start > 0 { c[14] = 1; }
  let rs: [i64] = crate::packet::patch_resize(7, wlen);
  if wlen == 0 {
    c[29] = 0;
    return issue(c, 407, 7, 0, h, 0, 0, 11, "", rs);
  }
  c[29] = 1;
  let mut cnt: i64 = wlen;
  if cnt > 262144 { cnt = 262144; }
  return issue(c, 406, 6, 0, h, start, cnt, 10, "", rs);
}

// 406: a read completion: store the chunk, read on, or finish (EOF / zero or short end / window end reached).
fn p_read(ctl: [i64], event: [i64]) -> [i64] ! alloc
  requires len(ctl) == 256 && len(event) >= 24 && 1 <= ctl[3] && ctl[3] <= 1000000000
  ensures len(result) >= 268
{
  if !comp_ok(ctl, event, 6) { return crate::packet::done_internal(ctl, 10); }
  let h: i64 = ctl[132];
  if h < 0 { return crate::packet::done_internal(ctl, 10); }
  if event[4] != 0 { return close_then(ctl, h, 10, 1, code_of(event[5])); }
  let start: i64 = ctl[10];
  let end: i64 = ctl[11];
  let off: i64 = ctl[12];
  if start < 0 || end < start || end - start > 8388608 || off < start || off > end { return close_then(ctl, h, 10, 6, 2); }
  let mut want: i64 = end - off;
  if want > 262144 { want = 262144; }
  let n: i64 = event[14];
  if n < 0 || n > want || n != event[18] { return close_then(ctl, h, 10, 6, 2); }
  let mut patches: [i64] = alloc(0, 0);
  if n > 0 { patches = crate::packet::patch_copy(7, off - start, n, 2, 0); }
  let off2: i64 = off + n;
  let mut c: [i64] = copy(ctl);
  c[12] = off2;
  if n > 0 && event[15] == 0 && off2 < end {
    let mut nwant: i64 = end - off2;
    if nwant > 262144 { nwant = 262144; }
    return issue(c, 406, 6, 0, h, off2, nwant, 10, "", patches);
  }
  // end of data: cut bank 7 to what was really read (the file may have shrunk), then close
  let got: i64 = off2 - start;
  let wlen: i64 = end - start;
  if got < wlen {
    patches = crate::packet::cat_words(patches, crate::packet::patch_resize(7, got));
  }
  c[29] = 1;
  return issue(c, 407, 7, 0, h, 0, 0, 11, "", patches);
}

// 407: close done after the window was read: parse the window once and finish.
fn p_finish(ctl: [i64], event: [i64], bank2: [u8], history: [u8]) -> [i64] ! alloc
  requires len(ctl) == 256 && len(event) >= 24 && len(bank2) <= 100000000 && len(history) <= 100000000
  ensures len(result) >= 268
{
  if !comp_ok(ctl, event, 7) { return crate::packet::done_internal(ctl, 11); }
  if event[4] != 0 && ctl[29] == 0 { return crate::packet::done_simple(ctl, 11, 1, code_of(event[5])); }
  let start: i64 = ctl[10];
  let stop: i64 = ctl[12];
  if start < 0 || stop < start || len(history) != stop - start { return crate::packet::done_internal(ctl, 12); }
  // summary::summary_from already applied one_line(title, 120) and trim(model); a second one_line would drop a trailing space
  // left by the 120-unit slice (reference applies oneLine once).
  let title: str = crate::util::cfg_str(bank2, ctl[20], ctl[21]);
  let model: str = crate::util::long_str(bank2, ctl[22], ctl[23]);
  let res: [i64] = window(history, ctl[14] == 1, title, model);
  return crate::packet::done_wrap(ctl, res);
}

// 408: close done after an error: finish with the pending error.
fn p_fail(ctl: [i64], event: [i64]) -> [i64] ! alloc
  requires len(ctl) == 256 && len(event) >= 24
  ensures len(result) >= 268
{
  if !comp_ok(ctl, event, 7) { return crate::packet::done_internal(ctl, 11); }
  let v: i64 = ctl[26];
  if v < 0 || v > 3099 { return crate::packet::done_internal(ctl, 30); }
  return crate::packet::done_simple(ctl, v / 100, (v % 100) / 10, v % 10);
}

pub fn advance(cfg: [i64], cfg_text: [u8], ctl: [i64], directory: [i64], rows: [i64], text: [u8],
               small0: [u8], small1: [u8], small2: [u8], small3: [u8], history: [u8],
               event: [i64], completion: [u8]) -> [i64] ! alloc
  requires len(cfg) == 24 && 0 <= cfg[2] && cfg[2] <= 2147483647 && len(ctl) == 256 && len(event) >= 24
  requires 1 <= ctl[3] && ctl[3] <= 1000000000 && 0 <= ctl[4] && ctl[4] <= 15 && 0 <= ctl[2] && ctl[2] <= 999
  requires len(cfg_text) <= 100000000 && len(directory) <= 100000000 && len(rows) <= 100000000 && len(text) <= 100000000
  requires len(small0) <= 100000000 && len(small1) <= 100000000 && len(small2) <= 100000000 && len(small3) <= 100000000
  requires len(history) <= 100000000 && len(completion) <= 100000000
  ensures len(result) >= 268
{
  let ph: i64 = ctl[2];
  if ph == 400 {
    if !crate::packet::event_empty(event) { return crate::packet::done_internal(ctl, 30); }
    return p_start(cfg, cfg_text, ctl);
  }
  if crate::packet::event_empty(event) { return crate::packet::done_internal(ctl, 30); }
  if ph == 401 { return p_lstat(cfg, cfg_text, ctl, event); }
  if ph == 402 { return p_real(cfg, cfg_text, ctl, event, text, completion); }
  if ph == 403 { return p_open(ctl, event); }
  if ph == 404 { return p_ident(ctl, event); }
  if ph == 405 { return p_size(ctl, event); }
  if ph == 406 { return p_read(ctl, event); }
  if ph == 407 { return p_finish(ctl, event, text, history); }
  if ph == 408 { return p_fail(ctl, event); }
  return crate::packet::done_internal(ctl, 30);
}

// ---- window: framing events in order -> collector -> read packet ----

// One line span: parse it (a failed parse is a skipped line; kind 18 is an internal failure) and hand the object to entry::feed.
// Returns feed's code: 0 handled, 1 grow buf and call again, negative internal failure.
fn line_step(win: [u8], lo: i64, hi: i64, inout st: [i64], inout sl: [i64], inout buf: [u8]) -> i64 ! alloc
  requires 0 <= lo && lo <= hi && hi <= len(win)
  requires len(st) == 4 && len(sl) == 1600 && len(buf) <= 13116800 && 0 <= st[0] && st[0] < 100000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1) && (st[1] == 0 || 65584 * st[3] + 65584 <= len(buf))
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  ensures len(st) == 4 && len(sl) == 1600 && len(buf) <= 13116800 && 0 <= st[0] && st[0] <= 100000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1) && (st[1] == 0 || 65584 * st[3] + 65584 <= len(buf))
  ensures st[0] == old(st)[0] || st[0] == old(st)[0] + 1
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
{
  let parsed: crate::json::JsonParse = crate::lines::parse_range(win, lo, hi);
  match parsed {
    crate::json::JsonParse::Failed(e) => {
      if e.kind == 18 { return -1; }
      return 0;
    }
    crate::json::JsonParse::Parsed(doc) => {
      return crate::entry::feed(doc, inout st, inout sl, inout buf);
    }
  }
}

// The packet of a finished collector, written in one copy by packet::result3 (R06 C). Turn text first (base 0, so turns::finish' base bound always holds), then the title, then the model.
fn assemble(col: crate::turns::Collected, title: str, model: str, omitted: bool) -> [i64] ! alloc
  requires len(title) <= 1000000 && len(model) <= 20000000
  ensures len(result) >= 28
{
  let nt: i64 = len(col.turns);
  let nx: i64 = len(col.text);
  if col.kept < 0 || col.kept > 200 || nt != 10 * col.kept || nx < 0 || nx > 2106752 {
    return crate::packet::simple_error(1, 12, 6, 2);
  }
  let tl: i64 = len(title);
  let ml: i64 = len(model);
  let mut m: [i64] = crate::packet::meta_new(1);
  if omitted || col.trimmed == 1 { m[2] = 1; }  // MUT:M12 => if omitted { m[2] = 1; }
  m[3] = col.kept;
  m[10] = 10;
  if tl > 0 {
    m[4] = nx;
    m[5] = tl;
  }
  if ml > 0 {
    m[6] = nx + tl;
    m[7] = ml;
  }
  return crate::packet::result3(m, col.turns, col.text, title, model);
}

// One framing event: 0 = consumed, 2 = grow the buffer and call again (state unchanged), 1 = corrupt event or a failed
// line (the caller reports InternalInvariant).
fn event_step(win: [u8], kd: i64, lo: i64, hi: i64, inout st: [i64], inout sl: [i64], inout buf: [u8]) -> i64 ! alloc
  requires len(st) == 4 && len(sl) == 1600 && len(buf) <= 13116800 && 0 <= st[0] && st[0] < 100000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1) && (st[1] == 0 || 65584 * st[3] + 65584 <= len(buf))
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  ensures len(st) == 4 && len(sl) == 1600 && len(buf) <= 13116800 && 0 <= st[0] && st[0] <= 100000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1) && (st[1] == 0 || 65584 * st[3] + 65584 <= len(buf))
  ensures st[0] == old(st)[0] || st[0] == old(st)[0] + 1
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
{
  if (kd != 0 && kd != 1) || lo < 0 || hi < lo || hi > len(win) { return 1; }
  if kd == 1 {
    // a dropped over-long line: a user line there detaches the draft and marks the next one clipped
    let head: [u8] = crate::util::span_bytes(win, lo, hi - lo);
    if crate::framing::dropped_user(head) { crate::turns::skip_user(inout st); }  // MUT:M10 => if false { crate::turns::skip_user(inout st); }
    return 0;
  }
  let r: i64 = line_step(win, lo, hi, inout st, inout sl, inout buf);
  if r == 1 { return 2; }
  if r != 0 { return 1; }
  return 0;
}

// The read packet (mode 1, row width 10) of a stored history window. omitted = the window does not start at the file start.
// Framing (reference/tail.ts openLineWindow) walks the window once with a cursor; each event goes straight to the collector,
// so no event array is built. Events in file order:
//   kind 0: an LF-terminated line [lo,hi) of at most 1048576 bytes (CR stays in the span; empty lines produce no event)
//   kind 1: a drop marker for a line over 1048576 bytes (LF-terminated, or the unterminated final fragment); [lo,hi) = its first 8192 bytes
// omitted: everything up to and including the first LF is discarded (no LF: no event). An ordinary unterminated final fragment is ignored.
pub fn window(win: [u8], omitted: bool, title: str, model: str) -> [i64] ! alloc
  ensures len(result) >= 28
{
  if len(win) > 8388608 { return crate::packet::simple_error(1, 12, 6, 1); }
  if len(title) > 1000000 || len(model) > 20000000 { return crate::packet::simple_error(1, 12, 6, 2); }
  let n: i64 = len(win);
  let mut st: [i64] = crate::turns::new_state();
  let mut sl: [i64] = crate::turns::new_slots();
  let mut buf: [u8] = crate::turns::empty_buffer();
  let mut bad: i64 = 0;
  let mut j: i64 = 0;
  let mut p: i64 = crate::framing::scan_start(win, omitted);
  while p < n && bad == 0
    invariant 0 <= p && p <= n && n == len(win) && n <= 8388608 && 0 <= j && j <= p && 0 <= bad && bad <= 1
    invariant len(st) == 4 && len(sl) == 1600 && len(buf) <= 13116800 && 0 <= st[0] && st[0] <= 2 * j && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1) && (st[1] == 0 || 65584 * st[3] + 65584 <= len(buf))
    invariant forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
    invariant forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
    decreases n - p
  {
    let q: i64 = crate::framing::find_lf(win, p);
    let mut kd: i64 = -1;
    let lo: i64 = p;
    let mut hi: i64 = p;
    if q < 0 {
      if n - p > 1048576 { kd = 1; hi = p + 8192; }
      p = n;
    } else {
      let ln: i64 = q - p;
      if ln > 1048576 {
        kd = 1;
        hi = p + 8192;
      } else if ln > 0 {
        kd = 0;
        hi = q;
      }
      p = q + 1;
    }
    let mut r: i64 = 0;
    if kd >= 0 {
      r = event_step(win, kd, lo, hi, inout st, inout sl, inout buf);
      if r == 2 {
        buf = crate::turns::grow(buf, st[0]);
        r = event_step(win, kd, lo, hi, inout st, inout sl, inout buf);
      }
      j = j + 1;
    }
    if r != 0 { bad = 1; }
  }
  if bad != 0 { return crate::packet::simple_error(1, 12, 6, 2); }
  let col: crate::turns::Collected = crate::turns::finish(st, sl, buf, 0);
  return assemble(col, title, model, omitted);
}
