// Grok history entry -> TurnCollector calls (hand bench/l3/grok/perf/hand_history.rs Collector::feed, Entry::at).
// Step 2.11: feed takes the Entry that line::entry scanned from one line (no Document, no tape). Step 4.4d: feed has the
// hand order (filters first, the stamp only for an accepted entry, one begin / answer call); `user` is the hand user arm on
// the borrowed content str.
//  1. feed requires st[0] < 100000000 (a window has at most 4194304 lines) and ensures st[0] <= 100000000, so the owner can
//     chain calls without carrying the 1e12 bound of turns::begin.
//  2. the assistant arm adds the tool calls with one turns::tool(n) for any Some(n) (hand `tool(n)`; saturates at 1e15);
//     line::entry ensures the count is non-negative (row 4.4d-T0).

// lit occurs in s at byte position at (hand `s[at..].starts_with(lit)`).
fn has_at(s: str, at: i64, lit: str) -> bool
  requires 0 <= at
  ensures result ==> at + len(lit) <= len(s) && (forall k in 0..len(lit): s[at + k] == lit[k])
{
  if at > len(s) || len(lit) > len(s) - at { return false; }
  return eq_range(s, at, lit, 0, len(lit));
}

// hand query_range: trimmed = s[lo..hi). When it starts <user_query>, ends </user_query> and is at least 25 bytes (the tags may not
// overlap), the inner bounds after removing exactly one leading \r?\n and then one trailing \r?\n; else lo == -1 (the hand None).
// Both bounds follow or sit at an ASCII byte (`>`, `\n`, `<`, `\r`), so they are char boundaries (R-6b-5) and `user` borrows
// the range with no run-time test (hand `&txt[a..b]`).
fn query_range(s: str, lo: i64, hi: i64) -> crate::text::Span
  requires 0 <= lo && lo <= hi && hi <= len(s)
  ensures result.lo == -1 || (lo + 12 <= result.lo && result.lo <= result.hi && result.hi <= hi - 13)
  ensures result.lo == -1 || (is_char_boundary(s, result.lo) && is_char_boundary(s, result.hi))
{
  if hi - lo < 25 || !has_at(s, lo, "<user_query>") || !has_at(s, hi - 13, "</user_query>") { return crate::text::Span { lo: -1, hi: -1 }; }
  let mut a: i64 = lo + 12;
  let mut b: i64 = hi - 13;
  if a < b {
    let x: i64 = s[a];
    if x == 10 {
      a = a + 1;
    } else if x == 13 && a + 1 < b {
      let y: i64 = s[a + 1];
      if y == 10 { a = a + 2; }
    }
  }
  if a < b {
    let z: i64 = s[b - 1];
    if z == 10 {
      b = b - 1;
      if a < b {
        let w: i64 = s[b - 1];
        if w == 13 { b = b - 1; }
      }
    }
  }
  return crate::text::Span { lo: a, hi: b };
}


// hand Entry::at: isoOf(timestamp ?? created_at); a missing or null timestamp falls back to created_at. Called only for an
// accepted user or assistant entry (hand order). Returns the offset of the 24 stamp bytes in line (Stamp::Canon, borrowed), -2 when
// a numeric stamp was formatted into iso (reference behaviour; the hand inputs carry canonical strings only), -3 absent, -1 a defect.
fn at(line: [u8], e: crate::line::Entry, inout iso: [u8]) -> i64 ! alloc
  requires utf8_valid(line) && len(iso) == 0
  ensures result == -1 || result == -3 || (result == -2 && len(iso) == 24 && utf8_valid(iso)) || (0 < result && result < len(line) - 24 && line[result - 1] < 128 && line[result + 24] < 128)
{
  let mut sp: crate::line::Stamp = e.timestamp;
  match e.timestamp {
    crate::line::Stamp::Missing => { sp = e.created_at; }
    crate::line::Stamp::Null => { sp = e.created_at; }
    crate::line::Stamp::Other => {}
    crate::line::Stamp::Canon(p) => {}
    crate::line::Stamp::Num(v) => {}
  }
  match sp {
    crate::line::Stamp::Missing => { return -3; }
    crate::line::Stamp::Null => { return -3; }
    crate::line::Stamp::Other => { return -3; }
    crate::line::Stamp::Canon(p) => {
      // proof guard: line::stamp found the 24 bytes between ASCII quotes
      if 0 < p && p < len(line) - 24 && line[p - 1] < 128 && line[p + 24] < 128 { return p; }
      return -1;
    }
    crate::line::Stamp::Num(v) => {
      if v < -9007199254740991 || v > 9007199254740991 { return -1; }
      let ms: i64 = crate::time::integer_time(v);
      if ms == 9223372036854775807 { return -3; }
      iso = crate::time::format_iso(ms);
      if len(iso) != 24 || !utf8_valid(iso) { return -1; }
      return -2;
    }
  }
}

// The stamp chosen by `at` as one borrowed str: iso (k == -2), none (k == -3) or the 24 bytes of line at k.
fn at_view(line: [u8], iso: [u8], k: i64) -> ref str from(line, iso)
  requires utf8_valid(line)
  requires (k == -2 && len(iso) == 24 && utf8_valid(iso)) || k == -3 || (0 < k && k < len(line) - 24 && line[k - 1] < 128 && line[k + 24] < 128)
  ensures len(result) == 0 || len(result) == 24
{
  if k == -2 { return subview(iso, 0, 24); }
  if k == -3 { return subview(line, 0, 0); }
  return subview(line, k, k + 24);
}

// hand Collector::feed. A non-object line and other entry types do nothing; -1 = a timestamp defect (time::iso_of).
// line is the scanned line: a Stamp::Canon offset borrows its 24 bytes from it. The stamp is resolved only after the filters
// (hand `e.at()` in the begin / answer call).
pub fn feed(line: [u8], e: crate::line::Entry, inout st: [i64], inout sl: [i64], inout bk: crate::turns::Store) -> i64 ! alloc
  requires utf8_valid(line) && len(line) <= 1048576 && utf8_valid_span(e.content, 0, len(e.content)) && len(e.content) <= len(line)
  requires is_some(e.tool_calls) ==> some_val(e.tool_calls) >= 0
  requires len(st) == 4 && len(sl) == 1600 && 0 <= st[0] && st[0] < 100000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1) && len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  ensures len(st) == 4 && len(sl) == 1600 && 0 <= st[0] && st[0] <= 100000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1) && len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  ensures st[0] == old(st)[0] || st[0] == old(st)[0] + 1
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
{
  if !e.is_obj { return 0; }
  if e.ty == 1 {
    // hand: return unless synthetic_reason is missing or null
    match e.synthetic {
      crate::line::Kind::Missing => {}
      crate::line::Kind::Null => {}
      crate::line::Kind::Other => { return 0; }  // MUT:M09 => crate::line::Kind::Other => {}
      crate::line::Kind::Str => { return 0; }
      crate::line::Kind::Arr => { return 0; }
    }
    return user(line, e, subview(e.content, 0, len(e.content)), inout st, inout sl, inout bk);
  }
  if e.ty == 2 {
    let mut iso: [u8] = alloc(0, 0);
    let k: i64 = at(line, e, inout iso);
    if k == -1 { return -1; }
    crate::turns::answer2(inout st, inout sl, inout bk, subview(e.content, 0, len(e.content)), at_view(line, iso, k));
    match e.tool_calls {
      Some(n) => { crate::turns::tool(inout st, inout sl, n); }  // MUT:M11 => Some(n) => { crate::turns::tool(inout st, inout sl, 1); }
      None => {}
    }
  }
  return 0;
}

// The hand user arm of Collector::feed on the borrowed content str: the prompt is the <user_query> interior or the whole text
// (the <user_info> skip only when prompt_index is missing or null), then one begin with the stamp.
fn user(line: [u8], e: crate::line::Entry, txt: str, inout st: [i64], inout sl: [i64], inout bk: crate::turns::Store) -> i64 ! alloc
  requires utf8_valid(line) && len(txt) <= 100000000
  requires len(st) == 4 && len(sl) == 1600 && 0 <= st[0] && st[0] < 100000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1) && len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  ensures len(st) == 4 && len(sl) == 1600 && 0 <= st[0] && st[0] <= 100000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1) && len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  ensures st[0] == old(st)[0] || st[0] == old(st)[0] + 1
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
{
  let tr: crate::text::Span = crate::text::trim_span(txt);
  let q: crate::text::Span = query_range(txt, tr.lo, tr.hi);
  let mut a: i64 = 0;
  let mut b: i64 = len(txt);
  if q.lo >= 0 {
    a = q.lo; b = q.hi;  // MUT:M08 => let t2: crate::text::Span = crate::text::trim_span(subview(txt, q.lo, q.hi)); a = q.lo + t2.lo; b = q.lo + t2.hi;
  } else {
    // hand: prompt_index is read only when there is no query tag
    let mut nopi: bool = false;
    match e.prompt_index {
      crate::line::Kind::Missing => { nopi = true; }
      crate::line::Kind::Null => { nopi = true; }
      crate::line::Kind::Other => {}
      crate::line::Kind::Str => {}
      crate::line::Kind::Arr => {}
    }
    if nopi && has_at(txt, tr.lo, "<user_info>") { return 0; }
  }
  if crate::text::is_blank(subview(txt, a, b)) { return 0; }
  let mut iso: [u8] = alloc(0, 0);
  let k: i64 = at(line, e, inout iso);
  if k == -1 { return -1; }
  crate::turns::begin2(inout st, inout sl, inout bk, subview(txt, a, b), at_view(line, iso, k));
  return 0;
}
