// Grok history entry -> TurnCollector calls (hand bench/l3/grok/perf/hand_history.rs Collector::feed, Entry::at).
// Step 2.11: feed takes the Entry that line::entry scanned from one line (no Document, no tape). user_view and
// assistant_view hold the decisions of the hand user and assistant arms on borrowed strs.
//  1. feed requires st[0] < 100000000 (a window has at most 4194304 lines) and ensures st[0] <= 100000000, so the owner can
//     chain calls without carrying the 1e12 bound of turns::begin.
//  2. assistant_view adds the tool calls with one turns::tool(n) (hand `tool(n)`; saturates at 1e15).

// isoOf(timestamp ?? created_at) of the entry object (root id 0): "" absent, 24 bytes present, 1 byte = iso_of defect.
// A present timestamp that is not null never falls back to created_at (an invalid one is simply absent).

// lit occurs in s at byte position at.
fn has_at(s: str, at: i64, lit: str) -> bool
  requires 0 <= at
{
  if at > len(s) || len(lit) > len(s) - at { return false; }
  let mut k: i64 = 0;
  while k < len(lit)
    invariant 0 <= k && k <= len(lit) && 0 <= at && at <= len(s) && len(lit) <= len(s) - at
    decreases len(lit) - k
  {
    let a: i64 = s[at + k];
    let b: i64 = lit[k];
    if a != b { return false; }
    k = k + 1;
  }
  return true;
}

// hand query_range: trimmed = s[lo..hi). When it starts <user_query>, ends </user_query> and is at least 25 bytes (the tags may not
// overlap), the inner bounds after removing exactly one leading \r?\n and then one trailing \r?\n; else lo == -1 (the hand None).
fn query_range(s: str, lo: i64, hi: i64) -> crate::text::Span
  requires 0 <= lo && lo <= hi && hi <= len(s)
  ensures result.lo == -1 || (lo + 12 <= result.lo && result.lo <= result.hi && result.hi <= hi - 13)
{
  if hi - lo < 25 || !has_at(s, lo, "<user_query>") || !has_at(s, hi - 13, "</user_query>") { return crate::text::Span { lo: -1, hi: -1 }; }
  let mut a: i64 = lo + 12;
  let mut b: i64 = hi - 13;
  if a < b {
    let x: i64 = s[a];
    if x == 10 {
      a = a + 1;
    } else if x == 13 && a + 1 < b {
      let y: i64 = s[a + 1];
      if y == 10 { a = a + 2; }
    }
  }
  if a < b {
    let z: i64 = s[b - 1];
    if z == 10 {
      b = b - 1;
      if a < b {
        let w: i64 = s[b - 1];
        if w == 13 { b = b - 1; }
      }
    }
  }
  return crate::text::Span { lo: a, hi: b };
}


// hand Collector::feed. A non-object line and other entry types do nothing; -1 = a timestamp defect (time::iso_of).
// line is the scanned line: a Stamp::Canon offset borrows its 24 bytes from it.
pub fn feed(line: [u8], e: crate::line::Entry, inout st: [i64], inout sl: [i64], inout bk: crate::turns::Store) -> i64 ! alloc
  requires utf8_valid(line) && utf8_valid_span(e.content, 0, len(e.content))
  requires len(st) == 4 && len(sl) == 1600 && 0 <= st[0] && st[0] < 100000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1) && len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  ensures len(st) == 4 && len(sl) == 1600 && 0 <= st[0] && st[0] <= 100000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1) && len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  ensures st[0] == old(st)[0] || st[0] == old(st)[0] + 1
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
{
  if !e.is_obj { return 0; }
  // hand Entry::at: timestamp, or created_at when timestamp is missing or null
  let mut fall: bool = false;
  match e.timestamp {
    crate::line::Stamp::Missing => { fall = true; }
    crate::line::Stamp::Null => { fall = true; }
    crate::line::Stamp::Other => {}
    crate::line::Stamp::Canon(p) => {}
    crate::line::Stamp::Num(v) => {}
  }
  let mut sp: crate::line::Stamp = e.timestamp;
  if fall { sp = e.created_at; }
  let mut lo: i64 = 0;
  let mut hi: i64 = 0;
  let mut iso: [u8] = alloc(0, 0);
  match sp {
    crate::line::Stamp::Missing => {}
    crate::line::Stamp::Null => {}
    crate::line::Stamp::Other => {}
    crate::line::Stamp::Canon(p) => {
      // proof guard: line::stamp found the 24 bytes between ASCII quotes
      if 0 < p && p < len(line) - 24 && line[p - 1] < 128 && line[p + 24] < 128 { lo = p; hi = p + 24; }
      else { return -1; }
    }
    crate::line::Stamp::Num(v) => {
      if v < -9007199254740991 || v > 9007199254740991 { return -1; }
      let ms: i64 = crate::time::integer_time(v);
      if ms != 9223372036854775807 {
        iso = crate::time::format_iso(ms);
        if len(iso) != 24 { return -1; }
        if !utf8_valid(iso) { return -1; }
      }
    }
  }
  if e.ty == 1 {
    // hand: skip = synthetic_reason present and not null; nopi = prompt_index missing or null
    let mut skip: bool = true;
    match e.synthetic {
      crate::line::Kind::Missing => { skip = false; }
      crate::line::Kind::Null => { skip = false; }
      crate::line::Kind::Other => {}  // MUT:M09 => crate::line::Kind::Other => { skip = false; }
      crate::line::Kind::Str => {}
      crate::line::Kind::Arr => {}
    }
    let mut nopi: bool = false;
    match e.prompt_index {
      crate::line::Kind::Missing => { nopi = true; }
      crate::line::Kind::Null => { nopi = true; }
      crate::line::Kind::Other => {}
      crate::line::Kind::Str => {}
      crate::line::Kind::Arr => {}
    }
    if len(iso) == 24 { return user_view(subview(e.content, 0, len(e.content)), subview(iso, 0, 24), skip, nopi, inout st, inout sl, inout bk); }
    return user_view(subview(e.content, 0, len(e.content)), subview(line, lo, hi), skip, nopi, inout st, inout sl, inout bk);
  }
  if e.ty == 2 {
    let mut tools: i64 = -1;
    match e.tool_calls {
      Some(n) => { tools = n; }
      None => {}
    }
    if len(iso) == 24 { return assistant_view(subview(e.content, 0, len(e.content)), subview(iso, 0, 24), tools, inout st, inout sl, inout bk); }
    return assistant_view(subview(e.content, 0, len(e.content)), subview(line, lo, hi), tools, inout st, inout sl, inout bk);
  }
  return 0;
}

// The hand user arm of Collector::feed on borrowed strs: prompt is the content text and at the stamp ("" or 24 bytes); skip =
// synthetic_reason neither missing nor null; nopi = prompt_index missing or null.
pub fn user_view(prompt: str, at: str, skip: bool, nopi: bool, inout st: [i64], inout sl: [i64], inout bk: crate::turns::Store) -> i64 ! alloc
  requires len(at) == 0 || len(at) == 24
  requires len(st) == 4 && len(sl) == 1600 && 0 <= st[0] && st[0] < 100000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1) && len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  ensures result == 0 || result == -1
  ensures len(st) == 4 && len(sl) == 1600 && 0 <= st[0] && st[0] <= 100000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1) && len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  ensures st[0] == old(st)[0] || st[0] == old(st)[0] + 1
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
{
  if skip { return 0; }
  if len(prompt) > 100000000 { return -1; }
  let tr: crate::text::Span = crate::text::trim_span(prompt);
  let q: crate::text::Span = query_range(prompt, tr.lo, tr.hi);
  if q.lo >= 0 {
    // user_query wins over everything: only the inner text, borrowed (the tags are ASCII, so the cut points are boundaries)
    let a: i64 = q.lo;
    let b: i64 = q.hi;
    if !is_char_boundary(prompt, a) || !is_char_boundary(prompt, b) { return -1; }
    if crate::text::is_blank(subview(prompt, a, b)) { return 0; }
    crate::turns::begin2(inout st, inout sl, inout bk, subview(prompt, a, b), at);  // MUT:M08 => crate::turns::begin2(inout st, inout sl, inout bk, crate::text::trim(subview(prompt, a, b)), at);
    return 0;
  }
  if nopi && has_at(prompt, tr.lo, "<user_info>") { return 0; }
  if crate::text::is_blank(prompt) { return 0; }
  crate::turns::begin2(inout st, inout sl, inout bk, prompt, at);
  return 0;
}

// type == "assistant": answer(contentText, at) even for empty text, then tools tool calls (tools < 0: tool_calls is not an array).
pub fn assistant_view(text: str, at: str, tools: i64, inout st: [i64], inout sl: [i64], inout bk: crate::turns::Store) -> i64 ! alloc
  requires len(at) == 0 || len(at) == 24
  requires len(st) == 4 && len(sl) == 1600 && 0 <= st[0] && st[0] < 100000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1) && len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  ensures result == 0 || result == -1
  ensures len(st) == 4 && len(sl) == 1600 && 0 <= st[0] && st[0] <= 100000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1) && len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  ensures st[0] == old(st)[0] || st[0] == old(st)[0] + 1
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
{
  if len(text) > 100000000 { return -1; }
  crate::turns::answer2(inout st, inout sl, inout bk, text, at);
  if tools > 0 { crate::turns::tool(inout st, inout sl, tools); }  // MUT:M11 => if tools > 0 { crate::turns::tool(inout st, inout sl, 1); }
  return 0;
}
