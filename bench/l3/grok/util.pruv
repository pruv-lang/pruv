// Grok import helpers: bytes/str conversion, tape access and JSON fragment serialization.
// to_bytes, str_at, raw, elements and escaped follow bench/l3/codex/util.pruv; json_value and the cfg helpers are new.

pub fn to_bytes(s: str) -> [u8] ! alloc
  ensures len(result) == len(s)
{
  let mut b: [u8] = alloc(len(s), 0);
  let mut i: i64 = 0;
  while i < len(s)
    invariant 0 <= i && i <= len(s) && len(b) == len(s)
    decreases len(s) - i
  { b[i] = s[i]; i = i + 1; }
  return b;
}

// The bytes t[s..s+l]; empty for an absent or invalid ref.
pub fn span_bytes(t: [u8], s: i64, l: i64) -> [u8] ! alloc
  ensures len(result) <= len(t)
{
  let empty: [u8] = alloc(0, 0);
  if !crate::packet::ref_ok(s, l, len(t)) || s < 0 { return empty; }
  let mut b: [u8] = alloc(l, 0);
  crate::bytes::copy_span(inout b, 0, t, s, s + l);
  return b;
}

// cfg_text[s..s+l] as text (valid UTF-8 only; "" for an absent ref, an invalid ref, invalid UTF-8 or more than 1000000 bytes).
pub fn cfg_str(t: [u8], s: i64, l: i64) -> str ! alloc
  ensures len(result) <= 1000000
{
  let none: str = "";
  if !crate::packet::ref_ok(s, l, len(t)) || s < 0 || l > 1000000 { return copy(none); }
  let b: [u8] = span_bytes(t, s, l);
  let x: str = crate::jstr::owned_text(move b);
  if len(x) > 1000000 { return copy(none); }
  return copy(x);
}

// t[s..s+l] as text like cfg_str but up to 20000000 bytes (summary.json can grow past its size check up to the
// 16 MiB growth cap, and the reference keeps the model whatever its length).
pub fn long_str(t: [u8], s: i64, l: i64) -> str ! alloc
  ensures len(result) <= 20000000
{
  let none: str = "";
  if !crate::packet::ref_ok(s, l, len(t)) || s < 0 || l > 20000000 { return copy(none); }
  let b: [u8] = span_bytes(t, s, l);
  let x: str = crate::jstr::owned_text(move b);
  if len(x) > 20000000 { return copy(none); }
  return copy(x);
}

// The source bytes of value id (the whole raw token, strings with their quotes); empty on a bad id or corrupt tape.
pub fn raw(d: crate::json::JsonDocument, id: i64) -> [u8] ! alloc
{
  let s: crate::access::Span = crate::access::raw_span(d, id);
  if s.status != 0 { let e: [u8] = alloc(0, 0); return e; }
  let mut b: [u8] = alloc(s.end - s.start, 0);
  let mut i: i64 = 0;
  while i < len(b)
    invariant 0 <= i && i <= len(b) && len(b) == s.end - s.start
    decreases len(b) - i
  { b[i] = d.source[s.start + i]; i = i + 1; }
  return b;
}

fn hex(d: i64) -> i64
  requires 0 <= d && d <= 15
  ensures 48 <= result && result <= 102
{
  if d < 10 { return 48 + d; }
  return 87 + d;
}
// JSON string content of s (no surrounding quotes): quote, backslash and C0 controls escaped.
pub fn escaped(s: str) -> [u8] ! alloc
  requires len(s) <= 100000000
  ensures len(result) <= 6 * len(s)
{
  let mut out: [u8] = alloc(6 * len(s), 0);
  let mut i: i64 = 0;
  let mut n: i64 = 0;
  while i < len(s)
    invariant 0 <= i && i <= len(s) && 0 <= n && n <= 6 * i && len(out) == 6 * len(s)
    decreases len(s) - i
  {
    let c: i64 = s[i];
    if c == 34 { out[n] = 92; out[n + 1] = 34; n = n + 2; }
    else if c == 92 { out[n] = 92; out[n + 1] = 92; n = n + 2; }
    else if c < 32 { out[n] = 92; out[n + 1] = 117; out[n + 2] = 48; out[n + 3] = 48; out[n + 4] = hex(c / 16); out[n + 5] = hex(c % 16); n = n + 6; }
    else { out[n] = c; n = n + 1; }
    i = i + 1;
  }
  let mut r: [u8] = alloc(n, 0);
  let mut j: i64 = 0;
  while j < n
    invariant 0 <= j && j <= n && n <= len(out) && len(r) == n
    decreases n - j
  { r[j] = out[j]; j = j + 1; }
  return r;
}

// The decoded text of string value id (lone surrogates became U+FFFD in the decoder, policy P2); "" for anything else.
pub fn str_at(d: crate::json::JsonDocument, id: i64) -> str ! alloc
  ensures len(result) <= 50331648
{
  let none: str = "";
  let t: crate::jstr::Text = crate::access::string_text_scanned_owned(d, id);
  match t {
    crate::jstr::Text::Decoded(x) => {
      if len(x) > 50331648 { return copy(none); }
      return copy(x);
    }
    crate::jstr::Text::InternalInvariant(e) => { return copy(none); }
  }
}

// Ids of the elements of array value c in order (empty for anything else or a corrupt tape). One pass over the tape.
pub fn elements(d: crate::json::JsonDocument, c: i64) -> [i64] ! alloc
{
  let empty: [i64] = alloc(0, 0);
  let n: i64 = crate::access::array_length(d, c);
  if n <= 0 || n > 1048576 { return empty; }
  if len(d.tape) > 6291456 || c < 0 || c >= len(d.tape) / 6 { return empty; }
  let stop: i64 = d.tape[6 * c + 3];
  if stop <= c || stop > len(d.tape) / 6 { return empty; }
  let mut ids: [i64] = alloc(n, 0);
  let mut j: i64 = c + 1;
  let mut k: i64 = 0;
  while j < stop && k < n
    invariant 0 <= c && c < j && j <= stop && stop <= len(d.tape) / 6 && len(d.tape) <= 6291456
    invariant 0 <= k && k <= n && len(ids) == n
    decreases stop - j
  {
    let next: i64 = d.tape[6 * j + 3];
    if next <= j || next > stop || d.tape[6 * j + 4] != c { return empty; }
    ids[k] = j; k = k + 1; j = next;
  }
  if k != n { return empty; }
  return ids;
}

// Grow b (first `used` bytes kept) so that at least n bytes are free after `used`. Only called when room is short.
fn reserve(b: [u8], used: i64, n: i64) -> [u8] ! alloc
  requires 0 <= used && used <= len(b) && len(b) <= 200000000 && 0 <= n && n <= 100000000 - used
  ensures len(result) >= used + n && len(result) <= 200000000
{
  let mut want: i64 = 2 * (used + n);
  if want < len(b) { want = len(b); }
  if want < 64 { want = 64; }
  let mut o: [u8] = alloc(want, 0);
  crate::bytes::copy_span(inout o, 0, b, 0, used);
  return o;
}

// One record's token text. A string token is empty only when it would pass about 49 MB; other kinds keep their
// raw length (a raw span is at most 16 MiB).
fn token(d: crate::json::JsonDocument, j: i64, k: i64, s: i64, e: i64) -> [u8] ! alloc
  requires 0 <= k && k <= 7 && 0 <= s && s <= e && e <= len(d.source) && e <= 16777216
  ensures len(result) <= 49000000
{
  let empty: [u8] = alloc(0, 0);
  if k == 4 {
    let body: [u8] = escaped(str_at(d, j));
    let tl: i64 = len(body) + 2;
    if tl > 49000000 { return empty; }
    let mut tok: [u8] = alloc(tl, 0);
    tok[0] = 34; tok[tl - 1] = 34;
    crate::bytes::copy_span(inout tok, 1, body, 0, len(body));
    return tok;
  }
  if k == 5 { let mut a: [u8] = alloc(1, 0); a[0] = 91; return a; }
  if k == 6 { let mut b: [u8] = alloc(1, 0); b[0] = 123; return b; }
  let mut tl: i64 = e - s;
  if k == 7 { tl = tl + 1; }
  let mut tok: [u8] = alloc(tl, 0);
  crate::bytes::copy_span(inout tok, 0, d.source, s, e);
  if k == 7 { tok[tl - 1] = 58; }
  return tok;
}

// JSON fragment of the subtree at id: number and literal tokens keep their raw source text, object keys keep their raw
// escaped source spelling (with quotes), string values are written re-escaped from the decoded value (lone surrogates
// are U+FFFD), no whitespace. Each tape record is visited once, in order, with an explicit container stack (depth <= 129).
// Empty result = bad id, corrupt tape, or output over about 49 MB; a real fragment is never empty.
pub fn json_value(d: crate::json::JsonDocument, id: i64) -> [u8] ! alloc
{
  let empty: [u8] = alloc(0, 0);
  if len(d.tape) > 6291456 || id < 0 || id >= len(d.tape) / 6 { return empty; }
  let nrec: i64 = len(d.tape) / 6;
  let stop: i64 = d.tape[6 * id + 3];
  if stop <= id || stop > nrec { return empty; }
  if d.tape[6 * id] < 0 || d.tape[6 * id] > 6 { return empty; }
  let mut out: [u8] = alloc(64, 0);
  let mut used: i64 = 0;
  let mut stk: [i64] = alloc(130, 0);
  let mut sp: i64 = 0;
  let mut j: i64 = id;
  while j < stop
    invariant 0 <= id && id <= j && j <= stop && stop <= nrec && nrec == len(d.tape) / 6 && len(d.tape) <= 6291456
    invariant 0 <= sp && sp <= 129 && len(stk) == 130
    invariant forall q in 0..sp: (0 <= stk[q] && stk[q] < nrec)
    invariant 0 <= used && used <= len(out) && len(out) <= 200000000
    decreases stop - j
  {
    let k: i64 = d.tape[6 * j];
    let s: i64 = d.tape[6 * j + 1];
    let e: i64 = d.tape[6 * j + 2];
    if k < 0 || k > 7 { return empty; }
    if s < 0 || e < s || e > len(d.source) || e > 16777216 { return empty; }
    let tok: [u8] = token(d, j, k, s, e);
    let tl: i64 = len(tok);
    if (k == 4 && tl == 0) || used > 49000000 { return empty; }
    let need: i64 = tl + sp + 8;
    if len(out) - used < need { out = reserve(out, used, need); }
    // close the containers that ended before this record
    while sp > 0 && d.tape[6 * stk[sp - 1] + 3] == j
      invariant 0 <= sp && sp <= 129 && len(stk) == 130 && nrec == len(d.tape) / 6 && len(d.tape) <= 6291456
      invariant forall q in 0..sp: (0 <= stk[q] && stk[q] < nrec)
      invariant 0 <= used && used <= len(out) && len(out) - used >= sp + tl + 8 && tl >= 0 && len(out) <= 200000000 && used + sp <= 49000129
      decreases sp
    {
      let c: i64 = stk[sp - 1];
      if d.tape[6 * c] == 5 { out[used] = 93; } else { out[used] = 125; }
      used = used + 1;
      sp = sp - 1;
    }
    if j != id {
      if sp == 0 { return empty; }
      let c2: i64 = stk[sp - 1];
      if d.tape[6 * j + 4] != c2 { return empty; }
      if j != c2 + 1 && (k == 7 || d.tape[6 * c2] == 5) { out[used] = 44; used = used + 1; }
    }
    crate::bytes::copy_span(inout out, used, tok, 0, tl);
    used = used + tl;
    if k == 5 || k == 6 {
      if sp >= 129 { return empty; }
      stk[sp] = j;
      sp = sp + 1;
    }
    j = j + 1;
  }
  if used > 90000000 { return empty; }
  if len(out) - used < sp + 1 { out = reserve(out, used, sp + 1); }
  while sp > 0 && d.tape[6 * stk[sp - 1] + 3] == stop
    invariant 0 <= sp && sp <= 129 && len(stk) == 130 && nrec == len(d.tape) / 6 && len(d.tape) <= 6291456
    invariant forall q in 0..sp: (0 <= stk[q] && stk[q] < nrec)
    invariant 0 <= used && used <= len(out) && len(out) - used >= sp
    decreases sp
  {
    let c: i64 = stk[sp - 1];
    if d.tape[6 * c] == 5 { out[used] = 93; } else { out[used] = 125; }
    used = used + 1;
    sp = sp - 1;
  }
  if sp != 0 { return empty; }
  return truncate(out, used);
}
