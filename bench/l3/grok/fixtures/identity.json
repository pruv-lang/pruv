[
  {"name": "identity-home-symlink-ok", "mode": "list", "source": {"home": "$SRC/link"},
   "tree": [{"path": "$SRC/link", "kind": "symlink", "target": "real"}],
   "gen": [{"session": {"home": "$SRC/real", "thread": "A"}}], "expected": {"status": "ok", "nrows": 1}},
  {"name": "identity-sessions-symlink-list", "mode": "list", "kills": ["M02"],
   "tree": [{"path": "$SRC/sessions", "kind": "symlink", "target": "store/sessions"}],
   "gen": [{"session": {"home": "$SRC/store", "thread": "A"}}], "expected": {"status": "ok", "nrows": 0}},
  {"name": "identity-sessions-symlink-read", "mode": "read", "kills": ["M02"],
   "tree": [{"path": "$SRC/sessions", "kind": "symlink", "target": "store/sessions"}],
   "gen": [{"session": {"home": "$SRC/store", "thread": "A", "history": [{"type": "user", "content": "x"}]}}],
   "expected": {"status": "error", "class": "EngineImportError", "code": "not-found"}},
  {"name": "identity-folder-symlink-list", "mode": "list", "kills": ["M02"],
   "tree": [{"path": "$SRC/sessions/%2Fwork", "kind": "symlink", "target": "../elsewhere"}],
   "gen": [{"session": {"enc": "../elsewhere", "thread": "A"}}], "expected": {"status": "ok", "nrows": 0}},
  {"name": "identity-folder-symlink-read", "mode": "read", "kills": ["M02"],
   "tree": [{"path": "$SRC/sessions/%2Fwork", "kind": "symlink", "target": "../elsewhere"}],
   "gen": [{"session": {"enc": "../elsewhere", "thread": "A", "history": [{"type": "user", "content": "x"}]}}],
   "expected": {"status": "error", "class": "EngineImportError", "code": "not-found"}},
  {"name": "identity-thread-symlink-list", "mode": "list",
   "gen": [{"session": {"thread": "R"}}, {"session": {"thread": "L", "link": "R"}}, {"session": {"thread": "Z", "link": "R"}}],
   "schedule": {"readdir": [{"path": "$SRC/sessions/%2Fwork", "names": ["R", "L", "Z"]}]},
   "expected": {"status": "ok", "nrows": 1}},
  {"name": "identity-thread-symlink-read", "mode": "read", "thread": "L", "kills": ["M02"],
   "gen": [{"session": {"thread": "R", "history": [{"type": "user", "content": "x"}]}}, {"session": {"thread": "L", "link": "R"}}],
   "expected": {"status": "error", "class": "EngineImportError", "code": "not-found"}},
  {"name": "identity-summary-symlink", "mode": "list",
   "tree": [{"path": "$SRC/outside.json", "kind": "file", "bytes": {"utf8": "{\"info\":{\"id\":\"A\",\"cwd\":\"/work\"},\"generated_title\":\"out\"}"}}],
   "gen": [{"session": {"thread": "A", "no_summary": true, "files": {"summary.json": {"kind": "symlink", "target": "$SRC/outside.json"}}}}],
   "expected": {"status": "ok", "nrows": 0}},
  {"name": "identity-history-symlink", "mode": "read",
   "tree": [{"path": "$SRC/outside.jsonl", "kind": "file", "bytes": {"utf8": "{\"type\":\"user\",\"content\":\"out\"}\n"}}],
   "gen": [{"session": {"thread": "A", "files": {"chat_history.jsonl": {"kind": "symlink", "target": "$SRC/outside.jsonl"}}}}],
   "expected": {"status": "error", "class": "EngineImportError", "code": "not-found"}},
  {"name": "identity-summary-fifo", "mode": "list",
   "gen": [{"session": {"thread": "A", "no_summary": true, "files": {"summary.json": {"kind": "fifo"}}}}],
   "expected": {"status": "ok", "nrows": 0}, "watchdog": 30},
  {"name": "identity-summary-is-directory", "mode": "list",
   "gen": [{"session": {"thread": "A", "no_summary": true, "files": {"summary.json": {"kind": "dir"}}}}],
   "expected": {"status": "ok", "nrows": 0}},
  {"name": "identity-hardlink-accepted", "mode": "list",
   "tree": [{"path": "$SRC/other.json", "kind": "file", "bytes": {"utf8": "{\"info\":{\"id\":\"A\",\"cwd\":\"/work\"},\"generated_title\":\"hl\"}"}}],
   "gen": [{"session": {"thread": "A", "no_summary": true, "files": {"summary.json": {"kind": "hardlink", "of": "$SRC/other.json"}}}}],
   "expected": {"status": "ok", "nrows": 1}},
  {"name": "identity-small-inside", "mode": "small-json", "smallHomeReal": "$SRC_REAL/h", "smallPath": "$SRC/h/x.json",
   "tree": [{"path": "$SRC/h", "kind": "dir"}, {"path": "$SRC/h/x.json", "kind": "file", "bytes": {"utf8": "{\"a\":1}"}}],
   "expected": {"status": "ok", "present": true}},
  {"name": "identity-sibling-prefix-outside", "mode": "small-json", "smallHomeReal": "$SRC_REAL/h", "smallPath": "$SRC/h2/x.json",
   "tree": [{"path": "$SRC/h", "kind": "dir"}, {"path": "$SRC/h2/x.json", "kind": "file", "bytes": {"utf8": "{\"a\":1}"}}],
   "expected": {"status": "ok", "present": false}},
  {"name": "identity-race-history-replaced", "mode": "read", "kills": ["M03"],
   "gen": [{"session": {"thread": "A",
     "history": [{"type": "user", "content": "original"}, {"type": "assistant", "content": "ok"}],
     "files": {"keep.bin": {"kind": "hardlink", "of": "$SRC/sessions/%2Fwork/A/chat_history.jsonl"}}}}],
   "schedule": {"rules": [{"match": {"op": "open", "path": "$SRC/sessions/%2Fwork/A/chat_history.jsonl", "barrier": "before-call"},
     "actions": [{"kind": "replace-file", "path": "$SRC/sessions/%2Fwork/A/chat_history.jsonl", "mode": 420,
                  "bytes": {"utf8": "{\"type\":\"user\",\"content\":\"REPLACED\"}\n{\"type\":\"assistant\",\"content\":\"evil\"}\n"}}]}]},
   "expected": {"status": "error", "class": "EngineImportError", "code": "read-failed"}},
  {"name": "identity-race-small-json-replaced", "mode": "small-json", "kills": ["M03"], "smallPath": "$SRC/x.json",
   "tree": [{"path": "$SRC/x.json", "kind": "file", "bytes": {"utf8": "{\"orig\":true}"}}, {"path": "$SRC/keep.json", "kind": "hardlink", "of": "$SRC/x.json"}],
   "schedule": {"rules": [{"match": {"op": "open", "path": "$SRC/x.json", "barrier": "before-call"},
     "actions": [{"kind": "replace-file", "path": "$SRC/x.json", "mode": 420, "bytes": {"utf8": "{\"evil\":true}"}}]}]},
   "expected": {"status": "ok", "present": false}},
  {"name": "identity-race-after-open-harmless", "mode": "read",
   "gen": [{"session": {"thread": "A",
     "history": [{"type": "user", "content": "original"}, {"type": "assistant", "content": "ok"}],
     "files": {"keep.bin": {"kind": "hardlink", "of": "$SRC/sessions/%2Fwork/A/chat_history.jsonl"}}}}],
   "schedule": {"rules": [{"match": {"op": "fstat", "path": "$SRC/sessions/%2Fwork/A/chat_history.jsonl", "barrier": "before-call"},
     "actions": [{"kind": "replace-file", "path": "$SRC/sessions/%2Fwork/A/chat_history.jsonl", "mode": 420,
                  "bytes": {"utf8": "{\"type\":\"user\",\"content\":\"REPLACED\"}\n"}}]}]}},
  {"name": "identity-race-ancestor-swapped", "mode": "read", "source": {"home": "$SRC/h"},
   "tree": [{"path": "$SRC/out/chat_history.jsonl", "kind": "file", "bytes": {"utf8": "{\"type\":\"user\",\"content\":\"outside\"}\n"}}],
   "gen": [{"session": {"home": "$SRC/h", "thread": "A", "history": [{"type": "user", "content": "inside"}]}}],
   "schedule": {"rules": [{"match": {"op": "realpath", "path": "$SRC/sessions/%2Fwork/A/chat_history.jsonl", "barrier": "before-call"},
     "actions": [{"kind": "symlink", "path": "$SRC/sessions/%2Fwork/A", "target": "../../../out"}]}]},
   "expected": {"status": "error", "class": "EngineImportError", "code": "not-found"}}
]
