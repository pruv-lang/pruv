[
  {"name": "read-basic", "mode": "read",
   "gen": [{"session": {"thread": "A", "history": [
     {"type": "user", "content": "hello", "timestamp": "2024-01-02T03:04:05.000Z"}, {"type": "assistant", "content": "world", "timestamp": "2024-01-02T03:04:06.000Z"}]}}],
   "expected": {"status": "ok", "nrows": 1, "omitted": false, "title": "Title A"}},
  {"name": "read-title-and-model-priority", "mode": "read",
   "gen": [{"session": {"thread": "A", "summary": {"generated_title": "  ", "session_summary": "  from summary  ", "current_model_id": "  grok-4  "},
     "history": [{"type": "user", "content": "q"}, {"type": "assistant", "content": "a"}]}}],
   "expected": {"status": "ok", "title": "from summary", "model": "grok-4"}},
  {"name": "read-title-model-absent", "mode": "read",
   "gen": [{"session": {"thread": "A", "summary": {"generated_title": {"$del": 1}, "current_model_id": "   "},
     "history": [{"type": "user", "content": "q"}]}}],
   "expected": {"status": "ok", "title": null, "model": null}},
  {"name": "read-long-model-not-limited", "mode": "read",
   "gen": [{"session": {"thread": "A", "summary": {"current_model_id": {"$rep": "m", "n": 300}, "generated_title": {"$rep": "t", "n": 300}},
     "history": [{"type": "user", "content": "q"}]}}]},
  {"name": "read-model-not-string", "mode": "read",
   "gen": [{"session": {"thread": "A", "summary": {"current_model_id": 5, "generated_title": 7, "session_summary": "ok"},
     "history": [{"type": "user", "content": "q"}]}}],
   "expected": {"status": "ok", "model": null, "title": "ok"}},
  {"name": "read-title-cut-split-scalar-p2", "mode": "read",
   "gen": [{"session": {"thread": "A", "summary": {"generated_title": {"$cat": [{"$rep": "a", "n": 119}, "😀z"]}},
     "history": [{"type": "user", "content": "q"}]}}]},
  {"name": "read-title-whitespace-collapse", "mode": "read",
   "gen": [{"session": {"thread": "A", "summary": {"generated_title": "  a \t\n  b  c d  "},
     "history": [{"type": "user", "content": "q"}]}}]},
  {"name": "read-no-history-file", "mode": "read",
   "gen": [{"session": {"thread": "A"}}], "expected": {"status": "error", "class": "EngineImportError", "code": "not-found"}},
  {"name": "read-missing-home", "mode": "read", "source": {"home": "$SRC/missing"},
   "expected": {"status": "error", "class": "EngineImportError", "code": "not-found"}},
  {"name": "read-open-eacces", "mode": "read",
   "gen": [{"session": {"thread": "A", "history": [{"type": "user", "content": "q"}]}}],
   "schedule": {"rules": [{"match": {"op": "open", "path": "$SRC/sessions/%2Fwork/A/chat_history.jsonl"}, "error": {"code": "EACCES"}}]},
   "expected": {"status": "error", "class": "EngineImportError", "code": "read-failed"}},
  {"name": "read-open-enoent-race", "mode": "read",
   "gen": [{"session": {"thread": "A", "history": [{"type": "user", "content": "q"}]}}],
   "schedule": {"rules": [{"match": {"op": "open", "path": "$SRC/sessions/%2Fwork/A/chat_history.jsonl", "barrier": "before-call"},
     "actions": [{"kind": "unlink", "path": "$SRC/sessions/%2Fwork/A/chat_history.jsonl"}]}]},
   "expected": {"status": "error", "class": "EngineImportError", "code": "not-found"}},
  {"name": "read-read-error-eio", "mode": "read",
   "gen": [{"session": {"thread": "A", "history": [{"type": "user", "content": "q"}, {"type": "assistant", "content": "a"}]}}],
   "schedule": {"rules": [{"match": {"op": "read", "path": "$SRC/sessions/%2Fwork/A/chat_history.jsonl"}, "error": {"code": "EIO"}}]},
   "expected": {"status": "error", "class": "EngineImportError", "code": "read-failed"}},
  {"name": "read-race-append-before-size-fstat", "mode": "read",
   "gen": [{"session": {"thread": "A", "history": [{"type": "user", "content": "q"}, {"type": "assistant", "content": "a"}]}}],
   "schedule": {"rules": [{"match": {"op": "fstat", "path": "$SRC/sessions/%2Fwork/A/chat_history.jsonl", "occurrence": 2, "barrier": "before-call"},
     "actions": [{"kind": "append", "path": "$SRC/sessions/%2Fwork/A/chat_history.jsonl",
                  "bytes": {"utf8": "{\"type\":\"user\",\"content\":\"late\"}\n{\"type\":\"assistant\",\"content\":\"late reply\"}\n"}}]}]}},
  {"name": "read-race-truncate-before-first-read", "mode": "read",
   "gen": [{"session": {"thread": "A", "history": [{"type": "user", "content": "q"}, {"type": "assistant", "content": "a"}]}}],
   "schedule": {"rules": [{"match": {"op": "read", "path": "$SRC/sessions/%2Fwork/A/chat_history.jsonl", "barrier": "before-call"},
     "actions": [{"kind": "truncate", "path": "$SRC/sessions/%2Fwork/A/chat_history.jsonl", "size": 10}]}]}},
  {"name": "read-summary-growth-after-check", "mode": "read",
   "gen": [{"session": {"thread": "A", "summary_size": 65000, "history": [{"type": "user", "content": "q"}]}}],
   "schedule": {"rules": [{"match": {"op": "open", "path": "$SRC/sessions/%2Fwork/A/summary.json", "barrier": "before-call"},
     "actions": [{"kind": "append", "path": "$SRC/sessions/%2Fwork/A/summary.json", "bytes": {"repeat": {"utf8": " "}, "count": 2000}}]}]},
   "expected": {"status": "ok", "nrows": 1}},
  {"name": "read-summary-open-error-is-not-found", "mode": "read",
   "gen": [{"session": {"thread": "A", "history": [{"type": "user", "content": "q"}]}}],
   "schedule": {"rules": [{"match": {"op": "open", "path": "$SRC/sessions/%2Fwork/A/summary.json"}, "error": {"code": "EACCES"}}]},
   "expected": {"status": "error", "class": "EngineImportError", "code": "not-found"}},
  {"name": "read-hardlinked-history-ok", "mode": "read",
   "tree": [{"path": "$SRC/h.jsonl", "kind": "file", "bytes": {"utf8": "{\"type\":\"user\",\"content\":\"hl\"}\n{\"type\":\"assistant\",\"content\":\"ok\"}\n"}}],
   "gen": [{"session": {"thread": "A", "files": {"chat_history.jsonl": {"kind": "hardlink", "of": "$SRC/h.jsonl"}}}}],
   "expected": {"status": "ok", "nrows": 1}}
]
