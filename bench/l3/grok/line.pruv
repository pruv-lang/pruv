// Grok history line -> one reused Entry (step 2.11). The hand reference is bench/l3/grok/perf/hand_history.rs: Kind, Stamp,
// Entry (new, reset, at) and the line scanner P (ws, lit, skip_string, decode_string, number, skip_value, skip_array,
// members, stamp, part, content, entry). Each function here is one hand function: a cursor `inout i` is the hand
// `self.i`, the line `s` is the hand `self.s`, and `Result<_, i64>` is the hand `Option<_>` (`?` works only on Result).
// The line is valid UTF-8 (read::line_step checks it once, the hand `from_utf8(line)`), so the scanner validates only the
// JSON grammar. A failed scan is a skipped line.
//
// Differences from the hand, recorded in bench/l3/pkgs/RESHAPE.md step 2.11:
//   - Stamp::Canon holds the offset of the 24 bytes in the line (no `[u8; 24]` value type, P7-1); entry::feed borrows
//     them from the line.
//   - Stamp::Num(v) is the integer timestamp of time::iso_of (a number or a digit string), which the fixtures test and
//     the hand leaves out of its scope.
//   - No closures: the hand `members(f)` is written out in each caller (part_members, fields, the object arm of
//     skip_value).
//   - skip_string returns the struct Raw (no tuples in a module).
//   - decode_string encodes a `\u` scalar with push_char (no `char`/`encode_utf8`); the bytes are the same.

pub enum Kind { Missing, Null, Other, Str, Arr }

pub enum Stamp { Missing, Null, Other, Canon(at: i64), Num(value: i64) }

pub struct Entry {
  is_obj: bool,
  ty: i64,
  synthetic: Kind,
  prompt_index: Kind,
  content_kind: Kind,
  content: [u8],
  scratch: [u8],
  timestamp: Stamp,
  created_at: Stamp,
  tool_calls: Option<i64>,
}

// The raw range between the quotes of a string (hand `(usize, usize)`).
pub struct Raw { lo: i64, hi: i64 }

// hand Entry::new
pub fn new_entry() -> Entry ! alloc
  ensures len(result.content) == 0 && len(result.scratch) == 0 && !is_some(result.tool_calls)
{
  let c: [u8] = alloc(0, 0);
  let t: [u8] = alloc(0, 0);
  return Entry { is_obj: false, ty: 0, synthetic: Kind::Missing, prompt_index: Kind::Missing, content_kind: Kind::Missing,
    content: move c, scratch: move t, timestamp: Stamp::Missing, created_at: Stamp::Missing, tool_calls: None };
}

// hand Entry::reset: everything but the scratch buffer.
pub fn reset(inout e: Entry) -> () ! alloc
  ensures len(e.content) == 0 && !is_some(e.tool_calls)
{
  e.is_obj = false;
  e.ty = 0;
  e.synthetic = Kind::Missing;
  e.prompt_index = Kind::Missing;
  e.content_kind = Kind::Missing;
  e.content = truncate(e.content, 0);
  e.timestamp = Stamp::Missing;
  e.created_at = Stamp::Missing;
  e.tool_calls = None;
}

// hand hex4: 4 hex digits at s[at..at+4).
fn hex4(s: [u8], at: i64) -> Result<i64, i64>
  requires 0 <= at
  ensures is_ok(result) ==> (at + 4 <= len(s) && 0 <= ok_val(result) && ok_val(result) <= 65535)
  ensures is_ok(result) ==> (s[at] < 128 && s[at + 1] < 128 && s[at + 2] < 128 && s[at + 3] < 128)
{
  if at > len(s) - 4 { return Err::<i64, i64>(1); }
  let mut v: i64 = 0;
  for k in 0..4
    invariant 0 <= at && at + 4 <= len(s)
    invariant (k == 0 && v == 0) || (k == 1 && 0 <= v && v < 16) || (k == 2 && 0 <= v && v < 256) || (k == 3 && 0 <= v && v < 4096) || (k == 4 && 0 <= v && v < 65536)
    invariant forall t in 0..k: s[at + t] < 128
  {
    let c: i64 = s[at + k];
    let mut d: i64 = -1;
    if 48 <= c && c <= 57 { d = c - 48; }
    else if 97 <= c && c <= 102 { d = c - 87; }
    else if 65 <= c && c <= 70 { d = c - 55; }
    if d < 0 { return Err::<i64, i64>(1); }
    v = v * 16 + d;
  }
  return Ok::<i64, i64>(v);
}

// hand P::ws
fn ws(s: [u8], inout i: i64) -> ()
  requires 0 <= i && i <= len(s)
  ensures old(i) <= i && i <= len(s)
{
  while i < len(s)
    invariant old(i) <= i && i <= len(s)
    decreases len(s) - i
  {
    let c: i64 = s[i];
    if c != 32 && c != 9 && c != 10 && c != 13 { return; }
    i = i + 1;
  }
}

// hand P::lit: s[i..] starts with w.
fn lit(s: [u8], inout i: i64, w: [u8]) -> Result<(), i64>
  requires 0 <= i && i <= len(s) && 1 <= len(w)
  ensures old(i) <= i && i <= len(s)
  ensures is_ok(result) ==> old(i) < i
{
  if len(w) > len(s) - i { return Err::<(), i64>(1); }
  if !eq_range(s, i, w, 0, len(w)) { return Err::<(), i64>(1); }
  i = i + len(w);
  return Ok::<(), i64>(());
}

// The hand `key == b"..."` on a raw range (no slice `==` on a range of s; eq_range compares the bytes).
fn raw_is(s: [u8], r: Raw, w: [u8]) -> bool
{
  if r.lo < 0 || r.hi > len(s) || r.hi < r.lo { return false; }
  if r.hi - r.lo != len(w) { return false; }
  return eq_range(s, r.lo, w, 0, len(w));
}

// hand P::skip_string: a string at i (the opening quote); the raw range between the quotes.
fn skip_string(s: [u8], inout i: i64) -> Result<Raw, i64>
  requires 0 <= i && i <= len(s)
  ensures old(i) <= i && i <= len(s)
  ensures is_ok(result) ==> (old(i) < i && s[old(i)] == 34 && ok_val(result).lo == old(i) + 1 && ok_val(result).lo <= ok_val(result).hi && ok_val(result).hi + 1 == i && s[ok_val(result).hi] == 34)
{
  if i >= len(s) { return Err::<Raw, i64>(1); }
  if s[i] != 34 { return Err::<Raw, i64>(1); }
  i = i + 1;
  let start: i64 = i;
  while i < len(s)
    invariant old(i) < start && start == old(i) + 1 && start <= i && i <= len(s) && s[old(i)] == 34
    decreases len(s) - i
  {
    let c: i64 = s[i];
    if c == 34 {
      i = i + 1;
      return Ok::<Raw, i64>(Raw { lo: start, hi: i - 1 });
    }
    if c == 92 {
      if i + 1 >= len(s) { return Err::<Raw, i64>(1); }
      let x: i64 = s[i + 1];
      if x == 34 || x == 92 || x == 47 || x == 98 || x == 102 || x == 110 || x == 114 || x == 116 {
        i = i + 2;
      } else if x == 117 {
        let h: i64 = hex4(s, i + 2)?;
        i = i + 6;
      } else {
        return Err::<Raw, i64>(1);
      }
    } else if c <= 31 {
      return Err::<Raw, i64>(1);
    } else {
      i = i + 1;
    }
  }
  return Err::<Raw, i64>(1);
}

// One scalar value appended as UTF-8 (the hand `char::from_u32(v).unwrap_or('\u{FFFD}')` + `encode_utf8`).
fn push_char(inout out: [u8], v: i64) -> () ! alloc
  requires 0 <= v && v <= 1114111
  requires utf8_valid_span(out, 0, len(out)) && len(out) + 4 <= 1099511627776
  ensures utf8_valid_span(out, 0, len(out)) && len(old(out)) < len(out) && len(out) <= len(old(out)) + 4
{
  let mut c: i64 = v;
  if 55296 <= c && c <= 57343 { c = 65533; }
  if c < 128 { arr_push(inout out, c); return; }
  if c < 2048 { arr_push(inout out, 192 + c / 64, 128 + c % 64); return; }
  if c < 65536 { arr_push(inout out, 224 + c / 4096, 128 + (c / 64) % 64, 128 + c % 64); return; }
  arr_push(inout out, 240 + c / 262144, 128 + (c / 4096) % 64, 128 + (c / 64) % 64, 128 + c % 64);
}

// hand P::decode_string: a string at i decoded into out (lone surrogates become U+FFFD).
fn decode_string(s: [u8], inout i: i64, inout out: [u8]) -> Result<(), i64> ! alloc
  requires utf8_valid(s) && 0 <= i && i <= len(s)
  requires utf8_valid_span(out, 0, len(out)) && len(out) + len(s) <= 1099511627776
  ensures old(i) <= i && i <= len(s)
  ensures is_ok(result) ==> old(i) < i
  ensures utf8_valid_span(out, 0, len(out)) && len(old(out)) <= len(out) && len(out) - len(old(out)) <= i - old(i)
{
  if i >= len(s) { return Err::<(), i64>(1); }
  if s[i] != 34 { return Err::<(), i64>(1); }
  i = i + 1;
  while i <= len(s)
    invariant old(i) < i && i <= len(s) && s[i - 1] < 128
    invariant utf8_valid_span(out, 0, len(out)) && len(old(out)) <= len(out) && len(out) - len(old(out)) <= i - old(i)
    decreases len(s) - i + 1
  {
    let run: i64 = i;
    while i < len(s) && s[i] != 34 && s[i] != 92 && s[i] >= 32
      invariant run <= i && i <= len(s)
      decreases len(s) - i
    {
      i = i + 1;
    }
    // s[run - 1] and s[i] are ASCII (or i is the end of the line), so s[run..i) is a valid span (LG30)
    arr_append(inout out, s, run, i - run);
    if i >= len(s) { return Err::<(), i64>(1); }
    let c: i64 = s[i];
    if c == 34 {
      i = i + 1;
      return Ok::<(), i64>(());
    }
    if c != 92 { return Err::<(), i64>(1); }  // a raw control byte
    if i + 1 >= len(s) { return Err::<(), i64>(1); }
    let x: i64 = s[i + 1];
    i = i + 2;
    if x == 34 { arr_push(inout out, 34); }
    else if x == 92 { arr_push(inout out, 92); }
    else if x == 47 { arr_push(inout out, 47); }
    else if x == 98 { arr_push(inout out, 8); }
    else if x == 102 { arr_push(inout out, 12); }
    else if x == 110 { arr_push(inout out, 10); }
    else if x == 114 { arr_push(inout out, 13); }
    else if x == 116 { arr_push(inout out, 9); }
    else if x == 117 {
      let mut v: i64 = hex4(s, i)?;
      i = i + 4;
      if 55296 <= v && v <= 56319 {
        if i + 1 < len(s) && s[i] == 92 && s[i + 1] == 117 {
          match hex4(s, i + 2) {
            Ok(lo) => {
              if 56320 <= lo && lo <= 57343 {
                v = 65536 + (v - 55296) * 1024 + (lo - 56320);
                i = i + 6;
              }
            }
            Err(z) => {}
          }
        }
      }
      push_char(inout out, v);
    } else {
      return Err::<(), i64>(1);
    }
  }
  return Err::<(), i64>(1);
}

// hand P::number
fn number(s: [u8], inout i: i64) -> Result<(), i64>
  requires 0 <= i && i <= len(s)
  ensures old(i) <= i && i <= len(s)
  ensures is_ok(result) ==> old(i) < i
{
  if i < len(s) && s[i] == 45 { i = i + 1; }
  if i >= len(s) { return Err::<(), i64>(1); }
  let c: i64 = s[i];
  if c == 48 {
    i = i + 1;
  } else if 49 <= c && c <= 57 {
    i = i + 1;
    while i < len(s) && s[i] >= 48 && s[i] <= 57
      invariant old(i) < i && i <= len(s)
      decreases len(s) - i
    { i = i + 1; }
  } else {
    return Err::<(), i64>(1);
  }
  if i < len(s) && s[i] == 46 {
    i = i + 1;
    if i >= len(s) { return Err::<(), i64>(1); }
    if s[i] < 48 || s[i] > 57 { return Err::<(), i64>(1); }
    while i < len(s) && s[i] >= 48 && s[i] <= 57
      invariant old(i) < i && i <= len(s)
      decreases len(s) - i
    { i = i + 1; }
  }
  if i < len(s) && (s[i] == 101 || s[i] == 69) {
    i = i + 1;
    if i < len(s) && (s[i] == 43 || s[i] == 45) { i = i + 1; }
    if i >= len(s) { return Err::<(), i64>(1); }
    if s[i] < 48 || s[i] > 57 { return Err::<(), i64>(1); }
    while i < len(s) && s[i] >= 48 && s[i] <= 57
      invariant old(i) < i && i <= len(s)
      decreases len(s) - i
    { i = i + 1; }
  }
  return Ok::<(), i64>(());
}

// hand P::skip_value: skips one value (validating it); the kind of the value. depth > 128 fails.
fn skip_value(s: [u8], inout i: i64, depth: i64) -> Result<Kind, i64>
  requires 0 <= i && i <= len(s) && 0 <= depth && depth <= 129
  ensures old(i) <= i && i <= len(s)
  ensures is_ok(result) ==> old(i) < i
  decreases 2 * (129 - depth) + 1
{
  if depth > 128 { return Err::<Kind, i64>(1); }
  ws(s, inout i);
  if i >= len(s) { return Err::<Kind, i64>(1); }
  let c: i64 = s[i];
  if c == 123 {
    // hand members, written out (no closures)
    i = i + 1;
    ws(s, inout i);
    if i < len(s) && s[i] == 125 {
      i = i + 1;
      return Ok::<Kind, i64>(Kind::Other);
    }
    while i < len(s)
      invariant old(i) < i && i <= len(s)
      decreases len(s) - i
    {
      ws(s, inout i);
      let k: Raw = skip_string(s, inout i)?;
      ws(s, inout i);
      if i >= len(s) { return Err::<Kind, i64>(1); }
      if s[i] != 58 { return Err::<Kind, i64>(1); }
      i = i + 1;
      let v: Kind = skip_value(s, inout i, depth + 1)?;
      ws(s, inout i);
      if i >= len(s) { return Err::<Kind, i64>(1); }
      let t: i64 = s[i];
      if t == 44 {
        i = i + 1;
      } else if t == 125 {
        i = i + 1;
        return Ok::<Kind, i64>(Kind::Other);
      } else {
        return Err::<Kind, i64>(1);
      }
    }
    return Err::<Kind, i64>(1);
  }
  if c == 91 {
    let n: i64 = skip_array(s, inout i, depth)?;
    return Ok::<Kind, i64>(Kind::Arr);
  }
  if c == 34 {
    let r: Raw = skip_string(s, inout i)?;
    return Ok::<Kind, i64>(Kind::Str);
  }
  if c == 116 { lit(s, inout i, "true")?; return Ok::<Kind, i64>(Kind::Other); }
  if c == 102 { lit(s, inout i, "false")?; return Ok::<Kind, i64>(Kind::Other); }
  if c == 110 { lit(s, inout i, "null")?; return Ok::<Kind, i64>(Kind::Null); }
  if c == 45 || (48 <= c && c <= 57) { number(s, inout i)?; return Ok::<Kind, i64>(Kind::Other); }
  return Err::<Kind, i64>(1);
}

// hand P::skip_array: an array at i; its element count.
fn skip_array(s: [u8], inout i: i64, depth: i64) -> Result<i64, i64>
  requires 0 <= i && i < len(s) && 0 <= depth && depth <= 128
  ensures old(i) <= i && i <= len(s)
  ensures is_ok(result) ==> (old(i) < i && 0 <= ok_val(result))
  decreases 2 * (129 - depth)
{
  i = i + 1;
  ws(s, inout i);
  if i < len(s) && s[i] == 93 {
    i = i + 1;
    return Ok::<i64, i64>(0);
  }
  let mut n: i64 = 0;
  while i < len(s)
    invariant old(i) < i && i <= len(s) && 0 <= n && n < i
    decreases len(s) - i
  {
    let v: Kind = skip_value(s, inout i, depth + 1)?;
    n = n + 1;
    ws(s, inout i);
    if i >= len(s) { return Err::<i64, i64>(1); }
    let t: i64 = s[i];
    if t == 44 {
      i = i + 1;
    } else if t == 93 {
      i = i + 1;
      return Ok::<i64, i64>(n);
    } else {
      return Err::<i64, i64>(1);
    }
  }
  return Err::<i64, i64>(1);
}

// time::iso_of on a string with no escapes, beyond the canonical form: a trimmed all-digit text is an integer time.
fn digit_stamp(t: str) -> Stamp
{
  let sp: crate::text::Span = crate::text::trim_span(t);
  let lo: i64 = sp.lo;
  let hi: i64 = sp.hi;
  if lo < 0 || hi > len(t) || lo >= hi { return Stamp::Other; }
  let mut v: i64 = 0;
  let mut k: i64 = lo;
  while k < hi
    invariant lo <= k && k <= hi && hi <= len(t) && 0 <= v && v <= 9007199254740991
    decreases hi - k
  {
    let c: i64 = t[k];
    if c < 48 || c > 57 { return Stamp::Other; }
    let d: i64 = c - 48;
    if v > (9007199254740991 - d) / 10 { return Stamp::Other; }
    v = v * 10 + d;
    k = k + 1;
  }
  return Stamp::Num(v);
}

// time::iso_of on a number s[lo..hi): only `-?digits` with |v| <= 2^53 - 1 is an integer time.
fn number_stamp(s: [u8], lo: i64, hi: i64) -> Stamp
  requires 0 <= lo && lo <= hi && hi <= len(s)
{
  let mut k: i64 = lo;
  let mut neg: bool = false;
  if k < hi && s[k] == 45 { neg = true; k = k + 1; }
  if k >= hi { return Stamp::Other; }
  let mut v: i64 = 0;
  while k < hi
    invariant lo <= k && k <= hi && hi <= len(s) && 0 <= v && v <= 9007199254740991
    decreases hi - k
  {
    let c: i64 = s[k];
    if c < 48 || c > 57 { return Stamp::Other; }
    let d: i64 = c - 48;
    if v > (9007199254740991 - d) / 10 { return Stamp::Other; }
    v = v * 10 + d;
    k = k + 1;
  }
  if neg { return Stamp::Num(0 - v); }
  return Stamp::Num(v);
}

// hand P::stamp
fn stamp(s: [u8], inout i: i64) -> Result<Stamp, i64> ! alloc
  requires utf8_valid(s) && 0 <= i && i <= len(s)
  ensures old(i) <= i && i <= len(s)
  ensures is_ok(result) ==> old(i) < i
{
  if i < len(s) && s[i] == 34 {
    let r: Raw = skip_string(s, inout i)?;
    // the quotes around s[r.lo..r.hi) are ASCII, so it is a valid span (LG30)
    if r.hi - r.lo == 24 && crate::time::canonical_iso(subview(s, r.lo, r.hi)) {
      return Ok::<Stamp, i64>(Stamp::Canon(r.lo));
    }
    if find_byte(s, 92, r.lo, r.hi) < r.hi { return Ok::<Stamp, i64>(Stamp::Other); }
    let d: Stamp = digit_stamp(subview(s, r.lo, r.hi));
    return Ok::<Stamp, i64>(d);
  }
  let at: i64 = i;
  let k: Kind = skip_value(s, inout i, 1)?;
  match k {
    Kind::Null => { return Ok::<Stamp, i64>(Stamp::Null); }
    Kind::Missing => { return Ok::<Stamp, i64>(Stamp::Other); }
    Kind::Other => {
      let n: Stamp = number_stamp(s, at, i);
      return Ok::<Stamp, i64>(n);
    }
    Kind::Str => { return Ok::<Stamp, i64>(Stamp::Other); }
    Kind::Arr => { return Ok::<Stamp, i64>(Stamp::Other); }
  }
}

// The hand `members` closure of P::part: the last "text" string is decoded into scratch.
fn part_members(s: [u8], inout i: i64, inout scratch: [u8], inout has: bool) -> Result<(), i64> ! alloc
  requires utf8_valid(s) && len(s) <= 1073741824 && 0 <= i && i < len(s)
  requires len(scratch) == 0
  ensures old(i) <= i && i <= len(s)
  ensures is_ok(result) ==> old(i) < i
  ensures utf8_valid_span(scratch, 0, len(scratch))
  ensures len(scratch) == 0 || len(scratch) + 2 <= i - old(i)
{
  i = i + 1;
  ws(s, inout i);
  if i < len(s) && s[i] == 125 {
    i = i + 1;
    return Ok::<(), i64>(());
  }
  while i < len(s)
    invariant old(i) < i && i <= len(s) && utf8_valid_span(scratch, 0, len(scratch))
    invariant len(scratch) == 0 || len(scratch) + 2 <= i - old(i)
    decreases len(s) - i
  {
    ws(s, inout i);
    let k: Raw = skip_string(s, inout i)?;
    ws(s, inout i);
    if i >= len(s) { return Err::<(), i64>(1); }
    if s[i] != 58 { return Err::<(), i64>(1); }
    i = i + 1;
    ws(s, inout i);
    let is_text: bool = raw_is(s, k, "text");
    if is_text && i < len(s) && s[i] == 34 {
      scratch = truncate(scratch, 0);
      decode_string(s, inout i, inout scratch)?;
      has = true;
    } else {
      if is_text { has = false; }
      let v: Kind = skip_value(s, inout i, 2)?;
    }
    ws(s, inout i);
    if i >= len(s) { return Err::<(), i64>(1); }
    let t: i64 = s[i];
    if t == 44 {
      i = i + 1;
    } else if t == 125 {
      i = i + 1;
      return Ok::<(), i64>(());
    } else {
      return Err::<(), i64>(1);
    }
  }
  return Err::<(), i64>(1);
}

// hand P::part: one element of a content array, its "text" string (the last one wins) joined with a blank line.
fn part(s: [u8], inout i: i64, inout e: Entry) -> Result<(), i64> ! alloc
  requires utf8_valid(s) && len(s) <= 1073741824 && 0 <= i && i < len(s)
  requires utf8_valid_span(e.content, 0, len(e.content)) && len(e.content) <= i && (is_some(e.tool_calls) ==> some_val(e.tool_calls) >= 0)
  ensures old(i) <= i && i <= len(s)
  ensures is_ok(result) ==> old(i) < i
  ensures utf8_valid_span(e.content, 0, len(e.content)) && len(e.content) <= i && (is_some(e.tool_calls) ==> some_val(e.tool_calls) >= 0)
{
  let mut has: bool = false;
  // hand: `let mut scratch = take(&mut e.scratch)` only to satisfy the borrow checker; disjoint field borrows need no take.
  // Emptied once here instead of only before a "text" decode: the bytes kept from an earlier line are never read.
  e.scratch = truncate(e.scratch, 0);
  let r: Result<(), i64> = part_members(s, inout i, inout e.scratch, inout has);
  let mut ok: bool = false;
  match r {
    Ok(()) => { ok = true; }
    Err(z) => {}
  }
  if ok && has && len(e.scratch) > 0 {
    if len(e.content) > 0 { arr_append(inout e.content, "\n\n", 0, 2); }
    arr_append(inout e.content, e.scratch, 0, len(e.scratch));
  }
  if ok { return Ok::<(), i64>(()); }
  return Err::<(), i64>(1);
}

// hand P::content
fn content(s: [u8], inout i: i64, inout e: Entry) -> Result<(), i64> ! alloc
  requires utf8_valid(s) && len(s) <= 1073741824 && 0 <= i && i <= len(s) && (is_some(e.tool_calls) ==> some_val(e.tool_calls) >= 0)
  ensures old(i) <= i && i <= len(s)
  ensures is_ok(result) ==> old(i) < i
  ensures utf8_valid_span(e.content, 0, len(e.content)) && len(e.content) <= i && (is_some(e.tool_calls) ==> some_val(e.tool_calls) >= 0)
{
  e.content = truncate(e.content, 0);
  if i >= len(s) { return Err::<(), i64>(1); }
  let c: i64 = s[i];
  if c == 34 {
    decode_string(s, inout i, inout e.content)?;
    e.content_kind = Kind::Str;
  } else if c == 91 {
    e.content_kind = Kind::Arr;
    i = i + 1;
    ws(s, inout i);
    if i < len(s) && s[i] == 93 {
      i = i + 1;
      return Ok::<(), i64>(());
    }
    while i < len(s)
      invariant old(i) < i && i <= len(s)
      invariant utf8_valid_span(e.content, 0, len(e.content)) && len(e.content) <= i
      invariant is_some(e.tool_calls) ==> some_val(e.tool_calls) >= 0
      decreases len(s) - i
    {
      ws(s, inout i);
      if i < len(s) && s[i] == 123 {
        part(s, inout i, inout e)?;
      } else {
        let v: Kind = skip_value(s, inout i, 2)?;
      }
      ws(s, inout i);
      if i >= len(s) { return Err::<(), i64>(1); }
      let t: i64 = s[i];
      if t == 44 {
        i = i + 1;
      } else if t == 93 {
        i = i + 1;
        return Ok::<(), i64>(());
      } else {
        return Err::<(), i64>(1);
      }
    }
    return Err::<(), i64>(1);
  } else {
    let k: Kind = skip_value(s, inout i, 1)?;
    e.content_kind = k;
  }
  return Ok::<(), i64>(());
}

// The hand `members` closure of P::entry: the top-level fields of the line.
fn fields(s: [u8], inout i: i64, inout e: Entry) -> Result<(), i64> ! alloc
  requires utf8_valid(s) && len(s) <= 1073741824 && 0 <= i && i < len(s)
  requires utf8_valid_span(e.content, 0, len(e.content)) && len(e.content) <= i && (is_some(e.tool_calls) ==> some_val(e.tool_calls) >= 0)
  ensures old(i) <= i && i <= len(s)
  ensures utf8_valid_span(e.content, 0, len(e.content)) && len(e.content) <= i && (is_some(e.tool_calls) ==> some_val(e.tool_calls) >= 0)
{
  i = i + 1;
  ws(s, inout i);
  if i < len(s) && s[i] == 125 {
    i = i + 1;
    return Ok::<(), i64>(());
  }
  while i < len(s)
    invariant old(i) < i && i <= len(s)
    invariant utf8_valid_span(e.content, 0, len(e.content)) && len(e.content) <= i
    invariant is_some(e.tool_calls) ==> some_val(e.tool_calls) >= 0
    decreases len(s) - i
  {
    ws(s, inout i);
    let k: Raw = skip_string(s, inout i)?;
    ws(s, inout i);
    if i >= len(s) { return Err::<(), i64>(1); }
    if s[i] != 58 { return Err::<(), i64>(1); }
    i = i + 1;
    ws(s, inout i);
    if raw_is(s, k, "type") {
      if i < len(s) && s[i] == 34 {
        let r: Raw = skip_string(s, inout i)?;
        if raw_is(s, r, "user") { e.ty = 1; }
        else if raw_is(s, r, "assistant") { e.ty = 2; }
        else { e.ty = 0; }
      } else {
        let v: Kind = skip_value(s, inout i, 1)?;
        e.ty = 0;
      }
    } else if raw_is(s, k, "synthetic_reason") {
      let v: Kind = skip_value(s, inout i, 1)?;
      e.synthetic = v;
    } else if raw_is(s, k, "prompt_index") {
      let v: Kind = skip_value(s, inout i, 1)?;
      e.prompt_index = v;
    } else if raw_is(s, k, "content") {
      content(s, inout i, inout e)?;
    } else if raw_is(s, k, "timestamp") {
      let t: Stamp = stamp(s, inout i)?;
      e.timestamp = t;
    } else if raw_is(s, k, "created_at") {
      let t: Stamp = stamp(s, inout i)?;
      e.created_at = t;
    } else if raw_is(s, k, "tool_calls") {
      if i < len(s) && s[i] == 91 {
        let n: i64 = skip_array(s, inout i, 1)?;
        e.tool_calls = Some(n);
      } else {
        let v: Kind = skip_value(s, inout i, 1)?;
        e.tool_calls = None;
      }
    } else {
      let v: Kind = skip_value(s, inout i, 1)?;
    }
    ws(s, inout i);
    if i >= len(s) { return Err::<(), i64>(1); }
    let t: i64 = s[i];
    if t == 44 {
      i = i + 1;
    } else if t == 125 {
      i = i + 1;
      return Ok::<(), i64>(());
    } else {
      return Err::<(), i64>(1);
    }
  }
  return Err::<(), i64>(1);
}

// hand P::entry: the whole line into e; Err = the line is not valid JSON (a skipped line).
// The content is decoded from (and joined inside) the line, so it is never longer than the line.
pub fn entry(s: [u8], inout i: i64, inout e: Entry) -> Result<(), i64> ! alloc
  requires utf8_valid(s) && len(s) <= 1073741824 && 0 <= i && i <= len(s)
  requires utf8_valid_span(e.content, 0, len(e.content)) && len(e.content) <= i && (is_some(e.tool_calls) ==> some_val(e.tool_calls) >= 0)
  ensures utf8_valid_span(e.content, 0, len(e.content)) && len(e.content) <= len(s) && (is_some(e.tool_calls) ==> some_val(e.tool_calls) >= 0)
{
  ws(s, inout i);
  if i < len(s) && s[i] == 123 {
    e.is_obj = true;
    fields(s, inout i, inout e)?;
  } else {
    let v: Kind = skip_value(s, inout i, 0)?;
  }
  ws(s, inout i);
  if i == len(s) { return Ok::<(), i64>(()); }
  return Err::<(), i64>(1);
}
