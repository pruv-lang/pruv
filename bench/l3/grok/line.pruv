// Grok one-pass line reader (DB45, G-DB43-2; design and cost bounds in docs/L3_DB45.md).
//
// step(b, f, ...) reads one history line b (a borrowed view of the window, no copy) in one left-to-right scan and feeds the
// collector through entry::user_view / entry::assistant_view. It answers only lines whose result it can decide with the
// rules of the tape path (read::line_step + entry::feed); for every other line it returns 3 and read::line_step runs the
// tape path on the same span, so the result equals the tape path by construction:
//   - first non-whitespace byte is ASCII and not `{`: every outcome of the tape path is a skip (non-object root or invalid JSON);
//   - an object whose top-level "type" is not the plain string "user"/"assistant": a skip whatever the rest of the line holds;
//   - otherwise the line must be valid UTF-8 (one run-time check), fully valid JSON under the scanner below, with no `\u`
//     escape anywhere, no escaped key, no duplicate wanted key, at most 64 content parts, nesting at most 120, and a
//     timestamp ?? created_at that is absent, null, not a number/string, or a 24-byte canonical ISO string.
//
// Scratch f (len >= 256, reused across lines; values are checked again where they are used as indices):
//   f[id] kind of wanted top-level key id (1 type, 2 synthetic_reason, 3 prompt_index, 4 content, 5 timestamp, 6 created_at,
//         7 tool_calls): -1 absent, 0 null, 1 bool, 3 number, 4 string, 5 array, 6 object
//   f[8 + id] value start (strings: after the opening quote), f[16 + id] value end (strings: the closing quote), f[24 + id] escapes
//   f[32] content parts recorded, f[33] tool_calls elements, f[0] decode failure flag
//   f[40 + 3k], f[41 + 3k], f[42 + 3k]: span and escape flag of the "text" string of content part k (k < 64)

pub struct Str { end: i64, esc: i64 }

// JSON whitespace run from p.
fn ws(b: [u8], p: i64) -> i64
  requires 0 <= p && p <= len(b)
  ensures p <= result && result <= len(b)
{
  let mut q: i64 = p;
  while q < len(b)
    invariant p <= q && q <= len(b)
    decreases len(b) - q
  {
    let c: i64 = b[q];
    if c != 32 && c != 10 && c != 13 && c != 9 { return q; }
    q = q + 1;
  }
  return q;
}

// p is just after an opening quote. end: index of the closing quote, or -1 (control byte, `\u` or unknown escape, unterminated:
// the caller falls back). esc: 1 when a simple escape was seen. UTF-8 is not looked at here (step checks the whole line once).
fn str_end(b: [u8], p: i64) -> Str
  requires 0 <= p && p <= len(b)
  ensures result.end == -1 || (p <= result.end && result.end < len(b))
  ensures result.esc == 0 || result.esc == 1
{
  let mut q: i64 = p;
  let mut esc: i64 = 0;
  while q < len(b)
    invariant p <= q && q <= len(b) && (esc == 0 || esc == 1)
    decreases len(b) - q
  {
    let c: i64 = b[q];
    if c == 34 { return Str { end: q, esc: esc }; }
    if c == 92 {
      if q + 1 >= len(b) { return Str { end: -1, esc: esc }; }
      let e: i64 = b[q + 1];
      if e != 34 && e != 92 && e != 47 && e != 98 && e != 102 && e != 110 && e != 114 && e != 116 { return Str { end: -1, esc: esc }; }
      esc = 1;
      q = q + 2;
    } else {
      if c < 32 { return Str { end: -1, esc: esc }; }
      q = q + 1;
    }
  }
  return Str { end: -1, esc: esc };
}

fn digits(b: [u8], p: i64) -> i64
  requires 0 <= p && p <= len(b)
  ensures p <= result && result <= len(b)
{
  let mut q: i64 = p;
  while q < len(b)
    invariant p <= q && q <= len(b)
    decreases len(b) - q
  {
    let c: i64 = b[q];
    if c < 48 || c > 57 { return q; }
    q = q + 1;
  }
  return q;
}

// JSON number at p (same grammar as lex::scan_number), end or -1.
fn num_end(b: [u8], p: i64) -> i64
  requires 0 <= p && p <= len(b)
  ensures result == -1 || (p < result && result <= len(b))
{
  let mut i: i64 = p;
  if i >= len(b) { return -1; }
  if b[i] == 45 { i = i + 1; }
  if i >= len(b) { return -1; }
  let c: i64 = b[i];
  if c < 48 || c > 57 { return -1; }
  i = i + 1;
  if c == 48 {
    if i < len(b) {
      let d: i64 = b[i];
      if d >= 48 && d <= 57 { return -1; }
    }
  } else { i = digits(b, i); }
  if i < len(b) {
    if b[i] == 46 {
      i = i + 1;
      if i >= len(b) { return -1; }
      let d: i64 = b[i];
      if d < 48 || d > 57 { return -1; }
      i = digits(b, i + 1);
    }
  }
  if i < len(b) {
    let e: i64 = b[i];
    if e == 101 || e == 69 {
      i = i + 1;
      if i >= len(b) { return -1; }
      let s: i64 = b[i];
      if s == 43 || s == 45 { i = i + 1; }
      if i >= len(b) { return -1; }
      let d: i64 = b[i];
      if d < 48 || d > 57 { return -1; }
      i = digits(b, i + 1);
    }
  }
  return i;
}

// b[lo..hi) equals lit byte for byte.
fn bytes_are(b: [u8], lo: i64, hi: i64, lit: str) -> bool
  requires 0 <= lo && lo <= hi && hi <= len(b)
{
  if hi - lo != len(lit) { return false; }
  let mut k: i64 = 0;
  while k < len(lit)
    invariant 0 <= k && k <= len(lit) && len(lit) == hi - lo && 0 <= lo && hi <= len(b)
    decreases len(lit) - k
  {
    let x: i64 = b[lo + k];
    let y: i64 = lit[k];
    if x != y { return false; }
    k = k + 1;
  }
  return true;
}

// Literal lit at p: its end, or -1.
fn lit_end(b: [u8], p: i64, lit: str) -> i64
  requires 0 <= p && p <= len(b) && len(lit) >= 1
  ensures result == -1 || (p < result && result <= len(b))
{
  if len(lit) > len(b) - p { return -1; }
  if !bytes_are(b, p, p + len(lit), lit) { return -1; }
  return p + len(lit);
}

// Kind of the value starting with byte c (access kinds): 0 null, 1 bool, 3 number, 4 string, 5 array, 6 object.
fn kind_of(c: i64) -> i64
{
  if c == 110 { return 0; }
  if c == 116 || c == 102 { return 1; }
  if c == 34 { return 4; }
  if c == 91 { return 5; }
  if c == 123 { return 6; }
  return 3;
}

// Any JSON value at p, nested at most d more levels: its end, or -1.
fn skip_value(b: [u8], p: i64, d: i64) -> i64 ! alloc
  requires 0 <= p && p <= len(b) && 0 <= d
  ensures result == -1 || (p < result && result <= len(b))
  decreases d
{
  if p >= len(b) { return -1; }
  let c: i64 = b[p];
  if c == 34 {
    let s: Str = str_end(b, p + 1);
    if s.end < 0 { return -1; }
    return s.end + 1;
  }
  if c == 110 { return lit_end(b, p, "null"); }
  if c == 116 { return lit_end(b, p, "true"); }
  if c == 102 { return lit_end(b, p, "false"); }
  if c != 123 && c != 91 { return num_end(b, p); }
  if d == 0 { return -1; }
  let obj: bool = c == 123;
  let mut close: i64 = 93;
  if obj { close = 125; }
  let mut q: i64 = ws(b, p + 1);
  if q < len(b) {
    if b[q] == close { return q + 1; }
  }
  while q < len(b)
    invariant p < q && q <= len(b) && 1 <= d
    decreases len(b) - q
  {
    if obj {
      if b[q] != 34 { return -1; }
      let k: Str = str_end(b, q + 1);
      if k.end < 0 { return -1; }
      q = ws(b, k.end + 1);
      if q >= len(b) { return -1; }
      if b[q] != 58 { return -1; }
      q = ws(b, q + 1);
    }
    let v: i64 = skip_value(b, q, d - 1);
    if v < 0 { return -1; }
    q = ws(b, v);
    if q >= len(b) { return -1; }
    let t: i64 = b[q];
    if t == close { return q + 1; }
    if t != 44 { return -1; }
    q = ws(b, q + 1);
  }
  return -1;
}

// Wanted top-level key id of the raw key b[lo..hi) (0: not wanted).
fn key_id(b: [u8], lo: i64, hi: i64) -> i64 ! alloc
  requires 0 <= lo && lo <= hi && hi <= len(b)
  ensures 0 <= result && result <= 7
{
  let n: i64 = hi - lo;
  if n == 4 && bytes_are(b, lo, hi, "type") { return 1; }
  if n == 16 && bytes_are(b, lo, hi, "synthetic_reason") { return 2; }
  if n == 12 && bytes_are(b, lo, hi, "prompt_index") { return 3; }
  if n == 7 && bytes_are(b, lo, hi, "content") { return 4; }
  if n == 9 && bytes_are(b, lo, hi, "timestamp") { return 5; }
  if n == 10 && bytes_are(b, lo, hi, "created_at") { return 6; }
  if n == 10 && bytes_are(b, lo, hi, "tool_calls") { return 7; }
  return 0;
}

// One content part object at p (b[p] == `{`): records the span of its "text" string as part f[32]. End or -1.
fn part(b: [u8], p: i64, inout f: [i64]) -> i64 ! alloc
  requires 0 <= p && p < len(b) && len(f) >= 256
  ensures len(f) == len(old(f))
  ensures result == -1 || (p < result && result <= len(b))
{
  let mut q: i64 = ws(b, p + 1);
  if q < len(b) {
    if b[q] == 125 { return q + 1; }
  }
  let mut seen: bool = false;
  while q < len(b)
    invariant p < q && q <= len(b) && len(f) == len(old(f))
    decreases len(b) - q
  {
    if b[q] != 34 { return -1; }
    let k: Str = str_end(b, q + 1);
    if k.end < 0 || k.esc != 0 { return -1; }
    let is_text: bool = bytes_are(b, q + 1, k.end, "text");
    q = ws(b, k.end + 1);
    if q >= len(b) { return -1; }
    if b[q] != 58 { return -1; }
    q = ws(b, q + 1);
    if q >= len(b) { return -1; }
    let mut v: i64 = -1;
    if is_text {
      if seen { return -1; }
      seen = true;
      if b[q] == 34 {
        let s: Str = str_end(b, q + 1);
        if s.end < 0 { return -1; }
        let n: i64 = f[32];
        if n < 0 || n >= 64 { return -1; }
        f[40 + 3 * n] = q + 1;
        f[41 + 3 * n] = s.end;
        f[42 + 3 * n] = s.esc;
        f[32] = n + 1;
        v = s.end + 1;
      } else {
        v = skip_value(b, q, 118);
      }
    } else {
      v = skip_value(b, q, 118);
    }
    if v < 0 { return -1; }
    q = ws(b, v);
    if q >= len(b) { return -1; }
    let t: i64 = b[q];
    if t == 125 { return q + 1; }
    if t != 44 { return -1; }
    q = ws(b, q + 1);
  }
  return -1;
}

// Array at p (b[p] == `[`): element count in f[33]; content = true records the part objects. End or -1.
fn array(b: [u8], p: i64, content: bool, inout f: [i64]) -> i64 ! alloc
  requires 0 <= p && p < len(b) && len(f) >= 256
  ensures len(f) == len(old(f))
  ensures result == -1 || (p < result && result <= len(b))
{
  let mut q: i64 = ws(b, p + 1);
  let mut n: i64 = 0;
  f[33] = 0;
  if q < len(b) {
    if b[q] == 93 { return q + 1; }
  }
  while q < len(b)
    invariant p < q && q <= len(b) && len(f) == len(old(f)) && 0 <= n && n <= q
    decreases len(b) - q
  {
    let mut v: i64 = -1;
    if content && b[q] == 123 { v = part(b, q, inout f); } else { v = skip_value(b, q, 119); }
    if v < 0 { return -1; }
    n = n + 1;
    f[33] = n;
    q = ws(b, v);
    if q >= len(b) { return -1; }
    let t: i64 = b[q];
    if t == 93 { return q + 1; }
    if t != 44 { return -1; }
    q = ws(b, q + 1);
  }
  return -1;
}

// The top-level scan: 0 object read into f, 1 fall back to the tape path, 2 skip (not an object line).
pub fn scan(b: [u8], inout f: [i64]) -> i64 ! alloc
  requires len(f) >= 256
  ensures len(f) == len(old(f))
  ensures 0 <= result && result <= 2
{
  let mut i: i64 = 0;
  while i < 34
    invariant 0 <= i && i <= 34 && len(f) == len(old(f))
    decreases 34 - i
  {
    f[i] = -1;
    i = i + 1;
  }
  f[0] = 0;
  f[32] = 0;
  f[33] = 0;
  let p: i64 = ws(b, 0);
  if p >= len(b) { return 2; }
  let c0: i64 = b[p];
  if c0 != 123 {
    if c0 < 128 { return 2; }
    return 1;
  }
  let mut q: i64 = ws(b, p + 1);
  if q < len(b) {
    if b[q] == 125 {
      if ws(b, q + 1) == len(b) { return 0; }
      return 1;
    }
  }
  let mut tools: i64 = 0;
  while q < len(b)
    invariant p < q && q <= len(b) && len(f) == len(old(f))
    decreases len(b) - q
  {
    if b[q] != 34 { return 1; }
    let k: Str = str_end(b, q + 1);
    if k.end < 0 || k.esc != 0 { return 1; }
    let id: i64 = key_id(b, q + 1, k.end);
    q = ws(b, k.end + 1);
    if q >= len(b) { return 1; }
    if b[q] != 58 { return 1; }
    q = ws(b, q + 1);
    if q >= len(b) { return 1; }
    let c: i64 = b[q];
    let mut v: i64 = -1;
    if id == 0 {
      v = skip_value(b, q, 120);
    } else {
      if f[id] != -1 { return 1; }
      let kd: i64 = kind_of(c);
      f[id] = kd;
      f[8 + id] = q;
      if kd == 4 {
        let s: Str = str_end(b, q + 1);
        if s.end < 0 { return 1; }
        f[8 + id] = q + 1;
        f[16 + id] = s.end;
        f[24 + id] = s.esc;
        v = s.end + 1;
      } else if kd == 5 && (id == 4 || id == 7) {
        v = array(b, q, id == 4, inout f);
        if id == 7 { tools = f[33]; }
        f[16 + id] = v;
      } else {
        v = skip_value(b, q, 120);
        f[16 + id] = v;
      }
    }
    if v < 0 { return 1; }
    q = ws(b, v);
    if q >= len(b) { return 1; }
    let t: i64 = b[q];
    if t == 125 {
      f[33] = tools;
      if ws(b, q + 1) == len(b) { return 0; }
      return 1;
    }
    if t != 44 { return 1; }
    q = ws(b, q + 1);
  }
  return 1;
}

// out + t (t is a borrowed view).
fn push(take out: String, t: str) -> String ! alloc
{
  // a line is at most 16 MiB (read::line_step), so the joined text never comes near the catalog bound 2^40
  if len(out) > 1099511627776 - len(t) { return move out; }
  return string_push_str(move out, t);
}

// First backslash in b[q..hi), or hi.
fn run_end(b: [u8], q: i64, hi: i64) -> i64
  requires 0 <= q && q <= hi && hi <= len(b)
  ensures q <= result && result <= hi
{
  let mut e: i64 = q;
  while e < hi
    invariant q <= e && e <= hi
    decreases hi - e
  {
    let c: i64 = b[e];
    if c == 92 { return e; }
    e = e + 1;
  }
  return e;
}

// out + the decoded JSON string body b[lo..hi) (simple escapes only; scan already rejected `\u`). A cut that is not a char
// boundary (impossible after the scan) sets f[0] = 1.
fn decode(take out: String, b: [u8], lo: i64, hi: i64, inout f: [i64]) -> String ! alloc
  requires utf8_valid(b) && 0 <= lo && lo <= hi && hi <= len(b) && len(f) >= 256
  ensures len(f) == len(old(f))
{
  let mut s: String = move out;
  let mut q: i64 = lo;
  while q < hi
    invariant lo <= q && q <= hi && hi <= len(b) && len(f) == len(old(f))
    decreases hi - q
  {
    let e: i64 = run_end(b, q, hi);
    if e > q {
      let a: i64 = b[q];
      let mut z: i64 = 0;
      if e < len(b) { z = b[e]; }
      if (a >= 128 && a < 192) || (e < len(b) && z >= 128 && z < 192) { f[0] = 1; return move s; }
      s = push(move s, subview(b, q, e));
    }
    if e + 1 >= hi {
      if e < hi { f[0] = 1; }
      return move s;
    }
    let x: i64 = b[e + 1];
    if x == 110 { s = push(move s, "\n"); }
    else if x == 116 { s = push(move s, "\t"); }
    else if x == 114 { s = push(move s, "\r"); }
    else if x == 34 { s = push(move s, "\""); }
    else if x == 92 { s = push(move s, "\\"); }
    else if x == 47 { s = push(move s, "/"); }
    else { f[0] = 1; return move s; }
    q = e + 2;
  }
  return move s;
}

// The joined content text when it is not a single borrowed span (f[0] = 1 on a defect).
fn content_text(b: [u8], inout f: [i64]) -> String ! alloc
  requires utf8_valid(b) && len(f) >= 256
  ensures len(f) == len(old(f))
{
  let mut out: String = string_new();
  if f[4] == 4 {
    let lo: i64 = f[12];
    let hi: i64 = f[20];
    if lo < 0 || lo > hi || hi > len(b) { f[0] = 1; return move out; }
    out = decode(move out, b, lo, hi, inout f);
    return move out;
  }
  if f[4] != 5 { return move out; }
  let n: i64 = f[32];
  if n < 0 || n > 64 { f[0] = 1; return move out; }
  let mut first: bool = true;
  let mut k: i64 = 0;
  while k < n
    invariant 0 <= k && k <= n && n <= 64 && len(f) == len(old(f)) && len(f) >= 256
    decreases n - k
  {
    let lo: i64 = f[40 + 3 * k];
    let hi: i64 = f[41 + 3 * k];
    if lo < 0 || lo > hi || hi > len(b) { f[0] = 1; return move out; }
    if hi > lo {
      if !first { out = push(move out, "\n\n"); }
      out = decode(move out, b, lo, hi, inout f);
      first = false;
    }
    k = k + 1;
  }
  return move out;
}

// Hand the entry to entry::user_view / assistant_view with at = b[at .. at + 24) (at >= 0) or "".
fn go(b: [u8], at: i64, text: str, user: bool, skip: bool, nopi: bool, tools: i64, inout st: [i64], inout sl: [i64], inout bk: crate::turns::Store) -> i64 ! alloc
  requires utf8_valid(b)
  requires at == -1 || (0 <= at && at + 24 < len(b) && b[at] < 128 && b[at + 24] < 128)
  requires len(st) == 4 && len(sl) == 1600 && 0 <= st[0] && st[0] < 100000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1) && len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  ensures result == 0 || result == -1
  ensures len(st) == 4 && len(sl) == 1600 && 0 <= st[0] && st[0] <= 100000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1) && len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  ensures st[0] == old(st)[0] || st[0] == old(st)[0] + 1
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
{
  if at < 0 {
    if user { return crate::entry::user_view(text, "", skip, nopi, inout st, inout sl, inout bk); }
    return crate::entry::assistant_view(text, "", tools, inout st, inout sl, inout bk);
  }
  if user { return crate::entry::user_view(text, subview(b, at, at + 24), skip, nopi, inout st, inout sl, inout bk); }
  return crate::entry::assistant_view(text, subview(b, at, at + 24), tools, inout st, inout sl, inout bk);
}

// One history line (see the header). 0 handled, -1 internal failure, 3 = run the tape path on this line.
pub fn step(b: [u8], inout f: [i64], inout st: [i64], inout sl: [i64], inout bk: crate::turns::Store) -> i64 ! alloc
  requires len(f) >= 256
  requires len(st) == 4 && len(sl) == 1600 && 0 <= st[0] && st[0] < 100000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1) && len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  ensures len(f) == len(old(f))
  ensures result == 3 ==> st[0] == old(st)[0]
  ensures len(st) == 4 && len(sl) == 1600 && 0 <= st[0] && st[0] <= 100000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1) && len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  ensures st[0] == old(st)[0] || st[0] == old(st)[0] + 1
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
{
  // above 1 MiB the tape record limit of the old parser could reject a line this scan accepts
  if len(b) > 1048576 { return 3; }
  let r: i64 = scan(b, inout f);
  if r == 2 { return 0; }
  if r != 0 { return 3; }
  if f[1] != 4 { return 0; }
  let ta: i64 = f[9];
  let tb: i64 = f[17];
  if ta < 0 || ta > tb || tb > len(b) { return 3; }
  if f[25] != 0 { return 3; }
  let user: bool = bytes_are(b, ta, tb, "user");
  if !user && !bytes_are(b, ta, tb, "assistant") { return 0; }
  // synthetic_reason neither missing nor null: the user entry is skipped before anything else is looked at
  let skip: bool = f[2] != -1 && f[2] != 0;
  if user && skip { return 0; }
  if !utf8_valid(b) { return 3; }
  // isoOf(timestamp ?? created_at)
  let mut tid: i64 = 5;
  if f[5] == -1 || f[5] == 0 { tid = 6; }
  let tk: i64 = f[tid];
  let mut at: i64 = -1;
  if tk == 3 { return 3; }
  if tk == 4 {
    if f[24 + tid] != 0 { return 3; }
    let s: i64 = f[8 + tid];
    let e: i64 = f[16 + tid];
    if s < 0 || s > len(b) || e != s + 24 || e >= len(b) { return 3; }
    let c: i64 = b[s];
    let z: i64 = b[e];
    if c >= 128 || z >= 128 { return 3; }
    if !crate::time::canonical_iso(subview(b, s, e)) { return 3; }
    at = s;
  }
  let nopi: bool = f[3] == -1 || f[3] == 0;
  let mut tools: i64 = -1;
  if f[7] == 5 { tools = f[33]; }
  if tools > 100000000 { return 3; }
  // a single escape-free span is passed borrowed; anything else is joined into one String
  let mut vlo: i64 = -1;
  let mut vhi: i64 = -1;
  let mut empty: bool = false;
  if f[4] == 4 {
    if f[28] == 0 { vlo = f[12]; vhi = f[20]; }
  } else if f[4] == 5 {
    let n: i64 = f[32];
    if n < 0 || n > 64 { return 3; }
    let mut live: i64 = 0;
    let mut k: i64 = 0;
    while k < n
      invariant 0 <= k && k <= n && n <= 64 && 0 <= live && live <= k && len(f) >= 256 && len(f) == len(old(f))
      decreases n - k
    {
      if f[41 + 3 * k] > f[40 + 3 * k] {
        live = live + 1;
        if f[42 + 3 * k] == 0 { vlo = f[40 + 3 * k]; vhi = f[41 + 3 * k]; } else { vlo = -2; }
      }
      k = k + 1;
    }
    if live == 0 { empty = true; }
    if live != 1 { vlo = -1; }
  } else {
    empty = true;
  }
  if empty { return go(b, at, "", user, skip, nopi, tools, inout st, inout sl, inout bk); }
  if vlo >= 0 {
    if vlo > vhi || vhi >= len(b) { return 3; }
    let a: i64 = b[vlo];
    let z: i64 = b[vhi];
    if (a >= 128 && a < 192) || z >= 128 { return 3; }
    return go(b, at, subview(b, vlo, vhi), user, skip, nopi, tools, inout st, inout sl, inout bk);
  }
  let s: String = content_text(b, inout f);
  if f[0] != 0 { return 3; }
  let t: str = string_to_str(s);
  return go(b, at, t, user, skip, nopi, tools, inout st, inout sl, inout bk);
}
