// Grok import packets (bench/l3/grok/DESIGN.md sections 1 and 2; see IMPL_NOTES.md for the cross-module contract).
//   step packet   [magic, 1, action, 256, pc, rc, lw, lb, lres, 0, 0, 0, ctl(256), patches(8*pc), requests(16*rc),
//                  literal words(lw), literal bytes(lb, one word per byte), final result(lres)]   length 268 + ...
//   result packet [status, 24, rowWords, textLen, meta(24), rows, text bytes (one word per byte)]  length 28 + ...
// Refs are (start,len) into the text of their packet; (-1,0) is absent. There are no consts: constants are nullary fns.
// The name `result` is only special inside expressions, so `fn result` below is called as crate::packet::result(..).

pub fn magic() -> i64 ensures result == 1196577585 { return 1196577585; }
pub fn ctl_len() -> i64 ensures result == 256 { return 256; }
pub fn head_len() -> i64 ensures result == 268 { return 268; }
pub fn c_mode() -> i64 ensures result == 1 { return 1; }
pub fn c_phase() -> i64 ensures result == 2 { return 2; }
pub fn c_next_id() -> i64 ensures result == 3 { return 3; }
pub fn c_pending() -> i64 ensures result == 4 { return 4; }
// ctl word 30 is owned by root: 1 expects the empty event, 2 expects a completion, 3 terminal (modules never write it).
pub fn c_state() -> i64 ensures result == 30 { return 30; }
pub fn slot_base(s: i64) -> i64
  requires 0 <= s && s <= 3
  ensures result == 128 + 32 * s
{ return 128 + 32 * s; }
pub fn bank_directory() -> i64 ensures result == 0 { return 0; }
pub fn bank_rows() -> i64 ensures result == 1 { return 1; }
pub fn bank_text() -> i64 ensures result == 2 { return 2; }
pub fn bank_small(s: i64) -> i64
  requires 0 <= s && s <= 3
  ensures result == 3 + s
{ return 3 + s; }
pub fn bank_history() -> i64 ensures result == 7 { return 7; }

// A ref (s,n) is absent (-1,0) or lies inside a text of `total` bytes.
pub fn ref_ok(s: i64, n: i64, total: i64) -> bool
  ensures result ==> (total >= 0 && ((s == -1 && n == 0) || (0 <= s && s <= total && 0 <= n && n <= total - s)))
{
  if total < 0 { return false; }
  if s == -1 { return n == 0; }
  if s < 0 || s > total { return false; }
  if n < 0 || n > total - s { return false; }
  return true;
}

// ---- small array helpers ----
fn put_words(inout dst: [i64], at: i64, src: [i64]) -> ()
  requires 0 <= at && at <= len(dst) && len(src) <= len(dst) - at
  ensures len(dst) == len(old(dst))
{
  let n: i64 = len(src);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n == len(src) && 0 <= at && at <= len(dst) && n <= len(dst) - at && len(dst) == len(old(dst))
    decreases n - i
  { dst[at + i] = src[i]; i = i + 1; }
}
fn put_bytes(inout dst: [i64], at: i64, src: [u8]) -> ()
  requires 0 <= at && at <= len(dst) && len(src) <= len(dst) - at
  ensures len(dst) == len(old(dst))
{
  let n: i64 = len(src);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n == len(src) && 0 <= at && at <= len(dst) && n <= len(dst) - at && len(dst) == len(old(dst))
    decreases n - i
  { dst[at + i] = src[i]; i = i + 1; }
}
pub fn cat_words(a: [i64], b: [i64]) -> [i64] ! alloc
  requires len(a) <= 50000000 && len(b) <= 50000000
  ensures len(result) == len(a) + len(b)
{
  let mut o: [i64] = alloc(len(a) + len(b), 0);
  put_words(inout o, 0, a);
  put_words(inout o, len(a), b);
  return o;
}
pub fn cat_bytes(a: [u8], b: [u8]) -> [u8] ! alloc
  requires len(a) <= 50000000 && len(b) <= 50000000
  ensures len(result) == len(a) + len(b)
{
  let na: i64 = len(a);
  let nb: i64 = len(b);
  let mut o: [u8] = alloc(na + nb, 0);
  let mut i: i64 = 0;
  while i < na
    invariant 0 <= i && i <= na && na == len(a) && nb == len(b) && len(o) == na + nb
    decreases na - i
  { o[i] = a[i]; i = i + 1; }
  let mut j: i64 = 0;
  while j < nb
    invariant 0 <= j && j <= nb && na == len(a) && nb == len(b) && len(o) == na + nb
    decreases nb - j
  { o[na + j] = b[j]; j = j + 1; }
  return o;
}
// a followed by the UTF-8 bytes of s; the new bytes start at len(a)
pub fn append_str(a: [u8], s: str) -> [u8] ! alloc
  requires len(a) <= 50000000 && len(s) <= 50000000
  ensures len(result) == len(a) + len(s)
{
  let na: i64 = len(a);
  let ns: i64 = len(s);
  let mut o: [u8] = alloc(na + ns, 0);
  let mut i: i64 = 0;
  while i < na
    invariant 0 <= i && i <= na && na == len(a) && ns == len(s) && len(o) == na + ns
    decreases na - i
  { o[i] = a[i]; i = i + 1; }
  let mut j: i64 = 0;
  while j < ns
    invariant 0 <= j && j <= ns && na == len(a) && ns == len(s) && len(o) == na + ns
    decreases ns - j
  { o[na + j] = s[j]; j = j + 1; }
  return o;
}

// ---- ctl ----
// Fresh 256-word control array: schema 1, mode, phase, next request id 1, state 1 (expects the empty event),
// every ref absent (-1,0), every handle/row index -1.
pub fn ctl_init(mode: i64, phase: i64) -> [i64] ! alloc
  requires 0 <= mode && mode <= 5 && 0 <= phase && phase <= 999
  ensures len(result) == 256 && result[3] == 1
{
  let mut c: [i64] = alloc(256, 0);
  c[0] = 1;
  c[1] = mode;
  c[2] = phase;
  c[3] = 1;
  c[16] = -1; c[18] = -1; c[20] = -1; c[22] = -1; c[24] = -1; c[26] = -1;
  c[30] = 1;
  let mut s: i64 = 0;
  while s < 4
    invariant 0 <= s && s <= 4 && len(c) == 256 && c[3] == 1
    decreases 4 - s
  {
    let b: i64 = 128 + 32 * s;
    c[b + 1] = -1; c[b + 4] = -1; c[b + 5] = -1;
    c[b + 16] = -1; c[b + 18] = -1; c[b + 20] = -1; c[b + 22] = -1; c[b + 24] = -1;
    s = s + 1;
  }
  return c;
}
// Terminal control array: phase 999, nothing pending, every slot record cleared.
pub fn ctl_final(ctl: [i64]) -> [i64] ! alloc
  requires len(ctl) == 256
  ensures len(result) == 256
{
  let mut c: [i64] = copy(ctl);
  c[0] = 1;
  c[2] = 999;
  c[4] = 0;
  let mut s: i64 = 0;
  while s < 4
    invariant 0 <= s && s <= 4 && len(c) == 256
    decreases 4 - s
  {
    let b: i64 = 128 + 32 * s;
    c[b + 2] = 0; c[b + 3] = 0;
    s = s + 1;
  }
  return c;
}
fn ctl_mode(ctl: [i64]) -> i64
  requires len(ctl) == 256
  ensures 0 <= result && result <= 5
{
  let m: i64 = ctl[1];
  if m < 0 || m > 5 { return 0; }
  return m;
}

// ---- patch rows (8 words) and request rows (16 words) ----
pub fn patch_resize(bank: i64, newlen: i64) -> [i64] ! alloc
  requires 0 <= bank && bank <= 7 && 0 <= newlen
  ensures len(result) == 8
{
  let mut p: [i64] = alloc(8, 0);
  p[1] = bank;
  p[3] = newlen;
  return p;
}
// src: 1 event words, 2 completion bytes, 3 literal words, 4 literal bytes; count/offsets are in destination-bank elements
pub fn patch_copy(bank: i64, dst_off: i64, count: i64, src: i64, src_off: i64) -> [i64] ! alloc
  requires 0 <= bank && bank <= 7 && 0 <= dst_off && 0 <= count && 1 <= src && src <= 4 && 0 <= src_off
  ensures len(result) == 8
{
  let mut p: [i64] = alloc(8, 0);
  p[0] = 1;
  p[1] = bank;
  p[2] = dst_off;
  p[3] = count;
  p[4] = src;
  p[5] = src_off;
  return p;
}
pub fn request(id: i64, slot: i64, opcode: i64, flags: i64, handle: i64, offset: i64, count: i64, mode: i64,
               p1s: i64, p1l: i64, p2s: i64, p2l: i64, ds: i64, dl: i64, stage: i64) -> [i64] ! alloc
  requires 1 <= id && 0 <= slot && slot <= 3 && 1 <= opcode && opcode <= 13 && 0 <= flags && flags <= 3
  requires -1 <= handle && 0 <= offset && 0 <= count && 0 <= mode && 0 <= stage && stage <= 30
  ensures len(result) == 16
{
  let mut r: [i64] = alloc(16, 0);
  r[0] = id; r[1] = slot; r[2] = opcode; r[3] = flags; r[4] = handle; r[5] = offset; r[6] = count; r[7] = mode;
  r[8] = p1s; r[9] = p1l; r[10] = p2s; r[11] = p2l; r[12] = ds; r[13] = dl; r[14] = stage;
  return r;
}

// ---- completion event ----
// version 1, request 0, slot -1, everything else 0 (readdir row count 0)
pub fn event_empty(event: [i64]) -> bool
  requires len(event) >= 24
{
  return event[0] == 1 && event[1] == 0 && event[2] == -1 && event[3] == 0 && event[4] == 0 && event[16] == 0 && event[18] == 0;
}
// shape of a completion: header ranges, completion length, refs inside the completion bytes, readdir rows consistent
pub fn event_shape(event: [i64], clen: i64) -> bool
  ensures result ==> len(event) >= 24
{
  if len(event) < 24 || clen < 0 { return false; }
  if event[0] != 1 { return false; }
  if event[4] < 0 || event[4] > 1 || event[5] < 0 || event[5] > 4 || event[6] < 0 { return false; }
  if event[7] < 0 || event[7] > 8 || event[13] < -1 || event[14] < 0 || event[15] < 0 || event[15] > 1 { return false; }
  if event[18] != clen { return false; }
  if !ref_ok(event[19], event[20], clen) || !ref_ok(event[21], event[22], clen) { return false; }
  let cnt: i64 = event[16];
  let w: i64 = event[17];
  if cnt < 0 { return false; }
  if w == 0 { return cnt == 0 && len(event) == 24; }
  if w != 3 { return false; }
  if cnt > (len(event) - 24) / 3 { return false; }
  if len(event) != 24 + 3 * cnt { return false; }
  let mut i: i64 = 0;
  while i < cnt
    invariant 0 <= i && i <= cnt && len(event) == 24 + 3 * cnt && cnt >= 0 && clen >= 0
    decreases cnt - i
  {
    let b: i64 = 24 + 3 * i;
    if !ref_ok(event[b], event[b + 1], clen) { return false; }
    if event[b + 2] < 0 || event[b + 2] > 8 { return false; }
    i = i + 1;
  }
  return true;
}

// ---- result packet ----
// meta for a mode: schema 2, every ref absent, no row width, everything else 0
pub fn meta_new(mode: i64) -> [i64] ! alloc
  requires 0 <= mode && mode <= 5
  ensures len(result) == 24
{
  let mut m: [i64] = alloc(24, 0);
  m[0] = 2;
  m[1] = mode;
  m[4] = -1; m[6] = -1; m[8] = -1; m[18] = -1; m[20] = -1; m[22] = -1;
  return m;
}
fn assemble(status: i64, meta: [i64], rows: [i64], text: [u8]) -> [i64] ! alloc
  requires len(meta) == 24 && 0 <= status && status <= 1 && len(rows) <= 100000000 && len(text) <= 100000000
  ensures len(result) == 28 + len(rows) + len(text)
{
  let nr: i64 = len(rows);
  let nx: i64 = len(text);
  let mut p: [i64] = alloc(28 + nr + nx, 0);
  p[0] = status;
  p[1] = 24;
  p[2] = nr;
  p[3] = nx;
  let mut i: i64 = 0;
  while i < 24
    invariant 0 <= i && i <= 24 && len(meta) == 24 && len(p) == 28 + nr + nx && 0 <= nr && 0 <= nx
    decreases 24 - i
  { p[4 + i] = meta[i]; i = i + 1; }
  let mut j: i64 = 0;
  while j < nr
    invariant 0 <= j && j <= nr && nr == len(rows) && len(p) == 28 + nr + nx && 0 <= nx
    decreases nr - j
  { p[28 + j] = rows[j]; j = j + 1; }
  let mut k: i64 = 0;
  while k < nx
    invariant 0 <= k && k <= nx && nx == len(text) && len(p) == 28 + nr + nx && 0 <= nr
    decreases nx - k
  { p[28 + nr + k] = text[k]; k = k + 1; }
  return p;
}
// error packet without text: stage/class/code only (every ref absent)
pub fn simple_error(mode: i64, stage: i64, cls: i64, code: i64) -> [i64] ! alloc
  requires 0 <= mode && mode <= 5 && 0 <= stage && stage <= 30 && 0 <= cls && cls <= 7 && 0 <= code && code <= 8
  ensures len(result) == 28 && result[0] == 1
{
  let mut p: [i64] = alloc(28, 0);
  p[0] = 1; p[1] = 24; p[4] = 2; p[5] = mode;
  p[8] = -1; p[10] = -1; p[12] = -1; p[22] = -1; p[24] = -1; p[26] = -1;
  p[17] = stage; p[18] = cls; p[19] = code;
  return p;
}
pub fn internal_packet(mode: i64) -> [i64] ! alloc
  requires 0 <= mode && mode <= 5
  ensures len(result) == 28 && result[0] == 1
{ return simple_error(mode, 30, 6, 2); }

fn build_error(mode: i64, stage: i64, cls: i64, code: i64, eno: i64, native: i64, raw: [u8], name: str, detail: str) -> [i64] ! alloc
  requires 0 <= mode && mode <= 5 && 0 <= stage && stage <= 30 && 0 <= cls && cls <= 7 && 0 <= code && code <= 8
  requires 0 <= eno && eno <= 4 && 0 <= native
  requires len(raw) <= 10000000 && len(name) <= 10000000 && len(detail) <= 10000000
  ensures len(result) == 28 + len(raw) + len(name) + len(detail)
{
  let lr: i64 = len(raw);
  let ln: i64 = len(name);
  let ld: i64 = len(detail);
  let nx: i64 = lr + ln + ld;
  let mut p: [i64] = alloc(28 + nx, 0);
  p[0] = 1; p[1] = 24; p[3] = nx; p[4] = 2; p[5] = mode;
  p[8] = -1; p[10] = -1; p[12] = -1; p[22] = -1; p[24] = -1; p[26] = -1;
  p[17] = stage; p[18] = cls; p[19] = code; p[20] = eno; p[21] = native;
  if lr > 0 { p[22] = 0; p[23] = lr; }
  if ln > 0 { p[24] = lr; p[25] = ln; }
  if ld > 0 { p[26] = lr + ln; p[27] = ld; }
  let mut i: i64 = 0;
  while i < lr
    invariant 0 <= i && i <= lr && lr == len(raw) && ln == len(name) && ld == len(detail) && nx == lr + ln + ld && len(p) == 28 + nx
    decreases lr - i
  { p[28 + i] = raw[i]; i = i + 1; }
  let mut j: i64 = 0;
  while j < ln
    invariant 0 <= j && j <= ln && lr == len(raw) && ln == len(name) && ld == len(detail) && nx == lr + ln + ld && len(p) == 28 + nx
    decreases ln - j
  { p[28 + lr + j] = name[j]; j = j + 1; }
  let mut k: i64 = 0;
  while k < ld
    invariant 0 <= k && k <= ld && lr == len(raw) && ln == len(name) && ld == len(detail) && nx == lr + ln + ld && len(p) == 28 + nx
    decreases ld - k
  { p[28 + lr + ln + k] = detail[k]; k = k + 1; }
  return p;
}
// Error result with a mode. Out-of-range enums or oversized strings give the InternalInvariant packet instead.
pub fn error_mode(mode: i64, stage: i64, cls: i64, code: i64, eno: i64, native: i64, raw: [u8], name: str, detail: str) -> [i64] ! alloc
  ensures len(result) >= 28
{
  let m: i64 = if_mode(mode);
  if stage < 0 || stage > 30 || cls < 1 || cls > 7 || code < 0 || code > 8 { return internal_packet(m); }
  if eno < 0 || eno > 4 || native < 0 { return internal_packet(m); }
  if len(raw) > 10000000 || len(name) > 10000000 || len(detail) > 10000000 { return internal_packet(m); }
  return build_error(m, stage, cls, code, eno, native, raw, name, detail);
}
fn if_mode(mode: i64) -> i64
  ensures 0 <= result && result <= 5
{
  if mode < 0 || mode > 5 { return 0; }
  return mode;
}
// DESIGN 3: error(stage, class, code, errno class, native errno, raw error.code JSON, name, diagnostic). Mode word is 0 here;
// use error_mode (or done_error, which takes the mode from ctl[1]) when the mode is known.
pub fn error(stage: i64, cls: i64, code: i64, eno: i64, native: i64, raw: [u8], name: str, detail: str) -> [i64] ! alloc
  ensures len(result) >= 28
{ return error_mode(0, stage, cls, code, eno, native, raw, name, detail); }

fn rows12_ok(rows: [i64], count: i64, n: i64) -> bool
  requires 0 <= count && count <= 100000000 && len(rows) == 12 * count && 0 <= n
{
  let mut i: i64 = 0;
  while i < count
    invariant 0 <= i && i <= count && count <= 100000000 && len(rows) == 12 * count && 0 <= n
    decreases count - i
  {
    let b: i64 = 12 * i;
    if !ref_ok(rows[b], rows[b + 1], n) { return false; }
    if !ref_ok(rows[b + 2], rows[b + 3], n) { return false; }
    if !ref_ok(rows[b + 4], rows[b + 5], n) { return false; }
    if !ref_ok(rows[b + 6], rows[b + 7], n) { return false; }
    if !ref_ok(rows[b + 8], rows[b + 9], n) { return false; }
    if rows[b + 10] < 0 || rows[b + 10] > 1 || rows[b + 11] != 0 { return false; }
    i = i + 1;
  }
  return true;
}
fn rows10_ok(rows: [i64], count: i64, n: i64) -> bool
  requires 0 <= count && count <= 100000000 && len(rows) == 10 * count && 0 <= n
{
  let mut i: i64 = 0;
  while i < count
    invariant 0 <= i && i <= count && count <= 100000000 && len(rows) == 10 * count && 0 <= n
    decreases count - i
  {
    let b: i64 = 10 * i;
    if !ref_ok(rows[b], rows[b + 1], n) { return false; }
    if !ref_ok(rows[b + 2], rows[b + 3], n) { return false; }
    if !ref_ok(rows[b + 4], rows[b + 5], n) { return false; }
    if !ref_ok(rows[b + 6], rows[b + 7], n) { return false; }
    if rows[b + 8] < 0 { return false; }
    if rows[b + 9] < 0 || rows[b + 9] > 1 { return false; }
    i = i + 1;
  }
  return true;
}
// meta/rows/text agree: schema 2, enums, success scalars/refs, row width (0, 10 read, 12 list), row refs inside text
fn result_ok(meta: [i64], rows: [i64], text: [u8]) -> bool
  requires len(meta) == 24 && len(rows) <= 100000000 && len(text) <= 100000000
{
  let n: i64 = len(text);
  if meta[0] != 2 || meta[1] < 0 || meta[1] > 5 { return false; }
  if meta[2] < 0 || meta[2] > 1 || meta[11] < 0 || meta[11] > 1 || meta[12] < 0 || meta[12] > 1000000000 { return false; }
  if !ref_ok(meta[4], meta[5], n) || !ref_ok(meta[6], meta[7], n) || !ref_ok(meta[8], meta[9], n) { return false; }
  if meta[13] != 0 || meta[14] != 0 || meta[15] != 0 || meta[16] != 0 || meta[17] != 0 { return false; }
  if meta[18] != -1 || meta[19] != 0 || meta[20] != -1 || meta[21] != 0 || meta[22] != -1 || meta[23] != 0 { return false; }
  let w: i64 = meta[10];
  let cnt: i64 = meta[3];
  if cnt < 0 || cnt > 100000000 { return false; }
  if w == 0 { return cnt == 0 && len(rows) == 0; }
  if meta[1] >= 2 { return false; }
  if w == 12 {
    if len(rows) != 12 * cnt { return false; }
    return rows12_ok(rows, cnt, n);
  }
  if w == 10 {
    if len(rows) != 10 * cnt { return false; }
    return rows10_ok(rows, cnt, n);
  }
  return false;
}
// DESIGN 3: success result. A failed shape check gives the InternalInvariant error packet (stage 30).
pub fn result(meta: [i64], rows: [i64], text: [u8]) -> [i64] ! alloc
  requires len(meta) == 24 && len(rows) <= 100000000 && len(text) <= 100000000
  ensures len(result) >= 28
{
  if !result_ok(meta, rows, text) {
    let mut m: i64 = meta[1];
    if m < 0 || m > 5 { m = 0; }
    return internal_packet(m);
  }
  return assemble(0, meta, rows, text);
}
// A result packet (status 0 or 1) is length-consistent: 28 + rowWords + textLen
pub fn result_shape(res: [i64]) -> bool
  requires len(res) <= 100000000
{
  if len(res) < 28 { return false; }
  if res[0] < 0 || res[0] > 1 || res[1] != 24 || res[4] != 2 { return false; }
  if res[2] < 0 || res[3] < 0 || res[2] > len(res) || res[3] > len(res) { return false; }
  return res[2] + res[3] == len(res) - 28;
}

// ---- step packet ----
fn patches_ok(p: [i64], cnt: i64, wl: i64, bl: i64) -> bool
  requires 0 <= cnt && cnt <= 512 && len(p) == 8 * cnt && 0 <= wl && 0 <= bl
{
  let mut i: i64 = 0;
  while i < cnt
    invariant 0 <= i && i <= cnt && cnt <= 512 && len(p) == 8 * cnt && 0 <= wl && 0 <= bl
    decreases cnt - i
  {
    let b: i64 = 8 * i;
    let kind: i64 = p[b];
    if kind < 0 || kind > 1 { return false; }
    if p[b + 1] < 0 || p[b + 1] > 7 || p[b + 2] < 0 || p[b + 3] < 0 { return false; }
    if p[b + 6] != 0 || p[b + 7] != 0 { return false; }
    if kind == 0 {
      if p[b + 2] != 0 || p[b + 4] != 0 || p[b + 5] != 0 { return false; }
    } else {
      let src: i64 = p[b + 4];
      if src < 1 || src > 4 || p[b + 5] < 0 { return false; }
      if src == 3 && (p[b + 5] > wl || p[b + 3] > wl - p[b + 5]) { return false; }
      if src == 4 && (p[b + 5] > bl || p[b + 3] > bl - p[b + 5]) { return false; }
    }
    i = i + 1;
  }
  return true;
}
fn requests_ok(r: [i64], cnt: i64, bl: i64) -> bool
  requires 0 <= cnt && cnt <= 4 && len(r) == 16 * cnt && 0 <= bl
{
  let mut i: i64 = 0;
  while i < cnt
    invariant 0 <= i && i <= cnt && cnt <= 4 && len(r) == 16 * cnt && 0 <= bl
    decreases cnt - i
  {
    let b: i64 = 16 * i;
    if r[b] < 1 || r[b + 1] < 0 || r[b + 1] > 3 || r[b + 2] < 1 || r[b + 2] > 13 { return false; }
    if r[b + 3] < 0 || r[b + 3] > 3 || r[b + 4] < -1 || r[b + 5] < 0 || r[b + 6] < 0 || r[b + 7] < 0 { return false; }
    if !ref_ok(r[b + 8], r[b + 9], bl) || !ref_ok(r[b + 10], r[b + 11], bl) || !ref_ok(r[b + 12], r[b + 13], bl) { return false; }
    if r[b + 14] < 0 || r[b + 14] > 30 || r[b + 15] != 0 { return false; }
    i = i + 1;
  }
  return true;
}
fn step_args_ok(ctl: [i64], patches: [i64], requests: [i64], words: [i64], bytes: [u8], res: [i64], action: i64) -> bool
  requires len(ctl) == 256 && len(patches) <= 4096 && len(requests) <= 64 && len(words) <= 100000000 && len(bytes) <= 100000000 && len(res) <= 100000000
{
  if action < 0 || action > 2 { return false; }
  if ctl[0] != 1 || ctl[2] < 0 || ctl[2] > 999 { return false; }
  if len(patches) % 8 != 0 || len(requests) % 16 != 0 { return false; }
  if len(patches) / 8 > 512 || len(requests) / 16 > 4 { return false; }
  if action == 1 {
    if len(patches) != 0 || len(requests) != 0 || !result_shape(res) { return false; }
  } else {
    if len(res) != 0 { return false; }
    if action == 2 && len(requests) != 0 { return false; }
    if action == 0 && len(requests) == 0 && ctl[4] == 0 { return false; }
  }
  if !patches_ok(patches, len(patches) / 8, len(words), len(bytes)) { return false; }
  if !requests_ok(requests, len(requests) / 16, len(bytes)) { return false; }
  return true;
}
fn assemble_step(ctl: [i64], patches: [i64], requests: [i64], words: [i64], bytes: [u8], res: [i64], action: i64) -> [i64] ! alloc
  requires len(ctl) == 256 && len(patches) <= 4096 && len(requests) <= 64 && len(words) <= 100000000 && len(bytes) <= 100000000 && len(res) <= 100000000
  ensures len(result) == 268 + len(patches) + len(requests) + len(words) + len(bytes) + len(res)
{
  let lp: i64 = len(patches);
  let lq: i64 = len(requests);
  let lw: i64 = len(words);
  let lb: i64 = len(bytes);
  let lr: i64 = len(res);
  let total: i64 = 268 + lp + lq + lw + lb + lr;
  let mut p: [i64] = alloc(total, 0);
  p[0] = 1196577585;
  p[1] = 1;
  p[2] = action;
  p[3] = 256;
  p[4] = lp / 8;
  p[5] = lq / 16;
  p[6] = lw;
  p[7] = lb;
  p[8] = lr;
  let a1: i64 = 268;
  let a2: i64 = a1 + lp;
  let a3: i64 = a2 + lq;
  let a4: i64 = a3 + lw;
  let a5: i64 = a4 + lb;
  put_words(inout p, 12, ctl);
  put_words(inout p, a1, patches);
  put_words(inout p, a2, requests);
  put_words(inout p, a3, words);
  put_bytes(inout p, a4, bytes);
  put_words(inout p, a5, res);
  return p;
}
// A done packet with the InternalInvariant result: used whenever a step packet fails its own shape check.
fn invariant_step(ctl: [i64]) -> [i64] ! alloc
  requires len(ctl) == 256
  ensures len(result) >= 268
{
  let c: [i64] = ctl_final(ctl);
  let e: [i64] = internal_packet(ctl_mode(c));
  let ep: [i64] = alloc(0, 0);
  let eb: [u8] = alloc(0, 0);
  return assemble_step(c, ep, ep, ep, eb, e, 1);
}
// DESIGN 3 step_packet. action 0 await (>=1 request, or something still pending), 1 done (res is a result packet, no
// patches/requests), 2 continue (no requests). Any shape failure returns a done packet carrying InternalInvariant.
pub fn step_packet(ctl: [i64], patches: [i64], requests: [i64], words: [i64], bytes: [u8], res: [i64], action: i64) -> [i64] ! alloc
  requires len(ctl) == 256 && len(patches) <= 4096 && len(requests) <= 64 && len(words) <= 100000000 && len(bytes) <= 100000000 && len(res) <= 100000000
  ensures len(result) >= 268
{
  if !step_args_ok(ctl, patches, requests, words, bytes, res, action) { return invariant_step(ctl); }
  return assemble_step(ctl, patches, requests, words, bytes, res, action);
}
// Finish with a result packet from result()/error*/load_check. ctl is finalised (phase 999, nothing pending).
pub fn done_wrap(ctl: [i64], res: [i64]) -> [i64] ! alloc
  requires len(ctl) == 256
  ensures len(result) >= 268
{
  let c: [i64] = ctl_final(ctl);
  if len(res) > 100000000 { return invariant_step(c); }
  let ep: [i64] = alloc(0, 0);
  let eb: [u8] = alloc(0, 0);
  return step_packet(c, ep, ep, ep, eb, res, 1);
}
// done packet with an error result; the mode word comes from ctl[1]
pub fn done_error(ctl: [i64], stage: i64, cls: i64, code: i64, eno: i64, native: i64, raw: [u8], name: str, detail: str) -> [i64] ! alloc
  requires len(ctl) == 256
  ensures len(result) >= 268
{
  let e: [i64] = error_mode(ctl_mode(ctl), stage, cls, code, eno, native, raw, name, detail);
  return done_wrap(ctl, e);
}
// done packet with a text-free error (stage, class, code)
pub fn done_simple(ctl: [i64], stage: i64, cls: i64, code: i64) -> [i64] ! alloc
  requires len(ctl) == 256
  ensures len(result) >= 268
{
  if stage < 0 || stage > 30 || cls < 1 || cls > 7 || code < 0 || code > 8 { return invariant_step(ctl); }
  let e: [i64] = simple_error(ctl_mode(ctl), stage, cls, code);
  return done_wrap(ctl, e);
}
pub fn done_internal(ctl: [i64], stage: i64) -> [i64] ! alloc
  requires len(ctl) == 256
  ensures len(result) >= 268
{ return done_simple(ctl, stage, 6, 2); }
