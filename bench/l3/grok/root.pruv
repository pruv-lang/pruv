// Grok conversation import (L3-6): public entries. See bench/l3/grok/DESIGN.md and IMPL_NOTES.md.
// Pruv owns every decision; the host only runs primitive requests and applies bank patches. Each grok_step consumes
// at most one completion and returns one step packet. Root validates shapes, matches the completion, dispatches by
// ctl phase range to the mode modules, and checks what they return before the host sees it.
mod json;
mod parse;
mod access;
mod jstr;
mod lines;
mod tail;
mod bytes;
mod text;
mod time;
mod names;
mod turns;
mod args;
mod transport;
mod util;
mod packet;
mod path;
mod summary;
mod list;
mod framing;
mod entry;
mod line;
mod read;
mod copy;
mod rpc;

fn bit_of(s: i64) -> i64
  requires 0 <= s && s <= 3
  ensures 1 <= result && result <= 8
{
  if s == 0 { return 1; }
  if s == 1 { return 2; }
  if s == 2 { return 4; }
  return 8;
}

// cfg: 24 words, schema 1, mode 0..5, timeout 0..2^31-1, reserved words 0, every ref absent or inside cfg_text (<= 1000000 bytes)
fn cfg_ok(cfg: [i64], t: [u8]) -> bool
  ensures result ==> (len(cfg) == 24 && 0 <= cfg[1] && cfg[1] <= 5 && 0 <= cfg[2] && cfg[2] <= 2147483647)
  ensures result ==> len(t) <= 100000000
{
  if len(cfg) != 24 || len(t) > 100000000 { return false; }
  if cfg[0] != 1 || cfg[1] < 0 || cfg[1] > 5 { return false; }
  if cfg[2] < 0 || cfg[2] > 2147483647 { return false; }
  if cfg[3] != 0 || cfg[22] != 0 || cfg[23] != 0 { return false; }
  let mut k: i64 = 4;
  while k <= 20
    invariant 4 <= k && k <= 22 && len(cfg) == 24 && len(t) <= 100000000
    decreases 22 - k
  {
    if !crate::packet::ref_ok(cfg[k], cfg[k + 1], len(t)) { return false; }
    if cfg[k + 1] > 1000000 { return false; }
    k = k + 2;
  }
  return true;
}

// slot records of a 256-word control block at offset off: bit s of the pending mask <=> request id > 0, opcode 0..13
fn slots_ok(a: [i64], off: i64) -> bool
  requires 0 <= off && off <= 100 && len(a) >= off + 256
{
  let m: i64 = a[off + 4];
  if m < 0 || m > 15 { return false; }
  let mut s: i64 = 0;
  while s < 4
    invariant 0 <= s && s <= 4 && 0 <= off && off <= 100 && len(a) >= off + 256 && 0 <= m && m <= 15
    decreases 4 - s
  {
    let b: i64 = off + 128 + 32 * s;
    let id: i64 = a[b + 2];
    let op: i64 = a[b + 3];
    if id < 0 || op < 0 || op > 13 { return false; }
    let on: i64 = band(m, bit_of(s));
    if on != 0 && id == 0 { return false; }
    if on == 0 && (id != 0 || op != 0) { return false; }
    s = s + 1;
  }
  return true;
}

// ctl: exactly 256 words, schema 1, same mode as cfg, phase 0..999, next id 1..1e9, pending 0..15, state 1..3, slots consistent
fn ctl_ok(cfg: [i64], ctl: [i64]) -> bool
  requires len(cfg) == 24
  ensures result ==> (len(ctl) == 256 && 1 <= ctl[3] && ctl[3] <= 1000000000 && 0 <= ctl[4] && ctl[4] <= 15 && ctl[1] == cfg[1])
  ensures result ==> (0 <= ctl[2] && ctl[2] <= 999 && 1 <= ctl[30] && ctl[30] <= 3)
{
  if len(ctl) != 256 { return false; }
  if ctl[0] != 1 || ctl[1] != cfg[1] { return false; }
  if ctl[2] < 0 || ctl[2] > 999 { return false; }
  if ctl[3] < 1 || ctl[3] > 1000000000 { return false; }
  if ctl[4] < 0 || ctl[4] > 15 { return false; }
  if ctl[30] < 1 || ctl[30] > 3 { return false; }
  return slots_ok(ctl, 0);
}

// every host bank is at most 100000000 elements (the modules rely on this)
fn banks_ok(directory: [i64], rows: [i64], text: [u8], s0: [u8], s1: [u8], s2: [u8], s3: [u8], history: [u8], completion: [u8]) -> bool
  ensures result ==> (len(directory) <= 100000000 && len(rows) <= 100000000 && len(text) <= 100000000 && len(s0) <= 100000000)
  ensures result ==> (len(s1) <= 100000000 && len(s2) <= 100000000 && len(s3) <= 100000000 && len(history) <= 100000000)
  ensures result ==> len(completion) <= 100000000
{
  return len(directory) <= 100000000 && len(rows) <= 100000000 && len(text) <= 100000000 && len(s0) <= 100000000
    && len(s1) <= 100000000 && len(s2) <= 100000000 && len(s3) <= 100000000 && len(history) <= 100000000
    && len(completion) <= 100000000;
}

// the completion names the outstanding request of its slot: slot 0..3, pending bit set, same id and opcode
fn matches(ctl: [i64], event: [i64]) -> bool
  requires len(ctl) == 256 && len(event) >= 24
  ensures result ==> (0 <= event[2] && event[2] <= 3)
{
  let s: i64 = event[2];
  if s < 0 || s > 3 { return false; }
  let id: i64 = event[1];
  if id <= 0 { return false; }
  let b: i64 = 128 + 32 * s;
  if ctl[b + 2] != id || ctl[b + 3] != event[3] { return false; }
  return band(ctl[4], bit_of(s)) != 0;
}

// the control state is changed (a continue packet must make progress)
fn ctl_differs(old: [i64], p: [i64]) -> bool
  requires len(old) == 256 && len(p) >= 268
{
  let mut i: i64 = 0;
  while i < 256
    invariant 0 <= i && i <= 256 && len(old) == 256 && len(p) >= 268
    decreases 256 - i
  {
    if p[12 + i] != old[i] { return true; }
    i = i + 1;
  }
  return false;
}

// What a module returned: header and length consistent, new ctl valid (mode kept, ids only grow, slot records consistent),
// every request row backed by its slot record and pending bit, action rules, and the completed slot's request consumed.
fn out_ok(old: [i64], p: [i64], cslot: i64, cid: i64) -> bool
  requires len(old) == 256 && 1 <= old[3] && old[3] <= 1000000000 && -1 <= cslot && cslot <= 3
  ensures result ==> len(p) >= 268
{
  if len(p) < 268 || len(p) > 1000000000 { return false; }
  if p[0] != 1196577585 || p[1] != 1 || p[3] != 256 { return false; }
  let action: i64 = p[2];
  if action < 0 || action > 2 { return false; }
  let pc: i64 = p[4];
  let rc: i64 = p[5];
  let lw: i64 = p[6];
  let lb: i64 = p[7];
  let lr: i64 = p[8];
  if pc < 0 || pc > 512 || rc < 0 || rc > 4 { return false; }
  if lw < 0 || lw > 100000000 || lb < 0 || lb > 100000000 || lr < 0 || lr > 100000000 { return false; }
  if len(p) != 268 + 8 * pc + 16 * rc + lw + lb + lr { return false; }
  if p[12] != 1 || p[13] != old[1] || p[14] < 0 || p[14] > 999 { return false; }
  if p[15] < old[3] || p[15] > old[3] + 4 { return false; }
  if p[16] < 0 || p[16] > 15 { return false; }
  if !slots_ok(p, 12) { return false; }
  if action == 2 && (rc != 0 || !ctl_differs(old, p)) { return false; }
  if action == 1 && rc != 0 { return false; }
  if action == 0 && rc == 0 && p[16] == 0 { return false; }
  let mut seen: i64 = 0;
  let mut r: i64 = 0;
  while r < rc
    invariant 0 <= r && r <= rc && rc <= 4 && 0 <= pc && pc <= 512 && 0 <= lw && 0 <= lb && 0 <= lr
    invariant len(p) == 268 + 8 * pc + 16 * rc + lw + lb + lr
    invariant 1 <= old[3] && old[3] <= 1000000000 && len(old) == 256 && 0 <= seen && seen <= 15
    decreases rc - r
  {
    let b: i64 = 268 + 8 * pc + 16 * r;
    let id: i64 = p[b];
    let slot: i64 = p[b + 1];
    let opc: i64 = p[b + 2];
    if slot < 0 || slot > 3 { return false; }
    if id < old[3] || id >= p[15] { return false; }
    let rec: i64 = 12 + 128 + 32 * slot;
    if p[rec + 2] != id || p[rec + 3] != opc { return false; }
    let pw: i64 = bit_of(slot);
    if band(p[16], pw) == 0 || band(seen, pw) != 0 { return false; }
    seen = bor(seen, pw);
    if seen < 0 || seen > 15 { return false; }
    r = r + 1;
  }
  if cslot >= 0 {
    let rec2: i64 = 12 + 128 + 32 * cslot;
    if p[rec2 + 2] == cid { return false; }
  }
  return true;
}

// root-owned ctl word 30 from the action: continue -> 1 (expect the empty event), await -> 2 (expect a completion), done -> 3
fn stamp(inout p: [i64]) -> ()
  requires len(p) >= 268
  ensures len(p) == len(old(p))
{
  let a: i64 = p[2];
  let mut s: i64 = 1;
  if a == 0 { s = 2; }
  if a == 1 { s = 3; }
  p[42] = s;
}

// one recursive-force remove (opcode 10, flags 3, stage 29) of path on slot 0; the next phase 701 waits for its completion
fn rm_step(ctl: [i64], path: [u8]) -> [i64] ! alloc
  requires len(ctl) == 256 && 1 <= ctl[3] && ctl[3] <= 1000000000
  ensures len(result) >= 268
{
  if len(path) == 0 || len(path) > 1000000 { return crate::packet::done_simple(ctl, 29, 6, 2); }
  let id: i64 = ctl[3];
  let mut c: [i64] = copy(ctl);
  c[2] = 701;
  c[3] = id + 1;
  c[4] = 1;
  c[130] = id;
  c[131] = 10;
  let req: [i64] = crate::packet::request(id, 0, 10, 3, -1, 0, 0, 0, 0, len(path), -1, 0, -1, 0, 29);
  let ep: [i64] = alloc(0, 0);
  return crate::packet::step_packet(c, ep, req, ep, path, ep, 0);
}

// phase dispatch (ranges in IMPL_NOTES.md); the modules are written against exactly these calls
fn route(cfg: [i64], cfg_text: [u8], ctl: [i64], directory: [i64], rows: [i64], text: [u8],
         small0: [u8], small1: [u8], small2: [u8], small3: [u8], history: [u8], event: [i64], completion: [u8]) -> [i64] ! async, net, proc, alloc
  requires len(cfg) == 24 && 0 <= cfg[2] && cfg[2] <= 2147483647 && len(ctl) == 256 && len(event) >= 24
  requires 1 <= ctl[3] && ctl[3] <= 1000000000 && 0 <= ctl[4] && ctl[4] <= 15 && 0 <= ctl[2] && ctl[2] <= 999
  requires len(cfg_text) <= 100000000 && len(directory) <= 100000000 && len(rows) <= 100000000 && len(text) <= 100000000
  requires len(small0) <= 100000000 && len(small1) <= 100000000 && len(small2) <= 100000000 && len(small3) <= 100000000
  requires len(history) <= 100000000 && len(completion) <= 100000000
  ensures len(result) >= 268
{
  let phase: i64 = ctl[2];
  if phase >= 100 && phase <= 199 {
    return crate::path::advance(cfg, cfg_text, ctl, directory, rows, text, small0, small1, small2, small3, history, event, completion);
  }
  if phase >= 200 && phase <= 299 {
    return crate::summary::advance(cfg, cfg_text, ctl, directory, rows, text, small0, small1, small2, small3, history, event, completion);
  }
  if phase >= 300 && phase <= 399 {
    return crate::list::advance(cfg, cfg_text, ctl, directory, rows, text, small0, small1, small2, small3, history, event, completion);
  }
  if phase >= 400 && phase <= 499 {
    return crate::read::advance(cfg, cfg_text, ctl, directory, rows, text, small0, small1, small2, small3, history, event, completion);
  }
  if phase >= 500 && phase <= 599 {
    return crate::copy::advance(cfg, cfg_text, ctl, directory, rows, text, small0, small1, small2, small3, history, event, completion);
  }
  if phase == 600 {
    // load mode: no filesystem work, the ACP check of the target home (cfg words 10,11) runs exactly once
    let binary: str = crate::util::cfg_str(cfg_text, cfg[12], cfg[13]);
    let home: str = crate::util::cfg_str(cfg_text, cfg[10], cfg[11]);
    let folder: str = crate::util::cfg_str(cfg_text, cfg[6], cfg[7]);
    let thread: str = crate::util::cfg_str(cfg_text, cfg[8], cfg[9]);
    let res: [i64] = crate::rpc::load_check(binary, home, folder, thread, cfg[2]);
    return crate::packet::done_wrap(ctl, res);
  }
  if phase == 700 {
    // caller cleanup from cfg words 20,21: issue the remove
    if cfg[20] < 0 || cfg[21] <= 0 { return crate::packet::done_simple(ctl, 29, 6, 2); }
    return rm_step(ctl, crate::util::span_bytes(cfg_text, cfg[20], cfg[21]));
  }
  if phase == 701 {
    // the remove completed (its errors never matter): success with no rows
    if event[2] != 0 || event[3] != 10 { return crate::packet::done_internal(ctl, 29); }
    let meta: [i64] = crate::packet::meta_new(5);
    let er: [i64] = alloc(0, 0);
    let et: [u8] = alloc(0, 0);
    return crate::packet::done_wrap(ctl, crate::packet::result(meta, er, et));
  }
  return crate::packet::done_internal(ctl, 30);
}

pub fn grok_begin(cfg: [i64], cfg_text: [u8]) -> [i64] ! alloc
  ensures len(result) >= 268
{
  if !cfg_ok(cfg, cfg_text) { return crate::packet::done_internal(crate::packet::ctl_init(0, 999), 0); }
  let mode: i64 = cfg[1];
  let mut phase: i64 = 100;
  if mode == 2 { phase = 500; }
  if mode == 3 { phase = 600; }
  if mode == 4 { phase = 200; }
  if mode == 5 { phase = 700; }
  let ctl: [i64] = crate::packet::ctl_init(mode, phase);
  let ep: [i64] = alloc(0, 0);
  let eb: [u8] = alloc(0, 0);
  let mut p: [i64] = crate::packet::step_packet(ctl, ep, ep, ep, eb, ep, 2);
  stamp(inout p);
  return p;
}

pub fn grok_step(
  cfg: [i64], cfg_text: [u8],
  ctl: [i64],
  directory: [i64], rows: [i64], text: [u8],
  small0: [u8], small1: [u8], small2: [u8], small3: [u8],
  history: [u8],
  event: [i64], completion: [u8]
) -> [i64] ! async, net, proc, alloc
  ensures len(result) >= 268
{
  if !cfg_ok(cfg, cfg_text) { return crate::packet::done_internal(crate::packet::ctl_init(0, 999), 0); }
  let blank: [i64] = crate::packet::ctl_init(cfg[1], 999);
  if !ctl_ok(cfg, ctl) { return crate::packet::done_internal(blank, 30); }
  if !banks_ok(directory, rows, text, small0, small1, small2, small3, history, completion) {
    return crate::packet::done_simple(ctl, 0, 6, 1);
  }
  if !crate::packet::event_shape(event, len(completion)) { return crate::packet::done_internal(ctl, 30); }
  // one terminal; the empty event only after begin/continue; a completion only after an await
  let st: i64 = ctl[30];
  let empty_ev: bool = crate::packet::event_empty(event);
  let mut cslot: i64 = -1;
  let mut cid: i64 = 0;
  if st == 1 {
    if !empty_ev { return crate::packet::done_internal(ctl, 30); }
  } else if st == 2 {
    if empty_ev || !matches(ctl, event) { return crate::packet::done_internal(ctl, 30); }
    cslot = event[2];
    cid = event[1];
  } else {
    return crate::packet::done_internal(ctl, 30);
  }
  let mut p: [i64] = route(cfg, cfg_text, ctl, directory, rows, text, small0, small1, small2, small3, history, event, completion);
  if !out_ok(ctl, p, cslot, cid) { return crate::packet::done_internal(ctl, 30); }
  stamp(inout p);
  return p;
}

// load check without filesystem steps: a result packet (DESIGN 2, mode 3), no step packet
pub fn grok_load(binary: str, home: str, folder: str, thread: str, timeout_ms: i64) -> [i64] ! async, net, proc, alloc
  ensures len(result) >= 28
{
  if len(binary) > 1000000 || len(home) > 1000000 || len(folder) > 1000000 || len(thread) > 1000000 {
    return crate::packet::simple_error(3, 0, 6, 1);
  }
  if timeout_ms < 0 || timeout_ms > 2147483647 { return crate::packet::simple_error(3, 0, 6, 2); }
  return crate::rpc::load_check(binary, home, folder, thread, timeout_ms);
}

// the test caller's rollback entry: one recursive force remove of the returned copy path (opcode 10, flags 3, slot 0);
// feed the step packet to grok_step exactly like any other (phase 701 then waits for the remove's completion)
pub fn grok_caller_cleanup(path: str) -> [i64] ! alloc
  ensures len(result) >= 268
{
  let ctl: [i64] = crate::packet::ctl_init(5, 700);
  if len(path) == 0 || len(path) > 1000000 {
    let mut q: [i64] = crate::packet::done_simple(ctl, 29, 6, 2);
    stamp(inout q);
    return q;
  }
  let mut p: [i64] = rm_step(ctl, crate::util::to_bytes(path));
  stamp(inout p);
  return p;
}
