// Grok ACP load check (grokLoadCheck on withRpcChild, jsonrpc true) on the G10 event loop. Package E, written WITHOUT a shell:
// nothing here was compiled or verified. Style and proofs follow bench/l3/codex/rpc.pruv (same transport, same loop invariants).
//
// NOTES / THINGS I WAS UNSURE ABOUT  (spec P11 is resolved: a failed stdin write half-closes stdin and stdout is still read, as TS does)
//  1. Local helpers: grok util.pruv has no `field`, `join`, `id_is`, `int_bytes`, `trim` (the Codex util has them), so this file has
//     private copies (`field`, `id_is`, `trim_bounds`); joins use packet::cat_bytes.
//  2. `inout` arrays are only written element by element (never replaced): the RpcResponseError detail text and raw `error.code` JSON
//     travel in the caller-owned buffer `aux` (detail at 0..300, raw code from 512, at most 8388608 bytes; longer => internal invariant).
//  3. kind 0 null/1 false/2 true/3 number/4 string/5 array/6 object are taken from access::kind (as the Codex rpc does).
//     "loadSession === true" is access::boolean(..) == 1 on an object agentCapabilities of an object-or-not result.
//  4. A non-object `error` (string, number, ...) does NOT reject (TS: record(error) is undefined => resolve(result)); the line is
//     then a normal response whose result is `result` (missing/null allowed for session/load, not enough for initialize).
//  5. `timeout_ms == 0` means the host default 20000 (IMPL_NOTES leaves the meaning of 0 to load_check). Capped at 86400000 like Codex.
//  6. Drain: after the initialize reply settles, the remaining COMPLETE lines of the same chunk (st[2] < st[4]) are processed with an
//     empty outstanding set (server requests get -32601, everything else is ignored) BEFORE request 2 is written (P6 chunk ordering).
//     The drain calls transport::receive_grow via `step`, which also polls once with wait 0 (a timeout could fire there; acceptable).
//  7. proc_spawn_env(binary, args, cwd, names, values): the arguments are not `move`d, as in tests/runtime/g10p_r22_env.pruv.
//  8. Result mapping (all mode 3, class 1 = EngineImportError, class 3 = RpcResponseError):
//       spawn failure: stage 24 code 8 (engine-missing); loop capacity failure: stage 24 code 7;
//       read-failed (EOF, exit, transport failure, 1000000 pump events, oversize line): stage 25 or 26 code 7;
//       timeout: stage 25/26 code 6; capability missing/false/non-true: stage 25 code 5 (grok-load-failed);
//       error response: stage 25/26 class 3 code 0 with raw error.code JSON (absent if no code), name RpcResponseError,
//       detail = message cut to 300 units with non-ASCII as '?' or "rejected";   internal: stage 30 class 6 code 2.
//  9. The `args` package is not used (the argv is the fixed three words agent --no-leader stdio).
// ctl (16 words): 0 failure (0 none, 2 internal, 3 rpc error response, 4 no loadSession, 5 timeout, 6 read-failed, 7 engine-missing)
//   1 stage (24 spawn, 25 initialize, 26 session/load)  2 process slot (-1 none)  3 timer slot  4 last request id
//   5 1 when step left a line  6 length of that line in `line`  7 exit code of a closed child  8 raw code length in aux  9 detail length in aux
//   10 overall budget in ms (transport::send deadline)

// ---- private helpers ----

fn field(d: crate::json::JsonDocument, id: i64, key: str) -> i64 ! alloc { return crate::access::field(d, id, key); }

// P6: a response id matches only when its JSON token is exactly the decimal text of the request id.
fn id_is(b: [u8], id: i64) -> bool
  requires 1 <= id && id <= 99
{
  if id < 10 {
    if len(b) != 1 { return false; }
    let c: i64 = b[0];
    return c == 48 + id;
  }
  if len(b) != 2 { return false; }
  let c0: i64 = b[0];
  let c1: i64 = b[1];
  return c0 == 48 + id / 10 && c1 == 48 + id % 10;
}

// ECMAScript trim whitespace, encoded as UTF-8 (same table as the Codex util).
fn space(b: [u8], i: i64) -> i64
  requires 0 <= i && i < len(b)
  ensures 0 <= result && result <= 3 && result <= len(b) - i
{
  let c: i64 = b[i];
  if c == 32 || (9 <= c && c <= 13) { return 1; }
  if i + 1 < len(b) && c == 194 && b[i + 1] == 160 { return 2; }
  if i + 2 < len(b) {
    if c == 225 && b[i + 1] == 154 && b[i + 2] == 128 { return 3; }
    if c == 226 && b[i + 1] == 128 && ((128 <= b[i + 2] && b[i + 2] <= 138) || b[i + 2] == 168 || b[i + 2] == 169 || b[i + 2] == 175) { return 3; }
    if c == 226 && b[i + 1] == 129 && b[i + 2] == 159 { return 3; }
    if c == 227 && b[i + 1] == 128 && b[i + 2] == 128 { return 3; }
    if c == 239 && b[i + 1] == 187 && b[i + 2] == 191 { return 3; }
  }
  return 0;
}

// DB56 (G-DB55-5): the bounds the old trim_bytes copied out, without the copy: b[lo..hi) is b without leading and trailing
// whitespace (the same `space` steps), lo == hi when b is all whitespace.
struct Bounds { lo: i64, hi: i64 }
fn trim_bounds(b: [u8]) -> Bounds
  ensures 0 <= result.lo && result.lo <= result.hi && result.hi <= len(b)
{
  let mut lo: i64 = 0;
  let mut k: i64 = 1;
  while lo < len(b) && k > 0
    invariant 0 <= lo && lo <= len(b) && k >= 0
    decreases len(b) - lo + k
  {
    k = space(b, lo);
    lo = lo + k;
  }
  if lo >= len(b) { return Bounds { lo: len(b), hi: len(b) }; }
  // DB65 (hand trim_bounds): an ASCII non-space last byte is never part of a multi-byte space step, so the walk would end at len(b)
  let last: i64 = b[len(b) - 1];
  if last < 128 && last != 32 && (last < 9 || last > 13) { return Bounds { lo: lo, hi: len(b) }; }
  let mut hi: i64 = 0;
  let mut i: i64 = lo;
  while i < len(b)
    invariant 0 <= lo && lo <= i && 0 <= hi && hi <= i && i <= len(b)
    decreases len(b) - i
  {
    let n: i64 = space(b, i);
    if n > 0 { if lo == i { lo = lo + n; } i = i + n; }
    else { i = i + 1; hi = i; }
  }
  if hi < lo { hi = lo; }
  return Bounds { lo: lo, hi: hi };
}

// ---- DB65 line path in the hand_rpc.rs shape (bench/l3/grok/RESHAPE_LINE.md) ----
// One pass over the trimmed line view t = line[lo..hi) (a borrowed subview, nothing copied) records the spans the loop needs, the
// way hand_rpc.rs line()/member() does. Spans are positions in t. Kinds are the access kinds (-1 absent, 0 null, 1 bool, 3 number,
// 4 string, 5 array, 6 object). Duplicate keys: the last one wins (access::field), so a tracked key resets what it owns.
// Two shapes go to the old tape path (parse_line) instead (fb): an escaped key inside a tracked object (access::field compares
// decoded keys) and, at the use site, an object `error` (detail and the json_value of the code are taken from the tape there).
pub struct Cap {
  lo: i64, hi: i64, root: i64,
  id_s: i64, id_e: i64, id_k: i64,
  m_s: i64, m_e: i64, m_k: i64, m_p: i64,
  x_s: i64, x_e: i64, x_k: i64, x_p: i64,
  err: i64, res: i64, caps: i64, ls: i64, rec: i64, fb: i64
}

// a scanned value: start s (first byte), end e (one past, -1 on a parse failure), kind k, p = 1 when a string has no escape
struct Val { s: i64, e: i64, k: i64, p: i64 }

pub fn cap_new() -> Cap
{
  return Cap { lo: 0, hi: 0, root: -1, id_s: 0, id_e: 0, id_k: -1, m_s: 0, m_e: 0, m_k: -1, m_p: 1, x_s: 0, x_e: 0, x_k: -1, x_p: 1, err: -1, res: -1, caps: -1, ls: 0, rec: 0, fb: 0 };
}

fn bad() -> Val
  ensures result.e == -1
{ return Val { s: 0, e: -1, k: -1, p: 1 }; }

// JSON whitespace run from p.
fn ws(b: [u8], p: i64) -> i64
  requires 0 <= p && p <= len(b)
  ensures p <= result && result <= len(b)
{
  let mut q: i64 = p;
  while q < len(b)
    invariant p <= q && q <= len(b)
    decreases len(b) - q
  {
    let c: i64 = b[q];
    if c != 32 && c != 10 && c != 13 && c != 9 { return q; }
    q = q + 1;
  }
  return q;
}

// First `"`, `\` or control byte at or after q, or len(b).
fn stop(b: [u8], q: i64) -> i64
  requires 0 <= q && q <= len(b)
  ensures q <= result && result <= len(b)
{
  let mut e: i64 = q;
  while e < len(b)
    invariant q <= e && e <= len(b)
    decreases len(b) - e
  {
    let c: i64 = b[e];
    if c == 34 || c == 92 || c < 32 { return e; }
    e = e + 1;
  }
  return e;
}

fn hexv(c: i64) -> i64
  ensures -1 <= result && result <= 15
{
  if 48 <= c && c <= 57 { return c - 48; }
  if 97 <= c && c <= 102 { return c - 87; }
  if 65 <= c && c <= 70 { return c - 55; }
  return -1;
}

// the four hex digits b[i..i+4) as a code unit, or -1
fn hex4(b: [u8], i: i64) -> i64
  requires 0 <= i && i + 4 <= len(b)
  ensures -1 <= result && result <= 65535
{
  let a: i64 = hexv(b[i]);
  let c: i64 = hexv(b[i + 1]);
  let d: i64 = hexv(b[i + 2]);
  let e: i64 = hexv(b[i + 3]);
  if a < 0 || c < 0 || d < 0 || e < 0 { return -1; }
  return a * 4096 + c * 256 + d * 16 + e;
}

// p is just after an opening quote: e = the closing quote, or -1 (control byte, bad escape, unterminated). The whole line was
// checked for UTF-8 once, so non-ASCII bytes run through (hand string() checks them per sequence).
fn sstr(b: [u8], p: i64) -> Val
  requires 0 <= p && p <= len(b)
  ensures result.e == -1 || (p <= result.e && result.e < len(b))
{
  let mut q: i64 = p;
  let mut plain: i64 = 1;
  while q < len(b)
    invariant p <= q && q <= len(b)
    decreases len(b) - q
  {
    let e: i64 = stop(b, q);
    if e >= len(b) { return bad(); }
    let c: i64 = b[e];
    if c == 34 { return Val { s: p, e: e, k: 4, p: plain }; }
    if c != 92 || e + 1 >= len(b) { return bad(); }
    let x: i64 = b[e + 1];
    plain = 0;
    if x == 117 {
      if e + 6 > len(b) { return bad(); }
      if hex4(b, e + 2) < 0 { return bad(); }
      q = e + 6;
    } else {
      if x != 34 && x != 92 && x != 47 && x != 98 && x != 102 && x != 110 && x != 114 && x != 116 { return bad(); }
      q = e + 2;
    }
  }
  return bad();
}

fn digits(b: [u8], p: i64) -> i64
  requires 0 <= p && p <= len(b)
  ensures p <= result && result <= len(b)
{
  let mut q: i64 = p;
  while q < len(b)
    invariant p <= q && q <= len(b)
    decreases len(b) - q
  {
    let c: i64 = b[q];
    if c < 48 || c > 57 { return q; }
    q = q + 1;
  }
  return q;
}

// JSON number at p (same grammar as lex::scan_number), end or -1.
fn num_end(b: [u8], p: i64) -> i64
  requires 0 <= p && p <= len(b)
  ensures result == -1 || (p < result && result <= len(b))
{
  let mut i: i64 = p;
  if i >= len(b) { return -1; }
  if b[i] == 45 { i = i + 1; }
  if i >= len(b) { return -1; }
  let c: i64 = b[i];
  if c < 48 || c > 57 { return -1; }
  i = i + 1;
  if c == 48 {
    if i < len(b) {
      let d: i64 = b[i];
      if d >= 48 && d <= 57 { return -1; }
    }
  } else { i = digits(b, i); }
  if i < len(b) {
    if b[i] == 46 {
      i = i + 1;
      if i >= len(b) { return -1; }
      let d: i64 = b[i];
      if d < 48 || d > 57 { return -1; }
      i = digits(b, i + 1);
    }
  }
  if i < len(b) {
    let e: i64 = b[i];
    if e == 101 || e == 69 {
      i = i + 1;
      if i >= len(b) { return -1; }
      let s: i64 = b[i];
      if s == 43 || s == 45 { i = i + 1; }
      if i >= len(b) { return -1; }
      let d: i64 = b[i];
      if d < 48 || d > 57 { return -1; }
      i = digits(b, i + 1);
    }
  }
  return i;
}

// b[lo..hi) equals lit byte for byte.
fn bytes_are(b: [u8], lo: i64, hi: i64, lit: str) -> bool
  requires 0 <= lo && lo <= hi && hi <= len(b)
{
  if hi - lo != len(lit) { return false; }
  let mut k: i64 = 0;
  while k < len(lit)
    invariant 0 <= k && k <= len(lit) && len(lit) == hi - lo && 0 <= lo && hi <= len(b)
    decreases len(lit) - k
  {
    let x: i64 = b[lo + k];
    let y: i64 = lit[k];
    if x != y { return false; }
    k = k + 1;
  }
  return true;
}

// Literal lit at p: its end, or -1.
fn lit_end(b: [u8], p: i64, lit: str) -> i64
  requires 0 <= p && p <= len(b) && len(lit) >= 1
  ensures result == -1 || (p < result && result <= len(b))
{
  if len(lit) > len(b) - p { return -1; }
  if !bytes_are(b, p, p + len(lit), lit) { return -1; }
  return p + len(lit);
}

// Tracks (hand member()): 0 none, 1 root, 2 params, 3 update, 4 content, 6 result, 7 agentCapabilities.
// Slot of the plain key b[lo..hi) under track: 1 id, 2 method, 3 params, 4 error, 5 result, 6 update, 7 content, 8 text,
// 9 agentCapabilities, 10 loadSession, 0 none.
fn key_slot(b: [u8], lo: i64, hi: i64, track: i64) -> i64 ! alloc
  requires 0 <= lo && lo <= hi && hi <= len(b)
{
  if track == 1 {
    if bytes_are(b, lo, hi, "id") { return 1; }
    if bytes_are(b, lo, hi, "method") { return 2; }
    if bytes_are(b, lo, hi, "params") { return 3; }
    if bytes_are(b, lo, hi, "error") { return 4; }
    if bytes_are(b, lo, hi, "result") { return 5; }
    return 0;
  }
  if track == 2 && bytes_are(b, lo, hi, "update") { return 6; }
  if track == 3 && bytes_are(b, lo, hi, "content") { return 7; }
  if track == 4 && bytes_are(b, lo, hi, "text") { return 8; }
  if track == 6 && bytes_are(b, lo, hi, "agentCapabilities") { return 9; }
  if track == 7 && bytes_are(b, lo, hi, "loadSession") { return 10; }
  return 0;
}

// Any JSON value after optional whitespace at p, nested at most d more containers (hand value(): 128 open containers), counting
// records like the tape (one per value and per key, at most 1048576). Tracked members fill c.
fn value(b: [u8], p: i64, d: i64, track: i64, inout c: Cap) -> Val ! alloc
  requires 0 <= p && p <= len(b) && 0 <= d
  ensures result.e == -1 || (p <= result.s && result.s < result.e && result.e <= len(b))
  decreases d
{
  let q0: i64 = ws(b, p);
  if q0 >= len(b) { return bad(); }
  if c.rec < 0 || c.rec >= 1048576 { return bad(); }
  c.rec = c.rec + 1;
  let ch: i64 = b[q0];
  if ch == 34 {
    let s: Val = sstr(b, q0 + 1);
    if s.e < 0 { return bad(); }
    return Val { s: q0, e: s.e + 1, k: 4, p: s.p };
  }
  if ch == 110 { let e0: i64 = lit_end(b, q0, "null"); if e0 < 0 { return bad(); } return Val { s: q0, e: e0, k: 0, p: 1 }; }
  if ch == 116 { let e1: i64 = lit_end(b, q0, "true"); if e1 < 0 { return bad(); } return Val { s: q0, e: e1, k: 1, p: 1 }; }
  if ch == 102 { let e2: i64 = lit_end(b, q0, "false"); if e2 < 0 { return bad(); } return Val { s: q0, e: e2, k: 1, p: 1 }; }
  if ch != 123 && ch != 91 {
    let e3: i64 = num_end(b, q0);
    if e3 < 0 { return bad(); }
    return Val { s: q0, e: e3, k: 3, p: 1 };
  }
  if d == 0 { return bad(); }
  let obj: bool = ch == 123;
  let mut kind: i64 = 5;
  let mut close: i64 = 93;
  if obj { close = 125; kind = 6; }
  let mut q: i64 = ws(b, q0 + 1);
  if q < len(b) {
    if b[q] == close { return Val { s: q0, e: q + 1, k: kind, p: 1 }; }
  }
  while q < len(b)
    invariant q0 < q && q <= len(b) && 1 <= d && p <= q0
    decreases len(b) - q
  {
    let mut slot: i64 = 0;
    let mut sub: i64 = 0;
    if obj {
      if b[q] != 34 { return bad(); }
      if c.rec < 0 || c.rec >= 1048576 { return bad(); }
      c.rec = c.rec + 1;
      let k: Val = sstr(b, q + 1);
      if k.e < 0 { return bad(); }
      if track != 0 {
        if k.p == 0 { c.fb = 1; }
        else {
          slot = key_slot(b, q + 1, k.e, track);
          // hand member(): a tracked key resets what it owns before its value is read
          if slot == 3 { sub = 2; c.x_k = -1; }
          if slot == 6 { sub = 3; c.x_k = -1; }
          if slot == 7 { sub = 4; c.x_k = -1; }
          if slot == 5 { sub = 6; c.caps = -1; c.ls = 0; }
          if slot == 9 { sub = 7; c.ls = 0; }
        }
      }
      q = ws(b, k.e + 1);
      if q >= len(b) { return bad(); }
      if b[q] != 58 { return bad(); }
      q = q + 1;
    }
    let v: Val = value(b, q, d - 1, sub, inout c);
    if v.e < 0 { return bad(); }
    if slot == 1 { c.id_s = v.s; c.id_e = v.e; c.id_k = v.k; }
    if slot == 2 { c.m_s = v.s + 1; c.m_e = v.e - 1; c.m_k = v.k; c.m_p = v.p; }
    if slot == 4 { c.err = v.k; }
    if slot == 5 { c.res = v.k; }
    if slot == 8 { c.x_s = v.s + 1; c.x_e = v.e - 1; c.x_k = v.k; c.x_p = v.p; }
    if slot == 9 { c.caps = v.k; }
    if slot == 10 { c.ls = 0; if v.k == 1 && b[v.s] == 116 { c.ls = 1; } }
    q = ws(b, v.e);
    if q >= len(b) { return bad(); }
    let t: i64 = b[q];
    if t == close { return Val { s: q0, e: q + 1, k: kind, p: 1 }; }
    if t != 44 { return bad(); }
    q = ws(b, q + 1);
  }
  return bad();
}

fn valid(b: [u8]) -> bool { return utf8_valid(b); }

// Scan line[0..n) trimmed (P1: invalid UTF-8 is a parse failure): 0 parse failure (parse_line would fail), 1 scanned into c,
// 2 the tape path decides this line (fb). c.lo/c.hi are the trimmed bounds in line; the other spans are relative to c.lo.
pub fn scan(line: [u8], n: i64, inout c: Cap) -> i64 ! alloc
  requires 0 <= n && n <= len(line)
  ensures result == 1 ==> (0 <= c.lo && c.lo <= c.hi && c.hi <= len(line))
{
  c.root = -1; c.id_s = 0; c.id_e = 0; c.id_k = -1; c.m_s = 0; c.m_e = 0; c.m_k = -1; c.m_p = 1;
  c.x_s = 0; c.x_e = 0; c.x_k = -1; c.x_p = 1; c.err = -1; c.res = -1; c.caps = -1; c.ls = 0; c.rec = 0; c.fb = 0;
  let tb: Bounds = trim_bounds(subview(line, 0, n));
  c.lo = tb.lo;
  c.hi = tb.hi;
  let tn: i64 = tb.hi - tb.lo;
  if tn == 0 || tn > 16777216 { return 0; }
  if !valid(subview(line, tb.lo, tb.hi)) { return 0; }
  let v: Val = value(subview(line, tb.lo, tb.hi), 0, 128, 1, inout c);
  if v.e < 0 { return 0; }
  if v.e != tn { if ws(subview(line, tb.lo, tb.hi), v.e) != tn { return 0; } }
  c.lo = tb.lo;
  c.hi = tb.hi;
  c.root = v.k;
  if c.fb != 0 { return 2; }
  return 1;
}

// kind_of on a scanned line (same answers): 1 server request, 2 the response to `id`, 0 anything else.
pub fn line_kind(line: [u8], c: Cap, id: i64) -> i64
  requires 1 <= id && id <= 99
{
  if c.root != 6 { return 0; }
  if c.id_k != -1 && c.m_k == 4 { return 1; }
  if c.id_k == 3 && 0 <= c.lo && c.lo <= len(line) && 0 <= c.id_s && c.id_s <= c.id_e && c.id_e <= len(line) {
    if c.lo + c.id_e <= len(line) {
      if id_is(subview(line, c.lo + c.id_s, c.lo + c.id_e), id) { return 2; }
    }
  }
  return 0;
}

fn put_lit(inout o: [u8], at: i64, lit: str) -> i64
  requires 0 <= at && at + len(lit) <= len(o)
  ensures len(o) == len(old(o)) && result == at + len(lit)
{
  let mut k: i64 = 0;
  while k < len(lit)
    invariant 0 <= k && k <= len(lit) && at + len(lit) <= len(o) && len(o) == len(old(o)) && 0 <= at
    decreases len(lit) - k
  {
    let x: i64 = lit[k];
    o[at + k] = x;
    k = k + 1;
  }
  return at + len(lit);
}

// not_handled on a scanned server request: one exact-size allocation, the raw id token copied from the line once.
pub fn not_handled_line(line: [u8], c: Cap) -> [u8] ! alloc
{
  let head: str = "{\"jsonrpc\":\"2.0\",\"id\":";
  let tail: str = ",\"error\":{\"code\":-32601,\"message\":\"not handled\"}}\n";
  if c.lo < 0 || c.lo > len(line) || c.id_s < 0 || c.id_s > c.id_e || c.id_e > len(line) { let z0: [u8] = alloc(0, 0); return z0; }
  let s: i64 = c.lo + c.id_s;
  let e: i64 = c.lo + c.id_e;
  if e > len(line) || e - s > 20000000 { let z: [u8] = alloc(0, 0); return z; }
  let mut o: [u8] = alloc(len(head) + (e - s) + len(tail), 0);
  let a: i64 = put_lit(inout o, 0, head);
  copy_range(inout o, a, line, s, e - s);
  let f: i64 = put_lit(inout o, a + (e - s), tail);
  return o;
}

// a decoded span: positions in line when the string had no escape (inbuf 0, borrowed), else buf[0..e) (inbuf 1)
pub struct Span { s: i64, e: i64, inbuf: i64 }

fn put_cp(inout o: [u8], at: i64, cp: i64) -> i64
  requires 0 <= at && at + 4 <= len(o) && 0 <= cp && cp <= 1114111
  ensures len(o) == len(old(o)) && at + 1 <= result && result <= at + 4
{
  if cp < 128 { o[at] = cp; return at + 1; }
  if cp < 2048 { o[at] = 192 + cp / 64; o[at + 1] = 128 + cp % 64; return at + 2; }
  if cp < 65536 { o[at] = 224 + cp / 4096; o[at + 1] = 128 + (cp / 64) % 64; o[at + 2] = 128 + cp % 64; return at + 3; }
  o[at] = 240 + cp / 262144; o[at + 1] = 128 + (cp / 4096) % 64; o[at + 2] = 128 + (cp / 64) % 64; o[at + 3] = 128 + cp % 64;
  return at + 4;
}

// decode the scanned string body b[s..e) into buf[0..), the hand unescape(): simple escapes, \u units, a surrogate pair
// combined, a lone surrogate as U+FFFD. Each escape writes no more bytes than it reads, so buf needs only e - s bytes.
fn dec(b: [u8], s: i64, e: i64, inout buf: [u8]) -> i64
  requires 0 <= s && s <= e && e <= len(b) && e - s <= len(buf)
  ensures len(buf) == len(old(buf)) && 0 <= result && result <= len(buf)
{
  let mut o: i64 = 0;
  let mut q: i64 = s;
  while q < e
    invariant s <= q && q <= e && 0 <= o && o <= q - s && len(buf) == len(old(buf)) && e - s <= len(buf) && e <= len(b)
    decreases e - q
  {
    let c: i64 = b[q];
    if c != 92 { buf[o] = c; o = o + 1; q = q + 1; }
    else {
      if q + 1 >= e { return o; }
      let x: i64 = b[q + 1];
      if x == 117 {
        if q + 6 > e { return o; }
        let mut cp: i64 = hex4(b, q + 2);
        if cp < 0 { return o; }
        let mut n: i64 = 6;
        if cp >= 55296 && cp < 56320 {
          let mut lo: i64 = -1;
          if q + 12 <= e { if b[q + 6] == 92 && b[q + 7] == 117 { lo = hex4(b, q + 8); } }
          if lo >= 56320 && lo < 57344 { cp = 65536 + (cp - 55296) * 1024 + (lo - 56320); n = 12; } else { cp = 65533; }
        } else if cp >= 56320 && cp < 57344 { cp = 65533; }
        o = put_cp(inout buf, o, cp);
        q = q + n;
      } else {
        let mut y: i64 = x;
        if x == 98 { y = 8; }
        if x == 102 { y = 12; }
        if x == 110 { y = 10; }
        if x == 114 { y = 13; }
        if x == 116 { y = 9; }
        buf[o] = y;
        o = o + 1;
        q = q + 2;
      }
    }
  }
  return o;
}

// hand text_of(): the method (which 0) or params.update.content.text (which 1) of a scanned line, borrowed when plain, decoded
// into the reused scratch buf otherwise (grown in place, never shrunk). A missing or non-string member is the empty span.
pub fn text_span(line: [u8], c: Cap, which: i64, inout buf: [u8]) -> Span ! alloc
  ensures result.inbuf == 0 ==> (0 <= result.s && result.s <= result.e && result.e <= len(line))
  ensures result.inbuf == 1 ==> (0 <= result.e && result.e <= len(buf))
{
  let mut s: i64 = c.m_s;
  let mut e: i64 = c.m_e;
  let mut k: i64 = c.m_k;
  let mut p: i64 = c.m_p;
  if which == 1 { s = c.x_s; e = c.x_e; k = c.x_k; p = c.x_p; }
  if k != 4 || c.lo < 0 || c.lo > len(line) || s < 0 || s > e || e > len(line) { return Span { s: 0, e: 0, inbuf: 0 }; }
  if c.lo + e > len(line) { return Span { s: 0, e: 0, inbuf: 0 }; }
  if p == 1 { return Span { s: c.lo + s, e: c.lo + e, inbuf: 0 }; }
  if len(buf) < e - s { buf = resize(buf, e - s, 0); }
  if len(buf) < e - s { return Span { s: 0, e: 0, inbuf: 0 }; }
  let n: i64 = dec(line, c.lo + s, c.lo + e, inout buf);
  return Span { s: 0, e: n, inbuf: 1 };
}

// What pump/drain do with line[0..n) waiting for `id`: 0 ignore (a parse failure too), 1 server request, 2 the response to
// `id` with no object error, 3 run the old tape path on this line (fb, or a response carrying an object error).
fn fast_kind(line: [u8], n: i64, id: i64, inout c: Cap) -> i64 ! alloc
  requires 0 <= n && n <= len(line) && 1 <= id && id <= 99
{
  let r: i64 = scan(line, n, inout c);
  if r == 0 { return 0; }
  if r == 2 { return 3; }
  let k: i64 = line_kind(line, c, id);
  if k == 2 && c.err == 6 { return 3; }
  return k;
}

// ---- process start ----

// child arguments: agent --no-leader stdio, exactly
fn child_args() -> ProcessArgs ! alloc
{
  let mut a: ProcessArgs = proc_args_new();
  a = proc_args_push(move a, "agent");
  a = proc_args_push(move a, "--no-leader");
  a = proc_args_push(move a, "stdio");
  return move a;
}

// Spawn the child with GROK_HOME=home (inherit the parent environment, then set the pair) in cwd=folder and register it with one
// overall timer. On failure ctl[0] is set and the returned loop is only to be closed.
pub fn start(binary: str, home: str, folder: str, timeout_ms: i64, inout ctl: [i64]) -> Loop ! async, net, proc, alloc
  requires len(ctl) == 16
  ensures len(ctl) == 16 && ctl[6] == 0
{
  ctl[0] = 0; ctl[1] = 24; ctl[2] = -1; ctl[3] = -1; ctl[4] = 0; ctl[5] = 0; ctl[6] = 0; ctl[7] = 0; ctl[8] = 0; ctl[9] = 0;
  let args: ProcessArgs = child_args();
  let mut names: ProcessArgs = proc_args_new();
  names = proc_args_push(move names, "GROK_HOME");
  let mut values: ProcessArgs = proc_args_new();
  values = proc_args_push(move values, home);
  let child: Process = proc_spawn_env(binary, args, folder, names, values);
  if !proc_ok(child) {
    let r: Result<i64> = proc_wait(move child);
    ctl[0] = 7;
    let l1: Loop = ev_new(3);
    return move l1;
  }
  let mut l: Loop = ev_new(3);
  if !ev_ok(l) || ev_count(l) >= ev_cap(l) {
    let k: Result<i64> = proc_kill(move child);
    ctl[0] = 6;
    return move l;
  }
  l = ev_add_process(move l, move child);
  ctl[2] = ev_last(l);
  if !ev_ok(l) || ev_count(l) >= ev_cap(l) { ctl[0] = 6; return move l; }
  let mut ms: i64 = timeout_ms;
  if ms <= 0 { ms = 20000; }
  if ms > 86400000 { ms = 86400000; }
  ctl[10] = ms;
  l = ev_add_timer(move l, ms);
  ctl[3] = ev_last(l);
  if !ev_ok(l) || ev_count(l) >= ev_cap(l) { ctl[0] = 6; return move l; }
  return move l;
}

// trim the line, parse it as JSON (P1: invalid UTF-8 is a parse failure and the line is skipped)
pub fn parse_line(line: [u8], n: i64) -> crate::json::JsonParse ! alloc
  requires 0 <= n && n <= len(line)
  ensures is_variant(result, crate::json::JsonParse::Parsed) ==> crate::json::doc_local(variant_field(result, crate::json::JsonParse::Parsed, document))
{
  // DB56 (G-DB55-5): trim to bounds on the line itself, then copy only the trimmed bytes once and give them up.
  let tb: Bounds = trim_bounds(subview(line, 0, n));
  let tn: i64 = tb.hi - tb.lo;
  let mut b: [u8] = alloc(tn, 0);
  copy_range(inout b, 0, line, tb.lo, tn);
  return crate::lines::parse_owned(move b, tn);
}

// One receive step of the pump (same contract as the Codex rpc::step with a 16-word ctl). ctl[5] = 1 when a line of ctl[6] bytes is
// in `line`, 0 when nothing usable arrived; a closed child, a timeout or a transport failure sets ctl[0].
pub fn step(take l: Loop, slot: i64, overall: i64, inout ctl: [i64], inout st: [i64], inout line: [u8], inout chunk: [u8], inout tl: crate::tail::Tail) -> Loop ! async, proc, alloc
  requires len(ctl) == 16
  requires len(st) == 5 && 0 <= st[1] && st[1] <= 8388608 && 0 <= st[2] && st[2] <= st[4] && 0 <= st[4] && st[4] <= 65536 && len(chunk) == 65536
  requires 1 <= len(line) && len(line) <= 8388608 && st[1] <= len(line)
  requires crate::tail::tail_ok(tl) && tl.limit == 1024
  ensures len(ctl) == 16 && 0 <= ctl[6] && ctl[6] <= 8388608
  ensures len(st) == 5 && 0 <= st[1] && st[1] <= 8388608 && 0 <= st[2] && st[2] <= st[4] && 0 <= st[4] && st[4] <= 65536 && len(chunk) == 65536
  ensures 1 <= len(line) && len(line) <= 8388608 && st[1] <= len(line) && ctl[6] <= len(line)
  ensures crate::tail::tail_ok(tl) && tl.limit == 1024
{
  let mut q: Loop = crate::transport::receive_grow(move l, slot, overall, -1, true, 8388608, inout st, inout line, inout chunk, inout tl);
  let n: i64 = st[0];
  ctl[5] = 0;
  ctl[6] = 0;
  if n < 0 && n != -6 {
    ctl[0] = 6;
    if n == -1 { ctl[0] = 5; }
    if n == -4 { ctl[7] = st[3]; }
  } else if n >= 0 && n <= len(line) {
    ctl[5] = 1;
    ctl[6] = n;
  }
  return move q;
}

// What a parsed line is to a caller waiting for request `id`: 1 a server request (a string `method` with any id, null included:
// answer it with not_handled), 2 the response to `id` (numeric id whose token is exactly the decimal id), 0 anything to ignore.
pub fn kind_of(d: crate::json::JsonDocument, id: i64) -> i64 ! alloc
  requires 1 <= id && id <= 99
{
  if crate::access::kind(d, 0) != 6 { return 0; }
  let mid: i64 = field(d, 0, "id");
  let method: i64 = field(d, 0, "method");
  if mid >= 0 && crate::access::kind(d, method) == 4 { return 1; }
  if mid >= 0 {
    let number: crate::access::Number = crate::access::number(d, mid);
    if number.status == 0 && id_is(crate::util::raw(d, mid), id) { return 2; }
  }
  return 0;
}

// the -32601 "not handled" reply to a server request: same raw id token, jsonrpc 2.0, LF. Empty only on an absurd id token.
pub fn not_handled(d: crate::json::JsonDocument) -> [u8] ! alloc
{
  let idr: [u8] = crate::util::raw(d, field(d, 0, "id"));
  if len(idr) > 20000000 { let e: [u8] = alloc(0, 0); return e; }
  let head: [u8] = crate::packet::cat_bytes(crate::util::to_bytes("{\"jsonrpc\":\"2.0\",\"id\":"), idr);
  return crate::packet::cat_bytes(head, crate::util::to_bytes(",\"error\":{\"code\":-32601,\"message\":\"not handled\"}}\n"));
}

// ---- requests ----

pub fn req_init() -> [u8] ! alloc
{
  return crate::util::to_bytes("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":1,\"clientCapabilities\":{\"fs\":{\"readTextFile\":false,\"writeTextFile\":false},\"terminal\":false},\"clientInfo\":{\"name\":\"lair\",\"title\":\"Lair\",\"version\":\"0.1.0\"}}}\n");
}

pub fn req_load(thread: str, folder: str) -> [u8] ! alloc
  requires len(thread) <= 1000000 && len(folder) <= 1000000
{
  let a: [u8] = crate::util::to_bytes("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"session/load\",\"params\":{\"sessionId\":\"");
  let b: [u8] = crate::packet::cat_bytes(a, crate::util::escaped(thread));
  let c: [u8] = crate::packet::cat_bytes(b, crate::util::to_bytes("\",\"cwd\":\""));
  let d: [u8] = crate::packet::cat_bytes(c, crate::util::escaped(folder));
  return crate::packet::cat_bytes(d, crate::util::to_bytes("\",\"mcpServers\":[]}}\n"));
}

// ---- response handling ----

// diagnostic detail: the message (cut to 300 units) with non-ASCII units shown as '?', "rejected" when it has none
pub fn error_detail(d: crate::json::JsonDocument, e: i64) -> [u8] ! alloc
  ensures len(result) <= 300
{
  let u: crate::access::Units = crate::access::string_units(d, field(d, e, "message"));
  if u.status != 0 { return crate::util::to_bytes("rejected"); }
  let mut m: i64 = len(u.units);
  if m > 300 { m = 300; }
  let mut out: [u8] = alloc(m, 0);
  let mut i: i64 = 0;
  while i < m
    invariant 0 <= i && i <= m && m <= len(u.units) && m <= 300 && len(out) == m
    decreases m - i
  {
    let x: i64 = u.units[i];
    if x >= 32 && x < 127 { out[i] = x; } else { out[i] = 63; }
    i = i + 1;
  }
  return out;
}

// the response to request `id` arrived (d is its document): an object error rejects (ctl[0] = 3, detail and raw code into aux);
// otherwise the initialize response must carry an object agentCapabilities whose loadSession is exactly true (else ctl[0] = 4).
fn on_reply(d: crate::json::JsonDocument, id: i64, inout ctl: [i64], inout aux: [u8]) -> () ! alloc
  requires len(ctl) == 16 && 512 <= len(aux) && len(aux) <= 8389120 && 1 <= id && id <= 2
  ensures len(ctl) == 16 && 512 <= len(aux) && len(aux) <= 8389120 && ctl[6] == old(ctl)[6]
{
  let error: i64 = field(d, 0, "error");
  if crate::access::kind(d, error) == 6 {
    ctl[0] = 3;
    let m: [u8] = error_detail(d, error);
    let mut i: i64 = 0;
    while i < len(m)
      invariant 0 <= i && i <= len(m) && len(m) <= 300 && 512 <= len(aux) && len(aux) <= 8389120 && len(ctl) == 16
      decreases len(m) - i
    { let c: i64 = m[i]; aux[i] = c; i = i + 1; }
    ctl[9] = len(m);
    let code: i64 = field(d, error, "code");
    if code >= 0 {
      let rj: [u8] = crate::util::json_value(d, code);
      if len(rj) == 0 || len(rj) > 8388608 {
        ctl[0] = 2;
      } else {
        let mut k: i64 = 0;
        while k < len(rj)
          invariant 0 <= k && k <= len(rj) && len(rj) <= 8388608 && 512 + k <= len(aux) && len(aux) <= 8389120 && len(ctl) == 16
          decreases len(rj) - k
        {
          if 512 + k == len(aux) { aux = crate::transport::grow_line(move aux, 8389120); }
          let c2: i64 = rj[k];
          aux[512 + k] = c2;
          k = k + 1;
        }
        ctl[8] = len(rj);
      }
    }
  } else if id == 1 {
    let res: i64 = field(d, 0, "result");
    let caps: i64 = field(d, res, "agentCapabilities");
    let mut ok: bool = false;
    if crate::access::kind(d, res) == 6 && crate::access::kind(d, caps) == 6 {
      if crate::access::boolean(d, field(d, caps, "loadSession")) == 1 { ok = true; }  // MUT:M16 => if crate::access::kind(d, field(d, caps, "loadSession")) > 0 { ok = true; }
    }
    if !ok { ctl[0] = 4; }
  }
}

// Pump until the response to request `id` arrives (at most 1000000 events, then read-failed). The first failure wins. A server
// request in between is answered with not_handled. On return ctl[0] == 0 means the response arrived and was accepted.
// Writes go through transport::send with the overall budget ctl[10]. Spec P11 is resolved: a failed stdin write half-closes stdin
// and the reader keeps reading stdout (as TS does); the slot is not failed.

fn pump(take l: Loop, slot: i64, overall: i64, id: i64, inout ctl: [i64], inout st: [i64], inout line: [u8], inout chunk: [u8], inout tl: crate::tail::Tail, inout aux: [u8]) -> Loop ! async, proc, alloc
  requires len(ctl) == 16 && 0 <= ctl[6] && ctl[6] <= 8388608 && 1 <= id && id <= 2 && 512 <= len(aux) && len(aux) <= 8389120
  requires len(st) == 5 && 0 <= st[1] && st[1] <= 8388608 && 0 <= st[2] && st[2] <= st[4] && 0 <= st[4] && st[4] <= 65536 && len(chunk) == 65536
  requires 1 <= len(line) && len(line) <= 8388608 && st[1] <= len(line)
  requires crate::tail::tail_ok(tl) && tl.limit == 1024
  ensures len(ctl) == 16 && 0 <= ctl[6] && ctl[6] <= 8388608 && 512 <= len(aux) && len(aux) <= 8389120
  ensures len(st) == 5 && 0 <= st[1] && st[1] <= 8388608 && 0 <= st[2] && st[2] <= st[4] && 0 <= st[4] && st[4] <= 65536 && len(chunk) == 65536
  ensures 1 <= len(line) && len(line) <= 8388608 && st[1] <= len(line)
  ensures crate::tail::tail_ok(tl) && tl.limit == 1024
{
  let mut q: Loop = move l;
  let mut c: Cap = cap_new();
  let mut done: bool = false;
  let mut events: i64 = 0;
  while ctl[0] == 0 && !done && events < 1000000
    invariant 0 <= events && events <= 1000000 && len(ctl) == 16 && 0 <= ctl[6] && ctl[6] <= 8388608 && 512 <= len(aux) && len(aux) <= 8389120
    invariant len(st) == 5 && 0 <= st[1] && st[1] <= 8388608 && 0 <= st[2] && st[2] <= st[4] && 0 <= st[4] && st[4] <= 65536 && len(chunk) == 65536
    invariant 1 <= len(line) && len(line) <= 8388608 && st[1] <= len(line) && 1 <= id && id <= 2
    invariant crate::tail::tail_ok(tl) && tl.limit == 1024
    decreases 1000000 - events
  {
    events = events + 1;
    q = step(move q, slot, overall, inout ctl, inout st, inout line, inout chunk, inout tl);
    if ctl[0] == 0 && ctl[5] == 1 {
      // DB65: the span scan decides the line in place; the tape path only for fast_kind 3
      let fk: i64 = fast_kind(line, ctl[6], id, inout c);
      if fk == 1 { q = crate::transport::send(move q, slot, not_handled_line(line, c), ctl[10]); }
      if fk == 2 {
        done = true;
        if id == 1 && !(c.res == 6 && c.caps == 6 && c.ls == 1) { ctl[0] = 4; }
      }
      if fk == 3 {
        let parsed: crate::json::JsonParse = parse_line(line, ctl[6]);
        match parsed {
          crate::json::JsonParse::Failed(e) => { }
          crate::json::JsonParse::Parsed(d) => {
            let k: i64 = kind_of(d, id);
            if k == 1 { q = crate::transport::send(move q, slot, not_handled(d), ctl[10]); }
            if k == 2 {
              done = true;
              on_reply(d, id, inout ctl, inout aux);
            }
          }
        }
      }
    }
  }
  if ctl[0] == 0 && !done { ctl[0] = 6; }
  return move q;
}

// After a response settled a request: the remaining complete lines of the current chunk are processed with nothing outstanding
// (server requests answered, everything else ignored) before the next request is written. Each step eats at least one chunk byte.
fn drain(take l: Loop, slot: i64, overall: i64, inout ctl: [i64], inout st: [i64], inout line: [u8], inout chunk: [u8], inout tl: crate::tail::Tail) -> Loop ! async, proc, alloc
  requires len(ctl) == 16 && 0 <= ctl[6] && ctl[6] <= 8388608
  requires len(st) == 5 && 0 <= st[1] && st[1] <= 8388608 && 0 <= st[2] && st[2] <= st[4] && 0 <= st[4] && st[4] <= 65536 && len(chunk) == 65536
  requires 1 <= len(line) && len(line) <= 8388608 && st[1] <= len(line)
  requires crate::tail::tail_ok(tl) && tl.limit == 1024
  ensures len(ctl) == 16 && 0 <= ctl[6] && ctl[6] <= 8388608
  ensures len(st) == 5 && 0 <= st[1] && st[1] <= 8388608 && 0 <= st[2] && st[2] <= st[4] && 0 <= st[4] && st[4] <= 65536 && len(chunk) == 65536
  ensures 1 <= len(line) && len(line) <= 8388608 && st[1] <= len(line)
  ensures crate::tail::tail_ok(tl) && tl.limit == 1024
{
  let mut q: Loop = move l;
  let mut c: Cap = cap_new();
  let mut n: i64 = 0;
  while ctl[0] == 0 && st[2] < st[4] && n < 70000
    invariant 0 <= n && n <= 70000 && len(ctl) == 16 && 0 <= ctl[6] && ctl[6] <= 8388608
    invariant len(st) == 5 && 0 <= st[1] && st[1] <= 8388608 && 0 <= st[2] && st[2] <= st[4] && 0 <= st[4] && st[4] <= 65536 && len(chunk) == 65536
    invariant 1 <= len(line) && len(line) <= 8388608 && st[1] <= len(line)
    invariant crate::tail::tail_ok(tl) && tl.limit == 1024
    decreases 70000 - n
  {
    n = n + 1;
    q = step(move q, slot, overall, inout ctl, inout st, inout line, inout chunk, inout tl);
    if ctl[0] == 0 && ctl[5] == 1 {
      // an id of 99 is never outstanding: only server requests (kind 1) matter here
      let fk: i64 = fast_kind(line, ctl[6], 99, inout c);
      if fk == 1 { q = crate::transport::send(move q, slot, not_handled_line(line, c), ctl[10]); }
      if fk == 3 {
        let parsed: crate::json::JsonParse = parse_line(line, ctl[6]);
        match parsed {
          crate::json::JsonParse::Failed(e) => { }
          crate::json::JsonParse::Parsed(d) => {
            if kind_of(d, 99) == 1 { q = crate::transport::send(move q, slot, not_handled(d), ctl[10]); }
          }
        }
      }
    }
  }
  return move q;
}

// ---- result ----

// the failure as a mode 3 result packet (see NOTE 8)
fn failure(code: i64, stage: i64, aux: [u8], rl: i64, dl: i64) -> [i64] ! alloc
  requires 512 <= len(aux) && len(aux) <= 8389120 && 0 <= rl && rl <= len(aux) - 512 && 0 <= dl && dl <= 300
  ensures len(result) >= 28
{
  let none: [u8] = alloc(0, 0);
  if code == 3 {
    let mut raw: [u8] = alloc(rl, 0);
    let mut i: i64 = 0;
    while i < rl
      invariant 0 <= i && i <= rl && len(raw) == rl && rl <= len(aux) - 512
      decreases rl - i
    { let c: i64 = aux[512 + i]; raw[i] = c; i = i + 1; }
    let mut dt: [u8] = alloc(dl, 0);
    let mut j: i64 = 0;
    while j < dl
      invariant 0 <= j && j <= dl && len(dt) == dl && dl <= 300 && 512 <= len(aux) && len(aux) <= 8389120
      decreases dl - j
    { let c2: i64 = aux[j]; dt[j] = c2; j = j + 1; }
    let detail: str = crate::jstr::owned_text(move dt);
    return crate::packet::error_mode(3, stage, 3, 0, 0, 0, raw, "RpcResponseError", detail);
  }
  if code == 7 { return crate::packet::error_mode(3, 24, 1, 8, 0, 0, none, "EngineImportError", ""); }
  if code == 6 { return crate::packet::error_mode(3, stage, 1, 7, 0, 0, none, "EngineImportError", ""); }
  if code == 5 { return crate::packet::error_mode(3, stage, 1, 6, 0, 0, none, "EngineImportError", ""); }
  if code == 4 { return crate::packet::error_mode(3, 25, 1, 5, 0, 0, none, "EngineImportError", ""); }
  return crate::packet::error_mode(3, 30, 6, 2, 0, 0, none, "", "");
}

// The ACP load check of the copy in `home`: spawn `binary agent --no-leader stdio` (cwd folder, GROK_HOME=home), initialize (id 1),
// require loadSession === true, then session/load (id 2); any successful reply (missing or null result included) passes.
// Returns a RESULT packet (mode 3): status 0 on success, status 1 with the stage 24..26 error otherwise. The loop and the child are
// closed on every path (transport::close consumes the Loop; a failed spawn is consumed by proc_wait).
pub fn load_check(binary: str, home: str, folder: str, thread: str, timeout_ms: i64) -> [i64] ! async, net, proc, alloc
  requires len(binary) <= 1000000 && len(home) <= 1000000 && len(folder) <= 1000000 && len(thread) <= 1000000
  requires 0 <= timeout_ms && timeout_ms <= 2147483647
  ensures len(result) >= 28
{
  let mut ctl: [i64] = alloc(16, 0);
  let mut l: Loop = start(binary, home, folder, timeout_ms, inout ctl);
  let slot: i64 = ctl[2];
  let overall: i64 = ctl[3];
  let mut st: [i64] = alloc(5, 0);
  let mut line: [u8] = alloc(4096, 0);
  let mut chunk: [u8] = alloc(65536, 0);
  let mut tl: crate::tail::Tail = crate::tail::new(1024);
  let mut aux: [u8] = alloc(512, 0);
  if ctl[0] == 0 {
    ctl[1] = 25;
    ctl[4] = 1;
    if crate::transport::stdin_closed(l, slot) {
      l = crate::transport::expired(move l, overall, inout st);
      if st[0] == -1 { ctl[0] = 5; } else { ctl[0] = 6; }
    }
    l = crate::transport::send(move l, slot, req_init(), ctl[10]);
    l = pump(move l, slot, overall, 1, inout ctl, inout st, inout line, inout chunk, inout tl, inout aux);
  }
  if ctl[0] == 0 {
    l = drain(move l, slot, overall, inout ctl, inout st, inout line, inout chunk, inout tl);
  }
  if ctl[0] == 0 {
    ctl[1] = 26;
    ctl[4] = 2;
    if crate::transport::stdin_closed(l, slot) {
      l = crate::transport::expired(move l, overall, inout st);
      if st[0] == -1 { ctl[0] = 5; } else { ctl[0] = 6; }
    }
    l = crate::transport::send(move l, slot, req_load(thread, folder), ctl[10]);
    l = pump(move l, slot, overall, 2, inout ctl, inout st, inout line, inout chunk, inout tl, inout aux);
  }
  // A settling response (0 ok, 2/3 error object, 4 bad capabilities) leaves the rest of its chunk: the reference's data handler still
  // answers server requests in it before the child is closed. The outcome is already settled, so a failed write there only half-closes stdin and is ignored.
  let settled: i64 = ctl[0];
  if settled == 0 || settled == 2 || settled == 3 || settled == 4 {
    ctl[0] = 0;
    l = drain(move l, slot, overall, inout ctl, inout st, inout line, inout chunk, inout tl);
    ctl[0] = settled;
  }
  let code: i64 = ctl[0];
  let stage: i64 = ctl[1];
  let mut rl: i64 = ctl[8];
  let mut dl: i64 = ctl[9];
  if rl < 0 || rl > len(aux) - 512 { rl = 0; }
  if dl < 0 || dl > 300 { dl = 0; }
  crate::transport::close(move l, slot);
  if code != 0 { return failure(code, stage, aux, rl, dl); }
  let meta: [i64] = crate::packet::meta_new(3);
  let er: [i64] = alloc(0, 0);
  let et: [u8] = alloc(0, 0);
  return crate::packet::result(meta, er, et);
}
