// Grok ACP load check (grokLoadCheck on withRpcChild, jsonrpc true) on the G10 event loop (same transport as bench/l3/codex/rpc.pruv).
//
// Reset 4.3 (bench/l3/grok/RESHAPE.md): the whole module is in the hand_rpc.rs shape. No JSON tape: every line goes through one span
// scan (scan/value), the state is the typed struct Check (no word packets); only load_check's result packet (host boundary) stays.
//
// NOTES  (spec P11 is resolved: a failed stdin write half-closes stdin and stdout is still read, as TS does)
//  1. Local helpers: grok util.pruv has no `id_is` or `trim`, so this file has private copies (`id_is`, `trim_bounds`).
//  2. The RpcResponseError detail (300 units) and the compact error.code JSON live in Check (detail, raw); a code over 8388608 bytes
//     is an internal invariant.
//  3. Kinds -1 absent, 0 null, 1 bool, 3 number, 4 string, 5 array, 6 object. "loadSession === true" is the literal `true` as the
//     value of loadSession in an object agentCapabilities of an object result (Cap.ls 1).
//  4. A non-object `error` (string, number, ...) does NOT reject (TS: record(error) is undefined => resolve(result)); the line is
//     then a normal response whose result is `result` (missing/null allowed for session/load, not enough for initialize).
//  5. `timeout_ms == 0` means the host default 20000 (IMPL_NOTES leaves the meaning of 0 to load_check). Capped at 86400000 like Codex.
//  6. Drain: after the initialize reply settles, the remaining COMPLETE lines of the same chunk (st.at < st.end) are processed with an
//     empty outstanding set (server requests get -32601, everything else is ignored) BEFORE request 2 is written (P6 chunk ordering).
//     The pump calls transport::receive via `step`, which scans the buffered bytes before it polls (hand `Rpc::step`);
//     the drain calls transport::scan, the buffered bytes only (hand `step(false)`).
//  7. proc_spawn_env_quiet(binary, args, cwd, names, values): the arguments are not `move`d, as in tests/runtime/g10p_r24_env_quiet.pruv.
//     Like the hand (`Command::env(..).stderr(Stdio::null())`), stderr is the null device, so stream 2 is never read
//     (SPEC R-6l-4, L-gaps 16 row 4.4za-EQ).
//  8. Result mapping (all mode 3, class 1 = EngineImportError, class 3 = RpcResponseError):
//       spawn failure: stage 24 code 8 (engine-missing); loop capacity failure: stage 24 code 7;
//       read-failed (EOF, exit, transport failure, 1000000 pump events, oversize line): stage 25 or 26 code 7;
//       timeout: stage 25/26 code 6; capability missing/false/non-true: stage 25 code 5 (grok-load-failed);
//       error response: stage 25/26 class 3 code 0 with raw error.code JSON (absent if no code), name RpcResponseError,
//       detail = message cut to 300 units with non-ASCII as '?' or "rejected";   internal: stage 30 class 6 code 2.
//  9. The `args` package is not used (the argv is the fixed three words agent --no-leader stdio).

// ---- private helpers ----

// P6: a response id matches only when its JSON token is exactly the decimal text of the request id.
fn id_is(b: [u8], id: i64) -> bool
  requires 1 <= id && id <= 99
{
  if id < 10 {
    if len(b) != 1 { return false; }
    let c: i64 = b[0];
    return c == 48 + id;
  }
  if len(b) != 2 { return false; }
  let c0: i64 = b[0];
  let c1: i64 = b[1];
  return c0 == 48 + id / 10 && c1 == 48 + id % 10;
}

// ECMAScript trim whitespace, encoded as UTF-8 (same table as the Codex util).
fn space(b: [u8], i: i64) -> i64
  requires 0 <= i && i < len(b)
  ensures 0 <= result && result <= 3 && result <= len(b) - i
{
  let c: i64 = b[i];
  if c == 32 || (9 <= c && c <= 13) { return 1; }
  if c < 194 { return 0; }
  if i + 1 < len(b) && c == 194 && b[i + 1] == 160 { return 2; }
  if i + 2 < len(b) {
    if c == 225 && b[i + 1] == 154 && b[i + 2] == 128 { return 3; }
    if c == 226 && b[i + 1] == 128 && ((128 <= b[i + 2] && b[i + 2] <= 138) || b[i + 2] == 168 || b[i + 2] == 169 || b[i + 2] == 175) { return 3; }
    if c == 226 && b[i + 1] == 129 && b[i + 2] == 159 { return 3; }
    if c == 227 && b[i + 1] == 128 && b[i + 2] == 128 { return 3; }
    if c == 239 && b[i + 1] == 187 && b[i + 2] == 191 { return 3; }
  }
  return 0;
}

// DB56 (G-DB55-5): the bounds the old trim_bytes copied out, without the copy: b[lo..hi) is b without leading and trailing
// whitespace (the same `space` steps), lo == hi when b is all whitespace.
pub struct Bounds { lo: i64, hi: i64 }
pub fn trim_bounds(b: [u8]) -> Bounds
  ensures 0 <= result.lo && result.lo <= result.hi && result.hi <= len(b)
{
  let mut lo: i64 = 0;
  let mut k: i64 = 1;
  while lo < len(b) && k > 0
    invariant 0 <= lo && lo <= len(b) && k >= 0
    decreases len(b) - lo + k
  {
    k = space(b, lo);
    lo = lo + k;
  }
  if lo >= len(b) { return Bounds { lo: len(b), hi: len(b) }; }
  // DB65 (hand trim_bounds): an ASCII non-space last byte is never part of a multi-byte space step, so the walk would end at len(b)
  let last: i64 = b[len(b) - 1];
  if last < 128 && last != 32 && (last < 9 || last > 13) { return Bounds { lo: lo, hi: len(b) }; }
  let mut hi: i64 = 0;
  let mut i: i64 = lo;
  while i < len(b)
    invariant 0 <= lo && lo <= i && 0 <= hi && hi <= i && i <= len(b)
    decreases len(b) - i
  {
    let n: i64 = space(b, i);
    if n > 0 { i = i + n; }
    else { i = i + 1; hi = i; }
  }
  if hi < lo { hi = lo; }
  return Bounds { lo: lo, hi: hi };
}

// ---- DB65 line path in the hand_rpc.rs shape (bench/l3/grok/RESHAPE_LINE.md) ----
// One pass over the trimmed line view t = line[lo..hi) (a borrowed subview, nothing copied) records the spans the loop needs, the
// way hand_rpc.rs line()/member() does. Spans are positions in t. Kinds are the access kinds (-1 absent, 0 null, 1 bool, 3 number,
// 4 string, 5 array, 6 object). Duplicate keys: the last one wins (access::field), so a tracked key resets what it owns.
// Escaped keys are compared decoded (key_is, as access::field compares decoded keys); an object `error` records its message and code
// spans (hand member() T_ERROR), so no line goes back to a JSON tape.
pub struct Cap {
  id_s: i64, id_e: i64, id_k: i64,
  m_s: i64, m_e: i64, m_k: i64, m_p: i64,
  x_s: i64, x_e: i64, x_k: i64, x_p: i64,
  e_s: i64, e_e: i64, e_k: i64, e_p: i64,
  c_s: i64, c_e: i64, c_k: i64,
  err: i64, res: i64, caps: i64, ls: i64
}

// a scanned value: start s (first byte), end e (one past, -1 on a parse failure), kind k, p = 1 when a string has no escape
struct Val { s: i64, e: i64, k: i64, p: i64 }

pub fn cap_new() -> Cap
{
  return Cap { id_s: 0, id_e: 0, id_k: -1, m_s: 0, m_e: 0, m_k: -1, m_p: 1, x_s: 0, x_e: 0, x_k: -1, x_p: 1,
               e_s: 0, e_e: 0, e_k: -1, e_p: 1, c_s: 0, c_e: 0, c_k: -1, err: -1, res: -1, caps: -1, ls: 0 };
}

fn bad() -> Val
  ensures result.e == -1
{ return Val { s: 0, e: -1, k: -1, p: 1 }; }

// JSON whitespace run from p.
fn ws(b: [u8], p: i64) -> i64
  requires 0 <= p && p <= len(b)
  ensures p <= result && result <= len(b)
{
  let mut q: i64 = p;
  while q < len(b)
    invariant p <= q && q <= len(b)
    decreases len(b) - q
  {
    let c: i64 = b[q];
    if c != 32 && c != 10 && c != 13 && c != 9 { return q; }
    q = q + 1;
  }
  return q;
}

// First `"`, `\`, control or non-ASCII byte at or after q, or len(b) (hand string() inner loop).
fn stop(b: [u8], q: i64) -> i64
  requires 0 <= q && q <= len(b)
  ensures q <= result && result <= len(b)
{
  let mut e: i64 = q;
  while e < len(b)
    invariant q <= e && e <= len(b)
    decreases len(b) - e
  {
    let c: i64 = b[e];
    if c == 34 || c == 92 || c < 32 || c >= 128 { return e; }
    e = e + 1;
  }
  return e;
}

fn hexv(c: i64) -> i64
  ensures -1 <= result && result <= 15
{
  if 48 <= c && c <= 57 { return c - 48; }
  if 97 <= c && c <= 102 { return c - 87; }
  if 65 <= c && c <= 70 { return c - 55; }
  return -1;
}

// the four hex digits b[i..i+4) as a code unit, or -1
fn hex4(b: [u8], i: i64) -> i64
  requires 0 <= i && i + 4 <= len(b)
  ensures -1 <= result && result <= 65535
{
  let a: i64 = hexv(b[i]);
  let c: i64 = hexv(b[i + 1]);
  let d: i64 = hexv(b[i + 2]);
  let e: i64 = hexv(b[i + 3]);
  if a < 0 || c < 0 || d < 0 || e < 0 { return -1; }
  return a * 4096 + c * 256 + d * 16 + e;
}

// Width of a valid UTF-8 sequence whose lead byte (>= 128) is at i, 0 if invalid (hand utf8_width, the parse::utf8_width rules).
fn utf8_width(b: [u8], i: i64) -> i64
  requires 0 <= i && i < len(b)
  ensures result == 0 || (2 <= result && result <= 4 && i + result <= len(b))
{
  let c: i64 = b[i];
  let mut n: i64 = 0;
  if c >= 194 && c <= 223 { n = 2; }
  else if c >= 224 && c <= 239 { n = 3; }
  else if c >= 240 && c <= 244 { n = 4; }
  else { return 0; }
  if len(b) - i < n { return 0; }
  let c1: i64 = b[i + 1];
  if c1 < 128 || c1 > 191 || (c == 224 && c1 < 160) || (c == 237 && c1 >= 160) || (c == 240 && c1 < 144) || (c == 244 && c1 > 143) { return 0; }
  let mut j: i64 = 2;
  while j < n
    invariant 2 <= j && j <= n && n <= 4 && i + n <= len(b)
    decreases n - j
  {
    let x: i64 = b[i + j];
    if x < 128 || x > 191 { return 0; }
    j = j + 1;
  }
  return n;
}

// p is just after an opening quote: e = the closing quote, or -1 (control byte, bad escape, bad UTF-8, unterminated). Non-ASCII
// bytes are checked per sequence (hand string()), so no whole-line UTF-8 pass is needed: outside strings a byte >= 128 fails anyway.
fn sstr(b: [u8], p: i64) -> Val
  requires 0 <= p && p <= len(b)
  ensures result.e == -1 || (p <= result.e && result.e < len(b))
{
  let mut q: i64 = p;
  let mut plain: i64 = 1;
  while q < len(b)
    invariant p <= q && q <= len(b)
    decreases len(b) - q
  {
    let e: i64 = stop(b, q);
    if e >= len(b) { return bad(); }
    let c: i64 = b[e];
    if c == 34 { return Val { s: p, e: e, k: 4, p: plain }; }
    if c >= 128 {
      let w: i64 = utf8_width(b, e);
      if w == 0 { return bad(); }
      q = e + w;
    } else {
      if c != 92 || e + 1 >= len(b) { return bad(); }
      let x: i64 = b[e + 1];
      plain = 0;
      if x == 117 {
        if e + 6 > len(b) { return bad(); }
        if hexv(b[e + 2]) < 0 || hexv(b[e + 3]) < 0 || hexv(b[e + 4]) < 0 || hexv(b[e + 5]) < 0 { return bad(); }
        q = e + 6;
      } else {
        if x != 34 && x != 92 && x != 47 && x != 98 && x != 102 && x != 110 && x != 114 && x != 116 { return bad(); }
        q = e + 2;
      }
    }
  }
  return bad();
}

fn digits(b: [u8], p: i64) -> i64
  requires 0 <= p && p <= len(b)
  ensures p <= result && result <= len(b)
{
  let mut q: i64 = p;
  while q < len(b)
    invariant p <= q && q <= len(b)
    decreases len(b) - q
  {
    let c: i64 = b[q];
    if c < 48 || c > 57 { return q; }
    q = q + 1;
  }
  return q;
}

// JSON number at p (same grammar as lex::scan_number), end or -1.
fn num_end(b: [u8], p: i64) -> i64
  requires 0 <= p && p <= len(b)
  ensures result == -1 || (p < result && result <= len(b))
{
  let mut i: i64 = p;
  if i >= len(b) { return -1; }
  if b[i] == 45 { i = i + 1; }
  if i >= len(b) { return -1; }
  let c: i64 = b[i];
  if c < 48 || c > 57 { return -1; }
  i = i + 1;
  if c == 48 {
    if i < len(b) {
      let d: i64 = b[i];
      if d >= 48 && d <= 57 { return -1; }
    }
  } else { i = digits(b, i); }
  if i < len(b) {
    if b[i] == 46 {
      i = i + 1;
      if i >= len(b) { return -1; }
      let d: i64 = b[i];
      if d < 48 || d > 57 { return -1; }
      i = digits(b, i + 1);
    }
  }
  if i < len(b) {
    let e: i64 = b[i];
    if e == 101 || e == 69 {
      i = i + 1;
      if i >= len(b) { return -1; }
      let s: i64 = b[i];
      if s == 43 || s == 45 { i = i + 1; }
      if i >= len(b) { return -1; }
      let d: i64 = b[i];
      if d < 48 || d > 57 { return -1; }
      i = digits(b, i + 1);
    }
  }
  return i;
}

// b[lo..hi) equals lit byte for byte.
fn bytes_are(b: [u8], lo: i64, hi: i64, lit: str) -> bool
  requires 0 <= lo && lo <= hi && hi <= len(b)
{
  if hi - lo != len(lit) { return false; }
  let mut k: i64 = 0;
  while k < len(lit)
    invariant 0 <= k && k <= len(lit) && len(lit) == hi - lo && 0 <= lo && hi <= len(b)
    decreases len(lit) - k
  {
    let x: i64 = b[lo + k];
    let y: i64 = lit[k];
    if x != y { return false; }
    k = k + 1;
  }
  return true;
}

// Literal lit at p: its end, or -1.
fn lit_end(b: [u8], p: i64, lit: str) -> i64
  requires 0 <= p && p <= len(b) && len(lit) >= 1
  ensures result == -1 || (p < result && result <= len(b))
{
  if len(lit) > len(b) - p { return -1; }
  if !bytes_are(b, p, p + len(lit), lit) { return -1; }
  return p + len(lit);
}

// The key body b[lo..hi) (plain: no escape) equals the ASCII literal lit after JSON unescaping (access::field compares decoded keys;
// hand key_is). A \u escape is one code unit; a surrogate never equals an ASCII byte.
fn key_is(b: [u8], lo: i64, hi: i64, plain: i64, lit: str) -> bool
  requires 0 <= lo && lo <= hi && hi <= len(b)
{
  if plain == 1 { return bytes_are(b, lo, hi, lit); }
  let mut q: i64 = lo;
  let mut k: i64 = 0;
  while q < hi
    invariant lo <= q && q <= hi && hi <= len(b) && 0 <= k && k <= len(lit)
    decreases hi - q
  {
    if k >= len(lit) { return false; }
    let c: i64 = b[q];
    let mut u: i64 = c;
    let mut n: i64 = 1;
    if c == 92 {
      if q + 1 >= hi { return false; }
      let x: i64 = b[q + 1];
      n = 2;
      u = x;
      if x == 117 {
        if q + 6 > hi { return false; }
        u = hex4(b, q + 2);
        n = 6;
      }
      if x == 98 { u = 8; }
      if x == 102 { u = 12; }
      if x == 110 { u = 10; }
      if x == 114 { u = 13; }
      if x == 116 { u = 9; }
    }
    let y: i64 = lit[k];
    if u != y { return false; }
    k = k + 1;
    q = q + n;
  }
  return k == len(lit);
}

// Tracks (hand member()): 0 none, 1 root, 2 params, 3 update, 4 content, 5 error, 6 result, 7 agentCapabilities.
// Slot of the key b[lo..hi) under track: 1 id, 2 method, 3 params, 4 error, 5 result, 6 update, 7 content, 8 text,
// 9 agentCapabilities, 10 loadSession, 11 message, 12 code, 0 none.
fn key_slot(b: [u8], lo: i64, hi: i64, plain: i64, track: i64) -> i64
  requires 0 <= lo && lo <= hi && hi <= len(b)
{
  if track == 1 {
    if key_is(b, lo, hi, plain, "id") { return 1; }
    if key_is(b, lo, hi, plain, "method") { return 2; }
    if key_is(b, lo, hi, plain, "params") { return 3; }
    if key_is(b, lo, hi, plain, "error") { return 4; }
    if key_is(b, lo, hi, plain, "result") { return 5; }
    return 0;
  }
  if track == 2 && key_is(b, lo, hi, plain, "update") { return 6; }
  if track == 3 && key_is(b, lo, hi, plain, "content") { return 7; }
  if track == 4 && key_is(b, lo, hi, plain, "text") { return 8; }
  if track == 5 {
    if key_is(b, lo, hi, plain, "message") { return 11; }
    if key_is(b, lo, hi, plain, "code") { return 12; }
    return 0;
  }
  if track == 6 && key_is(b, lo, hi, plain, "agentCapabilities") { return 9; }
  if track == 7 && key_is(b, lo, hi, plain, "loadSession") { return 10; }
  return 0;
}

// Any JSON value after optional whitespace at p (hand value()), inside at most d more containers (128 open containers in all),
// counting records like the tape (one per value and per key, at most 1048576, in rec). Objects and arrays are scanned by their own
// loops (hand object()/array()); tracked object members fill c.
fn value(b: [u8], p: i64, d: i64, track: i64, inout rec: i64, inout c: Cap) -> Val ! alloc
  requires 0 <= p && p <= len(b) && 0 <= d
  ensures result.e == -1 || (p <= result.s && result.s < result.e && result.e <= len(b))
  decreases 2 * d + 1
{
  let q0: i64 = ws(b, p);
  if q0 >= len(b) || rec < 0 || rec >= 1048576 { return bad(); }
  rec = rec + 1;
  let ch: i64 = b[q0];
  if ch == 34 {
    let s: Val = sstr(b, q0 + 1);
    if s.e < 0 { return bad(); }
    return Val { s: q0, e: s.e + 1, k: 4, p: s.p };
  } else if ch == 123 {
    if d == 0 { return bad(); }
    let eo: i64 = object(b, q0 + 1, d - 1, track, inout rec, inout c);
    if eo < 0 { return bad(); }
    return Val { s: q0, e: eo, k: 6, p: 1 };
  } else if ch == 91 {
    if d == 0 { return bad(); }
    let ea: i64 = array(b, q0 + 1, d - 1, inout rec, inout c);
    if ea < 0 { return bad(); }
    return Val { s: q0, e: ea, k: 5, p: 1 };
  } else if ch == 116 {
    let e1: i64 = lit_end(b, q0, "true");
    if e1 < 0 { return bad(); }
    return Val { s: q0, e: e1, k: 1, p: 1 };
  } else if ch == 102 {
    let e2: i64 = lit_end(b, q0, "false");
    if e2 < 0 { return bad(); }
    return Val { s: q0, e: e2, k: 1, p: 1 };
  } else if ch == 110 {
    let e0: i64 = lit_end(b, q0, "null");
    if e0 < 0 { return bad(); }
    return Val { s: q0, e: e0, k: 0, p: 1 };
  }
  let e3: i64 = num_end(b, q0);
  if e3 < 0 { return bad(); }
  return Val { s: q0, e: e3, k: 3, p: 1 };
}

// p is just after '[' (hand array()): the end just after ']', or -1. Elements are untracked.
fn array(b: [u8], p: i64, d: i64, inout rec: i64, inout c: Cap) -> i64 ! alloc
  requires 0 <= p && p <= len(b) && 0 <= d
  ensures result == -1 || (p < result && result <= len(b))
  decreases 2 * d + 2
{
  let mut q: i64 = ws(b, p);
  if q < len(b) {
    if b[q] == 93 { return q + 1; }
  }
  while q < len(b)
    invariant p <= q && q <= len(b) && 0 <= d
    decreases len(b) - q
  {
    let v: Val = value(b, q, d, 0, inout rec, inout c);
    if v.e < 0 { return -1; }
    q = ws(b, v.e);
    if q >= len(b) { return -1; }
    let t: i64 = b[q];
    if t == 93 { return q + 1; }
    if t != 44 { return -1; }
    q = q + 1;
  }
  return -1;
}

// p is just after '{' (hand object()): the end just after '}', or -1. Under a track, a tracked key resets what it owns before its
// value is read (hand member()) and the value then fills its slot.
fn object(b: [u8], p: i64, d: i64, track: i64, inout rec: i64, inout c: Cap) -> i64 ! alloc
  requires 0 <= p && p <= len(b) && 0 <= d
  ensures result == -1 || (p < result && result <= len(b))
  decreases 2 * d + 2
{
  let mut q: i64 = ws(b, p);
  if q < len(b) {
    if b[q] == 125 { return q + 1; }
  }
  while q < len(b)
    invariant p <= q && q <= len(b) && 0 <= d
    decreases len(b) - q
  {
    if b[q] != 34 || rec < 0 || rec >= 1048576 { return -1; }
    rec = rec + 1;
    let k: Val = sstr(b, q + 1);
    if k.e < 0 { return -1; }
    let ks: i64 = q + 1;
    q = ws(b, k.e + 1);
    if q >= len(b) { return -1; }
    if b[q] != 58 { return -1; }
    let mut slot: i64 = 0;
    let mut sub: i64 = 0;
    if track != 0 {
      slot = key_slot(b, ks, k.e, k.p, track);
      if slot == 3 { sub = 2; c.x_k = -1; }
      else if slot == 6 { sub = 3; c.x_k = -1; }
      else if slot == 7 { sub = 4; c.x_k = -1; }
      else if slot == 4 { sub = 5; c.e_k = -1; c.c_k = -1; }
      else if slot == 5 { sub = 6; c.caps = -1; c.ls = 0; }
      else if slot == 9 { sub = 7; c.ls = 0; }
    }
    let v: Val = value(b, q + 1, d, sub, inout rec, inout c);
    if v.e < 0 { return -1; }
    if slot == 1 { c.id_s = v.s; c.id_e = v.e; c.id_k = v.k; }
    else if slot == 2 { c.m_s = v.s + 1; c.m_e = v.e - 1; c.m_k = v.k; c.m_p = v.p; }
    else if slot == 4 { c.err = v.k; }
    else if slot == 5 { c.res = v.k; }
    else if slot == 8 { c.x_s = v.s + 1; c.x_e = v.e - 1; c.x_k = v.k; c.x_p = v.p; }
    else if slot == 9 { c.caps = v.k; }
    else if slot == 10 { c.ls = 2; if v.k == 1 && b[v.s] == 116 { c.ls = 1; } }
    else if slot == 11 { c.e_s = v.s + 1; c.e_e = v.e - 1; c.e_k = v.k; c.e_p = v.p; }
    else if slot == 12 { c.c_s = v.s; c.c_e = v.e; c.c_k = v.k; }
    q = ws(b, v.e);
    if q >= len(b) { return -1; }
    let t: i64 = b[q];
    if t == 125 { return q + 1; }
    if t != 44 { return -1; }
    q = ws(b, q + 1);
  }
  return -1;
}

// hand scan(): one validating scan of the trimmed line t into c. The captures start empty and stay empty unless the root is an
// object (only an object root has tracked members), so the kind tests need no separate root kind. Spans are positions in t.
pub fn scan(t: [u8], inout c: Cap) -> bool ! alloc
{
  c.id_s = 0; c.id_e = 0; c.id_k = -1; c.m_s = 0; c.m_e = 0; c.m_k = -1; c.m_p = 1;
  c.x_s = 0; c.x_e = 0; c.x_k = -1; c.x_p = 1; c.e_s = 0; c.e_e = 0; c.e_k = -1; c.e_p = 1; c.c_s = 0; c.c_e = 0; c.c_k = -1;
  c.err = -1; c.res = -1; c.caps = -1; c.ls = 0;
  let mut rec: i64 = 0;
  let v: Val = value(t, 0, 128, 1, inout rec, inout c);
  if v.e < 0 { return false; }
  return ws(t, v.e) == len(t);
}

// kind_of on a scanned line t (same answers): 1 server request, 2 the response to `id`, 0 anything else.
pub fn line_kind(t: [u8], c: Cap, id: i64) -> i64
  requires 1 <= id && id <= 99
{
  if c.id_k != -1 && c.m_k == 4 { return 1; }
  if id != 99 && c.id_k == 3 && 0 <= c.id_s && c.id_s <= c.id_e && c.id_e <= len(t) {
    if id_is(subview(t, c.id_s, c.id_e), id) { return 2; }
  }
  return 0;
}

// not_handled on a scanned server request t (hand NH_HEAD, id, NH_TAIL): one exact-size reservation, three appends, the raw id
// token copied from the line once.
pub fn not_handled_line(t: [u8], c: Cap) -> [u8] ! alloc
{
  let head: str = "{\"jsonrpc\":\"2.0\",\"id\":";
  let tail: str = ",\"error\":{\"code\":-32601,\"message\":\"not handled\"}}\n";
  let s: i64 = c.id_s;
  let e: i64 = c.id_e;
  if s < 0 || s > e || e > len(t) || e - s > 20000000 { let z: [u8] = alloc(0, 0); return z; }
  let mut o: [u8] = alloc(0, 0);
  arr_reserve(inout o, len(head) + (e - s) + len(tail));
  arr_append(inout o, head, 0, len(head));
  arr_append(inout o, t, s, e - s);
  arr_append(inout o, tail, 0, len(tail));
  return o;
}

// cp as UTF-8 appended to o (hand char::encode_utf8 + extend_from_slice)
fn push_cp(inout o: [u8], cp: i64) -> () ! alloc
  requires 0 <= cp && cp <= 1114111 && len(o) <= 100000000
  ensures len(old(o)) + 1 <= len(o) && len(o) <= len(old(o)) + 4
{
  if cp < 128 { arr_push(inout o, cp); }
  else if cp < 2048 { arr_push(inout o, 192 + cp / 64, 128 + cp % 64); }
  else if cp < 65536 { arr_push(inout o, 224 + cp / 4096, 128 + (cp / 64) % 64, 128 + cp % 64); }
  else { arr_push(inout o, 240 + cp / 262144, 128 + (cp / 4096) % 64, 128 + (cp / 64) % 64, 128 + cp % 64); }
}

// hand unescape(): the scanned string body b[s..e) decoded and appended to out: each plain run up to the next backslash (find_byte)
// appended at once, simple escapes, \u units, a surrogate pair combined, a lone surrogate as U+FFFD. Each escape appends no more
// bytes than it reads.
fn dec(b: [u8], s: i64, e: i64, inout out: [u8]) -> () ! alloc
  requires 0 <= s && s <= e && e <= len(b) && len(out) + (e - s) <= 100000000
  ensures len(old(out)) <= len(out) && len(out) <= len(old(out)) + (e - s)
{
  let o0: i64 = len(out);
  let mut i: i64 = s;
  while i < e
    invariant s <= i && i <= e && e <= len(b) && o0 <= len(out) && len(out) <= o0 + (i - s) && o0 + (e - s) <= 100000000
    decreases e - i
  {
    let j: i64 = find_byte(b, 92, i, e);
    arr_append(inout out, b, i, j - i);
    i = j;
    if i < e {
      if i + 1 >= e { return; }
      let x: i64 = b[i + 1];
      if x == 117 {
        if i + 6 > e { return; }
        let u: i64 = hex4(b, i + 2);
        if u < 0 { return; }
        i = i + 6;
        let mut cp: i64 = u;
        if u >= 55296 && u < 56320 {
          cp = 65533;
          if i + 6 <= e {
            if b[i] == 92 && b[i + 1] == 117 {
              let lo: i64 = hex4(b, i + 2);
              if lo >= 56320 && lo < 57344 { cp = 65536 + (u - 55296) * 1024 + (lo - 56320); i = i + 6; }
            }
          }
        } else if u >= 56320 && u < 57344 { cp = 65533; }
        push_cp(inout out, cp);
      } else {
        let mut y: i64 = x;
        if x == 98 { y = 8; }
        else if x == 102 { y = 12; }
        else if x == 110 { y = 10; }
        else if x == 114 { y = 13; }
        else if x == 116 { y = 9; }
        arr_push(inout out, y);
        i = i + 2;
      }
    }
  }
}

// hand text_of(): the method (which 0) or params.update.content.text (which 1) of the scanned line t, borrowed from t when plain,
// else decoded into the reused scratch buf (cleared, never shrunk). A missing or non-string member is empty.
pub fn text_of(t: [u8], c: Cap, which: i64, inout buf: [u8]) -> ref [u8] from(t, buf) ! alloc
  requires len(t) <= 16777216
{
  let mut s: i64 = c.m_s;
  let mut e: i64 = c.m_e;
  let mut k: i64 = c.m_k;
  let mut p: i64 = c.m_p;
  if which == 1 { s = c.x_s; e = c.x_e; k = c.x_k; p = c.x_p; }
  if k != 4 || s < 0 || s > e || e > len(t) { return subview(t, 0, 0); }
  if p == 1 { return subview(t, s, e); }
  buf = truncate(buf, 0);
  dec(t, s, e, inout buf);
  return subview(buf, 0, len(buf));
}

// hand detail(): the error message folded from its source span t[e_s..e_e) into out (cleared first): the first 300 UTF-16 units,
// 32..126 as themselves, every other unit '?', "rejected" when the message is missing or not a string. A \u escape is one unit (a
// surrogate pair two, as the decoded string has), a 2 or 3 byte UTF-8 sequence one, a 4 byte one two; none of those is printable ASCII.
pub fn detail(t: [u8], c: Cap, inout out: [u8]) -> () ! alloc
  ensures len(out) <= 300
{
  out = truncate(out, 0);
  if c.e_k != 4 || c.e_s < 0 || c.e_s > c.e_e || c.e_e > len(t) {
    arr_append(inout out, "rejected", 0, 8);
    return;
  }
  let e: i64 = c.e_e;
  let mut i: i64 = c.e_s;
  while i < e && len(out) < 300
    invariant 0 <= i && e <= len(t) && len(out) <= 300
    decreases e - i
  {
    let x: i64 = t[i];
    let mut u: i64 = x;
    let mut n: i64 = 1;
    let mut two: bool = false;
    if x == 92 && i + 1 < e {
      let y: i64 = t[i + 1];
      n = 2;
      u = y;
      if y == 117 && i + 6 <= e { u = hex4(t, i + 2); n = 6; }
      if y == 98 || y == 102 || y == 110 || y == 114 || y == 116 { u = 8; }
    } else if x >= 128 {
      u = 128;
      n = 2;
      if x >= 224 { n = 3; }
      if x >= 240 { n = 4; two = true; }
    }
    if u >= 32 && u <= 126 { arr_push(inout out, u); } else { arr_push(inout out, 63); }
    if two && len(out) < 300 { arr_push(inout out, 63); }
    i = i + n;
  }
}

fn hexd(d: i64) -> i64
  requires 0 <= d && d <= 15
  ensures 48 <= result && result <= 102
{
  if d < 10 { return 48 + d; }
  return 87 + d;
}

// util::json_value of the scanned value t[s..e) without a tape (hand compact()), into out (cleared first): whitespace dropped,
// numbers, literals and keys (their raw escaped spelling with quotes) copied, string values decoded (dec: lone surrogate U+FFFD) and
// re-escaped like util::escaped (quote, backslash, C0 as \u00xx). A plain string value is its own re-escaping. buf is the reused scratch.
pub fn compact(t: [u8], s: i64, e: i64, inout out: [u8], inout buf: [u8]) -> () ! alloc
  requires 0 <= s && s <= e && e <= len(t) && e - s <= 16777216
  ensures len(out) <= 6 * (e - s)
{
  out = truncate(out, 0);
  let mut q: i64 = s;
  while q < e
    invariant s <= q && q <= e && e <= len(t) && len(out) <= 6 * (q - s)
    decreases e - q
  {
    let x: i64 = t[q];
    if x == 34 {
      // the closing quote: the first '"' not escaped by a backslash (the scan already validated the string)
      let mut r: i64 = q + 1;
      let mut plain: bool = true;
      while r < e && t[r] != 34
        invariant q + 1 <= r && r <= e + 1 && e <= len(t)
        decreases e + 1 - r
      {
        if t[r] == 92 { plain = false; r = r + 1; }
        r = r + 1;
      }
      if r >= e { return; }
      let mut w: i64 = r + 1;
      while w < e && (t[w] == 32 || t[w] == 9 || t[w] == 10 || t[w] == 13)
        invariant r + 1 <= w && w <= e
        decreases e - w
      {
        w = w + 1;
      }
      let mut key: bool = false;
      if w < e { if t[w] == 58 { key = true; } }
      if key || plain {
        arr_append(inout out, t, q, r + 1 - q);
      } else {
        buf = truncate(buf, 0);
        dec(t, q + 1, r, inout buf);
        let n: i64 = len(buf);
        arr_push(inout out, 34);
        let mut j: i64 = 0;
        while j < n
          invariant 0 <= j && j <= n && n == len(buf) && n <= r - q - 1 && len(out) <= 6 * (q - s) + 1 + 6 * j
          decreases n - j
        {
          let y: i64 = buf[j];
          if y == 34 { arr_push(inout out, 92, 34); }
          else if y == 92 { arr_push(inout out, 92, 92); }
          else if y < 32 { arr_push(inout out, 92, 117, 48, 48, hexd(y / 16), hexd(y % 16)); }
          else { arr_push(inout out, y); }
          j = j + 1;
        }
        arr_push(inout out, 34);
      }
      q = r + 1;
    } else {
      if x != 32 && x != 9 && x != 10 && x != 13 { arr_push(inout out, x); }
      q = q + 1;
    }
  }
}

// What pump/drain do with the trimmed line t waiting for `id` (hand on_line): 0 ignore (an empty or oversized line, a parse
// failure), 1 server request, 2 the response to `id`.
fn fast_kind(t: [u8], id: i64, inout c: Cap) -> i64 ! alloc
  requires 1 <= id && id <= 99
{
  if len(t) == 0 || len(t) > 16777216 { return 0; }
  if !scan(t, inout c) { return 0; }
  return line_kind(t, c, id);
}

// ---- process start ----

// child arguments: agent --no-leader stdio, exactly
fn child_args() -> ProcessArgs ! alloc
{
  let mut a: ProcessArgs = proc_args_new();
  a = proc_args_push(move a, "agent");
  a = proc_args_push(move a, "--no-leader");
  a = proc_args_push(move a, "stdio");
  return move a;
}

// The load check state (hand_rpc.rs Check): one typed struct instead of the old 16-word ctl and the aux byte buffer.
// fail: 0 none, 2 internal, 3 rpc error response, 4 no loadSession, 5 timeout, 6 read-failed, 7 engine-missing.
// stage: 24 spawn, 25 initialize, 26 session/load. slot/timer: loop slots (-1 none). budget: overall ms (transport::send deadline).
// ready/n: step left a line of n bytes in `line`. detail/raw: the RpcResponseError parts.
pub struct Check { fail: i64, stage: i64, slot: i64, timer: i64, budget: i64, ready: bool, n: i64, detail: [u8], raw: [u8] }

// Spawn the child with GROK_HOME=home (inherit the parent environment, then set the pair) in cwd=folder and register it with one
// overall timer. On failure ck.fail is set and the returned loop is only to be closed.
fn start(binary: str, home: str, folder: str, timeout_ms: i64, inout ck: Check) -> Loop ! async, net, proc, alloc
  ensures ck.n == 0
{
  ck.n = 0;
  let args: ProcessArgs = child_args();
  let mut names: ProcessArgs = proc_args_new();
  names = proc_args_push(move names, "GROK_HOME");
  let mut values: ProcessArgs = proc_args_new();
  values = proc_args_push(move values, home);
  let child: Process = proc_spawn_env_quiet(binary, args, folder, names, values);
  if !proc_ok(child) {
    let r: Result<i64> = proc_wait(move child);
    ck.fail = 7;
    let l1: Loop = ev_new(3);
    return move l1;
  }
  let mut l: Loop = ev_new(3);
  if !ev_ok(l) || ev_count(l) >= ev_cap(l) {
    let k: Result<i64> = proc_kill(move child);
    ck.fail = 6;
    return move l;
  }
  l = ev_add_process(move l, move child);
  ck.slot = ev_last(l);
  if !ev_ok(l) || ev_count(l) >= ev_cap(l) { ck.fail = 6; return move l; }
  let mut ms: i64 = timeout_ms;
  if ms <= 0 { ms = 20000; }
  if ms > 86400000 { ms = 86400000; }
  ck.budget = ms;
  l = ev_add_timer(move l, ms);
  ck.timer = ev_last(l);
  if !ev_ok(l) || ev_count(l) >= ev_cap(l) { ck.fail = 6; return move l; }
  return move l;
}

// One receive step of the pump. ck.ready when a line of ck.n bytes is in `line`; a closed child, a timeout or a transport failure
// sets ck.fail.
fn step(take l: Loop, inout ck: Check, inout st: crate::transport::Reader, inout line: [u8], inout chunk: [u8]) -> Loop ! async, proc, alloc
  requires 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
  requires len(line) <= 8388608
  ensures 0 <= ck.n && ck.n <= len(line)
  ensures 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
  ensures len(line) <= 8388608
{
  let mut q: Loop = crate::transport::receive(move l, ck.slot, ck.timer, -1, true, 8388608, inout st, inout line, inout chunk);
  let n: i64 = st.status;
  ck.ready = false;
  ck.n = 0;
  if n < 0 && n != -6 {
    ck.fail = 6;
    if n == -1 { ck.fail = 5; }
  } else if n >= 0 && n <= len(line) {
    ck.ready = true;
    ck.n = n;
  }
  return move q;
}

// ---- requests ----

pub fn req_init() -> [u8] ! alloc
{
  return crate::util::to_bytes("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":1,\"clientCapabilities\":{\"fs\":{\"readTextFile\":false,\"writeTextFile\":false},\"terminal\":false},\"clientInfo\":{\"name\":\"lair\",\"title\":\"Lair\",\"version\":\"0.1.0\"}}}\n");
}

// util::escaped(s) appended to out (quote, backslash, C0 as \u00xx), no intermediate buffer
fn push_escaped(inout out: [u8], s: str) -> () ! alloc
  requires len(out) + 6 * len(s) <= 100000000
  ensures len(out) <= len(old(out)) + 6 * len(s)
{
  let mut i: i64 = 0;
  while i < len(s)
    invariant 0 <= i && i <= len(s) && len(out) <= len(old(out)) + 6 * i
    decreases len(s) - i
  {
    let c: i64 = s[i];
    if c == 34 { arr_push(inout out, 92, 34); }
    else if c == 92 { arr_push(inout out, 92, 92); }
    else if c < 32 { arr_push(inout out, 92, 117, 48, 48, hexd(c / 16), hexd(c % 16)); }
    else { arr_push(inout out, c); }
    i = i + 1;
  }
}

// session/load request: one buffer reserved for the worst case, the fixed parts appended, the two strings escaped into it
pub fn req_load(thread: str, folder: str) -> [u8] ! alloc
  requires len(thread) <= 1000000 && len(folder) <= 1000000
{
  let a: str = "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"session/load\",\"params\":{\"sessionId\":\"";
  let b: str = "\",\"cwd\":\"";
  let z: str = "\",\"mcpServers\":[]}}\n";
  let mut out: [u8] = alloc(0, 0);
  arr_reserve(inout out, len(a) + len(b) + len(z) + 6 * len(thread) + 6 * len(folder));
  arr_append(inout out, a, 0, len(a));
  push_escaped(inout out, thread);
  arr_append(inout out, b, 0, len(b));
  push_escaped(inout out, folder);
  arr_append(inout out, z, 0, len(z));
  return out;
}

// ---- response handling ----

// The response to the outstanding request arrived (scanned into c): an object error rejects (fail 3, detail and the compact
// error.code into ck); otherwise the initialize response must carry an object agentCapabilities whose loadSession is exactly true
// (else fail 4). c.ls: 0 absent, 1 the literal true, 2 anything else.
fn on_reply(t: [u8], c: Cap, id: i64, inout ck: Check, inout buf: [u8]) -> () ! alloc
  requires len(t) <= 8388608
{
  if c.err == 6 {
    ck.fail = 3;
    detail(t, c, inout ck.detail);
    if c.c_k != -1 && 0 <= c.c_s && c.c_s <= c.c_e && c.c_e <= len(t) {
      compact(t, c.c_s, c.c_e, inout ck.raw, inout buf);
      if len(ck.raw) == 0 || len(ck.raw) > 8388608 { ck.fail = 2; }
    }
  } else if id == 1 {
    let mut ok: bool = false;
    if c.res == 6 && c.caps == 6 {
      if c.ls == 1 { ok = true; }  // MUT:M16 => if c.ls > 0 { ok = true; }
    }
    if !ok { ck.fail = 4; }
  }
}

// Pump until the response to request `id` arrives (at most 1000000 events, then read-failed). The first failure wins. A server
// request in between is answered with the not-handled reply. On return ck.fail == 0 means the response arrived and was accepted.
// Writes go through transport::send with the overall budget. Spec P11 is resolved: a failed stdin write half-closes stdin and the
// reader keeps reading stdout (as TS does); the slot is not failed.
fn pump(take l: Loop, id: i64, inout ck: Check, inout st: crate::transport::Reader, inout line: [u8], inout chunk: [u8], inout c: Cap, inout buf: [u8]) -> Loop ! async, proc, alloc
  requires 1 <= id && id <= 2
  requires 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
  requires len(line) <= 8388608
  ensures 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
  ensures len(line) <= 8388608
{
  let mut q: Loop = move l;
  let mut done: bool = false;
  let mut events: i64 = 0;
  while ck.fail == 0 && !done && events < 1000000
    invariant 0 <= events && events <= 1000000
    invariant 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
    invariant len(line) <= 8388608 && 1 <= id && id <= 2
    decreases 1000000 - events
  {
    events = events + 1;
    q = step(move q, inout ck, inout st, inout line, inout chunk);
    if ck.fail == 0 && ck.ready {
      let tb: Bounds = trim_bounds(subview(line, 0, ck.n));
      let t: ref [u8] = subview(line, tb.lo, tb.hi);
      let fk: i64 = fast_kind(t, id, inout c);
      if fk == 1 { q = crate::transport::send(move q, ck.slot, not_handled_line(t, c), ck.budget); }
      else if fk == 2 {
        done = true;
        on_reply(t, c, id, inout ck, inout buf);
      }
      // hand on_line: the line is cleared once used
      line = truncate(line, 0);
    }
  }
  if ck.fail == 0 && !done { ck.fail = 6; }
  return move q;
}

// After a response settled a request: the remaining complete lines of the current chunk are processed with nothing outstanding
// (server requests answered, everything else ignored) before the next request is written. Each step eats at least one chunk byte.
fn drain(take l: Loop, inout ck: Check, inout st: crate::transport::Reader, inout line: [u8], inout chunk: [u8], inout c: Cap) -> Loop ! async, proc, alloc
  requires 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
  requires len(line) <= 8388608
  ensures 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
  ensures len(line) <= 8388608
{
  let mut q: Loop = move l;
  let mut n: i64 = 0;
  while ck.fail == 0 && st.at < st.end && n < 70000
    invariant 0 <= n && n <= 70000
    invariant 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
    invariant len(line) <= 8388608
    decreases 70000 - n
  {
    n = n + 1;
    // hand `step(false)`: the buffered bytes only; a partial line stays in `line` and the drain ends (no read, no poll)
    crate::transport::scan(inout st, inout line, chunk, 8388608);
    let k: i64 = st.status;
    if k == -3 { ck.fail = 6; }
    // an id of 99 is never outstanding: only server requests (kind 1) matter here
    if k >= 0 && k <= len(line) {
      let tb: Bounds = trim_bounds(subview(line, 0, k));
      let t: ref [u8] = subview(line, tb.lo, tb.hi);
      if fast_kind(t, 99, inout c) == 1 { q = crate::transport::send(move q, ck.slot, not_handled_line(t, c), ck.budget); }
      line = truncate(line, 0);
    }
  }
  return move q;
}

// Before a request is written: a child whose stdin is already closed is a timeout when the overall timer fired, else read-failed.
fn before_send(take l: Loop, inout ck: Check, inout st: crate::transport::Reader) -> Loop ! async, alloc
  ensures st.at == old(st).at && st.end == old(st).end
{
  if !crate::transport::stdin_closed(l, ck.slot) { return move l; }
  let q: Loop = crate::transport::expired(move l, ck.timer, inout st);
  if st.status == -1 { ck.fail = 5; } else { ck.fail = 6; }
  return move q;
}

// ---- result ----

// the failure as a mode 3 result packet (see NOTE 8); raw and detail are given up (hand failure(f, stage, raw, detail)), the detail
// bytes to the text
fn failure(code: i64, stage: i64, take raw: [u8], take detail: [u8]) -> [i64] ! alloc
  ensures len(result) >= 28
{
  let none: [u8] = alloc(0, 0);
  if code == 3 {
    let dt: str = crate::jstr::owned_text(move detail);
    return crate::packet::error_mode(3, stage, 3, 0, 0, 0, raw, "RpcResponseError", dt);
  }
  if code == 7 { return crate::packet::error_mode(3, 24, 1, 8, 0, 0, none, "EngineImportError", ""); }
  if code == 6 { return crate::packet::error_mode(3, stage, 1, 7, 0, 0, none, "EngineImportError", ""); }
  if code == 5 { return crate::packet::error_mode(3, stage, 1, 6, 0, 0, none, "EngineImportError", ""); }
  if code == 4 { return crate::packet::error_mode(3, 25, 1, 5, 0, 0, none, "EngineImportError", ""); }
  return crate::packet::error_mode(3, 30, 6, 2, 0, 0, none, "", "");
}

// The ACP load check of the copy in `home`: spawn `binary agent --no-leader stdio` (cwd folder, GROK_HOME=home), initialize (id 1),
// require loadSession === true, then session/load (id 2); any successful reply (missing or null result included) passes.
// Returns a RESULT packet (mode 3, the host boundary): status 0 on success, status 1 with the stage 24..26 error otherwise. The loop
// and the child are closed on every path (transport::close consumes the Loop; a failed spawn is consumed by proc_wait).
pub fn load_check(binary: str, home: str, folder: str, thread: str, timeout_ms: i64) -> [i64] ! async, net, proc, alloc
  requires len(binary) <= 1000000 && len(home) <= 1000000 && len(folder) <= 1000000 && len(thread) <= 1000000
  requires 0 <= timeout_ms && timeout_ms <= 2147483647
  ensures len(result) >= 28
{
  let d0: [u8] = alloc(0, 0);
  let r0: [u8] = alloc(0, 0);
  let mut ck: Check = Check { fail: 0, stage: 24, slot: -1, timer: -1, budget: 0, ready: false, n: 0, detail: move d0, raw: move r0 };
  let mut l: Loop = start(binary, home, folder, timeout_ms, inout ck);
  if ck.fail != 0 {
    // the hand returns at once when the spawn fails: no buffers are made
    crate::transport::close(move l, ck.slot);
    let r1: [u8] = move ck.raw;
    ck.raw = alloc(0, 0);
    let d1: [u8] = move ck.detail;
    ck.detail = alloc(0, 0);
    return failure(ck.fail, ck.stage, move r1, move d1);
  }
  let mut st: crate::transport::Reader = crate::transport::reader_new();
  let mut line: [u8] = alloc(0, 0);
  arr_reserve(inout line, 4096);
  let mut chunk: [u8] = alloc(65536, 0);
  let mut c: Cap = cap_new();
  let mut buf: [u8] = alloc(0, 0);
  ck.stage = 25;
  l = before_send(move l, inout ck, inout st);
  l = crate::transport::send(move l, ck.slot, req_init(), ck.budget);
  l = pump(move l, 1, inout ck, inout st, inout line, inout chunk, inout c, inout buf);
  if ck.fail == 0 {
    l = drain(move l, inout ck, inout st, inout line, inout chunk, inout c);
  }
  if ck.fail == 0 {
    ck.stage = 26;
    l = before_send(move l, inout ck, inout st);
    l = crate::transport::send(move l, ck.slot, req_load(thread, folder), ck.budget);
    l = pump(move l, 2, inout ck, inout st, inout line, inout chunk, inout c, inout buf);
  }
  // A settling response (0 ok, 2/3 error object, 4 bad capabilities) leaves the rest of its chunk: the reference's data handler still
  // answers server requests in it before the child is closed. The outcome is already settled, so a failed write there only half-closes stdin and is ignored.
  let settled: i64 = ck.fail;
  if settled == 0 || settled == 2 || settled == 3 || settled == 4 {
    ck.fail = 0;
    l = drain(move l, inout ck, inout st, inout line, inout chunk, inout c);
    ck.fail = settled;
  }
  crate::transport::close(move l, ck.slot);
  if ck.fail != 0 {
    // a moved field must be refilled by the next statement (no struct destructuring; an empty Vec does not allocate)
    let rw: [u8] = move ck.raw;
    ck.raw = alloc(0, 0);
    let dt: [u8] = move ck.detail;
    ck.detail = alloc(0, 0);
    return failure(ck.fail, ck.stage, move rw, move dt);
  }
  let meta: [i64] = crate::packet::meta_new(3);
  let er: [i64] = alloc(0, 0);
  let et: [u8] = alloc(0, 0);
  return crate::packet::result(meta, er, et);
}
