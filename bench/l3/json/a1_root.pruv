// Host-only scalar ABI. UTF-8 returns -1 or the first invalid sequence start.
// Token results: >=0 success end; -(kind * 33554432 + position) - 1 error.
// The encoding accommodates the A0 16 MiB input limit without overlap.
mod lex;

pub fn literal(input: [u8], pos: i64, end: i64) -> i64
  requires 0 <= pos && pos <= end && end <= len(input) && end <= 16777216
{
  let mut cursor: i64 = pos;
  let mut r: Result<(), crate::lex::Fault> = Ok::<(), crate::lex::Fault>(());
  if cursor < end && input[cursor] == 116 { r = crate::lex::scan_literal(input, inout cursor, end, "true"); }
  else if cursor < end && input[cursor] == 102 { r = crate::lex::scan_literal(input, inout cursor, end, "false"); }
  else { r = crate::lex::scan_literal(input, inout cursor, end, "null"); }
  match r {
    Ok(()) => { return cursor; }
    Err(fault) => { return -(fault.kind * 33554432 + fault.position) - 1; }
  }
}

pub fn number(input: [u8], pos: i64, end: i64) -> i64
  requires 0 <= pos && pos <= end && end <= len(input) && end <= 16777216
{
  let mut cursor: i64 = pos;
  let r: Result<(), crate::lex::Fault> = crate::lex::scan_number(input, inout cursor, end);
  match r {
    Ok(()) => { return cursor; }
    Err(fault) => { return -(fault.kind * 33554432 + fault.position) - 1; }
  }
}

pub fn string(input: [u8], pos: i64, end: i64) -> i64
  requires 0 <= pos && pos <= end && end <= len(input) && end <= 16777216
  requires pos < end && input[pos] == 34
{
  let mut cursor: i64 = pos;
  let r: Result<(), crate::lex::Fault> = crate::lex::scan_string(input, inout cursor, end);
  match r {
    Ok(()) => { return cursor; }
    Err(fault) => { return -(fault.kind * 33554432 + fault.position) - 1; }
  }
}

pub fn utf8(input: [u8], pos: i64, end: i64) -> i64
  requires 0 <= pos && pos <= end && end <= len(input)
  ensures result == -1 || (pos <= result && result < end)
{ return crate::lex::validate_utf8(input, pos, end); }

pub fn whitespace(input: [u8], pos: i64, end: i64) -> i64
  requires 0 <= pos && pos <= end && end <= len(input)
  ensures pos <= result && result <= end
{
  let mut cursor: i64 = pos;
  crate::lex::skip_whitespace(input, inout cursor, end);
  return cursor;
}
