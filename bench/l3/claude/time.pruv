// L3-1 A2 timestamps (mirror of tail.ts isoOf under the restricted domain of spec P4):
//   * JSON integer numbers with has_integer (|v| <= 9007199254740991, "-0" included);
//   * strings whose trim is nonempty ASCII digits (value <= 9007199254740991);
//   * strings that are exactly 24 ASCII bytes of canonical UTC ISO text YYYY-MM-DDTHH:mm:ss.sssZ.
// Integer v: ms = v * 1000 when v < 100000000000 (signed comparison), else ms = v; the result must lie in
// -62167219200000 (0000-01-01T00:00:00.000Z) .. 253402300799999 (9999-12-31T23:59:59.999Z).
// Everything else is absent (at None). Decoder/tape defects are status -4, never "absent".
// Civil calendar: days shifted by 5 whole 400-year cycles (63113904000000 ms) so every division is on
// nonnegative numbers, then the March-based civil-from-days walk (as bench/l0/cell_date.pruv).
// The shape of the 24-byte text is proved; the calendar arithmetic itself is guarded and tested.

// hand `Stamp` (Option<[u8; 24]>) plus the decoder status: status 0 (at is the stamp, None when absent) or -4 defect
// (at is None). The 24 bytes are a value, copied like the hand array (4.4c-IS).
pub struct Iso { status: i64, at: Option<[u8; 24]> }

pub fn time_none() -> i64 ensures result == 9223372036854775807 { return 9223372036854775807; }
pub fn time_min_ms() -> i64 ensures result == -62167219200000 { return -62167219200000; }
pub fn time_max_ms() -> i64 ensures result == 253402300799999 { return 253402300799999; }

// Seconds-or-milliseconds rule on a safe integer; time_none() when the milliseconds are out of range.
pub fn integer_time(v: i64) -> i64
  requires -9007199254740991 <= v && v <= 9007199254740991
  ensures result == 9223372036854775807 || (-62167219200000 <= result && result <= 253402300799999)
  ensures (v < 100000000000 && v >= -62167219200) ==> result == v * 1000
  ensures (v >= 100000000000 && v <= 253402300799999) ==> result == v
  ensures v < -62167219200 ==> result == 9223372036854775807
  ensures v > 253402300799999 ==> result == 9223372036854775807
{
  if v < 100000000000 {
    if v < -62167219200 { return 9223372036854775807; }
    return v * 1000;
  }
  if v > 253402300799999 { return 9223372036854775807; }
  return v;
}

fn leap(y: i64) -> bool
  requires 0 <= y
{
  if y % 400 == 0 { return true; }
  if y % 100 == 0 { return false; }
  return y % 4 == 0;
}

fn month_days(y: i64, m: i64) -> i64
  requires 0 <= y && 1 <= m && m <= 12
  ensures 28 <= result && result <= 31
{
  if m == 2 {
    if leap(y) { return 29; }
    return 28;
  }
  if m == 4 || m == 6 || m == 9 || m == 11 { return 30; }
  return 31;
}

// hand canon: b[p..p+24] is a valid canonical UTC timestamp (year 0000 allowed, Gregorian rules). The shape is
// checked byte by byte and the first mismatch returns; the fields are then read from the checked digits.
// One function over bytes: a `str` value cannot be passed as a read-only `[u8]` view (from_string copies first).
pub fn canonical_at(b: [u8], p: i64) -> bool
  requires 0 <= p && p + 24 <= len(b)
  ensures result ==> (b[p + 4] == 45 && b[p + 7] == 45 && b[p + 10] == 84 && b[p + 13] == 58 && b[p + 16] == 58 && b[p + 19] == 46 && b[p + 23] == 90)
  ensures result ==> (forall i in 0..24: (i == 4 || i == 7 || i == 10 || i == 13 || i == 16 || i == 19 || i == 23 || (48 <= b[p + i] && b[p + i] <= 57)))
{
  let mut i: i64 = 0;
  while i < 24
    invariant 0 <= i && i <= 24
    invariant forall k in 0..i: ((k == 4 || k == 7) ==> b[p + k] == 45) && (k == 10 ==> b[p + k] == 84) && ((k == 13 || k == 16) ==> b[p + k] == 58) && (k == 19 ==> b[p + k] == 46) && (k == 23 ==> b[p + k] == 90)
    invariant forall k in 0..i: (k == 4 || k == 7 || k == 10 || k == 13 || k == 16 || k == 19 || k == 23 || (48 <= b[p + k] && b[p + k] <= 57))
    decreases 24 - i
  {
    let c: i64 = b[p + i];
    let mut ok: bool = 48 <= c && c <= 57;
    if i == 4 || i == 7 { ok = c == 45; }
    if i == 10 { ok = c == 84; }
    if i == 13 || i == 16 { ok = c == 58; }
    if i == 19 { ok = c == 46; }
    if i == 23 { ok = c == 90; }
    if !ok { return false; }
    i = i + 1;
  }
  let y: i64 = num(b, p, 4);
  let m: i64 = num(b, p + 5, 2);
  let d: i64 = num(b, p + 8, 2);
  if m < 1 || m > 12 { return false; }
  return d >= 1 && d <= month_days(y, m) && num(b, p + 11, 2) <= 23 && num(b, p + 14, 2) <= 59 && num(b, p + 17, 2) <= 59;
}

// Decimal value of the n checked ASCII digits b[a..a+n] (hand closure `n`).
fn num(b: [u8], a: i64, n: i64) -> i64
  requires 0 <= a && 0 <= n && n <= 4 && a + n <= len(b)
  requires forall k in 0..n: 48 <= b[a + k] && b[a + k] <= 57
  ensures 0 <= result && result <= 9999
{
  let mut v: i64 = 0;
  let mut k: i64 = 0;
  while k < n
    invariant 0 <= k && k <= n && 0 <= v && v <= 9999
    invariant (k <= 0 ==> v == 0) && (k <= 1 ==> v <= 9) && (k <= 2 ==> v <= 99) && (k <= 3 ==> v <= 999)
    decreases n - k
  {
    v = v * 10 + (b[a + k] - 48);
    k = k + 1;
  }
  return v;
}

// hand put_digits: v as n decimal digits ending at o[at + n - 1].
fn put_digits(inout o: [u8; 24], at: i64, n: i64, v0: i64) -> ()
  requires 0 <= at && 0 <= n && at + n <= 24 && 0 <= v0
  ensures forall q in 0..24: (q < at || q >= at + n) ==> o[q] == old(o)[q]
  ensures forall q in at..at + n: 48 <= o[q] && o[q] <= 57
{
  let mut v: i64 = v0;
  let mut k: i64 = n;
  while k > 0
    invariant 0 <= k && k <= n && 0 <= v
    invariant forall q in 0..24: (q < at + k || q >= at + n) ==> o[q] == old(o)[q]
    invariant forall q in at + k..at + n: 48 <= o[q] && o[q] <= 57
    decreases k
  {
    k = k - 1;
    o[at + k] = u8(48 + v % 10);
    v = v / 10;
  }
}

// 24-byte canonical text of integer milliseconds in the supported range (hand: template + put_digits).
pub fn format_iso(ms: i64) -> [u8; 24]
  requires -62167219200000 <= ms && ms <= 253402300799999
  ensures result[4] == 45 && result[7] == 45 && result[10] == 84 && result[13] == 58 && result[16] == 58 && result[19] == 46 && result[23] == 90
  ensures forall i in 0..24: (i == 4 || i == 7 || i == 10 || i == 13 || i == 16 || i == 19 || i == 23 || (48 <= result[i] && result[i] <= 57))
{
  let day: i64 = 86400000;
  // 5 cycles of 146097 days: 730485 days = 63113904000000 ms.
  let shifted: i64 = ms + 63113904000000;
  let days: i64 = shifted / day;
  let rem: i64 = shifted - days * day;
  let z: i64 = days + 719468;
  let era: i64 = z / 146097;
  let doe: i64 = z - era * 146097;
  let yoe: i64 = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
  let doy: i64 = doe - (365 * yoe + yoe / 4 - yoe / 100);
  let mp: i64 = (5 * doy + 2) / 153;
  let d: i64 = doy - (153 * mp + 2) / 5 + 1;
  let mut m: i64 = mp + 3;
  if mp >= 10 { m = mp - 9; }
  let mut y: i64 = yoe + era * 400 - 2000;
  if m <= 2 { y = y + 1; }
  let secs: i64 = rem / 1000;
  let mut o: [u8; 24] = [48, 48, 48, 48, 45, 48, 48, 45, 48, 48, 84, 48, 48, 58, 48, 48, 58, 48, 48, 46, 48, 48, 48, 90];
  put_digits(inout o, 0, 4, y);
  put_digits(inout o, 5, 2, m);
  put_digits(inout o, 8, 2, d);
  put_digits(inout o, 11, 2, secs / 3600);
  put_digits(inout o, 14, 2, secs % 3600 / 60);
  put_digits(inout o, 17, 2, secs % 60);
  put_digits(inout o, 20, 3, rem % 1000);
  return o;
}

pub fn absent() -> Iso
  ensures result.status == 0 && !is_some(result.at)
{
  return Iso { status: 0, at: None::<[u8; 24]> };
}

pub fn defect() -> Iso
  ensures result.status == -4 && !is_some(result.at)
{
  return Iso { status: -4, at: None::<[u8; 24]> };
}

// hand `o.copy_from_slice(..)`: the 24 bytes b[p..p+24].
fn copy24(b: [u8], p: i64) -> [u8; 24]
  requires 0 <= p && p + 24 <= len(b)
  ensures forall k in 0..24: i64(result[k]) == b[p + k]
{
  let mut o: [u8; 24] = [u8(0); 24];
  let mut i: i64 = 0;
  while i < 24
    invariant 0 <= i && i <= 24
    invariant forall k in 0..i: i64(o[k]) == b[p + k]
    decreases 24 - i
  {
    o[i] = u8(b[p + i]);
    i = i + 1;
  }
  return o;
}

// hand iso_of_int
fn from_integer(v: i64) -> Iso
  requires -9007199254740991 <= v && v <= 9007199254740991
  ensures result.status == 0
{
  let ms: i64 = integer_time(v);
  if ms == 9223372036854775807 { return absent(); }
  return Iso { status: 0, at: Some::<[u8; 24]>(format_iso(ms)) };
}

// All of t is ASCII digits (and t is nonempty): the value; -1 for a non-digit before the value passes 2^53-1;
// -2 as soon as the digits read so far pass 2^53-1 (such a prefix is never a canonical ISO year, so from_string
// answers absent either way).
fn digit_value(t: str) -> i64
  ensures -2 <= result && result <= 9007199254740991
{
  if len(t) == 0 { return -1; }
  let mut v: i64 = 0;
  let mut i: i64 = 0;
  while i < len(t)
    invariant 0 <= i && i <= len(t)
    invariant 0 <= v && v <= 9007199254740991
    decreases len(t) - i
  {
    let c: i64 = t[i];
    if c < 48 || c > 57 { return -1; }
    let d: i64 = c - 48;
    if v > (9007199254740991 - d) / 10 { return -2; }
    v = v * 10 + d;
    i = i + 1;
  }
  return v;
}

// hand iso_str
fn from_string(v: str) -> Iso ! alloc
  ensures result.status == 0
{
  let t: crate::text::Span = crate::text::trim_span(v);
  let n: i64 = digit_value(subview(v, t.lo, t.hi));
  if n >= 0 { return from_integer(n); }
  if n == -2 { return absent(); }
  if len(v) != 24 { return absent(); }
  let b: [u8] = bytes24(v);
  if canonical_at(b, 0) { return Iso { status: 0, at: Some::<[u8; 24]>(copy24(b, 0)) }; }
  return absent();
}

fn bytes24(s: str) -> [u8] ! alloc
  requires len(s) == 24
  ensures len(result) == 24
{
  let mut out: [u8] = alloc(24, 0);
  copy_range(inout out, 0, s, 0, 24);
  return out;
}

// tail.ts isoOf for the value with tape id `id` of doc (hand iso).
pub fn iso_of(doc: crate::json::JsonDocument, id: i64) -> Iso ! alloc
  ensures result.status == 0 || (result.status == -4 && !is_some(result.at))
{
  let k: i64 = crate::access::kind(doc, id);
  if k < 0 { return defect(); }
  if k == 3 {
    let n: crate::access::Number = crate::access::number(doc, id);
    if n.status != 0 { return defect(); }
    if !n.has_integer { return absent(); }
    if n.integer < -9007199254740991 || n.integer > 9007199254740991 { return defect(); }
    return from_integer(n.integer);
  }
  if k == 4 {
    // A quoted canonical timestamp has no escapes, so its value is the 24 raw bytes: no decoding needed.
    let sp: crate::access::Span = crate::access::raw_span(doc, id);
    if sp.status == 0 && sp.end - sp.start == 26 && canonical_at(doc.source, sp.start + 1) {
      return Iso { status: 0, at: Some::<[u8; 24]>(copy24(doc.source, sp.start + 1)) };
    }
    let t: crate::jstr::Text = crate::access::string_text_owned(doc, id);
    match t {
      crate::jstr::Text::InternalInvariant(e) => { return defect(); }
      crate::jstr::Text::Decoded(v) => { return from_string(v); }
    }
  }
  return absent();
}
