// L3-1 A3 root: a plain-array program runner for the turn collector (root pub fns take [i64]/[u8] and return
// [i64]). `run(prog)` executes a transition program on fresh state and returns the observations.
//   prog[0]  base offset passed to the turn writer
//   then ops: [1, text, stamp] begin   [2] skip_user   [3, text, stamp] answer   [4] tool   [5] snapshot
//   spec     [n, plen, p0..p(plen-1)]: n bytes, byte i = p[i % plen] (plen >= 1 when n > 0); a stamp spec must
//            decode to 0 or 24 bytes; a text must be valid UTF-8
// Result: [0, nsnap, kept, trimmed, total, ...12*nsnap snapshot words, ...10*kept turn words, ...text bytes]
//         [1, position] for a malformed program.
// A snapshot is [begun, current, lost, slot, plen, rlen, budget, tools, clipped, created, completed, ordinal]
// of the current draft index (begun - 1) % 200 (slot 0 and zero fields before any begin); its ordinal is begun - 1 (-1 before any begin).
mod json;
mod jstr;
mod text;
mod boundary;
mod turns;

pub struct Txt { next: i64, bytes: [u8] }

fn pair(a: i64, b: i64) -> [i64] ! alloc
  ensures len(result) == 2
{
  let mut out: [i64] = alloc(2, 0);
  out[0] = a; out[1] = b;
  return out;
}

fn bad() -> Txt ! alloc
  ensures result.next == -1
{
  let z: [u8] = alloc(0, 0);
  return Txt { next: -1, bytes: copy(z) };
}

// Decode the spec at pos; next == -1 when malformed.
fn read_text(prog: [i64], pos: i64) -> Txt ! alloc
  requires 0 <= pos && len(prog) <= 100000000
  ensures result.next == -1 || (pos + 2 <= result.next && result.next <= len(prog))
  ensures result.next == -1 || len(result.bytes) <= 100000000
{
  if pos > len(prog) - 2 { return bad(); }
  let n: i64 = prog[pos];
  let plen: i64 = prog[pos + 1];
  if n < 0 || n > 100000000 { return bad(); }
  if plen < 0 || plen > 4096 { return bad(); }
  if n > 0 && plen == 0 { return bad(); }
  if plen > len(prog) - (pos + 2) { return bad(); }
  let mut pat: [u8] = alloc(plen, 0);
  let mut k: i64 = 0;
  while k < plen
    invariant 0 <= k && k <= plen && len(pat) == plen && 0 <= pos && plen <= len(prog) - (pos + 2)
    decreases plen - k
  {
    let v: i64 = prog[pos + 2 + k];
    if v < 0 || v > 255 { return bad(); }
    pat[k] = v;
    k = k + 1;
  }
  let mut out: [u8] = alloc(n, 0);
  let mut i: i64 = 0;
  let mut m: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && len(out) == n && len(pat) == plen && 0 <= m && (n == 0 || plen > 0) && (plen == 0 || m < plen)
    decreases n - i
  {
    out[i] = pat[m];
    m = m + 1;
    if m == plen { m = 0; }
    i = i + 1;
  }
  return Txt { next: pos + 2 + plen, bytes: copy(out) };
}

struct Step { next: i64 }

// One op at pos; the new position, or -1 for a malformed op (state untouched on every -1).
fn step(prog: [i64], pos: i64, inout col: crate::turns::Collector, inout snaps: [i64]) -> Step ! alloc
  requires 0 <= pos && pos < len(prog) && len(prog) <= 100000000
  requires crate::turns::ok(col) && col.begun <= pos && len(snaps) == 769
  requires 0 <= snaps[0] && snaps[0] <= 64
  ensures crate::turns::ok(col) && len(snaps) == 769
  ensures result.next == -1 || (pos < result.next && result.next <= len(prog))
  ensures result.next == -1 || col.begun <= result.next
  ensures 0 <= snaps[0] && snaps[0] <= 64
{
  let op: i64 = prog[pos];
  if op == 2 {
    crate::turns::skip_user(inout col);
    return Step { next: pos + 1 };
  }
  if op == 4 {
    crate::turns::tool(inout col);
    return Step { next: pos + 1 };
  }
  if op == 5 {
    let nsn: i64 = snaps[0];
    if nsn >= 64 { return Step { next: -1 }; }
    let at: i64 = 1 + 12 * nsn;
    snaps[at] = col.begun;
    snaps[at + 1] = 0;
    if col.active { snaps[at + 1] = 1; }
    snaps[at + 2] = 0;
    if col.lost { snaps[at + 2] = 1; }
    let mut k: i64 = 0;
    let mut f: [i64] = alloc(7, 0);
    if col.begun >= 1 {
      k = crate::turns::current(col);
      f[0] = len(vec_get::<crate::turns::Draft>(col.drafts, k).prompt);
      f[1] = len(vec_get::<crate::turns::Draft>(col.drafts, k).reply);
      f[2] = vec_get::<crate::turns::Draft>(col.drafts, k).used;
      f[3] = vec_get::<crate::turns::Draft>(col.drafts, k).tools;
      if vec_get::<crate::turns::Draft>(col.drafts, k).clipped { f[4] = 1; }
      f[5] = len(vec_get::<crate::turns::Draft>(col.drafts, k).created) / 24;
      f[6] = len(vec_get::<crate::turns::Draft>(col.drafts, k).completed) / 24;
    }
    snaps[at + 3] = k;
    snaps[at + 4] = f[0];
    snaps[at + 5] = f[1];
    snaps[at + 6] = f[2];
    snaps[at + 7] = f[3];
    snaps[at + 8] = f[4];
    snaps[at + 9] = f[5];
    snaps[at + 10] = f[6];
    snaps[at + 11] = col.begun - 1;
    snaps[0] = nsn + 1;
    return Step { next: pos + 1 };
  }
  if op == 1 || op == 3 {
    let a: Txt = read_text(prog, pos + 1);
    if a.next < 0 { return Step { next: -1 }; }
    let b: Txt = read_text(prog, a.next);
    if b.next < 0 { return Step { next: -1 }; }
    let s: str = crate::jstr::adapter_probe(a.bytes);
    if len(s) != len(a.bytes) { return Step { next: -1 }; }
    if len(b.bytes) != 0 && len(b.bytes) != 24 { return Step { next: -1 }; }
    if op == 1 {
      crate::turns::begin(inout col, s, b.bytes);
    } else {
      crate::turns::answer(inout col, s, b.bytes);
    }
    return Step { next: b.next };
  }
  return Step { next: -1 };
}

pub fn run(prog: [i64]) -> [i64] ! alloc
{
  if len(prog) < 1 || len(prog) > 100000000 { return pair(1, 0); }
  let base: i64 = prog[0];
  if base < 0 || base > 3500000 { return pair(1, 0); }
  let mut col: crate::turns::Collector = crate::turns::new_collector();
  let mut snaps: [i64] = alloc(769, 0);
  let mut pos: i64 = 1;
  while pos < len(prog)
    invariant 1 <= pos && pos <= len(prog) && len(prog) <= 100000000 && 0 <= base && base <= 3500000
    invariant crate::turns::ok(col) && col.begun <= pos && len(snaps) == 769
    invariant 0 <= snaps[0] && snaps[0] <= 64
    decreases len(prog) - pos
  {
    let step_result: Step = step(prog, pos, inout col, inout snaps);
    if step_result.next < 0 { return pair(1, pos); }
    pos = step_result.next;
  }
  let plan: crate::turns::Plan = crate::turns::plan(col);
  let ns: i64 = snaps[0];
  let head: i64 = 5 + 12 * ns;
  // A3 refs include base, but the fixture packet omits the base bytes.
  let mut text: [u8] = alloc(0, 0);
  arr_reserve(inout text, plan.bytes);
  let mut turns: [i64] = alloc(0, 0);
  arr_reserve(inout turns, 10 * plan.kept);
  crate::turns::put_turns(inout turns, inout text, base, col, plan.kept);
  let mut flag: i64 = 0;
  if plan.kept < col.begun { flag = 1; }
  let mut out: [i64] = alloc(0, 0);
  arr_reserve(inout out, head + len(turns) + len(text));
  arr_push(inout out, 0, ns, plan.kept, flag, plan.total);
  arr_append(inout out, snaps, 1, 12 * ns);
  arr_append(inout out, turns, 0, len(turns));
  arr_append(inout out, text, 0, len(text));
  return out;
}
