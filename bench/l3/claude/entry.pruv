// L3-1 A1 entry classification (mirror of tail.ts parseLine/record/str and claude.ts humanText/titleOf):
// one-line parse to an object document, checked field helpers, human_text and ranked titles.
// Decoder/tape defects (jstr InternalInvariant, corrupt tape) are returned as Defect, never as Missing.
// Objects are looked up with last-wins keys; kinds are never coerced.

pub enum Line { Object(doc: crate::json::JsonDocument), Skip, Defect(position: i64) }
pub enum Field { Value(text: str), Missing, Defect(kind: i64) }
enum Block { Piece(text: str), Ignore, Veto, Broken(kind: i64) }

// Object roots only; malformed, empty and non-object lines are Skip; only InternalInvariant is a defect.
pub fn parse_line(data: [u8], start: i64, end: i64) -> Line ! alloc
  requires 0 <= start && start <= end && end <= len(data)
  ensures is_variant(result, Line::Object) ==> crate::json::doc_local(variant_field(result, Line::Object, doc))
  ensures is_variant(result, Line::Object) ==> crate::json::doc_strings(variant_field(result, Line::Object, doc))
{
  // DB39: parse::parse over a borrowed view (R-6g-5). The scan reads data[start..end) in place and
  // validates UTF-8 inside string tokens (D33); the record-local tape facts are scan_document ensures
  // (DB33) and the parent and subtree facts are proved too (L-gaps 19), so nothing is checked after the scan.
  // Only an accepted line copies its bytes, once.
  // Every non-InternalInvariant failure maps to Skip (invalid UTF-8 included), as before.
  let n: i64 = end - start;
  if n > crate::json::limit_input_bytes() { return Line::Skip; }
  // 4.4zc (4.4l-RS): `object` takes only an object root, as the hand `parser.object(1)?`: another root fails at its
  // first byte, before any record, and the root kind check after the parse is proved away.
  let parsed: crate::json::JsonParse = crate::parse::parse(subview(data, start, end), true);
  match parsed {
    crate::json::JsonParse::Failed(error) => {
      if error.kind == crate::json::err_internal_invariant() { return Line::Defect(error.position); }
      return Line::Skip;
    }
    crate::json::JsonParse::Parsed(document) => {
      return Line::Object(document);
    }
  }
}

// Field present with kind string -> its decoded text; missing or another kind -> Missing.
pub fn string_field(doc: crate::json::JsonDocument, id: i64, key: str) -> Field ! alloc
  ensures is_variant(result, Field::Value) ==> len(variant_field(result, Field::Value, text)) <= 50331648
{
  return string_field_of(doc, crate::access::field(doc, id, key));
}

pub fn string_field_of(doc: crate::json::JsonDocument, f: i64) -> Field ! alloc
  ensures is_variant(result, Field::Value) ==> len(variant_field(result, Field::Value, text)) <= 50331648
{
  if f == -1 || f == -2 { return Field::Missing; }
  if f < 0 { return Field::Defect(f); }
  let k: i64 = crate::access::kind(doc, f);
  if k < 0 { return Field::Defect(k); }
  if k != 4 { return Field::Missing; }
  let t: crate::jstr::Text = crate::access::string_text_owned(doc, f);
  match t {
    crate::jstr::Text::InternalInvariant(e) => { return Field::Defect(e); }
    crate::jstr::Text::Decoded(v) => {
      if len(v) > 50331648 { return Field::Defect(-4); }
      return Field::Value(move v);
    }
  }
}

// 1 when the field is present, a string, and equal to lit; 0 when missing, another kind or another string;
// negative on a corrupt tape (string_field's Defect). No decoding for ASCII literals.
pub fn field_is(doc: crate::json::JsonDocument, id: i64, key: str, lit: str) -> i64 ! alloc
{
  let f: i64 = string_id(doc, id, key);
  if f == -1 { return 0; }
  if f < 0 { return f; }
  return crate::access::string_is(doc, f, lit);
}

// ID of the field when it is present and a string; -1 when missing or another kind; -3/-4 on a corrupt tape.
pub fn string_id(doc: crate::json::JsonDocument, id: i64, key: str) -> i64 ! alloc
  ensures result == -1 || result == -3 || result == -4 || (result >= 0 && result < len(doc.tape) / 6)
{
  return string_of(doc, crate::access::field(doc, id, key));
}

pub fn string_of(doc: crate::json::JsonDocument, f: i64) -> i64
  ensures result == -1 || result == -3 || result == -4 || (result >= 0 && result < len(doc.tape) / 6)
{
  if f == -1 || f == -2 { return -1; }
  if f < 0 { if f == -3 { return -3; } return -4; }
  let k: i64 = crate::access::kind(doc, f);
  if k < 0 || f >= len(doc.tape) / 6 { return -3; }
  if k != 4 { return -1; }
  return f;
}

// ID of the field when it is present and an object; -1 when missing or another kind; -2 on a corrupt tape.
pub fn object_field(doc: crate::json::JsonDocument, id: i64, key: str) -> i64 ! alloc
  ensures result == -1 || result == -2 || (result >= 0 && result < len(doc.tape) / 6)
{
  return object_of(doc, crate::access::field(doc, id, key));
}

pub fn object_of(doc: crate::json::JsonDocument, f: i64) -> i64
  ensures result == -1 || result == -2 || (result >= 0 && result < len(doc.tape) / 6)
{
  if f == -1 || f == -2 { return -1; }
  if f < 0 { return -2; }
  let k: i64 = crate::access::kind(doc, f);
  if k < 0 || f >= len(doc.tape) / 6 { return -2; }
  if k == 6 { return f; }
  return -1;
}

// 1 when the field is present and the literal boolean true, 0 otherwise, negative on a corrupt tape.
pub fn is_true(doc: crate::json::JsonDocument, id: i64, key: str) -> i64 ! alloc
{
  return true_of(doc, crate::access::field(doc, id, key));
}

pub fn true_of(doc: crate::json::JsonDocument, f: i64) -> i64
{
  if f == -1 || f == -2 { return 0; }
  if f < 0 { return f; }
  let k: i64 = crate::access::kind(doc, f);
  if k < 0 { return k; }
  if k == 2 { return 1; }
  return 0;
}

// 1 when origin is an object whose kind is the string "task-notification", 0 otherwise, negative on a
// corrupt tape.
pub fn task_origin(doc: crate::json::JsonDocument, id: i64) -> i64 ! alloc
{
  return task_origin_of(doc, crate::access::field(doc, id, "origin"));
}

pub fn task_origin_of(doc: crate::json::JsonDocument, origin_raw: i64) -> i64 ! alloc
{
  let o: i64 = object_of(doc, origin_raw);
  if o == -1 { return 0; }
  if o < 0 { return -4; }
  return field_is(doc, o, "kind", "task-notification");
}

// 4.4s (4.4n-KL option 3): the root keys the three readers use, resolved in one walk over the root's members
// (hand: `object()` builds the map in one pass, then each `get` costs one resolution). A slot holds what
// `access::field(doc, 0, key)` returns: the value id of the last member with that key, -1 when missing, and the
// same negative code in every slot when the walk finds a corrupt tape. No allocation: the slots are one value.
pub struct RootKeys { ty: i64, timestamp: i64, side: i64, meta: i64, api: i64, message: i64, origin: i64, custom: i64, ai: i64, summary: i64, title: i64, cwd: i64, entrypoint: i64 }

fn keys_all(v: i64) -> RootKeys
{
  return RootKeys { ty: v, timestamp: v, side: v, meta: v, api: v, message: v, origin: v, custom: v, ai: v, summary: v, title: v, cwd: v, entrypoint: v };
}

pub fn root_keys(doc: crate::json::JsonDocument) -> RootKeys
{
  let stop: i64 = crate::access::members_end(doc, 0);
  if stop < 0 { return keys_all(stop); }
  let mut k: RootKeys = keys_all(-1);
  let mut j: i64 = 1;
  while j < stop
    invariant 0 < j && j <= stop && stop <= len(doc.tape) / 6
    decreases stop - j
  {
    let n: i64 = crate::access::member_next(doc, 0, j, stop);
    if n < 0 { return keys_all(-4); }
    let v: i64 = j + 1;
    if crate::access::key_is(doc, j, "type") { k.ty = v; }
    else if crate::access::key_is(doc, j, "timestamp") { k.timestamp = v; }
    else if crate::access::key_is(doc, j, "isSidechain") { k.side = v; }
    else if crate::access::key_is(doc, j, "message") { k.message = v; }
    else if crate::access::key_is(doc, j, "isMeta") { k.meta = v; }
    else if crate::access::key_is(doc, j, "isApiErrorMessage") { k.api = v; }
    else if crate::access::key_is(doc, j, "origin") { k.origin = v; }
    else if crate::access::key_is(doc, j, "cwd") { k.cwd = v; }
    else if crate::access::key_is(doc, j, "entrypoint") { k.entrypoint = v; }
    else if crate::access::key_is(doc, j, "title") { k.title = v; }
    else if crate::access::key_is(doc, j, "customTitle") { k.custom = v; }
    else if crate::access::key_is(doc, j, "aiTitle") { k.ai = v; }
    else if crate::access::key_is(doc, j, "summary") { k.summary = v; }
    j = n;
  }
  return k;
}

// A block of a content array: a text piece, an ignorable block, the tool_result veto, or a defect.
fn block_of(doc: crate::json::JsonDocument, j: i64) -> Block ! alloc
{
  let k: i64 = crate::access::kind(doc, j);
  if k < 0 { return Block::Broken(k); }
  if k != 6 { return Block::Ignore; }
  let ty: i64 = string_of(doc, crate::access::field(doc, j, "type"));
  if ty == -1 { return Block::Ignore; }
  if ty < 0 { return Block::Broken(ty); }
  let veto: i64 = crate::access::string_is(doc, ty, "tool_result");
  if veto < 0 { return Block::Broken(veto); }
  if veto == 1 { return Block::Veto; }
  let txt: i64 = crate::access::string_is(doc, ty, "text");
  if txt < 0 { return Block::Broken(txt); }
  if txt == 0 { return Block::Ignore; }
  let tx: Field = string_field_of(doc, crate::access::field(doc, j, "text"));
  match tx {
    Field::Value(x) => { return Block::Piece(move x); }
    Field::Missing => { return Block::Ignore; }
    Field::Defect(e) => { return Block::Broken(e); }
  }
}

// hand is_human_text: one trim; empty and the interrupt lines are not human text; the origin is read only when
// both task tags match. 1 human, 0 not, negative on a corrupt tape.
fn is_human_text(doc: crate::json::JsonDocument, origin: i64, text: str) -> i64 ! alloc
{
  let b: crate::text::Span = crate::text::trim_span(text);
  if b.lo == b.hi { return 0; }
  if crate::text::interrupt_line(text, b.lo, b.hi) { return 0; }
  if !crate::text::task_tags(text, b.lo, b.hi) { return 1; }
  let o: i64 = task_origin_of(doc, origin);
  if o < 0 { return o; }
  return 1 - o;
}

// String content: untrimmed text unless blank or an engine line.
fn string_content(doc: crate::json::JsonDocument, origin: i64, c: i64) -> Field ! alloc
{
  let t: crate::jstr::Text = crate::access::string_text_owned(doc, c);
  match t {
    crate::jstr::Text::InternalInvariant(e) => { return Field::Defect(e); }
    crate::jstr::Text::Decoded(v) => {
      let h: i64 = is_human_text(doc, origin, v);
      if h < 0 { return Field::Defect(h); }
      if h == 0 { return Field::Missing; }
      return Field::Value(move v);
    }
  }
}

// Array content: walk the children by their skip links; a tool_result object anywhere vetoes; text pieces
// are joined with "\n\n"; the joined text is then tested for blankness and engine lines.
fn array_content(doc: crate::json::JsonDocument, origin: i64, c: i64) -> Field ! alloc
  requires 0 <= c && c < len(doc.tape) / 6
{
  if len(doc.tape) > 6291456 { return Field::Defect(-4); }
  let stop: i64 = doc.tape[6 * c + 3];
  if stop <= c || stop > len(doc.tape) / 6 { return Field::Defect(-4); }
  // hand human_text: the first piece is held as is; joining starts at the second piece.
  let mut first: str = "";
  let mut joined: String = string_new();
  let mut count: i64 = 0;
  let mut j: i64 = c + 1;
  while j < stop
    invariant 0 <= c && c < j && j <= stop && stop <= len(doc.tape) / 6 && len(doc.tape) <= 6291456
    invariant 0 <= count && count <= j
    invariant len(first) <= 1000000000 && len(joined) <= 1000000000
    decreases stop - j
  {
    let next: i64 = doc.tape[6 * j + 3];
    if next <= j || next > stop || doc.tape[6 * j + 4] != c { return Field::Defect(-4); }
    let b: Block = block_of(doc, j);
    match b {
      Block::Piece(x) => {
        if count == 0 {
          if len(x) > 1000000000 - 2 { return Field::Defect(-4); }
          first = move x;
        } else {
          if count == 1 { joined = string_push_str(move joined, first); }
          let room: i64 = 1000000000 - len(joined);
          if len(x) > room - 2 { return Field::Defect(-4); }
          joined = string_push_str(move joined, "\n\n");
          joined = string_push_str(move joined, x);
        }
        count = count + 1;
      }
      Block::Ignore => {}
      Block::Veto => { return Field::Missing; }
      Block::Broken(e) => { return Field::Defect(e); }
    }
    j = next;
  }
  let mut whole: str = move first;
  if count > 1 { whole = string_into_str(move joined); }
  let h: i64 = is_human_text(doc, origin, whole);
  if h < 0 { return Field::Defect(h); }
  if h == 0 { return Field::Missing; }
  return Field::Value(move whole);
}

// claude.ts humanText for a root object: the human-written text (untrimmed) or Missing.
pub fn human_text(doc: crate::json::JsonDocument) -> Field ! alloc
{
  return human_text_of(doc, root_keys(doc));
}

pub fn human_text_of(doc: crate::json::JsonDocument, k: RootKeys) -> Field ! alloc
{
  let ty: i64 = string_of(doc, k.ty);
  if ty == -1 { return Field::Missing; }
  if ty < 0 { return Field::Defect(ty); }
  let user: i64 = crate::access::string_is(doc, ty, "user");
  if user < 0 { return Field::Defect(user); }
  if user == 0 { return Field::Missing; }
  return user_text(doc, k);
}

// The caller has already classified the entry as a user message.
pub fn user_text(doc: crate::json::JsonDocument, k: RootKeys) -> Field ! alloc
{
  let meta: i64 = true_of(doc, k.meta);
  if meta < 0 { return Field::Defect(meta); }
  if meta == 1 { return Field::Missing; }
  let side: i64 = true_of(doc, k.side);
  if side < 0 { return Field::Defect(side); }
  if side == 1 { return Field::Missing; }
  let msg: i64 = object_of(doc, k.message);
  if msg == -1 { return Field::Missing; }
  if msg < 0 { return Field::Defect(msg); }
  let c: i64 = crate::access::field(doc, msg, "content");
  if c == -1 || c == -2 { return Field::Missing; }
  if c < 0 { return Field::Defect(c); }
  let kc: i64 = crate::access::kind(doc, c);
  if kc < 0 { return Field::Defect(kc); }
  if kc == 4 { return string_content(doc, k.origin, c); }
  if kc == 5 { return array_content(doc, k.origin, c); }
  return Field::Missing;
}

// The held title (hand `RankedTitle { rank, text }`): `rank` 0 = none, `text` is one buffer reused across lines
// (4.4r, 4.4m-TB part two). Every write copies a whole `str`, so `text` stays valid UTF-8.
pub struct RankedTitle { rank: i64, text: [u8] }

pub fn new_title() -> RankedTitle ! alloc
  ensures result.rank == 0 && len(result.text) == 0
{
  let text: [u8] = alloc(0, 0);
  return RankedTitle { rank: 0, text: move text };
}

// The bytes of a nonblank string value at field id `i` (an `access::field` result or a `RootKeys` slot) replace `buf` (hand `pick`, then `text.clear(); push_str(t)`).
// 1 = written, 0 = missing or blank (`buf` unchanged), any other value = the defect kind (negative, or 18). The blank check runs on the borrowed view and
// only a nonblank candidate is copied (4.4n); an escaped node is decoded first (the hand's `Cow::Owned`, made while
// parsing).
fn title_key(doc: crate::json::JsonDocument, i: i64, inout buf: [u8]) -> i64 ! alloc
  requires crate::json::doc_strings(doc)
  requires utf8_valid_span(buf, 0, len(buf))
  ensures utf8_valid_span(buf, 0, len(buf))
{
  let pv: Option<ref str> = crate::access::plain_str(doc, i);
  match pv {
    Some(v) => {
      if crate::text::is_blank(v) { return 0; }
      buf = truncate(buf, 0);
      arr_append(inout buf, v, 0, len(v));
      return 1;
    }
    None => {}
  }
  let f: Field = string_field_of(doc, i);
  match f {
    Field::Value(v) => {
      if crate::text::is_blank(v) { return 0; }
      buf = truncate(buf, 0);
      arr_append(inout buf, v, 0, len(v));
      return 1;
    }
    Field::Missing => { return 0; }
    Field::Defect(e) => { if e == 0 || e == 1 { return -1; } return e; }
  }
}

// The first of the two keys whose value is a string with nonblank trim; its untrimmed bytes replace `buf`.
// Same codes as title_key.
pub fn pick_title(doc: crate::json::JsonDocument, id: i64, first: str, second: str, inout buf: [u8]) -> i64 ! alloc
  requires crate::json::doc_strings(doc)
  requires utf8_valid_span(buf, 0, len(buf))
  ensures utf8_valid_span(buf, 0, len(buf))
{
  let a: i64 = title_key(doc, crate::access::field(doc, id, first), inout buf);
  if a != 0 { return a; }
  return title_key(doc, crate::access::field(doc, id, second), inout buf);
}

// hand RankedTitle::update: a rank below the held one is dropped before its text is read (ties go to the later line).
// 1 = `st` now holds this line's title, 0 = unchanged, any other value = the defect kind.
// `first` / `second` are the two candidates' slots from `root_keys` (4.4s).
fn ranked(doc: crate::json::JsonDocument, level: i64, first: i64, second: i64, inout st: RankedTitle) -> i64 ! alloc
  requires 1 <= level && level <= 3
  requires crate::json::doc_strings(doc)
  requires 0 <= st.rank && st.rank <= 3 && utf8_valid_span(st.text, 0, len(st.text))
  ensures 0 <= st.rank && st.rank <= 3 && utf8_valid_span(st.text, 0, len(st.text))
  ensures old(st).rank <= st.rank
{
  if level < st.rank { return 0; }
  let mut f: i64 = title_key(doc, first, inout st.text);
  if f == 0 { f = title_key(doc, second, inout st.text); }
  if f == 1 { st.rank = level; }
  return f;
}

// claude.ts titleOf: custom-title (rank 3), ai-title (rank 2), summary (rank 1). The text is untrimmed and
// not passed through one_line here (tailInfo applies oneLine(text, 120) to the winner). `st.rank` is the rank held
// so far (0 = none); a lower-ranked candidate leaves `st` unchanged. Codes as `ranked`.
pub fn title_of(doc: crate::json::JsonDocument, inout st: RankedTitle) -> i64 ! alloc
  requires crate::json::doc_strings(doc)
  requires 0 <= st.rank && st.rank <= 3 && utf8_valid_span(st.text, 0, len(st.text))
  ensures 0 <= st.rank && st.rank <= 3 && utf8_valid_span(st.text, 0, len(st.text))
  ensures old(st).rank <= st.rank
{
  let k: RootKeys = root_keys(doc);
  return title_for_type(doc, string_of(doc, k.ty), k, inout st);
}

// `ty` is `string_of(doc, k.ty)`, read once by the caller.
pub fn title_for_type(doc: crate::json::JsonDocument, ty: i64, k: RootKeys, inout st: RankedTitle) -> i64 ! alloc
  requires crate::json::doc_strings(doc)
  requires 0 <= st.rank && st.rank <= 3 && utf8_valid_span(st.text, 0, len(st.text))
  ensures 0 <= st.rank && st.rank <= 3 && utf8_valid_span(st.text, 0, len(st.text))
  ensures old(st).rank <= st.rank
{
  if ty == -1 { return 0; }
  if ty < 0 { return ty; }
  // 4.4n-TT: hand `match get_str(e, "type")` borrows `type` once and matches it; an unescaped `type` is read once
  // through `plain_str` and its view compared. An escaped, non-string or corrupt node keeps the `string_is` checks.
  let pv: Option<ref str> = crate::access::plain_str(doc, ty);
  match pv {
    Some(t) => {
      if len(t) == 12 && eq_range(t, 0, "custom-title", 0, 12) { return ranked(doc, 3, k.custom, k.title, inout st); }
      if len(t) == 8 && eq_range(t, 0, "ai-title", 0, 8) { return ranked(doc, 2, k.ai, k.title, inout st); }
      if len(t) == 7 && eq_range(t, 0, "summary", 0, 7) { return ranked(doc, 1, k.summary, k.title, inout st); }
      return 0;
    }
    None => {}
  }
  let a: i64 = crate::access::string_is(doc, ty, "custom-title");
  if a < 0 { return a; }
  if a == 1 { return ranked(doc, 3, k.custom, k.title, inout st); }
  let b: i64 = crate::access::string_is(doc, ty, "ai-title");
  if b < 0 { return b; }
  if b == 1 { return ranked(doc, 2, k.ai, k.title, inout st); }
  let c: i64 = crate::access::string_is(doc, ty, "summary");
  if c < 0 { return c; }
  if c == 1 { return ranked(doc, 1, k.summary, k.title, inout st); }
  return 0;
}
