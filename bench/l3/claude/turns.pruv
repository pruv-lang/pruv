// L3-1 turn collector, hand `Collector` (VecDeque<Draft>) and `Draft` (handrust/src/lib.rs).
// drafts holds at most 200 drafts. Draft k (k counts begins from 0) lives at index k % 200: the vector grows by
// push while fewer than 200 drafts were begun, and afterwards the oldest draft, at the front index begun % 200,
// is reused in place for the next begin (hand: pop_front, clear, push_back). Each draft owns its prompt, reply,
// createdAt and completedAt bytes; completedAt is a separate field, so a later answer never moves it.

pub struct Plan { kept: i64, total: i64, bytes: i64 }

pub struct Draft { prompt: [u8], reply: [u8], used: i64, tools: i64, created: [u8], completed: [u8], clipped: bool }

pub struct Collector { drafts: Vec<Draft>, begun: i64, active: bool, lost: bool }

pub pred fn ok(c: Collector) -> bool {
  return 0 <= c.begun && c.begun <= 1000000000000 && len(c.drafts) <= 200 &&
    (c.begun <= 200 ==> len(c.drafts) == c.begun) && (c.begun > 200 ==> len(c.drafts) == 200) &&
    (c.active ==> c.begun >= 1) &&
    (forall i in 0..len(c.drafts): (
      len(c.drafts[i].prompt) <= 32768 &&
      0 <= c.drafts[i].used && len(c.drafts[i].reply) <= c.drafts[i].used && c.drafts[i].used <= 32768 &&
      0 <= c.drafts[i].tools && c.drafts[i].tools <= 1000000000000000 &&
      (len(c.drafts[i].created) == 0 || len(c.drafts[i].created) == 24) &&
      (len(c.drafts[i].completed) == 0 || len(c.drafts[i].completed) == 24)));
}

pub fn new_collector() -> Collector ! alloc
  ensures ok(result) && result.begun == 0 && !result.active && !result.lost
{
  return Collector { drafts: vec_new::<Draft>(), begun: 0, active: false, lost: false };
}

// The current draft's index (the newest begun one).
pub fn current(c: Collector) -> i64
  requires ok(c) && c.begun >= 1
  ensures 0 <= result && result < len(c.drafts) && result == (c.begun - 1) % 200
{
  return (c.begun - 1) % 200;
}

// b emptied, keeping its block where the backend can (hand: clear), then t[0..n) appended (hand: extend).
fn refill(take b: [u8], t: [u8], n: i64) -> [u8] ! alloc
  requires 0 <= n && n <= len(t) && n <= 32768
  ensures len(result) == n
{
  let mut x: [u8] = move b;
  x = truncate(x, 0);
  arr_append(inout x, t, 0, n);
  return move x;
}

// The prompt form of refill (str source).
fn refill_text(take b: [u8], t: str, n: i64) -> [u8] ! alloc
  requires 0 <= n && n <= len(t) && n <= 32768
  ensures len(result) == n
{
  let mut x: [u8] = move b;
  x = truncate(x, 0);
  arr_append(inout x, t, 0, n);
  return move x;
}

// begin: new current draft (evicting the oldest once 200 exist), prompt clipped to 32768 bytes (longest
// whole-scalar prefix), clipped set when the original exceeded the cap or lost was set, lost cleared,
// reply/budget/tools/completedAt reset, optional createdAt stored.
pub fn begin(inout c: Collector, prompt: str, created: [u8]) -> () ! alloc
  requires ok(c) && c.begun < 1000000000000
  requires len(prompt) <= 100000000
  requires len(created) == 0 || len(created) == 24
  ensures ok(c)
  ensures c.begun == old(c).begun + 1 && c.active && !c.lost
  ensures len(c.drafts[(c.begun - 1) % 200].prompt) <= len(prompt) && is_char_boundary(prompt, len(c.drafts[(c.begun - 1) % 200].prompt))
  ensures len(prompt) <= 32768 ==> len(c.drafts[(c.begun - 1) % 200].prompt) == len(prompt)
  ensures len(c.drafts[(c.begun - 1) % 200].prompt) == len(prompt) || (forall t in len(c.drafts[(c.begun - 1) % 200].prompt) + 1..32769: !is_char_boundary(prompt, t))
  ensures c.drafts[(c.begun - 1) % 200].clipped == (len(prompt) > 32768 || old(c).lost)
  ensures len(c.drafts[(c.begun - 1) % 200].reply) == 0 && c.drafts[(c.begun - 1) % 200].used == 0 && c.drafts[(c.begun - 1) % 200].tools == 0 && len(c.drafts[(c.begun - 1) % 200].completed) == 0
  ensures len(c.drafts[(c.begun - 1) % 200].created) == len(created)
{
  let n: i64 = crate::text::clip_len(prompt, 32768);
  let cl: bool = len(prompt) > 32768 || c.lost;
  if len(c.drafts) < 200 {
    let p0: [u8] = alloc(0, 0);
    let p: [u8] = refill_text(move p0, prompt, n);
    let t0: [u8] = alloc(0, 0);
    let t: [u8] = refill(move t0, created, len(created));
    let r: [u8] = alloc(0, 0);
    let q: [u8] = alloc(0, 0);
    c.drafts = vec_push::<Draft>(move c.drafts, Draft { prompt: move p, reply: move r, used: 0, tools: 0, created: move t, completed: move q, clipped: cl });
  } else {
    let w: i64 = c.begun % 200;
    let m: i64 = len(created);
    match vec_at_mut::<Draft>(inout c.drafts, w) {
      Some(d) => {
        let p: [u8] = move d.prompt;
        d.prompt = refill_text(move p, prompt, n);
        let r: [u8] = move d.reply;
        d.reply = refill(move r, created, 0);
        let t: [u8] = move d.created;
        d.created = refill(move t, created, m);
        let q: [u8] = move d.completed;
        d.completed = refill(move q, created, 0);
        d.used = 0;
        d.tools = 0;
        d.clipped = cl;
      }
      None => {}
    }
  }
  c.begun = c.begun + 1;
  c.active = true;
  c.lost = false;
}

// skip_user: detach the current draft (it stays in drafts) and mark the next one clipped.
pub fn skip_user(inout c: Collector) -> ()
  requires ok(c)
  ensures ok(c) && c.begun == old(c).begun && !c.active && c.lost
{
  c.active = false;
  c.lost = true;
}

// tool: one increment of the current draft's tool count (saturating); no timestamp update; nothing without a
// current draft.
pub fn tool(inout c: Collector) -> ()
  requires ok(c)
  ensures ok(c) && c.begun == old(c).begun && c.active == old(c).active && c.lost == old(c).lost
  ensures len(c.drafts) == len(old(c).drafts)
  ensures (c.active && old(c).drafts[(c.begun - 1) % 200].tools < 1000000000000000) ==>
    c.drafts[(c.begun - 1) % 200].tools == old(c).drafts[(c.begun - 1) % 200].tools + 1
{
  if !c.active { return; }
  let k: i64 = (c.begun - 1) % 200;
  match vec_at_mut::<Draft>(inout c.drafts, k) {
    Some(d) => {
      if d.tools < 1000000000000000 { d.tools = d.tools + 1; }
    }
    None => {}
  }
}

// answer: no current draft => nothing. Otherwise completedAt is updated first (even for empty text or a full
// reply); empty text or budget >= 32768 stops there; else the piece text (empty reply) or "\n\n"+text is appended
// when it fits the remaining budget, else its longest whole-scalar prefix is appended, the budget counter
// saturates at 32768 and clipped is set. The counter is separate from the actual reply length (a multibyte cut
// leaves unused bytes that later calls must not fill).
pub fn answer(inout c: Collector, text: str, at: [u8]) -> () ! alloc
  requires ok(c)
  requires len(text) <= 100000000
  requires len(at) == 0 || len(at) == 24
  ensures ok(c) && c.begun == old(c).begun && c.active == old(c).active && c.lost == old(c).lost
  ensures len(c.drafts) == len(old(c).drafts)
  ensures (c.active && len(at) == 24) ==> len(c.drafts[(c.begun - 1) % 200].completed) == 24
  ensures (c.active && len(text) > 0 && len(old(c).drafts[(c.begun - 1) % 200].reply) > 0 &&
    len(text) + 2 <= 32768 - old(c).drafts[(c.begun - 1) % 200].used) ==>
    len(c.drafts[(c.begun - 1) % 200].reply) == len(old(c).drafts[(c.begun - 1) % 200].reply) + 2 + len(text)
{
  if !c.active { return; }
  let k: i64 = (c.begun - 1) % 200;
  let m: i64 = len(at);
  match vec_at_mut::<Draft>(inout c.drafts, k) {
    Some(d) => {
      if m == 24 {
        let q: [u8] = move d.completed;
        d.completed = refill(move q, at, 24);
      }
      if len(text) == 0 || d.used >= 32768 { return; }
      let mut sep: i64 = 0;
      if len(d.reply) > 0 { sep = 2; }
      let room: i64 = 32768 - d.used;
      if sep + len(text) <= room {
        arr_append(inout d.reply, "\n\n", 0, sep);
        arr_append(inout d.reply, text, 0, len(text));
        d.used = d.used + sep + len(text);
      } else {
        if room <= sep {
          arr_append(inout d.reply, "\n\n", 0, room);
        } else {
          let cut: i64 = crate::text::clip_len(text, room - sep);
          arr_append(inout d.reply, "\n\n", 0, sep);
          arr_append(inout d.reply, text, 0, cut);
        }
        d.used = 32768;
        d.clipped = true;
      }
    }
    None => {}
  }
}

// Count the newest kept turns, counting only prompt and reply bytes toward the trim cap (hand
// Collector::kept). bytes is the text those turns take, used only to reserve the text buffer.
pub fn plan(c: Collector) -> Plan
  requires ok(c)
  ensures 0 <= result.kept && result.kept <= 200 && result.kept <= c.begun
  ensures 0 <= result.total && result.total <= 2097152
  ensures result.total == sum(j in 0..result.kept: len(c.drafts[(c.begun - 1 - j) % 200].prompt) + len(c.drafts[(c.begun - 1 - j) % 200].reply))
  ensures (result.kept < c.begun && result.kept < 200) ==>
    result.total + len(c.drafts[(c.begun - 1 - result.kept) % 200].prompt) + len(c.drafts[(c.begun - 1 - result.kept) % 200].reply) > 2097152
  ensures 0 <= result.bytes && result.bytes <= 2106752
{
  let b: i64 = c.begun;
  let mut avail: i64 = b;
  if avail > 200 { avail = 200; }
  let mut i: i64 = 0;
  let mut total: i64 = 0;
  let mut bytes: i64 = 0;
  while i < avail
    invariant 0 <= i && i <= avail && avail <= 200 && avail <= b && 0 <= b && b <= 1000000000000
    invariant (b <= 200 && avail == b) || (b > 200 && avail == 200)
    invariant c.begun == b && ok(c)
    invariant 0 <= total && total <= 2097152
    invariant total == sum(j in 0..i: len(c.drafts[(b - 1 - j) % 200].prompt) + len(c.drafts[(b - 1 - j) % 200].reply))
    invariant 0 <= bytes && bytes <= total + 48 * i
    decreases avail - i
  {
    let w: i64 = (b - 1 - i) % 200;
    let size: i64 = len(vec_get::<Draft>(c.drafts, w).prompt) + len(vec_get::<Draft>(c.drafts, w).reply);
    if total + size > 2097152 {
      return Plan { kept: i, total: total, bytes: bytes };
    }
    bytes = bytes + size + len(vec_get::<Draft>(c.drafts, w).created) + len(vec_get::<Draft>(c.drafts, w).completed);
    total = total + size;
    i = i + 1;
  }
  return Plan { kept: i, total: total, bytes: bytes };
}

// Append the kept records to turns and their text to text, oldest first (hand window_packet loop
// over put). Each text ref is shift + its offset in text; the A3 fixture passes the omitted prefix.
pub fn put_turns(inout turns: [i64], inout text: [u8], shift: i64, c: Collector, kept: i64) -> () ! alloc
  requires ok(c)
  requires 0 <= kept && kept <= 200 && kept <= c.begun
  requires 0 <= shift && shift <= 3500000 && len(turns) <= 2000 && len(text) <= 10000000
  ensures len(turns) == len(old(turns)) + 10 * kept
  ensures len(old(text)) <= len(text) && len(text) <= len(old(text)) + 65584 * kept
{
  let b: i64 = c.begun;
  let t0: i64 = len(turns);
  let x0: i64 = len(text);
  let mut left: i64 = kept;
  while left > 0
    invariant 0 <= left && left <= kept && 0 <= kept && kept <= 200 && kept <= b && b <= 1000000000000
    invariant ok(c) && b == c.begun
    invariant 0 <= shift && shift <= 3500000 && 0 <= t0 && t0 <= 2000 && 0 <= x0 && x0 <= 10000000
    invariant len(turns) == t0 + 10 * (kept - left)
    invariant x0 <= len(text) && len(text) <= x0 + 65584 * (kept - left)
    decreases left
  {
    let j: i64 = left - 1;
    let w: i64 = (b - 1 - j) % 200;
    let plen: i64 = len(vec_get::<Draft>(c.drafts, w).prompt);
    let rlen: i64 = len(vec_get::<Draft>(c.drafts, w).reply);
    let cn: i64 = len(vec_get::<Draft>(c.drafts, w).created);
    let dn: i64 = len(vec_get::<Draft>(c.drafts, w).completed);
    let at: i64 = shift + len(text);
    arr_append(inout text, vec_get::<Draft>(c.drafts, w).prompt, 0, plen);
    arr_append(inout text, vec_get::<Draft>(c.drafts, w).reply, 0, rlen);
    arr_append(inout text, vec_get::<Draft>(c.drafts, w).created, 0, cn);
    arr_append(inout text, vec_get::<Draft>(c.drafts, w).completed, 0, dn);
    let mut ca: i64 = -1;
    if cn > 0 { ca = at + plen + rlen; }
    let mut da: i64 = -1;
    if dn > 0 { da = at + plen + rlen + cn; }
    let mut cl: i64 = 0;
    if vec_get::<Draft>(c.drafts, w).clipped { cl = 1; }
    arr_push(inout turns, at, plen, at + plen, rlen, ca, cn, da, dn, vec_get::<Draft>(c.drafts, w).tools, cl);
    left = j;
  }
}
