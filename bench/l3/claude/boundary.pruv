// L3-1 A0: import limits, flat output records, the publication check and the plain-array packet.
// Constants are nullary functions (no `const`); contracts repeat their values as literals.
// Output layout (docs/CLAUDE_IMPORT_SPEC.md): meta has 14 slots, each turn 10 slots, strings are (start,len)
// refs into text, absent is (-1,0).

pub fn limit_edge_bytes() -> i64 ensures result == 65536 { return 65536; }
pub fn limit_window_bytes() -> i64 ensures result == 8388608 { return 8388608; }
pub fn limit_line_bytes() -> i64 ensures result == 1048576 { return 1048576; }
pub fn limit_drop_head() -> i64 ensures result == 8192 { return 8192; }
pub fn limit_turns() -> i64 ensures result == 200 { return 200; }
pub fn limit_prompt_bytes() -> i64 ensures result == 32768 { return 32768; }
pub fn limit_reply_bytes() -> i64 ensures result == 32768 { return 32768; }
pub fn limit_total_bytes() -> i64 ensures result == 2097152 { return 2097152; }
pub fn limit_output_bytes() -> i64 ensures result == 5646080 { return 5646080; }
pub fn timestamp_bytes() -> i64 ensures result == 24 { return 24; }
pub fn schema_version() -> i64 ensures result == 1 { return 1; }
pub fn meta_len() -> i64 ensures result == 14 { return 14; }
pub fn turn_width() -> i64 ensures result == 10 { return 10; }
pub fn mode_head() -> i64 ensures result == 0 { return 0; }
pub fn mode_tail() -> i64 ensures result == 1 { return 1; }
pub fn mode_window() -> i64 ensures result == 2 { return 2; }
pub fn code_input_too_large() -> i64 ensures result == 1 { return 1; }
pub fn code_internal_invariant() -> i64 ensures result == 2 { return 2; }

// A ref (s,l) is absent (-1,0) or present inside a text of n bytes.
fn ref_ok(s: i64, l: i64, n: i64) -> bool
  requires 0 <= n
  ensures result ==> ((s == -1 && l == 0) || (0 <= s && s <= n && 0 <= l && l <= n - s))
{
  if s == -1 { return l == 0; }
  if s < 0 || s > n { return false; }
  if l < 0 || l > n - s { return false; }
  return true;
}

// Per-turn record facts of turn i (everything except the cross-turn total and the tiling).
fn turn_ok(packet: [i64], n: i64, i: i64) -> bool
  requires 0 <= i && 18 + 10 * i + 10 <= len(packet) && 0 <= n && n <= 5646080
  ensures result ==> (0 <= packet[18 + 10 * i] && packet[18 + 10 * i] <= n && 0 <= packet[18 + 10 * i + 1] && packet[18 + 10 * i + 1] <= 32768 && packet[18 + 10 * i] + packet[18 + 10 * i + 1] <= n && 0 <= packet[18 + 10 * i + 2] && packet[18 + 10 * i + 2] <= n && 0 <= packet[18 + 10 * i + 3] && packet[18 + 10 * i + 3] <= 32768 && packet[18 + 10 * i + 2] + packet[18 + 10 * i + 3] <= n && packet[18 + 10 * i + 8] >= 0 && (packet[18 + 10 * i + 9] == 0 || packet[18 + 10 * i + 9] == 1))
  ensures result ==> ((packet[18 + 10 * i + 5] == 0 || packet[18 + 10 * i + 5] == 24) && (packet[18 + 10 * i + 7] == 0 || packet[18 + 10 * i + 7] == 24))
  ensures result ==> (((packet[18 + 10 * i + 4] == -1 && packet[18 + 10 * i + 5] == 0) || (0 <= packet[18 + 10 * i + 4] && packet[18 + 10 * i + 4] <= n && 0 <= packet[18 + 10 * i + 5] && packet[18 + 10 * i + 5] <= n - packet[18 + 10 * i + 4])) && ((packet[18 + 10 * i + 6] == -1 && packet[18 + 10 * i + 7] == 0) || (0 <= packet[18 + 10 * i + 6] && packet[18 + 10 * i + 6] <= n && 0 <= packet[18 + 10 * i + 7] && packet[18 + 10 * i + 7] <= n - packet[18 + 10 * i + 6])))
{
  let b: i64 = 18 + 10 * i;
  if packet[b] < 0 || packet[b] > n { return false; }
  if packet[b + 1] < 0 || packet[b + 1] > 32768 || packet[b + 1] > n - packet[b] { return false; }
  if packet[b + 2] < 0 || packet[b + 2] > n { return false; }
  if packet[b + 3] < 0 || packet[b + 3] > 32768 || packet[b + 3] > n - packet[b + 2] { return false; }
  if !ref_ok(packet[b + 4], packet[b + 5], n) { return false; }
  if !ref_ok(packet[b + 6], packet[b + 7], n) { return false; }
  if packet[b + 4] != -1 && packet[b + 5] != 24 { return false; }
  if packet[b + 6] != -1 && packet[b + 7] != 24 { return false; }
  if packet[b + 8] < 0 { return false; }
  if packet[b + 9] != 0 && packet[b + 9] != 1 { return false; }
  return true;
}

// Every turn is well formed and the actual prompt+reply total stays within 2097152.
fn turns_ok(packet: [i64], n: i64, m: i64) -> bool
  requires 0 <= m && m <= 200 && 18 + 10 * m <= len(packet) && 0 <= n && n <= 5646080
  ensures result ==> (forall i in 0..m: (0 <= packet[18 + 10 * i] && packet[18 + 10 * i] <= n && 0 <= packet[18 + 10 * i + 1] && packet[18 + 10 * i + 1] <= 32768 && packet[18 + 10 * i] + packet[18 + 10 * i + 1] <= n && 0 <= packet[18 + 10 * i + 2] && packet[18 + 10 * i + 2] <= n && 0 <= packet[18 + 10 * i + 3] && packet[18 + 10 * i + 3] <= 32768 && packet[18 + 10 * i + 2] + packet[18 + 10 * i + 3] <= n && packet[18 + 10 * i + 8] >= 0 && (packet[18 + 10 * i + 9] == 0 || packet[18 + 10 * i + 9] == 1)))
  ensures result ==> (forall i in 0..m: ((packet[18 + 10 * i + 5] == 0 || packet[18 + 10 * i + 5] == 24) && (packet[18 + 10 * i + 7] == 0 || packet[18 + 10 * i + 7] == 24)))
  ensures result ==> (forall i in 0..m: (((packet[18 + 10 * i + 4] == -1 && packet[18 + 10 * i + 5] == 0) || (0 <= packet[18 + 10 * i + 4] && packet[18 + 10 * i + 4] <= n && 0 <= packet[18 + 10 * i + 5] && packet[18 + 10 * i + 5] <= n - packet[18 + 10 * i + 4])) && ((packet[18 + 10 * i + 6] == -1 && packet[18 + 10 * i + 7] == 0) || (0 <= packet[18 + 10 * i + 6] && packet[18 + 10 * i + 6] <= n && 0 <= packet[18 + 10 * i + 7] && packet[18 + 10 * i + 7] <= n - packet[18 + 10 * i + 6]))))
  ensures result ==> sum(i in 0..m: packet[18 + 10 * i + 1] + packet[18 + 10 * i + 3]) <= 2097152
{
  let mut i: i64 = 0;
  let mut total: i64 = 0;
  while i < m
    invariant 0 <= i && i <= m && 0 <= m && m <= 200 && 18 + 10 * m <= len(packet) && 0 <= n && n <= 5646080
    invariant 0 <= total && total <= 2097152
    invariant forall t in 0..i: (0 <= packet[18 + 10 * t] && packet[18 + 10 * t] <= n && 0 <= packet[18 + 10 * t + 1] && packet[18 + 10 * t + 1] <= 32768 && packet[18 + 10 * t] + packet[18 + 10 * t + 1] <= n && 0 <= packet[18 + 10 * t + 2] && packet[18 + 10 * t + 2] <= n && 0 <= packet[18 + 10 * t + 3] && packet[18 + 10 * t + 3] <= 32768 && packet[18 + 10 * t + 2] + packet[18 + 10 * t + 3] <= n && packet[18 + 10 * t + 8] >= 0 && (packet[18 + 10 * t + 9] == 0 || packet[18 + 10 * t + 9] == 1))
    invariant forall t in 0..i: ((packet[18 + 10 * t + 5] == 0 || packet[18 + 10 * t + 5] == 24) && (packet[18 + 10 * t + 7] == 0 || packet[18 + 10 * t + 7] == 24))
    invariant forall t in 0..i: (((packet[18 + 10 * t + 4] == -1 && packet[18 + 10 * t + 5] == 0) || (0 <= packet[18 + 10 * t + 4] && packet[18 + 10 * t + 4] <= n && 0 <= packet[18 + 10 * t + 5] && packet[18 + 10 * t + 5] <= n - packet[18 + 10 * t + 4])) && ((packet[18 + 10 * t + 6] == -1 && packet[18 + 10 * t + 7] == 0) || (0 <= packet[18 + 10 * t + 6] && packet[18 + 10 * t + 6] <= n && 0 <= packet[18 + 10 * t + 7] && packet[18 + 10 * t + 7] <= n - packet[18 + 10 * t + 6])))
    invariant total == sum(t in 0..i: packet[18 + 10 * t + 1] + packet[18 + 10 * t + 3])
    decreases m - i
  {
    if !turn_ok(packet, n, i) { return false; }
    let sum: i64 = total + packet[18 + 10 * i + 1] + packet[18 + 10 * i + 3];
    if sum > 2097152 { return false; }
    total = sum;
    i = i + 1;
  }
  return true;
}

// Advance the tiling cursor over one ref: -1 when a present ref does not start at the cursor.
fn take(s: i64, l: i64, cur: i64) -> i64
  requires 0 <= cur
  ensures result >= -1
{
  if s == -1 {
    if l == 0 { return cur; }
    return -1;
  }
  if s != cur || l < 0 { return -1; }
  if l > 9223372036854775807 - cur { return -1; }
  return cur + l;
}

// Runtime-only rule: present refs, in packing order, tile text exactly.
fn tiled(packet: [i64], n: i64, m: i64) -> bool
  requires 0 <= m && m <= 200 && 18 + 10 * m <= len(packet) && 0 <= n
{
  let mut cur: i64 = take(packet[8], packet[9], 0);
  if cur < 0 { return false; }
  cur = take(packet[10], packet[11], cur);
  if cur < 0 { return false; }
  cur = take(packet[12], packet[13], cur);
  if cur < 0 { return false; }
  cur = take(packet[14], packet[15], cur);
  if cur < 0 { return false; }
  cur = take(packet[16], packet[17], cur);
  if cur < 0 { return false; }
  let mut i: i64 = 0;
  while i < m
    invariant 0 <= i && i <= m && 0 <= cur && 0 <= m && m <= 200 && 18 + 10 * m <= len(packet)
    decreases m - i
  {
    cur = take(packet[18 + 10 * i], packet[18 + 10 * i + 1], cur);
    if cur < 0 { return false; }
    cur = take(packet[18 + 10 * i + 2], packet[18 + 10 * i + 3], cur);
    if cur < 0 { return false; }
    cur = take(packet[18 + 10 * i + 4], packet[18 + 10 * i + 5], cur);
    if cur < 0 { return false; }
    cur = take(packet[18 + 10 * i + 6], packet[18 + 10 * i + 7], cur);
    if cur < 0 { return false; }
    i = i + 1;
  }
  return cur == n;
}

pub fn check_output(packet: [i64], nt: i64, n: i64) -> bool
  requires 0 <= nt && 0 <= n && n <= 5646080 && len(packet) == 18 + nt + n
{
  if packet[4] != 1 { return false; }
  let mode: i64 = packet[5];
  if mode < 0 || mode > 2 { return false; }
  if packet[6] != 0 && packet[6] != 1 { return false; }
  if mode != 2 && packet[6] != 0 { return false; }
  let m: i64 = packet[7];
  if m < 0 || m > 200 { return false; }
  if mode != 2 && m != 0 { return false; }
  if nt != 10 * m { return false; }
  // title: any mode
  if !ref_ok(packet[8], packet[9], n) { return false; }
  // cwd and entrypoint: head only
  if !ref_ok(packet[10], packet[11], n) { return false; }
  if mode != 0 && packet[10] != -1 { return false; }
  if !ref_ok(packet[12], packet[13], n) { return false; }
  if mode != 0 && packet[12] != -1 { return false; }
  // lastAt: tail only, exactly 24 bytes when present
  if !ref_ok(packet[14], packet[15], n) { return false; }
  if mode != 1 && packet[14] != -1 { return false; }
  if packet[14] != -1 && packet[15] != 24 { return false; }
  // model: window only
  if !ref_ok(packet[16], packet[17], n) { return false; }
  if mode != 2 && packet[16] != -1 { return false; }
  if !turns_ok(packet, n, m) { return false; }
  if !tiled(packet, n, m) { return false; }
  return true;
}

// Allocate the exact packet and initialize its header and absent metadata refs.
pub fn new_packet(mode: i64, nt: i64, nx: i64) -> [i64] ! alloc
  requires 0 <= nt && nt <= 2000 && 0 <= nx && nx <= 5646080
  ensures len(result) == 18 + nt + nx
{
  let mut out: [i64] = alloc(18 + nt + nx, 0);
  out[1] = 14;
  out[2] = nt;
  out[3] = nx;
  out[4] = 1;
  out[5] = mode;
  out[8] = -1;
  out[10] = -1;
  out[12] = -1;
  out[14] = -1;
  out[16] = -1;
  return out;
}

// Widen only while writing bytes into the final packet.
pub fn write_bytes(inout out: [i64], at: i64, src: [u8], lo: i64, n: i64) -> ()
  requires 0 <= lo && lo <= len(src) && 0 <= n && n <= len(src) - lo
  requires 0 <= at && at <= len(out) && n <= len(out) - at
  ensures len(out) == len(old(out))
  ensures forall k in 0..n: out[at + k] == src[lo + k]
  ensures forall k in 0..len(out): (k < at || k >= at + n) ==> out[k] == old(out)[k]
{
  let mut k: i64 = 0;
  while k < n
    invariant 0 <= k && k <= n && 0 <= lo && n <= len(src) - lo && 0 <= at && n <= len(out) - at && len(out) == len(old(out))
    invariant forall j in 0..k: out[at + j] == src[lo + j]
    invariant forall j in 0..len(out): (j < at || j >= at + k) ==> out[j] == old(out)[j]
    decreases n - k
  { out[at + k] = src[lo + k]; k = k + 1; }
}

pub fn pair(a: i64, b: i64) -> [i64] ! alloc
  ensures len(result) == 2 && result[0] == a && result[1] == b
{
  let mut out: [i64] = alloc(2, 0);
  out[0] = a; out[1] = b;
  return out;
}

// Copy src[lo..hi] into dst at `at`; everything else in dst is unchanged.
pub fn copy_span(inout dst: [u8], at: i64, src: [u8], lo: i64, hi: i64) -> ()
  requires 0 <= lo && lo <= hi && hi <= len(src)
  requires 0 <= at && at <= len(dst) && hi - lo <= len(dst) - at
  ensures len(dst) == len(old(dst))
  ensures forall k in 0..hi - lo: dst[at + k] == src[lo + k]
  ensures forall k in 0..len(dst): ((k < at || k >= at + (hi - lo)) ==> dst[k] == old(dst)[k])
{
  let n: i64 = hi - lo;
  let mut j: i64 = 0;
  while j < n
    invariant 0 <= j && j <= n && n == hi - lo && 0 <= lo && hi <= len(src) && 0 <= at && at <= len(dst) && n <= len(dst) - at && len(dst) == len(old(dst))
    invariant forall k in 0..j: dst[at + k] == src[lo + k]
    invariant forall k in 0..len(dst): ((k < at || k >= at + j) ==> dst[k] == old(dst)[k])
    decreases n - j
  { dst[at + j] = src[lo + j]; j = j + 1; }
}
