// Qwen currentChain. Entry-ordinal marks avoid retaining parsed JSON documents.
// R05 B: one parse per line. scan decodes each uuid and parentUuid once into a byte arena; the chain walk compares
// arena bytes and never re-parses a line. Newest-first hash buckets; exact UUID comparison resolves collisions.
// Slot layout, 6 per uuid entry: Entry frame ordinal, next slot (newest-first), uuid offset, uuid length,
// parent offset, parent length (-1 missing, -2 parentUuid defect: bad only when the entry matches a key).
// DB6: a mixed 64-bit hash (8-byte words, splitmix64 finalizer) masked into a power-of-two table. The old
// h * 257 % size hash let a crafted file put every uuid in 8 buckets (D-R05-1). The hash is fixed, not keyed (G-DB6-1).
fn bucket(arena: [u8], off: i64, n: i64, mask: i64) -> i64
  requires 0 <= mask
  requires 0 <= off && 0 <= n && off + n <= len(arena)
  ensures 0 <= result && result <= mask
{
  let mut h: i64 = bxor(-7046029254386353131, n);
  let mut i: i64 = 0;
  while i + 8 <= n
    invariant 0 <= i && i <= n && off + n <= len(arena) && 0 <= off
    decreases n - i
  {
    h = wrapping_mul(bxor(h, load_le(arena, off + i, 8)), -4658895280553007687);
    h = bxor(h, ushr(h, 31));
    i = i + 8;
  }
  while i < n
    invariant 0 <= i && i <= n && off + n <= len(arena) && 0 <= off
    decreases n - i
  {
    h = wrapping_mul(bxor(h, arena[off + i]), -7046029254386353131);
    i = i + 1;
  }
  h = wrapping_mul(bxor(h, ushr(h, 30)), -4658895280553007687);
  h = wrapping_mul(bxor(h, ushr(h, 27)), -7723592293110705685);
  h = bxor(h, ushr(h, 31));
  return band(h, mask);
}

fn put(inout arena: [u8], at: i64, s: str) -> ()
  requires 0 <= at && at <= len(arena) && len(s) <= len(arena) - at
  ensures len(arena) == len(old(arena))
{
  let n: i64 = len(s);
  let mut j: i64 = 0;
  while j < n
    invariant 0 <= j && j <= n && n == len(s) && 0 <= at && at <= len(arena) && n <= len(arena) - at && len(arena) == len(old(arena))
    decreases n - j
  {
    let b: i64 = s[j];
    arena[at + j] = b;
    j = j + 1;
  }
}

// DB23 (G-R05-5): string_field's outcome for doc[id].key written straight into arena[at..], with no copy into a
// fresh str. Result: decoded length >= 0 (written), -1 Missing, -2 Defect (string_field's Field::Defect), -3 no room.
fn put_field(doc: crate::json::JsonDocument, id: i64, key: str, inout arena: [u8], at: i64) -> i64 ! alloc
  requires 0 <= at && at <= len(arena)
  ensures len(arena) == len(old(arena))
  ensures result >= -3 && (result >= 0 ==> result <= len(arena) - at)
{
  let f: i64 = crate::access::field(doc, id, key);
  if f == -1 || f == -2 { return -1; }
  if f < 0 { return -2; }
  let k: i64 = crate::access::kind(doc, f);
  if k < 0 { return -2; }
  if k != 4 { return -1; }
  let t: crate::jstr::Text = crate::access::string_text(doc, f);
  match t {
    crate::jstr::Text::InternalInvariant(e) => { return -2; }
    crate::jstr::Text::Decoded(v) => {
      if len(v) > 50331648 { return -2; }
      if len(v) > len(arena) - at { return -3; }
      put(inout arena, at, v);
      return len(v);
    }
  }
}

// Same bytes at two arena spans.
fn same_span(arena: [u8], a: i64, an: i64, b: i64, bn: i64) -> bool
  requires 0 <= a && 0 <= an && a + an <= len(arena) && 0 <= b && 0 <= bn && b + bn <= len(arena)
{
  if an != bn { return false; }
  let mut i: i64 = 0;
  while i < an
    invariant 0 <= i && i <= an && an == bn && a + an <= len(arena) && b + bn <= len(arena) && 0 <= a && 0 <= b
    decreases an - i
  {
    if arena[a + i] != arena[b + i] { return false; }
    i = i + 1;
  }
  return true;
}

// leaf: slot of the leaf entry, or -1.
pub struct Found { leaf: i64, found: bool, bad: bool }
pub fn scan(data: [u8], cut: bool, inout arena: [u8], inout heads: [i64], inout slots: [i64]) -> Found ! alloc
  requires len(data) <= 8388608 && len(arena) == len(data)
  requires 0 < len(heads) && len(heads) <= 33554436 && len(slots) <= 50331654
  ensures len(arena) == len(old(arena))
  ensures len(heads) == len(old(heads)) && len(slots) == len(old(slots))
{
  let mut leaf: i64 = -1;
  let mut found: bool = false;
  let mut role_seen: bool = false;
  let mut used: i64 = 0;
  let mut aused: i64 = 0;
  let mut ord: i64 = 0;
  // DB23: one parse scratch for the whole scan (tape 4096 records, stack 516).
  let mut tape: [i64] = alloc(24576, 0);
  let mut stack: [i64] = alloc(516, 0);
  let mut off: i64 = crate::framing::skip_first(data, cut);
  while off < len(data)
    invariant 0 <= off && off <= len(data) && len(data) <= 8388608 && len(arena) == len(data)
    invariant 0 <= used && used <= len(slots) && len(slots) <= 50331654
    invariant 0 <= aused && aused <= len(arena)
    invariant 0 < len(heads) && len(heads) <= 33554436 && 0 <= ord && ord <= off
    decreases len(data) - off
  {
    let step: crate::framing::Frame = crate::framing::window_next(data, off);
    match step {
      crate::framing::Frame::Entry(s, e, n) => {
        if s < 0 || s >= len(data) || e < s || e > len(data) || n <= off || n > len(data) { return Found { leaf: -1, found: false, bad: true }; }
        let line: crate::entry::Line = crate::entry::parse_line_span(data, s, e, inout tape, inout stack);
        match line {
          crate::entry::Line::Object(d) => {
            // DB23: uuid decoded straight into the arena (no string_field copy); a zero-length uuid adds no slot.
            let ul: i64 = put_field(d, 0, "uuid", inout arena, aused);
            if ul == -2 || ul == -3 { return Found { leaf: -1, found: false, bad: true }; }
            if ul > 0 {
              // DB6: one "type" key lookup, then three literal compares on that value.
              let ty: i64 = crate::entry::string_id(d, 0, "type");
              let role: bool = ty >= 0 && (crate::access::string_is(d, ty, "user") == 1 || crate::access::string_is(d, ty, "assistant") == 1 || crate::access::string_is(d, ty, "tool_result") == 1);
              if used + 6 > len(slots) { return Found { leaf: -1, found: false, bad: true }; }
              let uo: i64 = aused;
              aused = aused + ul;
              let po: i64 = aused;
              let pl: i64 = put_field(d, 0, "parentUuid", inout arena, aused);
              if pl == -3 { return Found { leaf: -1, found: false, bad: true }; }
              if pl >= 0 { aused = aused + pl; }
              let b: i64 = bucket(arena, uo, ul, len(heads) - 1);
              slots[used] = ord;
              slots[used + 1] = heads[b];
              slots[used + 2] = uo;
              slots[used + 3] = ul;
              slots[used + 4] = po;
              slots[used + 5] = pl;
              heads[b] = used;
              if role || !role_seen {
                // A leaf candidate reads its parent strictly.
                if pl == -2 { return Found { leaf: -1, found: false, bad: true }; }
                found = true;
                leaf = used;
              }
              used = used + 6;
              if role { role_seen = true; }
            }
          }
          crate::entry::Line::Skip => { found = found; }
          crate::entry::Line::Defect(k) => { return Found { leaf: -1, found: false, bad: true }; }
        }
        ord = ord + 1;
        off = n;
      }
      crate::framing::Frame::Dropped(s, e, n) => { if n <= off || n > len(data) { return Found { leaf: -1, found: false, bad: true }; } off = n; }
      crate::framing::Frame::Done => { off = len(data); }
    }
  }
  return Found { leaf: leaf, found: found, bad: false };
}

// First match supplies the last-write parent; mark all duplicates.
// Existing marks detect cycles without copying or comparing the whole bitmap.
pub struct Hit { poff: i64, plen: i64, found: bool, changed: bool, bad: bool }
fn lookup(arena: [u8], koff: i64, klen: i64, heads: [i64], slots: [i64], inout marks: [u8]) -> Hit
  requires 0 <= koff && 0 <= klen && koff + klen <= len(arena)
  requires 0 < len(heads) && len(heads) <= 33554436 && len(slots) <= 50331654
  ensures len(marks) == len(old(marks))
{
  let mut at: i64 = heads[bucket(arena, koff, klen, len(heads) - 1)];
  let mut left: i64 = len(slots);
  let mut found: bool = false;
  let mut changed: bool = false;
  let mut poff: i64 = 0;
  let mut plen: i64 = 0;
  while at >= 0 && left > 0
    invariant 0 <= left && left <= len(slots) && len(slots) <= 50331654
    invariant len(marks) == len(old(marks))
    decreases left
  {
    if at > len(slots) - 6 { return Hit { poff: 0, plen: 0, found: false, changed: false, bad: true }; }
    let s: i64 = slots[at];
    let uo: i64 = slots[at + 2];
    let ul: i64 = slots[at + 3];
    if s < 0 || s >= len(marks) || uo < 0 || ul < 0 || ul > len(arena) - uo { return Hit { poff: 0, plen: 0, found: false, changed: false, bad: true }; }
    if same_span(arena, uo, ul, koff, klen) {
      if marks[s] == 0 { changed = true; }
      marks[s] = 1;
      let pl: i64 = slots[at + 5];
      if pl == -2 { return Hit { poff: 0, plen: 0, found: false, changed: false, bad: true }; }
      if !found && pl >= 0 { poff = slots[at + 4]; plen = pl; }
      found = true;
    }
    let next: i64 = slots[at + 1];
    if next >= at { return Hit { poff: 0, plen: 0, found: false, changed: false, bad: true }; }
    at = next;
    left = left - 1;
  }
  return Hit { poff: poff, plen: plen, found: found, changed: changed, bad: false };
}

// One frame per newline, plus a possible unterminated final line: an upper bound on Entry frames.
pub fn capacity(data: [u8]) -> i64
  requires len(data) <= 8388608
  ensures 1 <= result && result <= len(data) + 1
{
  let mut c: i64 = 1;
  let mut i: i64 = 0;
  while i < len(data)
    invariant 0 <= i && i <= len(data) && len(data) <= 8388608
    invariant 1 <= c && c <= i + 1
    decreases len(data) - i
  {
    if data[i] == 10 { c = c + 1; }
    i = i + 1;
  }
  return c;
}

// marks is caller-owned, zero, one byte per Entry frame ordinal (DB6: was one per input byte).
pub struct Chain { active: bool, cut: bool, bad: bool }
pub fn select(data: [u8], cut: bool, inout marks: [u8]) -> Chain ! alloc
  requires len(data) <= 8388608 && 1 <= len(marks) && len(marks) <= len(data) + 1
  ensures len(marks) == len(old(marks))
{
  let capacity: i64 = len(marks);
  // Power-of-two heads, at least twice the entry count, so bucket chains stay short.
  let mut size: i64 = 1;
  while size < 2 * capacity
    invariant 1 <= size && size <= 4 * capacity && capacity <= 8388609
    decreases 4 * capacity - size
  {
    size = size * 2;
  }
  let mut heads: [i64] = alloc(size, -1);
  let mut slots: [i64] = alloc(capacity * 6, -1);
  let mut arena: [u8] = alloc(len(data), 0);
  let leaf: Found = scan(data, cut, inout arena, inout heads, inout slots);
  if leaf.bad { return Chain { active: leaf.found, cut: false, bad: true }; }
  let mut koff: i64 = 0;
  let mut klen: i64 = 0;
  let mut poff: i64 = 0;
  let mut plen: i64 = 0;
  if leaf.found {
    let at: i64 = leaf.leaf;
    if at < 0 || at > len(slots) - 6 { return Chain { active: leaf.found, cut: false, bad: true }; }
    koff = slots[at + 2];
    klen = slots[at + 3];
    if slots[at + 5] >= 0 { poff = slots[at + 4]; plen = slots[at + 5]; }
  }
  let mut lost: bool = false;
  let mut count: i64 = 0;
  let mut done: bool = !leaf.found;
  while !done && count < len(data)
    invariant len(marks) == len(old(marks)) && len(data) <= 8388608 && 0 <= count && count <= len(data)
    invariant 0 < len(heads) && len(heads) <= 33554436 && len(slots) <= 50331654
    decreases len(data) - count
  {
    if koff < 0 || klen < 0 || klen > len(arena) - koff { return Chain { active: leaf.found, cut: lost, bad: true }; }
    let f: Hit = lookup(arena, koff, klen, heads, slots, inout marks);
    if f.bad { return Chain { active: leaf.found, cut: lost, bad: true }; }
    // The initial parent belongs to the leaf entry itself, not the last duplicate UUID.
    if count > 0 { poff = f.poff; plen = f.plen; }
    if !f.found { lost = true; done = true; }
    if !f.changed || plen == 0 { done = true; }
    koff = poff;
    klen = plen;
    count = count + 1;
  }
  return Chain { active: leaf.found, cut: lost, bad: leaf.bad };
}
