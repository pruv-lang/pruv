// Qwen currentChain. Entry-ordinal marks avoid retaining parsed JSON documents.
// The index decodes each uuid and parentUuid once into a byte arena; the chain walk compares
// arena bytes and never re-parses a line. Newest-first hash buckets; exact UUID comparison resolves collisions.
// Slot layout, 7 per uuid entry: parsed object ordinal, next slot (newest-first), uuid offset, uuid length,
// parent offset, parent length (-1 missing, -2 parentUuid defect: bad only when that entry's parent is followed),
// role (1 when the action is not Action::Other).
// DB6: a mixed 64-bit hash (8-byte words, splitmix64 finalizer) masked into a power-of-two table. The old
// h * 257 % size hash let a crafted file put every uuid in 8 buckets (D-R05-1). The hash is fixed, not keyed (G-DB6-1).
fn bucket(arena: [u8], off: i64, n: i64, mask: i64) -> i64
  requires 0 <= mask
  requires 0 <= off && 0 <= n && off + n <= len(arena)
  ensures 0 <= result && result <= mask
{
  let mut h: i64 = bxor(-7046029254386353131, n);
  let mut i: i64 = 0;
  while i + 8 <= n
    invariant 0 <= i && i <= n && off + n <= len(arena) && 0 <= off
    decreases n - i
  {
    h = wrapping_mul(bxor(h, load_le(arena, off + i, 8)), -4658895280553007687);
    h = bxor(h, ushr(h, 31));
    i = i + 8;
  }
  while i < n
    invariant 0 <= i && i <= n && off + n <= len(arena) && 0 <= off
    decreases n - i
  {
    h = wrapping_mul(bxor(h, arena[off + i]), -7046029254386353131);
    i = i + 1;
  }
  h = wrapping_mul(bxor(h, ushr(h, 30)), -4658895280553007687);
  h = wrapping_mul(bxor(h, ushr(h, 27)), -7723592293110705685);
  h = bxor(h, ushr(h, 31));
  return band(h, mask);
}

// DB23 (G-R05-5), 4.3e-F: string_field's outcome for doc[id].key decoded straight onto the end of the arena
// (hand: the parsed string moved into the entry; no owned copy first). The caller takes the length from the arena.
// Result: 0 appended, -1 Missing, -2 Defect (string_field's Field::Defect), -3 no room (arena unchanged).
fn put_field(doc: crate::json::JsonDocument, id: i64, key: str, inout arena: [u8]) -> i64 ! alloc
  requires len(arena) <= 8388608
  ensures len(arena) <= 8388608
  ensures -3 <= result && result <= 0
  ensures result < 0 ==> len(arena) == len(old(arena))
{
  let f: i64 = crate::access::field(doc, id, key);
  if f == -1 || f == -2 { return -1; }
  if f < 0 { return -2; }
  let k: i64 = crate::access::kind(doc, f);
  if k < 0 { return -2; }
  if k != 4 { return -1; }
  let base: i64 = len(arena);
  if crate::access::string_append(doc, f, inout arena) != 0 { return -2; }
  if len(arena) > 8388608 {
    arena = truncate(arena, base);
    return -3;
  }
  return 0;
}

// The caller frames and parses each line and feeds Object frames into this index. The arena and slots grow
// per entry like the hand's slot vector; resolve links the hash buckets after the scan.
pub struct Index { arena: [u8], heads: [i64], slots: [i64] }

pub fn new_index() -> Index ! alloc
  ensures len(result.arena) == 0 && len(result.slots) == 0
{
  let arena: [u8] = alloc(0, 0);
  let heads: [i64] = alloc(0, 0);
  let slots: [i64] = alloc(0, 0);
  return Index { arena: move arena, heads: move heads, slots: move slots };
}

// hand: Entry::new takes uuid and parentUuid; `role` is the entry's action other than Action::Other.
pub fn note(inout index: Index, doc: crate::json::JsonDocument, ordinal: i64, role: bool) -> bool ! alloc
  requires len(index.arena) <= 8388608 && len(index.slots) <= 50331655
  ensures len(index.arena) <= 8388608 && len(index.slots) <= 50331655
{
  // DB23: uuid decoded straight into the arena (no string_field copy); a missing or empty uuid adds no slot.
  let uo: i64 = len(index.arena);
  let uf: i64 = put_field(doc, 0, "uuid", inout index.arena);
  if uf == -2 || uf == -3 { return false; }
  let ul: i64 = len(index.arena) - uo;
  if uf == 0 && ul > 0 {
    if len(index.slots) > 50331648 { return false; }
    let po: i64 = len(index.arena);
    let pf: i64 = put_field(doc, 0, "parentUuid", inout index.arena);
    if pf == -3 { return false; }
    let mut pl: i64 = pf;
    if pf == 0 { pl = len(index.arena) - po; }
    let mut r: i64 = 0;
    if role { r = 1; }
    // hand: slots.push(Slot::Entry(entry)); the bucket link (slot + 1) is set in resolve
    arr_push(inout index.slots, ordinal, -1, uo, ul, po, pl, r);
  }
  return true;
}

// hand: selected.insert(uuid). Marks every entry with this uuid; `changed` when one was not marked yet.
// Existing marks detect cycles without copying or comparing the whole bitmap. No parentUuid is read here.
struct Mark { changed: bool, bad: bool }
fn select(arena: [u8], koff: i64, klen: i64, heads: [i64], slots: [i64], inout marks: [u8]) -> Mark
  requires 0 <= koff && 0 <= klen && koff + klen <= len(arena)
  requires 0 < len(heads) && len(heads) <= 33554440 && len(slots) <= 50331655
  ensures len(marks) == len(old(marks))
{
  let mut at: i64 = heads[bucket(arena, koff, klen, len(heads) - 1)];
  let mut left: i64 = len(slots);
  let mut changed: bool = false;
  while at >= 0 && left > 0
    invariant 0 <= left && left <= len(slots) && len(slots) <= 50331655
    invariant len(marks) == len(old(marks))
    decreases left
  {
    if at > len(slots) - 7 { return Mark { changed: false, bad: true }; }
    let s: i64 = slots[at];
    let uo: i64 = slots[at + 2];
    let ul: i64 = slots[at + 3];
    if s < 0 || s >= len(marks) || uo < 0 || ul < 0 || ul > len(arena) - uo { return Mark { changed: false, bad: true }; }
    // hand: entry.uuid == key (one slice compare)
    if ul == klen && eq_range(arena, uo, arena, koff, klen) {
      if marks[s] == 0 { changed = true; }
      marks[s] = 1;
    }
    let next: i64 = slots[at + 1];
    if next >= at { return Mark { changed: false, bad: true }; }
    at = next;
    left = left - 1;
  }
  return Mark { changed: changed, bad: false };
}

// hand: latest.get(parent). Buckets are newest-first, so the first match is the newest entry with this uuid,
// the one whose parentUuid the walk follows. Result: its slot, -1 none, -2 corrupt slot.
fn newest(arena: [u8], koff: i64, klen: i64, heads: [i64], slots: [i64]) -> i64
  requires 0 <= koff && 0 <= klen && koff + klen <= len(arena)
  requires 0 < len(heads) && len(heads) <= 33554440 && len(slots) <= 50331655
  ensures result >= -2
  ensures result >= 0 ==> result <= len(slots) - 7
{
  let mut at: i64 = heads[bucket(arena, koff, klen, len(heads) - 1)];
  let mut left: i64 = len(slots);
  while at >= 0 && left > 0
    invariant 0 <= left && left <= len(slots) && len(slots) <= 50331655
    decreases left
  {
    if at > len(slots) - 7 { return -2; }
    let uo: i64 = slots[at + 2];
    let ul: i64 = slots[at + 3];
    if uo < 0 || ul < 0 || ul > len(arena) - uo { return -2; }
    if ul == klen && eq_range(arena, uo, arena, koff, klen) { return at; }
    let next: i64 = slots[at + 1];
    if next >= at { return -2; }
    at = next;
    left = left - 1;
  }
  return -1;
}

// marks is caller-owned, zero, one byte per parsed object ordinal (DB6: was one per input byte).
pub struct Chain { active: bool, cut: bool, bad: bool }
pub fn resolve(inout index: Index, inout marks: [u8]) -> Chain ! alloc
  requires len(index.arena) <= 8388608 && len(index.slots) <= 50331655
  ensures len(marks) == len(old(marks))
{
  // hand: current_chain returns None before any walk when no entry has a uuid.
  if len(index.slots) < 7 { return Chain { active: false, cut: false, bad: false }; }
  // hand: the `latest` map over all entries. Power-of-two heads, at least twice the entry count, so bucket
  // chains stay short; linking in slot order keeps each bucket newest-first. The same pass keeps the hand's
  // last_entry and last_role.
  let entries: i64 = len(index.slots) / 7 + 1;
  let mut size: i64 = 1;
  while size < 2 * entries
    invariant 1 <= size && size <= 4 * entries && entries <= 8388610
    decreases 4 * entries - size
  {
    size = size * 2;
  }
  index.heads = alloc(size, -1);
  let mut last_entry: i64 = -1;
  let mut last_role: i64 = -1;
  let mut k: i64 = 0;
  while k + 7 <= len(index.slots)
    invariant 0 <= k && k <= len(index.slots) && len(index.heads) == size && 1 <= size && size <= 33554440
    invariant len(index.arena) <= 8388608 && len(index.slots) <= 50331655 && len(marks) == len(old(marks))
    invariant last_entry == -1 || (0 <= last_entry && last_entry + 7 <= k)
    invariant last_role == -1 || (0 <= last_role && last_role + 7 <= k)
    decreases len(index.slots) - k
  {
    let uo: i64 = index.slots[k + 2];
    let ul: i64 = index.slots[k + 3];
    if uo < 0 || ul < 0 || ul > len(index.arena) - uo { return Chain { active: true, cut: false, bad: true }; }
    let b: i64 = bucket(index.arena, uo, ul, size - 1);
    index.slots[k + 1] = index.heads[b];
    index.heads[b] = k;
    last_entry = k;
    if index.slots[k + 6] == 1 { last_role = k; }
    k = k + 7;
  }
  // hand: `let Some(mut entry) = last_role.or(last_entry)`; last_entry is set whenever a slot exists.
  let mut at: i64 = last_entry;
  if last_role >= 0 { at = last_role; }
  let active: bool = at >= 0;
  let mut lost: bool = false;
  let mut count: i64 = 0;
  let mut done: bool = !active;
  // hand: `while selected.insert(entry.uuid) { parent of entry; latest.get(parent) }`. The first entry is the
  // leaf itself; later ones are the newest entry per uuid. Only the followed entry's parentUuid is read.
  while !done && count < len(index.arena)
    invariant len(marks) == len(old(marks)) && len(index.arena) <= 8388608 && 0 <= count && count <= len(index.arena)
    invariant 0 < len(index.heads) && len(index.heads) <= 33554440 && len(index.slots) <= 50331655
    invariant done || (0 <= at && at <= len(index.slots) - 7)
    decreases len(index.arena) - count
  {
    let koff: i64 = index.slots[at + 2];
    let klen: i64 = index.slots[at + 3];
    if koff < 0 || klen < 0 || klen > len(index.arena) - koff { return Chain { active: active, cut: lost, bad: true }; }
    let m: Mark = select(index.arena, koff, klen, index.heads, index.slots, inout marks);
    if m.bad { return Chain { active: active, cut: lost, bad: true }; }
    count = count + 1;
    if !m.changed {
      done = true;
    } else {
      let poff: i64 = index.slots[at + 4];
      let plen: i64 = index.slots[at + 5];
      if plen == -2 { return Chain { active: active, cut: lost, bad: true }; }
      // hand: take_string drops a missing or empty parentUuid
      if plen <= 0 {
        done = true;
      } else {
        if poff < 0 || plen > len(index.arena) - poff { return Chain { active: active, cut: lost, bad: true }; }
        let next: i64 = newest(index.arena, poff, plen, index.heads, index.slots);
        if next == -2 { return Chain { active: active, cut: lost, bad: true }; }
        if next == -1 { lost = true; done = true; } else { at = next; }
      }
    }
  }
  return Chain { active: active, cut: lost, bad: false };
}
