// Qwen currentChain. Entry-ordinal marks avoid retaining parsed JSON documents.
// The index decodes each uuid and parentUuid once into a byte arena; the chain walk compares
// arena bytes and never re-parses a line. Newest-first hash buckets; exact UUID comparison resolves collisions.
// Slot layout, 6 per uuid entry: parsed object ordinal, next slot (newest-first), uuid offset, uuid length,
// parent offset, parent length (-1 missing, -2 parentUuid defect: bad only when the entry matches a key).
// DB6: a mixed 64-bit hash (8-byte words, splitmix64 finalizer) masked into a power-of-two table. The old
// h * 257 % size hash let a crafted file put every uuid in 8 buckets (D-R05-1). The hash is fixed, not keyed (G-DB6-1).
fn bucket(arena: [u8], off: i64, n: i64, mask: i64) -> i64
  requires 0 <= mask
  requires 0 <= off && 0 <= n && off + n <= len(arena)
  ensures 0 <= result && result <= mask
{
  let mut h: i64 = bxor(-7046029254386353131, n);
  let mut i: i64 = 0;
  while i + 8 <= n
    invariant 0 <= i && i <= n && off + n <= len(arena) && 0 <= off
    decreases n - i
  {
    h = wrapping_mul(bxor(h, load_le(arena, off + i, 8)), -4658895280553007687);
    h = bxor(h, ushr(h, 31));
    i = i + 8;
  }
  while i < n
    invariant 0 <= i && i <= n && off + n <= len(arena) && 0 <= off
    decreases n - i
  {
    h = wrapping_mul(bxor(h, arena[off + i]), -7046029254386353131);
    i = i + 1;
  }
  h = wrapping_mul(bxor(h, ushr(h, 30)), -4658895280553007687);
  h = wrapping_mul(bxor(h, ushr(h, 27)), -7723592293110705685);
  h = bxor(h, ushr(h, 31));
  return band(h, mask);
}

// DB23 (G-R05-5): string_field's outcome for doc[id].key appended straight to the arena, with no copy into a
// fresh str. Result: decoded length >= 0 (appended), -1 Missing, -2 Defect (string_field's Field::Defect), -3 no room.
fn put_field(doc: crate::json::JsonDocument, id: i64, key: str, inout arena: [u8]) -> i64 ! alloc
  requires len(arena) <= 8388608
  ensures len(arena) <= 8388608
  ensures result >= -3
  ensures result >= 0 ==> len(arena) == len(old(arena)) + result
  ensures result < 0 ==> len(arena) == len(old(arena))
{
  let f: i64 = crate::access::field(doc, id, key);
  if f == -1 || f == -2 { return -1; }
  if f < 0 { return -2; }
  let k: i64 = crate::access::kind(doc, f);
  if k < 0 { return -2; }
  if k != 4 { return -1; }
  let t: crate::jstr::Text = crate::access::string_text_owned(doc, f);
  match t {
    crate::jstr::Text::InternalInvariant(e) => { return -2; }
    crate::jstr::Text::Decoded(v) => {
      if len(v) > 8388608 - len(arena) { return -3; }
      arr_append(inout arena, v, 0, len(v));
      return len(v);
    }
  }
}

// The caller frames and parses each line and feeds Object frames into this index. The arena and slots grow
// per entry like the hand's slot vector; resolve links the hash buckets after the scan.
pub struct Index { arena: [u8], heads: [i64], slots: [i64], leaf: i64, role_seen: bool }

pub fn new_index() -> Index ! alloc
  ensures len(result.arena) == 0 && len(result.slots) == 0
{
  let arena: [u8] = alloc(0, 0);
  let heads: [i64] = alloc(0, 0);
  let slots: [i64] = alloc(0, 0);
  return Index { arena: move arena, heads: move heads, slots: move slots, leaf: -1, role_seen: false };
}

// hand: Entry::new takes uuid and parentUuid; `role` is the entry's action other than Action::Other.
pub fn note(inout index: Index, doc: crate::json::JsonDocument, ordinal: i64, role: bool) -> bool ! alloc
  requires len(index.arena) <= 8388608 && len(index.slots) <= 50331654
  ensures len(index.arena) <= 8388608 && len(index.slots) <= 50331654
{
  // DB23: uuid decoded straight into the arena (no string_field copy); a zero-length uuid adds no slot.
  let uo: i64 = len(index.arena);
  let ul: i64 = put_field(doc, 0, "uuid", inout index.arena);
  if ul == -2 || ul == -3 { return false; }
  if ul > 0 {
    if len(index.slots) > 50331648 { return false; }
    let po: i64 = len(index.arena);
    let pl: i64 = put_field(doc, 0, "parentUuid", inout index.arena);
    if pl == -3 { return false; }
    if role || !index.role_seen {
      // A leaf candidate reads its parent strictly.
      if pl == -2 { return false; }
      index.leaf = len(index.slots);
    }
    // hand: slots.push(Slot::Entry(entry)); the bucket link (slot + 1) is set in resolve
    arr_push(inout index.slots, ordinal, -1, uo, ul, po, pl);
    if role { index.role_seen = true; }
  }
  return true;
}

// First match supplies the last-write parent; mark all duplicates.
// Existing marks detect cycles without copying or comparing the whole bitmap.
pub struct Hit { poff: i64, plen: i64, found: bool, changed: bool, bad: bool }
fn lookup(arena: [u8], koff: i64, klen: i64, heads: [i64], slots: [i64], inout marks: [u8]) -> Hit
  requires 0 <= koff && 0 <= klen && koff + klen <= len(arena)
  requires 0 < len(heads) && len(heads) <= 33554440 && len(slots) <= 50331654
  ensures len(marks) == len(old(marks))
{
  let mut at: i64 = heads[bucket(arena, koff, klen, len(heads) - 1)];
  let mut left: i64 = len(slots);
  let mut found: bool = false;
  let mut changed: bool = false;
  let mut poff: i64 = 0;
  let mut plen: i64 = 0;
  while at >= 0 && left > 0
    invariant 0 <= left && left <= len(slots) && len(slots) <= 50331654
    invariant len(marks) == len(old(marks))
    decreases left
  {
    if at > len(slots) - 6 { return Hit { poff: 0, plen: 0, found: false, changed: false, bad: true }; }
    let s: i64 = slots[at];
    let uo: i64 = slots[at + 2];
    let ul: i64 = slots[at + 3];
    if s < 0 || s >= len(marks) || uo < 0 || ul < 0 || ul > len(arena) - uo { return Hit { poff: 0, plen: 0, found: false, changed: false, bad: true }; }
    // hand: entry.uuid == key (one slice compare)
    if ul == klen && eq_range(arena, uo, arena, koff, klen) {
      if marks[s] == 0 { changed = true; }
      marks[s] = 1;
      let pl: i64 = slots[at + 5];
      if pl == -2 { return Hit { poff: 0, plen: 0, found: false, changed: false, bad: true }; }
      if !found && pl >= 0 { poff = slots[at + 4]; plen = pl; }
      found = true;
    }
    let next: i64 = slots[at + 1];
    if next >= at { return Hit { poff: 0, plen: 0, found: false, changed: false, bad: true }; }
    at = next;
    left = left - 1;
  }
  return Hit { poff: poff, plen: plen, found: found, changed: changed, bad: false };
}

// marks is caller-owned, zero, one byte per parsed object ordinal (DB6: was one per input byte).
pub struct Chain { active: bool, cut: bool, bad: bool }
struct Leaf { slot: i64, found: bool, bad: bool }
pub fn resolve(inout index: Index, inout marks: [u8]) -> Chain ! alloc
  requires len(index.arena) <= 8388608 && len(index.slots) <= 50331654
  ensures len(marks) == len(old(marks))
{
  // hand: current_chain returns None before any walk when no entry can be the leaf.
  if index.leaf < 0 { return Chain { active: false, cut: false, bad: false }; }
  // hand: the `latest` map over all entries. Power-of-two heads, at least twice the entry count, so bucket
  // chains stay short; linking in slot order keeps each bucket newest-first.
  let entries: i64 = len(index.slots) / 6 + 1;
  let mut size: i64 = 1;
  while size < 2 * entries
    invariant 1 <= size && size <= 4 * entries && entries <= 8388610
    decreases 4 * entries - size
  {
    size = size * 2;
  }
  index.heads = alloc(size, -1);
  let mut k: i64 = 0;
  while k + 6 <= len(index.slots)
    invariant 0 <= k && k <= len(index.slots) && len(index.heads) == size && 1 <= size && size <= 33554440
    invariant len(index.arena) <= 8388608 && len(index.slots) <= 50331654 && len(marks) == len(old(marks))
    decreases len(index.slots) - k
  {
    let uo: i64 = index.slots[k + 2];
    let ul: i64 = index.slots[k + 3];
    if uo < 0 || ul < 0 || ul > len(index.arena) - uo { return Chain { active: true, cut: false, bad: true }; }
    let b: i64 = bucket(index.arena, uo, ul, size - 1);
    index.slots[k + 1] = index.heads[b];
    index.heads[b] = k;
    k = k + 6;
  }
  let leaf: Leaf = Leaf { slot: index.leaf, found: index.leaf >= 0, bad: false };
  let mut koff: i64 = 0;
  let mut klen: i64 = 0;
  let mut poff: i64 = 0;
  let mut plen: i64 = 0;
  if leaf.found {
    let at: i64 = leaf.slot;
    if at < 0 || at > len(index.slots) - 6 { return Chain { active: leaf.found, cut: false, bad: true }; }
    koff = index.slots[at + 2];
    klen = index.slots[at + 3];
    if index.slots[at + 5] >= 0 { poff = index.slots[at + 4]; plen = index.slots[at + 5]; }
  }
  let mut lost: bool = false;
  let mut count: i64 = 0;
  let mut done: bool = !leaf.found;
  while !done && count < len(index.arena)
    invariant len(marks) == len(old(marks)) && len(index.arena) <= 8388608 && 0 <= count && count <= len(index.arena)
    invariant 0 < len(index.heads) && len(index.heads) <= 33554440 && len(index.slots) <= 50331654
    decreases len(index.arena) - count
  {
    if koff < 0 || klen < 0 || klen > len(index.arena) - koff { return Chain { active: leaf.found, cut: lost, bad: true }; }
    let f: Hit = lookup(index.arena, koff, klen, index.heads, index.slots, inout marks);
    if f.bad { return Chain { active: leaf.found, cut: lost, bad: true }; }
    // The initial parent belongs to the leaf entry itself, not the last duplicate UUID.
    if count > 0 { poff = f.poff; plen = f.plen; }
    if !f.found { lost = true; done = true; }
    if !f.changed || plen == 0 { done = true; }
    koff = poff;
    klen = plen;
    count = count + 1;
  }
  return Chain { active: leaf.found, cut: lost, bad: leaf.bad };
}
