// Qwen import; adapted from the L3-1 verified modules. See docs/QWEN_IMPORT_SPEC.md.


fn fail_at(start: i64, end: i64, p: i64) -> crate::boundary::ImportResult
  requires 0 <= start && start <= end
{
  if p >= 0 && p <= end - start {
    return crate::boundary::ImportResult::Failed(crate::boundary::code_internal_invariant(), start + p);
  }
  return crate::boundary::ImportResult::Failed(crate::boundary::code_internal_invariant(), start);
}

fn fail_zero() -> crate::boundary::ImportResult
{
  return crate::boundary::ImportResult::Failed(crate::boundary::code_internal_invariant(), 0);
}

fn meta_new(mode: i64) -> [i64] ! alloc
  requires 0 <= mode && mode <= 2
  ensures len(result) == 14 && result[0] == 1 && result[1] == mode && result[2] == 0 && result[3] == 0
  ensures result[4] == -1 && result[5] == 0 && result[6] == -1 && result[7] == 0 && result[8] == -1 && result[9] == 0
  ensures result[10] == -1 && result[11] == 0 && result[12] == -1 && result[13] == 0
{
  let mut m: [i64] = alloc(14, 0);
  m[0] = 1;
  m[1] = mode;
  m[4] = -1;
  m[6] = -1;
  m[8] = -1;
  m[10] = -1;
  m[12] = -1;
  return m;
}

fn publish(take meta: [i64], take text: [u8]) -> crate::boundary::ImportResult ! alloc
{
  let turns: [i64] = alloc(0, 0);
  if !crate::boundary::check_output(meta, turns, text) { return fail_zero(); }
  let o: crate::boundary::ImportOutput = crate::boundary::make_output(move meta, move turns, move text);
  return crate::boundary::ImportResult::Imported(o);
}

fn head_result(title: str, has_title: bool, cwd: str, has_cwd: bool) -> crate::boundary::ImportResult ! alloc
{
  let tl: i64 = len(title);
  let cl: i64 = len(cwd);
  if tl > 5646080 || cl > 5646080 { return fail_zero(); }
  let total: i64 = tl + cl;
  if total > 5646080 { return fail_zero(); }
  let mut text: [u8] = alloc(0, 0);
  arr_reserve(inout text, total);
  arr_append(inout text, title, 0, tl);
  arr_append(inout text, cwd, 0, cl);
  let mut m: [i64] = meta_new(0);
  if has_title { m[4] = 0; m[5] = tl; }
  if has_cwd { m[6] = tl; m[7] = cl; }
  return publish(move m, move text);
}

fn tail_result(title: str, has_title: bool, last: [u8], has_at: bool) -> crate::boundary::ImportResult ! alloc
{
  let tl: i64 = len(title);
  if tl > 5646080 { return fail_zero(); }
  let mut extra: i64 = 0;
  if has_at {
    if len(last) != 24 { return fail_zero(); }
    extra = 24;
  }
  let total: i64 = tl + extra;
  let mut text: [u8] = alloc(0, 0);
  arr_reserve(inout text, total);
  arr_append(inout text, title, 0, tl);
  let mut m: [i64] = meta_new(1);
  if has_title { m[4] = 0; m[5] = tl; }
  if has_at {
    arr_append(inout text, last, 0, 24);
    m[10] = tl;
    m[11] = 24;
  }
  return publish(move m, move text);
}


pub fn read_head(data: [u8], cut_after: bool) -> crate::boundary::ImportResult ! alloc
{
  if len(data) > crate::boundary::limit_edge_bytes() {
    return crate::boundary::ImportResult::Failed(crate::boundary::code_input_too_large(), 0);
  }
  let mut cwd: str = "";
  let mut title: str = "";
  let mut has_cwd: bool = false;
  let mut has_title: bool = false;
  let mut offset: i64 = 0;
  while offset < len(data)
    invariant 0 <= offset && offset <= len(data)
    decreases len(data) - offset
  {
    let step: crate::framing::Frame = crate::framing::edge_next(data, offset, !cut_after);
    match step {
      crate::framing::Frame::Entry(start, end, next) => {
        let line: crate::entry::Line = crate::entry::parse_line(data, start, end);
        match line {
          crate::entry::Line::Object(d) => {
            let root: i64 = crate::access::root(d);
            if !has_cwd {
              let f: crate::entry::Field = crate::entry::string_field(d, root, "cwd");
              match f {
                crate::entry::Field::Value(v) => { cwd = move v; has_cwd = true; }
                crate::entry::Field::Missing => {}
                crate::entry::Field::Defect(e) => { return fail_at(start, end, 0); }
              }
            }
            if !has_title {
              let h: crate::entry::Field = crate::entry::human_text(d);
              match h {
                crate::entry::Field::Value(t) => {
                  if len(t) > 50331648 { return fail_at(start, end, 0); }
                  title = move t;
                  has_title = true;
                }
                crate::entry::Field::Missing => {}
                crate::entry::Field::Defect(e) => { return fail_at(start, end, 0); }
              }
            }
          }
          crate::entry::Line::Skip => {}
          crate::entry::Line::Defect(p) => { return fail_at(start, end, p); }
        }
        offset = next;
        if has_cwd && has_title { offset = len(data); }
      }
      crate::framing::Frame::Dropped(s, e, n) => { offset = len(data); }
      crate::framing::Frame::Done => { offset = len(data); }
    }
  }
  return head_result(title, has_title, cwd, has_cwd);
}


// hand tail_import's loop body for one parsed object, in hand order: the timestamp, then the custom title (split
// out of tail_info's loop so doc_strings(d) is proved in a small context). Defect when the line fails.
fn tail_object(d: crate::json::JsonDocument, inout last: [u8], inout has_at: bool) -> crate::entry::Title ! alloc
  requires crate::json::doc_strings(d)
  ensures is_variant(result, crate::entry::Title::Found) ==> len(variant_field(result, crate::entry::Title::Found, text)) <= 50331648
{
  let root: i64 = crate::access::root(d);
  let tf: i64 = crate::access::field(d, root, "timestamp");
  if tf < -1 { return crate::entry::Title::Defect(-4); }
  if tf >= 0 {
    let iso: crate::time::Iso = crate::time::iso_of(d, tf);
    if iso.status < 0 { return crate::entry::Title::Defect(-4); }
    if iso.status == 0 {
      last = copy(iso.text);
      has_at = true;
    }
  }
  return crate::entry::title_of(d);
}

pub fn tail_info(data: [u8], cut_before: bool) -> crate::boundary::ImportResult ! alloc
{
  if len(data) > crate::boundary::limit_edge_bytes() {
    return crate::boundary::ImportResult::Failed(crate::boundary::code_input_too_large(), 0);
  }
  let mut best: str = "";
  let mut has_title: bool = false;
  let mut last: [u8] = alloc(0, 0);
  let mut has_at: bool = false;
  let mut offset: i64 = crate::framing::skip_first(data, cut_before);
  while offset < len(data)
    invariant 0 <= offset && offset <= len(data)
    invariant len(best) <= 50331648
    decreases len(data) - offset
  {
    let step: crate::framing::Frame = crate::framing::edge_next(data, offset, true);
    match step {
      crate::framing::Frame::Entry(start, end, next) => {
        let line: crate::entry::Line = crate::entry::parse_line(data, start, end);
        match line {
          crate::entry::Line::Object(d) => {
            let t: crate::entry::Title = tail_object(d, inout last, inout has_at);
            match t {
              // hand: the last custom title wins
              crate::entry::Title::Found(text) => { best = move text; has_title = true; }
              crate::entry::Title::NoTitle => {}
              crate::entry::Title::Defect(e) => { return fail_at(start, end, 0); }
            }
          }
          crate::entry::Line::Skip => {}
          crate::entry::Line::Defect(p) => { return fail_at(start, end, p); }
        }
        offset = next;
      }
      crate::framing::Frame::Dropped(s, e, n) => { offset = len(data); }
      crate::framing::Frame::Done => { offset = len(data); }
    }
  }
  let title: str = crate::text::one_line(best, 120);
  return tail_result(title, has_title, last, has_at);
}


// One record per Object boundary or replay operation (hand: the slot vector). Skip frames and non-user drops
// are no-ops. A record is three words: tag and two fields. For Object they hold ordinal/start; a token record
// holds the byte range [a, b) of one raw JSON token in data (hand: the parsed value kept in the Entry), decoded
// only in replay for a selected entry. The log grows per entry.
struct Event { kind: i64, a: i64, b: i64 }

fn write_event(inout log: [i64], event: Event) -> bool ! alloc
{
  if len(log) > 4294967292 { return false; }
  arr_push(inout log, event.kind, event.a, event.b);
  return true;
}

// The raw token of node id, as a range of data (the line's document source is data[start..end]).
fn write_token(inout log: [i64], kind: i64, doc: crate::json::JsonDocument, id: i64, start: i64) -> bool ! alloc
  requires 0 <= start && start <= 8388608
{
  let s: crate::access::Span = crate::access::raw_span(doc, id);
  if s.status != 0 { return false; }
  return write_event(inout log, Event { kind: kind, a: start + s.start, b: start + s.end });
}

fn read_event(records: [i64], pos: i64) -> Event
  requires 0 <= pos && pos + 3 <= len(records)
{
  return Event { kind: records[pos], a: records[pos + 1], b: records[pos + 2] };
}

// Replay tags: 0 Object, 1 dropped real user, 3 user stamp (ends a user entry), 4 assistant stamp, 5 prompt part,
// 6 model, 7 answer part, 8 tool, 9 selected-entry defect. A stamp record with a < 0 has no timestamp field.
// hand visible_parts: the object parts that are not thoughts; a text string is kept (tag 5 for a user, 7 for an
// assistant), else an assistant's functionCall object counts a tool (tag 8).
fn record_parts(doc: crate::json::JsonDocument, c: i64, user: bool, start: i64, inout log: [i64]) -> bool ! alloc
  requires 0 <= c && c < len(doc.tape) / 6
  requires 0 <= start && start <= 8388608
{
  if len(doc.tape) > 6291456 { return false; }
  let stop: i64 = doc.tape[6 * c + 3];
  if stop <= c || stop > len(doc.tape) / 6 { return false; }
  let mut tag: i64 = 7;
  if user { tag = 5; }
  let mut j: i64 = c + 1;
  while j < stop
    invariant 0 <= c && c < j && j <= stop && stop <= len(doc.tape) / 6 && len(doc.tape) <= 6291456
    decreases stop - j
  {
    let next: i64 = doc.tape[6 * j + 3];
    if next <= j || next > stop || doc.tape[6 * j + 4] != c { return false; }
    let bkind: i64 = crate::access::kind(doc, j);
    if bkind < 0 { return false; }
    if bkind == 6 {
      let thought: i64 = crate::entry::is_true(doc, j, "thought");
      if thought < 0 { return false; }
      if thought != 1 {
        let tx: i64 = crate::entry::string_id(doc, j, "text");
        if tx < -1 { return false; }
        if tx >= 0 {
          if !write_token(inout log, tag, doc, tx, start) { return false; }
        } else if !user {
          let call: i64 = crate::entry::object_field(doc, j, "functionCall");
          if call < -1 { return false; }
          if call >= 0 {
            if !write_event(inout log, Event { kind: 8, a: 0, b: 0 }) { return false; }
          }
        }
      }
    }
    j = next;
  }
  return true;
}

// hand take_parts: message.parts when it is an array, else no parts.
fn record_message(doc: crate::json::JsonDocument, user: bool, start: i64, inout log: [i64]) -> bool ! alloc
  requires 0 <= start && start <= 8388608
{
  let root: i64 = crate::access::root(doc);
  let msg: i64 = crate::entry::object_field(doc, root, "message");
  if msg == -1 { return true; }
  if msg < 0 { return false; }
  let c: i64 = crate::access::field(doc, msg, "parts");
  if c == -1 || c == -2 { return true; }
  if c < 0 { return false; }
  let k: i64 = crate::access::kind(doc, c);
  if k < 0 { return false; }
  if k != 5 { return true; }
  return record_parts(doc, c, user, start, inout log);
}

// hand object.remove("timestamp"): the raw token, formatted by iso in replay.
fn write_stamp(doc: crate::json::JsonDocument, kind: i64, start: i64, inout log: [i64]) -> bool ! alloc
  requires 0 <= start && start <= 8388608
{
  let root: i64 = crate::access::root(doc);
  let tf: i64 = crate::access::field(doc, root, "timestamp");
  if tf == -1 { return write_event(inout log, Event { kind: kind, a: -1, b: -1 }); }
  if tf < 0 { return false; }
  return write_token(inout log, kind, doc, tf, start);
}

// hand Entry::new's Action: a real user keeps its parts and timestamp; an assistant its timestamp, model and parts.
fn record_entry(doc: crate::json::JsonDocument, role: i64, start: i64, inout log: [i64]) -> bool ! alloc
  requires 0 <= start && start <= 8388608
{
  let root: i64 = crate::access::root(doc);
  match role {
    1 => {
      if !record_message(doc, true, start, inout log) { return false; }
      return write_stamp(doc, 3, start, inout log);
    }
    2 => {
      // hand take_string(model): a string token; the empty one is dropped in replay (model before the stamp, as
      // the hand updates the model before it tests collector.attached and formats the stamp)
      let mf: i64 = crate::entry::string_id(doc, root, "model");
      if mf < -1 { return false; }
      if mf >= 0 {
        if !write_token(inout log, 6, doc, mf, start) { return false; }
      }
      if !write_stamp(doc, 4, start, inout log) { return false; }
      return record_message(doc, false, start, inout log);
    }
    _ => { return role >= 0; }
  }
}

fn record_object(doc: crate::json::JsonDocument, role: i64, ordinal: i64, start: i64, inout log: [i64]) -> bool ! alloc
  requires 0 <= start && start <= 8388608
{
  if !write_event(inout log, Event { kind: 0, a: ordinal, b: start }) { return false; }
  if record_entry(doc, role, start, inout log) { return true; }
  return write_event(inout log, Event { kind: 9, a: 0, b: 0 });
}

// hand iso(timestamp) over the raw token data[a..b]; a < 0 is a missing field (hand Value::Null).
fn stamp(data: [u8], a: i64, b: i64) -> crate::time::Iso ! alloc
  requires len(data) <= 8388608
  ensures utf8_valid(result.text)
  ensures result.status == 0 ==> len(result.text) == 24
{
  if a < 0 || a > b || b > len(data) {
    let e: [u8] = alloc(0, 0);
    let mut status: i64 = 1;
    if a >= 0 { status = -4; }
    return crate::time::Iso { status: status, text: move e };
  }
  return crate::time::iso_raw(data, a, b);
}

struct Replay { model: str, defect: i64 }

fn replay(data: [u8], log: [i64], chain: crate::chain::Chain, selected: [u8], inout st: [i64], inout sl: [i64], inout bk: crate::turns::Store) -> Replay ! alloc
  requires len(log) <= 4294967295 && len(data) <= 8388608
  requires len(st) == 4 && len(sl) == 1600 && len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data) && st[0] == 0 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1)
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  ensures len(st) == 4 && len(sl) == 1600 && len(bk.off) == 200 && len(bk.stamp) == 9600
  ensures 0 <= st[0] && st[0] <= 4294967295
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
{
  let mut pos: i64 = 0;
  let mut start: i64 = 0;
  let mut chosen: bool = false;
  let mut started: bool = false;
  let mut pending: bool = false;
  let mut model: str = "";
  // hand prompt (the join of a selected user's parts) and the decoded text of one answer part
  let mut prompt: [u8] = alloc(0, 0);
  let mut parts: i64 = 0;
  let mut piece: [u8] = alloc(0, 0);
  // hand at = iso(timestamp) of an attached assistant: at_n is 24 when at.text holds the stamp, else 0
  let none: [u8] = alloc(0, 0);
  let mut at: crate::time::Iso = crate::time::Iso { status: 1, text: move none };
  let mut at_n: i64 = 0;
  while pos + 3 <= len(log)
    invariant 0 <= pos && pos <= len(log) && len(log) <= 4294967295 && 0 <= start && 0 <= parts && parts <= pos
    invariant utf8_valid(prompt) && utf8_valid(piece) && utf8_valid(at.text) && (at_n == 0 || (at_n == 24 && len(at.text) == 24))
    invariant len(st) == 4 && len(sl) == 1600 && len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data) && 0 <= st[0] && st[0] <= pos && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1)
    invariant forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
    invariant forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
    decreases len(log) - pos
  {
    let event: Event = read_event(log, pos);
    match event.kind {
      0 => {
        if event.a < 0 || event.a >= len(selected) || event.b < 0 { return Replay { model: move model, defect: 0 }; }
        chosen = !chain.active || selected[event.a] == 1;
        start = event.b;
        at_n = 0;
        if chosen {
          if !started && pending { crate::turns::skip_user(inout st); }
          started = true;
        }
        pending = false;
      }
      1 => {
        pending = true;
        if started { crate::turns::skip_user(inout st); }
      }
      9 => {
        if chosen { return Replay { model: move model, defect: start }; }
      }
      8 => {
        if chosen && st[1] == 1 { crate::turns::tool(inout st, inout sl, 1); }
      }
      3 => {
        // hand: the joined prompt starts a turn when it is not blank, with iso(timestamp)
        if chosen {
          if len(prompt) > 100000000 { return Replay { model: move model, defect: start }; }
          if !crate::text::is_blank(subview(prompt, 0, len(prompt))) {
            let created: crate::time::Iso = stamp(data, event.a, event.b);
            if created.status < 0 { return Replay { model: move model, defect: start }; }
            let mut cn: i64 = 0;
            if created.status == 0 { cn = 24; }
            crate::turns::begin2(inout st, inout sl, inout bk, subview(prompt, 0, len(prompt)), subview(created.text, 0, cn));
          }
        }
        prompt = truncate(prompt, 0);
        parts = 0;
      }
      4 => {
        // hand: if collector.attached { let at = iso(timestamp); .. }
        if chosen && st[1] == 1 {
          at = stamp(data, event.a, event.b);
          if at.status < 0 { return Replay { model: move model, defect: start }; }
          at_n = 0;
          if at.status == 0 { at_n = 24; }
        }
      }
      _ => {
        // hand: the model and the prompt parts of a selected entry; answer parts only for an attached turn
        if chosen && (event.kind != 7 || st[1] == 1) {
          if event.a < 0 || event.a > event.b || event.b > len(data) {
            return Replay { model: move model, defect: 0 };
          }
          match event.kind {
            5 => {
              // hand join("\n\n") over the parts' text
              if len(prompt) > 50331646 { return Replay { model: move model, defect: start }; }
              if parts > 0 { arr_append(inout prompt, "\n\n", 0, 2); }
              crate::jstr::decode_append(inout prompt, data, event.a, event.b, false);
              parts = parts + 1;
            }
            // hand: the reply model is an owned String (take_string drops the empty one)
            6 => {
              let mut m: [u8] = alloc(0, 0);
              crate::jstr::decode_append(inout m, data, event.a, event.b, false);
              if len(m) > 0 { model = str_from_utf8(m); }
            }
            7 => {
              // hand answer(text, at) borrows the part's text: its decode, lent as str
              piece = truncate(piece, 0);
              crate::jstr::decode_append(inout piece, data, event.a, event.b, false);
              crate::turns::answer2(inout st, inout sl, inout bk, subview(piece, 0, len(piece)), subview(at.text, 0, at_n));
            }
            _ => {}
          }
        }
      }
    }
    pos = pos + 3;
  }
  return Replay { model: move model, defect: -1 };
}

fn wfail_zero() -> [u8] ! alloc
{
  return crate::boundary::wire_fail(crate::boundary::code_internal_invariant(), 0);
}

// hand Entry::new's title and the replay actions of one parsed object (split out of window_wire's loop so
// doc_strings(d) is proved in a small context). Found or NoTitle when recorded; Defect when the line fails.
fn window_object(d: crate::json::JsonDocument, role: i64, ordinal: i64, start: i64, inout log: [i64]) -> crate::entry::Title ! alloc
  requires crate::json::doc_strings(d)
  requires 0 <= start && start <= 8388608
  ensures is_variant(result, crate::entry::Title::Found) ==> len(variant_field(result, crate::entry::Title::Found, text)) <= 50331648
{
  if role != 4 {
    if !record_object(d, role, ordinal, start, inout log) { return crate::entry::Title::Defect(-4); }
    return crate::entry::Title::NoTitle;
  }
  let t: crate::entry::Title = crate::entry::custom_title(d);
  match t {
    crate::entry::Title::Found(x) => {
      if !record_object(d, role, ordinal, start, inout log) { return crate::entry::Title::Defect(-4); }
      return crate::entry::Title::Found(move x);
    }
    crate::entry::Title::NoTitle => {
      if !record_object(d, role, ordinal, start, inout log) { return crate::entry::Title::Defect(-4); }
      return crate::entry::Title::NoTitle;
    }
    crate::entry::Title::Defect(e) => { return crate::entry::Title::Defect(e); }
  }
}

pub fn window_wire(data: [u8], cut_before: bool) -> [u8] ! alloc
{
  if len(data) > crate::boundary::limit_window_bytes() {
    return crate::boundary::wire_fail(crate::boundary::code_input_too_large(), 0);
  }
  let mut index: crate::chain::Index = crate::chain::new_index();
  let mut log: [i64] = alloc(0, 0);
  let mut title: str = "";
  let mut ordinal: i64 = 0;
  let mut offset: i64 = crate::framing::skip_first(data, cut_before);
  while offset < len(data)
    invariant 0 <= ordinal && ordinal <= offset
    invariant 0 <= offset && offset <= len(data) && len(data) <= 8388608
    invariant len(index.arena) <= 8388608 && len(index.slots) <= 50331655
    invariant len(title) <= 50331648
    decreases len(data) - offset
  {
    let step: crate::framing::Frame = crate::framing::window_next(data, offset);
    match step {
      crate::framing::Frame::Entry(start, end, next) => {
        let line: crate::entry::Line = crate::entry::parse_line(data, start, end);
        match line {
          crate::entry::Line::Object(d) => {
            // hand: Entry::new(object, &mut title) decides the role, the index keys and the title
            let role: i64 = crate::entry::role_of(d);
            if !crate::chain::note(inout index, d, ordinal, role >= 1 && role <= 3) { return wfail_zero(); }
            let t: crate::entry::Title = window_object(d, role, ordinal, start, inout log);
            match t {
              crate::entry::Title::Found(x) => { title = move x; }
              crate::entry::Title::NoTitle => {}
              crate::entry::Title::Defect(e) => { return wfail_zero(); }
            }
            // hand: only parsed objects become entries
            ordinal = ordinal + 1;
          }
          crate::entry::Line::Skip => {}
          // The old chain scan saw a parser defect before importer replay could report its position.
          crate::entry::Line::Defect(p) => { return wfail_zero(); }
        }
        offset = next;
      }
      crate::framing::Frame::Dropped(s, e, n) => {
        if crate::text::dropped_user(subview(data, s, e)) {
          if !write_event(inout log, Event { kind: 1, a: 0, b: 0 }) { return wfail_zero(); }
        }
        offset = n;
      }
      crate::framing::Frame::Done => { offset = len(data); }
    }
  }
  let mut selected: [u8] = alloc(ordinal, 0);
  let chain: crate::chain::Chain = crate::chain::resolve(inout index, inout selected);
  if chain.bad { return wfail_zero(); }
  let mut st: [i64] = crate::turns::new_state();
  let mut sl: [i64] = crate::turns::new_slots();
  let mut bk: crate::turns::Store = crate::turns::new_store();
  if len(log) > 4294967295 { return wfail_zero(); }
  let result: Replay = replay(data, log, chain, selected, inout st, inout sl, inout bk);
  if result.defect >= 0 {
    return crate::boundary::wire_fail(crate::boundary::code_internal_invariant(), result.defect);
  }
  let shown: str = crate::text::one_line(title, 120);
  let tl: i64 = len(shown);
  let ml: i64 = len(result.model);
  if tl > 4096 || ml > 3145728 { return wfail_zero(); }
  let base: i64 = tl + ml;
  let layout: crate::turns::Layout = crate::turns::text_layout(st, sl);
  let nt: i64 = 10 * layout.kept;
  let total: i64 = base + layout.text_len;
  let hl: i64 = 8 * (18 + nt);
  let mut w: [u8] = alloc(hl + total, 0);
  let col: crate::turns::Placed = crate::turns::finish_into(st, sl, bk, base, inout w, hl + base);
  if !col.ok || col.kept != layout.kept || col.text_len != layout.text_len { return wfail_zero(); }
  let mut m: [i64] = meta_new(2);
  if cut_before || col.trimmed == 1 || chain.cut { m[2] = 1; }
  m[3] = col.kept;
  if tl > 0 { m[4] = 0; m[5] = tl; }
  if ml > 0 { m[12] = tl; m[13] = ml; }
  // Check metadata and turn spans against the final text length before writing the header.
  if !crate::boundary::check_shape(m, col.turns, total) { return wfail_zero(); }
  let mut ok: bool = true;
  if !crate::boundary::put_word(inout w, 0, 0) { ok = false; }
  if !crate::boundary::put_word(inout w, 8, 14) { ok = false; }
  if !crate::boundary::put_word(inout w, 16, nt) { ok = false; }
  if !crate::boundary::put_word(inout w, 24, total) { ok = false; }
  let mut i: i64 = 0;
  while i < 14
    invariant 0 <= i && i <= 14 && len(m) == 14 && len(w) == hl + total && hl == 8 * (18 + nt) && 0 <= nt && 0 <= total
    decreases 14 - i
  {
    if !crate::boundary::put_word(inout w, 32 + 8 * i, m[i]) { ok = false; }
    i = i + 1;
  }
  let mut j: i64 = 0;
  while j < nt
    invariant 0 <= j && j <= nt && nt == len(col.turns) && len(w) == hl + total && hl == 8 * (18 + nt) && 0 <= total
    decreases nt - j
  {
    if !crate::boundary::put_word(inout w, 144 + 8 * j, col.turns[j]) { ok = false; }
    j = j + 1;
  }
  if !ok { return wfail_zero(); }
  copy_range(inout w, hl, shown, 0, tl);
  copy_range(inout w, hl + tl, result.model, 0, ml);
  return w;
}
