// Qwen import; adapted from the L3-1 verified modules. See docs/QWEN_IMPORT_SPEC.md.

pub enum Line { Object(doc: crate::json::JsonDocument), Skip, Defect(position: i64) }
pub enum Field { Value(text: str), Missing, Defect(kind: i64) }
pub enum Title { Found(text: str), NoTitle, Defect(kind: i64) }
// 4.3e-J: Piece carries the text string node; array_content appends its borrowed view (hand `&str` parts).
enum Block { Piece(node: i64), Ignore, Broken(kind: i64) }

pub fn parse_line(data: [u8], start: i64, end: i64) -> Line ! alloc
  requires 0 <= start && start <= end && end <= len(data)
  ensures is_variant(result, Line::Object) ==> crate::json::doc_local(variant_field(result, Line::Object, doc))
  ensures is_variant(result, Line::Object) ==> crate::json::doc_strings(variant_field(result, Line::Object, doc))
{
  // hand: skip the line unless its first non-blank byte is `{`
  let mut i: i64 = start;
  while i < end && (data[i] == 32 || data[i] == 9 || data[i] == 10 || data[i] == 13)
    invariant start <= i && i <= end
    decreases end - i
  { i = i + 1; }
  if i == end || data[i] != 123 { return Line::Skip; }
  let parsed: crate::json::JsonParse = crate::lines::parse_range(data, start, end);
  match parsed {
    crate::json::JsonParse::Parsed(d) => {
      if crate::access::kind(d, crate::access::root(d)) == 6 { return Line::Object(d); }
      return Line::Skip;
    }
    crate::json::JsonParse::Failed(error) => {
      if error.kind == crate::json::err_internal_invariant() { return Line::Defect(error.position); }
      return Line::Skip;
    }
  }
}

pub fn string_field(doc: crate::json::JsonDocument, id: i64, key: str) -> Field ! alloc
  ensures is_variant(result, Field::Value) ==> len(variant_field(result, Field::Value, text)) <= 50331648
{
  let f: i64 = crate::access::field(doc, id, key);
  if f == -1 || f == -2 { return Field::Missing; }
  if f < 0 { return Field::Defect(f); }
  let k: i64 = crate::access::kind(doc, f);
  if k < 0 { return Field::Defect(k); }
  if k != 4 { return Field::Missing; }
  let t: crate::jstr::Text = crate::access::string_text_owned(doc, f);
  match t {
    crate::jstr::Text::InternalInvariant(e) => { return Field::Defect(e); }
    crate::jstr::Text::Decoded(v) => {
      if len(v) > 50331648 { return Field::Defect(-4); }
      return Field::Value(move v);
    }
  }
}

pub fn field_is(doc: crate::json::JsonDocument, id: i64, key: str, lit: str) -> i64 ! alloc
  ensures result <= 1
{
  let f: i64 = string_id(doc, id, key);
  if f == -1 { return 0; }
  if f < 0 { return f; }
  return crate::access::string_is(doc, f, lit);
}

pub fn string_id(doc: crate::json::JsonDocument, id: i64, key: str) -> i64 ! alloc
  ensures result == -1 || result == -3 || result == -4 || (result >= 0 && result < len(doc.tape) / 6)
{
  let f: i64 = crate::access::field(doc, id, key);
  if f == -1 || f == -2 { return -1; }
  if f < 0 { if f == -3 { return -3; } return -4; }
  let k: i64 = crate::access::kind(doc, f);
  if k < 0 { return -3; }
  if k != 4 { return -1; }
  return f;
}

pub fn object_field(doc: crate::json::JsonDocument, id: i64, key: str) -> i64 ! alloc
  ensures result == -1 || result == -2 || (result >= 0 && result < len(doc.tape) / 6)
{
  let f: i64 = crate::access::field(doc, id, key);
  if f == -1 || f == -2 { return -1; }
  if f < 0 { return -2; }
  let k: i64 = crate::access::kind(doc, f);
  if k < 0 { return -2; }
  if k == 6 { return f; }
  return -1;
}

pub fn is_true(doc: crate::json::JsonDocument, id: i64, key: str) -> i64 ! alloc
  ensures result <= 1
{
  let f: i64 = crate::access::field(doc, id, key);
  if f == -1 || f == -2 { return 0; }
  if f < 0 { return f; }
  let k: i64 = crate::access::kind(doc, f);
  if k < 0 { return k; }
  if k == 2 { return 1; }
  return 0;
}

pub fn task_origin(doc: crate::json::JsonDocument, id: i64) -> i64 ! alloc
  ensures result <= 1
{
  let o: i64 = object_field(doc, id, "origin");
  if o == -1 { return 0; }
  if o < 0 { return -4; }
  return field_is(doc, o, "kind", "task-notification");
}

fn block_of(doc: crate::json::JsonDocument, j: i64) -> Block ! alloc
{
  let k: i64 = crate::access::kind(doc, j);
  if k < 0 { return Block::Broken(k); }
  if k != 6 { return Block::Ignore; }
  let thought: i64 = is_true(doc, j, "thought");
  if thought < 0 { return Block::Broken(thought); }
  if thought == 1 { return Block::Ignore; }
  let tx: i64 = string_id(doc, j, "text");
  if tx == -1 { return Block::Ignore; }
  if tx < 0 { return Block::Broken(tx); }
  return Block::Piece(tx);
}

fn string_content(doc: crate::json::JsonDocument, c: i64) -> Field ! alloc
{
  let t: crate::jstr::Text = crate::access::string_text_owned(doc, c);
  match t {
    crate::jstr::Text::InternalInvariant(e) => { return Field::Defect(e); }
    crate::jstr::Text::Decoded(v) => {
      if crate::text::is_blank(v) { return Field::Missing; }
      let o: i64 = task_origin(doc, 0);
      if o < 0 { return Field::Defect(o); }
      let engine: bool = crate::text::engine_line(v, o == 1);
      if engine { return Field::Missing; }
      return Field::Value(move v);
    }
  }
}

fn array_content(doc: crate::json::JsonDocument, c: i64) -> Field ! alloc
  requires 0 <= c && c < len(doc.tape) / 6
  requires crate::json::doc_strings(doc)
{
  if len(doc.tape) > 6291456 { return Field::Defect(-4); }
  let stop: i64 = doc.tape[6 * c + 3];
  if stop <= c || stop > len(doc.tape) / 6 { return Field::Defect(-4); }
  let mut joined: String = string_new();
  let mut count: i64 = 0;
  let mut j: i64 = c + 1;
  while j < stop
    invariant 0 <= c && c < j && j <= stop && stop <= len(doc.tape) / 6 && len(doc.tape) <= 6291456
    invariant 0 <= count && count <= j
    invariant len(joined) <= 1000000000
    decreases stop - j
  {
    let next: i64 = doc.tape[6 * j + 3];
    if next <= j || next > stop || doc.tape[6 * j + 4] != c { return Field::Defect(-4); }
    let b: Block = block_of(doc, j);
    match b {
      Block::Piece(n) => {
        // hand: a plain part is pushed from its borrowed view; an escaped one from its decode
        let room: i64 = 1000000000 - len(joined);
        let pv: Option<ref str> = crate::access::plain_str(doc, n);
        match pv {
          Some(x) => {
            if len(x) > 50331648 || len(x) > room - 2 { return Field::Defect(-4); }
            if count > 0 { joined = string_push_str(move joined, "\n\n"); }
            joined = string_push_str(move joined, x);
          }
          None => {
            let t: crate::jstr::Text = crate::access::string_text_owned(doc, n);
            match t {
              crate::jstr::Text::InternalInvariant(e) => { return Field::Defect(e); }
              crate::jstr::Text::Decoded(x) => {
                if len(x) > 50331648 || len(x) > room - 2 { return Field::Defect(-4); }
                if count > 0 { joined = string_push_str(move joined, "\n\n"); }
                joined = string_push_str(move joined, x);
              }
            }
          }
        }
        count = count + 1;
      }
      Block::Ignore => {}
      Block::Broken(e) => { return Field::Defect(e); }
    }
    j = next;
  }
  let whole: str = string_to_str(joined);
  if crate::text::is_blank(whole) { return Field::Missing; }
  return Field::Value(move whole);
}

// hand: Entry::new matches the "type" string once. 0 other, 1 real user (provenance missing or real_user),
// 2 assistant, 3 user that is not a real user or tool_result (a role without content), 4 system; negative: defect.
// hand: a user line is real when provenance is missing or "real_user" (1), otherwise a tool result (3).
fn user_role(doc: crate::json::JsonDocument, root: i64) -> i64 ! alloc
  ensures result <= 3
{
  let provenance: i64 = crate::access::field(doc, root, "provenance");
  if provenance == -1 { return 1; }
  if provenance < 0 { return -4; }
  let real: i64 = crate::access::string_is(doc, provenance, "real_user");
  if real < 0 { return real; }
  if real == 1 { return 1; }
  return 3;
}

pub fn role_of(doc: crate::json::JsonDocument) -> i64 ! alloc
  ensures result <= 4
{
  let root: i64 = crate::access::root(doc);
  let ty: i64 = string_id(doc, root, "type");
  if ty == -1 { return 0; }
  if ty < 0 { return ty; }
  if crate::access::string_is(doc, ty, "user") == 1 {
    return user_role(doc, root);
  } else if crate::access::string_is(doc, ty, "assistant") == 1 {
    return 2;
  } else if crate::access::string_is(doc, ty, "tool_result") == 1 {
    return 3;
  } else if crate::access::string_is(doc, ty, "system") == 1 {
    return 4;
  }
  return 0;
}

// hand: the non-thought text parts of message.parts joined with a blank line, kept when not blank.
pub fn user_text(doc: crate::json::JsonDocument) -> Field ! alloc
  requires crate::json::doc_strings(doc)
{
  let root: i64 = crate::access::root(doc);
  let msg: i64 = object_field(doc, root, "message");
  if msg == -1 { return Field::Missing; }
  if msg < 0 { return Field::Defect(msg); }
  let c: i64 = crate::access::field(doc, msg, "parts");
  if c == -1 || c == -2 { return Field::Missing; }
  if c < 0 { return Field::Defect(c); }
  let k: i64 = crate::access::kind(doc, c);
  if k < 0 { return Field::Defect(k); }
  if k == 5 { return array_content(doc, c); }
  return Field::Missing;
}

// hand edge.rs human_text: a real user line, then its parts text.
pub fn human_text(doc: crate::json::JsonDocument) -> Field ! alloc
  requires crate::json::doc_strings(doc)
{
  // hand: any type but "user" ends here, before provenance
  let root: i64 = crate::access::root(doc);
  let ty: i64 = string_id(doc, root, "type");
  if ty == -1 { return Field::Missing; }
  if ty < 0 { return Field::Defect(ty); }
  if crate::access::string_is(doc, ty, "user") != 1 { return Field::Missing; }
  let role: i64 = user_role(doc, root);
  if role < 0 { return Field::Defect(role); }
  if role != 1 { return Field::Missing; }
  return user_text(doc);
}

// 4.3e-J: the blank check runs on the borrowed view and only a nonblank title is copied (hand `take_string`
// borrows the value); an escaped node is decoded first.
fn title_key(doc: crate::json::JsonDocument, id: i64, key: str) -> Field ! alloc
  requires crate::json::doc_strings(doc)
  ensures is_variant(result, Field::Value) ==> len(variant_field(result, Field::Value, text)) <= 50331648
{
  let n: i64 = string_id(doc, id, key);
  if n == -1 { return Field::Missing; }
  if n < 0 { return Field::Defect(n); }
  let pv: Option<ref str> = crate::access::plain_str(doc, n);
  match pv {
    Some(v) => {
      if len(v) > 50331648 { return Field::Defect(-4); }
      if crate::text::is_blank(v) { return Field::Missing; }
      return Field::Value(copy(v));
    }
    None => {}
  }
  let f: Field = string_field(doc, id, key);
  match f {
    Field::Value(v) => {
      if crate::text::is_blank(v) { return Field::Missing; }
      return Field::Value(move v);
    }
    Field::Missing => { return Field::Missing; }
    Field::Defect(e) => { return Field::Defect(e); }
  }
}

// hand: a system line's custom title (the caller matched type "system").
pub fn custom_title(doc: crate::json::JsonDocument) -> Title ! alloc
  requires crate::json::doc_strings(doc)
  ensures is_variant(result, Title::Found) ==> len(variant_field(result, Title::Found, text)) <= 50331648
{
  let root: i64 = crate::access::root(doc);
  let sub: i64 = field_is(doc, root, "subtype", "custom_title");
  if sub < 0 { return Title::Defect(sub); }
  if sub != 1 { return Title::NoTitle; }
  let payload: i64 = object_field(doc, root, "systemPayload");
  if payload == -1 { return Title::NoTitle; }
  if payload < 0 { return Title::Defect(-4); }
  let f: Field = title_key(doc, payload, "customTitle");
  match f {
    Field::Value(v) => { return Title::Found(move v); }
    Field::Missing => { return Title::NoTitle; }
    Field::Defect(e) => { return Title::Defect(e); }
  }
}

// hand edge.rs tail_import: type "system", then the custom title.
pub fn title_of(doc: crate::json::JsonDocument) -> Title ! alloc
  requires crate::json::doc_strings(doc)
  ensures is_variant(result, Title::Found) ==> len(variant_field(result, Title::Found, text)) <= 50331648
{
  let ty: i64 = field_is(doc, crate::access::root(doc), "type", "system");
  if ty < 0 { return Title::Defect(ty); }
  if ty != 1 { return Title::NoTitle; }
  return custom_title(doc);
}
