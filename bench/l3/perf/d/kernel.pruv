// Leg D kernel: the core of the req list bound search as one pure call (bench/l3/perf/REQ_THREEWAY.md).
// For each item (engine, thread) return the index of the first non-temporary session that has a candidate with the same
// engine and thread, or -1. The same flat layouts are used by hand.rs and ts_kernel.mjs.
//   INT: sess = per session [temporary, eng0, thr0, ..., eng(k-1), thr(k-1)] (stride 1 + 2k); items = [eng, thr] per item.
//   STR: sess = per session [temporary, then per candidate eng, thread offset, thread length] (stride 1 + 3k);
//        items = [eng, offset, length] per item; offsets point into pool (one UTF-16 unit per word).

pub fn bound_int(sess: [i64], k: i64, items: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let ns: i64 = len(sess);
  let ni: i64 = len(items);
  if k < 1 || k > 64 || ns > 1000000000 || ni > 1000000 { return alloc(0, 0); }
  let w: i64 = 1 + 2 * k;
  let m: i64 = ni / 2;
  let mut out: [i64] = alloc(m, -1);
  let mut j: i64 = 0;
  while j < m
    invariant 0 <= j && j <= m && 2 * m <= ni && ni == len(items) && len(out) == m && ns == len(sess)
    invariant w == 1 + 2 * k && 1 <= k && k <= 64 && ns <= 1000000000
    decreases m - j
  {
    let e: i64 = items[2 * j];
    let t: i64 = items[2 * j + 1];
    let mut found: i64 = -1;
    let mut s: i64 = 0;
    let mut b: i64 = 0;
    while b + w <= ns && found < 0
      invariant 0 <= b && b <= ns && 0 <= s && s <= b && ns == len(sess) && w == 1 + 2 * k && 1 <= k && k <= 64 && ns <= 1000000000
      decreases ns - b
    {
      if sess[b] == 0 {
        let mut c: i64 = 0;
        while c < k
          invariant 0 <= c && c <= k && b + w <= ns && 0 <= b && ns == len(sess) && w == 1 + 2 * k
          decreases k - c
        {
          if sess[b + 1 + 2 * c] == e && sess[b + 2 + 2 * c] == t {
            found = s;
            c = k;
          } else {
            c = c + 1;
          }
        }
      }
      s = s + 1;
      b = b + w;
    }
    out[j] = found;
    j = j + 1;
  }
  return out;
}

// pool[a .. a+l) == pool[b .. b+l), false when either range is outside the pool
fn same(pool: [i64], a: i64, b: i64, l: i64) -> bool
{
  let np: i64 = len(pool);
  if a < 0 || b < 0 || l < 0 || np > 1000000000 || a > np || b > np || l > np - a || l > np - b { return false; }
  let mut u: i64 = 0;
  while u < l
    invariant 0 <= u && u <= l && 0 <= a && 0 <= b && a + l <= np && b + l <= np && np == len(pool)
    decreases l - u
  {
    if pool[a + u] != pool[b + u] { return false; }
    u = u + 1;
  }
  return true;
}

pub fn bound_str(sess: [i64], k: i64, items: [i64], pool: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let ns: i64 = len(sess);
  let ni: i64 = len(items);
  if k < 1 || k > 64 || ns > 1000000000 || ni > 1000000 { return alloc(0, 0); }
  let w: i64 = 1 + 3 * k;
  let m: i64 = ni / 3;
  let mut out: [i64] = alloc(m, -1);
  let mut j: i64 = 0;
  while j < m
    invariant 0 <= j && j <= m && 3 * m <= ni && ni == len(items) && len(out) == m && ns == len(sess)
    invariant w == 1 + 3 * k && 1 <= k && k <= 64 && ns <= 1000000000
    decreases m - j
  {
    let e: i64 = items[3 * j];
    let io: i64 = items[3 * j + 1];
    let il: i64 = items[3 * j + 2];
    let mut found: i64 = -1;
    let mut s: i64 = 0;
    let mut b: i64 = 0;
    while b + w <= ns && found < 0
      invariant 0 <= b && b <= ns && 0 <= s && s <= b && ns == len(sess) && w == 1 + 3 * k && 1 <= k && k <= 64 && ns <= 1000000000
      decreases ns - b
    {
      if sess[b] == 0 {
        let mut c: i64 = 0;
        while c < k
          invariant 0 <= c && c <= k && b + w <= ns && 0 <= b && ns == len(sess) && w == 1 + 3 * k
          decreases k - c
        {
          let p: i64 = b + 1 + 3 * c;
          if sess[p] == e && sess[p + 2] == il && same(pool, sess[p + 1], io, il) {
            found = s;
            c = k;
          } else {
            c = c + 1;
          }
        }
      }
      s = s + 1;
      b = b + w;
    }
    out[j] = found;
    j = j + 1;
  }
  return out;
}
