// L3-8 entry packet layer (DESIGN.md section 2 and 3, host.rs is the wire authority).
//
//   packet  = [1, kind, op_id, seq, len, op, nsec, len_0..len_{nsec-1}, section data...]       total words = 5 + len
//   section 0 = UTF-16 pool, section 1 = record, sections >= 2 = tables (input/completion) or
//   state (2) / emitted rows (3) / request or result tables (>= 4) in await and done packets.
//   VS (value slot) = [tag, a, b], 3 words (see the tag list in DESIGN 2.2).
//
// Everything is index-total (u16::rd / u16::wr): validation happens first, so the accessors are defence in depth.
// `meta` (an [i64] of 2 * nsec + 3 words made by new_meta; layout at new_meta) tracks while a packet record is checked:
//   meta[0]       highest pool unit referenced by any string slot (pool_hi)
//   meta[1 + s]   1 once section s has been claimed by a table slot
// A table section must be claimed exactly once.

// ---- constants (no consts in Pruv: nullary functions) ----
pub fn max_words() -> i64 ensures result == 16777216 { return 16777216; }
pub fn pos_cap() -> i64 ensures result == 1000000000 { return 1000000000; }

// tag masks: bit t set = tag t allowed
pub fn m_any() -> i64 ensures result == 1647 { return 1647; }       // 0 1 2 3 5 6 9 10
pub fn m_thread() -> i64 ensures result == 3075 { return 3075; }    // 0 1 10 11
pub fn m_forks() -> i64 ensures result == 1155 { return 1155; }     // 0 1 10 7
pub fn m_ets() -> i64 ensures result == 1283 { return 1283; }       // 0 1 10 8
pub fn m_bound() -> i64 ensures result == 3183 { return 3183; }     // 0 1 2 3 5 6 10 11
pub fn m_bool() -> i64 ensures result == 12 { return 12; }          // 2 3
pub fn m_str() -> i64 ensures result == 64 { return 64; }           // 6
pub fn m_arr() -> i64 ensures result == 128 { return 128; }         // 7
pub fn m_ref() -> i64 ensures result == 512 { return 512; }         // 9
pub fn m_undef() -> i64 ensures result == 1 { return 1; }           // 0
pub fn m_ustr() -> i64 ensures result == 65 { return 65; }          // 0 6
pub fn m_proto() -> i64 ensures result == 16 { return 16; }         // 4

pub fn rd(w: [i64], i: i64) -> i64 { return crate::u16::rd(w, i); }

// ---- sections ----
pub fn nsec(w: [i64]) -> i64
  ensures 0 <= result && result <= 1000000
{
  return crate::u16::clamp(crate::u16::rd(w, 6), 1000000);
}

// length of section i (0 for an index out of range)
pub fn sec_len(w: [i64], i: i64) -> i64
  ensures 0 <= result && result <= 16777216
{
  if i < 0 || i >= nsec(w) { return 0; }
  return crate::u16::clamp(crate::u16::rd(w, 7 + i), 16777216);
}

// absolute index in w of the first word of section i (0 <= i <= nsec); clamped into 0..2^25 (a valid packet never reaches the clamp)
pub fn sec_start(w: [i64], i: i64) -> i64
  ensures 0 <= result && result <= 33554432
{
  let ns: i64 = nsec(w);
  let top: i64 = crate::u16::clamp(i, ns);
  let mut at: i64 = 7 + ns;
  let mut j: i64 = 0;
  while j < top
    invariant 0 <= j && j <= top && top <= ns && ns <= 1000000 && 0 <= at && at <= 1000007 + 16777216 * j
    decreases top - j
  {
    at = at + crate::u16::clamp(crate::u16::rd(w, 7 + j), 16777216);
    j = j + 1;
  }
  return crate::u16::clamp(at, 33554432);
}

// meta layout (length 2 * nsec + 3):
//   [0]                  pool high-water
//   [1 + s]              section s claimed (s < nsec)
//   [nsec + 1 + j]       offs[j] = sec_start(w, j) for 0 <= j <= nsec (built once, so a table check is O(1) per section lookup)
//   [len - 1]            bad flag
pub fn new_meta(w: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let ns: i64 = nsec(w);
  let mut m: [i64] = crate::u16::zeros(2 * ns + 3);
  let mut at: i64 = 7 + ns;
  let mut j: i64 = 0;
  while j <= ns
    invariant 0 <= j && j <= ns + 1 && ns <= 1000000 && 0 <= at && at <= 1000007 + 16777216 * j
    decreases ns + 1 - j
  {
    crate::u16::wr(inout m, ns + 1 + j, crate::u16::clamp(at, 33554432));
    if j < ns { at = at + crate::u16::clamp(crate::u16::rd(w, 7 + j), 16777216); }
    j = j + 1;
  }
  return m;
}

// same value as sec_start(w, i) (clamped index, clamped result), read from the offset table in meta (made by new_meta for this w)
pub fn sec_start_m(w: [i64], meta: [i64], i: i64) -> i64
  ensures 0 <= result && result <= 33554432
{
  let ns: i64 = nsec(w);
  let top: i64 = crate::u16::clamp(i, ns);
  return crate::u16::clamp(crate::u16::rd(meta, ns + 1 + top), 33554432);
}

// copy of the pool prefix that string slots reference (pool_hi from meta)
pub fn pool_used(w: [i64], meta: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let hi: i64 = crate::u16::clamp(crate::u16::rd(meta, 0), sec_len(w, 0));
  return crate::u16::slice(w, sec_start(w, 0), sec_start(w, 0) + hi);
}

// ---- envelope ----
// 0 ok, 1 InvalidPacket, 2 InputTooLarge. Structure only: version, kind, ids, section header, pool unit range.
pub fn env_check(w: [i64]) -> i64
{
  let n: i64 = len(w);
  if n > 16777216 { return 2; }
  if n < 7 { return 1; }
  if w[0] != 1 { return 1; }
  if w[1] < 0 || w[1] > 3 { return 1; }
  if w[2] < 1 { return 1; }
  if w[3] < 0 { return 1; }
  if w[4] != n - 5 { return 1; }
  if w[5] < 1 || w[5] > 9 { return 1; }
  let ns: i64 = w[6];
  if ns < 2 || ns > n - 7 { return 1; }
  let mut rest: i64 = n - 7 - ns;
  let mut i: i64 = 0;
  while i < ns
    invariant 0 <= i && i <= ns && ns <= n - 7 && n == len(w) && 0 <= rest
    decreases ns - i
  {
    let l: i64 = w[7 + i];
    if l < 0 || l > rest { return 1; }
    rest = rest - l;
    i = i + 1;
  }
  if rest != 0 { return 1; }
  let p0: i64 = sec_start(w, 0);
  let l0: i64 = sec_len(w, 0);
  let mut k: i64 = 0;
  while k < l0
    invariant 0 <= k && k <= l0 && 0 <= p0 && p0 <= 33554432 && l0 <= 16777216
    decreases l0 - k
  {
    let u: i64 = crate::u16::rd(w, p0 + k);
    if u < 0 || u > 65535 { return 1; }
    k = k + 1;
  }
  return 0;
}

// ---- value slots ----
pub fn in_mask(mask: i64, tag: i64) -> bool
{
  if tag < 0 || tag > 11 { return false; }
  return band(ushr(mask, tag), 1) == 1;
}

pub fn zero3(w: [i64], p0: i64) -> bool
{
  let p: i64 = crate::u16::clamp(p0, 1000000000);
  return crate::u16::rd(w, p) == 0 && crate::u16::rd(w, p + 1) == 0 && crate::u16::rd(w, p + 2) == 0;
}

pub fn zero_run(w: [i64], p0: i64, n0: i64) -> bool
{
  let p: i64 = crate::u16::clamp(p0, 1000000000);
  let n: i64 = crate::u16::clamp(n0, 1000000);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && 0 <= p && p <= 1000000000 && n <= 1000000
    decreases n - i
  {
    if crate::u16::rd(w, p + i) != 0 { return false; }
    i = i + 1;
  }
  return true;
}

// meta layout: [0] pool high-water, [1 + s] section s claimed, [len-1] bad flag. A failed check only sets the flag; the
// callers go on (every accessor is total) and the flag is read once at the end.
pub fn setbad(inout meta: [i64]) -> ()
{
  let n: i64 = len(meta);
  crate::u16::wr(inout meta, n - 1, 1);
}

pub fn is_bad(meta: [i64]) -> bool
{
  return crate::u16::rd(meta, len(meta) - 1) != 0;
}

// 0 invalid, 1 ok (nothing to record), 2 ok string slot (record pool high-water), 3 ok table slot (claim section a)
pub fn vs_ok(w: [i64], p0: i64, mask: i64, width0: i64, meta: [i64]) -> i64
{
  let p: i64 = crate::u16::clamp(p0, 1000000000);
  let width: i64 = crate::u16::clamp(width0, 64);
  let tag: i64 = crate::u16::rd(w, p);
  let a: i64 = crate::u16::rd(w, p + 1);
  let b: i64 = crate::u16::rd(w, p + 2);
  if !in_mask(mask, tag) { return 0; }
  if tag <= 3 || tag == 10 || tag == 11 {
    if a == 0 && b == 0 { return 1; }
    return 0;
  }
  if tag == 4 {
    if b == 0 { return 1; }
    return 0;
  }
  if tag == 5 {
    if a >= 0 && a <= 4294967295 && b >= 0 && b <= 4294967295 { return 1; }
    return 0;
  }
  if tag == 6 {
    let pl: i64 = sec_len(w, 0);
    if a < 0 || b < 0 || a > pl || b > pl - a { return 0; }
    return 2;
  }
  if tag == 9 {
    if a >= 1 && b == 0 { return 1; }
    return 0;
  }
  // tags 7 and 8
  if width <= 0 { return 0; }
  let ns: i64 = nsec(w);
  if a < 2 || a >= ns { return 0; }
  if b < 0 || b > 16777216 { return 0; }
  if crate::u16::rd(w, 7 + a) != b * width { return 0; }
  if crate::u16::rd(meta, 1 + a) != 0 { return 0; }
  return 3;
}

// Check the slot at absolute position p against a tag mask. width > 0: a table slot (tag 7/8) whose section must hold
// exactly count * width words; the section is claimed. width == 0: table tags are rejected.
pub fn vs(w: [i64], p0: i64, mask: i64, width: i64, inout meta: [i64]) -> ()
{
  let p: i64 = crate::u16::clamp(p0, 1000000000);
  let r: i64 = vs_ok(w, p, mask, width, meta);
  if r == 0 { setbad(inout meta); return; }
  if r == 2 {
    let hi: i64 = crate::u16::clamp(crate::u16::rd(w, p + 1), 4294967296) + crate::u16::clamp(crate::u16::rd(w, p + 2), 4294967296);
    if hi > crate::u16::rd(meta, 0) { crate::u16::wr(inout meta, 0, hi); }
  }
  if r == 3 { crate::u16::wr(inout meta, 1 + crate::u16::clamp(crate::u16::rd(w, p + 1), 4294967296), 1); }
}

// every table section (>= 2) was claimed
pub fn all_claimed(w: [i64], meta: [i64]) -> bool
{
  let ns: i64 = nsec(w);
  let mut s: i64 = 0;
  while s < ns
    invariant 0 <= s && s <= ns && ns <= 1000000
    decreases ns - s
  {
    if s >= 2 && crate::u16::rd(meta, 1 + s) != 1 { return false; }
    s = s + 1;
  }
  return true;
}

// ---- record checks ----

// rows of width 3 (one VS each, tags in mask) in the table slot at p; the slot itself was already checked
fn rows1_check(w: [i64], p0: i64, mask: i64, inout meta: [i64]) -> ()
{
  let p: i64 = crate::u16::clamp(p0, 1000000000);
  if crate::u16::rd(w, p) != 7 { return; }
  let sec: i64 = crate::u16::rd(w, p + 1);
  let cnt: i64 = crate::u16::clamp(crate::u16::rd(w, p + 2), 16777216);
  let base: i64 = sec_start_m(w, meta, sec);
  let mut i: i64 = 0;
  while i < cnt
    invariant 0 <= i && i <= cnt && cnt <= 16777216 && 0 <= base && base <= 33554432
    decreases cnt - i
  {
    vs(w, base + 3 * i, mask, 0, inout meta);
    i = i + 1;
  }
}

// engineThreads entry rows: key {6}, bound {0,1,2,3,5,6,10,11}, threadId (any if bound is 11, else zero slot)
fn ets_check(w: [i64], p0: i64, inout meta: [i64]) -> ()
{
  let p: i64 = crate::u16::clamp(p0, 1000000000);
  if crate::u16::rd(w, p) != 8 { return; }
  let sec: i64 = crate::u16::rd(w, p + 1);
  let cnt: i64 = crate::u16::clamp(crate::u16::rd(w, p + 2), 16777216);
  let base: i64 = sec_start_m(w, meta, sec);
  let mut i: i64 = 0;
  while i < cnt
    invariant 0 <= i && i <= cnt && cnt <= 16777216 && 0 <= base && base <= 33554432
    decreases cnt - i
  {
    let q: i64 = base + 9 * i;
    vs(w, q, m_str(), 0, inout meta);
    vs(w, q + 3, m_bound(), 0, inout meta);
    if crate::u16::rd(w, q + 3) == 11 {
      vs(w, q + 6, m_any(), 0, inout meta);
    } else {
      if !zero3(w, q + 6) { setbad(inout meta); }
    }
    i = i + 1;
  }
}

// one session record (10 slots = 30 words) at absolute position p
pub fn session_check(w: [i64], p0: i64, inout meta: [i64]) -> ()
{
  let p: i64 = crate::u16::clamp(p0, 1000000000);
  vs(w, p, m_any(), 0, inout meta);
  vs(w, p + 3, m_any(), 0, inout meta);
  vs(w, p + 6, m_any(), 0, inout meta);
  vs(w, p + 9, m_thread(), 0, inout meta);
  if crate::u16::rd(w, p + 9) == 11 {
    vs(w, p + 12, m_any(), 0, inout meta);
    vs(w, p + 15, m_any(), 0, inout meta);
    vs(w, p + 18, m_forks(), 3, inout meta);
    rows1_check(w, p + 18, m_any(), inout meta);
  } else {
    if !zero_run(w, p + 12, 9) { setbad(inout meta); }
  }
  vs(w, p + 21, m_thread(), 0, inout meta);
  if crate::u16::rd(w, p + 21) == 11 {
    vs(w, p + 24, m_any(), 0, inout meta);
  } else {
    if !zero3(w, p + 24) { setbad(inout meta); }
  }
  vs(w, p + 27, m_ets(), 9, inout meta);
  ets_check(w, p + 27, inout meta);
}

// Input record check for ops 2,3,4,7,8,9 (kind 0, envelope already ok). true = valid.
pub fn input_check(w: [i64]) -> i64 ! alloc
{
  let op: i64 = crate::u16::rd(w, 5);
  let mut meta: [i64] = new_meta(w);
  let r0: i64 = sec_start(w, 1);
  let rl: i64 = sec_len(w, 1);
  if op == 2 {
    if rl != 6 { return -1; }
    vs(w, r0, m_any(), 0, inout meta);
    vs(w, r0 + 3, m_arr(), 3, inout meta);
    rows1_check(w, r0 + 3, m_any(), inout meta);
  } else if op == 3 {
    if rl != 12 { return -1; }
    vs(w, r0, m_any(), 0, inout meta);
    vs(w, r0 + 3, m_ref(), 0, inout meta);
    vs(w, r0 + 6, m_any(), 0, inout meta);
    vs(w, r0 + 9, m_ref(), 0, inout meta);
  } else if op == 4 {
    if rl != 15 { return -1; }
    vs(w, r0, m_any(), 0, inout meta);
    vs(w, r0 + 3, m_ref(), 0, inout meta);
    vs(w, r0 + 6, m_any(), 0, inout meta);
    vs(w, r0 + 9, m_any(), 0, inout meta);
    vs(w, r0 + 12, m_ref(), 0, inout meta);
  } else if op == 7 || op == 8 {
    if rl != 30 { return -1; }
    session_check(w, r0, inout meta);
  } else if op == 9 {
    if rl != 3 { return -1; }
    vs(w, r0, m_arr(), 30, inout meta);
    let cnt: i64 = crate::u16::clamp(crate::u16::rd(w, r0 + 2), 16777216);
    let base: i64 = sec_start_m(w, meta, crate::u16::rd(w, r0 + 1));
    let mut i: i64 = 0;
    while i < cnt
      invariant 0 <= i && i <= cnt && cnt <= 16777216 && 0 <= base && base <= 33554432
      decreases cnt - i
    {
      session_check(w, base + 30 * i, inout meta);
      i = i + 1;
    }
  } else {
    return -1;
  }
  if is_bad(meta) || !all_claimed(w, meta) { return -1; }
  return crate::u16::clamp(crate::u16::rd(meta, 0), sec_len(w, 0));
}

// error observation E (6 slots = 18 words) at p: valueRef {9}, isEngineImportError {2,3}, isError {2,3}, name any,
// message ({6} if isError is true, else {0}), code any
pub fn err_check(w: [i64], p0: i64, inout meta: [i64]) -> ()
{
  let p: i64 = crate::u16::clamp(p0, 1000000000);
  vs(w, p, m_ref(), 0, inout meta);
  vs(w, p + 3, m_bool(), 0, inout meta);
  vs(w, p + 6, m_bool(), 0, inout meta);
  vs(w, p + 9, m_any(), 0, inout meta);
  if crate::u16::rd(w, p + 6) == 3 {
    vs(w, p + 12, m_str(), 0, inout meta);
  } else {
    vs(w, p + 12, m_undef(), 0, inout meta);
  }
  vs(w, p + 15, m_any(), 0, inout meta);
}

// Completion record check for the outstanding request `rcode` (1..9). aux: for 8 the number of ids sent, for 9 the opKind
// (0 list / 1 read). Envelope already ok. host.rs is the layout authority.
pub fn comp_check(w: [i64], rcode: i64, aux: i64) -> i64 ! alloc
{
  let mut meta: [i64] = new_meta(w);
  let r0: i64 = sec_start(w, 1);
  let rl: i64 = sec_len(w, 1);
  if rl < 1 { return -1; }
  let st: i64 = crate::u16::rd(w, r0);
  if rcode != 8 && st != 0 && st != 1 { return -1; }
  if rcode == 1 {
    if st == 1 {
      if rl != 19 { return -1; }
      err_check(w, r0 + 1, inout meta);
    } else {
      if rl != 2 { return -1; }
      let cnt: i64 = crate::u16::rd(w, r0 + 1);
      if cnt < 0 || cnt > 16777216 { return -1; }
    }
  } else if rcode == 2 {
    if st != 0 || rl != 8 { return -1; }
    let kind: i64 = crate::u16::rd(w, r0 + 1);
    if kind != 0 && kind != 1 { return -1; }
    vs(w, r0 + 2, m_any(), 0, inout meta);
    vs(w, r0 + 5, m_any(), 0, inout meta);
  } else if rcode == 3 {
    if st != 0 || rl != 4 { return -1; }
    vs(w, r0 + 1, m_ustr(), 0, inout meta);
  } else if rcode == 4 || rcode == 5 || rcode == 6 {
    if st == 1 {
      if rl != 19 { return -1; }
      err_check(w, r0 + 1, inout meta);
    } else {
      if rl != 4 { return -1; }
      vs(w, r0 + 1, m_str(), 0, inout meta);
    }
  } else if rcode == 7 {
    if st == 1 {
      if rl != 19 { return -1; }
      err_check(w, r0 + 1, inout meta);
    } else {
      if rl != 7 { return -1; }
      vs(w, r0 + 1, m_str(), 0, inout meta);
      vs(w, r0 + 4, m_str(), 0, inout meta);
    }
  } else if rcode == 8 {
    // [0, results {7} rows of one any, thrown 0/1, E (18 words)]
    if rl != 23 || st != 0 { return -1; }
    vs(w, r0 + 1, m_arr(), 3, inout meta);
    rows1_check(w, r0 + 1, m_any(), inout meta);
    let thrown: i64 = crate::u16::rd(w, r0 + 4);
    let n: i64 = crate::u16::rd(w, r0 + 3);
    if thrown == 0 {
      if n != aux { return -1; }
      if !zero_run(w, r0 + 5, 18) { return -1; }
    } else if thrown == 1 {
      if n >= aux { return -1; }
      err_check(w, r0 + 5, inout meta);
    } else {
      return -1;
    }
  } else if rcode == 9 {
    if st == 1 {
      if rl != 19 { return -1; }
      err_check(w, r0 + 1, inout meta);
    } else {
      if rl != 4 { return -1; }
      if aux == 0 {
        vs(w, r0 + 1, m_arr(), 6, inout meta);
        // rows [rowRef {9}, title {6}]
        let sec: i64 = crate::u16::rd(w, r0 + 2);
        let cnt: i64 = crate::u16::clamp(crate::u16::rd(w, r0 + 3), 16777216);
        let base: i64 = sec_start_m(w, meta, sec);
        let mut i: i64 = 0;
        while i < cnt
          invariant 0 <= i && i <= cnt && cnt <= 16777216 && 0 <= base && base <= 33554432
          decreases cnt - i
        {
          vs(w, base + 6 * i, m_ref(), 0, inout meta);
          vs(w, base + 6 * i + 3, m_str(), 0, inout meta);
          i = i + 1;
        }
      } else {
        vs(w, r0 + 1, m_ref(), 0, inout meta);
      }
    }
  } else {
    return -1;
  }
  if is_bad(meta) || !all_claimed(w, meta) { return -1; }
  return crate::u16::clamp(crate::u16::rd(meta, 0), sec_len(w, 0));
}

// ---- builders ----
pub fn put_vs(inout o: [i64], at0: i64, tag: i64, a: i64, b: i64) -> ()
  ensures len(o) == len(old(o))
{
  let at: i64 = crate::u16::clamp(at0, 1000000000);
  crate::u16::wr(inout o, at, tag);
  crate::u16::wr(inout o, at + 1, a);
  crate::u16::wr(inout o, at + 2, b);
}

// A boundary done packet: [5, code] with an empty pool; sections pool, record, state, rows (4, host minimum).
// code 0 InvalidPacket, 1 InputTooLarge, 2 InternalInvariant. op 0 when unknown.
pub fn boundary(op: i64, op_id: i64, code: i64) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let mut o: [i64] = crate::u16::zeros(15);
  let mut id: i64 = op_id;
  if id < 1 { id = 1; }
  let mut c: i64 = code;
  if c < 0 || c > 2 { c = 2; }
  let mut p: i64 = op;
  if p < 0 || p > 9 { p = 0; }
  crate::u16::wr(inout o, 0, 1);
  crate::u16::wr(inout o, 1, 3);
  crate::u16::wr(inout o, 2, id);
  crate::u16::wr(inout o, 3, 0);
  crate::u16::wr(inout o, 4, 8);
  crate::u16::wr(inout o, 5, p);
  crate::u16::wr(inout o, 6, 4);
  crate::u16::wr(inout o, 7, 0);
  crate::u16::wr(inout o, 8, 2);
  crate::u16::wr(inout o, 9, 0);
  crate::u16::wr(inout o, 10, 0);
  crate::u16::wr(inout o, 11, 5);
  crate::u16::wr(inout o, 12, c);
  return crate::u16::slice(o, 0, 13);
}

// Assemble a packet. Sections: pool, rec, state, rows, then one table when ntab != 0 (else tab is ignored).
// An output that would exceed 16,777,216 words becomes a done packet with InputTooLarge, never a truncation.
pub fn mk_packet(kind: i64, op_id: i64, seq: i64, op: i64, pool: [i64], rec: [i64], state: [i64], rows: [i64], tab: [i64], ntab: i64) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let lp: i64 = len(pool);
  let lr: i64 = len(rec);
  let ls: i64 = len(state);
  let lw: i64 = len(rows);
  let mut lt: i64 = len(tab);
  let mut ns: i64 = 5;
  if ntab == 0 { lt = 0; ns = 4; }
  if lp > 16777216 || lr > 16777216 || ls > 16777216 || lw > 16777216 || lt > 16777216 { return boundary(op, op_id, 1); }
  let total: i64 = 5 + 2 + ns + lp + lr + ls + lw + lt;
  if total > 16777216 { return boundary(op, op_id, 1); }
  let mut o: [i64] = crate::u16::zeros(total);
  crate::u16::wr(inout o, 0, 1);
  crate::u16::wr(inout o, 1, kind);
  crate::u16::wr(inout o, 2, op_id);
  crate::u16::wr(inout o, 3, seq);
  crate::u16::wr(inout o, 4, total - 5);
  crate::u16::wr(inout o, 5, op);
  crate::u16::wr(inout o, 6, ns);
  crate::u16::wr(inout o, 7, lp);
  crate::u16::wr(inout o, 8, lr);
  crate::u16::wr(inout o, 9, ls);
  crate::u16::wr(inout o, 10, lw);
  let mut at: i64 = 11;
  if ns == 5 { crate::u16::wr(inout o, 11, lt); at = 12; }
  let r_pool: i64 = crate::u16::put_all(inout o, at, pool);
  at = crate::u16::clamp(r_pool, 4294967296);
  let r_rec: i64 = crate::u16::put_all(inout o, at, rec);
  at = crate::u16::clamp(r_rec, 4294967296);
  let r_state: i64 = crate::u16::put_all(inout o, at, state);
  at = crate::u16::clamp(r_state, 4294967296);
  let r_rows: i64 = crate::u16::put_all(inout o, at, rows);
  at = crate::u16::clamp(r_rows, 4294967296);
  if ns == 5 {
    let r_t: i64 = crate::u16::put_all(inout o, at, tab);
    at = crate::u16::clamp(r_t, 4294967296);
  }
  return o;
}

pub fn empty_state() -> [i64] ! alloc ensures len(result) == 0 { return crate::u16::empty(); }
