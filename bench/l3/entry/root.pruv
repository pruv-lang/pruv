// L3-8 entry root: thin forwarder. DB8: section 0 crosses the boundary as the packed WTF-8 pool (ent_wire). The verified code lives in bench/l3/lib (ent_* modules and entry_api); compile with --lib bench/l3/lib.
// Rust-shape reset step 3.8: same structure as lib/hand/entry_root.rs, function by function.
mod ent_u16;
mod ent_packet;
mod ent_value;
mod ent_state;
mod ent_dispatch;
mod ent_bound;
mod ent_sources;
mod ent_canon;
mod ent_accounts;
mod ent_path;
mod entry_api;
mod ent_wire;

pub fn entry_begin(input: [i64]) -> [i64] ! alloc
{
  return crate::entry_api::entry_begin_with_env(input, crate::ent_packet::env_check_wire(input));
}

pub fn entry_step(prev: [i64], completion: [i64]) -> [i64] ! alloc
{
  return crate::entry_api::entry_step_at(prev, completion, true);
}

pub fn index_begin(inout progress: [i64], input: [i64]) -> [i64] ! alloc
{
  return crate::entry_api::index_begin(inout progress, input);
}

pub fn index_step(inout progress: [i64], input: [i64], prev: [i64], emitted: [i64], completion: [i64]) -> [i64] ! alloc
{
  if !crate::ent_wire::wire_in(input) {
    return crate::entry_api::index_step(inout progress, crate::ent_wire::poison(input), prev, emitted, completion);
  }
  return crate::entry_api::index_step(inout progress, input, prev, emitted, completion);
}
