// L3-8 entry root: thin forwarder. DB8: section 0 crosses the boundary as the packed WTF-8 pool (ent_wire). The verified code lives in bench/l3/lib (ent_* modules and entry_api); compile with --lib bench/l3/lib.
mod ent_u16;
mod ent_packet;
mod ent_value;
mod ent_state;
mod ent_dispatch;
mod ent_bound;
mod ent_sources;
mod ent_canon;
mod ent_accounts;
mod ent_path;
mod entry_api;
mod ent_wire;

pub fn entry_begin(input: [i64]) -> [i64] ! alloc
{
  return crate::ent_wire::wire_out(crate::entry_api::entry_begin(crate::ent_wire::wire_in(input)));
}

pub fn entry_step(prev: [i64], completion: [i64]) -> [i64] ! alloc
{
  return crate::ent_wire::wire_out(crate::entry_api::entry_step(crate::ent_wire::wire_in(prev), crate::ent_wire::wire_in(completion)));
}

pub fn index_begin(inout progress: [i64], input: [i64]) -> [i64] ! alloc
{
  return crate::ent_wire::wire_out(crate::entry_api::index_begin(inout progress, crate::ent_wire::wire_in(input)));
}

pub fn index_step(inout progress: [i64], input: [i64], prev: [i64], emitted: [i64], completion: [i64]) -> [i64] ! alloc
{
  // DB12: the adapter passes back the emitted await as both prev and emitted; equal wire words decode to equal packets,
  // so decode it once (different words still decode separately and entry_api compares them as before).
  let n: i64 = len(prev);
  if n == len(emitted) && eq_range(prev, 0, emitted, 0, n) {
    let e: [i64] = crate::ent_wire::wire_in(emitted);
    return crate::ent_wire::wire_out(crate::entry_api::index_step(inout progress, crate::ent_wire::wire_in(input), e, e, crate::ent_wire::wire_in(completion)));
  }
  return crate::ent_wire::wire_out(crate::entry_api::index_step(inout progress, crate::ent_wire::wire_in(input), crate::ent_wire::wire_in(prev), crate::ent_wire::wire_in(emitted), crate::ent_wire::wire_in(completion)));
}
