// L3-8 entry: exact port of Node v26.4.0 path.posix over UTF-16 unit buffers ([i64], each element 0..65535; '/' = 47, '.' = 46).
// Pure functions: is_abs, normalize_string (Node internal, '/' separator), normalize, join2/3/4, join_segs, dirname, basename.
//
// resolve with ONE argument p is split around the process.cwd() observation. Node 26.4.0 calls cwd:
//   p absolute ('/' first)            : 0 times; result = "/" + normalizeString(p + "/", false)
//   p == "" or p == "."  (fast path)  : cwd1 first. If cwd1 starts with '/', the result is cwd1 verbatim (1 call).
//                                       Otherwise the general path calls cwd a 2nd time (cwd2); resolved = cwd2 + "/" + ("" or "./").
//   any other relative p              : exactly 1 call (cwd1); resolved = cwd1 + "/" + p + "/".
// In the general path the result is "/" + normalizeString(resolved, false) when the used cwd starts with '/', else
// normalizeString(resolved, true) or "." when empty (relative or empty cwd).
// API (ncwd = number of cwd results already obtained, cwd1/cwd2 their values; unused ones may be empty):
//   resolve_needs_first_cwd(p)               true iff ncwd == 0 needs a call (== !is_abs(p))
//   resolve_need(p, ncwd, cwd1, cwd2)        true iff one more cwd call is needed after ncwd calls (ncwd 0, 1, 2)
//   resolve_finish(p, ncwd, cwd1, cwd2)      the result once resolve_need is false
// A cwd call that throws escapes resolve in Node; the caller handles that before calling these.

pub fn is_abs(p: [i64]) -> bool
{
  return crate::u16::rd(p, 0) == 47 && len(p) > 0;
}

// copy m units of p starting at s into o at position at (all clamped); returns the new end position
fn copy_into(inout o: [i64], at: i64, p: [i64], s: i64, m: i64) -> i64
  requires 0 <= at && at <= 4294967296 && 0 <= s && s <= 4294967296
  ensures len(o) == len(old(o)) && at <= result && result <= at + 1073741824
{
  let mut mm: i64 = m;
  if mm < 0 { mm = 0; }
  if mm > 1073741824 { mm = 1073741824; }
  let mut k: i64 = 0;
  while k < mm
    invariant 0 <= k && k <= mm && mm <= 1073741824 && 0 <= at && at <= 4294967296 && 0 <= s && s <= 4294967296
    decreases mm - k
  {
    crate::u16::wr(inout o, at + k, crate::u16::rd(p, s + k));
    k = k + 1;
  }
  return at + mm;
}

// last index of '/' in a[0..u), or -1
fn last_slash_idx(a: [i64], u: i64) -> i64
  ensures result >= -1 && result < u
  requires 0 <= u
{
  let mut k: i64 = u;
  while k > 0
    invariant 0 <= k && k <= u
    decreases k
  {
    if crate::u16::rd(a, k - 1) == 47 { return k - 1; }
    k = k - 1;
  }
  return -1;
}

// Node internal normalizeString(path, allowAboveRoot, '/', isPosixPathSeparator)
pub fn normalize_string(p: [i64], allow_above_root: bool) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let n: i64 = len(p);
  if n > 1073741823 { return crate::u16::empty(); }
  let cap: i64 = 2 * n + 8;
  let mut res: [i64] = alloc(cap, 0);
  let mut u: i64 = 0;          // res.length
  let mut lsl: i64 = 0;        // lastSegmentLength
  let mut last_slash: i64 = -1;
  let mut dots: i64 = 0;
  let mut code: i64 = 0;
  let mut i: i64 = 0;
  while i <= n
    invariant 0 <= i && i <= n + 1 && n == len(p) && len(res) == cap && cap == 2 * n + 8 && 0 <= n && n <= 1073741823
      && 0 <= u && u <= cap && -1 <= last_slash && last_slash <= i && -1 <= dots && dots <= 3
    decreases n + 1 - i
  {
    let mut brk: bool = false;
    if i < n { code = crate::u16::rd(p, i); }
    else if code == 47 { brk = true; }
    else { code = 47; }
    if brk {
      i = n + 1;
    } else {
      if code == 47 {
        let mut cont: bool = false;
        if last_slash == i - 1 || dots == 1 {
          // NOOP
        } else if dots == 2 {
          let tail_dd: bool = u >= 2 && lsl == 2 && crate::u16::rd(res, u - 1) == 46 && crate::u16::rd(res, u - 2) == 46;
          if !tail_dd {
            if u > 2 {
              let li: i64 = last_slash_idx(res, u);
              if li == -1 {
                u = 0;
                lsl = 0;
              } else {
                u = li;
                lsl = u - 1 - last_slash_idx(res, u);
              }
              last_slash = i;
              dots = 0;
              cont = true;
            } else if u != 0 {
              u = 0;
              lsl = 0;
              last_slash = i;
              dots = 0;
              cont = true;
            }
          }
          if !cont && allow_above_root {
            if u > 0 {
              crate::u16::wr(inout res, u, 47);
              crate::u16::wr(inout res, u + 1, 46);
              crate::u16::wr(inout res, u + 2, 46);
              u = u + 3;
            } else {
              crate::u16::wr(inout res, 0, 46);
              crate::u16::wr(inout res, 1, 46);
              u = 2;
            }
            if u > cap { u = cap; }
            lsl = 2;
          }
        } else {
          let mut at: i64 = u;
          if u > 0 {
            crate::u16::wr(inout res, u, 47);
            at = u + 1;
          }
          u = copy_into(inout res, at, p, last_slash + 1, i - last_slash - 1);
          if u > cap { u = cap; }
          lsl = i - last_slash - 1;
        }
        if !cont {
          last_slash = i;
          dots = 0;
        }
      } else if code == 46 && dots != -1 {
        if dots < 3 { dots = dots + 1; }
      } else {
        dots = -1;
      }
      i = i + 1;
    }
  }
  return crate::u16::slice(res, 0, u);
}

pub fn normalize(p: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  if len(p) == 0 { return crate::u16::lit("."); }
  let absolute: bool = is_abs(p);
  let trailing: bool = crate::u16::rd(p, len(p) - 1) == 47;
  let r: [i64] = normalize_string(p, !absolute);
  if len(r) == 0 {
    if absolute { return crate::u16::lit("/"); }
    if trailing { return crate::u16::lit("./"); }
    return crate::u16::lit(".");
  }
  let mut x: [i64] = crate::u16::cat(r, crate::u16::empty());
  if trailing { x = crate::u16::cat(x, crate::u16::lit("/")); }
  if absolute { x = crate::u16::cat(crate::u16::lit("/"), x); }
  return x;
}

// raw join of two arguments: empty ones dropped, the rest joined with '/'
fn pjoin(a: [i64], b: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  if len(a) == 0 { return copy(b); }
  if len(b) == 0 { return copy(a); }
  return crate::u16::cat(crate::u16::cat(a, crate::u16::lit("/")), b);
}

pub fn join2(a: [i64], b: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  return normalize(pjoin(a, b));
}

pub fn join3(a: [i64], b: [i64], c: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  return normalize(pjoin(pjoin(a, b), c));
}

pub fn join4(a: [i64], b: [i64], c: [i64], d: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  return normalize(pjoin(pjoin(pjoin(a, b), c), d));
}

// join(base, ...segments) where segs holds non-empty '/'-free segments joined by '/' (empty segs: join(base))
pub fn join_segs(base: [i64], segs: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  return normalize(pjoin(base, segs));
}

pub fn dirname(p: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let n: i64 = len(p);
  if n == 0 { return crate::u16::lit("."); }
  let root: bool = crate::u16::rd(p, 0) == 47;
  let mut endp: i64 = -1;
  let mut matched: bool = true;
  let mut i: i64 = n - 1;
  while i >= 1 && endp == -1
    invariant 0 <= i && i <= n - 1 && n == len(p) && -1 <= endp
    decreases i
  {
    if crate::u16::rd(p, i) == 47 {
      if !matched { endp = i; }
    } else {
      matched = false;
    }
    i = i - 1;
  }
  if endp == -1 {
    if root { return crate::u16::lit("/"); }
    return crate::u16::lit(".");
  }
  if root && endp == 1 { return crate::u16::lit("//"); }
  return crate::u16::slice(p, 0, endp);
}

pub fn basename(p: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let n: i64 = len(p);
  let mut start: i64 = 0;
  let mut endp: i64 = -1;
  let mut matched: bool = true;
  let mut i: i64 = n - 1;
  let mut stop: bool = false;
  while i >= 0 && !stop
    invariant -1 <= i && i <= n - 1 && n == len(p) && 0 <= start && start <= n && -1 <= endp
    decreases i + 1
  {
    if crate::u16::rd(p, i) == 47 {
      if !matched {
        start = i + 1;
        stop = true;
      }
    } else if endp == -1 {
      matched = false;
      endp = i + 1;
    }
    i = i - 1;
  }
  if endp == -1 { return crate::u16::empty(); }
  return crate::u16::slice(p, start, endp);
}

// ---- resolve(p) with one argument, split around process.cwd() ----
pub fn resolve_needs_first_cwd(p: [i64]) -> bool
{
  return !is_abs(p);
}

fn is_fast(p: [i64]) -> bool
{
  return len(p) == 0 || (len(p) == 1 && crate::u16::rd(p, 0) == 46);
}

pub fn resolve_need(p: [i64], ncwd: i64, cwd1: [i64], cwd2: [i64]) -> bool
{
  if is_abs(p) { return false; }
  if ncwd <= 0 { return true; }
  if ncwd == 1 { return is_fast(p) && !is_abs(cwd1); }
  return false;
}

pub fn resolve_finish(p: [i64], ncwd: i64, cwd1: [i64], cwd2: [i64]) -> [i64] ! alloc
  ensures len(result) >= 0
{
  let mut resolved: [i64] = crate::u16::empty();
  let mut absolute: bool = true;
  if is_abs(p) {
    resolved = crate::u16::cat(p, crate::u16::lit("/"));
  } else {
    let mut c: [i64] = copy(cwd1);
    if ncwd >= 2 { c = copy(cwd2); }
    if ncwd == 1 && is_fast(p) && is_abs(cwd1) { return copy(cwd1); }
    let mut tail: [i64] = crate::u16::empty();
    if len(p) > 0 { tail = crate::u16::cat(p, crate::u16::lit("/")); }
    resolved = crate::u16::cat(crate::u16::cat(c, crate::u16::lit("/")), tail);
    absolute = is_abs(c);
  }
  let r: [i64] = normalize_string(resolved, !absolute);
  if absolute { return crate::u16::cat(crate::u16::lit("/"), r); }
  if len(r) > 0 { return r; }
  return crate::u16::lit(".");
}
