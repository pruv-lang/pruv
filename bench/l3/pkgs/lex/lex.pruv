// A1: absolute byte offsets. Each scanner moves the caller's cursor (`inout pos`, the hand `&mut self.pos`) and
// returns `Result<(), Fault>` (the hand `ParseResult<()>`); an error is `Fault { position, kind }` at the cursor.
// Literals blame the first mismatching byte; Unicode escapes the first nonhex byte.
// Missing required bytes: UnexpectedEof at end. Missing quote: UnterminatedString.
// Strings validate their own UTF-8 per scalar like the hand parser; validate_utf8 is std `from_utf8`.
// No string decoding here.
// The hand error `(usize, i64)`: the cursor and an A0 error kind (1..17).
pub struct Fault { position: i64, kind: i64 }

pub fn validate_utf8(input: [u8], start: i64, end: i64) -> i64
  requires 0 <= start && start <= end && end <= len(input)
  ensures result == -1 || (start <= result && result < end)
  ensures result == -1 ==> utf8_valid_span(input, start, end)
{
  let mut i: i64 = start;
  // Skip 16-byte all-ASCII blocks (a min reduction over 255 - byte, which the backend vectorizes).
  let mut ok: bool = true;
  while ok && i + 16 <= end
    invariant start <= i && i <= end && end <= len(input)
    invariant ok || start + 16 <= i
    invariant ok ==> utf8_valid_span(input, start, i)
    invariant !ok ==> utf8_valid_span(input, start, i - 16)
    decreases end - i
  {
    let mut m: i64 = 255;
    let mut k: i64 = 0;
    while k < 16
      invariant 0 <= k && k <= 16 && start <= i && i + 16 <= end && end <= len(input)
      invariant 0 <= m && m <= 255
      invariant forall j in 0..k: m <= 255 - input[i + j]
      decreases 16 - k
    { let r: i64 = 255 - input[i + k]; if r < m { m = r; } k = k + 1; }
    ok = m >= 128;
    i = i + 16;
  }
  if !ok { i = i - 16; }
  while i < end
    invariant start <= i && i <= end
    invariant utf8_valid_span(input, start, i)
    decreases end - i
  {
    let c: i64 = input[i];
    if c < 128 { i = i + 1; } else {
      let mut n: i64 = 0;
      if c >= 194 && c <= 223 { n = 2; }
      if c >= 224 && c <= 239 { n = 3; }
      if c >= 240 && c <= 244 { n = 4; }
      if n == 0 || end - i < n { return i; }
      let b: i64 = input[i + 1];
      if b < 128 || b > 191 { return i; }
      if c == 224 && b < 160 { return i; }
      if c == 237 && b >= 160 { return i; }
      if c == 240 && b < 144 { return i; }
      if c == 244 && b > 143 { return i; }
      let mut j: i64 = 2;
      while j < n
        invariant 2 <= j && j <= n && 2 <= n && n <= 4 && n <= end - i
        invariant start <= i && i < end && end <= len(input)
        invariant forall t in 2..j: (128 <= input[i + t] && input[i + t] <= 191)
        decreases n - j
      {
        let continuation: i64 = input[i + j];
        if continuation < 128 || continuation > 191 { return i; }
        j = j + 1;
      }
      i = i + n;
    }
  }
  return -1;
}

// The hand `whitespace(&mut self)`.
pub fn skip_whitespace(input: [u8], inout pos: i64, end: i64) -> ()
  requires 0 <= pos && pos <= end && end <= len(input)
  ensures old(pos) <= pos && pos <= end
{
  while pos < end
    invariant old(pos) <= pos && pos <= end
    decreases end - pos
  {
    let c: i64 = input[pos];
    if c != 32 && c != 9 && c != 10 && c != 13 { return; }
    pos = pos + 1;
  }
}

// The hand `literal(&mut self, literal: &[u8])`: `required()` per expected byte, error 12 at the first mismatch.
// The caller picks the literal from the first byte (hand `record`: `b't' => self.literal(b"true")?`).
pub fn scan_literal(input: [u8], inout pos: i64, end: i64, literal: [u8]) -> Result<(), Fault>
  requires 0 <= pos && pos <= end && end <= len(input) && 1 <= len(literal)
  ensures old(pos) <= pos && pos <= end
  ensures is_ok(result) ==> old(pos) < pos
  ensures !is_ok(result) ==> (err_val(result).position == pos && 0 < err_val(result).kind && err_val(result).kind <= 17)
{
  for expected in literal
    invariant old(pos) <= pos && pos <= end && pos - old(pos) == index(expected)
  {
    if pos == end { return Err::<(), Fault>(Fault { position: pos, kind: 5 }); }
    if input[pos] != expected { return Err::<(), Fault>(Fault { position: pos, kind: 12 }); }
    pos = pos + 1;
  }
  return Ok::<(), Fault>(());
}

// The hand `digits()`: one required digit, then the rest.
fn digits(input: [u8], inout pos: i64, end: i64) -> Result<(), Fault>
  requires 0 <= pos && pos <= end && end <= len(input)
  ensures old(pos) <= pos && pos <= end
  ensures is_ok(result) ==> old(pos) < pos
  ensures !is_ok(result) ==> (err_val(result).position == pos && 0 < err_val(result).kind && err_val(result).kind <= 17)
{
  if pos == end { return Err::<(), Fault>(Fault { position: pos, kind: 5 }); }
  let first: i64 = input[pos];
  if first < 48 || first > 57 { return Err::<(), Fault>(Fault { position: pos, kind: 13 }); }
  while pos < end
    invariant old(pos) <= pos && pos <= end
    invariant pos == old(pos) ==> (pos < end && 48 <= input[pos] && input[pos] <= 57)
    decreases end - pos
  {
    let c: i64 = input[pos];
    if c < 48 || c > 57 { return Ok::<(), Fault>(()); }
    pos = pos + 1;
  }
  return Ok::<(), Fault>(());
}

// The hand `number()`.
pub fn scan_number(input: [u8], inout pos: i64, end: i64) -> Result<(), Fault>
  requires 0 <= pos && pos <= end && end <= len(input)
  ensures old(pos) <= pos && pos <= end
  ensures is_ok(result) ==> old(pos) < pos
  ensures !is_ok(result) ==> (err_val(result).position == pos && 0 < err_val(result).kind && err_val(result).kind <= 17)
{
  if pos < end && input[pos] == 45 { pos = pos + 1; }
  if pos == end { return Err::<(), Fault>(Fault { position: pos, kind: 5 }); }
  if input[pos] == 48 {
    pos = pos + 1;
    if pos < end && input[pos] >= 48 && input[pos] <= 57 { return Err::<(), Fault>(Fault { position: pos, kind: 13 }); }
  } else {
    digits(input, inout pos, end)?;
  }
  if pos < end && input[pos] == 46 {
    pos = pos + 1;
    digits(input, inout pos, end)?;
  }
  if pos < end && (input[pos] == 101 || input[pos] == 69) {
    pos = pos + 1;
    if pos < end && (input[pos] == 43 || input[pos] == 45) { pos = pos + 1; }
    digits(input, inout pos, end)?;
  }
  return Ok::<(), Fault>(());
}

// The hand `utf8_width`: the scalar length a lead byte announces (1 for bytes no scalar starts with).
// Named apart from parse's private `utf8_width` (same body): with both names equal, the Python verifier times out on
// claude/time.pruv iso_of -> canonical_copy in the claude a2/a4 roots, the solver instability noted in RESHAPE step 2.4.
fn scalar_width(byte: i64) -> i64
  ensures 1 <= result && result <= 4
{
  if 194 <= byte && byte <= 223 { return 2; }
  if 224 <= byte && byte <= 239 { return 3; }
  if 240 <= byte && byte <= 244 { return 4; }
  return 1;
}

// The hand `Parser::string`: requires the opening quote; lone escaped surrogates are accepted.
// Non-ASCII bytes are validated in place, one scalar at a time (error 4 at the scalar's first byte).
pub fn scan_string(input: [u8], inout pos: i64, end: i64) -> Result<(), Fault>
  requires 0 <= pos && pos < end && end <= len(input)
  requires input[pos] == 34
  ensures old(pos) < pos && pos <= end
  ensures is_ok(result) ==> (old(pos) + 2 <= pos && utf8_valid_span(input, old(pos) + 1, pos - 1))
  ensures !is_ok(result) ==> (err_val(result).position == pos && 0 < err_val(result).kind && err_val(result).kind <= 17)
{
  pos = pos + 1;
  while pos < end
    invariant old(pos) < pos && pos <= end && end <= len(input)
    invariant utf8_valid_span(input, old(pos) + 1, pos)
    decreases end - pos
  {
    let c: i64 = input[pos];
    if c == 34 { pos = pos + 1; return Ok::<(), Fault>(()); }
    if c < 32 { return Err::<(), Fault>(Fault { position: pos, kind: 16 }); }
    if c >= 128 {
      let scalar_end: i64 = pos + scalar_width(c);
      if scalar_end > end { return Err::<(), Fault>(Fault { position: pos, kind: 4 }); }
      if validate_utf8(input, pos, scalar_end) >= 0 { return Err::<(), Fault>(Fault { position: pos, kind: 4 }); }
      pos = scalar_end;
    } else {
      pos = pos + 1;
      if c == 92 {
        if pos == end { return Err::<(), Fault>(Fault { position: pos, kind: 5 }); }
        let esc: i64 = input[pos];
        if esc == 117 {
          pos = pos + 1;
          let hex_start: i64 = pos;
          // hand: for _ in 0..4 (step 2.9, P4 range loop); hex_start only feeds the outer loop's measure
          for k in 0..4
            invariant old(pos) < pos && pos <= end && end <= len(input)
            invariant pos >= hex_start
            invariant utf8_valid_span(input, old(pos) + 1, pos)
          {
            if pos == end { return Err::<(), Fault>(Fault { position: pos, kind: 5 }); }
            let h: i64 = input[pos];
            if !((48 <= h && h <= 57) || (65 <= h && h <= 70) || (97 <= h && h <= 102)) {
              return Err::<(), Fault>(Fault { position: pos, kind: 15 });
            }
            pos = pos + 1;
          }
        } else {
          if esc != 34 && esc != 92 && esc != 47 && esc != 98 && esc != 102 && esc != 110 && esc != 114 && esc != 116 {
            return Err::<(), Fault>(Fault { position: pos, kind: 14 });
          }
          pos = pos + 1;
        }
      }
    }
  }
  return Err::<(), Fault>(Fault { position: pos, kind: 17 });
}
