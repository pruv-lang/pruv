mod bytes;
mod text;
// L3-1 A3 turn collector (port of tail.ts TurnCollector; docs/CLAUDE_IMPORT_SPEC.md "Collector state and
// transitions", policies P2/P3). State lives in three caller-owned arrays passed through `inout`:
//   st  [4]    st[0] begun (ordinal counter), st[1] current present, st[2] lost_before, st[3] slot of the newest draft
//   sl  [1600] 200 slots x 8: +0 prompt_len +1 reply_len +2 reply budget (saturating counter) +3 tools +4 clipped
//              +5 created present +6 completed present +7 draft ordinal (-1 = never written)
//   buf [65584 per slot in use] slot s at 65584*s: prompt +0, reply +32768, created stamp +65536, completed
//              stamp +65560. new_buffer starts with 16 slots (1 MiB); before a begin whose slot does not fit, the
//              owner grows buf straight to all 200 slots (grow). begin requires that fit and answer requires the
//              current slot to fit, so a window of at most 16 turns zeroes 1 MiB instead of 13 MiB.
// Draft k (0-based begin ordinal) lives in slot k % 200, so the ring always holds the newest min(begun,200)
// drafts. Timestamps are `str` of length 0 (absent) or 24.
//
// State invariant (repeated inline because contracts cannot call functions; `s` ranges over 0..200):
//   I3(s) slot numbers in range:  0<=len(prompt)<=32768, 0<=reply_len<=budget<=32768, 0<=tools<=1e15, flags 0/1
//   I4(s) ring ordering: begun<=s ==> ordinal==-1; begun>s ==> ordinal in [begun-200,begun-1] and ordinal%200==s
// tools saturates at 1e15 (an unreachable bound: a window has at most 8 MiB of text).

pub struct Collected { turns: [i64], text: [u8], kept: i64, trimmed: i64, total: i64 }

pub fn new_state() -> [i64] ! alloc
  ensures len(result) == 4
  ensures result[0] == 0 && result[1] == 0 && result[2] == 0 && result[3] == 0
{
  return alloc(4, 0);
}

pub fn new_slots() -> [i64] ! alloc
  ensures len(result) == 1600
  ensures forall s in 0..200: (result[8 * s] == 0 && result[8 * s + 1] == 0 && result[8 * s + 2] == 0 && result[8 * s + 3] == 0 && result[8 * s + 4] == 0 && result[8 * s + 5] == 0 && result[8 * s + 6] == 0 && result[8 * s + 7] == -1)
{
  let mut sl: [i64] = alloc(1600, 0);
  let mut s: i64 = 0;
  while s < 200
    invariant 0 <= s && s <= 200 && len(sl) == 1600
    invariant forall t in 0..s: (sl[8 * t] == 0 && sl[8 * t + 1] == 0 && sl[8 * t + 2] == 0 && sl[8 * t + 3] == 0 && sl[8 * t + 4] == 0 && sl[8 * t + 5] == 0 && sl[8 * t + 6] == 0 && sl[8 * t + 7] == -1)
    invariant forall k in 0..1600: (k >= 8 * s) ==> sl[k] == 0
    decreases 200 - s
  {
    sl[8 * s + 7] = -1;
    s = s + 1;
  }
  return sl;
}

pub fn new_buffer() -> [u8] ! alloc
  ensures len(result) == 1049344
{
  return alloc(1049344, 0);
}

// An empty buffer for owners that always grow before the first begin (DB7). The first begin then makes the one
// 13 MiB buffer, whose untouched pages stay unmapped, instead of zeroing 1 MiB and copying it on the first grow.
pub fn empty_buffer() -> [u8] ! alloc
  ensures len(result) == 0
{
  return alloc(0, 0);
}

// buf grown in place to the full 200 slots, so it fits slot begun % 200; the old bytes are kept (hand: Vec::resize,
// one realloc, no fresh buffer and copy; step 2.9). It jumps straight to the full size: doubling through 32, 64 and
// 128 slots zeroed and copied about 40 MiB on a full ring, against 13 MiB here.
pub fn grow(take buf: [u8], begun: i64) -> [u8] ! alloc
  requires 0 <= begun && len(buf) <= 13116800
  ensures len(buf) <= len(result) && len(result) <= 13116800
  ensures 65584 * (begun % 200) + 65584 <= len(result)
  ensures forall k in 0..len(buf): result[k] == buf[k]
{
  let mut b: [u8] = move buf;
  b = resize(b, 13116800, 0);
  return move b;
}

// dst[at..at+n) = src[0..n); everything else unchanged.
fn put_str(inout dst: [u8], at: i64, src: str, n: i64) -> ()
  requires 0 <= n && n <= len(src) && 0 <= at && at <= len(dst) && n <= len(dst) - at
  ensures len(dst) == len(old(dst))
  ensures forall k in 0..n: dst[at + k] == src[k]
  ensures forall k in 0..len(dst): (k < at || k >= at + n) ==> dst[k] == old(dst)[k]
{
  copy_range(inout dst, at, src, 0, n);
}

// n (0..2) LF bytes at dst[at..].
fn put_nl(inout dst: [u8], at: i64, n: i64) -> ()
  requires 0 <= n && n <= 2 && 0 <= at && at <= len(dst) && n <= len(dst) - at
  ensures len(dst) == len(old(dst))
  ensures forall k in 0..n: dst[at + k] == 10
  ensures forall k in 0..len(dst): (k < at || k >= at + n) ==> dst[k] == old(dst)[k]
{
  crate::bytes::copy_span(inout dst, at, "\n\n", 0, n);
}

// sep LF bytes followed by text[0..n) at dst[at..].
fn write_piece(inout dst: [u8], at: i64, sep: i64, text: str, n: i64) -> ()
  requires 0 <= sep && sep <= 2 && 0 <= n && n <= len(text) && 0 <= at && at <= len(dst) && sep + n <= len(dst) - at
  ensures len(dst) == len(old(dst))
  ensures forall k in 0..sep: dst[at + k] == 10
  ensures forall k in 0..n: dst[at + sep + k] == text[k]
  ensures forall k in 0..len(dst): (k < at || k >= at + sep + n) ==> dst[k] == old(dst)[k]
{
  put_nl(inout dst, at, sep);
  put_str(inout dst, at + sep, text, n);
}

fn clip_len(s: str, max: i64) -> i64
  requires 0 <= max && max <= 100_000_000
  requires len(s) <= 100_000_000
  ensures result <= max
  ensures result <= len(s)
  ensures is_char_boundary(s, result)
  ensures result == len(s) || (forall t in result+1..max+1: !is_char_boundary(s, t))
  ensures len(s) <= max ==> result == len(s)
{
  let mut i: i64 = max;
  if i > len(s) { i = len(s); }
  while i > 0 && !is_char_boundary(s, i)
    invariant 0 <= i && i <= len(s) && i <= max
    invariant forall t in i+1..max+1: !is_char_boundary(s, t)
    decreases i
  {
    i = i - 1;
  }
  return i;
}

// begin: new current draft in slot begun % 200 (evicting the oldest), prompt clipped to 32768 bytes (longest
// whole-scalar prefix), clipped set when the original exceeded the cap or lost_before was set, lost_before
// cleared, reply/budget/tools/completedAt reset, optional createdAt stored.
pub fn begin(inout st: [i64], inout sl: [i64], inout buf: [u8], prompt: str, created: str) -> () ! alloc
  requires len(st) == 4 && len(sl) == 1600 && 65584 * (st[0] % 200) + 65584 <= len(buf)
  requires 0 <= st[0] && st[0] < 1000000000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1)
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  requires len(prompt) <= 100000000
  requires len(created) == 0 || len(created) == 24
  ensures len(st) == 4 && len(sl) == 1600 && 65584 * st[3] + 65584 <= len(buf)
  ensures st[0] == old(st)[0] + 1 && st[1] == 1 && st[2] == 0 && st[3] == old(st)[0] % 200
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  ensures sl[8 * st[3] + 7] == old(st)[0]
  ensures sl[8 * st[3] + 1] == 0 && sl[8 * st[3] + 2] == 0 && sl[8 * st[3] + 3] == 0 && sl[8 * st[3] + 6] == 0
  ensures sl[8 * st[3]] <= len(prompt)
  ensures len(prompt) <= 32768 ==> sl[8 * st[3]] == len(prompt)
  ensures is_char_boundary(prompt, sl[8 * st[3]])
  ensures sl[8 * st[3]] == len(prompt) || (forall t in sl[8 * st[3]] + 1..32769: !is_char_boundary(prompt, t))
  ensures forall k in 0..sl[8 * st[3]]: buf[65584 * st[3] + k] == prompt[k]
  ensures (len(prompt) > 32768 || old(st)[2] == 1) ==> sl[8 * st[3] + 4] == 1
  ensures (len(prompt) <= 32768 && old(st)[2] == 0) ==> sl[8 * st[3] + 4] == 0
  ensures len(created) == 24 ==> (sl[8 * st[3] + 5] == 1 && forall k in 0..24: buf[65584 * st[3] + 65536 + k] == created[k])
  ensures len(created) != 24 ==> sl[8 * st[3] + 5] == 0
  ensures forall k in 0..1600: (k < 8 * st[3] || k >= 8 * st[3] + 8) ==> sl[k] == old(sl)[k]
  ensures forall k in 0..len(buf): ((k < 65584 * st[3] || k >= 65584 * st[3] + sl[8 * st[3]]) && (k < 65584 * st[3] + 65536 || k >= 65584 * st[3] + 65536 + 24 * sl[8 * st[3] + 5])) ==> buf[k] == old(buf)[k]
{
  let k: i64 = st[0];
  let w: i64 = k % 200;
  let n: i64 = clip_len(prompt, 32768);
  put_str(inout buf, 65584 * w, prompt, n);
  let mut has: i64 = 0;
  if len(created) == 24 {
    put_str(inout buf, 65584 * w + 65536, created, 24);
    has = 1;
  }
  let mut cl: i64 = 0;
  if len(prompt) > 32768 || st[2] == 1 { cl = 1; }
  sl[8 * w] = n;
  sl[8 * w + 1] = 0;
  sl[8 * w + 2] = 0;
  sl[8 * w + 3] = 0;
  sl[8 * w + 4] = cl;
  sl[8 * w + 5] = has;
  sl[8 * w + 6] = 0;
  sl[8 * w + 7] = k;
  st[0] = k + 1;
  st[1] = 1;
  st[2] = 0;
  st[3] = w;
}

// skip_user: detach the current draft (the earlier draft stays in the ring) and mark the next one clipped.
pub fn skip_user(inout st: [i64]) -> ()
  requires len(st) == 4
  ensures len(st) == 4
  ensures st[0] == old(st)[0] && st[1] == 0 && st[2] == 1 && st[3] == old(st)[3]
{
  st[1] = 0;
  st[2] = 1;
}

// tool: n more tool calls on the current draft's tool count, saturating at 1e15 (hand `tool(&mut self, n)`:
// `s.tools = (s.tools + n).min(TOOLS_MAX)`); no timestamp update; nothing without a current draft.
pub fn tool(inout st: [i64], inout sl: [i64], n: i64) -> ()
  requires len(st) == 4 && len(sl) == 1600 && 0 <= st[3] && st[3] < 200 && 0 <= n
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures len(st) == 4 && len(sl) == 1600
  ensures st[0] == old(st)[0] && st[1] == old(st)[1] && st[2] == old(st)[2] && st[3] == old(st)[3]
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: sl[8 * s + 7] == old(sl)[8 * s + 7]
  ensures st[1] == 0 ==> (forall k in 0..1600: sl[k] == old(sl)[k])
  ensures st[1] == 1 ==> (forall k in 0..1600: (k != 8 * st[3] + 3) ==> sl[k] == old(sl)[k])
  ensures (st[1] == 1 && n < 1000000000000000 - old(sl)[8 * st[3] + 3]) ==> sl[8 * st[3] + 3] == old(sl)[8 * st[3] + 3] + n
  ensures (st[1] == 1 && n >= 1000000000000000 - old(sl)[8 * st[3] + 3]) ==> sl[8 * st[3] + 3] == 1000000000000000
{
  if st[1] == 0 { return; }
  let c: i64 = st[3];
  let t: i64 = sl[8 * c + 3];
  if n < 1000000000000000 - t { sl[8 * c + 3] = t + n; } else { sl[8 * c + 3] = 1000000000000000; }
}

// answer: no current draft => nothing. Otherwise completedAt is updated first (even for empty text or a full
// reply); empty text or budget >= 32768 stops; else piece = text (empty reply) or "\n\n"+text, appended when
// it fits the remaining budget, else its longest whole-scalar prefix is appended, the budget counter saturates
// at 32768 and clipped is set. The counter is separate from the actual reply length (a multibyte cut leaves
// unused bytes that later calls must not fill).
pub fn answer(inout st: [i64], inout sl: [i64], inout buf: [u8], text: str, at: str) -> () ! alloc
  requires len(st) == 4 && len(sl) == 1600 && (st[1] == 0 || 65584 * st[3] + 65584 <= len(buf))
  requires 0 <= st[0] && st[0] <= 1000000000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1)
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  requires len(text) <= 100000000
  requires len(at) == 0 || len(at) == 24
  ensures len(st) == 4 && len(sl) == 1600
  ensures st[0] == old(st)[0] && st[1] == old(st)[1] && st[2] == old(st)[2] && st[3] == old(st)[3]
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  ensures st[1] == 0 ==> (forall k in 0..1600: sl[k] == old(sl)[k])
  ensures st[1] == 0 ==> (forall k in 0..len(buf): buf[k] == old(buf)[k])
  ensures st[1] == 1 ==> (forall k in 0..1600: (k < 8 * st[3] || k >= 8 * st[3] + 8) ==> sl[k] == old(sl)[k])
  ensures st[1] == 1 ==> (sl[8 * st[3]] == old(sl)[8 * st[3]] && sl[8 * st[3] + 3] == old(sl)[8 * st[3] + 3] && sl[8 * st[3] + 5] == old(sl)[8 * st[3] + 5] && sl[8 * st[3] + 7] == old(sl)[8 * st[3] + 7])
  ensures (st[1] == 1 && len(at) == 24) ==> (sl[8 * st[3] + 6] == 1 && forall k in 0..24: buf[65584 * st[3] + 65560 + k] == at[k])
  ensures (st[1] == 1 && len(at) != 24) ==> sl[8 * st[3] + 6] == old(sl)[8 * st[3] + 6]
  ensures (st[1] == 1 && (len(text) == 0 || old(sl)[8 * st[3] + 2] >= 32768)) ==> (sl[8 * st[3] + 1] == old(sl)[8 * st[3] + 1] && sl[8 * st[3] + 2] == old(sl)[8 * st[3] + 2] && sl[8 * st[3] + 4] == old(sl)[8 * st[3] + 4])
  ensures (st[1] == 1 && len(text) > 0 && old(sl)[8 * st[3] + 2] < 32768 && old(sl)[8 * st[3] + 1] == 0 && len(text) <= 32768 - old(sl)[8 * st[3] + 2]) ==> (sl[8 * st[3] + 1] == len(text) && sl[8 * st[3] + 2] == old(sl)[8 * st[3] + 2] + len(text) && sl[8 * st[3] + 4] == old(sl)[8 * st[3] + 4] && (forall k in 0..len(text): buf[65584 * st[3] + 32768 + k] == text[k]))
  ensures (st[1] == 1 && len(text) > 0 && old(sl)[8 * st[3] + 2] < 32768 && old(sl)[8 * st[3] + 1] > 0 && len(text) + 2 <= 32768 - old(sl)[8 * st[3] + 2]) ==> (sl[8 * st[3] + 1] == old(sl)[8 * st[3] + 1] + 2 + len(text) && sl[8 * st[3] + 2] == old(sl)[8 * st[3] + 2] + 2 + len(text) && sl[8 * st[3] + 4] == old(sl)[8 * st[3] + 4] && buf[65584 * st[3] + 32768 + old(sl)[8 * st[3] + 1]] == 10 && buf[65584 * st[3] + 32768 + old(sl)[8 * st[3] + 1] + 1] == 10 && (forall k in 0..len(text): buf[65584 * st[3] + 32768 + old(sl)[8 * st[3] + 1] + 2 + k] == text[k]))
  ensures (st[1] == 1 && len(text) > 0 && old(sl)[8 * st[3] + 2] < 32768 && old(sl)[8 * st[3] + 1] == 0 && len(text) > 32768 - old(sl)[8 * st[3] + 2]) ==> (sl[8 * st[3] + 2] == 32768 && sl[8 * st[3] + 4] == 1 && sl[8 * st[3] + 1] <= 32768 - old(sl)[8 * st[3] + 2] && sl[8 * st[3] + 1] <= len(text) && is_char_boundary(text, sl[8 * st[3] + 1]) && (forall t in sl[8 * st[3] + 1] + 1..32769 - old(sl)[8 * st[3] + 2]: !is_char_boundary(text, t)) && (forall k in 0..sl[8 * st[3] + 1]: buf[65584 * st[3] + 32768 + k] == text[k]))
  ensures (st[1] == 1 && len(text) > 0 && old(sl)[8 * st[3] + 2] < 32768 && old(sl)[8 * st[3] + 1] > 0 && len(text) + 2 > 32768 - old(sl)[8 * st[3] + 2] && 32768 - old(sl)[8 * st[3] + 2] == 1) ==> (sl[8 * st[3] + 2] == 32768 && sl[8 * st[3] + 4] == 1 && sl[8 * st[3] + 1] == old(sl)[8 * st[3] + 1] + 1 && buf[65584 * st[3] + 32768 + old(sl)[8 * st[3] + 1]] == 10)
  ensures (st[1] == 1 && len(text) > 0 && old(sl)[8 * st[3] + 2] < 32768 && old(sl)[8 * st[3] + 1] > 0 && len(text) + 2 > 32768 - old(sl)[8 * st[3] + 2] && 32768 - old(sl)[8 * st[3] + 2] >= 2) ==> (sl[8 * st[3] + 2] == 32768 && sl[8 * st[3] + 4] == 1 && sl[8 * st[3] + 1] >= old(sl)[8 * st[3] + 1] + 2 && sl[8 * st[3] + 1] <= old(sl)[8 * st[3] + 1] + (32768 - old(sl)[8 * st[3] + 2]) && buf[65584 * st[3] + 32768 + old(sl)[8 * st[3] + 1]] == 10 && buf[65584 * st[3] + 32768 + old(sl)[8 * st[3] + 1] + 1] == 10 && is_char_boundary(text, sl[8 * st[3] + 1] - old(sl)[8 * st[3] + 1] - 2) && (forall k in 0..sl[8 * st[3] + 1] - old(sl)[8 * st[3] + 1] - 2: buf[65584 * st[3] + 32768 + old(sl)[8 * st[3] + 1] + 2 + k] == text[k]) && (forall t in sl[8 * st[3] + 1] - old(sl)[8 * st[3] + 1] - 1..32767 - old(sl)[8 * st[3] + 2]: !is_char_boundary(text, t)))
{
  if st[1] == 0 { return; }
  let c: i64 = st[3];
  if len(at) == 24 {
    put_str(inout buf, 65584 * c + 65560, at, 24);
    sl[8 * c + 6] = 1;
  }
  if len(text) == 0 { return; }
  let used: i64 = sl[8 * c + 2];
  if used >= 32768 { return; }
  let rl: i64 = sl[8 * c + 1];
  let rb: i64 = 65584 * c + 32768 + rl;
  let room: i64 = 32768 - used;
  let mut sep: i64 = 0;
  if rl > 0 { sep = 2; }
  if sep + len(text) <= room {
    write_piece(inout buf, rb, sep, text, len(text));
    sl[8 * c + 1] = rl + sep + len(text);
    sl[8 * c + 2] = used + sep + len(text);
    return;
  }
  let mut s2: i64 = sep;
  let mut take: i64 = 0;
  if sep == 2 && room < 2 {
    s2 = room;
  } else {
    take = clip_len(text, room - sep);
  }
  write_piece(inout buf, rb, s2, text, take);
  sl[8 * c + 1] = rl + s2 + take;
  sl[8 * c + 2] = 32768;
  sl[8 * c + 4] = 1;
}

// First pass: choose the newest contiguous suffix and sum its text and stamp bytes.
fn plan(st: [i64], sl: [i64]) -> Layout
  requires len(st) == 4 && len(sl) == 1600 && 0 <= st[0] && st[0] <= 1000000000000
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures 0 <= result.kept && result.kept <= 200 && result.kept <= st[0]
  ensures 0 <= result.total && result.total <= 2097152
  ensures result.total == sum(j in 0..result.kept: sl[8 * ((st[0] - 1 - j) % 200)] + sl[8 * ((st[0] - 1 - j) % 200) + 1])
  ensures (result.kept < st[0] && result.kept < 200) ==> result.total + sl[8 * ((st[0] - 1 - result.kept) % 200)] + sl[8 * ((st[0] - 1 - result.kept) % 200) + 1] > 2097152
  ensures 0 <= result.text_len && result.text_len <= result.total + 48 * result.kept
  ensures result.text_len <= 2106752
{
  let b: i64 = st[0];
  let mut avail: i64 = b;
  if avail > 200 { avail = 200; }
  let mut text_len: i64 = 0;
  let mut i: i64 = 0;
  let mut total: i64 = 0;
  while i < avail
    invariant 0 <= i && i <= avail && avail <= 200 && avail <= b && 0 <= b && b <= 1000000000000
    invariant (b <= 200 && avail == b) || (b > 200 && avail == 200)
    invariant len(sl) == 1600 && len(st) == 4 && st[0] == b
    invariant 0 <= total && total <= 2097152
    invariant total == sum(j in 0..i: sl[8 * ((b - 1 - j) % 200)] + sl[8 * ((b - 1 - j) % 200) + 1])
    invariant 0 <= text_len && text_len <= total + 48 * i
    invariant forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
    decreases avail - i
  {
    let w: i64 = (b - 1 - i) % 200;
    let size: i64 = sl[8 * w] + sl[8 * w + 1];
    if total + size > 2097152 {
      return Layout { kept: i, total: total, text_len: text_len };
    }
    let need: i64 = size + 24 * sl[8 * w + 5] + 24 * sl[8 * w + 6];
    total = total + size;
    text_len = text_len + need;
    i = i + 1;
  }
  return Layout { kept: i, total: total, text_len: text_len };
}

// finish: newest contiguous suffix (at most 200 drafts, at most 2097152 actual prompt+reply bytes), published
// oldest first. Turn text is packed oldest first as prompt, reply, createdAt, completedAt of each turn,
// starting at byte offset `base` of the caller's text; refs of the 10-slot records are absolute
// (base + local) and absent stamps are (-1,0). trimmed = kept < begun (drafts evicted from the ring count).
pub fn finish(st: [i64], sl: [i64], buf: [u8], base: i64) -> Collected ! alloc
  requires len(st) == 4 && len(sl) == 1600
  requires 0 <= st[0] && st[0] <= 1000000000000 && 0 <= base && base <= 3500000
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  ensures 0 <= result.kept && result.kept <= 200 && result.kept <= st[0]
  ensures len(result.turns) == 10 * result.kept
  ensures 0 <= len(result.text) && len(result.text) <= 2106752
  ensures (result.trimmed == 0 && result.kept == st[0]) || (result.trimmed == 1 && result.kept < st[0])
  ensures 0 <= result.total && result.total <= 2097152
  ensures result.total == sum(j in 0..result.kept: sl[8 * ((st[0] - 1 - j) % 200)] + sl[8 * ((st[0] - 1 - j) % 200) + 1])
  ensures (result.kept < st[0] && result.kept < 200) ==> result.total + sl[8 * ((st[0] - 1 - result.kept) % 200)] + sl[8 * ((st[0] - 1 - result.kept) % 200) + 1] > 2097152
{
  let p: Layout = plan(st, sl);
  let kept: i64 = p.kept;
  let b: i64 = st[0];
  let tl: i64 = p.text_len;
  let mut turns: [i64] = alloc(10 * kept, 0);
  let mut text: [u8] = alloc(tl, 0);
  let mut tr: i64 = 0;
  if kept < b { tr = 1; }
  let mut cursor: i64 = tl;
  let mut j: i64 = 0;
  while j < kept
    invariant (tr == 0 && kept == b) || (tr == 1 && kept < b)
    invariant 0 <= j && j <= kept && 0 <= kept && kept <= 200 && kept <= b && 0 <= b && b <= 1000000000000
    invariant len(turns) == 10 * kept && len(text) == tl && len(sl) == 1600
    invariant 0 <= cursor && cursor <= tl && tl <= 2106752
    invariant forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
    decreases kept - j
  {
    let w: i64 = (b - 1 - j) % 200;
    let plen: i64 = sl[8 * w];
    let rlen: i64 = sl[8 * w + 1];
    let cp: i64 = sl[8 * w + 5];
    let dp: i64 = sl[8 * w + 6];
    let e: i64 = cursor;
    if plen + rlen + 24 * cp + 24 * dp > e || 65584 * w + 65584 > len(buf) {
      return Collected { turns: move turns, text: move text, kept: kept, trimmed: tr, total: p.total };
    }
    let lo: i64 = e - plen - rlen - 24 * cp - 24 * dp;
    let sb: i64 = 65584 * w;
    crate::bytes::copy_span(inout text, lo, buf, sb, sb + plen);
    crate::bytes::copy_span(inout text, lo + plen, buf, sb + 32768, sb + 32768 + rlen);
    if cp == 1 {
      crate::bytes::copy_span(inout text, lo + plen + rlen, buf, sb + 65536, sb + 65560);
    }
    if dp == 1 {
      crate::bytes::copy_span(inout text, lo + plen + rlen + 24 * cp, buf, sb + 65560, sb + 65584);
    }
    let t: i64 = kept - 1 - j;
    turns[10 * t] = base + lo;
    turns[10 * t + 1] = plen;
    turns[10 * t + 2] = base + lo + plen;
    turns[10 * t + 3] = rlen;
    if cp == 1 {
      turns[10 * t + 4] = base + lo + plen + rlen;
      turns[10 * t + 5] = 24;
    } else {
      turns[10 * t + 4] = -1;
      turns[10 * t + 5] = 0;
    }
    if dp == 1 {
      turns[10 * t + 6] = base + lo + plen + rlen + 24 * cp;
      turns[10 * t + 7] = 24;
    } else {
      turns[10 * t + 6] = -1;
      turns[10 * t + 7] = 0;
    }
    turns[10 * t + 8] = sl[8 * w + 3];
    turns[10 * t + 9] = sl[8 * w + 4];
    cursor = lo;
    j = j + 1;
  }
  return Collected { turns: move turns, text: move text, kept: kept, trimmed: tr, total: p.total };
}


// ---- Content-sized store (DB11). Same st/sl state and slot rules as above; only the bytes move. ----
// data  draft k's prompt then its reply, contiguous at off[k % 200]; the current draft is always the last record,
//       so answer appends at end. Records are in ordinal order (newer at higher offsets).
// off   [200] byte offset of each slot's record in data (-1 = no record)
// stamp [9600] slot s: created stamp at 48*s, completed stamp at 48*s+24
// end   bytes of data in use. Growth: when a write does not fit, reserve packs the records finish can still
//       publish into the front, in place when that leaves half the buffer free, else into a new buffer of twice
//       the bytes needed; past 1 MiB the new buffer is 4259840 bytes (twice the largest live text plus need), after
//       which every grow is in place (DB48). Each byte is copied O(1) times on average.
// hint  the owner's input size (0 = unknown, the sizes above). With a hint the first buffer is 16384 bytes instead of
//       65536 (a dense window keeps a few KiB of text; DB53, G-DB51-4), and when the hint is over 1 MiB the first grow
//       past it goes straight to 4259840 bytes instead of 32 K ... 561 K first (DB53, G-DB51-2). Windows whose text stays
//       in the first buffer never take that grow, so they never map the large buffer.
// Record offsets are not tied to sl by a proof; finish2 and answer2 check them at run time (D-DB11-1).
pub struct Store { data: [u8], off: [i64], stamp: [u8], end: i64, hint: i64 }

pub fn new_store() -> Store ! alloc
  ensures len(result.off) == 200 && len(result.stamp) == 9600 && 0 <= result.end && result.end <= len(result.data)
{
  return new_store_hint(0);
}

// A Store whose owner knows its input size (see hint above). Only the growth sizes depend on it, never the contents.
pub fn new_store_hint(hint: i64) -> Store ! alloc
  ensures len(result.off) == 200 && len(result.stamp) == 9600 && 0 <= result.end && result.end <= len(result.data)
{
  let d: [u8] = alloc(0, 0);
  let o: [i64] = alloc(200, -1);
  let s: [u8] = alloc(9600, 0);
  return Store { data: move d, off: move o, stamp: move s, end: 0, hint: hint };
}

// a[dst..dst+n) = old a[src..src+n) (overlap safe).
fn move_bytes(inout a: [u8], dst: i64, src: i64, n: i64) -> ()
  requires 0 <= dst && 0 <= src && 0 <= n && dst + n <= len(a) && src + n <= len(a)
  ensures len(a) == len(old(a))
{
  copy_within(inout a, dst, src, n);
}

// Room for need more bytes at bk.end. The drafts kept are the newest ones from ordinal top-1 down, at most cnt,
// stopping (as plan does) at the first that would push the running total, which starts at extra (the bytes of a
// draft about to be added), past 2097152. Sizes only grow and newer drafts only get added, so finish can never
// publish a draft past that point; those records are dropped (off = -1). Kept records are packed oldest first.
fn reserve(inout bk: Store, sl: [i64], top: i64, cnt: i64, extra: i64, need: i64) -> () ! alloc
  requires len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  requires len(sl) == 1600 && 0 <= cnt && cnt <= 200 && cnt <= top && top <= 1000000000000
  requires 0 <= extra && extra <= 32768 && 0 <= need && need <= 32768
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= 32768)
  ensures len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data) && need <= len(bk.data) - bk.end
{
  if need <= len(bk.data) - bk.end { return; }
  let mut m: i64 = 0;
  let mut live: i64 = 0;
  let mut total: i64 = extra;
  let mut lim: i64 = cnt;
  while m < lim
    invariant 0 <= m && m <= lim && lim <= cnt && cnt <= 200 && cnt <= top && len(sl) == 1600 && len(bk.off) == 200 && len(bk.stamp) == 9600
    invariant 0 <= live && live <= total && total <= 2097152
    invariant forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= 32768)
    decreases lim - m
  {
    let w: i64 = (top - 1 - m) % 200;
    let size: i64 = sl[8 * w] + sl[8 * w + 1];
    let o: i64 = bk.off[w];
    if total + size > 2097152 || o < 0 || o > bk.end - size {
      lim = m;
    } else {
      total = total + size;
      live = live + size;
      m = m + 1;
    }
  }
  let mut d: i64 = m;
  while d < cnt
    invariant m <= d && d <= cnt && cnt <= 200 && cnt <= top && len(bk.off) == 200 && len(bk.stamp) == 9600
    decreases cnt - d
  {
    bk.off[(top - 1 - d) % 200] = -1;
    d = d + 1;
  }
  let tgt: i64 = live + need;
  let l: i64 = len(bk.data);
  let mut pos: i64 = 0;
  let mut i: i64 = m;
  if tgt <= l - tgt {
    while i > 0
      invariant 0 <= i && i <= m && m <= cnt && cnt <= 200 && cnt <= top && len(sl) == 1600 && len(bk.off) == 200 && len(bk.stamp) == 9600
      invariant len(bk.data) == l && 0 <= pos && pos <= live
      invariant forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= 32768)
      decreases i
    {
      i = i - 1;
      let w: i64 = (top - 1 - i) % 200;
      let size: i64 = sl[8 * w] + sl[8 * w + 1];
      let o: i64 = bk.off[w];
      if o >= 0 && o <= l - size && pos <= live - size {
        move_bytes(inout bk.data, pos, o, size);
        bk.off[w] = pos;
        pos = pos + size;
      } else {
        bk.off[w] = -1;
      }
    }
    bk.end = pos;
    return;
  }
  // DB48 (G-DB45-2): past 1 MiB, jump to the bound. live <= 2097152 and need <= 32768, so tgt <= 2129920 and a
  // buffer of 2 * 2129920 bytes always takes the in-place path above from then on. Plain doubling went on through
  // 1.1, 2.2 and 4.2 MB and, once live sat near 2 MiB, made a fresh 4.2 MB buffer on most grows; every freed block
  // stayed resident (about 1.1 B of RSS per input byte on the grok ord rows). Small windows keep doubling, so they
  // never map the large buffer.
  let mut cap: i64 = 2 * tgt;
  let mut low: i64 = 65536;
  if bk.hint > 0 { low = 16384; }
  if cap < low { cap = low; }
  if cap > 1048576 || (cap > low && bk.hint > 1048576) { cap = 4259840; }
  let mut nb: [u8] = alloc(cap, 0);
  while i > 0
    invariant 0 <= i && i <= m && m <= cnt && cnt <= 200 && cnt <= top && len(sl) == 1600 && len(bk.off) == 200 && len(bk.stamp) == 9600
    invariant len(bk.data) == l && len(nb) == cap && tgt <= cap && 0 <= pos && pos <= live
    invariant forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= 32768)
    decreases i
  {
    i = i - 1;
    let w: i64 = (top - 1 - i) % 200;
    let size: i64 = sl[8 * w] + sl[8 * w + 1];
    let o: i64 = bk.off[w];
    if o >= 0 && o <= l - size && pos <= live - size {
      crate::bytes::copy_span(inout nb, pos, bk.data, o, o + size);
      bk.off[w] = pos;
      pos = pos + size;
    } else {
      bk.off[w] = -1;
    }
  }
  bk.data = move nb;
  bk.end = pos;
}

// begin on a Store: the same st/sl transition as begin; the clipped prompt is appended at bk.end.
pub fn begin2(inout st: [i64], inout sl: [i64], inout bk: Store, prompt: str, created: str) -> () ! alloc
  requires len(st) == 4 && len(sl) == 1600
  requires len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  requires 0 <= st[0] && st[0] < 1000000000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1)
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  requires len(prompt) <= 100000000
  requires len(created) == 0 || len(created) == 24
  ensures len(st) == 4 && len(sl) == 1600
  ensures len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  ensures st[0] == old(st)[0] + 1 && st[1] == 1 && st[2] == 0 && st[3] == old(st)[0] % 200
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
{
  let k: i64 = st[0];
  let w: i64 = k % 200;
  let n: i64 = clip_len(prompt, 32768);
  let mut cnt: i64 = k;
  if cnt > 199 { cnt = 199; }
  reserve(inout bk, sl, k, cnt, n, n);
  let at: i64 = bk.end;
  put_str(inout bk.data, at, prompt, n);
  bk.off[w] = at;
  bk.end = at + n;
  let mut has: i64 = 0;
  if len(created) == 24 {
    put_str(inout bk.stamp, 48 * w, created, 24);
    has = 1;
  }
  let mut cl: i64 = 0;
  if len(prompt) > 32768 || st[2] == 1 { cl = 1; }
  sl[8 * w] = n;
  sl[8 * w + 1] = 0;
  sl[8 * w + 2] = 0;
  sl[8 * w + 3] = 0;
  sl[8 * w + 4] = cl;
  sl[8 * w + 5] = has;
  sl[8 * w + 6] = 0;
  sl[8 * w + 7] = k;
  st[0] = k + 1;
  st[1] = 1;
  st[2] = 0;
  st[3] = w;
}

// answer on a Store: the same rules as answer; the piece is appended at bk.end, which is the end of the current
// draft's record (checked at run time; a mismatch leaves the draft unchanged, D-DB11-1).
pub fn answer2(inout st: [i64], inout sl: [i64], inout bk: Store, text: str, at: str) -> () ! alloc
  requires len(st) == 4 && len(sl) == 1600
  requires len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  requires 0 <= st[0] && st[0] <= 1000000000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1)
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  requires len(text) <= 100000000
  requires len(at) == 0 || len(at) == 24
  ensures len(st) == 4 && len(sl) == 1600
  ensures len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  ensures st[0] == old(st)[0] && st[1] == old(st)[1] && st[2] == old(st)[2] && st[3] == old(st)[3]
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
{
  if st[1] == 0 { return; }
  let c: i64 = st[3];
  if len(at) == 24 {
    put_str(inout bk.stamp, 48 * c + 24, at, 24);
    sl[8 * c + 6] = 1;
  }
  if len(text) == 0 { return; }
  let used: i64 = sl[8 * c + 2];
  if used >= 32768 { return; }
  let rl: i64 = sl[8 * c + 1];
  let room: i64 = 32768 - used;
  let mut sep: i64 = 0;
  if rl > 0 { sep = 2; }
  let mut s2: i64 = sep;
  let mut take: i64 = len(text);
  let mut full: bool = true;
  if sep + len(text) > room {
    full = false;
    if sep == 2 && room < 2 {
      s2 = room;
      take = 0;
    } else {
      take = clip_len(text, room - sep);
    }
  }
  let mut cnt: i64 = st[0];
  if cnt > 200 { cnt = 200; }
  if cnt < 1 { return; }
  reserve(inout bk, sl, st[0], cnt, 0, s2 + take);
  let o: i64 = bk.off[c];
  let e: i64 = bk.end;
  if o < 0 || o != e - sl[8 * c] - rl { return; }
  write_piece(inout bk.data, e, s2, text, take);
  bk.end = e + s2 + take;
  sl[8 * c + 1] = rl + s2 + take;
  if full {
    sl[8 * c + 2] = used + s2 + take;
  } else {
    sl[8 * c + 2] = 32768;
    sl[8 * c + 4] = 1;
  }
}

// finish on a Store: the same selection, layout and result as finish.
pub fn finish2(st: [i64], sl: [i64], inout bk: Store, base: i64) -> Collected ! alloc
  requires len(st) == 4 && len(sl) == 1600
  requires len(bk.off) == 200 && len(bk.stamp) == 9600
  requires 0 <= st[0] && st[0] <= 1000000000000 && 0 <= base && base <= 3500000
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  ensures len(bk.off) == 200 && len(bk.stamp) == 9600
  ensures 0 <= result.kept && result.kept <= 200 && result.kept <= st[0]
  ensures len(result.turns) == 10 * result.kept
  ensures 0 <= len(result.text) && len(result.text) <= 2106752
  ensures (result.trimmed == 0 && result.kept == st[0]) || (result.trimmed == 1 && result.kept < st[0])
  ensures 0 <= result.total && result.total <= 2097152
  ensures result.total == sum(j in 0..result.kept: sl[8 * ((st[0] - 1 - j) % 200)] + sl[8 * ((st[0] - 1 - j) % 200) + 1])
  ensures (result.kept < st[0] && result.kept < 200) ==> result.total + sl[8 * ((st[0] - 1 - result.kept) % 200)] + sl[8 * ((st[0] - 1 - result.kept) % 200) + 1] > 2097152
{
  let p: Layout = plan(st, sl);
  let kept: i64 = p.kept;
  let b: i64 = st[0];
  let tl: i64 = p.text_len;
  let mut turns: [i64] = alloc(10 * kept, 0);
  let mut text: [u8] = alloc(tl, 0);
  let mut tr: i64 = 0;
  if kept < b { tr = 1; }
  let dl: i64 = len(bk.data);
  let mut cursor: i64 = tl;
  let mut j: i64 = 0;
  while j < kept
    invariant (tr == 0 && kept == b) || (tr == 1 && kept < b)
    invariant 0 <= j && j <= kept && 0 <= kept && kept <= 200 && kept <= b && 0 <= b && b <= 1000000000000
    invariant len(turns) == 10 * kept && len(text) == tl && len(sl) == 1600
    invariant len(bk.off) == 200 && len(bk.stamp) == 9600 && len(bk.data) == dl
    invariant 0 <= cursor && cursor <= tl && tl <= 2106752
    invariant forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
    decreases kept - j
  {
    let w: i64 = (b - 1 - j) % 200;
    let plen: i64 = sl[8 * w];
    let rlen: i64 = sl[8 * w + 1];
    let cp: i64 = sl[8 * w + 5];
    let dp: i64 = sl[8 * w + 6];
    let o: i64 = bk.off[w];
    let e: i64 = cursor;
    if plen + rlen + 24 * cp + 24 * dp > e || o < 0 || o > dl - plen - rlen {
      return Collected { turns: move turns, text: move text, kept: kept, trimmed: tr, total: p.total };
    }
    let lo: i64 = e - plen - rlen - 24 * cp - 24 * dp;
    crate::bytes::copy_span(inout text, lo, bk.data, o, o + plen + rlen);
    if cp == 1 {
      crate::bytes::copy_span(inout text, lo + plen + rlen, bk.stamp, 48 * w, 48 * w + 24);
    }
    if dp == 1 {
      crate::bytes::copy_span(inout text, lo + plen + rlen + 24 * cp, bk.stamp, 48 * w + 24, 48 * w + 48);
    }
    let t: i64 = kept - 1 - j;
    turns[10 * t] = base + lo;
    turns[10 * t + 1] = plen;
    turns[10 * t + 2] = base + lo + plen;
    turns[10 * t + 3] = rlen;
    if cp == 1 {
      turns[10 * t + 4] = base + lo + plen + rlen;
      turns[10 * t + 5] = 24;
    } else {
      turns[10 * t + 4] = -1;
      turns[10 * t + 5] = 0;
    }
    if dp == 1 {
      turns[10 * t + 6] = base + lo + plen + rlen + 24 * cp;
      turns[10 * t + 7] = 24;
    } else {
      turns[10 * t + 6] = -1;
      turns[10 * t + 7] = 0;
    }
    turns[10 * t + 8] = sl[8 * w + 3];
    turns[10 * t + 9] = sl[8 * w + 4];
    cursor = lo;
    j = j + 1;
  }
  return Collected { turns: move turns, text: move text, kept: kept, trimmed: tr, total: p.total };
}

// The same suffix used by finish2, with its byte size including both stamps.
pub struct Layout { kept: i64, total: i64, text_len: i64 }

pub fn text_layout(st: [i64], sl: [i64]) -> Layout ! alloc
  requires len(st) == 4 && len(sl) == 1600 && 0 <= st[0] && st[0] <= 1000000000000
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures 0 <= result.kept && result.kept <= 200 && result.kept <= st[0]
  ensures 0 <= result.total && result.total <= 2097152
  ensures result.total == sum(j in 0..result.kept: sl[8 * ((st[0] - 1 - j) % 200)] + sl[8 * ((st[0] - 1 - j) % 200) + 1])
  ensures (result.kept < st[0] && result.kept < 200) ==> result.total + sl[8 * ((st[0] - 1 - result.kept) % 200)] + sl[8 * ((st[0] - 1 - result.kept) % 200) + 1] > 2097152
  ensures 0 <= result.text_len && result.text_len <= result.total + 48 * result.kept && result.text_len <= 2106752
{
  return plan(st, sl);
}

pub struct Placed { turns: [i64], kept: i64, trimmed: i64, total: i64, text_len: i64, ok: bool }

// Write the selected drafts at wire[at..at+text_len]. Turn offsets are relative to base, as in finish2.
// An invalid span or store offset returns ok=false; callers must discard a partial write.
pub fn finish_into(st: [i64], sl: [i64], bk: Store, base: i64, inout wire: [u8], at: i64) -> Placed ! alloc
  requires len(st) == 4 && len(sl) == 1600
  requires len(bk.off) == 200 && len(bk.stamp) == 9600
  requires 0 <= st[0] && st[0] <= 1000000000000 && 0 <= base && base <= 3500000
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  ensures len(wire) == len(old(wire))
  ensures 0 <= result.kept && result.kept <= 200 && result.kept <= st[0]
  ensures len(result.turns) == 10 * result.kept
  ensures 0 <= result.text_len && result.text_len <= result.total + 48 * result.kept && result.text_len <= 2106752
  ensures result.ok ==> (0 <= at && at <= len(wire) && result.text_len <= len(wire) - at)
  ensures forall k in 0..len(wire): ((k < at || k >= at + result.text_len) ==> wire[k] == old(wire)[k])
  ensures (result.trimmed == 0 && result.kept == st[0]) || (result.trimmed == 1 && result.kept < st[0])
  ensures 0 <= result.total && result.total <= 2097152
  ensures result.total == sum(j in 0..result.kept: sl[8 * ((st[0] - 1 - j) % 200)] + sl[8 * ((st[0] - 1 - j) % 200) + 1])
  ensures (result.kept < st[0] && result.kept < 200) ==> result.total + sl[8 * ((st[0] - 1 - result.kept) % 200)] + sl[8 * ((st[0] - 1 - result.kept) % 200) + 1] > 2097152
{
  let p: Layout = plan(st, sl);
  let kept: i64 = p.kept;
  let b: i64 = st[0];
  let tl: i64 = p.text_len;
  let mut turns: [i64] = alloc(10 * kept, 0);
  let mut tr: i64 = 0;
  if kept < b { tr = 1; }
  if at < 0 || at > len(wire) || tl > len(wire) - at {
    return Placed { turns: move turns, kept: kept, trimmed: tr, total: p.total, text_len: tl, ok: false };
  }
  let dl: i64 = len(bk.data);
  let mut cursor: i64 = tl;
  let mut j: i64 = 0;
  while j < kept
    invariant (tr == 0 && kept == b) || (tr == 1 && kept < b)
    invariant 0 <= j && j <= kept && 0 <= kept && kept <= 200 && kept <= b && 0 <= b && b <= 1000000000000
    invariant len(turns) == 10 * kept && 0 <= at && at <= len(wire) && tl <= len(wire) - at && len(wire) == len(old(wire)) && len(sl) == 1600
    invariant len(bk.off) == 200 && len(bk.stamp) == 9600 && len(bk.data) == dl
    invariant 0 <= cursor && cursor <= tl && tl <= 2106752
    invariant forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
    invariant forall k in 0..len(wire): ((k < at || k >= at + tl) ==> wire[k] == old(wire)[k])
    decreases kept - j
  {
    let w: i64 = (b - 1 - j) % 200;
    let plen: i64 = sl[8 * w];
    let rlen: i64 = sl[8 * w + 1];
    let cp: i64 = sl[8 * w + 5];
    let dp: i64 = sl[8 * w + 6];
    let o: i64 = bk.off[w];
    let e: i64 = cursor;
    if plen + rlen + 24 * cp + 24 * dp > e || o < 0 || o > dl - plen - rlen {
      return Placed { turns: move turns, kept: kept, trimmed: tr, total: p.total, text_len: tl, ok: false };
    }
    let lo: i64 = e - plen - rlen - 24 * cp - 24 * dp;
    crate::bytes::copy_span(inout wire, at + lo, bk.data, o, o + plen + rlen);
    if cp == 1 {
      crate::bytes::copy_span(inout wire, at + lo + plen + rlen, bk.stamp, 48 * w, 48 * w + 24);
    }
    if dp == 1 {
      crate::bytes::copy_span(inout wire, at + lo + plen + rlen + 24 * cp, bk.stamp, 48 * w + 24, 48 * w + 48);
    }
    let t: i64 = kept - 1 - j;
    turns[10 * t] = base + lo;
    turns[10 * t + 1] = plen;
    turns[10 * t + 2] = base + lo + plen;
    turns[10 * t + 3] = rlen;
    if cp == 1 {
      turns[10 * t + 4] = base + lo + plen + rlen;
      turns[10 * t + 5] = 24;
    } else {
      turns[10 * t + 4] = -1;
      turns[10 * t + 5] = 0;
    }
    if dp == 1 {
      turns[10 * t + 6] = base + lo + plen + rlen + 24 * cp;
      turns[10 * t + 7] = 24;
    } else {
      turns[10 * t + 6] = -1;
      turns[10 * t + 7] = 0;
    }
    turns[10 * t + 8] = sl[8 * w + 3];
    turns[10 * t + 9] = sl[8 * w + 4];
    cursor = lo;
    j = j + 1;
  }
  return Placed { turns: move turns, kept: kept, trimmed: tr, total: p.total, text_len: tl, ok: true };
}

// Span forms (DB32): begin2 / answer2 over a byte span src[lo..lo+n) instead of a str, so a caller that holds the
// text in a byte arena does not copy it out first. The span must be valid UTF-8 (the caller checks); then clipping
// at the last byte that is not a continuation byte (128..191) is the clip_bytes cut.

// Longest prefix length of src[lo..lo+n) that is at most max and ends before a non-continuation byte or at n.
fn clip_span(src: [u8], lo: i64, n: i64, max: i64) -> i64
  requires 0 <= lo && 0 <= n && n <= len(src) - lo && 0 <= max
  ensures 0 <= result && result <= n && result <= max
  ensures n <= max ==> result == n
  ensures result == 0 || result == n || src[lo + result] < 128 || src[lo + result] > 191
  ensures result == n || (forall t in result + 1..max + 1: t < n && src[lo + t] >= 128 && src[lo + t] <= 191)
{
  let mut i: i64 = max;
  if i > n { i = n; }
  while i > 0 && i < n && src[lo + i] >= 128 && src[lo + i] <= 191
    invariant 0 <= i && i <= n && i <= max && n <= len(src) - lo && 0 <= lo
    invariant n <= max ==> i == n
    invariant i == n || (forall t in i + 1..max + 1: t < n && src[lo + t] >= 128 && src[lo + t] <= 191)
    decreases i
  {
    i = i - 1;
  }
  return i;
}

// sep LF bytes followed by src[lo..lo+n) at dst[at..] (write_piece over a byte span).
fn put_nl_span(inout dst: [u8], at: i64, sep: i64, src: [u8], lo: i64, n: i64) -> ()
  requires 0 <= sep && sep <= 2 && 0 <= lo && 0 <= n && n <= len(src) - lo
  requires 0 <= at && at <= len(dst) && sep + n <= len(dst) - at
  ensures len(dst) == len(old(dst))
  ensures forall k in 0..sep: dst[at + k] == 10
  ensures forall k in 0..n: dst[at + sep + k] == src[lo + k]
  ensures forall k in 0..len(dst): (k < at || k >= at + sep + n) ==> dst[k] == old(dst)[k]
{
  put_nl(inout dst, at, sep);
  crate::bytes::copy_span(inout dst, at + sep, src, lo, lo + n);
}

// The 4 UTF-8 bytes of U+10000 at dst[p..p+4); everything else unchanged.
fn put_pad(inout dst: [u8], p: i64) -> ()
  requires 0 <= p && 4 <= len(dst) - p
  ensures len(dst) == len(old(dst))
  ensures dst[p] == 240 && dst[p + 1] == 144 && dst[p + 2] == 128 && dst[p + 3] == 128
  ensures forall k in 0..len(dst): (k < p || k >= p + 4) ==> dst[k] == old(dst)[k]
{
  crate::bytes::copy_span(inout dst, p, "𐀀", 0, 4);
}

// sep LF bytes, src[lo..lo+n), then pad bytes of U+10000 (pad 0 or 4) at dst[at..].
// DB37: split into put_nl_span and put_pad so each postcondition here follows from one helper's content or frame
// clause (the inline form timed out on the line-837 clause in full codex runs under load, G-DB36-2).
fn write_span(inout dst: [u8], at: i64, sep: i64, src: [u8], lo: i64, n: i64, pad: i64) -> ()
  requires 0 <= sep && sep <= 2 && 0 <= lo && 0 <= n && n <= len(src) - lo && (pad == 0 || pad == 4)
  requires 0 <= at && at <= len(dst) && sep + n + pad <= len(dst) - at
  ensures len(dst) == len(old(dst))
  ensures forall k in 0..sep: dst[at + k] == 10
  ensures forall k in 0..n: dst[at + sep + k] == src[lo + k]
  ensures pad == 4 ==> (dst[at + sep + n] == 240 && dst[at + sep + n + 1] == 144 && dst[at + sep + n + 2] == 128 && dst[at + sep + n + 3] == 128)
  ensures forall k in 0..len(dst): (k < at || k >= at + sep + n + pad) ==> dst[k] == old(dst)[k]
{
  put_nl_span(inout dst, at, sep, src, lo, n);
  if pad == 4 {
    put_pad(inout dst, at + sep + n);
  }
}

// begin2 with the prompt src[lo..lo+n) (valid UTF-8).
pub fn begin3(inout st: [i64], inout sl: [i64], inout bk: Store, src: [u8], lo: i64, n: i64, created: str) -> () ! alloc
  requires len(st) == 4 && len(sl) == 1600
  requires len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  requires 0 <= st[0] && st[0] < 1000000000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1)
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  requires 0 <= lo && 0 <= n && n <= len(src) - lo && n <= 100000000
  requires len(created) == 0 || len(created) == 24
  ensures len(st) == 4 && len(sl) == 1600
  ensures len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  ensures st[0] == old(st)[0] + 1 && st[1] == 1 && st[2] == 0 && st[3] == old(st)[0] % 200
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
{
  let k: i64 = st[0];
  let w: i64 = k % 200;
  let cn: i64 = clip_span(src, lo, n, 32768);
  let mut cnt: i64 = k;
  if cnt > 199 { cnt = 199; }
  reserve(inout bk, sl, k, cnt, cn, cn);
  let at: i64 = bk.end;
  crate::bytes::copy_span(inout bk.data, at, src, lo, lo + cn);
  bk.off[w] = at;
  bk.end = at + cn;
  let mut has: i64 = 0;
  if len(created) == 24 {
    put_str(inout bk.stamp, 48 * w, created, 24);
    has = 1;
  }
  let mut cl: i64 = 0;
  if n > 32768 || st[2] == 1 { cl = 1; }
  sl[8 * w] = cn;
  sl[8 * w + 1] = 0;
  sl[8 * w + 2] = 0;
  sl[8 * w + 3] = 0;
  sl[8 * w + 4] = cl;
  sl[8 * w + 5] = has;
  sl[8 * w + 6] = 0;
  sl[8 * w + 7] = k;
  st[0] = k + 1;
  st[1] = 1;
  st[2] = 0;
  st[3] = w;
}

// answer2 with the text src[lo..lo+n) (valid UTF-8) followed, when pad is 4, by the one scalar U+10000.
pub fn answer3(inout st: [i64], inout sl: [i64], inout bk: Store, src: [u8], lo: i64, n: i64, pad: i64, at: str) -> () ! alloc
  requires len(st) == 4 && len(sl) == 1600
  requires len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  requires 0 <= st[0] && st[0] <= 1000000000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1)
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  requires 0 <= lo && 0 <= n && n <= len(src) - lo && n + pad <= 100000000 && (pad == 0 || pad == 4)
  requires len(at) == 0 || len(at) == 24
  ensures len(st) == 4 && len(sl) == 1600
  ensures len(bk.off) == 200 && len(bk.stamp) == 9600 && 0 <= bk.end && bk.end <= len(bk.data)
  ensures st[0] == old(st)[0] && st[1] == old(st)[1] && st[2] == old(st)[2] && st[3] == old(st)[3]
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
{
  if st[1] == 0 { return; }
  let c: i64 = st[3];
  if len(at) == 24 {
    put_str(inout bk.stamp, 48 * c + 24, at, 24);
    sl[8 * c + 6] = 1;
  }
  let tl: i64 = n + pad;
  if tl == 0 { return; }
  let used: i64 = sl[8 * c + 2];
  if used >= 32768 { return; }
  let rl: i64 = sl[8 * c + 1];
  let room: i64 = 32768 - used;
  let mut sep: i64 = 0;
  if rl > 0 { sep = 2; }
  let mut s2: i64 = sep;
  let mut take: i64 = n;
  let mut tp: i64 = pad;
  let mut full: bool = true;
  if sep + tl > room {
    full = false;
    tp = 0;
    if sep == 2 && room < 2 {
      s2 = room;
      take = 0;
    } else if room - sep < n {
      take = clip_span(src, lo, n, room - sep);
    }
  }
  let mut cnt: i64 = st[0];
  if cnt > 200 { cnt = 200; }
  if cnt < 1 { return; }
  let piece: i64 = s2 + take + tp;
  reserve(inout bk, sl, st[0], cnt, 0, piece);
  let o: i64 = bk.off[c];
  let e: i64 = bk.end;
  if o < 0 || o != e - sl[8 * c] - rl { return; }
  write_span(inout bk.data, e, s2, src, lo, take, tp);
  bk.end = e + piece;
  sl[8 * c + 1] = rl + piece;
  if full {
    sl[8 * c + 2] = used + piece;
  } else {
    sl[8 * c + 2] = 32768;
    sl[8 * c + 4] = 1;
  }
}

// Per slot: prompt, reply, created stamp and completed stamp source offsets.
pub fn new_refs() -> [i64] ! alloc
  ensures len(result) == 800
{
  return alloc(800, -1);
}

pub fn begin_ref(inout st: [i64], inout sl: [i64], inout rf: [i64], src: [u8], lo: i64, n: i64, co: i64) -> ()
  requires len(st) == 4 && len(sl) == 1600
  requires len(rf) == 800
  requires 0 <= st[0] && st[0] < 1000000000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1)
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  requires 0 <= lo && 0 <= n && n <= len(src) - lo
  requires co == -1 || (0 <= co && co <= len(src) - 24)
  ensures len(st) == 4 && len(sl) == 1600
  ensures len(rf) == 800
  ensures st[0] == old(st)[0] + 1 && st[1] == 1 && st[2] == 0 && st[3] == old(st)[0] % 200
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
{
  let k: i64 = st[0];
  let w: i64 = k % 200;
  let cn: i64 = clip_span(src, lo, n, 32768);
  rf[4 * w] = lo;
  rf[4 * w + 1] = -1;
  rf[4 * w + 2] = co;
  rf[4 * w + 3] = -1;
  let mut has: i64 = 0;
  if co >= 0 { has = 1; }
  let mut cl: i64 = 0;
  if n > 32768 || st[2] == 1 { cl = 1; }
  sl[8 * w] = cn;
  sl[8 * w + 1] = 0;
  sl[8 * w + 2] = 0;
  sl[8 * w + 3] = 0;
  sl[8 * w + 4] = cl;
  sl[8 * w + 5] = has;
  sl[8 * w + 6] = 0;
  sl[8 * w + 7] = k;
  st[0] = k + 1;
  st[1] = 1;
  st[2] = 0;
  st[3] = w;
}

pub fn answer_ref(inout st: [i64], inout sl: [i64], inout rf: [i64], src: [u8], lo: i64, n: i64, pad: i64, dc: i64) -> bool
  requires len(st) == 4 && len(sl) == 1600
  requires len(rf) == 800
  requires 0 <= st[0] && st[0] <= 1000000000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1)
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  requires 0 <= lo && 0 <= n && n <= len(src) - lo && n + pad <= 100000000 && (pad == 0 || pad == 4)
  requires dc == -1 || (0 <= dc && dc <= len(src) - 24)
  ensures len(st) == 4 && len(sl) == 1600
  ensures len(rf) == 800
  ensures st[0] == old(st)[0] && st[1] == old(st)[1] && st[2] == old(st)[2] && st[3] == old(st)[3]
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
{
  if st[1] == 0 { return true; }
  let c: i64 = st[3];
  if dc >= 0 {
    rf[4 * c + 3] = dc;
    sl[8 * c + 6] = 1;
  }
  let tl: i64 = n + pad;
  if tl == 0 { return true; }
  let used: i64 = sl[8 * c + 2];
  if used >= 32768 { return true; }
  if sl[8 * c + 1] != 0 { return false; }
  let room: i64 = 32768 - used;
  let mut take: i64 = n;
  let full: bool = tl <= room;
  if full {
    if pad != 0 { return false; }
  } else if room < n {
    take = clip_span(src, lo, n, room);
  }
  if st[0] == 0 { return true; }
  rf[4 * c + 1] = lo;
  sl[8 * c + 1] = take;
  if full {
    sl[8 * c + 2] = used + take;
  } else {
    sl[8 * c + 2] = 32768;
    sl[8 * c + 4] = 1;
  }
  return true;
}

pub fn finish_ref(st: [i64], sl: [i64], rf: [i64], src: [u8], base: i64, inout wire: [u8], at: i64) -> Placed ! alloc
  requires len(st) == 4 && len(sl) == 1600
  requires len(rf) == 800
  requires 0 <= st[0] && st[0] <= 1000000000000 && 0 <= base && base <= 3500000
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  ensures len(wire) == len(old(wire))
  ensures 0 <= result.kept && result.kept <= 200 && result.kept <= st[0]
  ensures len(result.turns) == 10 * result.kept
  ensures 0 <= result.text_len && result.text_len <= result.total + 48 * result.kept && result.text_len <= 2106752
  ensures result.ok ==> (0 <= at && at <= len(wire) && result.text_len <= len(wire) - at)
  ensures forall k in 0..len(wire): ((k < at || k >= at + result.text_len) ==> wire[k] == old(wire)[k])
  ensures (result.trimmed == 0 && result.kept == st[0]) || (result.trimmed == 1 && result.kept < st[0])
  ensures 0 <= result.total && result.total <= 2097152
  ensures result.total == sum(j in 0..result.kept: sl[8 * ((st[0] - 1 - j) % 200)] + sl[8 * ((st[0] - 1 - j) % 200) + 1])
  ensures (result.kept < st[0] && result.kept < 200) ==> result.total + sl[8 * ((st[0] - 1 - result.kept) % 200)] + sl[8 * ((st[0] - 1 - result.kept) % 200) + 1] > 2097152
{
  let p: Layout = plan(st, sl);
  let kept: i64 = p.kept;
  let b: i64 = st[0];
  let tl: i64 = p.text_len;
  let mut turns: [i64] = alloc(10 * kept, 0);
  let mut tr: i64 = 0;
  if kept < b { tr = 1; }
  if at < 0 || at > len(wire) || tl > len(wire) - at {
    return Placed { turns: move turns, kept: kept, trimmed: tr, total: p.total, text_len: tl, ok: false };
  }
  let dl: i64 = len(src);
  let mut cursor: i64 = tl;
  let mut j: i64 = 0;
  while j < kept
    invariant (tr == 0 && kept == b) || (tr == 1 && kept < b)
    invariant 0 <= j && j <= kept && 0 <= kept && kept <= 200 && kept <= b && 0 <= b && b <= 1000000000000
    invariant len(turns) == 10 * kept && 0 <= at && at <= len(wire) && tl <= len(wire) - at && len(wire) == len(old(wire)) && len(sl) == 1600
    invariant len(rf) == 800 && len(src) == dl
    invariant 0 <= cursor && cursor <= tl && tl <= 2106752
    invariant forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
    invariant forall k in 0..len(wire): ((k < at || k >= at + tl) ==> wire[k] == old(wire)[k])
    decreases kept - j
  {
    let w: i64 = (b - 1 - j) % 200;
    let plen: i64 = sl[8 * w];
    let rlen: i64 = sl[8 * w + 1];
    let cp: i64 = sl[8 * w + 5];
    let dp: i64 = sl[8 * w + 6];
    let po: i64 = rf[4 * w];
    let ro: i64 = rf[4 * w + 1];
    let co: i64 = rf[4 * w + 2];
    let dc: i64 = rf[4 * w + 3];
    let e: i64 = cursor;
    if plen + rlen + 24 * cp + 24 * dp > e || po < 0 || po > dl - plen
      || ((rlen != 0 || ro != -1) && (ro < 0 || ro > dl - rlen))
      || (cp == 1 && (co < 0 || co > dl - 24))
      || (dp == 1 && (dc < 0 || dc > dl - 24)) {
      return Placed { turns: move turns, kept: kept, trimmed: tr, total: p.total, text_len: tl, ok: false };
    }
    let lo: i64 = e - plen - rlen - 24 * cp - 24 * dp;
    crate::bytes::copy_span(inout wire, at + lo, src, po, po + plen);
    if rlen > 0 {
      crate::bytes::copy_span(inout wire, at + lo + plen, src, ro, ro + rlen);
    }
    if cp == 1 {
      crate::bytes::copy_span(inout wire, at + lo + plen + rlen, src, co, co + 24);
    }
    if dp == 1 {
      crate::bytes::copy_span(inout wire, at + lo + plen + rlen + 24 * cp, src, dc, dc + 24);
    }
    let t: i64 = kept - 1 - j;
    turns[10 * t] = base + lo;
    turns[10 * t + 1] = plen;
    turns[10 * t + 2] = base + lo + plen;
    turns[10 * t + 3] = rlen;
    if cp == 1 {
      turns[10 * t + 4] = base + lo + plen + rlen;
      turns[10 * t + 5] = 24;
    } else {
      turns[10 * t + 4] = -1;
      turns[10 * t + 5] = 0;
    }
    if dp == 1 {
      turns[10 * t + 6] = base + lo + plen + rlen + 24 * cp;
      turns[10 * t + 7] = 24;
    } else {
      turns[10 * t + 6] = -1;
      turns[10 * t + 7] = 0;
    }
    turns[10 * t + 8] = sl[8 * w + 3];
    turns[10 * t + 9] = sl[8 * w + 4];
    cursor = lo;
    j = j + 1;
  }
  return Placed { turns: move turns, kept: kept, trimmed: tr, total: p.total, text_len: tl, ok: true };
}


// In-place form (DB44): the turn texts already sit in buf, the caller's byte arena, at the rf offsets. finish_inplace
// moves the selected drafts left to buf[at..at+text_len), newest first, so the arena becomes the wire and no second
// buffer is allocated. Each move is overlap safe (copy_within), so the proof is bounds only, as for finish_ref.
// Output correctness needs one caller fact that is not proved here: every source span lies at or after `at`, and
// the held turns sit newest first at increasing offsets, each as prompt, reply, created stamp, completed stamp. The
// bytes a draft takes in the wire are at most its source bytes (clipping only shortens), so by induction each
// draft's destination starts at or before its source and ends at or before the next older draft's source: no move
// overwrites a byte that is still to be read. Turn offsets are relative to base as in finish_ref; the rows stay
// oldest first while the texts are newest first, which a reader that follows the rows does not see.
pub fn finish_inplace(st: [i64], sl: [i64], rf: [i64], inout buf: [u8], base: i64, at: i64) -> Placed ! alloc
  requires len(st) == 4 && len(sl) == 1600
  requires len(rf) == 800
  requires 0 <= st[0] && st[0] <= 1000000000000 && 0 <= base && base <= 3500000
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  ensures len(buf) == len(old(buf))
  ensures 0 <= result.kept && result.kept <= 200 && result.kept <= st[0]
  ensures len(result.turns) == 10 * result.kept
  ensures 0 <= result.text_len && result.text_len <= result.total + 48 * result.kept && result.text_len <= 2106752
  ensures result.ok ==> (0 <= at && at <= len(buf) && result.text_len <= len(buf) - at)
  ensures (result.trimmed == 0 && result.kept == st[0]) || (result.trimmed == 1 && result.kept < st[0])
  ensures 0 <= result.total && result.total <= 2097152
  ensures result.total == sum(j in 0..result.kept: sl[8 * ((st[0] - 1 - j) % 200)] + sl[8 * ((st[0] - 1 - j) % 200) + 1])
  ensures (result.kept < st[0] && result.kept < 200) ==> result.total + sl[8 * ((st[0] - 1 - result.kept) % 200)] + sl[8 * ((st[0] - 1 - result.kept) % 200) + 1] > 2097152
{
  let p: Layout = plan(st, sl);
  let kept: i64 = p.kept;
  let b: i64 = st[0];
  let tl: i64 = p.text_len;
  let mut turns: [i64] = alloc(10 * kept, 0);
  let mut tr: i64 = 0;
  if kept < b { tr = 1; }
  if at < 0 || at > len(buf) || tl > len(buf) - at {
    return Placed { turns: move turns, kept: kept, trimmed: tr, total: p.total, text_len: tl, ok: false };
  }
  let dl: i64 = len(buf);
  let mut cursor: i64 = 0;
  let mut j: i64 = 0;
  while j < kept
    invariant (tr == 0 && kept == b) || (tr == 1 && kept < b)
    invariant 0 <= j && j <= kept && 0 <= kept && kept <= 200 && kept <= b && 0 <= b && b <= 1000000000000
    invariant len(turns) == 10 * kept && 0 <= at && at <= dl && tl <= dl - at && len(buf) == dl && dl == len(old(buf)) && len(sl) == 1600
    invariant len(rf) == 800
    invariant 0 <= cursor && cursor <= tl && tl <= 2106752
    invariant forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
    decreases kept - j
  {
    let w: i64 = (b - 1 - j) % 200;
    let plen: i64 = sl[8 * w];
    let rlen: i64 = sl[8 * w + 1];
    let cp: i64 = sl[8 * w + 5];
    let dp: i64 = sl[8 * w + 6];
    let po: i64 = rf[4 * w];
    let ro: i64 = rf[4 * w + 1];
    let co: i64 = rf[4 * w + 2];
    let dc: i64 = rf[4 * w + 3];
    let lo: i64 = cursor;
    let e: i64 = lo + plen + rlen + 24 * cp + 24 * dp;
    if e > tl || po < 0 || po > dl - plen
      || ((rlen != 0 || ro != -1) && (ro < 0 || ro > dl - rlen))
      || (cp == 1 && (co < 0 || co > dl - 24))
      || (dp == 1 && (dc < 0 || dc > dl - 24)) {
      return Placed { turns: move turns, kept: kept, trimmed: tr, total: p.total, text_len: tl, ok: false };
    }
    copy_within(inout buf, at + lo, po, plen);
    if rlen > 0 {
      copy_within(inout buf, at + lo + plen, ro, rlen);
    }
    if cp == 1 {
      copy_within(inout buf, at + lo + plen + rlen, co, 24);
    }
    if dp == 1 {
      copy_within(inout buf, at + lo + plen + rlen + 24 * cp, dc, 24);
    }
    let t: i64 = kept - 1 - j;
    turns[10 * t] = base + lo;
    turns[10 * t + 1] = plen;
    turns[10 * t + 2] = base + lo + plen;
    turns[10 * t + 3] = rlen;
    if cp == 1 {
      turns[10 * t + 4] = base + lo + plen + rlen;
      turns[10 * t + 5] = 24;
    } else {
      turns[10 * t + 4] = -1;
      turns[10 * t + 5] = 0;
    }
    if dp == 1 {
      turns[10 * t + 6] = base + lo + plen + rlen + 24 * cp;
      turns[10 * t + 7] = 24;
    } else {
      turns[10 * t + 6] = -1;
      turns[10 * t + 7] = 0;
    }
    turns[10 * t + 8] = sl[8 * w + 3];
    turns[10 * t + 9] = sl[8 * w + 4];
    cursor = e;
    j = j + 1;
  }
  return Placed { turns: move turns, kept: kept, trimmed: tr, total: p.total, text_len: tl, ok: true };
}
