mod json;
mod lex;
mod parse;

// A5: byte-preserving JSON Lines iteration and bounded range parsing.
pub enum JsonlStep { Line(start: i64, end: i64, next: i64), NeedMore, Done }

pub fn jsonl_next(data: [u8], offset: i64, is_final: bool) -> JsonlStep
  requires 0 <= offset && offset <= len(data)
  ensures is_variant(result, JsonlStep::Line) ==> (offset <= variant_field(result, JsonlStep::Line, start) && variant_field(result, JsonlStep::Line, start) <= variant_field(result, JsonlStep::Line, end) && variant_field(result, JsonlStep::Line, end) <= variant_field(result, JsonlStep::Line, next) && variant_field(result, JsonlStep::Line, next) <= len(data) && offset < variant_field(result, JsonlStep::Line, next))
{
  let mut i: i64 = offset;
  while i < len(data)
    invariant offset <= i && i <= len(data)
    decreases len(data) - i
  {
    if data[i] == 10 {
      let mut end: i64 = i;
      if i > offset { if data[i - 1] == 13 { end = i - 1; } }
      return JsonlStep::Line(offset, end, i + 1);
    }
    i = i + 1;
  }
  if !is_final { return JsonlStep::NeedMore; }
  if offset < len(data) { return JsonlStep::Line(offset, len(data), len(data)); }
  return JsonlStep::Done;
}

pub fn parse_range(data: [u8], lo: i64, hi: i64) -> crate::json::JsonParse ! alloc
  requires 0 <= lo && lo <= hi && hi <= len(data)
  ensures is_variant(result, crate::json::JsonParse::Failed) ==> (0 <= variant_field(result, crate::json::JsonParse::Failed, error).position && variant_field(result, crate::json::JsonParse::Failed, error).position <= hi - lo)
  ensures hi - lo > 16777216 ==> is_variant(result, crate::json::JsonParse::Failed)
  ensures hi - lo > 16777216 ==> (variant_field(result, crate::json::JsonParse::Failed, error).position == 0 && variant_field(result, crate::json::JsonParse::Failed, error).kind == 1)
  ensures is_variant(result, crate::json::JsonParse::Parsed) ==> crate::json::doc_local(variant_field(result, crate::json::JsonParse::Parsed, document))
{
  let n: i64 = hi - lo;
  if n > crate::json::limit_input_bytes() {
    return crate::json::JsonParse::Failed(crate::json::make_error(0, crate::json::err_input_too_large()));
  }
  // hand parse(&data[lo..hi]) borrows the range; the owned document takes one exact copy (B-LLVM), as parse_copy.
  let owned: [u8] = copy(subview(data, lo, hi));
  return parse_owned(move owned, n);
}

// DB55 (G-DB54-1): parse_range(data, 0, hi) for a caller that gives up its buffer: no copy of the bytes; the document's
// source is data shortened to hi (in place on both backends) and the scanned tape is moved in.
pub fn parse_owned(take data: [u8], hi: i64) -> crate::json::JsonParse ! alloc
  requires 0 <= hi && hi <= len(data)
  ensures is_variant(result, crate::json::JsonParse::Failed) ==> (0 <= variant_field(result, crate::json::JsonParse::Failed, error).position && variant_field(result, crate::json::JsonParse::Failed, error).position <= hi)
  ensures hi > 16777216 ==> is_variant(result, crate::json::JsonParse::Failed)
  ensures hi > 16777216 ==> (variant_field(result, crate::json::JsonParse::Failed, error).position == 0 && variant_field(result, crate::json::JsonParse::Failed, error).kind == 1)
  ensures is_variant(result, crate::json::JsonParse::Parsed) ==> crate::json::doc_local(variant_field(result, crate::json::JsonParse::Parsed, document))
{
  let n: i64 = hi;
  if n > crate::json::limit_input_bytes() {
    return crate::json::JsonParse::Failed(crate::json::make_error(0, crate::json::err_input_too_large()));
  }
  // an owned local, so the truncate in the returned document shortens it in place (Rust and LLVM)
  let owned: [u8] = move data;
  let invalid: i64 = crate::lex::validate_utf8(owned, 0, n);
  if invalid >= 0 { return crate::json::JsonParse::Failed(crate::json::make_error(invalid, 4)); }
  let checked: crate::parse::Checked = crate::parse::scan(subview(owned, 0, n));
  match checked {
    crate::parse::Checked::Rejected(position, kind) => {
      return crate::json::JsonParse::Failed(crate::json::make_error(position, kind));
    }
    crate::parse::Checked::Tape(tape) => {
      if !crate::json::check_tape(tape, n) { return crate::json::JsonParse::Failed(crate::json::make_error(0, 18)); }
      return crate::json::JsonParse::Parsed(crate::json::JsonDocument { source: truncate(owned, n), tape: move tape });
    }
  }
}

// DB59 (G-DB58-1): parse_range for a caller that keeps and reuses its buffer (a line buffer): data[lo..hi) is copied
// once into an exact-size block (one allocate-and-fill, no zeroed buffer and byte loop) that parse_owned moves into
// the document. Same results as parse_range.
pub fn parse_copy(data: [u8], lo: i64, hi: i64) -> crate::json::JsonParse ! alloc
  requires 0 <= lo && lo <= hi && hi <= len(data)
  ensures is_variant(result, crate::json::JsonParse::Failed) ==> (0 <= variant_field(result, crate::json::JsonParse::Failed, error).position && variant_field(result, crate::json::JsonParse::Failed, error).position <= hi - lo)
  ensures hi - lo > 16777216 ==> is_variant(result, crate::json::JsonParse::Failed)
  ensures hi - lo > 16777216 ==> (variant_field(result, crate::json::JsonParse::Failed, error).position == 0 && variant_field(result, crate::json::JsonParse::Failed, error).kind == 1)
  ensures is_variant(result, crate::json::JsonParse::Parsed) ==> crate::json::doc_local(variant_field(result, crate::json::JsonParse::Parsed, document))
{
  let n: i64 = hi - lo;
  if n > crate::json::limit_input_bytes() {
    return crate::json::JsonParse::Failed(crate::json::make_error(0, crate::json::err_input_too_large()));
  }
  let owned: [u8] = copy(subview(data, lo, hi));
  return parse_owned(move owned, n);
}

// ---- borrowed-span parsing: scan into caller scratch, then (optionally) build an exact-size owned document ----

// Validate and scan data[lo..hi) in place, with no allocation. Same outcome as parse_range except that the document is not built:
//   kind == 0: accepted, `records` records in tape[0 .. 6 * records) (span offsets relative to lo);
//   kind > 0: parse_range's Failed kind at the same (relative) position (>16777216 bytes: kind 1 at 0; bad UTF-8: kind 4);
//   kind < 0: the scratch is too small (tape 6 * records slots, stack 516 slots); the caller falls back to parse_range.
pub fn scan_span(data: [u8], lo: i64, hi: i64, inout tape: [i64], inout stack: [i64]) -> crate::parse::Pass
  requires 0 <= lo && lo <= hi && hi <= len(data)
  ensures len(tape) == len(old(tape)) && len(stack) == len(old(stack))
  ensures result.kind == 0 ==> (0 <= result.records && result.records <= 1048576 && 6 * result.records <= len(tape))
  ensures result.kind > 0 ==> (0 <= result.position && result.position <= hi - lo)
  ensures result.kind == 0 || result.kind == -1 || result.kind == -2 || result.kind > 0
  ensures hi - lo > 16777216 ==> (result.kind == 1 && result.position == 0)
{
  let n: i64 = hi - lo;
  if n > crate::json::limit_input_bytes() {
    return crate::parse::Pass { position: 0, kind: crate::json::err_input_too_large(), records: 0 };
  }
  let invalid: i64 = crate::lex::validate_utf8(data, lo, hi);
  if invalid >= 0 {
    return crate::parse::Pass { position: invalid - lo, kind: crate::json::err_invalid_utf8(), records: 0 };
  }
  return crate::parse::scan_into(data, lo, hi, inout tape, inout stack);
}

// The owned document of a span that scan_span accepted: the span bytes copied once, the tape prefix in an exact-size array.
// Failed (0, 18) when the tape does not pass check_tape, as parse_range does.
pub fn build_span(data: [u8], lo: i64, hi: i64, tape: [i64], records: i64) -> crate::json::JsonParse ! alloc
  requires 0 <= lo && lo <= hi && hi <= len(data) && hi - lo <= 16777216
  requires 0 <= records && records <= 1048576 && 6 * records <= len(tape)
  ensures is_variant(result, crate::json::JsonParse::Failed) ==> (0 <= variant_field(result, crate::json::JsonParse::Failed, error).position && variant_field(result, crate::json::JsonParse::Failed, error).position <= hi - lo)
  ensures is_variant(result, crate::json::JsonParse::Parsed) ==> crate::json::doc_local(variant_field(result, crate::json::JsonParse::Parsed, document))
{
  // DB21 (D-DB15-3): the span bytes come from copy(subview(...)) (one allocate-and-fill, no zeroed buffer and byte loop).
  // The tape prefix keeps its loop (gap ZP): copy(subview(tape, 0, m)) and arr_reserve + arr_append(inout exact, tape, 0, m)
  // both hit "z3 error 6: invalid pattern" (G-DB21-1, checked again in step 2.3).
  let n: i64 = hi - lo;
  let m: i64 = 6 * records;
  let source: [u8] = copy(subview(data, lo, hi));
  let mut exact: [i64] = alloc(m, 0);
  let mut t: i64 = 0;
  while t < m
    invariant 0 <= t && t <= m && m == 6 * records && m <= len(tape) && len(exact) == m
    decreases m - t
  { exact[t] = tape[t]; t = t + 1; }
  if !crate::json::check_tape(exact, n) { return crate::json::JsonParse::Failed(crate::json::make_error(0, 18)); }
  return crate::json::JsonParse::Parsed(crate::json::JsonDocument { source: move source, tape: move exact });
}

// parse_range with caller scratch: same result for every input; a too-small scratch falls back to parse_range.
pub fn parse_span(data: [u8], lo: i64, hi: i64, inout tape: [i64], inout stack: [i64]) -> crate::json::JsonParse ! alloc
  requires 0 <= lo && lo <= hi && hi <= len(data)
  ensures is_variant(result, crate::json::JsonParse::Failed) ==> (0 <= variant_field(result, crate::json::JsonParse::Failed, error).position && variant_field(result, crate::json::JsonParse::Failed, error).position <= hi - lo)
  ensures hi - lo > 16777216 ==> is_variant(result, crate::json::JsonParse::Failed)
  ensures hi - lo > 16777216 ==> (variant_field(result, crate::json::JsonParse::Failed, error).position == 0 && variant_field(result, crate::json::JsonParse::Failed, error).kind == 1)
  ensures is_variant(result, crate::json::JsonParse::Parsed) ==> crate::json::doc_local(variant_field(result, crate::json::JsonParse::Parsed, document))
{
  let sp: crate::parse::Pass = scan_span(data, lo, hi, inout tape, inout stack);
  if sp.kind < 0 { return parse_range(data, lo, hi); }
  if sp.kind > 0 { return crate::json::JsonParse::Failed(crate::json::make_error(sp.position, sp.kind)); }
  if hi - lo > 16777216 { return crate::json::JsonParse::Failed(crate::json::make_error(0, 1)); }
  return build_span(data, lo, hi, tape, sp.records);
}

// -1 denotes negative input or an unrepresentable absolute offset.
pub fn absolute_offset(base: i64, start: i64, position: i64) -> i64
  ensures result == -1 || (result >= 0 && result == base + start + position)
  ensures (base < 0 || start < 0 || position < 0) ==> result == -1
{
  if base < 0 || start < 0 || position < 0 { return -1; }
  if start > 9223372036854775807 - base { return -1; }
  let sum: i64 = base + start;
  if position > 9223372036854775807 - sum { return -1; }
  return sum + position;
}
