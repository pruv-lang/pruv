mod json;

// A3: decoding semantics are specified for parser-validated quoted spans.
trusted rust fn utf8_to_string(data: [u8]) -> String ! alloc
  ensures len(result) == 0 || len(result) == len(data)
  ensures len(result) == len(data) ==> (forall i in 0..len(data): result[i] == data[i])
  = "::pruv_str::utf8_to_string";

pub struct Step { next: i64, value: i64 }
fn hex(c: i64) -> i64
  ensures 0 <= result && result <= 15
{
  if 48 <= c && c <= 57 { return c - 48; }
  if 65 <= c && c <= 70 { return c - 55; }
  if 97 <= c && c <= 102 { return c - 87; }
  return 0;
}
pub fn step(a: [u8], p: i64, end: i64) -> Step
  requires 0 <= p && p < end && end <= len(a) && end <= 16777216
  ensures p < result.next && result.next <= end
  ensures 0 <= result.value && result.value <= 1114111
  ensures result.value > 65535 ==> result.next >= p + 2
  ensures a[p] == 92 ==> a[result.next - 1] < 128
  ensures (a[p] == 92 && end - p >= 6 && a[p + 1] == 117 && a[p + 4] >= 128)
    ==> (result.next == p + 1 && result.value == 92)
{
  // L-gaps 17 (4.4x-DS): an escape is decoded only if it ends on an ASCII byte (hand `escape` needs ASCII after
  // `\`, and `\u` needs four ASCII digits); otherwise the `\` is one literal byte. Valid JSON gives the same bytes.
  let c: i64 = a[p];
  if c == 92 && end - p >= 2 && a[p + 1] < 128 {
    let e: i64 = a[p + 1];
    if e == 117 && end - p >= 6 {
      if a[p + 2] >= 128 || a[p + 3] >= 128 || a[p + 4] >= 128 || a[p + 5] >= 128 {
        return Step { next: p + 1, value: 92 };
      }
      let v: i64 = 4096 * hex(a[p + 2]) + 256 * hex(a[p + 3]) + 16 * hex(a[p + 4]) + hex(a[p + 5]);
      return Step { next: p + 6, value: v };
    }
    let mut v: i64 = e;
    if e == 98 { v = 8; }
    if e == 102 { v = 12; }
    if e == 110 { v = 10; }
    if e == 114 { v = 13; }
    if e == 116 { v = 9; }
    return Step { next: p + 2, value: v };
  }
  let mut n: i64 = 1;
  let mut v: i64 = c;
  if 194 <= c && c <= 223 { n = 2; v = c - 192; }
  if 224 <= c && c <= 239 { n = 3; v = c - 224; }
  if 240 <= c && c <= 244 { n = 4; v = c - 240; }
  if end - p < n { return Step { next: p + 1, value: 65533 }; }
  let mut k: i64 = 1;
  while k < n
    invariant 1 <= k && k <= n && 1 <= n && n <= 4 && n <= end - p
    invariant 0 <= p && p < end && end <= len(a) && end <= 16777216
    invariant 0 <= v && v <= 16777215
    decreases n - k
  {
    v = v * 64 + a[p + k] % 64;
    k = k + 1;
    if v > 16777215 { return Step { next: p + n, value: 65533 }; }
  }
  if v > 1114111 { v = 65533; }
  if n == 1 { v = c; }
  return Step { next: p + n, value: v };
}

pub fn string_units(source: [u8], start: i64, end: i64) -> [i64] ! alloc
  requires 0 <= start && start <= end && end <= len(source) && end <= 16777216
  ensures len(result) <= end - start
  ensures forall i in 0..len(result): (0 <= result[i] && result[i] <= 65535)
{
  // Hand shape (hand_json.rs query mode 5): `units(raw).count()`, `Vec::with_capacity(count)`, then decode
  // again and push each unit. One allocation of the exact length.
  let mut p: i64 = start;
  let mut stop: i64 = start;
  if end - start >= 2 { p = start + 1; stop = end - 1; }
  let first: i64 = p;
  let mut count: i64 = 0;
  while p < stop
    invariant start <= first && first <= p && p <= end && start <= stop && stop <= end
    invariant 0 <= count && count <= p - first
    decreases stop - p
  {
    let s: Step = step(source, p, stop);
    if s.value <= 65535 { count = count + 1; } else { count = count + 2; }
    p = s.next;
  }
  let mut out: [i64] = alloc(0, 0);
  arr_reserve(inout out, count);
  p = first;
  while p < stop
    invariant start <= first && first <= p && p <= end && start <= stop && stop <= end
    invariant 0 <= len(out) && len(out) <= p - first
    invariant forall i in 0..len(out): (0 <= out[i] && out[i] <= 65535)
    decreases stop - p
  {
    let s: Step = step(source, p, stop);
    let v: i64 = s.value;
    if v <= 65535 { arr_push(inout out, v); }
    else {
      arr_push(inout out, 55296 + (v - 65536) / 1024);
      arr_push(inout out, 56320 + (v - 65536) % 1024);
    }
    p = s.next;
  }
  return out;
}

// True iff string_units(source, start, end) equals key[0..klen]; no allocation.
pub fn units_equal(source: [u8], start: i64, end: i64, key: [i64], klen: i64) -> bool
  requires 0 <= start && start <= end && end <= len(source) && end <= 16777216 && 0 <= klen && klen <= len(key)
{
  let mut p: i64 = start;
  let mut stop: i64 = start;
  if end - start >= 2 { p = start + 1; stop = end - 1; }
  let mut q: i64 = 0;
  while p < stop
    invariant start <= p && p <= end && start <= stop && stop <= end
    invariant end <= len(source) && end <= 16777216
    invariant 0 <= q && q <= klen && klen <= len(key)
    decreases stop - p
  {
    let s: Step = step(source, p, stop);
    let v: i64 = s.value;
    if v <= 65535 {
      if q >= klen || key[q] != v { return false; }
      q = q + 1;
    } else {
      if q + 1 >= klen { return false; }
      if key[q] != 55296 + (v - 65536) / 1024 || key[q + 1] != 56320 + (v - 65536) % 1024 { return false; }
      q = q + 2;
    }
    p = s.next;
  }
  return q == klen;
}

// units_equal for an ASCII key given as str bytes (ASCII bytes are their own UTF-16 units); no allocation.
pub fn ascii_equal(source: [u8], start: i64, end: i64, key: str) -> bool
  requires 0 <= start && start <= end && end <= len(source) && end <= 16777216
{
  let klen: i64 = len(key);
  let mut p: i64 = start;
  let mut stop: i64 = start;
  if end - start >= 2 { p = start + 1; stop = end - 1; }
  // Fast path: no escapes and no high bytes, so the units are the raw bytes.
  if stop - p == klen {
    let mut i: i64 = 0; let mut plain: bool = true;
    while i < klen
      invariant 0 <= i && i <= klen && klen == len(key) && p + klen == stop && stop <= end && end <= len(source) && start <= p
      decreases klen - i
    {
      let c: i64 = source[p + i];
      if c == 92 || c >= 128 { plain = false; i = klen; }
      else { if c != key[i] { return false; } i = i + 1; }
    }
    if plain { return true; }
  }
  let mut q: i64 = 0;
  while p < stop
    invariant start <= p && p <= end && start <= stop && stop <= end
    invariant end <= len(source) && end <= 16777216
    invariant 0 <= q && q <= klen && klen == len(key)
    decreases stop - p
  {
    let s: Step = step(source, p, stop);
    let v: i64 = s.value;
    if v > 65535 { return false; }
    if q >= klen || key[q] != v { return false; }
    q = q + 1;
    p = s.next;
  }
  return q == klen;
}

// Scalar at p after recombining a high+low surrogate pair; lone surrogates become U+FFFD.
struct Scalar { next: i64, value: i64 }
fn scalar(a: [u8], p: i64, stop: i64) -> Scalar
  requires 0 <= p && p < stop && stop <= len(a) && stop <= 16777216
  ensures p < result.next && result.next <= stop
  ensures 0 <= result.value && result.value <= 1114111
  ensures result.value > 65535 ==> result.next >= p + 2
  ensures result.value < 55296 || result.value > 57343
  ensures a[p] == 92 ==> a[result.next - 1] < 128
{
  let s: Step = step(a, p, stop);
  let mut v: i64 = s.value;
  let mut np: i64 = s.next;
  // 4.4zc (4.4l-RE): the low half is read only after a `\u`, and its four hex digits directly (hand `escape`:
  // `if self.eat("\\u") { let low = self.hex4()?; .. }`).
  if 55296 <= v && v <= 56319 && np + 6 <= stop && a[np] == 92 && a[np + 1] == 117
    && a[np + 2] < 128 && a[np + 3] < 128 && a[np + 4] < 128 && a[np + 5] < 128 {
    let low: i64 = 4096 * hex(a[np + 2]) + 256 * hex(a[np + 3]) + 16 * hex(a[np + 4]) + hex(a[np + 5]);
    if 56320 <= low && low <= 57343 {
      v = 65536 + (v - 55296) * 1024 + low - 56320; np = np + 6;
    }
  }
  if 55296 <= v && v <= 57343 { v = 65533; }
  return Scalar { next: np, value: v };
}
pub fn string_utf8(source: [u8], start: i64, end: i64) -> [u8] ! alloc
  requires 0 <= start && start <= end && end <= len(source) && end <= 16777216
  ensures len(result) <= 3 * (end - start)
  ensures forall i in 0..len(result): (0 <= result[i] && result[i] <= 255)
{
  // 4.4zc (4.4l-RE): a document's string spans were validated by its parser (the hand validates the line once), so
  // the raw bytes of each escape-free chunk are copied as they are, non-ASCII included (hand `extend_from_slice(chunk)`);
  // only escapes are decoded. string_text_owned tests the result as the hand `String::from_utf8(bytes).ok()?` does.
  return decode_utf8(source, start, end, true);
}

fn decode_utf8(source: [u8], start: i64, end: i64, scanned: bool) -> [u8] ! alloc
  requires 0 <= start && start <= end && end <= len(source) && end <= 16777216
  ensures len(result) <= 3 * (end - start)
  ensures forall i in 0..len(result): (0 <= result[i] && result[i] <= 255)
{
  let mut out: [u8] = alloc(0, 0);
  decode_append(inout out, source, start, end, scanned);
  return out;
}

// One pass, as the hand decodes while parsing (`decoded.get_or_insert_with(Vec::new)`, `extend_from_slice` per
// escape-free run, the escape scalar written as UTF-8, no count pass and no reserve; 4.4i-DP).
// Appends to the caller's buffer (4.4i, hand `buf.extend_from_slice` into an existing `Vec`).
// `scanned` (every caller of a parsed document since 4.4zc) copies non-ASCII bytes with the run; `!scanned` decodes
// them to valid UTF-8 for a source with no validity fact (qwen's replay events), which then needs no run-time test.
// L-gaps 17 (4.4x-DS): in the scanned mode a source whose content `start + 1..end - 1` is a valid span also keeps
// `out` valid: every raw run starts at `start + 1` or after an ASCII byte (`scalar` ends an escape on ASCII) and ends
// at `end - 1` or before `\`, so it is a valid sub-window.
pub fn decode_append(inout out: [u8], source: [u8], start: i64, end: i64, scanned: bool) -> () ! alloc
  requires 0 <= start && start <= end && end <= len(source) && end <= 16777216
  requires len(out) <= 50331648
  ensures len(out) <= old(len(out)) + 3 * (end - start)
  ensures (utf8_valid(old(out)) && !scanned) ==> utf8_valid(out)
  ensures (utf8_valid(old(out)) && utf8_valid_span(source, start + 1, end - 1)) ==> utf8_valid(out)
{
  let base: i64 = len(out);
  let mut p: i64 = start;
  let mut stop: i64 = start;
  if end - start >= 2 { p = start + 1; stop = end - 1; }
  while p < stop
    invariant start <= p && p <= stop && stop <= end
    invariant len(out) <= base + 3 * (p - start)
    invariant (utf8_valid(old(out)) && !scanned) ==> utf8_valid(out)
    invariant (utf8_valid(old(out)) && utf8_valid_span(source, start + 1, end - 1)) ==> utf8_valid(out)
    invariant stop == start || (stop == end - 1 && start + 1 <= p)
    invariant scanned ==> (p == start + 1 || p == stop || source[p - 1] < 128 || source[p] == 92)
    decreases stop - p
  {
    let c: i64 = source[p];
    if c != 92 && (scanned || c < 128) {
      // An escape-free run is copied as it is (hand: `extend_from_slice` of the run).
      let run: i64 = p;
      while p < stop && source[p] != 92 && (scanned || source[p] < 128)
        invariant start <= run && run <= p && p <= stop && stop <= end
        invariant !scanned ==> (forall q in run..p: source[q] < 128)
        decreases stop - p
      { p = p + 1; }
      arr_append(inout out, source, run, p - run);
    } else {
      let s: Scalar = scalar(source, p, stop);
      let v: i64 = s.value;
      if v <= 127 {
        arr_push(inout out, v);
      } else if v <= 2047 {
        arr_push(inout out, 192 + v / 64, 128 + v % 64);
      } else if v <= 65535 {
        arr_push(inout out, 224 + v / 4096, 128 + (v / 64) % 64, 128 + v % 64);
      } else {
        arr_push(inout out, 240 + v / 262144, 128 + (v / 4096) % 64, 128 + (v / 64) % 64, 128 + v % 64);
      }
      p = s.next;
    }
  }
}

pub enum Text { Decoded(text: str), InternalInvariant(kind: i64) }
pub fn adapter_probe(data: [u8]) -> str ! alloc
{ let s: String = utf8_to_string(data); return string_to_str(s); }

// DB21 (D-DB15-1): the content of a quoted span that scan_into marked plain (no backslash, tape slot 5 == 1),
// copied once with no count pass. The mark is trusted at run time (G-DB21-2).
pub fn string_utf8_plain(source: [u8], start: i64, end: i64) -> [u8] ! alloc
  requires 0 <= start && start <= end && end <= len(source) && end <= 16777216
  ensures len(result) <= 3 * (end - start)
  ensures forall i in 0..len(result): (0 <= result[i] && result[i] <= 255)
{
  let mut first: i64 = start;
  let mut stop: i64 = start;
  if end - start >= 2 { first = start + 1; stop = end - 1; }
  let need: i64 = stop - first;
  let mut out: [u8] = alloc(0, 0);
  arr_reserve(inout out, need);
  arr_append(inout out, source, first, need);
  return out;
}

pub fn string_utf8_scanned(source: [u8], start: i64, end: i64) -> [u8] ! alloc
  requires 0 <= start && start <= end && end <= len(source) && end <= 16777216
  ensures len(result) <= 3 * (end - start)
  ensures forall i in 0..len(result): (0 <= result[i] && result[i] <= 255)
{
  return decode_utf8(source, start, end, true);
}

// DB56 (G-LG33-1): owned decodes. Each builds its decode buffer as a fresh local, tests it with utf8_valid at run
// time (the test utf8_to_string made) and hands it to str_from_utf8 at its last use, which moves the block into
// the str (D-LG33-2) instead of copying it (hand String::from_utf8; the copy variants went in step 2.9): invalid UTF-8 gives
// InternalInvariant (Text) or "" (owned_text), and the empty buffer is valid.
pub fn string_text_owned(source: [u8], start: i64, end: i64) -> Text ! alloc
  requires 0 <= start && start <= end && end <= len(source) && end <= 16777216
  ensures is_variant(result, Text::Decoded) ==> len(variant_field(result, Text::Decoded, text)) <= 3 * (end - start)
{
  let bytes: [u8] = string_utf8(source, start, end);
  if !utf8_valid(bytes) { return Text::InternalInvariant(crate::json::err_internal_invariant()); }
  let text: str = str_from_utf8(bytes);
  return Text::Decoded(move text);
}

pub fn string_text_scanned_owned(source: [u8], start: i64, end: i64) -> Text ! alloc
  requires 0 <= start && start <= end && end <= len(source) && end <= 16777216
  ensures is_variant(result, Text::Decoded) ==> len(variant_field(result, Text::Decoded, text)) <= 3 * (end - start)
{
  let bytes: [u8] = string_utf8_scanned(source, start, end);
  if !utf8_valid(bytes) { return Text::InternalInvariant(crate::json::err_internal_invariant()); }
  let text: str = str_from_utf8(bytes);
  return Text::Decoded(move text);
}

pub fn string_text_plain_owned(source: [u8], start: i64, end: i64) -> Text ! alloc
  requires 0 <= start && start <= end && end <= len(source) && end <= 16777216
  ensures is_variant(result, Text::Decoded) ==> len(variant_field(result, Text::Decoded, text)) <= 3 * (end - start)
{
  let bytes: [u8] = string_utf8_plain(source, start, end);
  if !utf8_valid(bytes) { return Text::InternalInvariant(crate::json::err_internal_invariant()); }
  let text: str = str_from_utf8(bytes);
  return Text::Decoded(move text);
}

// adapter_probe for a buffer the caller gives up: the bytes as text with no copy, "" when they are not valid UTF-8.
pub fn owned_text(take data: [u8]) -> str ! alloc
{
  let b: [u8] = move data;
  if utf8_valid(b) {
    let text: str = str_from_utf8(b);
    return move text;
  }
  let none: str = "";
  return copy(none);
}
