mod json;
mod lex;

// Owned tapes are built by recursive descent in one pass.
// A token's following byte belongs to the enclosing grammar: truex/1x
// give TrailingData at root and ExpectedCommaOrEnd inside a container.
// TrailingComma blames the closing delimiter, not the comma.
pub struct Pass { position: i64, kind: i64, records: i64 }
enum Lexed { Value(kind: i64, plain: bool), Error(kind: i64) }

fn utf8_width(byte: i64) -> i64
  ensures 1 <= result && result <= 4
{
  if 194 <= byte && byte <= 223 { return 2; }
  if 224 <= byte && byte <= 239 { return 3; }
  if 240 <= byte && byte <= 244 { return 4; }
  return 1;
}

// D33: `crate::lex::scan_string` that also returns the plain bit (no escape), like the hand `self.string()?`
// returning `Cow::Borrowed`. Used by `record` (4.4n, 4.4m-PB) and `token_at` (scan_into, P8).
// Non-ASCII bytes are validated in place.
// An invalid sequence stops the token with error 4; parse then reports the first invalid byte.
// Like the hand `Parser::string`, an error is returned once as `Fault { position, kind }` at the cursor.
// The Ok value is the plain bit (no escape), which feeds `string_utf8_plain`.
// start lets the contract relate the final cursor to its entry position.
fn string_token(input: [u8], start: i64, end: i64, checked: bool, inout pos: i64) -> Result<bool, crate::lex::Fault>
  requires 0 <= start && start < end && end <= len(input) && pos == start && input[start] == 34
  requires checked ==> utf8_valid_span(input, 0, len(input))
  ensures start <= pos && pos <= end
  ensures is_ok(result) ==> (start + 2 <= pos && utf8_valid_span(input, start + 1, pos - 1))
  ensures !is_ok(result) ==> (err_val(result).position == pos && 0 < err_val(result).kind && err_val(result).kind <= 17)
{
  pos = pos + 1;
  let mut plain: bool = true;
  while pos < end
    invariant start < pos && pos <= end && end <= len(input)
    invariant !checked ==> utf8_valid_span(input, start + 1, pos)
    decreases end - pos
  {
    let c: i64 = input[pos];
    if c == 34 { pos = pos + 1; return Ok::<bool, crate::lex::Fault>(plain); }
    if c < 32 { return Err::<bool, crate::lex::Fault>(crate::lex::Fault { position: pos, kind: 16 }); }
    if c >= 128 && checked {
      // 4.4m-SS: the caller validated the whole input (hand `str::from_utf8(line)`), so a raw byte is skipped like
      // the hand's `position(|b| matches!(b, b'"' | b'\\' | 0..=31))`; the span fact follows from the line fact
      // because both quotes are ASCII (SPEC LG30).
      pos = pos + 1;
    } else if c >= 128 {
      let scalar_end: i64 = pos + utf8_width(c);
      if scalar_end > end { return Err::<bool, crate::lex::Fault>(crate::lex::Fault { position: pos, kind: 4 }); }
      if crate::lex::validate_utf8(input, pos, scalar_end) >= 0 { return Err::<bool, crate::lex::Fault>(crate::lex::Fault { position: pos, kind: 4 }); }
      pos = scalar_end;
    } else {
      pos = pos + 1;
      if c == 92 {
        plain = false;
        if pos == end { return Err::<bool, crate::lex::Fault>(crate::lex::Fault { position: pos, kind: 5 }); }
        let esc: i64 = input[pos];
        if esc == 117 {
          pos = pos + 1;
          let hex_start: i64 = pos;
          let mut k: i64 = 0;
          while k < 4
            invariant 0 <= k && k <= 4 && start < pos && pos <= end && end <= len(input)
            invariant pos >= hex_start
            invariant !checked ==> utf8_valid_span(input, start + 1, pos)
            decreases 4 - k
          {
            if pos == end { return Err::<bool, crate::lex::Fault>(crate::lex::Fault { position: pos, kind: 5 }); }
            let h: i64 = input[pos];
            if !((48 <= h && h <= 57) || (65 <= h && h <= 70) || (97 <= h && h <= 102)) {
              return Err::<bool, crate::lex::Fault>(crate::lex::Fault { position: pos, kind: 15 });
            }
            pos = pos + 1;
            k = k + 1;
          }
        } else {
          if esc != 34 && esc != 92 && esc != 47 && esc != 98 && esc != 102 && esc != 110 && esc != 114 && esc != 116 {
            return Err::<bool, crate::lex::Fault>(crate::lex::Fault { position: pos, kind: 14 });
          }
          pos = pos + 1;
        }
      }
    }
  }
  return Err::<bool, crate::lex::Fault>(crate::lex::Fault { position: pos, kind: 17 });
}

// Token packet for the reusable-scratch path `scan_into` (P8) only; the recursive path dispatches in `record`.
fn token_at(input: [u8], start: i64, end: i64, key: bool, inout pos: i64) -> Lexed
  requires 0 <= start && start < end && end <= len(input) && pos == start
  ensures start <= pos && pos <= end
  ensures is_variant(result, Lexed::Value) ==> (start < pos && 0 <= variant_field(result, Lexed::Value, kind) && variant_field(result, Lexed::Value, kind) <= 7)
  ensures is_variant(result, Lexed::Value) ==> ((variant_field(result, Lexed::Value, kind) == 7) == key)
  ensures is_variant(result, Lexed::Value) ==> (variant_field(result, Lexed::Value, plain) ==> (variant_field(result, Lexed::Value, kind) == 4 || variant_field(result, Lexed::Value, kind) == 7))
  ensures is_variant(result, Lexed::Error) ==> variant_field(result, Lexed::Error, kind) > 0
{
  let c: i64 = input[pos];
  if key && c != 34 { return Lexed::Error(7); }
  if c == 34 {
    let text: Result<bool, crate::lex::Fault> = string_token(input, start, end, false, inout pos);
    match text {
      Err(fault) => { return Lexed::Error(fault.kind); }
      Ok(plain) => {
        if key { return Lexed::Value(7, plain); }
        return Lexed::Value(4, plain);
      }
    }
  }
  if c == 91 || c == 123 {
    pos = pos + 1;
    if c == 91 { return Lexed::Value(5, false); }
    return Lexed::Value(6, false);
  }
  if c == 116 || c == 102 || c == 110 {
    let mut r: Result<(), crate::lex::Fault> = Ok::<(), crate::lex::Fault>(());
    if c == 116 { r = crate::lex::scan_literal(input, inout pos, end, "true"); }
    else if c == 102 { r = crate::lex::scan_literal(input, inout pos, end, "false"); }
    else { r = crate::lex::scan_literal(input, inout pos, end, "null"); }
    match r {
      Err(fault) => { return Lexed::Error(fault.kind); }
      Ok(()) => {}
    }
    if c == 116 { return Lexed::Value(2, false); }
    if c == 102 { return Lexed::Value(1, false); }
    return Lexed::Value(0, false);
  }
  if c == 45 || (48 <= c && c <= 57) {
    let r: Result<(), crate::lex::Fault> = crate::lex::scan_number(input, inout pos, end);
    match r {
      Err(fault) => { return Lexed::Error(fault.kind); }
      Ok(()) => {}
    }
    return Lexed::Value(3, false);
  }
  return Lexed::Error(6);
}

fn done(p: i64, k: i64, records: i64) -> Pass
  requires 0 <= p && p <= 16777216 && 0 <= records && records <= 1048576
  ensures result.position == p && result.kind == k && result.records == records
{ return Pass { position: p, kind: k, records: records }; }

// Fixed-length caller scratch used by scan_into.
fn write_record(inout tape: [i64], r: i64, k: i64, s: i64, e: i64, parent: i64, plain_flag: i64) -> bool
  requires 0 <= r && r < 1048576
  requires plain_flag == 0 || (plain_flag == 1 && (k == 4 || k == 7)) || (plain_flag < 0 && (k == 5 || k == 6))
  ensures len(tape) == len(old(tape))
  ensures forall i in 0..len(tape): ((i < 6 * r || i >= 6 * r + 6) ==> tape[i] == old(tape)[i])
  ensures !result ==> (forall i in 0..len(tape): tape[i] == old(tape)[i])
  ensures result ==> (6 * r + 6 <= len(tape) && tape[6 * r] == k && tape[6 * r + 1] == s && tape[6 * r + 2] == e && tape[6 * r + 3] == r + 1 && tape[6 * r + 4] == parent && tape[6 * r + 5] == plain_flag)
{
  let b: i64 = 6 * r;
  if len(tape) - b < 6 { return false; }
  tape[b] = k; tape[b + 1] = s; tape[b + 2] = e;
  tape[b + 3] = r + 1; tape[b + 4] = parent; tape[b + 5] = plain_flag;
  return true;
}
fn close_record(inout tape: [i64], r: i64, e: i64, skip: i64, count: i64) -> bool
  ensures len(tape) == len(old(tape))
  ensures !result ==> (forall i in 0..len(tape): tape[i] == old(tape)[i])
  ensures result ==> (0 <= r && r < 1048576 && 6 * r + 6 <= len(tape))
  ensures result ==> (forall i in 0..len(tape): ((i != 6 * r + 2 && i != 6 * r + 3 && i != 6 * r + 5) ==> tape[i] == old(tape)[i]))
  ensures result ==> (tape[6 * r + 2] == e && tape[6 * r + 3] == skip && tape[6 * r + 5] == count)
{
  if r < 0 || r >= 1048576 { return false; }
  let b: i64 = 6 * r;
  if len(tape) - b < 6 { return false; }
  tape[b + 2] = e; tape[b + 3] = skip; tape[b + 5] = count;
  return true;
}

fn comma_state(kind: i64) -> i64
  ensures (kind == 6 ==> result == 4) && (kind != 6 ==> result == 1)
{ if kind == 6 { return 4; } return 1; }
fn initial_state(kind: i64) -> i64
  ensures (kind == 6 ==> result == 3) && (kind != 6 ==> result == 0)
{ if kind == 6 { return 3; } return 0; }
fn value_state(key: bool) -> i64
  ensures (key ==> result == 5) && (!key ==> result == 2)
{ if key { return 5; } return 2; }
fn value_increment(key: bool) -> i64
  ensures 0 <= result && result <= 1
  ensures (key ==> result == 0) && (!key ==> result == 1)
{ if key { return 0; } return 1; }
fn append_record(inout tape: [i64], r: i64, k: i64, s: i64, e: i64, parent: i64, count: i64) -> () ! alloc
  requires 0 <= r && r < 1048576 && len(tape) == 6 * r
  ensures len(tape) == 6 * (r + 1)
  ensures forall i in 0..len(old(tape)): tape[i] == old(tape)[i]
  ensures tape[6 * r] == k && tape[6 * r + 1] == s && tape[6 * r + 2] == e && tape[6 * r + 3] == r + 1 && tape[6 * r + 4] == parent && tape[6 * r + 5] == count
{
  arr_push(inout tape, k, s, e, r + 1, parent, count);
}

pred fn local_records(tape: [i64], lo: i64, hi: i64, end: i64) -> bool {
  return 0 <= lo && lo <= hi && 6 * hi <= len(tape) &&
    (forall t in lo..hi: (0 <= tape[6 * t] && tape[6 * t] <= 7 &&
      0 <= tape[6 * t + 1] && tape[6 * t + 1] < tape[6 * t + 2] && tape[6 * t + 2] <= end &&
      t < tape[6 * t + 3] && tape[6 * t + 3] <= hi &&
      ((tape[6 * t] <= 4 || tape[6 * t] == 7) ==> (tape[6 * t + 3] == t + 1 && (tape[6 * t + 5] == 0 || (tape[6 * t + 5] == 1 && (tape[6 * t] == 4 || tape[6 * t] == 7)))))));
}

pred fn parents_ok(tape: [i64], lo: i64, hi: i64) -> bool {
  return 0 <= lo && lo <= hi && 6 * hi <= len(tape) &&
    (forall t in lo..hi: (t > 0 ==>
      (0 <= tape[6 * t + 4] && tape[6 * t + 4] < t &&
        (tape[6 * tape[6 * t + 4]] == 5 || tape[6 * tape[6 * t + 4]] == 6) &&
        tape[6 * tape[6 * t + 4] + 1] < tape[6 * t + 1])));
}

// 4.4i-UF: the content of every string and key record (between its quotes) is valid UTF-8, proved from
// `lex::scan_string`'s ensures. Consumers borrow a plain span as a `str` view with no run-time scan.
pub pred fn strings_ok(input: [u8], tape: [i64], lo: i64, hi: i64) -> bool {
  return 0 <= lo && lo <= hi && 6 * hi <= len(tape) &&
    (forall t in lo..hi: ((tape[6 * t] == 4 || tape[6 * t] == 7) ==>
      utf8_valid_span(input, tape[6 * t + 1] + 1, tape[6 * t + 2] - 1)));
}

// Hand `Parser::record` / `Parser::container`: one recursion, errors passed up with `?`.
fn record(input: [u8], inout pos: i64, inout tape: [i64], parent: i64, depth: i64, key: bool) -> Result<(), crate::lex::Fault> ! alloc
  requires 0 <= pos && pos <= len(input) && len(input) <= 16777216 && utf8_valid_span(input, 0, len(input))
  requires 0 <= depth && depth <= 128 && len(tape) % 6 == 0 && len(tape) <= 6291456
  requires len(tape) > 0 ==> (0 <= parent && 6 * parent < len(tape) && (tape[6 * parent] == 5 || tape[6 * parent] == 6) && tape[6 * parent + 1] < pos)
  ensures old(pos) <= pos && pos <= len(input)
  ensures len(tape) >= len(old(tape)) && len(tape) % 6 == 0 && len(tape) <= 6291456
  ensures is_ok(result) ==> (pos > old(pos) && len(tape) > len(old(tape)))
  ensures forall i in 0..len(old(tape)): tape[i] == old(tape)[i]
  ensures is_ok(result) ==> local_records(tape, len(old(tape)) / 6, len(tape) / 6, pos)
  ensures is_ok(result) ==> parents_ok(tape, len(old(tape)) / 6, len(tape) / 6)
  ensures is_ok(result) ==> strings_ok(input, tape, len(old(tape)) / 6, len(tape) / 6)
  ensures !is_ok(result) ==> (0 <= err_val(result).position && err_val(result).position <= len(input))
  ensures is_ok(result) ==> (tape[len(old(tape)) + 3] == len(tape) / 6 && tape[len(old(tape)) + 4] == parent && ((tape[len(old(tape))] == 7) == key))
  decreases 2 * (129 - depth)
{
  let end: i64 = len(input);
  crate::lex::skip_whitespace(input, inout pos, end);
  let start: i64 = pos;
  if pos == end { return Err::<(), crate::lex::Fault>(crate::lex::Fault { position: pos, kind: 5 }); }
  let byte: i64 = input[pos];
  if key && byte != 34 { return Err::<(), crate::lex::Fault>(crate::lex::Fault { position: start, kind: 7 }); }
  let mut kind: i64 = 0;
  let mut plain: i64 = 0;
  if byte == 34 {
    let simple: bool = string_token(input, start, end, true, inout pos)?;
    if simple { plain = 1; }
    kind = 4;
    if key { kind = 7; }
  } else if byte == 91 {
    pos = pos + 1;
    kind = 5;
  } else if byte == 123 {
    pos = pos + 1;
    kind = 6;
  } else if byte == 110 {
    crate::lex::scan_literal(input, inout pos, end, "null")?;
  } else if byte == 102 {
    crate::lex::scan_literal(input, inout pos, end, "false")?;
    kind = 1;
  } else if byte == 116 {
    crate::lex::scan_literal(input, inout pos, end, "true")?;
    kind = 2;
  } else if byte == 45 || (48 <= byte && byte <= 57) {
    crate::lex::scan_number(input, inout pos, end)?;
    kind = 3;
  } else {
    return Err::<(), crate::lex::Fault>(crate::lex::Fault { position: start, kind: 6 });
  }
  let base: i64 = len(tape);
  let id: i64 = base / 6;
  if id == 1048576 { return Err::<(), crate::lex::Fault>(crate::lex::Fault { position: start, kind: 2 }); }
  if (kind == 5 || kind == 6) && depth == 128 { return Err::<(), crate::lex::Fault>(crate::lex::Fault { position: start, kind: 3 }); }
  append_record(inout tape, id, kind, start, pos, parent, plain);
  if kind == 5 || kind == 6 {
    let children: i64 = container(input, inout pos, inout tape, id, depth + 1, kind == 6)?;
    tape[base + 2] = pos;
    tape[base + 3] = len(tape) / 6;
    tape[base + 5] = children;
  }
  return Ok::<(), crate::lex::Fault>(());
}

fn container(input: [u8], inout pos: i64, inout tape: [i64], id: i64, depth: i64, object: bool) -> Result<i64, crate::lex::Fault> ! alloc
  requires 0 <= pos && pos <= len(input) && len(input) <= 16777216 && utf8_valid_span(input, 0, len(input))
  requires 1 <= depth && depth <= 128 && len(tape) % 6 == 0 && len(tape) <= 6291456
  requires 0 <= id && 6 * id < len(tape) && (tape[6 * id] == 5 || tape[6 * id] == 6) && tape[6 * id + 1] < pos
  ensures old(pos) <= pos && pos <= len(input)
  ensures len(tape) >= len(old(tape)) && len(tape) % 6 == 0 && len(tape) <= 6291456
  ensures forall i in 0..len(old(tape)): tape[i] == old(tape)[i]
  ensures is_ok(result) ==> local_records(tape, len(old(tape)) / 6, len(tape) / 6, pos)
  ensures is_ok(result) ==> parents_ok(tape, len(old(tape)) / 6, len(tape) / 6)
  ensures is_ok(result) ==> strings_ok(input, tape, len(old(tape)) / 6, len(tape) / 6)
  ensures !is_ok(result) ==> (0 <= err_val(result).position && err_val(result).position <= len(input))
  decreases 2 * (129 - depth) + 1
{
  let end: i64 = len(input);
  let mut close: i64 = 93;
  if object { close = 125; }
  crate::lex::skip_whitespace(input, inout pos, end);
  if pos < end && input[pos] == close {
    pos = pos + 1;
    return Ok::<i64, crate::lex::Fault>(0);
  }
  let mut children: i64 = 0;
  while pos <= end
    invariant old(pos) <= pos && pos <= end && end == len(input) && end <= 16777216
    invariant len(tape) >= len(old(tape)) && len(tape) % 6 == 0 && len(tape) <= 6291456
    invariant forall i in 0..len(old(tape)): tape[i] == old(tape)[i]
    invariant local_records(tape, len(old(tape)) / 6, len(tape) / 6, pos)
    invariant parents_ok(tape, len(old(tape)) / 6, len(tape) / 6)
    invariant strings_ok(input, tape, len(old(tape)) / 6, len(tape) / 6)
    invariant 0 <= id && 6 * id < len(old(tape)) && (tape[6 * id] == 5 || tape[6 * id] == 6) && tape[6 * id + 1] < old(pos)
    invariant 0 <= children && children <= pos
    decreases end - pos + 1
  {
    if object {
      record(input, inout pos, inout tape, id, depth, true)?;
      crate::lex::skip_whitespace(input, inout pos, end);
      if pos == end { return Err::<i64, crate::lex::Fault>(crate::lex::Fault { position: pos, kind: 5 }); }
      if input[pos] != 58 { return Err::<i64, crate::lex::Fault>(crate::lex::Fault { position: pos, kind: 8 }); }
      pos = pos + 1;
    }
    record(input, inout pos, inout tape, id, depth, false)?;
    children = children + 1;
    crate::lex::skip_whitespace(input, inout pos, end);
    if pos == end { return Err::<i64, crate::lex::Fault>(crate::lex::Fault { position: pos, kind: 5 }); }
    let byte: i64 = input[pos];
    if byte == close {
      pos = pos + 1;
      return Ok::<i64, crate::lex::Fault>(children);
    }
    if byte != 44 { return Err::<i64, crate::lex::Fault>(crate::lex::Fault { position: pos, kind: 9 }); }
    pos = pos + 1;
    crate::lex::skip_whitespace(input, inout pos, end);
    if pos < end && input[pos] == close { return Err::<i64, crate::lex::Fault>(crate::lex::Fault { position: pos, kind: 10 }); }
  }
  return Err::<i64, crate::lex::Fault>(crate::lex::Fault { position: end, kind: 5 });
}
// Parse one root and consume its trailing whitespace (hand `parse`).
fn scan_records(input: [u8], inout tape: [i64]) -> Result<(), crate::lex::Fault> ! alloc
  requires len(input) <= 16777216 && len(tape) == 0 && utf8_valid_span(input, 0, len(input))
  ensures !is_ok(result) ==> (0 <= err_val(result).position && err_val(result).position <= len(input))
  ensures is_ok(result) ==> (len(input) >= 1 && len(tape) % 6 == 0 && len(tape) >= 6 && len(tape) <= 6291456)
  ensures is_ok(result) ==> local_records(tape, 0, len(tape) / 6, len(input))
  ensures is_ok(result) ==> parents_ok(tape, 0, len(tape) / 6)
  ensures is_ok(result) ==> strings_ok(input, tape, 0, len(tape) / 6)
  ensures is_ok(result) ==> (tape[4] == -1 && tape[3] == len(tape) / 6 && tape[0] != 7)
{
  let n: i64 = len(input);
  arr_reserve(inout tape, 32 * 6);
  let mut pos: i64 = 0;
  record(input, inout pos, inout tape, -1, 0, false)?;
  crate::lex::skip_whitespace(input, inout pos, n);
  if pos != n { return Err::<(), crate::lex::Fault>(crate::lex::Fault { position: pos, kind: 11 }); }
  return Ok::<(), crate::lex::Fault>(());
}

// The scan outcome owns its tape so callers can move it into a document.
pub enum Checked { Tape(tape: [i64]), Rejected(position: i64, kind: i64) }
pub fn scan(input: [u8]) -> Checked ! alloc
  requires len(input) <= 16777216 && utf8_valid_span(input, 0, len(input))
  ensures is_variant(result, Checked::Rejected) ==> (0 <= variant_field(result, Checked::Rejected, position) && variant_field(result, Checked::Rejected, position) <= len(input))
  ensures is_variant(result, Checked::Tape) ==> strings_ok(input, variant_field(result, Checked::Tape, tape), 0, len(variant_field(result, Checked::Tape, tape)) / 6)
{
  let mut tape: [i64] = alloc(0, 0);
  let root: Result<(), crate::lex::Fault> = scan_records(input, inout tape);
  assert is_ok(root) ==> strings_ok(input, tape, 0, len(tape) / 6);
  match root {
    Err(fault) => { return Checked::Rejected(fault.position, fault.kind); }
    Ok(()) => {
      return Checked::Tape(move tape);
    }
  }
}

fn failure(p: i64, k: i64) -> crate::json::JsonParse
  ensures is_variant(result, crate::json::JsonParse::Failed)
  ensures variant_field(result, crate::json::JsonParse::Failed, error).position == p
{ return crate::json::JsonParse::Failed(crate::json::make_error(p, k)); }

// Publish the completed tape with an owned source.
fn scan_document(input: [u8]) -> crate::json::JsonParse ! alloc
  requires len(input) <= 16777216 && utf8_valid_span(input, 0, len(input))
  ensures is_variant(result, crate::json::JsonParse::Parsed) ==> crate::json::doc_strings(variant_field(result, crate::json::JsonParse::Parsed, document))
  ensures is_variant(result, crate::json::JsonParse::Failed) ==> (0 <= variant_field(result, crate::json::JsonParse::Failed, error).position && variant_field(result, crate::json::JsonParse::Failed, error).position <= len(input))
  ensures is_variant(result, crate::json::JsonParse::Parsed) ==> len(variant_field(result, crate::json::JsonParse::Parsed, document).source) == len(input)
  ensures is_variant(result, crate::json::JsonParse::Parsed) ==> (len(variant_field(result, crate::json::JsonParse::Parsed, document).tape) % 6 == 0 && len(variant_field(result, crate::json::JsonParse::Parsed, document).tape) >= 6 && len(variant_field(result, crate::json::JsonParse::Parsed, document).tape) <= 6291456)
  ensures is_variant(result, crate::json::JsonParse::Parsed) ==> (len(input) >= 1 && len(input) <= 16777216)
  ensures is_variant(result, crate::json::JsonParse::Parsed) ==> (forall t in 0..len(variant_field(result, crate::json::JsonParse::Parsed, document).tape) / 6: (0 <= variant_field(result, crate::json::JsonParse::Parsed, document).tape[6 * t] && variant_field(result, crate::json::JsonParse::Parsed, document).tape[6 * t] <= 7))
