// Output tail in the shape of `supervisor/hand/core_hand.rs` (`Tail`, `Decoder`): two WHATWG UTF-8 decoders (one
// per stream) feed one UTF-8 byte buffer; the UTF-16 length of the buffer is kept in `units`. When an appended
// character takes the units past 2 * limit (or the bytes past 6 * limit), whole characters leave the front until at
// most `limit` units and 3 * limit bytes remain. `finish` returns the buffer.

pub struct Decoder { remaining: i64, cp: i64, lower: i64, upper: i64 }

// Stream 0 is `d0`, stream 1 is `d1` (hand `decoders: [Decoder; 2]`; Pruv has no fixed-length arrays, P7-1).
pub struct Tail { d0: Decoder, d1: Decoder, bytes: [u8], units: i64, limit: i64 }

// The decoder states the hand decoder can reach. With them `char::from_u32(cp).unwrap()` never fails: the lead
// byte and the first continuation range (`lower..=upper`) keep the finished code point a scalar value.
pub pred fn dec_ok(d: Decoder) -> bool {
  return 128 <= d.lower && d.lower <= d.upper && d.upper <= 191 && 0 <= d.cp && 0 <= d.remaining && d.remaining <= 3
    && (d.remaining == 3 ==> (d.cp <= 4 && (d.cp == 0 ==> d.lower >= 144) && (d.cp == 4 ==> d.upper <= 143)))
    && (d.remaining == 2 ==> (d.cp <= 271 && (d.cp == 0 ==> d.lower >= 160) && (d.cp == 13 ==> d.upper <= 159)))
    && (d.remaining == 1 ==> (d.cp <= 17407 && (d.cp < 864 || d.cp > 895)));
}

pub pred fn tail_ok(tl: Tail) -> bool {
  return 1 <= tl.limit && tl.limit <= 65536 && len(tl.bytes) <= 6 * tl.limit && 0 <= tl.units && tl.units <= 2 * tl.limit
    && dec_ok(tl.d0) && dec_ok(tl.d1);
}

fn decoder_new() -> Decoder
  ensures dec_ok(result) && result.remaining == 0
{
  return Decoder { remaining: 0, cp: 0, lower: 128, upper: 191 };
}

pub fn new(limit: i64) -> Tail ! alloc
  requires 1 <= limit && limit <= 65536
  ensures tail_ok(result) && result.limit == limit
{
  let mut bytes: [u8] = alloc(0, 0);
  arr_reserve(inout bytes, 6 * limit + 4);
  return Tail { d0: decoder_new(), d1: decoder_new(), bytes: move bytes, units: 0, limit: limit };
}

// hand `self.bytes.copy_within(start.., 0); self.bytes.truncate(len - start);`. `copy_within` takes a whole array
// name, not a field (gap CW), so the buffer moves through this `take` call and back (no copy).
fn shift_front(take bytes: [u8], start: i64) -> [u8] ! alloc
  requires 0 <= start && start <= len(bytes)
  ensures len(result) == len(bytes) - start
{
  let len: i64 = len(bytes);
  let mut b: [u8] = move bytes;
  copy_within(inout b, 0, start, len - start);
  b = truncate(b, len - start);
  return move b;
}

fn trim(inout tl: Tail) -> () ! alloc
  requires 1 <= tl.limit && tl.limit <= 65536 && len(tl.bytes) <= 6 * tl.limit + 4
  requires 0 <= tl.units && tl.units <= 2 * tl.limit + 2
  ensures tl.limit == old(tl.limit) && len(tl.bytes) <= 3 * tl.limit && 0 <= tl.units && tl.units <= tl.limit
  ensures tl.d0 == old(tl.d0) && tl.d1 == old(tl.d1)
{
  let mut start: i64 = 0;
  let len: i64 = len(tl.bytes);
  // `start < len`, the two clamps of `start` and `units` and the reset after the loop stand for the UTF-8 validity
  // of `bytes` (and `units` being its UTF-16 length) that hand trusts (gap U8); on valid bytes none of them fires.
  while start < len && (tl.units > tl.limit || len - start > 3 * tl.limit)
    invariant 0 <= start && start <= len && len == len(tl.bytes) && 0 <= tl.units && tl.units <= 2 * tl.limit + 2
    invariant tl.limit == old(tl.limit) && tl.d0 == old(tl.d0) && tl.d1 == old(tl.d1)
    decreases len - start
  {
    let b: i64 = tl.bytes[start];
    let mut width: i64 = 4;
    if b <= 127 { width = 1; } else if b <= 223 { width = 2; } else if b <= 239 { width = 3; }
    start = start + width;
    if width == 4 { tl.units = tl.units - 2; } else { tl.units = tl.units - 1; }
    if start > len { start = len; }
    if tl.units < 0 { tl.units = 0; }
  }
  if start == len { tl.units = 0; }
  if start != 0 {
    let bytes: [u8] = move tl.bytes;
    tl.bytes = shift_front(move bytes, start);
  }
}

fn append(inout tl: Tail, ch: char) -> () ! alloc
  requires 1 <= tl.limit && tl.limit <= 65536 && len(tl.bytes) <= 6 * tl.limit
  requires 0 <= tl.units && tl.units <= 2 * tl.limit
  ensures tl.limit == old(tl.limit) && len(tl.bytes) <= 6 * tl.limit && 0 <= tl.units && tl.units <= 2 * tl.limit
  ensures tl.d0 == old(tl.d0) && tl.d1 == old(tl.d1)
{
  // hand: `ch.encode_utf8(&mut [0; 4])` then one `extend_from_slice`, `units += ch.len_utf16()`
  let c: i64 = i64(u32(ch));
  if c < 128 {
    arr_push(inout tl.bytes, c);
    tl.units = tl.units + 1;
  } else if c < 2048 {
    arr_push(inout tl.bytes, 192 + c / 64);
    arr_push(inout tl.bytes, 128 + c % 64);
    tl.units = tl.units + 1;
  } else if c < 65536 {
    arr_push(inout tl.bytes, 224 + c / 4096);
    arr_push(inout tl.bytes, 128 + (c / 64) % 64);
    arr_push(inout tl.bytes, 128 + c % 64);
    tl.units = tl.units + 1;
  } else {
    arr_push(inout tl.bytes, 240 + c / 262144);
    arr_push(inout tl.bytes, 128 + (c / 4096) % 64);
    arr_push(inout tl.bytes, 128 + (c / 64) % 64);
    arr_push(inout tl.bytes, 128 + c % 64);
    tl.units = tl.units + 2;
  }
  if tl.units > 2 * tl.limit || len(tl.bytes) > 6 * tl.limit {
    trim(inout tl);
  }
}

// Decodes one chunk of stream 0 or 1 into the tail (WHATWG UTF-8 decoder, maximal-subpart replacement).
pub fn push(inout tl: Tail, stream: i64, bytes: [u8]) -> () ! alloc
  requires tail_ok(tl)
  requires stream == 0 || stream == 1
  ensures tail_ok(tl) && tl.limit == old(tl.limit)
{
  for byte in bytes
    invariant tail_ok(tl) && tl.limit == old(tl.limit)
  {
    let decoder = inout if stream == 0 { tl.d0 } else { tl.d1 };
    if decoder.remaining != 0 {
      if decoder.lower <= byte && byte <= decoder.upper {
        decoder.remaining = decoder.remaining - 1;
        // hand `(cp << 6) | (byte & 0x3f)`; the low six bits of `cp << 6` are zero, so `+` gives the same value. With `|`
        // the solver gives up on the char range of the finished code point (gap BV).
        decoder.cp = (decoder.cp << 6) + (byte & 63);
        decoder.lower = 128;
        decoder.upper = 191;
        if decoder.remaining == 0 {
          let ch: char = char(u32(decoder.cp));
          append(inout tl, ch);
        }
        continue;
      }
      decoder = decoder_new();
      append(inout tl, '\u{FFFD}');
    }

    let mut remaining: i64 = 0;
    let mut mask: i64 = 0;
    let mut lower: i64 = 128;
    let mut upper: i64 = 191;
    if byte <= 127 {
      append(inout tl, char(u8(byte)));
      continue;
    } else if byte >= 194 && byte <= 223 {
      remaining = 1;
      mask = 31;
    } else if byte == 224 {
      remaining = 2;
      mask = 15;
      lower = 160;
    } else if byte == 237 {
      remaining = 2;
      mask = 15;
      upper = 159;
    } else if byte >= 225 && byte <= 239 {
      remaining = 2;
      mask = 15;
    } else if byte == 240 {
      remaining = 3;
      mask = 7;
      lower = 144;
    } else if byte == 244 {
      remaining = 3;
      mask = 7;
      upper = 143;
    } else if byte >= 241 && byte <= 243 {
      remaining = 3;
      mask = 7;
    } else {
      append(inout tl, '\u{FFFD}');
      continue;
    }
    let slot = inout if stream == 0 { tl.d0 } else { tl.d1 };
    slot = Decoder { remaining: remaining, cp: byte & mask, lower: lower, upper: upper };
  }
}

// End of input: an incomplete sequence becomes one U+FFFD, stream 0 first; then the last trim. Consumes the tail.
pub fn finish(take tl: Tail) -> [u8] ! alloc
  requires tail_ok(tl)
  ensures len(result) <= 3 * tl.limit
{
  // hand `finish(mut self)`: the taken value rebinds as mutable.
  let limit: i64 = tl.limit;
  let mut t: Tail = move tl;
  for stream in 0..2
    invariant tail_ok(t) && t.limit == limit
  {
    let mut remaining: i64 = t.d0.remaining;
    if stream == 1 { remaining = t.d1.remaining; }
    if remaining != 0 {
      append(inout t, '\u{FFFD}');
    }
  }
  trim(inout t);
  let bytes: [u8] = move t.bytes;
  return move bytes;
}
