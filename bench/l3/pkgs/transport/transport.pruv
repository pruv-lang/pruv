mod tail;
// G10 transport (moved from bench/l3/mcp; cap is the maximum line length: mcp 4194304, codex 8388608): state holds status, partial length, chunk offset, exit code, chunk length. receive waits for the child's exit in 10 ms slices bounded by the overall timer (slot kept and st[0] stays -6 until it exits, so the caller's pump loops and calls receive again).
pub fn live(l: Loop, slot: i64) -> bool
 requires ev_ok(l)
 ensures result ==> 0 <= slot && slot < ev_cap(l) && ev_kind(l,slot) == 3
{ return slot >= 0 && slot < ev_cap(l) && ev_kind(l,slot) == 3; }
// True when the child is running but its stdin was half-closed (a write hit its deadline or a broken pipe). TS's write throws
// read-failed 'closed' when !child.stdin.writable, so callers fail a NEW request or notification here; replies to server requests ignore it.
pub fn stdin_closed(l: Loop, slot: i64) -> bool {
 if ev_ok(l) { if live(l,slot) { return !ev_write_open(l,slot); } }
 return false;
}
// ms is the caller's overall budget; a write that cannot finish within it half-closes stdin (the overall timer has fired by then), a broken pipe half-closes at once; neither fails the slot, so stdout keeps being read (as Node ignores stdin write errors).
pub fn send(take l: Loop, slot: i64, data: [u8], ms: i64) -> Loop ! async, proc, alloc {
 let mut d: i64 = ms; if d < 0 { d = 0; } if d > 86400000 { d = 86400000; }
 if ev_ok(l) { if live(l,slot) && ev_write_open(l,slot) { return ev_proc_write_for(move l,slot,data,d); } }
 return move l;
}
pub fn close(take l: Loop, slot: i64) -> () ! async, net, proc, alloc {
 let mut q: Loop = move l;
 if ev_ok(q) { if live(q,slot) { q=ev_remove(move q,slot); } }
 let r: Result<i64> = ev_close(move q);
}
// Called before failing a new request on a closed stdin. A write that hit its deadline ran for the whole overall budget, so the
// overall timer has expired and TS (whose write only queues) would end in timeout: st[0] becomes -1 then. Polls without blocking
// until the timer, no event, or 8 events (the round-robin scan reaches every slot of these 2-3 slot loops); otherwise st[0] stays -6.
pub fn expired(take l: Loop, overall: i64, inout st: [i64]) -> Loop ! async, alloc
 requires len(st) == 5
 ensures len(st) == 5
 ensures st[1] == old(st)[1] && st[2] == old(st)[2] && st[3] == old(st)[3] && st[4] == old(st)[4]
{
 let a1: i64 = st[1]; let a2: i64 = st[2]; let a3: i64 = st[3]; let a4: i64 = st[4];
 st[0]=-6;
 let mut q: Loop = move l; let mut k: i64 = 0; let mut more: bool = true;
 while k < 8 && more && st[0] == -6
  invariant 0 <= k && k <= 8 && len(st) == 5
  invariant st[1] == a1 && st[2] == a2 && st[3] == a3 && st[4] == a4
  decreases 8-k
 {
  k=k+1; q=poll(move q,overall,-1,true,inout st,0);
  if !ev_ok(q) { more=false; } else if ev_event_kind(q) == 0 { more=false; }
 }
 return move q;
}
pub fn poll(take l: Loop, overall: i64, init: i64, ready: bool, inout st: [i64], wait: i64) -> Loop ! async, alloc
 requires len(st) == 5
 requires 0 <= wait && wait <= 10
 ensures len(st) == 5
 ensures st[1] == old(st)[1] && st[2] == old(st)[2] && st[3] == old(st)[3] && st[4] == old(st)[4]
{
 let mut q: Loop = move l;
 if ev_ok(q) {
 q=ev_wait(move q,wait);
 if ev_ok(q) && ev_event_kind(q) == 4 {
 if ev_event_slot(q) == overall { st[0]=-1; }
 else if ev_event_slot(q) == init && !ready { st[0]=-2; }
 }
 }
 return move q;
}
// Grow `line` in place for at least one more byte (hand: the reused read_line String grows): double the length, at most cap. The first len(line) bytes are kept.
pub fn grow_line(take line: [u8], cap: i64) -> [u8] ! alloc
 requires 1 <= len(line) && len(line) < cap && cap <= 8389120
 ensures len(line) < len(result) && len(result) <= cap
{
 let mut n: i64 = len(line) * 2; if n > cap { n = cap; }
 let mut b: [u8] = move line;
 b = resize(b, n, 0);
 return move b;
}
// receive with a growing line buffer: the same framing, st[] protocol and -3 at cap, but `line` may start short (1 <= len(line) <= cap)
// and grows in place as needed. st[1] is the number of bytes filled; bytes of line past st[1] are stale. A read that adds
// bytes leaves len(line) == st[1] (the hand's cleared-and-extended read_line String).
pub fn receive_grow(take l: Loop, slot: i64, overall: i64, init: i64, ready: bool, cap: i64,
 inout st: [i64], inout line: [u8], inout chunk: [u8], inout tb: [i64], inout ts: [i64]) -> Loop ! async, proc, alloc
 requires len(st) == 5 && 0 <= st[1] && st[1] <= len(line) && 0 <= st[2] && st[2] <= st[4] && 0 <= st[4] && st[4] <= 65536 && len(chunk) == 65536
 requires 1 <= cap && cap <= 8388608 && 1 <= len(line) && len(line) <= cap
 requires len(ts) == 12 && ts[1] == 1024 && 0 <= ts[0] && ts[0] <= 2048 && len(tb) == 2050
 ensures len(st) == 5 && 0 <= st[1] && st[1] <= len(line) && 0 <= st[2] && st[2] <= st[4] && 0 <= st[4] && st[4] <= 65536 && len(chunk) == 65536
 ensures 1 <= len(line) && len(line) <= cap
 ensures len(ts) == 12 && ts[1] == 1024 && 0 <= ts[0] && ts[0] <= 2048 && len(tb) == 2050
{
 st[0]=-6;
 let mut q: Loop = poll(move l,overall,init,ready,inout st,0);
 if st[0] != -6 { return move q; }
 if !ev_ok(q) { st[0]=-5; return move q; }
 if !live(q,slot) { st[0]=-5; return move q; }
 if !ev_eof(q,slot) {
 q=ev_proc_read(move q,slot,2,65536);
 if ev_ok(q) { let err: [u8] = ev_bytes(q); crate::tail::tail_push(inout tb,inout ts,2,err); }
 }
 if st[2] == st[4] && ev_ok(q) {
 if live(q,slot) && !ev_eof(q,slot) {
 let mut got: i64 = 0;
 q=ev_proc_read_into(move q,slot,1,inout chunk,inout got);
 if ev_ok(q) { st[4]=got; st[2]=0; }
 }
 }
 let begin: i64 = st[2];
 let filled: i64 = st[1];
 let mut i: i64 = begin;
 while i < st[4] && i - begin < cap - filled && chunk[i] != 10
  invariant 0 <= begin && begin <= i && i <= st[4] && st[4] <= 65536 && len(chunk) == 65536
  invariant i - begin <= cap - filled
  decreases st[4] - i
 {
  i = i + 1;
 }
 let needed: i64 = filled + (i - begin);
 // Hand read_line: drop the bytes past the filled prefix, then extend_from_slice (Vec growth, no zero fill).
 if i > begin {
  line = truncate(line, filled);
  arr_append(inout line, chunk, begin, i - begin);
 }
 st[1]=needed;
 // A newline at cap completes the line. Any other byte at cap is consumed and reports -3.
 if i < st[4] {
  if chunk[i] == 10 { st[0]=needed; st[1]=0; }
  else { st[0]=-3; }
  i=i+1;
 }
 st[2]=i;
 if st[0] == -6 && ev_ok(q) {
 if live(q,slot) && ev_eof(q,slot) && st[2] == st[4] {
 q=ev_proc_wait_for(move q,slot,10);
 if ev_ok(q) {
 if slot >= 0 && slot < ev_cap(q) && ev_kind(q,slot) == 0 {
 st[3]=ev_exit(q); q=poll(move q,overall,init,ready,inout st,0);
 if st[0] == -6 { st[0]=-4; }
 }
 else { q=poll(move q,overall,init,ready,inout st,0); }
 }
 } else { q=poll(move q,overall,init,ready,inout st,10); }
 }
 if !ev_ok(q) { st[0]=-5; }
 return move q;
}
