mod tail;
// G10 transport (moved from bench/l3/mcp; cap is the maximum line length: mcp 4194304, codex 8388608). receive waits for the child's exit in 10 ms slices bounded by the overall timer (slot kept and st.status stays -6 until it exits, so the caller's pump loops and calls receive again).
// Reader: the receive state, named fields (hand `Rpc`: `chunk` cursor; X6). status: -6 pending, -1 overall timeout,
// -2 initialize timeout, -3 line over cap, -4 child exited, -5 failed, >= 0 a complete line of that length (the
// partial line is the caller's `line`, as hand `self.line`). at..end: the unread bytes of the current chunk. exit: the
// exit code after -4.
pub struct Reader { status: i64, at: i64, exit: i64, end: i64 }
pub fn reader_new() -> Reader
 ensures result.status == -6 && result.at == 0 && result.end == 0
{ return Reader { status: -6, at: 0, exit: 0, end: 0 }; }
pub fn live(l: Loop, slot: i64) -> bool
 requires ev_ok(l)
 ensures result ==> 0 <= slot && slot < ev_cap(l) && ev_kind(l,slot) == 3
{ return slot >= 0 && slot < ev_cap(l) && ev_kind(l,slot) == 3; }
// True when the child is running but its stdin was half-closed (a write hit its deadline or a broken pipe). TS's write throws
// read-failed 'closed' when !child.stdin.writable, so callers fail a NEW request or notification here; replies to server requests ignore it.
pub fn stdin_closed(l: Loop, slot: i64) -> bool {
 if ev_ok(l) { if live(l,slot) { return !ev_write_open(l,slot); } }
 return false;
}
// ms is the caller's overall budget; a write that cannot finish within it half-closes stdin (the overall timer has fired by then), a broken pipe half-closes at once; neither fails the slot, so stdout keeps being read (as Node ignores stdin write errors).
pub fn send(take l: Loop, slot: i64, data: [u8], ms: i64) -> Loop ! async, proc, alloc {
 let mut d: i64 = ms; if d < 0 { d = 0; } if d > 86400000 { d = 86400000; }
 if ev_ok(l) { if live(l,slot) && ev_write_open(l,slot) { return ev_proc_write_for(move l,slot,data,d); } }
 return move l;
}
pub fn close(take l: Loop, slot: i64) -> () ! async, net, proc, alloc {
 let mut q: Loop = move l;
 if ev_ok(q) { if live(q,slot) { q=ev_remove(move q,slot); } }
 let r: Result<i64> = ev_close(move q);
}
// Called before failing a new request on a closed stdin. A write that hit its deadline ran for the whole overall budget, so the
// overall timer has expired and TS (whose write only queues) would end in timeout: st.status becomes -1 then. Polls without blocking
// until the timer, no event, or 8 events (the round-robin scan reaches every slot of these 2-3 slot loops); otherwise st.status stays -6.
pub fn expired(take l: Loop, overall: i64, inout st: Reader) -> Loop ! async, alloc
 ensures st.at == old(st).at && st.exit == old(st).exit && st.end == old(st).end
{
 let a2: i64 = st.at; let a3: i64 = st.exit; let a4: i64 = st.end;
 st.status=-6;
 let mut q: Loop = move l; let mut k: i64 = 0; let mut more: bool = true;
 while k < 8 && more && st.status == -6
  invariant 0 <= k && k <= 8
  invariant st.at == a2 && st.exit == a3 && st.end == a4
  decreases 8-k
 {
  k=k+1; q=poll(move q,overall,-1,true,inout st,0);
  if !ev_ok(q) { more=false; } else if ev_event_kind(q) == 0 { more=false; }
 }
 return move q;
}
pub fn poll(take l: Loop, overall: i64, init: i64, ready: bool, inout st: Reader, wait: i64) -> Loop ! async, alloc
 requires 0 <= wait && wait <= 10
 ensures st.at == old(st).at && st.exit == old(st).exit && st.end == old(st).end
{
 let mut q: Loop = move l;
 if ev_ok(q) {
 q=ev_wait(move q,wait);
 if ev_ok(q) && ev_event_kind(q) == 4 {
 if ev_event_slot(q) == overall { st.status=-1; }
 else if ev_event_slot(q) == init && !ready { st.status=-2; }
 }
 }
 return move q;
}
// The scan block of hand `Rpc::step`: the newline in chunk[at..end) completes `line` (status = len(line), the cursor
// past it); without one the rest is appended and the cursor reaches end. A piece that would take the line past cap
// fails before any copy (-3, the cursor stays at the piece start, hand `LINE_CAP` check before `extend`).
fn take(inout st: Reader, inout line: [u8], chunk: [u8], cap: i64) -> () ! alloc
 requires 0 <= st.at && st.at <= st.end && st.end <= 65536 && len(chunk) == 65536
 requires 1 <= cap && cap <= 8388608 && len(line) <= cap && st.status == -6
 ensures 0 <= st.at && st.at <= st.end && st.end == old(st).end && st.exit == old(st).exit && len(chunk) == 65536
 ensures len(line) <= cap
 ensures st.status == -6 || st.status == -3 || st.status == len(line)
{
 let begin: i64 = st.at;
 // Hand: memchr for the newline in the buffered bytes, bounded by the room left under cap.
 let mut stop: i64 = st.end;
 if cap - len(line) < stop - begin { stop = begin + (cap - len(line)); }
 let i: i64 = find_byte(chunk, 10, begin, stop);
 if i < st.end && chunk[i] != 10 { st.status=-3; return; }
 if i > begin { arr_append(inout line, chunk, begin, i - begin); }
 if i < st.end { st.status=len(line); st.at=i+1; } else { st.at=i; }
}
// Hand `Rpc::step(false)`: only the buffered bytes are scanned, nothing is read or polled.
pub fn scan(inout st: Reader, inout line: [u8], chunk: [u8], cap: i64) -> () ! alloc
 requires 0 <= st.at && st.at <= st.end && st.end <= 65536 && len(chunk) == 65536
 requires 1 <= cap && cap <= 8388608 && len(line) <= cap
 ensures 0 <= st.at && st.at <= st.end && st.end == old(st).end && st.exit == old(st).exit && len(chunk) == 65536
 ensures len(line) <= cap
 ensures st.status == -6 || st.status == -3 || st.status == len(line)
{
 st.status=-6;
 if st.at < st.end { take(inout st, inout line, chunk, cap); }
}
// The need-more path of hand `Rpc::step` (`recv_timeout`): the overall and init timers, then one stdout chunk
// (scanned at once), then a 10 ms wait or the child's exit.
fn wake(take l: Loop, slot: i64, overall: i64, init: i64, ready: bool, inout st: Reader) -> Loop ! async, alloc
 ensures st.at == old(st).at && st.exit == old(st).exit && st.end == old(st).end
 ensures st.status == -6 ==> ev_ok(result) && 0 <= slot && slot < ev_cap(result) && ev_kind(result,slot) == 3
{
 let q: Loop = poll(move l,overall,init,ready,inout st,0);
 if st.status != -6 { return move q; }
 if !ev_ok(q) { st.status=-5; return move q; }
 if !live(q,slot) { st.status=-5; return move q; }
 return move q;
}
fn fill(take l: Loop, slot: i64, overall: i64, init: i64, ready: bool, cap: i64,
 inout st: Reader, inout line: [u8], inout chunk: [u8]) -> Loop ! async, proc, alloc
 requires 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
 requires 1 <= cap && cap <= 8388608 && len(line) <= cap && st.status == -6
 ensures 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
 ensures len(line) <= cap
{
 let mut q: Loop = move l;
 if st.at == st.end && ev_ok(q) {
 if live(q,slot) && !ev_eof(q,slot) {
 let mut got: i64 = 0;
 q=ev_proc_read_into(move q,slot,1,inout chunk,inout got);
 if ev_ok(q) { st.end=got; st.at=0; if got > 0 { take(inout st, inout line, chunk, cap); } }
 }
 }
 if st.status == -6 && ev_ok(q) {
 if live(q,slot) && ev_eof(q,slot) && st.at == st.end {
 q=ev_proc_wait_for(move q,slot,10);
 if ev_ok(q) {
 if slot >= 0 && slot < ev_cap(q) && ev_kind(q,slot) == 0 {
 st.exit=ev_exit(q); q=poll(move q,overall,init,ready,inout st,0);
 if st.status == -6 { st.status=-4; }
 }
 else { q=poll(move q,overall,init,ready,inout st,0); }
 }
 } else { q=poll(move q,overall,init,ready,inout st,10); }
 }
 if !ev_ok(q) { st.status=-5; }
 return move q;
}
// The common start of every receive step: the buffered bytes are scanned first (a complete line or -3 returns at once),
// then the timers and the child's liveness (hand `Rpc::step` before `recv_timeout`). st.status stays -6 when more bytes
// are needed.
fn begin(take l: Loop, slot: i64, overall: i64, init: i64, ready: bool, cap: i64,
 inout st: Reader, inout line: [u8], chunk: [u8]) -> Loop ! async, alloc
 requires 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
 requires 1 <= cap && cap <= 8388608 && len(line) <= cap
 ensures 0 <= st.at && st.at <= st.end && st.end == old(st).end && st.exit == old(st).exit
 ensures len(line) <= cap
 ensures st.status == -6 ==> ev_ok(result) && 0 <= slot && slot < ev_cap(result) && ev_kind(result,slot) == 3
{
 st.status=-6;
 if st.at < st.end { take(inout st, inout line, chunk, cap); if st.status != -6 { return move l; } }
 return wake(move l,slot,overall,init,ready,inout st);
}
// One receive step with a growing line buffer (hand `Rpc::step` with `line: Vec<u8>`): `line` holds the partial line and
// grows by extend; a complete line of len(line) bytes sets st.status = len(line), and the caller clears `line` after
// using it (hand `on_line` then `line.clear()`). The buffered bytes are scanned first; the loop is polled only when no
// line is complete. Stream 2 is read and dropped: for a grok child (`proc_spawn_env`, no quiet form, row 4.4za-EQ) so
// that its stderr never fills the pipe, and for a quiet codex child (`proc_spawn_quiet`, hand `Stdio::null()`) because
// `ev_eof` turns true only after both streams were observed at end of file (the read adds no bytes; row 4.4za-QE).
pub fn receive(take l: Loop, slot: i64, overall: i64, init: i64, ready: bool, cap: i64,
 inout st: Reader, inout line: [u8], inout chunk: [u8]) -> Loop ! async, proc, alloc
 requires 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
 requires 1 <= cap && cap <= 8388608 && len(line) <= cap
 ensures 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
 ensures len(line) <= cap
{
 let mut q: Loop = begin(move l,slot,overall,init,ready,cap,inout st,inout line,chunk);
 if st.status != -6 { return move q; }
 if !ev_eof(q,slot) { q=ev_proc_read(move q,slot,2,65536); }
 return fill(move q,slot,overall,init,ready,cap,inout st,inout line,inout chunk);
}
// `receive` that keeps the child's stderr in `tl` (MCP reports the last stderr line).
pub fn receive_tail(take l: Loop, slot: i64, overall: i64, init: i64, ready: bool, cap: i64,
 inout st: Reader, inout line: [u8], inout chunk: [u8], inout tl: crate::tail::Tail) -> Loop ! async, proc, alloc
 requires 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
 requires 1 <= cap && cap <= 8388608 && len(line) <= cap
 requires crate::tail::tail_ok(tl) && tl.limit == 1024
 ensures 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
 ensures len(line) <= cap
 ensures crate::tail::tail_ok(tl) && tl.limit == 1024
{
 let mut q: Loop = begin(move l,slot,overall,init,ready,cap,inout st,inout line,chunk);
 if st.status != -6 { return move q; }
 if !ev_eof(q,slot) {
 q=ev_proc_read(move q,slot,2,65536);
 if ev_ok(q) { let err: [u8] = ev_bytes(q); crate::tail::push(inout tl,1,err); }
 }
 return fill(move q,slot,overall,init,ready,cap,inout st,inout line,inout chunk);
}
