// folderKey (non-win32): strip every trailing '/', but keep an all-slash string unchanged.
// Comparison is exact UTF-8 byte equality, which is UTF-16 unit equality for valid text. A cwd holding a lone
// surrogate never equals the (valid) folder: its decoded U+FFFD must not stand in for the surrogate.
pub fn key_len(s: str) -> i64
  ensures 0 <= result && result <= len(s)
{
  let mut n: i64 = len(s);
  while n > 0 && s[n - 1] == 47
    invariant 0 <= n && n <= len(s)
    decreases n
  {
    n = n - 1;
  }
  if n == 0 { return len(s); }
  return n;
}

pub fn same(a: str, b: str) -> bool
{
  let na: i64 = key_len(a);
  let nb: i64 = key_len(b);
  if na != nb { return false; }
  let mut i: i64 = 0;
  while i < na
    invariant 0 <= i && i <= na && na == nb && na <= len(a) && nb <= len(b)
    decreases na - i
  {
    let x: i64 = a[i];
    let y: i64 = b[i];
    if x != y { return false; }
    i = i + 1;
  }
  return true;
}

// true when string value id holds a surrogate that is not part of a high-low pair, walked in place over its raw
// span (only a \u escape yields a surrogate unit; a literal four-byte scalar is a valid pair)
pub fn lone_at(d: crate::json::JsonDocument, id: i64) -> bool
{
  let s: crate::access::Span = crate::access::raw_span(d, id);
  if s.status != 0 || s.end - s.start < 2 { return false; }
  let stop: i64 = s.end - 1;
  let mut high: bool = false;
  let mut p: i64 = s.start + 1;
  while p < stop
    invariant s.start + 1 <= p && p <= stop && stop <= len(d.source) && stop <= 16777216
    decreases stop - p
  {
    let st: crate::jstr::Step = crate::jstr::step(d.source, p, stop);
    let u: i64 = st.value;
    if u >= 56320 && u <= 57343 {
      if !high { return true; }
      high = false;
    } else {
      if high { return true; }
      high = u >= 55296 && u <= 56319;
    }
    p = st.next;
  }
  return high;
}
