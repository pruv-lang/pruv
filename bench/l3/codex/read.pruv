// readCodex page handling, held turns and the final packet.
// Held-turn state (caller owned, see root.pruv):
//   hs [8]      0 held count (<= 200), 1 arena bytes used, 2 budget bytes (prompt + capped reply sizes, <= 2097152),
//               3 plan seen (0/1), 4 full (0/1)
//   ht [2000]   10 words per held turn, newest first: 0 prompt off, 1 prompt len, 2 reply off, 3 reply len (folded, <= 32768),
//               4 reply count, 5 reply clipped, 6 tools, 7 createdAt off (-1 none), 8 completedAt off (-1 none), 9 unused
//   hb byte arena (up to 8700000 bytes): 2097152 prompt bytes + 200 * 32768 folded replies + 200 * 48 stamps fit
// Held turns keep their reply already folded exactly as TurnCollector.answer folds it (item.pruv). The replay feeds
// begin; one answer with the folded text (plus one padding scalar when the fold was clipped, so that the
// collector sets clipped and saturates its budget without changing the kept bytes); tool x count. Folded replies of a
// clipped turn are at least 32765 bytes long, so the 4-byte padding scalar always overflows and is cut off again.

// One page of thread/turns/list: classify every object of result.data newest first, keep the last-plan, apply the
// budgets. Returns 0, or -4 when a bound that cannot happen was exceeded.
pub fn absorb(d: crate::json::JsonDocument, rid: i64, inout hs: [i64], inout ht: [i64], inout hb: crate::util::ByteBuffer, inout pl: [i64], inout pb: [u8], inout fs: [i64], inout fb: [u8]) -> i64 ! alloc
  requires len(hs) == 8 && len(ht) == 2000 && len(hb.data) <= 8700000 && len(pl) == 64 && len(pb) == 18024 && len(fs) == 3 && len(fb) == 32768
  requires 0 <= hs[0] && hs[0] <= 200 && 0 <= hs[1] && hs[1] <= len(hb.data) && 0 <= hs[2] && hs[2] <= 2097152
  requires -1 <= pl[0] && pl[0] <= 30 && 0 <= pl[1] && pl[1] <= 100000000 && 0 <= pl[62] && pl[62] <= 18000 && (pl[63] == 0 || pl[63] == 1)
  requires 0 <= fs[0] && fs[0] <= fs[1] && fs[1] <= 32768 && (fs[2] == 0 || fs[2] == 1)
  ensures len(hs) == 8 && len(ht) == 2000 && len(hb.data) <= 8700000 && len(pl) == 64 && len(pb) == 18024 && len(fs) == 3 && len(fb) == 32768
  ensures 0 <= hs[0] && hs[0] <= 200 && 0 <= hs[1] && hs[1] <= len(hb.data) && 0 <= hs[2] && hs[2] <= 2097152
  ensures -1 <= pl[0] && pl[0] <= 30 && 0 <= pl[1] && pl[1] <= 100000000 && 0 <= pl[62] && pl[62] <= 18000 && (pl[63] == 0 || pl[63] == 1)
  ensures 0 <= fs[0] && fs[0] <= fs[1] && fs[1] <= 32768 && (fs[2] == 0 || fs[2] == 1)
{
  let ids: [i64] = crate::util::elements(d, crate::util::field(d, rid, "data"));
  let n: i64 = len(ids);
  let mut k: i64 = 0;
  while k < n && hs[4] == 0
    invariant 0 <= k && k <= n && n == len(ids)
    invariant len(hs) == 8 && len(ht) == 2000 && len(hb.data) <= 8700000 && len(pl) == 64 && len(pb) == 18024 && len(fs) == 3 && len(fb) == 32768
    invariant 0 <= hs[0] && hs[0] <= 200 && 0 <= hs[1] && hs[1] <= len(hb.data) && 0 <= hs[2] && hs[2] <= 2097152
    invariant -1 <= pl[0] && pl[0] <= 30 && 0 <= pl[1] && pl[1] <= 100000000 && 0 <= pl[62] && pl[62] <= 18000 && (pl[63] == 0 || pl[63] == 1)
    invariant 0 <= fs[0] && fs[0] <= fs[1] && fs[1] <= 32768 && (fs[2] == 0 || fs[2] == 1)
    decreases n - k
  {
    let t: i64 = ids[k];
    k = k + 1;
    if crate::access::kind(d, t) == 6 {
      let raw: crate::item::RawTurn = crate::item::read_turn(d, t, inout fs, inout fb);
      // the first plan met (newest first) is the last plan; later turns never replace it, even when it yields none
      if hs[3] == 0 && raw.has_plan {
        hs[3] = 1;
        let mut at: [u8] = alloc(0, 0);
        if len(raw.completed) == 24 { at = copy(raw.completed); }
        else if len(raw.created) == 24 { at = copy(raw.created); }
        if len(raw.plan) <= 100000000 && (len(at) == 0 || len(at) == 24) {
          crate::plan::codex_plan(raw.plan, at, inout pl, inout pb);
        }
      }
      let plen: i64 = len(raw.prompt);
      let rlen: i64 = len(raw.reply);
      if raw.rbytes < 0 { return -4; }
      if plen > 0 || raw.nreply > 0 {
        let mut rb: i64 = raw.rbytes;
        if rb > 32768 { rb = 32768; }
        let size: i64 = plen + rb;
        if hs[0] >= 200 || hs[2] + size > 2097152 {
          hs[4] = 1;
        } else {
          let needed: i64 = hs[1] + plen + rlen + 48;
          if needed > 8700000 { return -4; }
          if rlen > 32768 || raw.tools < 0 || raw.nreply < 0 || raw.rclipped < 0 || raw.rclipped > 1 { return -4; }
          if needed > len(hb.data) { crate::util::grow_bytes(inout hb.data, needed, 8700000); }
          let h: i64 = hs[0];
          let b: i64 = 10 * h;
          let mut u: i64 = hs[1];
          ht[b] = u;
          ht[b + 1] = plen;
          crate::bytes::copy_span(inout hb.data, u, raw.prompt, 0, plen);
          u = u + plen;
          ht[b + 2] = u;
          ht[b + 3] = rlen;
          crate::bytes::copy_span(inout hb.data, u, raw.reply, 0, rlen);
          u = u + rlen;
          ht[b + 4] = raw.nreply;
          ht[b + 5] = raw.rclipped;
          ht[b + 6] = raw.tools;
          ht[b + 7] = -1;
          if len(raw.created) == 24 {
            ht[b + 7] = u;
            crate::bytes::copy_span(inout hb.data, u, raw.created, 0, 24);
            u = u + 24;
          }
          ht[b + 8] = -1;
          if len(raw.completed) == 24 {
            ht[b + 8] = u;
            crate::bytes::copy_span(inout hb.data, u, raw.completed, 0, 24);
            u = u + 24;
          }
          ht[b + 9] = 0;
          hs[0] = h + 1;
          hs[1] = u;
          hs[2] = hs[2] + size;
        }
      }
    }
  }
  return 0;
}

// 24-byte stamp of the arena at o as a str ("" when absent or malformed)
fn stamp_str(hb: [u8], o: i64) -> str ! alloc
  ensures len(result) == 0 || len(result) == 24
{
  let none: str = "";
  if o < 0 || o > len(hb) - 24 { return copy(none); }
  let mut cb: [u8] = alloc(24, 0);
  crate::bytes::copy_span(inout cb, 0, hb, o, o + 24);
  let s: str = crate::jstr::adapter_probe(cb);
  if len(s) != 24 { return copy(none); }
  return copy(s);
}

// One held turn into the collector: begin, the folded reply when present, then its tool items.
fn feed(inout st: [i64], inout sl: [i64], inout rf: [i64], hb: [u8], po: i64, pn: i64, co: i64, ans: bool, ro: i64, rn: i64, pad: i64, dc: i64, tools: i64) -> bool
  requires len(st) == 4 && len(sl) == 1600 && len(rf) == 800 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1) && 0 <= st[0] && st[0] < 200
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  requires 0 <= po && 0 <= pn && pn <= len(hb) - po && pn <= 100000000 && 0 <= ro && 0 <= rn && rn <= len(hb) - ro && rn <= 99999996 && (pad == 0 || pad == 4)
  requires (co == -1 || (0 <= co && co <= len(hb) - 24)) && (dc == -1 || (0 <= dc && dc <= len(hb) - 24)) && 0 <= tools && tools <= 100000000
  ensures len(st) == 4 && len(sl) == 1600 && len(rf) == 800 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1) && st[0] == old(st)[0] + 1
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
{
  crate::turns::begin_ref(inout st, inout sl, inout rf, hb, po, pn, co);
  if ans {
    if !crate::turns::answer_ref(inout st, inout sl, inout rf, hb, ro, rn, pad, dc) { return false; }
  }
  add_tools(inout st, inout sl, tools);
  return true;
}

// The bytes are valid UTF-8 (the check decoding did).
fn span_ok(b: [u8]) -> bool
{
  return utf8_valid(b);
}

fn add_tools(inout st: [i64], inout sl: [i64], n: i64) -> ()
  requires len(st) == 4 && len(sl) == 1600 && 0 <= st[3] && st[3] < 200 && 0 <= n
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  ensures len(st) == 4 && len(sl) == 1600 && st[0] == old(st)[0] && st[1] == old(st)[1] && st[2] == old(st)[2] && st[3] == old(st)[3]
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
{
  let mut k: i64 = 0;
  while k < n
    invariant 0 <= k && k <= n && len(st) == 4 && len(sl) == 1600
    invariant st[0] == old(st)[0] && st[1] == old(st)[1] && st[2] == old(st)[2] && st[3] == old(st)[3]
    invariant forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
    invariant forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
    decreases n - k
  {
    crate::turns::tool(inout st, inout sl);
    k = k + 1;
  }
}

// Collect held turns oldest first as offsets into hb, then turn hb itself into the wire (header of
// 20 + 10 * kept + 2 * items words, then base bytes, then turn texts, newest first) by moving the kept
// drafts left in place. Set bad[0] for a malformed record or layout mismatch.
pub fn replay(ht: [i64], take held: [u8], used: i64, count: i64, base: i64, items: i64, inout wire: [u8], inout bad: [i64]) -> crate::turns::Placed ! alloc
  requires len(ht) == 2000 && len(held) <= 8700000 && 0 <= count && count <= 200 && 0 <= base && base <= 3500000 && len(bad) == 1
  requires 0 <= items && items <= 30
  ensures len(bad) == 1
{
  let mut hb: [u8] = move held;
  // In place (DB46, G-DB44-1): absorb packs the held turns from offset 0, so hb grows in the same doubling steps as
  // the turn bytes alone (DB44's 36,864-byte front reserve pushed M over one more doubling). Here, once, the used
  // bytes move right by the largest header + base this read can need (all held turns kept), which is at or after
  // the real wire start; finish_inplace then moves the kept drafts left to it. Every ht offset is read + sh.
  let front: i64 = 8 * (20 + 10 * count + 2 * items) + base;
  let mut sh: i64 = 0;
  // lim: end of the bytes absorb wrote (after the shift); a span past it is rejected like a span past len(hb)
  let mut lim: i64 = len(hb);
  if used < 0 || used > len(hb) {
    bad[0] = 1;
  } else {
    if count > 0 && ht[0] >= 0 && ht[0] < front {
      sh = front;
      let need: i64 = used + sh;
      if need > len(hb) { hb = resize(hb, need, 0); }
      copy_within(inout hb, sh, 0, used);
    }
    lim = used + sh;
  }
  let mut st: [i64] = crate::turns::new_state();
  let mut sl: [i64] = crate::turns::new_slots();
  let mut rf: [i64] = crate::turns::new_refs();
  let mut fed: i64 = 0;
  let mut j: i64 = count;
  while j > 0
    invariant 0 <= j && j <= count && count <= 200 && len(ht) == 2000 && len(hb) <= 12300000 && len(bad) == 1 && 0 <= sh && sh <= 3520000 && 0 <= lim && lim <= len(hb)
    invariant 0 <= fed && fed <= count && fed + j <= count
    invariant len(st) == 4 && len(sl) == 1600 && len(rf) == 800 && st[0] == fed && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1)
    invariant forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
    invariant forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
    decreases j
  {
    j = j - 1;
    let b: i64 = 10 * j;
    let pn: i64 = ht[b + 1];
    let rn: i64 = ht[b + 3];
    let nrep: i64 = ht[b + 4];
    let rcl: i64 = ht[b + 5];
    let tools: i64 = ht[b + 6];
    let mut po: i64 = -1;
    let mut ro: i64 = -1;
    let mut co: i64 = -2;
    let mut dof: i64 = -2;
    if ht[b] >= 0 && ht[b] <= 8700000 { po = ht[b] + sh; }
    if ht[b + 2] >= 0 && ht[b + 2] <= 8700000 { ro = ht[b + 2] + sh; }
    if ht[b + 7] == -1 { co = -1; } else if ht[b + 7] >= 0 && ht[b + 7] <= 8700000 { co = ht[b + 7] + sh; }
    if ht[b + 8] == -1 { dof = -1; } else if ht[b + 8] >= 0 && ht[b + 8] <= 8700000 { dof = ht[b + 8] + sh; }
    if po < 0 || pn < 0 || pn > 2097152 || po > lim - pn || ro < 0 || rn < 0 || rn > 32768 || ro > lim - rn || nrep < 0 || tools < 0 || tools > 100000000 || (rcl != 0 && rcl != 1) || co < -1 || (co >= 0 && co > lim - 24) || dof < -1 || (dof >= 0 && dof > lim - 24) {
      bad[0] = 1;
    } else {
      // the spans of hb are passed as they are (no copy, D-DB28-1); a span that is not valid UTF-8 counts as empty,
      // as decoding it did before
      let mut pl: i64 = 0;
      if span_ok(subview(hb, po, po + pn)) { pl = pn; }
      let mut rl: i64 = 0;
      let mut pd: i64 = 0;
      if nrep > 0 {
        if span_ok(subview(hb, ro, ro + rn)) {
          rl = rn;
          if rcl == 1 { pd = 4; }
        }
      }
      let mut created: i64 = -1;
      if len(stamp_str(hb, co)) == 24 { created = co; }
      let mut completed: i64 = -1;
      if len(stamp_str(hb, dof)) == 24 { completed = dof; }
      if !feed(inout st, inout sl, inout rf, hb, po, pl, created, nrep > 0, ro, rl, pd, completed, tools) {
        bad[0] = 1;
      }
      fed = fed + 1;
    }
  }
  let layout: crate::turns::Layout = crate::turns::text_layout(st, sl);
  let at: i64 = 8 * (20 + 10 * layout.kept + 2 * items) + base;
  // In place (DB44, G-DB40-2): absorb packs the held turns newest first, each as prompt, reply, created, completed,
  // and the shift above put the newest at sh >= at (kept <= count). finish_inplace moves the kept drafts left to at,
  // so hb becomes the wire and no second buffer is allocated. The move needs the newest held turn to start at or
  // after at; if it does not, mv = -1 makes finish_inplace fail without moving.
  let mut mv: i64 = at;
  if count > 0 && ht[0] + sh < at { mv = -1; }
  let col: crate::turns::Placed = crate::turns::finish_inplace(st, sl, rf, inout hb, base, mv);
  if !col.ok || col.kept != layout.kept || col.text_len != layout.text_len {
    bad[0] = 1;
    return col;
  }
  wire = truncate(hb, mv + col.text_len);
  return col;
}

fn put_str(inout dst: [u8], at: i64, s: str) -> ()
  requires 0 <= at && at <= len(dst) && len(s) <= len(dst) - at
  ensures len(dst) == len(old(dst))
{
  let n: i64 = len(s);
  let mut j: i64 = 0;
  while j < n
    invariant 0 <= j && j <= n && n == len(s) && 0 <= at && at <= len(dst) && n <= len(dst) - at && len(dst) == len(old(dst))
    decreases n - j
  {
    let b: i64 = s[j];
    dst[at + j] = b;
    j = j + 1;
  }
}

// The result packet of a finished read. Text layout: title, model, lastPlan at (24), plan item blob, then the turn texts.
pub fn finish(hs: [i64], ht: [i64], take hb: [u8], pl: [i64], pb: [u8], title: str, model: str, more: bool) -> [u8] ! alloc
  requires len(hs) == 8 && len(ht) == 2000 && len(hb) <= 8700000 && len(pl) == 64 && len(pb) == 18024
  requires 0 <= hs[0] && hs[0] <= 200
  requires -1 <= pl[0] && pl[0] <= 30 && 0 <= pl[1] && pl[1] <= 100000000 && 0 <= pl[62] && pl[62] <= 18000 && (pl[63] == 0 || pl[63] == 1)
  ensures len(result) >= 24
{
  let empty: [u8] = alloc(0, 0);
  let tl: i64 = len(title);
  let ml: i64 = len(model);
  if tl > 1000 || ml > 1000 { return crate::packet::wire_fail(2, 6, empty); }
  let items: i64 = pl[0];
  let mut pitems: i64 = 0;
  let mut alen: i64 = 0;
  let mut blob: i64 = 0;
  let mut pmore: i64 = 0;
  if items > 0 {
    pitems = items;
    blob = pl[62];
    pmore = pl[1];
    if pl[63] == 1 { alen = 24; }
  }
  let base: i64 = tl + ml + alen + blob;
  let mut bad: [i64] = alloc(1, 0);
  let mut wire: [u8] = alloc(0, 0);
  let col: crate::turns::Placed = replay(ht, move hb, hs[1], hs[0], base, pitems, inout wire, inout bad);
  let nt: i64 = len(col.turns);
  let nx: i64 = col.text_len;
  if bad[0] != 0 || nt < 0 || nt > 2000 || nx < 0 || nx > 2106752 || col.kept < 0 || col.kept > 200 || nt != 10 * col.kept {
    return crate::packet::wire_fail(2, 6, empty);
  }
  let total: i64 = base + nx;
  let mut m: [i64] = crate::packet::meta_new(1);
  if more || col.trimmed == 1 { m[2] = 1; }
  m[3] = col.kept;
  if tl > 0 { m[4] = 0; m[5] = tl; }
  if ml > 0 { m[6] = tl; m[7] = ml; }
  if alen == 24 { m[8] = tl + ml; m[9] = 24; }
  if pitems > 0 { m[11] = pitems; m[12] = pmore; }
  let rl: i64 = nt + 2 * pitems;
  let mut rows: [i64] = alloc(rl, 0);
  let mut i: i64 = 0;
  while i < nt
    invariant 0 <= i && i <= nt && nt == len(col.turns) && len(rows) == rl && rl == nt + 2 * pitems && 0 <= pitems
    decreases nt - i
  {
    rows[i] = col.turns[i];
    i = i + 1;
  }
  let mut q: i64 = 0;
  while q < pitems
    invariant 0 <= q && q <= pitems && pitems <= 30 && 0 <= tl && tl <= 1000 && 0 <= ml && ml <= 1000 && 0 <= alen && alen <= 24 && len(rows) == rl && rl == nt + 2 * pitems && 0 <= nt && len(pl) == 64
    decreases pitems - q
  {
    let o: i64 = pl[2 + 2 * q];
    if o < 0 || o > 18000 { return crate::packet::wire_fail(2, 6, empty); }
    rows[nt + 2 * q] = tl + ml + alen + o;
    rows[nt + 2 * q + 1] = pl[3 + 2 * q];
    q = q + 1;
  }
  let header: i64 = 8 * (20 + rl);
  if len(wire) != header + total { return crate::packet::wire_fail(2, 6, empty); }
  if !crate::packet::read_header(m, rows, total, inout wire) { return crate::packet::wire_fail(2, 6, empty); }
  put_str(inout wire, header, title);
  put_str(inout wire, header + tl, model);
  if alen == 24 { crate::bytes::copy_span(inout wire, header + tl + ml, pb, 18000, 18024); }
  if blob > 0 { crate::bytes::copy_span(inout wire, header + tl + ml + alen, pb, 0, blob); }
  return wire;
}
