// Codex conversation import (listCodex / readCodex). See docs/CODEX_IMPORT_SPEC.md.
// Pruv owns the whole conversation with `codex app-server --stdio`: spawn, framing, request ids, response matching,
// error mapping, paging, list filtering, turn classification, budgets, collector, last plan and the result packet.
mod json;
mod access;
mod jstr;
mod lines;
mod bytes;
mod text;
mod time;
mod names;
mod turns;
mod args;
mod transport;
mod util;
mod folder;
mod plan;
mod item;
mod rpc;
mod list;
mod read;
mod packet;

// A failed request: the child is closed and the failure returned at once (hand `?` through `run`).
fn quit(take l: Loop, slot: i64, code: i64, stage: i64, detail: [u8]) -> [i64] ! async, net, proc, alloc
  requires len(detail) <= 100000000
  ensures len(result) >= 3
{
  crate::transport::close(move l, slot);
  return crate::packet::fail(code, stage, detail);
}

fn quit_wire(take l: Loop, slot: i64, code: i64, stage: i64, detail: [u8]) -> [u8] ! async, net, proc, alloc
  requires len(detail) <= 100000000
  ensures len(result) >= 24
{
  crate::transport::close(move l, slot);
  return crate::packet::wire_fail(code, stage, detail);
}

fn quit0(take l: Loop, slot: i64, code: i64, stage: i64) -> [i64] ! async, net, proc, alloc
  ensures len(result) >= 3
{
  let none: [u8] = alloc(0, 0);
  return quit(move l, slot, code, stage, none);
}

fn quit0w(take l: Loop, slot: i64, code: i64, stage: i64) -> [u8] ! async, net, proc, alloc
  ensures len(result) >= 24
{
  let none: [u8] = alloc(0, 0);
  return quit_wire(move l, slot, code, stage, none);
}

pub fn codex_list(binary: str, argv: str, cwd: str, folder: str, timeout_ms: i64) -> [i64] ! async, net, proc, alloc
  ensures len(result) >= 3
{
  if len(folder) > 1000000 { let none: [u8] = alloc(0, 0); return crate::packet::fail(1, 0, none); }
  let mut ctl: crate::rpc::Ctl = crate::rpc::ctl_new();
  let mut l: Loop = crate::rpc::start(binary, argv, cwd, timeout_ms, inout ctl);
  let slot: i64 = ctl.slot;
  let overall: i64 = ctl.overall;
  if ctl.fail != 0 { return quit0(move l, slot, ctl.fail, ctl.stage); }
  let mut st: crate::transport::Reader = crate::transport::reader_new();
  let mut line: [u8] = alloc(0, 0);
  arr_reserve(inout line, 4096);
  let mut chunk: [u8] = alloc(65536, 0);
  l = crate::rpc::open(move l, inout ctl, inout st, inout line, inout chunk, timeout_ms);
  if ctl.fail == 0 {
    ctl.stage = 3;
    l = crate::rpc::closed(move l, slot, overall, inout ctl, inout st);
  }
  if ctl.fail != 0 { return quit0(move l, slot, ctl.fail, ctl.stage); }
  l = crate::transport::send(move l, slot, crate::rpc::req_list(2, folder), timeout_ms);
  let mut events: i64 = 0;
  while events < 1000000
    invariant 0 <= events && events <= 1000000
    invariant 0 <= ctl.n
    invariant 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
    invariant len(line) <= 8388608
    decreases 1000000 - events
  {
    events = events + 1;
    l = crate::rpc::step(move l, slot, overall, inout ctl, inout st, inout line, inout chunk);
    if ctl.fail != 0 { return quit0(move l, slot, ctl.fail, 3); }
    if ctl.got {
      let parsed: crate::json::JsonParse = crate::rpc::parse_line(line, ctl.n);
      match parsed {
        crate::json::JsonParse::Failed(e) => { }
        crate::json::JsonParse::Parsed(d) => {
          match crate::rpc::kind_of(d, 2) {
            crate::rpc::Kind::Server => { l = crate::transport::send(move l, slot, crate::rpc::not_handled(d), timeout_ms); }
            crate::rpc::Kind::Response => {
              let error: i64 = crate::util::field(d, 0, "error");
              // any error response to thread/list is codex-unsupported
              if crate::access::kind(d, error) == 6 { return quit(move l, slot, 4, 3, crate::rpc::error_detail(d, error)); }
              let p: [i64] = crate::list::build(d, crate::util::field(d, 0, "result"));
              crate::transport::close(move l, slot);
              return p;
            }
            crate::rpc::Kind::Ignore => { }
          }
        }
      }
      line = truncate(line, 0); // after the document's last use (it borrows `line`)
    }
  }
  return quit0(move l, slot, 6, 3);
}

pub fn codex_read(binary: str, argv: str, cwd: str, folder: str, thread: str, timeout_ms: i64) -> [i64] ! async, net, proc, alloc
  ensures len(result) >= 3
{
  let wire: [u8] = codex_read_wire(binary, argv, cwd, folder, thread, timeout_ms);
  return crate::packet::wire_packet(wire);
}

pub fn codex_read_wire(binary: str, argv: str, cwd: str, folder: str, thread: str, timeout_ms: i64) -> [u8] ! async, net, proc, alloc
  ensures len(result) >= 24
{
  // an invalid thread never spawns
  if len(thread) > 1000000 { let none: [u8] = alloc(0, 0); return crate::packet::wire_fail(3, 0, none); }
  if !crate::names::valid_thread(thread) { let none: [u8] = alloc(0, 0); return crate::packet::wire_fail(3, 0, none); }
  if len(folder) > 1000000 { let none: [u8] = alloc(0, 0); return crate::packet::wire_fail(1, 0, none); }
  let mut ctl: crate::rpc::Ctl = crate::rpc::ctl_new();
  let mut l: Loop = crate::rpc::start(binary, argv, cwd, timeout_ms, inout ctl);
  let slot: i64 = ctl.slot;
  let overall: i64 = ctl.overall;
  if ctl.fail != 0 { return quit0w(move l, slot, ctl.fail, ctl.stage); }
  let mut st: crate::transport::Reader = crate::transport::reader_new();
  let mut line: [u8] = alloc(0, 0);
  arr_reserve(inout line, 4096);
  let mut chunk: [u8] = alloc(65536, 0);
  l = crate::rpc::open(move l, inout ctl, inout st, inout line, inout chunk, timeout_ms);
  // thread/read: any error response is not-found; the conversation's cwd must be the chosen folder
  if ctl.fail == 0 {
    ctl.stage = 4;
    l = crate::rpc::closed(move l, slot, overall, inout ctl, inout st);
  }
  if ctl.fail != 0 { return quit0w(move l, slot, ctl.fail, ctl.stage); }
  l = crate::transport::send(move l, slot, crate::rpc::req_read(2, thread), timeout_ms);
  let mut title: str = "";
  let mut model: str = "";
  let mut done: bool = false;
  let mut events: i64 = 0;
  while !done && events < 1000000
    invariant 0 <= events && events <= 1000000
    invariant 0 <= ctl.n
    invariant 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
    invariant len(line) <= 8388608
    decreases 1000000 - events
  {
    events = events + 1;
    l = crate::rpc::step(move l, slot, overall, inout ctl, inout st, inout line, inout chunk);
    if ctl.fail != 0 { return quit0w(move l, slot, ctl.fail, 4); }
    if ctl.got {
      let parsed: crate::json::JsonParse = crate::rpc::parse_line(line, ctl.n);
      match parsed {
        crate::json::JsonParse::Failed(e) => { }
        crate::json::JsonParse::Parsed(d) => {
          match crate::rpc::kind_of(d, 2) {
            crate::rpc::Kind::Server => { l = crate::transport::send(move l, slot, crate::rpc::not_handled(d), timeout_ms); }
            crate::rpc::Kind::Response => {
              let error: i64 = crate::util::field(d, 0, "error");
              if crate::access::kind(d, error) == 6 { return quit_wire(move l, slot, 3, 4, crate::rpc::error_detail(d, error)); }
              let tid: i64 = crate::util::field(d, crate::util::field(d, 0, "result"), "thread");
              let cw: i64 = crate::util::field(d, tid, "cwd");
              // a cwd that is not a string, or one with a lone surrogate, is never the folder; decoded once
              if crate::access::kind(d, cw) != 4 || crate::folder::lone_at(d, cw) || !crate::folder::same(crate::util::str_at(d, cw), folder) {
                return quit0w(move l, slot, 3, 4);
              }
              let nm: i64 = crate::util::field(d, tid, "name");
              if crate::access::kind(d, nm) == 4 {
                let nv: str = crate::util::str_at(d, nm);
                let tn: ref str = crate::text::trim(nv);
                if len(tn) > 0 { title = crate::text::one_line(tn, 120); }
              }
              let mf: i64 = crate::util::field(d, tid, "model");
              let mut mid: i64 = -1;
              if crate::access::kind(d, mf) == 4 { mid = mf; }
              else {
                let idf: i64 = crate::util::field(d, mf, "id");
                if crate::access::kind(d, idf) == 4 { mid = idf; }
              }
              if mid >= 0 {
                let ms: str = crate::util::str_at(d, mid);
                if crate::util::units16(ms) <= 200 {
                  // the decoded value is kept as is when trimming leaves it whole; only a trimmed value is copied
                  let t: crate::text::Span = crate::text::trim_span(ms);
                  if t.lo == 0 && t.hi == len(ms) { model = move ms; }
                  else { let mt: ref str = subview(ms, t.lo, t.hi); model = copy(mt); }
                }
              }
              done = true;
            }
            crate::rpc::Kind::Ignore => { }
          }
        }
      }
      line = truncate(line, 0); // after the document's last use (it borrows `line`)
    }
  }
  if !done { return quit0w(move l, slot, 6, 4); }
  // the read stores, allocated once the thread is known to be in the folder
  let mut hs: [i64] = alloc(8, 0);
  let mut ht: [i64] = alloc(2000, 0);
  // held turns start at 0; read::replay shifts them right once past the wire header + base, then moves them left in place
  let mut hb: [u8] = alloc(0, 0);
  arr_reserve(inout hb, 65536);
  let mut pl: [i64] = alloc(64, 0);
  pl[0] = -1;
  let mut pb: [u8] = alloc(18024, 0);
  // thread/turns/list: newest first, at most 40 pages, request ids 3..42
  let mut cursor: [u8] = alloc(0, 0);
  let mut more: bool = false;
  let mut fin: bool = false;
  let mut page: i64 = 0;
  while !fin && page < 40
    invariant 0 <= page && page <= 40
    invariant len(cursor) <= 16777216
    invariant 0 <= ctl.n
    invariant 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
    invariant len(line) <= 8388608
    invariant len(hs) == 8 && len(ht) == 2000 && len(hb) <= 8700000 && len(pl) == 64 && len(pb) == 18024
    invariant 0 <= hs[0] && hs[0] <= 200 && hs[1] == len(hb) && 0 <= hs[2] && hs[2] <= 2097152
    invariant -1 <= pl[0] && pl[0] <= 30 && 0 <= pl[1] && pl[1] <= 100000000 && 0 <= pl[62] && pl[62] <= 18000 && (pl[63] == 0 || pl[63] == 1)
    decreases 40 - page
  {
    ctl.stage = 5;
    l = crate::rpc::closed(move l, slot, overall, inout ctl, inout st);
    if ctl.fail != 0 { return quit0w(move l, slot, ctl.fail, 5); }
    let id: i64 = page + 3;
    l = crate::transport::send(move l, slot, crate::rpc::req_turns(id, thread, cursor), timeout_ms);
    let mut got: bool = false;
    let mut waits: i64 = 0;
    while !got && waits < 1000000
      invariant 0 <= waits && waits <= 1000000
      invariant 0 <= ctl.n
      invariant 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
      invariant len(line) <= 8388608
      invariant 0 <= page && page < 40 && id == page + 3
      invariant len(cursor) <= 16777216
      invariant len(hs) == 8 && len(ht) == 2000 && len(hb) <= 8700000 && len(pl) == 64 && len(pb) == 18024
      invariant 0 <= hs[0] && hs[0] <= 200 && hs[1] == len(hb) && 0 <= hs[2] && hs[2] <= 2097152
      invariant -1 <= pl[0] && pl[0] <= 30 && 0 <= pl[1] && pl[1] <= 100000000 && 0 <= pl[62] && pl[62] <= 18000 && (pl[63] == 0 || pl[63] == 1)
      decreases 1000000 - waits
    {
      waits = waits + 1;
      l = crate::rpc::step(move l, slot, overall, inout ctl, inout st, inout line, inout chunk);
      if ctl.fail != 0 { return quit0w(move l, slot, ctl.fail, 5); }
      if ctl.got {
        let parsed: crate::json::JsonParse = crate::rpc::parse_line(line, ctl.n);
        match parsed {
          crate::json::JsonParse::Failed(e) => { }
          crate::json::JsonParse::Parsed(d) => {
            match crate::rpc::kind_of(d, id) {
              crate::rpc::Kind::Server => { l = crate::transport::send(move l, slot, crate::rpc::not_handled(d), timeout_ms); }
              crate::rpc::Kind::Response => {
                let error: i64 = crate::util::field(d, 0, "error");
                if crate::access::kind(d, error) == 6 {
                  // -32601 codex-unsupported; not found / no rollout / unknown thread not-found; else read-failed
                  let mut code: i64 = 6;
                  match crate::rpc::error_class(d, error) {
                    1 => { code = 4; }
                    2 => { code = 3; }
                    _ => { }
                  }
                  return quit_wire(move l, slot, code, 5, crate::rpc::error_detail(d, error));
                }
                let res: i64 = crate::util::field(d, 0, "result");
                match crate::read::absorb(d, res, inout hs, inout ht, inout hb, inout pl, inout pb) {
                  crate::read::Absorbed::Broken => { return quit0w(move l, slot, 2, 5); }
                  crate::read::Absorbed::Full => { more = true; fin = true; }
                  crate::read::Absorbed::Open => {
                    // a non-empty string cursor and a non-empty page go on; the cursor is resent as its raw token
                    let nxt: i64 = crate::util::field(d, res, "nextCursor");
                    let cs: crate::access::Span = crate::access::raw_span(d, nxt);
                    if crate::access::kind(d, nxt) == 4 && cs.status == 0 && cs.end - cs.start > 2 && crate::access::array_length(d, crate::util::field(d, res, "data")) > 0 {
                      cursor = crate::util::raw(d, nxt);
                      more = page + 1 == 40;
                    } else { fin = true; }
                  }
                }
                got = true;
              }
              crate::rpc::Kind::Ignore => { }
            }
          }
        }
        line = truncate(line, 0); // after the document's last use (it borrows `line`)
      }
    }
    if !got { return quit0w(move l, slot, 6, 5); }
    page = page + 1;
  }
  let wire: [u8] = crate::read::finish(hs, ht, move hb, pl, pb, title, model, more);
  crate::transport::close(move l, slot);
  return wire;
}
