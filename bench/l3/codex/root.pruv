// Codex conversation import (listCodex / readCodex). See docs/CODEX_IMPORT_SPEC.md.
// Pruv owns the whole conversation with `codex app-server --stdio`: spawn, framing, request ids, response matching,
// error mapping, paging, list filtering, turn classification, budgets, collector, last plan and the result packet.
mod json;
mod access;
mod jstr;
mod lines;
mod tail;
mod bytes;
mod text;
mod time;
mod names;
mod turns;
mod args;
mod transport;
mod util;
mod folder;
mod plan;
mod item;
mod rpc;
mod list;
mod read;
mod packet;

pub fn codex_list(binary: str, argv: str, cwd: str, folder: str, timeout_ms: i64) -> [i64] ! async, net, proc, alloc
  ensures len(result) >= 3
{
  let empty: [u8] = alloc(0, 0);
  if len(folder) > 1000000 { return crate::packet::fail(1, 0, empty); }
  let mut ctl: [i64] = alloc(8, 0);
  let mut l: Loop = crate::rpc::start(binary, argv, cwd, timeout_ms, inout ctl);
  let slot: i64 = ctl[2];
  let overall: i64 = ctl[3];
  let mut st: [i64] = alloc(5, 0);
  let mut line: crate::util::ByteBuffer = crate::util::byte_buffer(4096);
  let mut chunk: [u8] = alloc(65536, 0);
  let mut tl: crate::tail::Tail = crate::tail::new(1024);
  let mut detail: [u8] = alloc(0, 0);
  let mut p: [i64] = crate::packet::fail(2, 6, empty);
  if ctl[0] == 0 {
    l = crate::rpc::open(move l, inout ctl, inout st, inout line, inout chunk, inout tl, timeout_ms);
  }
  if ctl[0] == 0 {
    ctl[1] = 3;
    ctl[4] = 2;
    if crate::transport::stdin_closed(l, slot) {
      l = crate::transport::expired(move l, overall, inout st);
      if st[0] == -1 { ctl[0] = 5; } else { ctl[0] = 6; }
    }
    l = crate::transport::send(move l, slot, crate::rpc::req_list(2, folder), timeout_ms);
    let mut done: bool = false;
    let mut events: i64 = 0;
    while ctl[0] == 0 && !done && events < 1000000
      invariant 0 <= events && events <= 1000000 && len(p) >= 3
      invariant len(ctl) == 8 && 0 <= ctl[6] && ctl[6] <= len(line.data)
      invariant len(st) == 5 && 0 <= st[1] && st[1] <= len(line.data) && 0 <= st[2] && st[2] <= st[4] && 0 <= st[4] && st[4] <= 65536 && len(chunk) == 65536
      invariant len(line.data) <= 8388608
      invariant crate::tail::tail_ok(tl) && tl.limit == 1024
      decreases 1000000 - events
    {
      events = events + 1;
      l = crate::rpc::step(move l, slot, overall, inout ctl, inout st, inout line, inout chunk, inout tl);
      if ctl[0] == 0 && ctl[5] == 1 {
        let parsed: crate::json::JsonParse = crate::rpc::parse_line(inout line, ctl[6], st);
        ctl[6] = 0;
        match parsed {
          crate::json::JsonParse::Failed(e) => { }
          crate::json::JsonParse::Parsed(d) => {
            let k: i64 = crate::rpc::kind_of(d, 2);
            if k == 1 { l = crate::transport::send(move l, slot, crate::rpc::not_handled(d), timeout_ms); }
            if k == 2 {
              done = true;
              let error: i64 = crate::util::field(d, 0, "error");
              if crate::access::kind(d, error) == 6 {
                // any error response to thread/list is codex-unsupported
                ctl[0] = 4;
                detail = crate::rpc::error_detail(d, error);
              } else {
                ctl[1] = 6;
                p = crate::list::build(d, crate::util::field(d, 0, "result"));
              }
            }
          }
        }
      }
    }
    if ctl[0] == 0 && !done { ctl[0] = 6; }
  }
  let code: i64 = ctl[0];
  let stage: i64 = ctl[1];
  crate::transport::close(move l, slot);
  if code != 0 && len(detail) <= 100000000 { return crate::packet::fail(code, stage, detail); }
  if code != 0 { return crate::packet::fail(code, stage, empty); }
  return p;
}

pub fn codex_read(binary: str, argv: str, cwd: str, folder: str, thread: str, timeout_ms: i64) -> [i64] ! async, net, proc, alloc
  ensures len(result) >= 3
{
  let wire: [u8] = codex_read_wire(binary, argv, cwd, folder, thread, timeout_ms);
  return crate::packet::wire_packet(wire);
}

pub fn codex_read_wire(binary: str, argv: str, cwd: str, folder: str, thread: str, timeout_ms: i64) -> [u8] ! async, net, proc, alloc
  ensures len(result) >= 24
{
  let empty: [u8] = alloc(0, 0);
  // an invalid thread never spawns
  if len(thread) > 1000000 { return crate::packet::wire_fail(3, 0, empty); }
  if !crate::names::valid_thread(thread) { return crate::packet::wire_fail(3, 0, empty); }
  if len(folder) > 1000000 { return crate::packet::wire_fail(1, 0, empty); }
  let mut ctl: [i64] = alloc(8, 0);
  let mut l: Loop = crate::rpc::start(binary, argv, cwd, timeout_ms, inout ctl);
  let slot: i64 = ctl[2];
  let overall: i64 = ctl[3];
  let mut st: [i64] = alloc(5, 0);
  let mut line: crate::util::ByteBuffer = crate::util::byte_buffer(4096);
  let mut chunk: [u8] = alloc(65536, 0);
  let mut tl: crate::tail::Tail = crate::tail::new(1024);
  let mut hs: [i64] = alloc(8, 0);
  let mut ht: [i64] = alloc(2000, 0);
  // held turns start at 0; read::replay shifts them right once past the wire header + base, then moves them left in place
  let mut hb: crate::util::ByteBuffer = crate::util::byte_buffer(65536);
  let mut pl: [i64] = alloc(64, 0);
  pl[0] = -1;
  let mut pb: [u8] = alloc(18024, 0);
  let mut fs: [i64] = alloc(3, 0);
  let mut fb: [u8] = alloc(32768, 0);
  let mut detail: [u8] = alloc(0, 0);
  let mut title: str = "";
  let mut model: str = "";
  let mut more: bool = false;
  if ctl[0] == 0 {
    l = crate::rpc::open(move l, inout ctl, inout st, inout line, inout chunk, inout tl, timeout_ms);
  }
  // thread/read: any error response is not-found; the conversation's cwd must be the chosen folder
  if ctl[0] == 0 {
    ctl[1] = 4;
    ctl[4] = 2;
    if crate::transport::stdin_closed(l, slot) {
      l = crate::transport::expired(move l, overall, inout st);
      if st[0] == -1 { ctl[0] = 5; } else { ctl[0] = 6; }
    }
    l = crate::transport::send(move l, slot, crate::rpc::req_read(2, thread), timeout_ms);
    let mut done: bool = false;
    let mut events: i64 = 0;
    while ctl[0] == 0 && !done && events < 1000000
      invariant 0 <= events && events <= 1000000
      invariant len(ctl) == 8 && 0 <= ctl[6] && ctl[6] <= len(line.data)
      invariant len(st) == 5 && 0 <= st[1] && st[1] <= len(line.data) && 0 <= st[2] && st[2] <= st[4] && 0 <= st[4] && st[4] <= 65536 && len(chunk) == 65536
      invariant len(line.data) <= 8388608
      invariant crate::tail::tail_ok(tl) && tl.limit == 1024
      decreases 1000000 - events
    {
      events = events + 1;
      l = crate::rpc::step(move l, slot, overall, inout ctl, inout st, inout line, inout chunk, inout tl);
      if ctl[0] == 0 && ctl[5] == 1 {
        let parsed: crate::json::JsonParse = crate::rpc::parse_line(inout line, ctl[6], st);
        ctl[6] = 0;
        match parsed {
          crate::json::JsonParse::Failed(e) => { }
          crate::json::JsonParse::Parsed(d) => {
            let k: i64 = crate::rpc::kind_of(d, 2);
            if k == 1 { l = crate::transport::send(move l, slot, crate::rpc::not_handled(d), timeout_ms); }
            if k == 2 {
              done = true;
              let error: i64 = crate::util::field(d, 0, "error");
              if crate::access::kind(d, error) == 6 {
                ctl[0] = 3;
                detail = crate::rpc::error_detail(d, error);
              } else {
                let res: i64 = crate::util::field(d, 0, "result");
                let tid: i64 = crate::util::field(d, res, "thread");
                let cw: i64 = crate::util::field(d, tid, "cwd");
                if crate::access::kind(d, tid) == 6 && crate::access::kind(d, cw) == 4 && !crate::folder::lone(crate::access::string_units(d, cw).units) && crate::folder::same(crate::util::str_at(d, cw), folder) {
                  let nm: i64 = crate::util::field(d, tid, "name");
                  if crate::access::kind(d, nm) == 4 {
                    let nv: str = crate::util::str_at(d, nm);
                    let tn: ref str = crate::text::trim(nv);
                    if len(tn) > 0 { title = crate::text::one_line(tn, 120); }
                  }
                  let mf: i64 = crate::util::field(d, tid, "model");
                  let mut mid: i64 = -1;
                  if crate::access::kind(d, mf) == 4 { mid = mf; }
                  else if crate::access::kind(d, mf) == 6 {
                    let idf: i64 = crate::util::field(d, mf, "id");
                    if crate::access::kind(d, idf) == 4 { mid = idf; }
                  }
                  if mid >= 0 {
                    let ms: str = crate::util::str_at(d, mid);
                    if crate::util::units16(ms) <= 200 {
                      let mt: ref str = crate::text::trim(ms);
                      if len(mt) > 0 { model = copy(mt); }
                    }
                  }
                } else {
                  ctl[0] = 3;
                }
              }
            }
          }
        }
      }
    }
    if ctl[0] == 0 && !done { ctl[0] = 6; }
  }
  // thread/turns/list: newest first, at most 40 pages
  let mut id: i64 = 2;
  let mut page: i64 = 0;
  let mut cursor: [u8] = alloc(0, 0);
  let mut fin: bool = false;
  while ctl[0] == 0 && !fin && page < 40
    invariant id == 2 + page && 0 <= page && page <= 40
    invariant len(ctl) == 8 && 0 <= ctl[6] && ctl[6] <= len(line.data)
    invariant len(st) == 5 && 0 <= st[1] && st[1] <= len(line.data) && 0 <= st[2] && st[2] <= st[4] && 0 <= st[4] && st[4] <= 65536 && len(chunk) == 65536
    invariant len(line.data) <= 8388608
    invariant crate::tail::tail_ok(tl) && tl.limit == 1024
    invariant len(hs) == 8 && len(ht) == 2000 && len(hb.data) <= 8700000 && len(pl) == 64 && len(pb) == 18024 && len(fs) == 3 && len(fb) == 32768
    invariant 0 <= hs[0] && hs[0] <= 200 && 0 <= hs[1] && hs[1] <= len(hb.data) && 0 <= hs[2] && hs[2] <= 2097152
    invariant -1 <= pl[0] && pl[0] <= 30 && 0 <= pl[1] && pl[1] <= 100000000 && 0 <= pl[62] && pl[62] <= 18000 && (pl[63] == 0 || pl[63] == 1)
    invariant 0 <= fs[0] && fs[0] <= fs[1] && fs[1] <= 32768 && (fs[2] == 0 || fs[2] == 1)
    decreases 40 - page
  {
    id = id + 1;
    page = page + 1;
    ctl[1] = 5;
    ctl[4] = id;
    if crate::transport::stdin_closed(l, slot) {
      l = crate::transport::expired(move l, overall, inout st);
      if st[0] == -1 { ctl[0] = 5; } else { ctl[0] = 6; }
    }
    l = crate::transport::send(move l, slot, crate::rpc::req_turns(id, thread, cursor), timeout_ms);
    let mut done: bool = false;
    let mut events: i64 = 0;
    while ctl[0] == 0 && !done && events < 1000000
      invariant 0 <= events && events <= 1000000
      invariant len(ctl) == 8 && 0 <= ctl[6] && ctl[6] <= len(line.data)
      invariant len(st) == 5 && 0 <= st[1] && st[1] <= len(line.data) && 0 <= st[2] && st[2] <= st[4] && 0 <= st[4] && st[4] <= 65536 && len(chunk) == 65536
      invariant len(line.data) <= 8388608
      invariant crate::tail::tail_ok(tl) && tl.limit == 1024
      invariant id == 2 + page && 0 <= page && page <= 40
      invariant len(hs) == 8 && len(ht) == 2000 && len(hb.data) <= 8700000 && len(pl) == 64 && len(pb) == 18024 && len(fs) == 3 && len(fb) == 32768
      invariant 0 <= hs[0] && hs[0] <= 200 && 0 <= hs[1] && hs[1] <= len(hb.data) && 0 <= hs[2] && hs[2] <= 2097152
      invariant -1 <= pl[0] && pl[0] <= 30 && 0 <= pl[1] && pl[1] <= 100000000 && 0 <= pl[62] && pl[62] <= 18000 && (pl[63] == 0 || pl[63] == 1)
      invariant 0 <= fs[0] && fs[0] <= fs[1] && fs[1] <= 32768 && (fs[2] == 0 || fs[2] == 1)
      decreases 1000000 - events
    {
      events = events + 1;
      l = crate::rpc::step(move l, slot, overall, inout ctl, inout st, inout line, inout chunk, inout tl);
      if ctl[0] == 0 && ctl[5] == 1 {
        let parsed: crate::json::JsonParse = crate::rpc::parse_line(inout line, ctl[6], st);
        ctl[6] = 0;
        match parsed {
          crate::json::JsonParse::Failed(e) => { }
          crate::json::JsonParse::Parsed(d) => {
            let k: i64 = crate::rpc::kind_of(d, id);
            if k == 1 { l = crate::transport::send(move l, slot, crate::rpc::not_handled(d), timeout_ms); }
            if k == 2 {
              done = true;
              let error: i64 = crate::util::field(d, 0, "error");
              if crate::access::kind(d, error) == 6 {
                // -32601 codex-unsupported; not found / no rollout / unknown thread not-found; else read-failed
                let cls: i64 = crate::rpc::error_class(d, error);
                ctl[0] = 6;
                if cls == 1 { ctl[0] = 4; }
                if cls == 2 { ctl[0] = 3; }
                detail = crate::rpc::error_detail(d, error);
              } else {
                let res: i64 = crate::util::field(d, 0, "result");
                let r: i64 = crate::read::absorb(d, res, inout hs, inout ht, inout hb, inout pl, inout pb, inout fs, inout fb);
                if r < 0 { ctl[0] = 2; }
                else {
                  let dn: i64 = crate::access::array_length(d, crate::util::field(d, res, "data"));
                  let nxt: i64 = crate::util::field(d, res, "nextCursor");
                  let cu: crate::access::Units = crate::access::string_units(d, nxt);
                  if hs[4] == 1 { more = true; fin = true; }
                  else if cu.status != 0 || len(cu.units) == 0 || dn <= 0 { fin = true; }
                  else {
                    cursor = crate::util::raw(d, nxt);
                    if page == 40 { more = true; }
                  }
                }
              }
            }
          }
        }
      }
    }
    if ctl[0] == 0 && !done { ctl[0] = 6; }
  }
  let code: i64 = ctl[0];
  let stage: i64 = ctl[1];
  if code == 0 {
    let wire: [u8] = crate::read::finish(hs, ht, move hb.data, pl, pb, title, model, more);
    crate::transport::close(move l, slot);
    return wire;
  }
  crate::transport::close(move l, slot);
  if len(detail) <= 100000000 { return crate::packet::wire_fail(code, stage, detail); }
  return crate::packet::wire_fail(code, stage, empty);
}
