// Result packets (docs/CODEX_IMPORT_SPEC.md "Boundary representation").
//   success  [0, 16, row_words, byte_len, ...meta16, ...rows, ...text_bytes]
//   failure  [code, stage, detail_len, ...detail]   (code != 0)
// meta: 0 schema 1, 1 mode (0 list, 1 read), 2 omittedBefore, 3 row count, 4-5 title ref, 6-7 model ref,
//       8-9 lastPlan at ref, 10 row width (list 9, read 10), 11 lastPlan item count (-1 absent), 12 lastPlan more, 13-15 0.
// Refs are (start,len) into the text bytes; (-1,0) is absent.
// Failure codes: 1 InputTooLarge, 2 InternalInvariant, 3 not-found, 4 codex-unsupported, 5 timeout, 6 read-failed, 7 engine-missing.

pub fn fail(code: i64, stage: i64, detail: [u8]) -> [i64] ! alloc
  requires len(detail) <= 100000000
  ensures len(result) == 3 + len(detail)
{
  let mut p: [i64] = alloc(3 + len(detail), 0);
  let mut c: i64 = code;
  if c < 1 { c = 2; }
  p[0] = c;
  p[1] = stage;
  p[2] = len(detail);
  let mut i: i64 = 0;
  while i < len(detail)
    invariant 0 <= i && i <= len(detail) && len(p) == 3 + len(detail)
    decreases len(detail) - i
  {
    p[3 + i] = detail[i];
    i = i + 1;
  }
  return p;
}

// fresh meta for a mode: schema 1, all refs absent, no plan
pub fn meta_new(mode: i64) -> [i64] ! alloc
  requires 0 <= mode && mode <= 1
  ensures len(result) == 16
{
  let mut m: [i64] = alloc(16, 0);
  m[0] = 1;
  m[1] = mode;
  m[4] = -1;
  m[6] = -1;
  m[8] = -1;
  m[10] = 9;
  if mode == 1 { m[10] = 10; }
  m[11] = -1;
  return m;
}

// A ref (s,l) is absent (-1,0) or inside a text of n bytes.
fn ref_ok(s: i64, l: i64, n: i64) -> bool
  requires 0 <= n
{
  if s == -1 { return l == 0; }
  if s < 0 || s > n { return false; }
  if l < 0 || l > n - s { return false; }
  return true;
}

fn check_list(rows: [i64], count: i64, n: i64) -> bool
  requires 0 <= n && 0 <= count && count <= 50 && len(rows) == 450
{
  let mut i: i64 = 0;
  while i < count
    invariant 0 <= i && i <= count && count <= 50 && len(rows) == 450 && 0 <= n
    decreases count - i
  {
    let b: i64 = 9 * i;
    if !ref_ok(rows[b], rows[b + 1], n) { return false; }
    if !ref_ok(rows[b + 2], rows[b + 3], n) { return false; }
    if !ref_ok(rows[b + 4], rows[b + 5], n) { return false; }
    if !ref_ok(rows[b + 6], rows[b + 7], n) { return false; }
    if rows[b + 8] < -1 || rows[b + 8] > 1 { return false; }
    i = i + 1;
  }
  return true;
}

fn assemble(meta: [i64], rows: [i64], rw: i64, text: [u8]) -> [i64] ! alloc
  requires len(meta) == 16 && 0 <= rw && rw <= len(rows) && len(rows) <= 100000000 && len(text) <= 100000000
  ensures len(result) == 20 + rw + len(text)
{
  let nx: i64 = len(text);
  let mut p: [i64] = alloc(20 + rw + nx, 0);
  p[1] = 16;
  p[2] = rw;
  p[3] = nx;
  let mut i: i64 = 0;
  while i < 16
    invariant 0 <= i && i <= 16 && len(p) == 20 + rw + nx && len(meta) == 16
    decreases 16 - i
  { p[4 + i] = meta[i]; i = i + 1; }
  let mut j: i64 = 0;
  while j < rw
    invariant 0 <= j && j <= rw && rw <= len(rows) && len(p) == 20 + rw + nx
    decreases rw - j
  { p[20 + j] = rows[j]; j = j + 1; }
  let mut k: i64 = 0;
  while k < nx
    invariant 0 <= k && k <= nx && nx == len(text) && len(p) == 20 + rw + nx
    decreases nx - k
  { p[20 + rw + k] = text[k]; k = k + 1; }
  return p;
}

// rows holds 9 words per row for `count` rows (rows has room for 50)
pub fn list_ok(rows: [i64], count: i64, text: [u8]) -> [i64] ! alloc
  requires len(rows) == 450 && 0 <= count && count <= 50 && len(text) <= 100000000
  ensures len(result) >= 3
{
  let empty: [u8] = alloc(0, 0);
  if !check_list(rows, count, len(text)) { return fail(2, 6, empty); }
  let mut m: [i64] = meta_new(0);
  m[3] = count;
  return assemble(m, rows, 9 * count, text);
}

// meta from meta_new(1); rows = 10 words per turn (kept = meta[3]) then 2 words per plan item (items = meta[11])
fn check_read(meta: [i64], rows: [i64], n: i64) -> bool
  requires len(meta) == 16 && 0 <= n
{
  let kept: i64 = meta[3];
  let mut items: i64 = meta[11];
  if items < 0 { items = 0; }
  if kept < 0 || kept > 200 || items > 30 || len(rows) != 10 * kept + 2 * items { return false; }
  if !ref_ok(meta[4], meta[5], n) || !ref_ok(meta[6], meta[7], n) || !ref_ok(meta[8], meta[9], n) { return false; }
  let mut i: i64 = 0;
  while i < kept
    invariant 0 <= i && i <= kept && kept <= 200 && 0 <= items && items <= 30 && len(rows) == 10 * kept + 2 * items && 0 <= n
    decreases kept - i
  {
    let b: i64 = 10 * i;
    if !ref_ok(rows[b], rows[b + 1], n) { return false; }
    if !ref_ok(rows[b + 2], rows[b + 3], n) { return false; }
    if !ref_ok(rows[b + 4], rows[b + 5], n) { return false; }
    if !ref_ok(rows[b + 6], rows[b + 7], n) { return false; }
    if rows[b + 8] < 0 { return false; }
    if rows[b + 9] != 0 && rows[b + 9] != 1 { return false; }
    i = i + 1;
  }
  let mut j: i64 = 0;
  while j < items
    invariant 0 <= j && j <= items && items <= 30 && 0 <= kept && kept <= 200 && len(rows) == 10 * kept + 2 * items && 0 <= n
    decreases items - j
  {
    let b: i64 = 10 * kept + 2 * j;
    if !ref_ok(rows[b], rows[b + 1], n) { return false; }
    if rows[b] < 0 { return false; }
    j = j + 1;
  }
  return true;
}

// Read wire: 8-byte little-endian words of v + 1 (so -1 encodes as zero; the top byte is zero).
// Success: [0, 16, row_words, byte_len, ...meta16, ...rows], then raw UTF-8 text.
// Failure: [code, stage, detail_len], then raw detail bytes. Refs are relative to the text start.
fn put_word(inout wire: [u8], at: i64, v: i64) -> bool
  requires 0 <= at && at <= len(wire) - 8
  ensures len(wire) == len(old(wire))
{
  if v < -1 || v > 72057594037927934 { return false; }
  let mut u: i64 = v + 1;
  let mut i: i64 = 0;
  while i < 8
    invariant 0 <= i && i <= 8 && 0 <= u && 0 <= at && at <= len(wire) - 8 && len(wire) == len(old(wire))
    decreases 8 - i
  {
    wire[at + i] = u % 256;
    u = u / 256;
    i = i + 1;
  }
  return true;
}

fn get_word(wire: [u8], at: i64) -> i64
  requires 0 <= at && at <= len(wire) - 8
{
  let mut u: i64 = wire[at + 6];
  u = u * 256 + wire[at + 5];
  u = u * 256 + wire[at + 4];
  u = u * 256 + wire[at + 3];
  u = u * 256 + wire[at + 2];
  u = u * 256 + wire[at + 1];
  u = u * 256 + wire[at];
  return u - 1;
}

pub fn wire_fail(code: i64, stage: i64, detail: [u8]) -> [u8] ! alloc
  requires len(detail) <= 100000000
  ensures len(result) == 24 + len(detail)
{
  let mut wire: [u8] = alloc(24 + len(detail), 0);
  let mut c: i64 = code;
  if c < 1 || c > 7 { c = 2; }
  let a: bool = put_word(inout wire, 0, c);
  let mut st: i64 = stage;
  if st < 0 || st > 6 { st = 0; }
  let b: bool = put_word(inout wire, 8, st);
  let d: bool = put_word(inout wire, 16, len(detail));
  crate::bytes::copy_span(inout wire, 24, detail, 0, len(detail));
  return wire;
}

// Validate the read shape, then write the words and leave the text area for finish().
pub fn wire_read(meta: [i64], rows: [i64], n: i64) -> [u8] ! alloc
  requires len(meta) == 16 && len(rows) <= 2060 && 0 <= n && n <= 100000000
  ensures len(result) == 24 || len(result) == 8 * (20 + len(rows)) + n
{
  let empty: [u8] = alloc(0, 0);
  if !check_read(meta, rows, n) { return wire_fail(2, 6, empty); }
  let rw: i64 = len(rows);
  let mut wire: [u8] = alloc(8 * (20 + rw) + n, 0);
  let a: bool = put_word(inout wire, 0, 0);
  let b: bool = put_word(inout wire, 8, 16);
  let c: bool = put_word(inout wire, 16, rw);
  let d: bool = put_word(inout wire, 24, n);
  let mut i: i64 = 0;
  while i < 16
    invariant 0 <= i && i <= 16 && len(meta) == 16 && len(wire) == 8 * (20 + rw) + n && 0 <= rw && 0 <= n
    decreases 16 - i
  {
    if !put_word(inout wire, 8 * (4 + i), meta[i]) { return wire_fail(2, 6, empty); }
    i = i + 1;
  }
  let mut j: i64 = 0;
  while j < rw
    invariant 0 <= j && j <= rw && rw == len(rows) && len(wire) == 8 * (20 + rw) + n && 0 <= n
    decreases rw - j
  {
    if !put_word(inout wire, 8 * (20 + j), rows[j]) { return wire_fail(2, 6, empty); }
    j = j + 1;
  }
  return wire;
}

// Only the legacy codex_read entry widens the text bytes into [i64].
pub fn wire_packet(wire: [u8]) -> [i64] ! alloc
  requires len(wire) >= 24
  ensures len(result) >= 3
{
  let code: i64 = get_word(wire, 0);
  let mut words: i64 = 3;
  let mut n: i64 = get_word(wire, 16);
  if code == 0 {
    let rw: i64 = n;
    if len(wire) >= 32 && 0 <= rw && rw <= 2060 {
      words = 20 + rw;
      n = get_word(wire, 24);
    } else {
      n = -1;
    }
  }
  let header: i64 = 8 * words;
  if n < 0 || n > 100000000 || len(wire) != header + n {
    let empty: [u8] = alloc(0, 0);
    return fail(2, 6, empty);
  }
  let mut out: [i64] = alloc(words + n, 0);
  let mut i: i64 = 0;
  while i < words
    invariant 0 <= i && i <= words && 3 <= words && words <= 2080 && 0 <= n && len(out) == words + n && len(wire) == header + n && header == 8 * words
    decreases words - i
  {
    out[i] = get_word(wire, 8 * i);
    i = i + 1;
  }
  let mut j: i64 = 0;
  while j < n
    invariant 0 <= j && j <= n && 3 <= words && len(out) == words + n && len(wire) == header + n && header == 8 * words
    decreases n - j
  {
    out[words + j] = wire[header + j];
    j = j + 1;
  }
  return out;
}
