// Codex app-server conversation (withRpcChild with jsonrpc false, withCodex) on the G10 event loop.
// The caller owns the receive state: st [5], line (up to 8388608 bytes), chunk [65536], tl (the stderr tail, limit 1024) (see receive below)
// and the control state Ctl:
//   fail   failure code (0 none; 2 internal, 3 not-found, 4 codex-unsupported, 5 timeout, 6 read-failed, 7 engine-missing)
//   stage  (0 pre-spawn, 1 spawn, 2 initialize, 3 thread/list, 4 thread/read, 5 thread/turns/list, 6 result)
//   slot   process slot (-1 none)   overall  overall timer slot
//   got    step left a line         n        length of that line in `line`
// Callers pump with step until kind_of says the response arrived (at most 1,000,000 events, then read-failed); the
// first failure wins.

pub struct Ctl { fail: i64, stage: i64, slot: i64, overall: i64, got: bool, n: i64 }

// child arguments: app-server --stdio, then the host's extra arguments
fn child_args(argv: str, sp: [i64]) -> ProcessArgs ! alloc
  requires len(sp) >= 2 && sp[0] == 0 && 0 <= sp[1] && sp[1] <= 1048576 && len(sp) == 2 + 2 * sp[1]
{
  let mut a: ProcessArgs = proc_args_new();
  a = proc_args_push(move a, "app-server");
  a = proc_args_push(move a, "--stdio");
  let cnt: i64 = sp[1];
  let mut k: i64 = 0;
  while k < cnt
    invariant 0 <= k && k <= cnt && proc_args_len(a) == k + 2
    invariant sp[0] == 0 && len(sp) == 2 + 2 * cnt && cnt == sp[1]
    decreases cnt - k
  {
    let lo: i64 = sp[2 + 2 * k];
    let hi: i64 = sp[3 + 2 * k];
    if lo < 0 || hi < lo || hi > len(argv) || !is_char_boundary(argv, lo) || !is_char_boundary(argv, hi) { return move a; }
    let piece: str = substr(argv, lo, hi);
    a = proc_args_push(move a, piece);
    k = k + 1;
  }
  return move a;
}

// Spawn the child and register it with one overall timer. On failure ctl.fail is set and the returned loop is only to be closed.
pub fn ctl_new() -> Ctl
  ensures result.fail == 0 && result.n == 0
{ return Ctl { fail: 0, stage: 0, slot: -1, overall: -1, got: false, n: 0 }; }

pub fn start(binary: str, argv: str, cwd: str, timeout_ms: i64, inout ctl: Ctl) -> Loop ! async, net, proc, alloc
  requires ctl.fail == 0 && ctl.n == 0
  ensures ctl.n == 0
{
  let sp: [i64] = crate::args::arg_spans(argv);
  if sp[0] != 0 { ctl.fail = 2; let l0: Loop = ev_new(3); return move l0; }
  let args: ProcessArgs = child_args(argv, sp);
  ctl.stage = 1;
  let child: Process = proc_spawn(binary, args, cwd);
  if !proc_ok(child) {
    let r: Result<i64> = proc_wait(move child);
    ctl.fail = 7;
    let l1: Loop = ev_new(3);
    return move l1;
  }
  let mut l: Loop = ev_new(3);
  if !ev_ok(l) || ev_count(l) >= ev_cap(l) {
    let k: Result<i64> = proc_kill(move child);
    ctl.fail = 6;
    return move l;
  }
  l = ev_add_process(move l, move child);
  ctl.slot = ev_last(l);
  if !ev_ok(l) || ev_count(l) >= ev_cap(l) { ctl.fail = 6; return move l; }
  let mut ms: i64 = timeout_ms;
  if ms < 0 { ms = 0; }
  if ms > 86400000 { ms = 86400000; }
  l = ev_add_timer(move l, ms);
  ctl.overall = ev_last(l);
  if !ev_ok(l) || ev_count(l) >= ev_cap(l) { ctl.fail = 6; return move l; }
  return move l;
}

// trim the line, parse it as JSON (P1: invalid UTF-8 is a parse failure and the line is skipped).
// DB59 (G-DB58-1): line.data stays with the caller and is reused for the next line (its size stays at the longest
// line so far, as hand's cleared `self.line`); the document copies out only the trimmed line, once.
pub fn parse_line(inout line: crate::util::ByteBuffer, n: i64, st: crate::transport::Reader) -> crate::json::JsonParse ! alloc
  requires 0 <= n && n <= len(line.data) && len(line.data) <= 8388608
  requires 0 <= st.filled && st.filled <= len(line.data)
  ensures len(line.data) <= 8388608 && st.filled <= len(line.data)
  ensures is_variant(result, crate::json::JsonParse::Parsed) ==> crate::json::doc_local(variant_field(result, crate::json::JsonParse::Parsed, document))
{
  let t: crate::util::Bounds = crate::util::trim_span(line.data, n);
  return crate::lines::parse_copy(line.data, t.lo, t.hi);
}

// The shared transport requires a full-sized line buffer. Keep its polling and event order
// here, growing only the line storage while keeping the wire limit fixed.
fn receive(take l: Loop, slot: i64, overall: i64,
  inout st: crate::transport::Reader, inout line: crate::util::ByteBuffer, inout chunk: [u8], inout tl: crate::tail::Tail) -> Loop ! async, proc, alloc
  requires 0 <= st.filled && st.filled <= len(line.data) && 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
  requires len(line.data) <= 8388608
  requires crate::tail::tail_ok(tl) && tl.limit == 1024
  ensures 0 <= st.filled && st.filled <= len(line.data) && 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
  ensures len(line.data) <= 8388608
  ensures crate::tail::tail_ok(tl) && tl.limit == 1024
{
  st.status = -6;
  let mut q: Loop = crate::transport::poll(move l, overall, -1, true, inout st, 0);
  if st.status != -6 { return move q; }
  if !ev_ok(q) || !crate::transport::live(q, slot) { st.status = -5; return move q; }
  if !ev_eof(q, slot) {
    q = ev_proc_read(move q, slot, 2, 65536);
    if ev_ok(q) {
      let err: [u8] = ev_bytes(q);
      crate::tail::push(inout tl, 1, err);
    }
  }
  if st.at == st.end && ev_ok(q) && crate::transport::live(q, slot) && !ev_eof(q, slot) {
    // DB58: read straight into `chunk` (no `ev_bytes` copy of the loop buffer per read)
    let mut got: i64 = 0;
    q = ev_proc_read_into(move q, slot, 1, inout chunk, inout got);
    if ev_ok(q) {
      st.end = got;
      st.at = 0;
    }
  }
  let begin: i64 = st.at;
  let filled: i64 = st.filled;
  // memchr for the newline within the line limit
  let mut lim: i64 = st.end;
  if lim - begin > 8388608 - filled { lim = begin + 8388608 - filled; }
  let mut i: i64 = find_byte(chunk, 10, begin, lim);
  let needed: i64 = filled + (i - begin);
  if needed > len(line.data) { crate::util::grow_bytes(inout line.data, needed, 8388608); }
  crate::bytes::copy_span(inout line.data, filled, chunk, begin, i);
  st.filled = needed;
  if i < st.end {
    if chunk[i] == 10 {
      st.status = needed;
      st.filled = 0;
    } else {
      st.status = -3;
    }
    i = i + 1;
  }
  st.at = i;
  if st.status == -6 && ev_ok(q) {
    if crate::transport::live(q, slot) && ev_eof(q, slot) && st.at == st.end {
      q = ev_proc_wait_for(move q, slot, 10);
      if ev_ok(q) {
        if slot >= 0 && slot < ev_cap(q) && ev_kind(q, slot) == 0 {
          // A timer that fired during the wait takes precedence over the exit.
          st.exit = ev_exit(q);
          q = crate::transport::poll(move q, overall, -1, true, inout st, 0);
          if st.status == -6 { st.status = -4; }
        } else {
          q = crate::transport::poll(move q, overall, -1, true, inout st, 0);
        }
      }
    } else {
      q = crate::transport::poll(move q, overall, -1, true, inout st, 10);
    }
  }
  if !ev_ok(q) { st.status = -5; }
  return move q;
}

// One receive step of a caller's pump loop (the caller parses each line once and keeps the document; a document cannot
// travel back with the loop). ctl.got when a line of ctl.n bytes is in `line`, false when nothing usable arrived.
// An oversized line, a closed child, a timeout or a transport failure sets ctl.fail.
pub fn step(take l: Loop, slot: i64, overall: i64, inout ctl: Ctl, inout st: crate::transport::Reader, inout line: crate::util::ByteBuffer, inout chunk: [u8], inout tl: crate::tail::Tail) -> Loop ! async, proc, alloc
  requires 0 <= st.filled && st.filled <= len(line.data) && 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
  requires len(line.data) <= 8388608
  requires crate::tail::tail_ok(tl) && tl.limit == 1024
  ensures 0 <= ctl.n && ctl.n <= len(line.data)
  ensures 0 <= st.filled && st.filled <= len(line.data) && 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
  ensures len(line.data) <= 8388608
  ensures crate::tail::tail_ok(tl) && tl.limit == 1024
{
  let mut q: Loop = receive(move l, slot, overall, inout st, inout line, inout chunk, inout tl);
  let n: i64 = st.status;
  ctl.got = false;
  ctl.n = 0;
  if n == -1 { ctl.fail = 5; }
  else if n < 0 && n != -6 { ctl.fail = 6; }
  else if n >= 0 && n <= len(line.data) {
    ctl.got = true;
    ctl.n = n;
  }
  return move q;
}

// What a parsed line is to a caller waiting for request `id`: 1 a server request (answer it with not_handled), 2 the
// response to `id`, 0 anything to ignore (notifications, garbage, other ids, id tokens that are not exactly the decimal id).
pub fn kind_of(d: crate::json::JsonDocument, id: i64) -> i64 ! alloc
  requires 1 <= id && id <= 99
{
  if crate::access::kind(d, 0) != 6 { return 0; }
  let mid: i64 = crate::util::field(d, 0, "id");
  let method: i64 = crate::util::field(d, 0, "method");
  if mid >= 0 && crate::access::kind(d, method) == 4 { return 1; }
  if mid >= 0 {
    let number: crate::access::Number = crate::access::number(d, mid);
    let sp: crate::access::Span = crate::access::raw_span(d, mid);
    if number.status == 0 && sp.status == 0 && crate::util::id_is(d.source, sp.start, sp.end, id) { return 2; }
  }
  return 0;
}

// the -32601 "not handled" reply to a server request
pub fn not_handled(d: crate::json::JsonDocument) -> [u8] ! alloc
{
  let a: str = "{\"id\":";
  let z: str = ",\"error\":{\"code\":-32601,\"message\":\"not handled\"}}\n";
  let sp: crate::access::Span = crate::access::raw_span(d, crate::util::field(d, 0, "id"));
  let mut out: [u8] = alloc(0, 0);
  if sp.status != 0 {
    arr_reserve(inout out, len(a) + 4 + len(z));
    arr_append(inout out, a, 0, len(a));
    arr_append(inout out, "null", 0, 4);
  } else {
    arr_reserve(inout out, len(a) + sp.end - sp.start + len(z));
    arr_append(inout out, a, 0, len(a));
    arr_append(inout out, d.source, sp.start, sp.end - sp.start);
  }
  arr_append(inout out, z, 0, len(z));
  return out;
}

// initialize (id 1), then the initialized notification. An error response to initialize is read-failed at stage 2.
pub fn open(take l: Loop, inout ctl: Ctl, inout st: crate::transport::Reader, inout line: crate::util::ByteBuffer, inout chunk: [u8], inout tl: crate::tail::Tail, ms: i64) -> Loop ! async, proc, alloc
  requires 0 <= st.filled && st.filled <= len(line.data) && 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
  requires len(line.data) <= 8388608
  requires crate::tail::tail_ok(tl) && tl.limit == 1024
  ensures 0 <= ctl.n && ctl.n <= len(line.data)
  ensures 0 <= st.filled && st.filled <= len(line.data) && 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
  ensures len(line.data) <= 8388608
  ensures crate::tail::tail_ok(tl) && tl.limit == 1024
{
  let slot: i64 = ctl.slot;
  let overall: i64 = ctl.overall;
  ctl.stage = 2;
  ctl.got = false;
  ctl.n = 0;
  let req: [u8] = crate::util::to_bytes("{\"id\":1,\"method\":\"initialize\",\"params\":{\"clientInfo\":{\"name\":\"lair\",\"title\":\"Lair\",\"version\":\"0.0.1\"},\"capabilities\":{\"experimentalApi\":true,\"requestAttestation\":false}}}\n");
  let mut q: Loop = crate::transport::send(move l, slot, req, ms);
  let mut done: bool = false;
  let mut events: i64 = 0;
  while ctl.fail == 0 && !done && events < 1000000
    invariant 0 <= events && events <= 1000000 && 0 <= ctl.n && ctl.n <= len(line.data)
    invariant 0 <= st.filled && st.filled <= len(line.data) && 0 <= st.at && st.at <= st.end && 0 <= st.end && st.end <= 65536 && len(chunk) == 65536
    invariant len(line.data) <= 8388608
    invariant crate::tail::tail_ok(tl) && tl.limit == 1024
    decreases 1000000 - events
  {
    events = events + 1;
    q = step(move q, slot, overall, inout ctl, inout st, inout line, inout chunk, inout tl);
    if ctl.fail == 0 && ctl.got {
      let parsed: crate::json::JsonParse = parse_line(inout line, ctl.n, st);
      ctl.n = 0;
      match parsed {
        crate::json::JsonParse::Failed(e) => { }
        crate::json::JsonParse::Parsed(d) => {
          let k: i64 = kind_of(d, 1);
          if k == 1 { q = crate::transport::send(move q, slot, not_handled(d), ms); }
          else if k == 2 {
            done = true;
            let error: i64 = crate::util::field(d, 0, "error");
            if crate::access::kind(d, error) == 6 { ctl.fail = 6; }
            else if crate::transport::stdin_closed(q, slot) {
              q = crate::transport::expired(move q, overall, inout st);
              if st.status == -1 { ctl.fail = 5; } else { ctl.fail = 6; }
            }
            else { q = crate::transport::send(move q, slot, crate::util::to_bytes("{\"method\":\"initialized\",\"params\":{}}\n"), ms); }
          }
        }
      }
    }
  }
  if ctl.fail == 0 && !done { ctl.fail = 6; }
  return move q;
}

// thread/list request: one buffer reserved for the worst case, the fixed parts appended, the folder escaped into it
pub fn req_list(id: i64, folder: str) -> [u8] ! alloc
  requires 1 <= id && id <= 99 && len(folder) <= 1000000
{
  let a: str = "{\"id\":";
  let b: str = ",\"method\":\"thread/list\",\"params\":{\"cwd\":[\"";
  let z: str = "\"],\"limit\":50,\"sortKey\":\"updated_at\",\"useStateDbOnly\":true,\"sourceKinds\":[\"cli\",\"vscode\",\"exec\",\"appServer\"]}}\n";
  let mut out: [u8] = alloc(0, 0);
  arr_reserve(inout out, len(a) + 2 + len(b) + 6 * len(folder) + len(z));
  arr_append(inout out, a, 0, len(a));
  crate::util::push_int(inout out, id);
  arr_append(inout out, b, 0, len(b));
  crate::util::push_escaped(inout out, folder);
  arr_append(inout out, z, 0, len(z));
  return out;
}

pub fn req_read(id: i64, thread: str) -> [u8] ! alloc
  requires 1 <= id && id <= 99 && len(thread) <= 1000000
{
  let a: str = "{\"id\":";
  let b: str = ",\"method\":\"thread/read\",\"params\":{\"threadId\":\"";
  let z: str = "\",\"includeTurns\":false}}\n";
  let mut out: [u8] = alloc(0, 0);
  arr_reserve(inout out, len(a) + 2 + len(b) + 6 * len(thread) + len(z));
  arr_append(inout out, a, 0, len(a));
  crate::util::push_int(inout out, id);
  arr_append(inout out, b, 0, len(b));
  crate::util::push_escaped(inout out, thread);
  arr_append(inout out, z, 0, len(z));
  return out;
}

// cursor is the raw JSON token (with its quotes) received as nextCursor, or empty for the first page
pub fn req_turns(id: i64, thread: str, cursor: [u8]) -> [u8] ! alloc
  requires 1 <= id && id <= 99 && len(thread) <= 1000000 && len(cursor) <= 16777216
{
  let a: str = "{\"id\":";
  let b: str = ",\"method\":\"thread/turns/list\",\"params\":{\"threadId\":\"";
  let c: str = "\",\"limit\":20,\"sortDirection\":\"desc\",\"itemsView\":\"summary\"";
  let k: str = ",\"cursor\":";
  let z: str = "}}\n";
  let mut out: [u8] = alloc(0, 0);
  arr_reserve(inout out, len(a) + 2 + len(b) + 6 * len(thread) + len(c) + len(k) + len(cursor) + len(z));
  arr_append(inout out, a, 0, len(a));
  crate::util::push_int(inout out, id);
  arr_append(inout out, b, 0, len(b));
  crate::util::push_escaped(inout out, thread);
  arr_append(inout out, c, 0, len(c));
  if len(cursor) > 0 {
    arr_append(inout out, k, 0, len(k));
    arr_append(inout out, cursor, 0, len(cursor));
  }
  arr_append(inout out, z, 0, len(z));
  return out;
}

// ---- error responses ----

fn lower(x: i64) -> i64
{
  if x >= 65 && x <= 90 { return x + 32; }
  return x;
}

// ASCII-case-insensitive literal at unit position i of u[0..n) (JS /i never matches a non-ASCII unit to an ASCII letter)
fn lit_at(u: [i64], n: i64, i: i64, lit: str) -> bool
  requires 0 <= n && n <= len(u) && 0 <= i
{
  if len(lit) > n - i { return false; }
  let mut k: i64 = 0;
  while k < len(lit)
    invariant 0 <= k && k <= len(lit) && len(lit) <= n - i && 0 <= i && n <= len(u)
    decreases len(lit) - k
  {
    let x: i64 = u[i + k];
    let y: i64 = lit[k];
    if lower(x) != y { return false; }
    k = k + 1;
  }
  return true;
}

// /not found|no rollout|unknown thread/i over the first n units
fn has_phrase(u: [i64], n: i64) -> bool ! alloc
  requires 0 <= n && n <= len(u)
{
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n <= len(u)
    decreases n - i
  {
    if lit_at(u, n, i, "not found") { return true; }
    if lit_at(u, n, i, "no rollout") { return true; }
    if lit_at(u, n, i, "unknown thread") { return true; }
    i = i + 1;
  }
  return false;
}

// the expected significant digit at position p of 32601
// The JSON number token src[s..e) reads as -32601 after JS's binary64 rounding (JS ===): "-32601", "-32601.0",
// "-3.2601e4", and any value within half an ulp (2^-39, ties to even, so both ends included) of it. The token is
// already a valid JSON number. Its significant digits (leading zeros skipped) are compared with the exact decimal
// bounds 32601 -/+ 2^-39 (digits past a bound are zeros), and the decimal exponent must put the fifth significant
// digit in the units place. The exponent saturates far beyond what a line can compensate.
fn is_minus_32601(src: [u8], s: i64, e: i64) -> bool ! alloc
  requires 0 <= s && s <= e && e <= len(src)
{
  if e - s < 2 || src[s] != 45 { return false; }
  let lo: str = "32600999999999998181010596454143524169921875";
  let hi: str = "32601000000000001818989403545856475830078125";
  let mut i: i64 = s + 1;
  let mut sig: i64 = 0;
  let mut ip: i64 = 0;
  let mut first: i64 = 0;
  let mut dot: bool = false;
  let mut on_lo: bool = true;
  let mut on_hi: bool = true;
  while i < e && ((src[i] >= 48 && src[i] <= 57) || src[i] == 46)
    invariant s + 1 <= i && i <= e && e <= len(src) && 0 <= sig && sig <= i && 0 <= ip && ip <= i && 0 <= first && first <= i
    decreases e - i
  {
    let c: i64 = src[i];
    if c == 46 { dot = true; }
    else {
      let v: i64 = c - 48;
      if sig == 0 && v == 0 { first = first + 1; }
      else {
        let mut l: i64 = 0;
        let mut h: i64 = 0;
        if sig < len(lo) { l = lo[sig] - 48; }
        if sig < len(hi) { h = hi[sig] - 48; }
        if on_lo { if v < l { return false; } if v > l { on_lo = false; } }
        if on_hi { if v > h { return false; } if v < h { on_hi = false; } }
        sig = sig + 1;
      }
      if !dot { ip = ip + 1; }
    }
    i = i + 1;
  }
  // a prefix of the lower bound (its last digit is 5) is below it
  if sig < 5 || (on_lo && sig < len(lo)) { return false; }
  let mut x: i64 = 0;
  if i < e && (src[i] == 101 || src[i] == 69) {
    i = i + 1;
    let mut neg: bool = false;
    if i < e && (src[i] == 43 || src[i] == 45) { neg = src[i] == 45; i = i + 1; }
    while i < e && src[i] >= 48 && src[i] <= 57
      invariant s + 1 <= i && i <= e && e <= len(src) && 0 <= x && x <= 1000000000
      decreases e - i
    {
      x = 10 * x + (src[i] - 48);
      if x > 100000000 { x = 1000000000; }
      i = i + 1;
    }
    if neg { x = 0 - x; }
  }
  if i != e { return false; }
  return ip - first + x == 5;
}

// 1: error.code is exactly -32601 (codex-unsupported); 2: the message (cut to 300 units) matches the not-found regex;
// 3: anything else (read-failed).
pub fn error_class(d: crate::json::JsonDocument, e: i64) -> i64 ! alloc
{
  let c: crate::access::Number = crate::access::number(d, crate::util::field(d, e, "code"));
  if c.status == 0 && is_minus_32601(d.source, c.start, c.end) { return 1; }
  let u: crate::access::Units = crate::access::string_units(d, crate::util::field(d, e, "message"));
  if u.status == 0 {
    let mut m: i64 = len(u.units);
    if m > 300 { m = 300; }
    if has_phrase(u.units, m) { return 2; }
  }
  return 3;
}

// diagnostic detail: the message (cut to 300 units) with non-ASCII units shown as '?', "rejected" when it has none
pub fn error_detail(d: crate::json::JsonDocument, e: i64) -> [u8] ! alloc
{
  let u: crate::access::Units = crate::access::string_units(d, crate::util::field(d, e, "message"));
  if u.status != 0 { return crate::util::to_bytes("rejected"); }
  let mut m: i64 = len(u.units);
  if m > 300 { m = 300; }
  let mut out: [u8] = alloc(m, 0);
  let mut i: i64 = 0;
  while i < m
    invariant 0 <= i && i <= m && m <= len(u.units) && len(out) == m
    decreases m - i
  {
    let x: i64 = u.units[i];
    if x >= 32 && x < 127 { out[i] = x; } else { out[i] = 63; }
    i = i + 1;
  }
  return out;
}
