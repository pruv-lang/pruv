// listCodex row building (non-win32): the first 50 raw entries of result.data (else result.threads), valid ids only.
// List row (9 words): thread ref, title ref, updatedAt ref, path ref, origin (-1 absent, 0 other, 1 lair).
// Text order per row: thread, title, updatedAt, path (the refs tile the text).

// Title: name, else preview (each trimmed), one line, 120 units.
fn title(d: crate::json::JsonDocument, t: i64) -> str ! alloc
  ensures len(result) <= 50331648
{
  let name: str = crate::util::str_at(d, crate::util::field(d, t, "name"));
  let tn: ref str = crate::text::trim(name);
  if len(tn) > 0 { return crate::text::one_line(tn, 120); }
  let preview: str = crate::util::str_at(d, crate::util::field(d, t, "preview"));
  let tp: ref str = crate::text::trim(preview);
  return crate::text::one_line(tp, 120);
}

pub fn build(d: crate::json::JsonDocument, rid: i64) -> [i64] ! alloc
  ensures len(result) >= 3
{
  let empty: [u8] = alloc(0, 0);
  let mut data: i64 = crate::util::field(d, rid, "data");
  if crate::access::kind(d, data) != 5 { data = crate::util::field(d, rid, "threads"); }
  let ids: [i64] = crate::util::elements(d, data);
  let mut lim: i64 = len(ids);
  if lim > 50 { lim = 50; }
  let mut rows: [i64] = alloc(450, 0);
  let mut tx: [u8] = alloc(0, 0);
  let mut count: i64 = 0;
  let mut k: i64 = 0;
  while k < lim
    invariant 0 <= k && k <= lim && lim <= 50 && lim <= len(ids) && 0 <= count && count <= k && len(rows) == 450
    invariant len(tx) <= 100000000
    decreases lim - k
  {
    let t: i64 = ids[k];
    k = k + 1;
    if crate::access::kind(d, t) == 6 {
      let idv: str = crate::util::str_at(d, crate::util::field(d, t, "id"));
      if crate::names::valid_thread(idv) {
        let b: i64 = 9 * count;
        rows[b] = len(tx);
        rows[b + 1] = len(idv);
        if len(idv) > 100000000 - len(tx) { return crate::packet::fail(2, 6, empty); }
        arr_append(inout tx, idv, 0, len(idv));
        let one: str = title(d, t);
        rows[b + 2] = len(tx);
        rows[b + 3] = len(one);
        if len(one) > 100000000 - len(tx) { return crate::packet::fail(2, 6, empty); }
        arr_append(inout tx, one, 0, len(one));
        rows[b + 4] = -1;
        rows[b + 5] = 0;
        let uf: i64 = crate::util::field(d, t, "updatedAt");
        if uf >= 0 {
          let iso: crate::time::Iso = crate::time::iso_of(d, uf);
          if iso.status == 0 && len(iso.text) == 24 {
            rows[b + 4] = len(tx);
            rows[b + 5] = 24;
            if 24 > 100000000 - len(tx) { return crate::packet::fail(2, 6, empty); }
            arr_append(inout tx, iso.text, 0, 24);
          }
        }
        rows[b + 6] = -1;
        rows[b + 7] = 0;
        let pf: i64 = crate::util::field(d, t, "path");
        if crate::access::kind(d, pf) == 4 {
          let ps: str = crate::util::str_at(d, pf);
          if len(ps) > 0 {
            rows[b + 6] = len(tx);
            rows[b + 7] = len(ps);
            if len(ps) > 100000000 - len(tx) { return crate::packet::fail(2, 6, empty); }
            arr_append(inout tx, ps, 0, len(ps));
          }
        }
        rows[b + 8] = -1;
        let of: i64 = crate::util::field(d, t, "originator");
        if crate::access::kind(d, of) == 4 {
          let o: str = crate::util::str_at(d, of);
          rows[b + 8] = 0;
          if len(o) >= 4 {
            let c0: i64 = o[0]; let c1: i64 = o[1]; let c2: i64 = o[2]; let c3: i64 = o[3];
            if c0 == 108 && c1 == 97 && c2 == 105 && c3 == 114 { rows[b + 8] = 1; }
          }
        }
        count = count + 1;
      }
    }
  }
  return crate::packet::list_ok(rows, count, tx);
}
