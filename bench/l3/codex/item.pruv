// readTurn and itemText (codex.ts). One turn object of a thread/turns/list page becomes a RawTurn.
// The replies of a turn are folded as they are met with exactly the arithmetic of TurnCollector.answer
// (budget counter `used` saturating at 32768, whole-scalar clipping, separators) into the turn's own reply buffer.
// Invariant len(reply) <= used <= 32768. The fold is replayed into the real collector by read.pruv (one answer per
// turn, with a padding scalar when clipped).

pub struct RawTurn { prompt: [u8], reply: [u8], nreply: i64, rbytes: i64, rclipped: bool, tools: i64, has_plan: bool, plan: str, created: [u8], completed: [u8] }

fn fold_reply(inout reply: [u8], inout used: i64, inout clipped: bool, text: str) -> () ! alloc
  requires len(reply) <= used && used <= 32768 && len(text) <= 100000000
  ensures len(reply) <= used && used <= 32768
{
  if len(text) == 0 { return; }
  if used >= 32768 { return; }
  let room: i64 = 32768 - used;
  let mut sep: i64 = 0;
  if len(reply) > 0 { sep = 2; }
  if sep + len(text) <= room {
    arr_append(inout reply, "\n\n", 0, sep);
    arr_append(inout reply, text, 0, len(text));
    used = used + sep + len(text);
    return;
  }
  if sep == 2 && room < 2 {
    arr_append(inout reply, "\n\n", 0, room);
  } else {
    let cp: ref str = crate::text::clip_bytes(text, room - sep);
    arr_append(inout reply, "\n\n", 0, sep);
    arr_append(inout reply, cp, 0, len(cp));
  }
  used = 32768;
  clipped = true;
}

// itemText: item.text when a string; else the nonempty string `text` fields of the content parts joined by a blank line.
pub fn item_text(d: crate::json::JsonDocument, it: i64) -> str ! alloc
  ensures len(result) <= 120000000
{
  let none: str = "";
  let tf: i64 = crate::util::field(d, it, "text");
  if crate::access::kind(d, tf) == 4 { return crate::util::str_at(d, tf); }
  let c: i64 = crate::util::field(d, it, "content");
  if crate::access::kind(d, c) != 5 { return copy(none); }
  let ids: [i64] = crate::util::elements(d, c);
  let n: i64 = len(ids);
  let mut out: String = string_new();
  let mut first: bool = true;
  let mut total: i64 = 0;
  let mut k: i64 = 0;
  while k < n && total <= 60000000
    invariant 0 <= k && k <= n && n == len(ids) && 0 <= total && total <= 120000000 && len(out) <= total
    decreases n - k
  {
    let part: i64 = ids[k];
    k = k + 1;
    if crate::access::kind(d, part) == 6 {
      let pt: i64 = crate::util::field(d, part, "text");
      if crate::access::kind(d, pt) == 4 {
        let x: str = crate::util::str_at(d, pt);
        if len(x) > 0 {
          if !first { out = string_push_str(move out, "\n\n"); }
          out = string_push_str(move out, x);
          first = false;
          total = total + len(x) + 2;
        }
      }
    }
  }
  return string_to_str(out);
}

// 24-byte timestamp of the field `key` of turn t via isoOf, else an empty array.
fn stamp(d: crate::json::JsonDocument, t: i64, key: str) -> [u8] ! alloc
{
  let empty: [u8] = alloc(0, 0);
  let f: i64 = crate::util::field(d, t, key);
  if f < 0 { return empty; }
  let iso: crate::time::Iso = crate::time::iso_of(d, f);
  if iso.status == 0 && len(iso.text) == 24 { return copy(iso.text); }
  return empty;
}

pub fn read_turn(d: crate::json::JsonDocument, t: i64) -> RawTurn ! alloc
  ensures len(result.reply) <= 32768
{
  let ids: [i64] = crate::util::elements(d, crate::util::field(d, t, "items"));
  let n: i64 = len(ids);
  let mut prompt: [u8] = alloc(0, 0);
  let mut nreply: i64 = 0;
  let mut rbytes: i64 = 0;
  let mut reply: [u8] = alloc(0, 0);
  let mut used: i64 = 0;
  let mut clipped: bool = false;
  let mut tools: i64 = 0;
  let mut has_plan: bool = false;
  let mut plan: str = "";
  let mut k: i64 = 0;
  while k < n
    invariant 0 <= k && k <= n && n == len(ids) && 0 <= nreply && 0 <= rbytes && 0 <= tools
    invariant nreply <= k && tools <= k && rbytes <= 32768 && len(prompt) <= 300000000
    invariant len(reply) <= used && used <= 32768
    decreases n - k
  {
    let it: i64 = ids[k];
    k = k + 1;
    if crate::access::kind(d, it) == 6 {
      let ty: i64 = crate::util::field(d, it, "type");
      if crate::access::string_is(d, ty, "userMessage") == 1 {
        let x: str = item_text(d, it);
        if !crate::text::is_blank(x) && len(x) <= 290000000 - len(prompt) {
          if len(prompt) > 0 { arr_append(inout prompt, "\n\n", 0, 2); }
          arr_append(inout prompt, x, 0, len(x));
        }
      } else if crate::access::string_is(d, ty, "agentMessage") == 1 {
        // commentary is not an answer
        let mut x: str = "";
        if crate::access::string_is(d, crate::util::field(d, it, "phase"), "commentary") != 1 { x = item_text(d, it); }
        if !crate::text::is_blank(x) && len(x) <= 100000000 {
          nreply = nreply + 1;
          rbytes = rbytes + len(x);
          if rbytes > 32768 { rbytes = 32768; }
          fold_reply(inout reply, inout used, inout clipped, x);
        }
      } else if crate::access::string_is(d, ty, "plan") == 1 {
        // a plan item is not a tool; the last nonblank text of the turn wins
        let tf: i64 = crate::util::field(d, it, "text");
        if crate::access::kind(d, tf) == 4 {
          let x: str = crate::util::str_at(d, tf);
          if !crate::text::is_blank(x) { has_plan = true; plan = move x; }
        }
      } else if crate::access::string_is(d, ty, "reasoning") != 1 {
        tools = tools + 1;
      }
    }
  }
  return RawTurn { prompt: move prompt, reply: move reply, nreply: nreply, rbytes: rbytes, rclipped: clipped, tools: tools, has_plan: has_plan, plan: move plan, created: stamp(d, t, "startedAt"), completed: stamp(d, t, "completedAt") };
}
