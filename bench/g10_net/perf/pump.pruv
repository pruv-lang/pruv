// G10 net Q perf: read a loopback transfer to EOF in chunks of at most 4096 bytes.
// mode 0 (per byte): every byte of each chunk goes through net_byte into the running checksum
//   sum = (sum * 31 + b) % 1000000007; the result is that checksum.
// mode 1 (bulk copy): each chunk is copied with net_bytes and only its first byte, last byte and length are used;
//   the result is total_bytes * 1000 + the first byte of the first chunk.
// A lost or duplicated byte changes the checksum or the total. Errors: -1 connect, -2 read or close error,
// -3 read budget exhausted.
fn fail(take s: Socket, code: i64) -> i64 ! net, alloc
  requires -3 <= code && code <= -1
  ensures result == code
{
  let r: Result<i64> = net_close(move s);
  return code;
}

fn chunk_sum(s: Socket, sum0: i64) -> i64
  requires 0 <= sum0 && sum0 < 1000000007
  ensures 0 <= result && result < 1000000007
{
  let n: i64 = net_size(s);
  let mut sum: i64 = sum0;
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n
    invariant 0 <= sum && sum < 1000000007
    decreases n - i
  {
    let b: i64 = net_byte(s, i);
    sum = (sum * 31 + b) % 1000000007;
    i = i + 1;
  }
  return sum;
}

fn chunk_copy(s: Socket, acc: i64) -> i64 ! alloc
  requires 0 <= acc && acc < 1000000007
  requires net_size(s) <= 4096
  ensures 0 <= result && result < 1000000007
{
  let c: [u8] = net_bytes(s);
  if len(c) == 0 { return acc; }
  return (acc + c[0] + c[len(c) - 1] + len(c)) % 1000000007;
}

pub fn pump(host: str, port: i64, mode: i64) -> i64 ! net, alloc
  requires 1 <= port && port <= 65535
  requires 0 <= mode && mode <= 1
  ensures result >= -3
{
  let mut s: Socket = net_connect(host, port);
  if !net_ok(s) { return fail(move s, -1); }
  s = net_set_timeout(move s, 20000);
  if !net_ok(s) { return fail(move s, -2); }
  let mut total: i64 = 0;
  let mut sum: i64 = 0;
  let mut acc: i64 = 0;
  let mut first: i64 = 0;
  let mut used: i64 = 0;
  let mut done: bool = false;
  while !done && used < 1000000
    invariant net_ok(s)
    invariant 0 <= used && used <= 1000000
    invariant 0 <= total && total <= 4096 * used
    invariant 0 <= sum && sum < 1000000007
    invariant 0 <= acc && acc < 1000000007
    invariant 0 <= first && first <= 255
    decreases 1000000 - used
  {
    used = used + 1;
    s = net_read(move s, 4096);
    if !net_ok(s) { return fail(move s, -2); }
    let k: i64 = net_size(s);
    if k > 4096 { return fail(move s, -2); }
    if k == 0 {
      done = true;
    } else {
      if total == 0 { first = net_byte(s, 0); }
      if mode == 0 {
        sum = chunk_sum(s, sum);
      } else {
        acc = chunk_copy(s, acc);
      }
      total = total + k;
    }
  }
  if !done { return fail(move s, -3); }
  let r: Result<i64> = net_close(move s);
  match r {
    Ok(v) => {
      if mode == 0 { return sum; }
      return total * 1000 + first;
    }
    Err(code) => { return -2; }
  }
}
