// P2: [u16] buffers as UTF-16 code-unit keys. Compare is lexicographic code-unit order (hand Rust `&[u16]` Ord);
// no UTF-16 validation or normalisation, so lone surrogates are plain values.
fn cmp_units(a: ref [u16], b: ref [u16]) -> i64
  ensures result == -1 || result == 0 || result == 1
{
  let mut i: i64 = 0;
  while i < len(a) && i < len(b)
    invariant 0 <= i && i <= len(a) && i <= len(b)
    decreases len(a) - i
  {
    if a[i] < b[i] {
      return -1;
    }
    if a[i] > b[i] {
      return 1;
    }
    i = i + 1;
  }
  if len(a) < len(b) {
    return -1;
  }
  if len(a) > len(b) {
    return 1;
  }
  return 0;
}

// Polynomial hash of the code units modulo a prime; equal keys hash equal.
fn hash_units(a: ref [u16]) -> i64
  ensures 0 <= result && result < 1000000007
{
  let mut h: i64 = 0;
  let mut i: i64 = 0;
  while i < len(a)
    invariant 0 <= i && i <= len(a)
    invariant 0 <= h && h < 1000000007
    decreases len(a) - i
  {
    h = (h * 65537 + a[i]) % 1000000007;
    i = i + 1;
  }
  return h;
}

fn pair(x: i64, y: i64) -> [u16] ! alloc
  requires 0 <= x && x <= 65535
  requires 0 <= y && y <= 65535
  ensures len(result) == 2
{
  let mut k: [u16] = alloc(2, x);
  k[1] = y;
  return k;
}

fn one(x: i64) -> [u16] ! alloc
  requires 0 <= x && x <= 65535
  ensures len(result) == 1
{
  let k: [u16] = alloc(1, x);
  return k;
}

// Encodes the compare results of fixed key pairs as base-3 digits (0 = less, 1 = equal, 2 = greater).
fn order_code() -> i64 ! alloc {
  let empty: [u16] = alloc(0, 0);
  let hi: [u16] = one(55296);
  let lo: [u16] = one(57343);
  let good: [u16] = pair(55357, 56832);
  let rev: [u16] = pair(56832, 55357);
  let top: [u16] = one(65535);
  let mut code: i64 = 0;
  code = code * 3 + cmp_units(empty, hi) + 1;
  code = code * 3 + cmp_units(hi, lo) + 1;
  code = code * 3 + cmp_units(good, rev) + 1;
  code = code * 3 + cmp_units(rev, good) + 1;
  code = code * 3 + cmp_units(hi, good) + 1;
  code = code * 3 + cmp_units(top, rev) + 1;
  code = code * 3 + cmp_units(good, good) + 1;
  return code;
}

fn run() -> i64 ! alloc {
  let a: [u16] = pair(55357, 56832);
  let b: [u16] = pair(55357, 56832);
  if hash_units(a) != hash_units(b) {
    return -1;
  }
  return order_code();
}
