// P06 contract expansion accept: a predicate calls another user predicate
pub fn small(x: i64) -> bool { return x >= 0 && x <= 1000; }
pub fn fits(x: i64, y: i64) -> bool { return x >= 0 && x <= 1000 && y >= 0 && y <= 1000 && small(x + y - 500); }

pub fn area(x: i64, y: i64) -> i64
  requires fits(x, y)
  ensures small(result / 1000) && result >= 0
{ return x * y; }
