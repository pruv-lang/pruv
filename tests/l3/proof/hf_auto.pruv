// P07 automatic ensures: a code call of an expandable function knows result == the expanded body, so callers need
// no hand-written ensures on small helpers.
// straight-line i64 helpers (an expandable i64 function has no branches and no requires)
fn mid(a: [i64]) -> i64
{ return len(a) / 2; }

fn last(a: [i64]) -> i64
{
  let n: i64 = len(a);
  return n - 1;
}

fn in_range(a: [i64], i: i64) -> bool
{ return 0 <= i && i < len(a); }

// mid(a) is in 0..len(a) without an ensures on mid
pub fn at(a: [i64]) -> i64
  requires len(a) > 0
{ return a[mid(a)]; }

// a bool predicate called in code guards the read
pub fn get(a: [i64], i: i64) -> i64
{
  if in_range(a, i) { return a[i]; }
  return -1;
}

// the value of an i64 helper is known exactly: last(a) == len(a) - 1
pub fn tail(a: [i64]) -> i64
  requires len(a) > 0
{ return a[last(a)]; }

// bit builtins stay allowed inside a bool predicate; its code call still guards the read
fn even_slot(a: [i64], i: i64) -> bool
{ return 0 <= i && i < len(a) && band(i, 1) == 0; }

pub fn even_at(a: [i64], i: i64) -> i64
{
  if even_slot(a, i) { return a[i]; }
  return 0;
}
