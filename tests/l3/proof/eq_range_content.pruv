// P16: the verifier knows eq_range(a, i, b, j, n) == (forall k in 0..n: a[i+k] == b[j+k]) on the call's path.
// eq_range is code only, so every use below binds the result with `let` before it is asserted.

// content, i64: both directions of the equivalence
pub fn same(a: [i64], i: i64, b: [i64], j: i64, n: i64) -> bool
  requires 0 <= i && 0 <= j && 0 <= n && i + n <= len(a) && j + n <= len(b)
  ensures result ==> (forall k in 0..n: a[i + k] == b[j + k])
  ensures (forall k in 0..n: a[i + k] == b[j + k]) ==> result
{ return eq_range(a, i, b, j, n); }

// content, u8
pub fn same8(a: [u8], i: i64, b: [u8], j: i64, n: i64) -> bool
  requires 0 <= i && 0 <= j && 0 <= n && i + n <= len(a) && j + n <= len(b)
  ensures result ==> (forall k in 0..n: a[i + k] == b[j + k])
  ensures (forall k in 0..n: a[i + k] == b[j + k]) ==> result
{ return eq_range(a, i, b, j, n); }

// a point fact inside the true branch
pub fn point(a: [i64], b: [i64], n: i64) -> i64
  requires 3 <= n && n <= len(a) && n <= len(b)
{
  if eq_range(a, 0, b, 0, n) { assert a[2] == b[2]; }
  return 0;
}

// the empty range is always equal
pub fn empty(a: [i64], i: i64, b: [i64], j: i64) -> bool
  requires 0 <= i && i <= len(a) && 0 <= j && j <= len(b)
  ensures result
{ return eq_range(a, i, b, j, 0); }

// the same array at the same start
pub fn alias(a: [i64], i: i64, n: i64) -> bool
  requires 0 <= i && 0 <= n && i + n <= len(a)
  ensures result
{ return eq_range(a, i, a, i, n); }

// overlapping ranges of one array with a shifted start, constant content
pub fn const_shift() -> bool ! alloc
  ensures result
{
  let mut c: [i64] = alloc(8, 5);
  let ok: bool = eq_range(c, 0, c, 1, 7);
  assert ok;
  return ok;
}

// frame: a store outside the compared range does not change the answer
pub fn frame(a: [i64], b: [i64]) -> bool ! alloc
  requires 6 <= len(a) && 2 <= len(b)
  ensures result
{
  let mut a2: [i64] = copy(a);
  let r1: bool = eq_range(a2, 0, b, 0, 2);
  a2[5] = 9;
  let r2: bool = eq_range(a2, 0, b, 0, 2);
  assert r1 == r2;
  return r1 == r2;
}

// frame inside the range: a store that makes a2[0] differ from b[0] makes the answer false
pub fn frame_in(a: [i64], b: [i64]) -> bool ! alloc
  requires 2 <= len(a) && 2 <= len(b)
  requires b[0] <= 1000000
  ensures !result
{
  let mut a2: [i64] = copy(a);
  a2[0] = b[0] + 1;
  let r: bool = eq_range(a2, 0, b, 0, 2);
  assert !r;
  return r;
}

// one differing element makes the answer false
pub fn differ(a: [i64], b: [i64], n: i64) -> bool
  requires 2 <= n && n <= len(a) && n <= len(b)
  requires a[1] != b[1]
  ensures !result
{ return eq_range(a, 0, b, 0, n); }

// a loop that relies on it: count the positions where the two arrays agree
pub fn agree(a: [i64], b: [i64], n: i64) -> i64
  requires 0 <= n && n <= len(a) && n <= len(b)
  ensures 0 <= result && result <= n
{
  let mut c: i64 = 0;
  let mut m: i64 = 0;
  while m < n
    invariant 0 <= m && m <= n && 0 <= c && c <= m
    decreases n - m
  {
    let e: bool = eq_range(a, m, b, m, 1);
    if e {
      assert a[m] == b[m];
      c = c + 1;
    }
    m = m + 1;
  }
  return c;
}
