// Intended dead points for tests/vacuity/run.py (contradiction cases): an inserted `assert false` verifies here.
fn no_model(x: i64) -> i64
  requires x > 0 && x < 0
{
  return x;
}

fn excluded(x: i64) -> i64
  requires 0 <= x
{
  if x < 0 {
    return 0;
  }
  return x;
}

fn both_return(x: i64) -> i64
{
  if x > 0 { return x; } else { return 0; }
  return x;
}
