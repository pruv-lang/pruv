// G3 TIDY 14(b) reject twin of p24: choose a2 in the true branch; must fail verify/ensures
// The remaining declarations are copied from the proof fixture.
struct Pair<A, B> {
  first: A,
  second: B
}

fn pick_by<A, B>(flag: bool, a: A, a2: A, b: B) -> Pair<A, B>
  ensures flag ==> result.first == a
  ensures !flag ==> result.first == a2
  ensures result.second == b
{
  let mut chosen: A = a2;
  if flag {
    chosen = a2;
  }
  return Pair::<A, B> { first: chosen, second: b };
}
