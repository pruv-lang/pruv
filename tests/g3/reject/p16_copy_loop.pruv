// G3 TIDY 14(b) reject twin of p16: copy the first element at every iteration; must fail verify/invariant_preserved
// The remaining declarations are copied from the proof fixture.
fn copy_loop<T: Element>(a: [T]) -> [T] ! alloc
  ensures len(result) == len(a)
  ensures forall k in 0..len(a): result[k] == a[k]
{
  let mut out: [T] = copy(a);
  let mut i: i64 = 0;
  while i < len(a)
    invariant 0 <= i && i <= len(a)
    invariant len(out) == len(a)
    invariant forall j in 0..len(a): out[j] == a[j]
    decreases len(a) - i
  {
    out[i] = a[0];
    i = i + 1;
  }
  return out;
}
