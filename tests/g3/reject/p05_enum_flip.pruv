// G3 TIDY 14(b) reject twin of p05: require a Right result unconditionally; must fail verify/ensures
enum Choice<A, B> {
  Left(value: A),
  Right(value: B)
}

fn flip<A, B>(c: Choice<A, B>) -> Choice<B, A>
  ensures is_variant(result, Choice::Right)
{
  match c {
    Choice::Left(x) => { return Choice::<B, A>::Right(x); }
    Choice::Right(y) => { return Choice::<B, A>::Left(y); }
  }
}

fn keep<A, B>(c: Choice<A, B>) -> Choice<A, B>
  ensures result == c
{
  return c;
}
