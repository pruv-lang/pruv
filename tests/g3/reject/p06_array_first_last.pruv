// G3 TIDY 14(b) reject twin of p06: return the first element from last; must fail verify/ensures
fn first<T: Element>(a: [T]) -> T
  requires len(a) > 0
  ensures result == a[0]
{
  return a[0];
}

fn last<T: Element>(a: [T]) -> T
  requires len(a) > 0
  ensures result == a[len(a) - 1]
{
  return a[0];
}
