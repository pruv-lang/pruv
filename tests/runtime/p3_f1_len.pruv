// P3-F1: len(b) >= len(a) does not make the lengths equal, so the fused guard len(b) == len(a) fails and the slow path
// runs (the forall over b reads all of b, past len(a)); the result and the violation message are the usual ones.

fn add(a: [i64], b: [i64]) -> [i64] ! alloc
  requires len(b) >= len(a)
  requires forall t in 0..len(a): 0 <= a[t] && a[t] <= 1000
  requires forall t in 0..len(b): 0 <= b[t] && b[t] <= 1000
{
  let mut c: [i64] = alloc(len(a), 0);
  let mut i: i64 = 0;
  while i < len(a)
    invariant 0 <= i && i <= len(a)
    invariant len(c) == len(a)
    decreases len(a) - i
  {
    c[i] = a[i] + b[i];
    i = i + 1;
  }
  return c;
}
