// P3-S1: small non-escaping local arrays with a constant length live on the stack.

fn total4(a: [i64 | -100..=100]) -> i64
  requires len(a) == 4
{ return a[0] + a[1] + a[2] + a[3]; }

fn bump(inout a: [i64]) -> ()
  requires len(a) == 4 && a[1] == 3 && a[2] == 3 && a[3] == 3
  ensures len(a) == 4 && a[0] == 5 && a[1] == 3 && a[2] == 3 && a[3] == 3
{ a[0] = 5; }

// a declaration inside the loop is refilled on every iteration; `return` leaves the scope holding stack arrays
fn scan(limit: i64) -> i64 ! alloc
  requires 0 <= limit && limit <= 5
{
  let mut seen: [bool] = alloc(5, false);
  let mut i: i64 = 0;
  while i < 5
    invariant len(seen) == 5
    invariant 0 <= i && i <= 5
    decreases 5 - i
  {
    let mut cur: [i64 | -9..=9] = alloc(2, -9);
    if cur[0] != -9 { return 77; }
    if seen[i] { return 55; }
    cur[0] = 4;
    cur[1] = i;
    if i == limit { return cur[0] + cur[1]; }
    seen[i] = true;
    i = i + 1;
  }
  return 100;
}

// heap: returned
fn ret_heap() -> [i64] ! alloc
  ensures len(result) == 13
{
  let mut r: [i64] = alloc(13, 4);
  r[0] = 9;
  return r;
}

// heap: reassigned
fn reassigned() -> i64 ! alloc {
  let mut x: [i64] = alloc(14, 1);
  x = alloc(2, 3);
  return x[1];
}

// heap: over 16384 bytes (3000 * 8 and 16385 * 1); exactly 16384 bytes stays on the stack
fn big() -> i64 ! alloc {
  let mut g: [i64] = alloc(3000, 2);
  g[2999] = 8;
  let h: [u8] = alloc(16385, 1);
  let k: [u8] = alloc(16384, 3);
  return h[16384] + k[0];
}

// eight arrays of 8000 bytes fill 64000 of the 65536-byte total; the ninth stays on the heap, a later small one fits
fn many() -> i64 ! alloc {
  let a1: [i64] = alloc(1000, 1);
  let a2: [i64] = alloc(1000, 1);
  let a3: [i64] = alloc(1000, 1);
  let a4: [i64] = alloc(1000, 1);
  let a5: [i64] = alloc(1000, 1);
  let a6: [i64] = alloc(1000, 1);
  let a7: [i64] = alloc(1000, 1);
  let a8: [i64] = alloc(1000, 1);
  let a9: [i64] = alloc(1001, 1);
  let a10: [u8] = alloc(100, 5);
  return a10[0];
}

// heap: recursive function
fn rec(n: i64) -> i64 ! alloc
  requires 0 <= n && n <= 3
  decreases n
{
  let t: [i64] = alloc(15, 1);
  if n == 0 { return t[0]; }
  return rec(n - 1);
}

// heap: copy source (and the copy itself is not an alloc declaration)
fn copied() -> i64 ! alloc {
  let src: [i64] = alloc(16, 6);
  let dup: [i64] = copy(src);
  return dup[0];
}

fn run() -> () ! alloc, io {
  let mut a: [i64 | -100..=100] = alloc(4, -7);
  a[1] = 100;
  print(total4(a));
  let mut b: [i64] = alloc(4, 3);
  bump(inout b);
  print(b[0]);
  print(b[3]);
  print(b[0] + b[1] + b[2] + b[3]);
  let mut u: [u8] = alloc(4, 200);
  u[2] = 7;
  print(u[0] + u[2]);
  let mut flags: [bool] = alloc(3, true);
  flags[1] = false;
  if flags[0] { print(1); }
  if flags[1] { print(2); }
  print(len(flags));
  let mut n: [i64] = alloc(6, -5);
  print(n[0]);
  n[5] = 7;
  print(n[5]);
  let neg: [i64 | -128..=-1] = alloc(3, -1);
  print(neg[2]);
  print(scan(3));
  print(scan(0));
  print(scan(5));
  let r: [i64] = ret_heap();
  print(r[0]);
  print(len(r));
  print(reassigned());
  print(big());
  print(many());
  print(rec(3));
  print(copied());
}
