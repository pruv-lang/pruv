struct S { n: i64, a: [u8], w: [i64] }
struct D { sub: S, tag: i64 }
struct Counter { n: i64 }

fn write_byte(inout a: [u8], v: i64) -> ()
  requires len(a) == 1 && 0 <= v && v <= 255
  ensures a[0] == v
{
  a[0] = v;
}

fn bump(inout s: S, v: i64) -> () ! alloc
  requires len(s.a) == 1 && 0 <= v && v <= 255 && 0 <= s.n && s.n <= 1 && 1 <= len(s.w) && len(s.w) <= 5
  ensures len(s.a) == 1 && s.a[0] == v && 1 <= s.n && s.n <= 2 && 5 <= len(s.w) && len(s.w) <= 9
{
  write_byte(inout s.a, v);
  s.n = s.n + 1;
  s.w = resize(s.w, len(s.w) + 4, 9);
}

fn forward(inout s: S, v: i64) -> () ! alloc
  requires len(s.a) == 1 && 0 <= v && v <= 255 && s.n == 0 && len(s.w) == 1
  ensures len(s.a) == 1 && s.a[0] == v && 1 <= s.n && s.n <= 2 && 5 <= len(s.w) && len(s.w) <= 9
{
  bump(inout s, v);
}

fn advance(inout c: Counter) -> ()
  requires c.n == 0
  ensures c.n == 1
{
  c.n = c.n + 1;
}

fn run() -> () ! io, alloc {
  let a: [u8] = alloc(1, 0);
  let mut s: S = S { n: 0, a: move a, w: alloc(1, 3) };
  forward(inout s, 7);
  print(s.n);
  print(s.a[0]);
  print(len(s.w));
  print(s.w[4]);

  let b: [u8] = alloc(1, 0);
  let mut d: D = D { sub: S { n: 1, a: move b, w: alloc(5, 3) }, tag: 42 };
  bump(inout d.sub, 8);
  print(d.sub.n);
  print(d.sub.a[0]);
  print(len(d.sub.w));
  print(d.sub.w[0]);
  print(d.sub.w[4]);
  print(d.tag);

  let mut c: Counter = Counter { n: 0 };
  advance(inout c);
  print(c.n);
}
