// P7-1 B: slice patterns on fixed-length arrays (a local, a u8 parameter and a struct field; `..` without a name)
struct P { k: i64, d: [bool; 3] }

fn head(a: [u8; 4]) -> i64
  ensures 0 <= result && result <= 510
{
  match a {
    [x, y, ..] => { return i64(x) + i64(y); }
  }
}

fn run(i: i64) -> i64
  requires 0 <= i && i < 3
{
  let mut a: [i64; 3] = [1, 2, 3];
  a[i] = 9;
  let mut s: i64 = 0;
  match a {
    [x, y, z] => { s = x * 100 + y * 10 + z; }
  }
  let p: P = P { k: 0, d: [true, false, i == 2] };
  let mut c: i64 = 0;
  match p.d {
    [u, w, ..] => { if u { c = c + 1; } if w { c = c + 2; } }
  }
  let b: [u8; 4] = [7, 0, 0, 200];
  return s * 10000 + head(b) * 10 + c;
}
