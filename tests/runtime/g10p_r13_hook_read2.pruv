// G10 proc A2 gate 10 (fault path, spec "proc_hook": "read2"): the stderr reader reports a read error. stdout reads
// before it are fine; the failing stderr read publishes error 3 and also empties the stdout buffer that was delivered
// earlier (an update failure empties both public buffers and clears both EOFs). The earlier [u8] copy is unaffected.
fn read_stderr_fail(child: str) -> i64 ! proc, alloc {
  let mut args: ProcessArgs = proc_args_new();
  args = proc_args_push(move args, "hold");
  let mut p: Process = proc_spawn(child, args, "");
  if !proc_ok(p) {
    let r0: Result<i64> = proc_wait(move p);
    return 100;
  }
  p = proc_read(move p, 1, 64);
  if !proc_ok(p) {
    let r1: Result<i64> = proc_kill(move p);
    return 300;
  }
  let announced: bool = proc_size(p, 1) > 0;
  let copy: [u8] = proc_bytes(p, 1);
  let copy_len: i64 = len(copy);
  p = proc_read(move p, 2, 64);
  let alive: bool = proc_ok(p);
  let e: i64 = proc_error(p);
  let open: bool = proc_stdin_open(p);
  let clean: bool = proc_size(p, 1) == 0 && proc_size(p, 2) == 0 && !proc_eof(p, 1) && !proc_eof(p, 2);
  let r: Result<i64> = proc_kill(move p);
  if !announced { return 1; }
  if copy_len != 6 { return 2; }
  if alive { return 3; }
  if e != 3 { return 4; }
  if open || !clean { return 5; }
  match r {
    Ok(v) => { return 6; }
    Err(code) => {
      if code == 3 { return 0; }
      return 7;
    }
  }
}

fn read_all_fail(child: str) -> i64 ! proc, alloc {
  let mut args: ProcessArgs = proc_args_new();
  args = proc_args_push(move args, "exit");
  args = proc_args_push(move args, "0");
  let mut p: Process = proc_spawn(child, args, "");
  if !proc_ok(p) {
    let r0: Result<i64> = proc_wait(move p);
    return 100;
  }
  p = proc_close_stdin(move p);
  if !proc_ok(p) {
    let r1: Result<i64> = proc_kill(move p);
    return 200;
  }
  p = proc_read_all(move p);
  let alive: bool = proc_ok(p);
  let e: i64 = proc_error(p);
  let r: Result<i64> = proc_wait(move p);
  if alive { return 1; }
  if e != 3 { return 2; }
  match r {
    Ok(v) => { return 4; }
    Err(code) => {
      if code == 3 { return 0; }
      return 5;
    }
  }
}
