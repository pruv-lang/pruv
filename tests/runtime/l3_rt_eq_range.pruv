// eq_range(a, i, b, j, n): slice equality of a[i..i+n] and b[j..j+n] on [i64] and [u8]; bounds are proof obligations.
fn same(a: [i64], i: i64, b: [i64], j: i64, n: i64) -> bool
  requires 0 <= i && 0 <= j && 0 <= n && i + n <= len(a) && j + n <= len(b)
{ return eq_range(a, i, b, j, n); }
fn same8(a: [u8], i: i64, b: [u8], j: i64, n: i64) -> bool
  requires 0 <= i && 0 <= j && 0 <= n && i + n <= len(a) && j + n <= len(b)
{ return eq_range(a, i, b, j, n); }
// a local array is passed by reference (`&a` in the generated Rust)
fn local_self(n: i64) -> bool ! alloc
  requires 2 <= n && n <= 100
{
  let mut a: [i64] = alloc(n, 4);
  a[0] = 9;
  return eq_range(a, 1, a, 0, 1);
}
fn bit(x: bool) -> i64 {
  if x { return 1; }
  return 0;
}
fn run() -> () ! io, alloc {
  let mut a: [i64] = alloc(4, 0);
  let mut c: [i64] = alloc(5, 0);
  a[0] = 1; a[1] = 2; a[2] = 3; a[3] = 4;
  c[0] = 9; c[1] = 2; c[2] = 3; c[3] = 4; c[4] = 5;
  print(bit(same(a, 1, c, 1, 3)));
  print(bit(same(a, 0, c, 0, 2)));
  print(bit(same(a, 0, c, 4, 0)));
  print(bit(same(a, 4, c, 5, 0)));
  print(bit(same(a, 3, c, 3, 1)));
  let mut s: [u8] = alloc(6, 0);
  let mut t: [u8] = alloc(3, 0);
  s[2] = 200; s[3] = 7; t[0] = 200; t[1] = 7; t[2] = 1;
  print(bit(same8(s, 2, t, 0, 2)));
  print(bit(same8(s, 2, t, 0, 3)));
  print(bit(local_self(3)));
}
