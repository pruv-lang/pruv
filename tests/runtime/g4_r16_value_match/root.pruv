mod m;

pub fn skew(w: i64, h: i64) -> i64
  requires 0 <= w && w <= 1000
  requires 0 <= h && h <= 1000
{
  let k: crate::m::Kind = crate::m::classify(w, h);
  return match k {
    crate::m::Kind::Square => 0,
    crate::m::Kind::Wide(e) => e,
    crate::m::Kind::Tall(e) => if e > 0 { 0 - e } else { 0 },
  };
}

pub fn back(w: i64, h: i64) -> crate::m::Kind
  requires 0 <= w && w <= 1000
  requires 0 <= h && h <= 1000
{
  let k: crate::m::Kind = crate::m::classify(w, h);
  return match k {
    crate::m::Kind::Square => crate::m::Kind::Wide(1),
    crate::m::Kind::Wide(e) => crate::m::Kind::Square,
    crate::m::Kind::Tall(e) => k,
  };
}

pub fn opt(w: i64, h: i64) -> i64
  requires 0 <= w && w <= 1000
  requires 0 <= h && h <= 1000
{
  return match crate::m::wrap(crate::m::classify(w, h)) {
    Some(k) => 10 + crate::m::code(k),
    None => -1,
  };
}

pub fn run() -> () ! io {
  print(skew(5, 2));
  print(skew(2, 5));
  print(skew(3, 3));
  print(crate::m::code(back(3, 3)));
  print(crate::m::code(back(5, 3)));
  print(crate::m::code(back(1, 3)));
  print(opt(1, 1));
  print(opt(4, 1));
  print(opt(1, 4));
}
