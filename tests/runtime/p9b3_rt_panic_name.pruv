// P9b-3 (R-6x-4): a contract violation of a method of a generic impl found at run time names it `Box2::new`, not
// the stem of its specialization (with --no-verify).
struct Box2<T> { v: T, n: i64 }
impl<T> Box2<T> {
  fn new(v: T, n: i64) -> Self requires n >= 0 ensures result.n == n { return Self { v: v, n: n }; }
}
fn run(k: i64) -> i64 {
  let b: Box2<bool> = Box2::<bool>::new(true, k);
  return b.n;
}
