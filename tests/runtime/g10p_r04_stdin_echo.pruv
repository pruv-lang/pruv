// G10 proc A2 gate 4: stdin echo with an explicit EOF (proc_close_stdin), empty text and empty byte writes, and two
// writes in a row; the child's stdout is exactly text ++ data and nothing is lost.
fn abort_with(take p: Process, base: i64) -> i64 ! proc, alloc
  requires base >= 0 && base <= 1000000
{
  let e: i64 = proc_error(p);
  let r: Result<i64> = proc_wait(move p);
  return base + e;
}

fn bytes_eq(p: Process, stream: i64, expected: [u8]) -> bool ! alloc
  requires stream == 1 || stream == 2
{
  let got: [u8] = proc_bytes(p, stream);
  if len(got) != len(expected) { return false; }
  let mut i: i64 = 0;
  while i < len(got)
    invariant 0 <= i && i <= len(got)
    decreases len(got) - i
  {
    if got[i] != expected[i] { return false; }
    i = i + 1;
  }
  return true;
}

fn echo_roundtrip(child: str, text: str, data: [u8], expected: [u8]) -> i64 ! proc, alloc {
  let mut args: ProcessArgs = proc_args_new();
  args = proc_args_push(move args, "echo");
  let mut p: Process = proc_spawn(child, args, "");
  if !proc_ok(p) { return abort_with(move p, 100); }
  p = proc_write_str(move p, "");
  if !proc_ok(p) { return abort_with(move p, 110); }
  p = proc_write_str(move p, text);
  if !proc_ok(p) { return abort_with(move p, 120); }
  p = proc_write_bytes(move p, data);
  if !proc_ok(p) { return abort_with(move p, 130); }
  p = proc_close_stdin(move p);
  if !proc_ok(p) { return abort_with(move p, 200); }
  if proc_stdin_open(p) { return abort_with(move p, 210); }
  p = proc_read_all(move p);
  if !proc_ok(p) { return abort_with(move p, 300); }
  let same: bool = bytes_eq(p, 1, expected);
  let quiet: bool = proc_size(p, 2) == 0 && proc_eof(p, 1) && proc_eof(p, 2);
  let r: Result<i64> = proc_wait(move p);
  if !same { return 1; }
  if !quiet { return 2; }
  match r {
    Ok(v) => { return v; }
    Err(code) => { return 400 + code; }
  }
}

fn empty_session(child: str) -> i64 ! proc, alloc {
  let mut args: ProcessArgs = proc_args_new();
  args = proc_args_push(move args, "echo");
  let mut p: Process = proc_spawn(child, args, "");
  if !proc_ok(p) { return abort_with(move p, 100); }
  p = proc_close_stdin(move p);
  if !proc_ok(p) { return abort_with(move p, 200); }
  p = proc_read_all(move p);
  if !proc_ok(p) { return abort_with(move p, 300); }
  let empty: bool = proc_size(p, 1) == 0 && proc_size(p, 2) == 0;
  let r: Result<i64> = proc_wait(move p);
  if !empty { return 1; }
  match r {
    Ok(v) => { return v; }
    Err(code) => { return 400 + code; }
  }
}
