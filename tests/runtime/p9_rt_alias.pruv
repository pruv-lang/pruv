// P9: transparent type aliases (generic alias over Result, a fixed-array alias, an alias chain)
type Code = i64;
type Res<T> = Result<T, Code>;
type Row = [i64; 3];
type Pair = (i64, bool);
type Big = Wide;
type Wide = i64;

fn parse(x: Code) -> Res<i64>
  requires -1000 < x && x < 1000
  ensures result == Ok(x * 2) || result == Err(x)
{
  if x < 0 { return Err(x); }
  return Ok(x * 2);
}

fn row_sum(r: Row) -> Big
  requires r[0] < 1000 && r[0] > -1000 && r[1] < 1000 && r[1] > -1000 && r[2] < 1000 && r[2] > -1000
  ensures result == r[0] + r[1] + r[2]
{
  return r[0] + r[1] + r[2];
}

fn run(i: i64) -> i64
  requires -10 < i && i < 10
{
  let r: Row = [i, i + 1, i + 2];
  let p: Pair = (i, i > 0);
  let s: Big = row_sum(r);
  match parse(p.0) {
    Ok(v) => { return v + s; }
    Err(e) => { return e - 100; }
  }
}
