// LG13: `?` inside an expression (return value, call argument, if condition, operand, several per statement, nested)
fn half(x: i64) -> Result<i64>
  requires 0 <= x && x <= 1000000
  ensures is_ok(result) ==> ok_val(result) * 2 == x
  ensures !is_ok(result) ==> err_val(result) == x
{
  if x % 2 == 0 {
    return Ok(x / 2);
  }
  return Err(x);
}

fn check_pos(x: i64) -> Result<bool>
  requires 0 <= x && x <= 1000000
  ensures !is_ok(result) ==> err_val(result) == 0
{
  if x > 0 {
    return Ok::<bool>(x > 10);
  }
  return Err::<bool>(0);
}

fn twice(x: i64) -> i64
  requires 0 <= x && x <= 1000000
{
  return x * 2;
}

fn sink(x: i64) -> () {
}

fn plus_one(x: i64) -> Result<i64>
  requires 0 <= x && x <= 1000000
  ensures is_ok(result) ==> ok_val(result) * 2 == x + 2
{
  return Ok(half(x)? + 1);
}

fn as_arg(x: i64) -> Result<i64>
  requires 0 <= x && x <= 1000000
{
  sink(half(x)?);
  let t: i64 = twice(half(x)?);
  return Ok(t);
}

fn sum_halves(a: i64, b: i64) -> Result<i64>
  requires 0 <= a && a <= 1000000 && 0 <= b && b <= 1000000
  ensures !is_ok(result) ==> err_val(result) == a || err_val(result) == b
{
  let s: i64 = a + (half(a)? + half(b)?);
  return Ok(s);
}

fn quarter(x: i64) -> Result<i64>
  requires 0 <= x && x <= 1000000
{
  return half(half(x)?);
}

fn pick(x: i64) -> Result<i64>
  requires 0 <= x && x <= 1000000
{
  if check_pos(x)? && x < 100 {
    return Ok(1);
  }
  let mut y: i64 = 10;
  y = y + half(x)?;
  return Ok(y);
}

fn need_pos(x: i64) -> Result<i64, String> ! alloc
  ensures is_ok(result) ==> ok_val(result) == x && x > 0
{
  if x > 0 {
    return Ok::<i64, String>(x);
  }
  return Err::<i64, String>(string_from("not positive"));
}

fn sum_pos(a: i64, b: i64) -> Result<i64, String> ! alloc
  requires a <= 1000 && b <= 1000
{
  return Ok::<i64, String>(need_pos(a)? + need_pos(b)?);
}

fn show(r: Result<i64>) -> i64 {
  match r {
    Ok(v) => { return v; }
    Err(e) => { return 0 - 1 - e; }
  }
}

fn run(k: i64, x: i64) -> i64
  requires 0 <= x && x <= 1000
{
  if k == 0 { return show(plus_one(x)); }
  if k == 1 { return show(as_arg(x)); }
  if k == 2 { return show(sum_halves(x, x + 2)); }
  if k == 3 { return show(sum_halves(x, 3)); }
  if k == 4 { return show(quarter(x)); }
  return show(pick(x));
}

fn run_pos(a: i64, b: i64) -> i64 ! alloc
  requires a <= 1000 && b <= 1000
{
  let r: Result<i64, String> = sum_pos(a, b);
  match r {
    Ok(v) => { return v; }
    Err(e) => { return 0 - len(e); }
  }
}
