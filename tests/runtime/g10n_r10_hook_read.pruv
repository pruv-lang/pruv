// G10 net A2 gates 8 and 9 (fault path, spec "net_hook": "read"): a failing read, as a connection reset or a failed read in
// the middle of a stream is, publishes error 3 for net_read and for net_read_all: the write side is closed, the public
// buffer is empty and EOF is false. The socket still has to be closed and net_close returns Err(3). An OS reset is not
// portable enough to provoke here, so the test hook stands in for it.
fn read_fault(host: str, port: i64) -> i64 ! net, alloc
  requires 1 <= port && port <= 65535
{
  let mut s: Socket = net_connect(host, port);
  if !net_ok(s) {
    let r0: Result<i64> = net_close(move s);
    return 100;
  }
  s = net_read(move s, 64);
  let alive: bool = net_ok(s);
  let e: i64 = net_error(s);
  let open: bool = net_write_open(s);
  let clean: bool = net_size(s) == 0 && !net_eof(s);
  let r: Result<i64> = net_close(move s);
  if alive { return 1; }
  if e != 3 { return 2; }
  if open || !clean { return 3; }
  match r {
    Ok(v) => { return 4; }
    Err(code) => {
      if code == 3 { return 0; }
      return 5;
    }
  }
}

fn read_all_fault(host: str, port: i64) -> i64 ! net, alloc
  requires 1 <= port && port <= 65535
{
  let mut s: Socket = net_connect(host, port);
  if !net_ok(s) {
    let r0: Result<i64> = net_close(move s);
    return 100;
  }
  s = net_shutdown_write(move s);
  if !net_ok(s) {
    let r1: Result<i64> = net_close(move s);
    return 110;
  }
  s = net_read_all(move s);
  let alive: bool = net_ok(s);
  let e: i64 = net_error(s);
  let open: bool = net_write_open(s);
  let clean: bool = net_size(s) == 0 && !net_eof(s);
  let r: Result<i64> = net_close(move s);
  if alive { return 1; }
  if e != 3 { return 2; }
  if open || !clean { return 3; }
  match r {
    Ok(v) => { return 4; }
    Err(code) => {
      if code == 3 { return 0; }
      return 5;
    }
  }
}
