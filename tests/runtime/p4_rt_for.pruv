// P4 runtime: range and slice for loops (u32 range, [u8]/[u16]/[bool]/ref/field slices, empty and one-element
// ranges, a bound changed in the body, nested loops, early return); verified and unverified
struct Bag { items: [i64], n: u32 }

fn wsum(a: u32, b: u32) -> u64
  requires a <= b && b <= 1000
  ensures result <= 1000000
{
  let mut s: u64 = 0;
  for i in a..b
    invariant s <= u64(i) * 1000
  {
    s = s + u64(i);
  }
  return s;
}

fn bytes(a: [u8]) -> i64
  requires len(a) <= 1000
  ensures 0 <= result && result <= 255000
{
  let mut s: i64 = 0;
  for x in a invariant 0 <= s && s <= index(x) * 255 { s = s + x; }
  return s;
}

fn units(a: ref [u16]) -> i64
  requires len(a) <= 1000
  ensures 0 <= result && result <= 65535000
{
  let mut s: i64 = 0;
  for x in a invariant 0 <= s && s <= index(x) * 65535 { s = s + x; }
  return s;
}

fn trues(a: [bool]) -> i64
  requires len(a) <= 1000
  ensures 0 <= result && result <= 1000
{
  let mut s: i64 = 0;
  for x in a invariant 0 <= s && s <= index(x) { if x { s = s + 1; } }
  return s;
}

fn bag(b: Bag) -> i64
  requires len(b.items) <= 100
  requires forall k in 0..len(b.items): 0 <= b.items[k] && b.items[k] <= 10
  ensures 0 <= result && result <= 1000
{
  let mut s: i64 = 0;
  for x in b.items invariant 0 <= s && s <= index(x) * 10 { s = s + x; }
  return s;
}

fn shrink(n0: i64) -> i64
  requires 0 <= n0 && n0 <= 100
  ensures result == n0
{
  let mut n: i64 = n0;
  let mut c: i64 = 0;
  for i in 0..n invariant c == i - 0 && n <= n0 && n >= n0 - i {
    n = n - 1;
    c = c + 1;
  }
  return c;
}

fn nested(n: i64) -> i64
  requires 0 <= n && n <= 100
  ensures 0 <= result && result <= 10000
{
  let mut c: i64 = 0;
  for i in 0..n invariant 0 <= c && c <= i * 100 {
    for j in 0..i invariant 0 <= c && c <= i * 100 + j { c = c + 1; }
  }
  return c;
}

fn find(a: [i64], t: i64) -> i64
  ensures result >= -1 && result < len(a)
{
  for i in 0..len(a) {
    if a[i] == t { return i; }
  }
  for i in 5..5 { return -1; }
  return -1;
}

fn run(k: i64) -> i64 ! alloc
  requires 0 <= k && k <= 10
{
  let mut b8: [u8] = alloc(k, 7);
  let mut b16: [u16] = alloc(k, 65535);
  let mut bb: [bool] = alloc(k, true);
  let mut it: [i64] = alloc(k, 3);
  let g: Bag = Bag { items: move it, n: 1 };
  let mut q: [i64] = alloc(k, 1);
  if k > 2 { q[2] = 5; }
  let r: i64 = i64(wsum(0, u32(k))) + bytes(b8) * 10 + units(b16) * 1000 + trues(bb) * 100000000;
  return r + bag(g) + (find(q, 5) + 1) * 100000000000 + shrink(k) * 100 + nested(k) * 10000;
}
