// P7-1 B: place bindings of fixed arrays: `let d = inout if c { a } else { a }`, a choice between two fixed
// fields of one struct, and passing the binding on as inout
struct Two { a: [i64; 2], b: [i64; 2] }

fn bump(inout x: [i64; 2]) -> ()
  requires x[0] < 100 && x[0] > -100
  ensures x[0] == old(x)[0] + 1 && x[1] == old(x)[1]
{
  x[0] = x[0] + 1;
}

fn run(i: i64) -> i64
  requires 0 <= i && i < 3
{
  let mut a: [i64; 2] = [1, 2];
  let d = inout if i == 1 { a } else { a };
  d[1] = 7 + i;
  bump(inout d);
  let mut s: Two = Two { a: [3, 4], b: [5, 6] };
  let e = inout if i == 2 { s.a } else { s.b };
  bump(inout e);
  e[1] = 0;
  return a[0] * 10000 + a[1] * 1000 + s.a[0] * 100 + s.b[0] * 10 + s.a[1] + s.b[1];
}
