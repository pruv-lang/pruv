// HC-2: a sortedness requires over a fixed array checks the constant length N and the element width at run time
// (LLVM used the missing length field). [1, 2], [u8] [1, 2, 200] and [i8] [-1, 1] (sign-extended) pass; [3, 1]
// stops with the requires message.

fn first(a: [i64; 2]) -> i64
  requires forall i in 0..len(a): forall j in i..len(a): a[i] <= a[j]
{
  return a[0];
}

fn small(b: [u8; 3]) -> i64
  requires forall i in 0..len(b): forall j in i..len(b): b[i] <= b[j]
{
  return len(b);
}

fn neg(c: [i8; 2]) -> i64
  requires forall i in 0..len(c): forall j in i..len(c): c[i] <= c[j]
{
  return len(c);
}

fn run() -> () ! io {
  let b: [u8; 3] = [1, 2, 200];
  print(small(b));
  let c: [i8; 2] = [-1, 1];
  print(neg(c));
  print(first([1, 2]));
  print(first([3, 1]));
}
