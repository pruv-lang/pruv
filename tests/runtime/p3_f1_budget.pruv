// P3-F1 with --contract-budget 1000: 400 elements fit the fused path (2 * 400 <= 1000); 600 do not (2 * 600 > 1000),
// so the guard falls through and the slow path exhausts the iteration budget exactly as without the fused path.

fn add(a: [i64], b: [i64]) -> [i64] ! alloc
  requires len(a) == len(b)
  requires forall t in 0..len(a): 0 <= a[t] && a[t] <= 1000
  requires forall t in 0..len(b): 0 <= b[t] && b[t] <= 1000
{
  let mut c: [i64] = alloc(len(a), 0);
  let mut i: i64 = 0;
  while i < len(a)
    invariant 0 <= i && i <= len(a)
    invariant len(c) == len(a)
    decreases len(a) - i
  {
    c[i] = a[i] + b[i];
    i = i + 1;
  }
  return c;
}
