// P7-1 B: fixed-array literals inside contracts (requires, ensures, assert, invariant, decreases, a quantifier)
fn pick(i: i64, w: i64) -> i64
  requires 0 <= i && i < 3 && [w, 7, i][i] >= 0 && len([w; 4]) == 4 && [true, false, true][i] == (i != 1)
  ensures result == [w, 7, i][i]
{
  if i == 0 { return w; }
  if i == 1 { return 7; }
  return i;
}

fn low(a: [i64]) -> i64
  requires len(a) == 3
  requires forall k in 0..len(a): a[k] >= [0; 2][1] && a[k] <= [100, 200][1]
  ensures result >= 0 && result <= [100, 200][1]
{
  return a[0];
}

fn run(i: i64) -> i64
  requires 0 <= i && i < 3
{
  let w: i64 = 40 + i;
  let p: i64 = pick(i, w);
  assert p == [w, 7, i][i];
  let mut k: i64 = 0;
  while k < 4
    invariant 0 <= k && k <= [4, i][0]
    decreases [4 - k, 0][0]
  {
    k = k + 1;
  }
  let v: [i64; 3] = [5, 6, 9];
  return p * 100 + k * 10 + low(v);
}
