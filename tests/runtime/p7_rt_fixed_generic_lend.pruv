// P7-1 B: a [T; N] is lent as a read-only [T] to a generic function too
fn count<T: Element>(a: [T]) -> i64
  ensures result == len(a)
{
  return len(a);
}

fn total(a: [i64]) -> i64
  requires len(a) == 3 && forall k in 0..3: a[k] >= 0 && a[k] <= 1000
  ensures 0 <= result && result <= 3000
{
  return a[0] + a[1] + a[2];
}

fn run(i: i64) -> i64
  requires 0 <= i && i < 3
{
  let mut a: [i64; 3] = [1, 2, 3];
  a[i] = 10;
  let b: [bool; 2] = [true, false];
  return count::<i64>(a) * 1000 + count::<bool>(b) * 100 + total(a);
}
