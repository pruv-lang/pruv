// P7-1 B: `for x in a` over a fixed-length array (a local, a parameter and a struct field)
struct P { k: i64, d: [u8; 3] }

fn sum(a: [u8; 4]) -> i64
  ensures 0 <= result && result <= 1020
{
  let mut s: i64 = 0;
  for x in a
    invariant 0 <= s && s <= index(x) * 255
  {
    s = s + i64(x);
  }
  return s;
}

fn run(i: i64) -> i64
  requires 0 <= i && i < 3
{
  let mut a: [u8; 4] = [1, 2, 3, 4];
  a[i] = 10;
  let p: P = P { k: 0, d: [5, 6, 7] };
  let mut t: i64 = 0;
  for y in p.d
    invariant 0 <= t && t <= index(y) * 255
  {
    t = t + i64(y);
  }
  let mut c: i64 = 0;
  let bs: [bool; 3] = [true, false, true];
  for b in bs
    invariant 0 <= c && c <= index(b)
  {
    if b { c = c + 1; }
  }
  return sum(a) * 1000 + t * 10 + c;
}
