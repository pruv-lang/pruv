// 4.3f-S (R-6b-4): eq_range on str operands compares the UTF-8 bytes, so hand Rust
// `a.as_bytes()[i..i + 4] == b"lair"`, `s.starts_with(p)` and byte-range compares between a str and a [u8]
// have one call each (no byte loop). A string literal operand is borrowed as its static bytes (no alloc).
fn is_lair(a: str, i: i64) -> bool
  requires 0 <= i && i + 4 <= len(a)
{
  return eq_range(a, i, "lair", 0, 4);
}

fn starts_with(s: str, p: str) -> bool {
  return len(p) <= len(s) && eq_range(s, 0, p, 0, len(p));
}

fn same_key(k: [u8], s: str) -> bool {
  return len(k) == len(s) && eq_range(k, 0, s, 0, len(k));
}

fn same_owned(n: i64) -> bool ! alloc
  requires 0 <= n && n <= 3
{
  let t: str = "héllo";
  let u: str = copy(t);
  return eq_range(t, n, u, n, len(t) - n);
}

fn bit(x: bool) -> i64 {
  if x { return 1; }
  return 0;
}

fn run() -> () ! io, alloc {
  print(bit(is_lair("lair-1", 0)));
  print(bit(is_lair("x-lair", 2)));
  print(bit(is_lair("x-lain", 2)));
  print(bit(starts_with("lair/codex", "lair/")));
  print(bit(starts_with("lai", "lair")));
  print(bit(starts_with("é", "")));
  let mut k: [u8] = alloc(2, 195);
  k[1] = 169;
  print(bit(same_key(k, "é")));
  print(bit(same_key(k, "e")));
  print(bit(same_owned(1)));
}
