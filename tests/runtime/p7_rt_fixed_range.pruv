// P7-1 B runtime: fixed-array parameters, inout finals, old() and results hold values of their element type in contracts
fn wr(inout a: [u8; 3]) -> ()
  ensures a[1] <= 255 && old(a)[2] <= 255 && a[0] == 9
{
  a[0] = 9;
}

fn mk(x: u8) -> [u8; 2]
  ensures result[0] <= 255 && result[1] == x
{
  return [1, x];
}

fn lo(c: [i8; 2]) -> i64
  ensures -128 <= c[0] && c[1] <= 127 && result == i64(c[0]) + i64(c[1])
{
  return i64(c[0]) + i64(c[1]);
}

fn run(i: i64) -> i64
  requires 0 <= i && i < 3
{
  let mut a: [u8; 3] = [0, 1, u8(i)];
  wr(inout a);
  let b: [u8; 2] = mk(u8(i + 10));
  assert b[1] <= 255 && a[2] <= 255;
  let c: [i8; 2] = [-5, i8(i)];
  return i64(a[0]) * 1000 + i64(b[1]) * 10 + lo(c);
}
