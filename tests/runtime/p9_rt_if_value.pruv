// P9a-3: `if c { a } else { b }` as a value. The expected type types every arm (a narrow literal arm takes u8, a
// later wide arm does not fix the type), only the chosen arm is evaluated (a dangerous index in the other arm is
// proved under its own guard), and an `else if` chain nests.
struct P { x: i64, y: i64 }

fn at(a: [i64], i: i64) -> i64
  requires 0 <= i
  ensures i < len(a) ==> result == a[i]
  ensures i >= len(a) ==> result == -1
{
  return if i < len(a) { a[i] } else { -1 };
}

fn sign(x: i64) -> i64
  ensures x > 0 ==> result == 1
  ensures x == 0 ==> result == 0
  ensures x < 0 ==> result == -1
{
  return if x > 0 { 1 } else if x == 0 { 0 } else { -1 };
}

fn small(b: bool, k: u8) -> u8 {
  let v: u8 = if b { 200 } else { k };
  return v;
}

fn safe_div(a: i64, b: i64) -> i64
  requires 0 <= a && a < 1000
  ensures 0 <= result && result <= 1002
{
  let q: i64 = if b > 0 { a / b } else { 0 };
  return q + (if a > 0 { 1 } else { 2 });
}

fn pick(c: bool, n: i64) -> P
  requires -1000 < n && n < 1000
  ensures c ==> result.x == n && result.y == 0
  ensures !c ==> result.y == n && result.x == 0
{
  return if c { P { x: n, y: 0 } } else { P { x: 0, y: n } };
}

fn opt(c: bool, n: i64) -> Option<i64>
  ensures c ==> result == Some(n)
  ensures !c ==> result == None
{
  return if c { Some(n) } else { None };
}

fn run(i: i64) -> i64 ! alloc
  requires 0 <= i && i < 10
{
  let a: [i64] = alloc(3, 10);
  let p: P = pick(i % 2 == 0, i);
  let mut o: i64 = 7;
  if let Some(v) = opt(i > 1, i) { o = v; }
  return at(a, i) + sign(i - 1) * 100 + (if small(i == 0, 3) == 200 { 1000 } else { 0 }) + safe_div(i, i - 1) * 10000
    + (p.x + p.y) * 100000 + o * 1000000;
}
