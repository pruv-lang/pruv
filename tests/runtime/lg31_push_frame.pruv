// LG31 (G-LG28-2..4, G-LG27-1): a local Vec<S> that a loop only pushes onto (every write is
// `w = vec_push(move w, x)`, no inout / vec_at_mut / vec_clear / vec_pop use) gets S's element clause
// `forall j in 0..len(w): C[w[j]]` as an automatic loop frame clause: proved at entry and preservation like an
// inferred invariant, dropped silently when it does not prove. No loop below states an element invariant.
struct P {
  x: i64,
  invariant x > 0 && x <= 1000
}

struct Q {
  p: P,
  y: i64,
  invariant y >= 0 && y <= 100
}

fn get(v: Vec<P>, i: i64) -> i64
  requires 0 <= i && i < len(v)
  ensures 1 <= result && result <= 1000
{
  return 1000 / vec_get::<P>(v, i).x;
}

fn fill(v: Vec<P>, n: i64, x: i64) -> Vec<P> ! alloc
  requires len(v) == 1 && 0 <= n && n <= 10 && 1 <= x && x <= 10
  ensures len(result) == 1 + n
{
  let mut w: Vec<P> = vec_push::<P>(vec_new::<P>(), vec_get::<P>(v, 0));
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && len(w) == 1 + i
    decreases n - i
  {
    w = vec_push::<P>(move w, P { x: x + i });
    i = i + 1;
  }
  return move w;
}

fn odd(n: i64) -> Vec<Q> ! alloc
  requires 0 <= n && n <= 10
  ensures len(result) == n / 2
{
  let mut w: Vec<Q> = vec_new::<Q>();
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && len(w) == i / 2
    decreases n - i
  {
    if i % 2 == 1 {
      w = vec_push::<Q>(move w, Q { p: P { x: i }, y: i });
    }
    i = i + 1;
  }
  return move w;
}

fn grid(n: i64) -> Vec<P> ! alloc
  requires 0 <= n && n <= 4
  ensures len(result) == n * n
{
  let mut w: Vec<P> = vec_new::<P>();
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && len(w) == i * n
    decreases n - i
  {
    let mut j: i64 = 0;
    while j < n
      invariant 0 <= j && j <= n && len(w) == i * n + j
      decreases n - j
    {
      w = vec_push::<P>(move w, P { x: 1 + i * 10 + j });
      j = j + 1;
    }
    i = i + 1;
  }
  return move w;
}

fn start(x: i64) -> Vec<P> ! alloc
  requires 1 <= x && x <= 1000
  ensures len(result) == 1
{
  return vec_push::<P>(vec_new::<P>(), P { x: x });
}

pub fn run(k: i64) -> i64 ! alloc
  requires 0 <= k && k <= 3
{
  let v: Vec<P> = fill(start(500), 2, k + 1);
  let q: Vec<Q> = odd(k + 4);
  let g: Vec<P> = grid(k + 1);
  let a: i64 = get(v, 0) * 1000000 + get(v, 1) * 1000 + get(v, 2);
  let b: i64 = len(q) * 100 + vec_get::<Q>(q, 0).p.x * 10 + vec_get::<Q>(q, 1).y;
  return a * 10000 + b + get(g, len(g) - 1) * 100000000000000;
}
