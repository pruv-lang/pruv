// P7-1 A runtime: assignment copies a fixed array by value (memcpy), self-assignment is a no-op, a let in a loop is fresh
fn run(i: i64) -> i64
  requires 0 <= i && i < 3
{
  let mut a: [i32; 3] = [1, 2, 3];
  let mut b: [i32; 3] = [0; 3];
  b = a;
  b[i] = -5;
  a = a;
  let mut f: [bool; 3] = [false; 3];
  f[i] = true;
  let mut s: i64 = 0;
  for k in 0..3 invariant -k <= s && s <= k {
    let mut t: [i8; 2] = [-1; 2];
    t[1] = i8(k);
    s = s + i64(t[0]) + i64(t[1]);
  }
  let mut x: i64 = i64(a[0]) * 100 + i64(a[1]) * 10 + i64(a[2]) + i64(b[i]) * 1000 + s * 10000;
  if f[i] && !f[(i + 1) % 3] { x = x + 100000; }
  return x;
}
