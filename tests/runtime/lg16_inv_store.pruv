// LG16 G-DB26-1: a Store-like struct invariant (slot offset + size <= end <= len(data)) lets the reader index the
// slot picked by a modular index with no requires on the offsets; writers re-establish it at their inout exit
struct Buf {
  data: [i64], off: [i64], end: i64,
  invariant len(off) == 16 && len(data) == 64 && 0 <= end && end <= len(data),
  invariant forall k in 0..8: (0 <= off[2 * k] && 0 <= off[2 * k + 1] && off[2 * k] + off[2 * k + 1] <= end)
}

fn new_buf() -> Buf ! alloc
  ensures result.end == 0
{
  let d: [i64] = alloc(64, 0);
  let o: [i64] = alloc(16, 0);
  return Buf { data: move d, off: move o, end: 0 };
}

// append n copies of x as the slot w (the field writes break the invariant until the exit)
fn put(inout b: Buf, w: i64, n: i64, x: i64, e: i64) -> ()
  requires b.end == e && 0 <= w && w < 8 && 0 <= n && n <= len(b.data) - b.end
  ensures b.end == e + n
{
  let start: i64 = b.end;
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && start + n <= len(b.data) && len(b.data) == 64 && len(b.off) == 16 && b.end == start
    invariant forall k in 0..8: (0 <= b.off[2 * k] && 0 <= b.off[2 * k + 1] && b.off[2 * k] + b.off[2 * k + 1] <= start)
    decreases n - i
  {
    b.data[start + i] = x;
    i = i + 1;
  }
  b.end = start + n;
  b.off[2 * w] = start;
  b.off[2 * w + 1] = n;
}

// the slot of ordinal m counted back from top, read with no offset requires
fn slot_sum(b: Buf, top: i64, m: i64) -> i64
  requires 0 <= m && m < 8 && 0 <= top && top <= 1000000
  ensures result >= 0 - 64000000000 && result <= 64000000000
{
  let w: i64 = (top + 7 - m) % 8;
  let o: i64 = b.off[2 * w];
  let n: i64 = b.off[2 * w + 1];
  let mut s: i64 = 0;
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && n <= 64 && o + n <= len(b.data) && 0 <= o && s >= 0 - 1000000000 * i && s <= 1000000000 * i
    decreases n - i
  {
    let v: i64 = b.data[o + i];
    if v >= 0 - 1000000000 && v <= 1000000000 { s = s + v; }
    i = i + 1;
  }
  return s;
}

fn run(k: i64) -> i64 ! alloc
  requires 0 <= k && k <= 3
{
  let mut b: Buf = new_buf();
  put(inout b, 0, 3, k + 1, 0);
  put(inout b, 1, 2, 10, 3);
  return slot_sum(b, 2, 1) * 100 + slot_sum(b, 2, 0);
}
