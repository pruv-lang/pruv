// LG22 (G-DB31-3): a parameter of a struct carries the invariants of its struct fields, so a callee that receives the
// field (inout c.log) gets the Events invariant from the caller's own Collected parameter, with no restated contract
struct Events {
  records: [u8], used: i64,
  invariant 0 <= used && used <= len(records) && used <= 4294967295
}

struct Collected { log: Events, count: i64 }

fn add(inout log: Events, b: i64) -> bool
  requires 0 <= b && b <= 255
{
  if log.used >= len(log.records) || log.used >= 4294967295 { return false; }
  log.records[log.used] = b;
  log.used = log.used + 1;
  return true;
}

fn collect(inout c: Collected, b: i64) -> bool
  requires 0 <= b && b <= 255
{
  let ok: bool = add(inout c.log, b);
  if ok && c.count >= 0 && c.count < 1000000 { c.count = c.count + 1; }
  return ok;
}

fn total(c: Collected) -> i64
  ensures 0 <= result && result <= 4294967295
{
  return c.log.used;
}

pub fn run(k: i64) -> i64 ! alloc
  requires 0 <= k && k <= 3
{
  let r: [u8] = alloc(k + 1, 0);
  let e: Events = Events { records: move r, used: 0 };
  let mut c: Collected = Collected { log: move e, count: 0 };
  let a: bool = collect(inout c, 7);
  let b: bool = collect(inout c, 8);
  let d: bool = collect(inout c, 9);
  return total(c) * 10 + k;
}
