// L-gaps 16 (4.4za-QE): a proc_spawn_quiet process in an event loop reaches ev_eof by reading stdout only.
// Stream 2 is the null device, so the slot counts it as observed at end of file from the start; no stream-2 read is needed.
fn quiet_eof(child: str, nerr: str, nout: str) -> i64 ! async, net, proc, alloc {
 let mut a: ProcessArgs = proc_args_new();
 a = proc_args_push(move a, "errout");
 a = proc_args_push(move a, nerr);
 a = proc_args_push(move a, nout);
 let p: Process = proc_spawn_quiet(child, a, "");
 let mut l: Loop = ev_new(2);
 l = ev_add_process(move l, move p);
 if !ev_ok(l) { let r0: Result<i64> = ev_close(move l); return 100; }
 l = ev_proc_close_stdin(move l, 0);
 let mut out: i64 = 0; let mut rounds: i64 = 10000; let mut stuck: bool = false;
 while !ev_eof(l, 0) && !stuck && rounds > 0 decreases rounds {
  l = ev_wait(move l, 20000);
  if ev_event_kind(l) == 0 { stuck = true; } else {
   l = ev_proc_read(move l, 0, 1, 65536);
   out = out + ev_size(l);
  }
  rounds = rounds - 1;
 }
 let eof: bool = ev_eof(l, 0);
 l = ev_proc_wait(move l, 0);
 let code: i64 = ev_exit(l);
 let r: Result<i64> = ev_close(move l);
 if !eof { return 2; }
 if code != 0 { return 300 + code; }
 return out;
}
