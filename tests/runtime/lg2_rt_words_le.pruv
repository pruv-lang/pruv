fn rd2(b: [u8], i: i64) -> i64
  requires 0 <= i && i + 2 <= len(b) && load_le(b, i, 2) >= 0
{ return load_le(b, i, 2); }

fn dump(b: [u8]) -> () ! io {
  let mut i: i64 = 0;
  while i < len(b) invariant 0 <= i && i <= len(b) decreases len(b) - i {
    print(b[i]);
    i = i + 1;
  }
}

fn run() -> () ! io, alloc {
  let mut b: [u8] = alloc(10, 0);
  b[1] = 1; b[2] = 2; b[3] = 3; b[4] = 4;
  b[5] = 5; b[6] = 6; b[7] = 7; b[8] = 128;
  print(load_le(b, 1, 1));
  print(rd2(b, 1));
  print(load_le(b, 1, 4));
  print(load_le(b, 1, 6));
  print(load_le(b, 1, 8));

  let mut dst: [u8] = alloc(10, 42);
  store_le(inout dst, 2, 511, 1);
  dump(dst);
  store_le(inout dst, 3, 4660, 2);
  dump(dst);
  store_le(inout dst, 1, 168496141, 3);
  dump(dst);
  store_le(inout dst, 2, -2, 6);
  dump(dst);
  store_le(inout dst, 1, -9223372036854775807, 8);
  dump(dst);
  print(load_le(dst, 1, 8));
  store_le(inout dst, 3, -2, 5);
  print(load_le(dst, 3, 5));
}
