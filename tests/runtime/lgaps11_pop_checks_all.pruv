// spec: R-6g9-11 accept
// LG7-T3 (L-gaps 11): verified `vec_pop` built with `--foreign-checks all` (since L-gaps 12 both backends emit the
// proven pop with no run-time check, LG7-B4) pops a non-empty view list and keeps the rest.
fn run() -> () ! alloc, io {
  let s: str = "abc";
  let mut names: Vec<ref str> = vec_new::<ref str>();
  vec_push::<ref str>(inout names, subview(s, 0, 1));
  vec_push::<ref str>(inout names, subview(s, 1, 3));
  vec_pop::<ref str>(inout names);
  let g: ref str = vec_get::<ref str>(names, 0);
  print(len(g));
  let j: String = vec_join::<ref str>(names, "/");
  print(len(j));
}
