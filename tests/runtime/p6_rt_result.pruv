fn div(a: i64, b: i64) -> Result<(i64, i64), String> ! alloc
  requires 0 <= a && a <= 1000 && 0 <= b && b <= 1000
  ensures is_ok(result) ==> ok_val(result).0 * b + ok_val(result).1 == a
  ensures is_ok(result) ==> 0 <= ok_val(result).0 && ok_val(result).0 <= a && 0 <= ok_val(result).1 && ok_val(result).1 < b
{
  if b == 0 { return Err::<(i64, i64), String>(string_from("zero")); }
  return Ok::<(i64, i64), String>((a / b, a % b));
}

fn use_div(a: i64) -> i64 ! alloc
  requires 0 <= a && a <= 1000
  ensures 0 - 1 <= result && result <= 20000
{
  let r: Result<(i64, i64), String> = div(a, 7);
  match r {
    Ok(q) => { return q.0 * 10 + q.1; }
    Err(e) => { return 0 - 1; }
  }
}

fn opt(a: i64) -> Option<(i64, bool)>
  requires 0 <= a && a <= 1000
  ensures is_some(result) ==> some_val(result).0 == a
{
  if a > 5 { return Some::<(i64, bool)>((a, true)); }
  return None::<(i64, bool)>;
}

fn run(k: i64) -> i64 ! alloc
  requires 0 <= k && k <= 10
{
  let o: Option<(i64, bool)> = opt(k);
  let mut x: i64 = 0;
  match o {
    Some(p) => { x = p.0; }
    None => { x = 100; }
  }
  return use_div(k * 9) + x;
}
