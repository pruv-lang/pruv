// G10 proc A2 gate 5 (--no-verify only: the byte arithmetic is not proved): stdout and stderr are read chunk by chunk
// with a small max, every chunk is at most max bytes, and the reassembled streams are exactly the fixture's pattern
// bytes: the byte at stream offset i is (i * 31 + stream * 7 + 5) % 251, and the totals match.
fn abort_with(take p: Process, base: i64) -> i64 ! proc, alloc {
  let e: i64 = proc_error(p);
  let r: Result<i64> = proc_wait(move p);
  return base + e;
}

// the public buffer of `stream` holds the pattern bytes starting at stream offset `offset`
fn pattern_ok(p: Process, stream: i64, offset: i64) -> bool
  requires stream == 1 || stream == 2
{
  let n: i64 = proc_size(p, stream);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n
    decreases n - i
  {
    if proc_byte(p, stream, i) != ((offset + i) * 31 + stream * 7 + 5) % 251 { return false; }
    i = i + 1;
  }
  return true;
}

fn chunked(child: str, nerr: str, nout: str, max: i64, want_err: i64, want_out: i64) -> i64 ! proc, alloc {
  let mut args: ProcessArgs = proc_args_new();
  args = proc_args_push(move args, "errout");
  args = proc_args_push(move args, nerr);
  args = proc_args_push(move args, nout);
  let mut p: Process = proc_spawn(child, args, "");
  if !proc_ok(p) { return abort_with(move p, 100); }
  p = proc_close_stdin(move p);
  if !proc_ok(p) { return abort_with(move p, 200); }

  // stderr first although the child writes it first and stdout second: the order of reading is free
  let mut got_err: i64 = 0;
  let mut rounds: i64 = 5000000;
  while rounds > 0 && proc_ok(p) && !proc_eof(p, 2)
    invariant 0 <= rounds
    decreases rounds
  {
    p = proc_read(move p, 2, max);
    if proc_ok(p) {
      if proc_size(p, 2) > max { return abort_with(move p, 900); }
      if !pattern_ok(p, 2, got_err) { return abort_with(move p, 910); }
      got_err = got_err + proc_size(p, 2);
    }
    rounds = rounds - 1;
  }
  if !proc_ok(p) { return abort_with(move p, 300); }

  let mut got_out: i64 = 0;
  rounds = 5000000;
  while rounds > 0 && proc_ok(p) && !proc_eof(p, 1)
    invariant 0 <= rounds
    decreases rounds
  {
    p = proc_read(move p, 1, max);
    if proc_ok(p) {
      if proc_size(p, 1) > max { return abort_with(move p, 920); }
      if !pattern_ok(p, 1, got_out) { return abort_with(move p, 930); }
      got_out = got_out + proc_size(p, 1);
    }
    rounds = rounds - 1;
  }
  if !proc_ok(p) { return abort_with(move p, 400); }

  // reading a stream at EOF again gives an empty buffer and EOF true
  p = proc_read(move p, 1, max);
  if !proc_ok(p) { return abort_with(move p, 500); }
  let again: bool = proc_size(p, 1) == 0 && proc_eof(p, 1);

  let r: Result<i64> = proc_wait(move p);
  if got_err != want_err { return 1; }
  if got_out != want_out { return 2; }
  if !again { return 3; }
  match r {
    Ok(v) => { return v; }
    Err(code) => { return 600 + code; }
  }
}
