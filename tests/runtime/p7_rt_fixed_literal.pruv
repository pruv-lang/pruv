// P7-1 A runtime: fixed-length array literals, copies by value, every scalar element type
const K: u8 = 3;

fn run(i: i64) -> i64
  requires 0 <= i && i < 4
{
  let mut a: [i64; K + 1] = [1, 2, 3, 4,];
  let c: [i64; 4] = a;
  a[i] = a[i] + 10;
  a[0] = 99;
  let b: [u8; 4] = [200; 4];
  let s: [i8; 3] = [-128, -1, 127];
  let w: [u64; 2] = [18446744073709551615, 1];
  let h: [char; 3] = ['a', 'Z', '\u{10FFFF}'];
  let t: [bool; 3] = [true, false, true];
  let z: [bool; 0] = [true; 0];
  let e: [i32; 0] = [5; 0];
  let mut p: [i16; 2] = [-7, 9];
  p = [p[1], p[0]];
  let mut x: i64 = a[i] + c[i] + i64(b[3]) + i64(s[0]) + i64(s[2]) + len(z) + len(e) + len(a) + [5, 6, 7][1];
  if w[0] == 18446744073709551615 && w[1] == 1 { x = x + 1000; }
  if h[2] == '\u{10FFFF}' && h[1] == 'Z' { x = x + 2000; }
  if t[0] && !t[1] && t[2] { x = x + 4000; }
  if p[0] == 9 && p[1] == -7 { x = x + 8000; }
  return x;
}
