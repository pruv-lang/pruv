struct P { n: i64, a: [u8], x: [i64], y: [i64], z: [i64] }

fn run() -> () ! io, alloc {
  let b: [u8] = alloc(3, 7);
  let mut p: P = P { n: 1, a: move b, x: alloc(2, 10), y: alloc(2, 20), z: alloc(4, 0) };

  let mut t: [u8] = move p.a;
  p.a = copy(t);
  t[0] = 9;
  print(t[0]);
  print(p.a[0]);
  print(len(p.a));
  print(len(t));

  let q: [i64] = move p.z;
  p.z = alloc(0, 0);
  print(len(q));
  print(len(p.z));

  p.x[1] = 11;
  p.y[0] = 22;
  let s: [i64] = move p.x;
  p.x = move p.y;
  p.y = move s;
  print(p.x[0]);
  print(p.x[1]);
  print(p.y[0]);
  print(p.y[1]);
  print(p.n);
}
