// eq_range edge cases: empty and full ranges, first/last element, aliasing and overlap, short dynamic ranges (the
// inline loop on LLVM, n < 4), long ranges (memcmp), literal counts (constant-size memcmp), and a refined
// [i64 | 0..=200] against a plain [i64].
fn same(a: [i64], i: i64, b: [i64], j: i64, n: i64) -> bool
  requires 0 <= i && 0 <= j && 0 <= n && i + n <= len(a) && j + n <= len(b)
{ return eq_range(a, i, b, j, n); }
fn same8(a: [u8], i: i64, b: [u8], j: i64, n: i64) -> bool
  requires 0 <= i && 0 <= j && 0 <= n && i + n <= len(a) && j + n <= len(b)
{ return eq_range(a, i, b, j, n); }
// a refined element type: the storage plan keeps eq_range operands as 64-bit elements, so this is the i64 path
fn same_nw(a: [i64 | 0..=200], i: i64, b: [i64], j: i64, n: i64) -> bool
  requires 0 <= i && 0 <= j && 0 <= n && i + n <= len(a) && j + n <= len(b)
{ return eq_range(a, i, b, j, n); }
// literal counts: a constant-size memcmp on LLVM (3 elements = 24 bytes, 64 bytes, 64 elements)
fn lit3(a: [i64], i: i64, b: [i64], j: i64) -> bool
  requires 0 <= i && 0 <= j && i + 3 <= len(a) && j + 3 <= len(b)
{ return eq_range(a, i, b, j, 3); }
fn lit64_8(a: [u8], i: i64, b: [u8], j: i64) -> bool
  requires 0 <= i && 0 <= j && i + 64 <= len(a) && j + 64 <= len(b)
{ return eq_range(a, i, b, j, 64); }
fn lit64(a: [i64], i: i64, b: [i64], j: i64) -> bool
  requires 0 <= i && 0 <= j && i + 64 <= len(a) && j + 64 <= len(b)
{ return eq_range(a, i, b, j, 64); }
fn bit(x: bool) -> i64 {
  if x { return 1; }
  return 0;
}
fn run() -> () ! io, alloc {
  let mut a: [i64] = alloc(4, 0);
  let mut c: [i64] = alloc(4, 0);
  a[0] = 1; a[1] = 2; a[2] = 3; a[3] = 4;
  c[0] = 1; c[1] = 2; c[2] = 3; c[3] = 4;
  // empty range at the end of an array
  print(bit(same(a, 4, c, 4, 0)));
  // the full array, equal
  print(bit(same(a, 0, c, 0, 4)));
  // last element differs
  c[3] = 9;
  print(bit(same(a, 0, c, 0, 4)));
  // first element differs
  c[3] = 4;
  c[0] = 9;
  print(bit(same(a, 0, c, 0, 4)));
  // the same array, same start
  print(bit(same(a, 1, a, 1, 3)));
  // the same array, overlapping shift: constant content is equal, varying content is not
  let k: [i64] = alloc(6, 7);
  print(bit(same(k, 0, k, 1, 5)));
  print(bit(same(a, 0, a, 1, 3)));
  // a long [u8] range (100 bytes): equal, then the last byte differs
  let s: [u8] = alloc(100, 7);
  let mut t: [u8] = alloc(100, 7);
  print(bit(same8(s, 0, t, 0, 100)));
  t[99] = 8;
  print(bit(same8(s, 0, t, 0, 100)));
  // a long [i64] range (40 elements): equal, then element 20 differs
  let x: [i64] = alloc(40, 5);
  let mut y: [i64] = alloc(40, 5);
  print(bit(same(x, 0, y, 0, 40)));
  y[20] = 6;
  print(bit(same(x, 0, y, 0, 40)));
  // literal n = 3
  print(bit(lit3(a, 0, c, 1)));
  print(bit(lit3(a, 1, c, 1)));
  // literal n = 64
  let u: [u8] = alloc(64, 3);
  let mut v: [u8] = alloc(64, 3);
  print(bit(lit64_8(u, 0, v, 0)));
  v[63] = 4;
  print(bit(lit64_8(u, 0, v, 0)));
  let p: [i64] = alloc(64, 2);
  let mut q: [i64] = alloc(64, 2);
  print(bit(lit64(p, 0, q, 0)));
  q[31] = 3;
  print(bit(lit64(p, 0, q, 0)));
  // a refined [i64 | 0..=200] against a plain [i64]
  let mut nw: [i64 | 0..=200] = alloc(4, 3);
  let mut pl: [i64] = alloc(4, 3);
  print(bit(same_nw(nw, 0, pl, 0, 4)));
  pl[2] = 4;
  print(bit(same_nw(nw, 0, pl, 0, 4)));
  nw[2] = 4;
  print(bit(same_nw(nw, 1, pl, 1, 3)));
}
