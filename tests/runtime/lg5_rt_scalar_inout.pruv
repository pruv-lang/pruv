struct C { n: i64, ok: bool }

fn bit(x: bool) -> i64 {
  if x { return 1; }
  return 0;
}

fn bump(inout x: i64, inout f: bool, d: i64) -> ()
  requires x == 10 && !f && 0 <= d && d <= 1000
  ensures x == 10 + d && f
{
  x = x + d;
  f = !f;
}

fn fwd(inout x: i64, inout f: bool, d: i64) -> ()
  requires x == 10 && !f && 0 <= d && d <= 1000
  ensures x == 10 + d && f
{
  bump(inout x, inout f, d);
}

fn run() -> () ! io {
  let mut x: i64 = 10;
  let mut f: bool = false;
  fwd(inout x, inout f, 5);
  print(x);
  print(bit(f));
  let mut c: C = C { n: 10, ok: false };
  bump(inout c.n, inout c.ok, 32);
  print(c.n);
  print(bit(c.ok));
  let mut y: i64 = 10;
  let mut g: bool = false;
  bump(inout y, inout g, 0);
  print(y);
  print(bit(g));
}
