struct Buf { len: i64, data: [u8; 4] }

fn make(x: u8) -> Buf
  ensures result.data[0] == x && result.data[2] == 0 && result.len == 1
{
  let mut d: [u8; 4] = [0; 4];
  d[0] = x;
  return Buf { len: 1, data: d };
}

fn get(b: Buf, i: i64) -> i64
  requires 0 <= i && i < 4
  ensures 0 <= result && result <= 255
{
  return i64(b.data[i]);
}

fn put(inout b: Buf, v: u8) -> ()
  ensures b.data[3] == v && b.data[0] == old(b).data[0] && b.data[2] == old(b).data[2] && b.len == old(b).len
{
  b.data[3] = v;
}

fn run(i: i64) -> i64
  requires 0 <= i && i < 4
{
  let mut b: Buf = make(9);
  put(inout b, 7);
  b.data[1] = 5;
  let c: Buf = b;
  b.data[2] = 1;
  assert c.data[2] == 0 && b.data[2] == 1 && b.data[1] == 5;
  assert len(c.data) == 4;
  return get(b, i) + i64(c.data[3]) * 100 + i64(c.data[2]) * 1000 + c.len * 10000;
}
