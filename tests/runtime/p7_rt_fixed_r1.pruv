// P7-1 R1: generics without == take a struct holding [T; N] (also as an Option payload); nested inout w.p.f;
// contracts read a fixed field of a struct that also has a buffer field
struct S { a: [i64; 2] }
struct Px { d: [i64; 3] }
struct W { p: Px, k: i64 }
struct B { buf: [i64], f: [i64; 2] }

fn pick<T>(x: T, y: T, k: i64) -> i64
  ensures result == k
{ return k; }

fn bump(inout d: [i64; 3]) -> ()
  requires d[1] < 1000
  ensures d[1] == old(d)[1] + 1 && d[0] == old(d)[0] && d[2] == old(d)[2]
{ d[1] = d[1] + 1; }

fn head(b: B) -> i64
  requires b.f[0] < 100 && len(b.f) == 2 && len(b.buf) > 0
  ensures result == b.f[0] + 1
{ return b.f[0] + 1; }

fn run(i: i64) -> i64 ! alloc
  requires 0 <= i && i < 2
{
  let s: S = S { a: [3, 4] };
  let t: S = S { a: [5, 6] };
  let o: Option<S> = Some::<S>(t);
  let mut r: i64 = pick::<S>(s, t, s.a[i]);
  match o {
    Some(x) => { r = r + x.a[i] * 10; }
    None => { }
  }
  let mut w: W = W { p: Px { d: [1, 2, 3] }, k: 0 };
  bump(inout w.p.d);
  assert w.p.d[1] == 3;
  r = r + 1000 * w.p.d[1];

  let b: B = B { buf: alloc(3, 9), f: [20, 30] };
  return r + 10000 * head(b);
}
