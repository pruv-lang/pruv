// copy_range with src == dst: memmove semantics (forward and backward overlap), [i64] and [u8].
fn run() -> () ! io, alloc {
  let mut a: [i64] = alloc(8, 0);
  a[1] = 1; a[2] = 2; a[3] = 3; a[4] = 4; a[5] = 5; a[6] = 6; a[7] = 7;
  copy_range(inout a, 2, a, 0, 4);
  print(a[0]);
  print(a[1]);
  print(a[2]);
  print(a[3]);
  print(a[4]);
  print(a[5]);
  print(a[6]);
  print(a[7]);

  let mut b: [i64] = alloc(8, 0);
  b[1] = 1; b[2] = 2; b[3] = 3; b[4] = 4; b[5] = 5; b[6] = 6; b[7] = 7;
  copy_range(inout b, 0, b, 3, 4);
  print(b[0]);
  print(b[1]);
  print(b[2]);
  print(b[3]);
  print(b[4]);
  print(b[5]);
  print(b[6]);
  print(b[7]);

  let mut c: [u8] = alloc(6, 0);
  c[0] = 10; c[1] = 20; c[2] = 30; c[3] = 40; c[4] = 50; c[5] = 60;
  copy_range(inout c, 1, c, 0, 4);
  print(c[0]);
  print(c[1]);
  print(c[2]);
  print(c[3]);
  print(c[4]);
  print(c[5]);
}
