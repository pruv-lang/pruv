// P9b (R-6x-4): owner names that meet generated names: `Foo_` next to `Foo` (`Foo___get` is `Foo_` + `get`) and a
// type named `Pruv` (the LLVM bindings' own `Pruv__Array` items are not its methods), and a method name ending
// with `_` next to the same name without it (`Foo__get___pruv_body` is `get_` + `__pruv_body`)
struct Foo { m: i64 }
struct Foo_ { m: i64 }
struct Pruv { n: i64 }

impl Foo {
  fn get(self) -> i64 requires self.m >= 0 && self.m <= 10 ensures result == self.m + 1 { return self.m + 1; }
  fn get_(self) -> i64 requires self.m >= 0 && self.m <= 10 ensures result == self.m { return self.m; }
}

impl Foo_ {
  fn get(self) -> i64 ensures result == self.m { return self.m; }
}

impl Pruv {
  fn get(self) -> i64 ensures result == self.n { return self.n; }
}

fn pair(k: i64) -> (i64, i64) ensures result.1 == 2 { return (k, 2); }

fn run(k: i64) -> i64
  requires k >= 0 && k <= 10
{
  let a: Foo = Foo { m: k };
  let b: Foo_ = Foo_ { m: k };
  let c: Pruv = Pruv { n: k };
  let p: (i64, i64) = pair(k);
  return a.get() + a.get_() + b.get() + c.get() + p.1;
}
