// LG14 (G-LG13-1): a `?` after an earlier call, index, move or arithmetic operand; the earlier operands are bound to
// fresh temporaries (__pruv_try_tN) left to right before the `?` match, so they still run first
fn half(x: i64) -> Result<i64>
  requires 0 <= x && x <= 1000
  ensures is_ok(result) ==> ok_val(result) * 2 == x
{
  if x % 2 == 0 { return Ok(x / 2); }
  return Err(x);
}

fn twice(x: i64) -> i64
  requires 0 <= x && x <= 1000
  ensures result == x * 2
{
  return x * 2;
}

fn after_call(x: i64) -> Result<i64>
  requires 0 <= x && x <= 100
{
  return Ok(twice(x) + half(x)?);
}

fn after_index(a: [i64]) -> Result<i64>
  requires len(a) >= 2 && len(a) <= 100 && 0 <= a[0] && a[0] <= 100 && 0 <= a[1] && a[1] <= 100
{
  let r: i64 = a[1] * 3 + half(a[0])?;
  return Ok(r);
}

fn after_two(x: i64) -> Result<i64>
  requires 0 <= x && x <= 100
{
  return Ok(twice(x) - (x + 1) * twice(1) + half(twice(x))? + half(x)?);
}

fn eat(take s: String) -> i64 ! alloc
  requires len(s) <= 100
  ensures result == len(s)
{
  return len(s);
}

fn need(x: i64) -> Result<i64, String> ! alloc
  ensures is_ok(result) ==> ok_val(result) == x && x > 0 && x <= 100
{
  if x > 0 && x <= 100 { return Ok::<i64, String>(x); }
  return Err::<i64, String>(string_from("no"));
}

fn after_move(x: i64) -> Result<i64, String> ! alloc {
  let s: String = string_from("abc");
  return Ok::<i64, String>(eat(move s) + need(x)?);
}

fn show(r: Result<i64>) -> i64 {
  match r {
    Ok(v) => { return v; }
    Err(e) => { return 0 - 1 - e; }
  }
}

fn run(k: i64, x: i64) -> i64
  requires 0 <= x && x <= 100
{
  if k == 0 { return show(after_call(x)); }
  return show(after_two(x));
}

fn run_index(a: [i64]) -> i64
  requires len(a) >= 2 && len(a) <= 100 && 0 <= a[0] && a[0] <= 100 && 0 <= a[1] && a[1] <= 100
{
  return show(after_index(a));
}

fn run_move(x: i64) -> i64 ! alloc {
  let r: Result<i64, String> = after_move(x);
  match r {
    Ok(v) => { return v; }
    Err(e) => { return 0 - len(e); }
  }
}
