// P4 runtime: a for loop over Vec<i64> (Rust backend: LLVM has no Vec yet, llvm_pending G6)
fn vsum(v: Vec<i64>) -> i64
  requires len(v) <= 100
  requires forall k in 0..len(v): 0 <= v[k] && v[k] <= 10
  ensures 0 <= result && result <= 1000
{
  let mut s: i64 = 0;
  for x in v invariant 0 <= s && s <= index(x) * 10 { s = s + x; }
  return s;
}

fn run(k: i64) -> i64 ! alloc
  requires 0 <= k && k <= 10
{
  let mut v: Vec<i64> = vec_new::<i64>();
  for i in 0..k invariant len(v) == i && forall q in 0..len(v): 0 <= v[q] && v[q] <= 10 {
    v = vec_push::<i64>(move v, i);
  }
  return vsum(v);
}
