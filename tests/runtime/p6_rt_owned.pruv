struct S { a: i64, b: i64 }

fn mk(n: i64) -> (String, S) ! alloc
  requires 1 <= n && n <= 50
  ensures result.1.a == n && len(result.0) == 3
{
  return (string_from("abc"), S { a: n, b: 2 });
}

fn take(n: i64) -> i64 ! alloc
  requires 1 <= n && n <= 50
{
  let t: (String, S) = mk(n);
  let (k, s): (String, S) = move t;
  return len(k) * 100 + s.a;
}

fn proj(n: i64) -> i64 ! alloc
  requires 1 <= n && n <= 50
{
  let mut t: (String, S) = mk(n);
  let k: String = move t.0;
  return len(k) + 10 * n;
}

fn vecs(n: i64) -> i64 ! alloc
  requires 1 <= n && n <= 20
{
  let mut v: Vec<(String, S)> = vec_new::<(String, S)>();
  let t: (String, S) = mk(n);
  v = vec_push::<(String, S)>(move v, move t);
  v = vec_push::<(String, S)>(move v, mk(n + 1));
  if len(v) != 2 { return 0; }
  let r: i64 = len(vec_get::<(String, S)>(v, 1).0);
  let a: i64 = vec_get::<(String, S)>(v, 0).1.a;
  if r > 1000 || a > 1000 || a < 0 { return 0; }
  return r * 10 + a;
}

fn total(v: Vec<(String, S)>) -> i64
  requires len(v) <= 10
{
  let mut s: i64 = 0;
  for i in 0..len(v) invariant 0 <= s && s <= i * 100 {
    let a: i64 = vec_get::<(String, S)>(v, i).1.a;
    if 0 <= a && a <= 100 { s = s + a; }
  }
  return s;
}

fn run() -> () ! io, alloc {
  print(take(3));
  print(proj(4));
  print(vecs(2));
  let mut w: Vec<(String, S)> = vec_new::<(String, S)>();
  w = vec_push::<(String, S)>(move w, mk(5));
  w = vec_push::<(String, S)>(move w, mk(7));
  print(total(w));
}
