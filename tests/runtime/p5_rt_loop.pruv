// P5 runtime: break/continue in for (range, slice) and while, labeled break/continue from nested loops,
// break on the first iteration; verified and unverified
fn first_ge(a: [i64], t: i64) -> i64
  ensures result >= -1 && result < len(a)
{
  let mut r: i64 = -1;
  for i in 0..len(a) invariant r == -1 {
    if a[i] >= t { r = i; break; }
  }
  return r;
}

fn skip_odd(n: i64) -> i64
  requires 0 <= n && n <= 100
  ensures 0 <= result && result <= n
{
  let mut c: i64 = 0;
  for i in 0..n invariant 0 <= c && c <= i {
    if i % 2 == 1 { continue; }
    c = c + 1;
  }
  return c;
}

fn wskip(n: i64) -> i64
  requires 0 <= n && n <= 100
  ensures 0 <= result && result <= n
{
  let mut i: i64 = 0;
  let mut c: i64 = 0;
  while i < n invariant 0 <= i && i <= n && 0 <= c && c <= i decreases n - i {
    i = i + 1;
    if i % 3 == 0 { continue; }
    c = c + 1;
  }
  return c;
}

fn pair(n: i64) -> i64
  requires 0 <= n && n <= 50
  ensures result >= -1 && result < 5100
{
  let mut r: i64 = -1;
  'outer: for i in 0..n invariant r == -1 {
    for j in 0..n invariant r == -1 {
      if i * j == 12 { r = i * 100 + j; break 'outer; }
      if j > i { continue 'outer; }
    }
  }
  return r;
}

fn sum_bytes(a: [u8]) -> i64
  requires len(a) <= 1000
  ensures 0 <= result && result <= 255000
{
  let mut s: i64 = 0;
  for x in a invariant 0 <= s && s <= index(x) * 255 {
    if x == 0 { break; }
    s = s + x;
  }
  return s;
}

fn run(k: i64) -> i64 ! alloc
  requires 0 <= k && k <= 10
{
  let mut q: [i64] = alloc(k, 1);
  if k > 2 { q[2] = 5; }
  let mut b: [u8] = alloc(k, 3);
  if k > 4 { b[4] = 0; }
  return (first_ge(q, 5) + 1) + skip_odd(k) * 100 + wskip(k) * 10000 + (pair(k) + 1) * 1000000 + sum_bytes(b) * 1000000000;
}
