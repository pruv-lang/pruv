// --no-verify: an i + n past the end (i near i64 max, so i + n would overflow) fails the combined range check
fn same(a: [i64], i: i64, b: [i64], j: i64, n: i64) -> bool {
  return eq_range(a, i, b, j, n);
}
fn run() -> () ! io, alloc {
  let a: [i64] = alloc(4, 1);
  let b: [i64] = alloc(4, 1);
  print(1);
  if same(a, 9223372036854775807, b, 0, 2) { print(2); }
  print(3);
}
