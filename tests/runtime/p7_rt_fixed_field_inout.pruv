// P7-1 B audit: inout of a fixed field passes the field storage; contracts read fixed fields
struct S { a: i64, f: [i64; 2] }
fn bump(inout x: [i64; 2]) -> ()
  requires x[0] < 1000
  ensures x[0] == old(x)[0] + 1 && x[1] == old(x)[1]
{ x[0] = x[0] + 1; }
fn g(s: S) -> i64
  requires s.f[0] < 100 && len(s.f) == 2
  ensures result <= 100
{ return s.f[0] + 1; }
pub fn run(i: i64) -> i64
  requires 0 <= i && i < 2
{
  let mut s: S = S { a: 1, f: [10, 20] };
  bump(inout s.f);
  assert s.f[0] == 11;
  return s.f[i] + g(s);
}
