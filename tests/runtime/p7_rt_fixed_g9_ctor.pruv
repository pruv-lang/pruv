// P7-1 B confirm audit: a [T; N] field of a constructor built as a real value (size, G9 variant_field)
// the recursive type turns on the G9 real-value path for variant_field
enum Tree { Empty, Next(child: Tree) }
enum E { A(a: [i64; 2]), B }
struct S { a: [i64; 2] }

fn f(s: S, p: [i64; 2]) -> i64
  requires size(S { a: p }) == 1 && size(E::A(s.a)) == 1
  requires variant_field(E::A(p), E::A, a)[1] > 0 && variant_field(E::A(s.a), E::A, a)[0] > 0
  requires p[1] < 1000
  ensures result == variant_field(E::A(p), E::A, a)[1]
{ return p[1]; }

fn run(i: i64) -> i64
  requires 0 <= i && i < 3
{
  let p: [i64; 2] = [i + 1, i + 2];
  let s: S = S { a: p };
  return f(s, p) + 10;
}
