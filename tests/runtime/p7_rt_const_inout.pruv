const K: u64 = 18446744073709551615;
const QUOTE: char = '"';

struct S { n: i64 }

fn put(inout s: S, c: char, b: u8, w: u64) -> ()
  requires 0 <= s.n && s.n <= 100
  ensures s.n == old(s.n) + i64(u32(c)) % 2 + i64(b) % 2 + i64(w % 2)
{
  s.n = s.n + i64(u32(c)) % 2 + i64(b) % 2 + i64(w % 2);
}

fn run(k: i64) -> i64
  requires 0 <= k && k <= 10
{
  let mut s: S = S { n: k };
  put(inout s, 'a', b'"', K);
  put(inout s, QUOTE, b'\\', 7);
  put(inout s, '\'', b'\'', 0);
  return s.n * 1000 + i64(u32(QUOTE));
}
