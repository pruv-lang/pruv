// P9b-3 (R-6x-4) audit: an associated function of a generic impl whose owner application no function builds stays a
// free function, and its contract violation at run time still names it `Box2::k` (with --no-verify).
struct Box2<T> { v: T, n: i64 }
impl<T> Box2<T> {
  fn k(n: i64) -> i64 requires n >= 0 { return n; }
}
fn run(k: i64) -> i64 {
  return Box2::<bool>::k(k);
}
