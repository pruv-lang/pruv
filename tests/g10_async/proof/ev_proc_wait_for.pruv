fn check(take l: Loop, a: i64, b: i64, data: [u8]) -> Loop ! async, net, proc, alloc
  requires ev_ok(l)
  requires 0 <= a && a < ev_cap(l)
  requires ev_kind(l, a) == 3
  requires 0 <= b && b < ev_cap(l) && a != b
  ensures ev_ok(result)
  ensures ev_write_open(result, a) == false
  ensures ev_kind(result, a) == 0 || ev_kind(result, a) == 3
  ensures (ev_kind(result, a) == 3) ==> ev_count(result) == ev_count(l)
  ensures (ev_kind(result, a) == 3) ==> ev_eof(result, a) == ev_eof(l, a)
  ensures (ev_kind(result, a) == 3) ==> ev_exit(result) == ev_exit(l)
  ensures (ev_kind(result, a) == 0) ==> ev_count(result) == ev_count(l) - 1
  ensures (ev_kind(result, a) == 0) ==> !ev_eof(result, a)
  ensures ev_kind(result, b) == ev_kind(l, b)
  ensures ev_eof(result, b) == ev_eof(l, b)
  ensures ev_write_open(result, b) == ev_write_open(l, b)
{ return ev_proc_wait_for(move l, a, 50); }

// After a kept result the slot is still a process; ev_proc_wait ends it.
fn finish(take l: Loop, a: i64) -> Loop ! async, net, proc, alloc
  requires ev_ok(l)
  requires 0 <= a && a < ev_cap(l)
  requires ev_kind(l, a) == 3
  ensures ev_ok(result)
  ensures ev_kind(result, a) == 0
  ensures ev_count(result) == ev_count(l) - 1
{
  let q: Loop = ev_proc_wait_for(move l, a, 0);
  if ev_kind(q, a) == 3 { return ev_proc_wait(move q, a); }
  return move q;
}
