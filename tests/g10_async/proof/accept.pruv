fn check(take l: Loop, a: i64, b: i64) -> Loop ! async, net, proc, alloc
  requires ev_ok(l)
  requires 0 <= a && a < ev_cap(l)
  requires ev_kind(l, a) == 2
  requires ev_count(l) < ev_cap(l)
  ensures ev_ok(result) ==> ev_kind(result, a) == 2
  ensures ev_ok(result) && ev_last(result) != -1 ==> ev_count(result) == ev_count(l) + 1
{ return ev_accept(move l, a); }
