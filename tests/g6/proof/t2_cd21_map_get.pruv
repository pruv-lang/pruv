// TIDY 4.11 accept twin of must_reject/cd21_map_get: map_get pinned to independent values (absent key None,
// inserted key Some(value), other key None).
fn absent() -> i64 ! alloc
  ensures result == -1
{
  let m: HashMap<i64, i64> = map_new::<i64, i64>();
  let found: Option<i64> = map_get::<i64, i64>(m, 4);
  match found {
    Some(x) => { return x; }
    None => { return -1; }
  }
}

fn present() -> i64 ! alloc
  ensures result == 7
{
  let mut m: HashMap<i64, i64> = map_new::<i64, i64>();
  m = map_insert::<i64, i64>(move m, 3, 7);
  let other: Option<i64> = map_get::<i64, i64>(m, 4);
  match other {
    Some(y) => { return -2; }
    None => { }
  }
  let found: Option<i64> = map_get::<i64, i64>(m, 3);
  match found {
    Some(x) => { return x; }
    None => { return -1; }
  }
}
