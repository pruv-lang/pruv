// B8-1 (P8b): a while let target that borrows and moves the same value in one call is type/foreign_borrow, as for match
struct Rec { text: String }
fn pick(s: String, take r: Rec) -> Option<i64> ! alloc { if len(s) > 0 { return Some(len(s)); } return None; }
fn f(take r: Rec) -> i64 ! alloc {
  while let Some(n) = pick(r.text, move r) decreases 0 { return n; }
  return 0;
}
