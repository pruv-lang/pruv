// LG14: an operand before the `?` whose type is not a value (here a String) is bound to a temporary only when it is
// a call result, or a plain move passed to a take parameter (LG18, G-LG14-1); a move passed to a borrowed parameter
// is not, since the temporary would turn the invalid move into a valid borrow; rejected
fn mk() -> String ! alloc {
  return string_from("a");
}

fn need(x: i64) -> Result<i64, String> ! alloc {
  if x > 0 { return Ok::<i64, String>(x); }
  return Err::<i64, String>(string_from("no"));
}

fn cat2(a: String, b: i64) -> i64 {
  return b;
}

fn g(x: i64) -> Result<i64, String> ! alloc {
  let s: String = mk();
  return Ok::<i64, String>(cat2(move s, need(x)?));
}
