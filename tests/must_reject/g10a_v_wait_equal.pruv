fn bad(take l: Loop) -> Result<i64> ! async, net, proc, alloc
  requires ev_ok(l)
{
  let a: Loop = ev_wait(move l, 0);
  let first: i64 = ev_event_kind(a);
  if !ev_ok(a) { return ev_close(move a); }
  let b: Loop = ev_wait(move a, 0);
  assert first == ev_event_kind(b);
  return ev_close(move b);
}
