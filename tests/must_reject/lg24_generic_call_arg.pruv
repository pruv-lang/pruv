// LG24 (G-LG23-4): a generic call at an instantiated type argument checks the invariant of the actual argument
struct R {
  lo: i64, hi: i64,
  invariant 0 <= lo && lo <= hi
}

fn ignore<T>(x: T) -> i64 {
  return 0;
}

pub fn run(k: i64) -> i64
  requires 0 <= k && k <= 10
{
  let mut r: R = R { lo: 0, hi: k };
  r.lo = k + 1;
  return ignore::<R>(r);
}
