// B8-1 (P8): a match target that borrows and moves the same value in one call is type/foreign_borrow
struct Rec { text: String }
fn pick(s: String, take r: Rec) -> Option<i64> ! alloc { if len(s) > 0 { return Some(len(s)); } return None; }
fn f(take r: Rec) -> i64 ! alloc {
  match pick(r.text, move r) {
    Some(n) => { return n; }
    None => { return 0; }
  }
}
