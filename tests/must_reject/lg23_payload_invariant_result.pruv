// LG23 (G-LG22-1): an Option result whose payload breaks the struct invariant is rejected at the return
struct R {
  lo: i64, hi: i64,
  invariant 0 <= lo && lo <= hi
}

fn mk(k: i64) -> Option<R>
  requires 0 <= k && k <= 10
{
  let mut r: R = R { lo: 0, hi: k };
  r.lo = k + 1;
  return Some::<R>(r);
}

pub fn run(k: i64) -> i64
  requires 0 <= k && k <= 10
{
  let o: Option<R> = mk(k);
  match o {
    Some(r) => { return r.hi; }
    None => { return 0; }
  }
}
