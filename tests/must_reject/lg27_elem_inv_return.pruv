// LG27 (G-LG26-1): a returned Vec<S> must hold S's invariant for every element
struct R {
  lo: i64, hi: i64,
  invariant 0 <= lo && lo <= hi
}

fn bad() -> Vec<R> ! alloc {
  let v: Vec<R> = vec_push::<R>(vec_new::<R>(), R { lo: 9, hi: 5 });
  return move v;
}
pub fn lg27_entry() -> () {
  return;
}
