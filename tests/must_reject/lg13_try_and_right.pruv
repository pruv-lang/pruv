// LG13: a `?` in the right operand of && would run only when the left operand is true; not lowered
fn check_pos(x: i64) -> Result<bool> {
  if x > 0 { return Ok::<bool>(true); }
  return Err::<bool>(0);
}

fn g(x: i64) -> Result<i64> {
  if x > 3 && check_pos(x)? { return Ok(1); }
  return Ok(0);
}
