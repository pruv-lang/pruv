// spec: R-6g9-13 reject
// LG7-SR (L-gaps 9): a false length claim about a view list of subviews of a parameter must refute (assert), not end unknown
fn f(b: [u8], m: i64) -> i64 ! alloc
  requires len(b) <= 1000 && 1 <= len(b) && 0 <= m && m <= len(b)
{
  let mut out: Vec<ref [u8]> = vec_new::<ref [u8]>();
  vec_push::<ref [u8]>(inout out, subview(b, 0, m));
  vec_push::<ref [u8]>(inout out, subview(b, m, len(b)));

  assert len(out) == 3;
  return 0;
}
