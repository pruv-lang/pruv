fn f(program: str, cwd: str) -> i64 ! proc, alloc {
  let args: ProcessArgs = proc_args_new();
  let names: ProcessArgs = proc_args_new();
  let values: ProcessArgs = proc_args_new();
  let p: Process = proc_spawn_env(program, args, cwd, names, values);
  if !proc_ok(p) { return 1; }
  let r: Result<i64> = proc_wait(move p);
  return 0;
}
