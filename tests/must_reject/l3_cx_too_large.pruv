// P06 contract expansion reject: an expansion over 4096 nodes is rejected
fn p(x: i64) -> bool {
  let a0: i64 = x + x;
  let a1: i64 = a0 + a0;
  let a2: i64 = a1 + a1;
  let a3: i64 = a2 + a2;
  let a4: i64 = a3 + a3;
  let a5: i64 = a4 + a4;
  let a6: i64 = a5 + a5;
  let a7: i64 = a6 + a6;
  let a8: i64 = a7 + a7;
  let a9: i64 = a8 + a8;
  let a10: i64 = a9 + a9;
  let a11: i64 = a10 + a10;
  let a12: i64 = a11 + a11;
  let a13: i64 = a12 + a12;
  return a13 > 0;
}
fn f(x: i64) -> i64 requires p(x) { return x; }
