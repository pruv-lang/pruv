// L-gaps 16 (LG15-MB): a struct binder moved whole is gone; a second move of it is a use after move
struct Doc { bytes: [u8], n: i64 }
enum Parse { Parsed(doc: Doc), Bad(code: i64) }

fn make() -> Parse ! alloc {
  let b: [u8] = alloc(2, 7);
  return Parse::Parsed(Doc { bytes: move b, n: 2 });
}

fn run() -> i64 ! alloc {
  let mut docs: Vec<Doc> = vec_new::<Doc>();
  let q: Parse = make();
  match q {
    Parse::Parsed(doc) => {
      docs = vec_push::<Doc>(move docs, move doc);
      docs = vec_push::<Doc>(move docs, move doc);
    }
    Parse::Bad(code) => {}
  }
  return len(docs);
}
