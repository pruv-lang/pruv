// LG24 (G-LG23-3): a call that passes a generic enum instance whose variant field breaks the struct invariant is rejected
struct R {
  lo: i64, hi: i64,
  invariant 0 <= lo && lo <= hi
}

enum Wrap<T> { Nothing, One(v: T) }

fn span(w: Wrap<R>) -> i64
  ensures result >= 0
{
  match w {
    Wrap::Nothing => { return 0; }
    Wrap::One(r) => { return r.hi - r.lo; }
  }
}

pub fn run(k: i64) -> i64
  requires 0 <= k && k <= 10
{
  let mut r: R = R { lo: 0, hi: k };
  r.lo = k + 1;
  return span(Wrap::<R>::One(r));
}
