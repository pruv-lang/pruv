// P31L: an inout call may be a binary operand (R-6g-1), but bump may return the i64 maximum, so + 1 overflows
fn bump(inout a: [i64]) -> i64
  requires len(a) >= 1
{
  a[0] = a[0] + 1;
  return a[0];
}

fn demo() -> i64 ! alloc {
  let mut d: [i64] = alloc(2, 0);
  let x: i64 = bump(inout d) + 1;
  return x;
}
