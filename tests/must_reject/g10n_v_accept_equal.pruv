fn bad(l: Listener) -> bool ! net, alloc
  requires net_listener_ok(l)
{
  let a: Socket = net_accept(l);
  let b: Socket = net_accept(l);
  let same: bool = net_ok(a) == net_ok(b);
  assert same;
  let r1: Result<i64> = net_close(move a);
  let r2: Result<i64> = net_close(move b);
  return same;
}
