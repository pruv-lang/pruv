// LG19 (G-LG18-4): an owned call result lifted for a take parameter stays try_position when its own call borrows a
// temporary (here the String built by string_from): the `let` would drop it before the `?` operand runs
fn mk(s: String) -> String ! alloc { return string_from("ab"); }
fn noisy() -> Result<i64, String> ! alloc, io {
  print(1);
  return Ok::<i64, String>(1);
}
fn eat(take a: String, b: i64) -> i64 ! alloc { return b; }
fn f() -> Result<i64, String> ! alloc, io {
  return Ok::<i64, String>(eat(mk(string_from("a")), noisy()?));
}
