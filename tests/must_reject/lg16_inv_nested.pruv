// LG16: a struct read from an Option payload is not assumed to satisfy its invariant (LG22: struct fields now are)
struct R {
  lo: i64, hi: i64,
  invariant 0 <= lo && lo <= hi
}

fn bad(o: Option<R>) -> i64
  ensures result >= 0
{
  match o {
    Some(r) => { return r.hi - r.lo; }
    None => { return 0; }
  }
}
