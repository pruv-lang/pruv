// P16 must reject: the result describes the array before the store, so r ==> a2[0] == b[0] fails after a2[0] = 7
pub fn f(a: [i64], b: [i64]) -> () ! alloc
  requires 2 <= len(a) && 2 <= len(b)
{
  let mut a2: [i64] = copy(a);
  let r: bool = eq_range(a2, 0, b, 0, 2);
  a2[0] = 7;
  assert r ==> a2[0] == b[0];
  return;
}
