// LG13: a call evaluated before the `?` would run after it once the `?` is lowered first; not lowered
fn half(x: i64) -> Result<i64>
  requires 0 <= x && x <= 1000
{
  if x % 2 == 0 { return Ok(x / 2); }
  return Err(x);
}

fn twice(x: i64) -> i64
  requires 0 <= x && x <= 1000
{
  return x * 2;
}

fn g(x: i64) -> Result<i64>
  requires 0 <= x && x <= 100
{
  return Ok(twice(x) + half(x)?);
}
