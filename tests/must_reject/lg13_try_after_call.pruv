// LG13/LG14: an inout call evaluated before the `?` cannot be bound to a temporary (LG14 binds only operands without
// inout or a quantifier); still rejected
fn half(x: i64) -> Result<i64>
  requires 0 <= x && x <= 1000
{
  if x % 2 == 0 { return Ok(x / 2); }
  return Err(x);
}

fn bump(inout y: i64) -> i64
  requires y <= 100
{
  y = y + 1;
  return 0;
}

fn g(x: i64) -> Result<i64>
  requires 0 <= x && x <= 100
{
  let mut y: i64 = 0;
  return Ok(bump(inout y) + half(x)?);
}
