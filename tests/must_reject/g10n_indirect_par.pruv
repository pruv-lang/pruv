// G10 net A0: net is reachable from a par branch through a helper
fn set_first(inout a: [i64], value: i64) -> ()
  requires len(a) > 0
  ensures a[0] == value
{ a[0] = value; }

fn probe(inout a: [i64]) -> () ! net {
}

fn middle(inout a: [i64]) -> () ! net {
  probe(inout a);
}

fn demo(inout a: [i64], inout b: [i64]) -> () ! net {
  par {
    set_first(inout b, 2);
    middle(inout a);
  }
}
