// LG13/LG14: an index whose position passes a local inout is evaluated before the `?` and cannot be bound to a
// temporary; still rejected
fn bump(inout y: i64) -> i64
  requires y <= 100
{
  y = y + 1;
  return 0;
}

fn f(a: [i64]) -> Result<i64>
  requires len(a) >= 1 && len(a) <= 100
{
  let mut y: i64 = 0;
  return Ok(a[bump(inout y)] + Err::<i64>(7)?);
}
