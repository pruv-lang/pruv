// P07 header fact reject: the grow exit forgets to rewrite the length word of the larger array
fn valid(st: [i64]) -> bool
{
  let l: i64 = len(st);
  if l < 4 { return false; }
  if st[0] != 77 || st[1] != l || st[2] != l - 4 { return false; }
  let t: i64 = st[3];
  if t < 0 || t > st[2] { return false; }
  return true;
}
fn grow(st: [i64]) -> [i64] ! alloc
  requires valid(st) && len(st) <= 1000000
  ensures valid(result)
{
  let n: i64 = 2 * len(st);
  let mut g: [i64] = resize(st, n, 0);
  g[2] = n - 4;
  return g;
}
