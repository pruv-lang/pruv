// LG27 (G-LG26-3): a str read under a short-circuit guard is assumed valid UTF-8 only on that path
fn width(t: str) -> i64
  ensures result == len(t)
{
  return len(t);
}

fn mk(b: [u8]) -> str ! alloc
  requires len(b) == 1
{
  let ok: bool = false && width(subview(b, 0, 1)) == 1;
  return str_from_utf8(b);
}
pub fn lg27_entry() -> () {
  return;
}
