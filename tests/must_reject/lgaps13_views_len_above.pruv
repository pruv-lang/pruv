// spec: R-6g9-13 reject
// LG12-QK (L-gaps 13): a quantified claim about the prefix sum at k == n + 1 (outside 0..=n) is not provable
fn f(p: [u8]) -> i64 ! alloc
  requires len(p) == 3
  ensures result == 3
{
  let mut out: Vec<ref [u8]> = vec_new::<ref [u8]>();
  vec_push::<ref [u8]>(inout out, subview(p, 0, 1));
  vec_push::<ref [u8]>(inout out, subview(p, 1, 3));
  assert forall k in 2..4: vec_views_len::<ref [u8]>(out, k) == 3;
  let s: [u8] = vec_join::<ref [u8]>(out, []);
  return len(s);
}
