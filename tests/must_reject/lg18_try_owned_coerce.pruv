// LG18 (G-LG14-1): a Vec call result passed to a [i64] parameter before a `?` stays try_position (the Vec to [T]
// coercion applies to places, the temporary would change the parameter type)
fn get(a: i64) -> Result<i64> {
  if a > 0 { return Ok(a); }
  return Err(a);
}
fn see(a: [i64], b: i64) -> i64 { return b; }
fn f() -> Result<i64> ! alloc {
  return Ok(see(vec_new::<i64>(), get(2)?));
}
