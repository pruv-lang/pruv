// L-gaps 16 (LG15-MB): after `move doc.bytes` the binder is partly moved, so moving it whole is refused
struct Doc { bytes: [u8], n: i64 }
enum Parse { Parsed(doc: Doc), Bad(code: i64) }

fn make() -> Parse ! alloc {
  let b: [u8] = alloc(2, 7);
  return Parse::Parsed(Doc { bytes: move b, n: 2 });
}

fn run() -> i64 ! alloc {
  let mut docs: Vec<Doc> = vec_new::<Doc>();
  let q: Parse = make();
  match q {
    Parse::Parsed(doc) => {
      let b: [u8] = move doc.bytes;
      docs = vec_push::<Doc>(move docs, move doc);
    }
    Parse::Bad(code) => {}
  }
  return len(docs);
}
