// LG15 (G-LG13-2): a `?` inside a quantifier stays rejected, also in the right operand of && (no nested-if lowering
// inside a quantifier body); try_position in both compilers
fn half(x: i64) -> Result<i64> {
  if x % 2 == 0 { return Ok(x / 2); }
  return Err(x);
}

fn g(a: [i64]) -> Result<bool>
  requires len(a) <= 10
{
  return Ok(len(a) > 0 && (forall i in 0..len(a): a[i] > 0 && half(a[i])? > 0));
}
