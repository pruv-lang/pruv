// G10 proc A1 gate 1: stdin write, close, read-all and termination after a confirmed spawn verify.
fn session(program: str, cwd: str, input: str) -> Result<i64> ! proc, alloc {
  let args: ProcessArgs = proc_args_new();
  let mut p: Process = proc_spawn(program, args, cwd);
  if !proc_ok(p) {
    return proc_wait(move p);
  }

  p = proc_write_str(move p, input);
  if !proc_ok(p) {
    return proc_kill(move p);
  }

  p = proc_close_stdin(move p);
  if !proc_ok(p) {
    return proc_kill(move p);
  }
  assert !proc_stdin_open(p);

  p = proc_read_all(move p);
  if !proc_ok(p) {
    return proc_kill(move p);
  }

  let so: [u8] = proc_bytes(p, 1);
  let se: [u8] = proc_bytes(p, 2);
  return proc_wait(move p);
}

fn feed(take input: Process, data: [u8]) -> Process ! proc, alloc
  requires proc_ok(input) && proc_stdin_open(input)
{
  let mut p: Process = proc_write_bytes(move input, data);
  if proc_ok(p) {
    p = proc_write_str(move p, "\n");
  }
  return move p;
}
