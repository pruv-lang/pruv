// TIDY 4.11 accept twin of must_reject/cd27_proc_args_len: a new argument list has length 0, two pushes give 2.
fn two(x: str) -> i64 ! alloc
  ensures result == 2
{
  let mut a: ProcessArgs = proc_args_new();
  assert proc_args_len(a) == 0;
  a = proc_args_push(move a, x);
  a = proc_args_push(move a, x);
  return proc_args_len(a);
}
