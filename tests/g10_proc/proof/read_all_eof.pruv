// G10 proc A1 gate 5: read_all gives EOF true on both streams; EOF true and an empty buffer are not equated, so a
// non-empty final buffer is consistent (the claim that the buffer is empty is rejected in g10p_v_eof_empty).
fn drain(take input: Process) -> Process ! proc, alloc
  requires proc_ok(input) && !proc_stdin_open(input)
{
  let p: Process = proc_read_all(move input);
  if proc_ok(p) {
    assert proc_eof(p, 1) && proc_eof(p, 2) && !proc_stdin_open(p);
    assert 0 <= proc_size(p, 1) && 0 <= proc_size(p, 2);
  }
  return move p;
}

fn after_close(take input: Process) -> Process ! proc, alloc
  requires proc_ok(input) && proc_stdin_open(input)
{
  let mut p: Process = proc_close_stdin(move input);
  if proc_ok(p) {
    p = proc_read_all(move p);
  }
  return move p;
}
