// spec: R-6p-4 accept
fn last(a: ref [u16]) -> i64
  requires len(a) > 0
  ensures 0 <= result && result <= 65535
{
  return a[len(a) - 1];
}

fn build(n: i64) -> [u16] ! alloc
  requires 1 <= n && n <= 1000
  ensures len(result) == n + 1
{
  let mut a: [u16] = alloc(n, 65535);
  a[0] = 55296;
  arr_push(inout a, 57343);
  return a;
}

fn run() -> i64 ! alloc {
  let a: [u16] = build(3);
  let b: [u16] = copy(a);
  let v: ref [u16] = subview(b, 1, 4);
  if eq_range(a, 0, b, 0, 4) {
    return last(v) + a[0];
  }
  return 0;
}
