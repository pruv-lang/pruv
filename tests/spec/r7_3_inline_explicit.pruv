// spec: R-7-3 accept
// A generic fn called once keeps inline. A large fn with many call sites keeps always.
#[inline]
fn keep<T>(a: T) -> T { return a; }

#[inline(always)]
fn large(x: i64) -> i64
  requires 0 <= x
{
  let a0: i64 = 0; let a1: i64 = 1; let a2: i64 = 2; let a3: i64 = 3;
  let a4: i64 = 4; let a5: i64 = 5; let a6: i64 = 6; let a7: i64 = 7;
  let a8: i64 = 8; let a9: i64 = 9; let a10: i64 = 10; let a11: i64 = 11;
  let a12: i64 = 12; let a13: i64 = 13; let a14: i64 = 14; let a15: i64 = 15;
  let a16: i64 = 16; let a17: i64 = 17; let a18: i64 = 18; let a19: i64 = 19;
  let a20: i64 = 20; let a21: i64 = 21; let a22: i64 = 22; let a23: i64 = 23;
  let a24: i64 = 24; let a25: i64 = 25; let a26: i64 = 26; let a27: i64 = 27;
  let a28: i64 = 28; let a29: i64 = 29; let a30: i64 = 30; let a31: i64 = 31;
  let a32: i64 = 32; let a33: i64 = 33; let a34: i64 = 34; let a35: i64 = 35;
  let a36: i64 = 36; let a37: i64 = 37; let a38: i64 = 38; let a39: i64 = 39;
  let a40: i64 = 40; let a41: i64 = 41; let a42: i64 = 42; let a43: i64 = 43;
  let a44: i64 = 44; let a45: i64 = 45; let a46: i64 = 46; let a47: i64 = 47;
  let a48: i64 = 48; let a49: i64 = 49; let a50: i64 = 50; let a51: i64 = 51;
  let a52: i64 = 52; let a53: i64 = 53; let a54: i64 = 54; let a55: i64 = 55;
  let a56: i64 = 56; let a57: i64 = 57; let a58: i64 = 58; let a59: i64 = 59;
  let a60: i64 = 60; let a61: i64 = 61; let a62: i64 = 62; let a63: i64 = 63;
  let a64: i64 = 64; let a65: i64 = 65; let a66: i64 = 66; let a67: i64 = 67;
  let a68: i64 = 68; let a69: i64 = 69; let a70: i64 = 70; let a71: i64 = 71;
  let a72: i64 = 72; let a73: i64 = 73; let a74: i64 = 74; let a75: i64 = 75;
  let a76: i64 = 76; let a77: i64 = 77; let a78: i64 = 78; let a79: i64 = 79;
  return x;
}

fn caller(x: i64) -> i64
  requires 0 <= x
{
  return large(x);
}

fn main() -> () ! io {
  print(keep::<i64>(1));
  print(caller(0)); print(large(0)); print(caller(1)); print(large(1));
  print(caller(2)); print(large(2)); print(caller(3)); print(large(3));
  print(caller(4)); print(large(4)); print(caller(5)); print(large(5));
  print(caller(6)); print(large(6)); print(caller(7)); print(large(7));
  print(caller(8)); print(large(8)); print(caller(9)); print(large(9));
  print(caller(10)); print(large(10)); print(caller(11)); print(large(11));
  print(caller(12)); print(large(12)); print(caller(13)); print(large(13));
  print(caller(14)); print(large(14)); print(caller(15)); print(large(15));
  print(caller(16)); print(large(16)); print(caller(17)); print(large(17));
  print(caller(18)); print(large(18)); print(caller(19)); print(large(19));
  print(caller(20)); print(large(20)); print(caller(21)); print(large(21));
  print(caller(22)); print(large(22)); print(caller(23)); print(large(23));
}
