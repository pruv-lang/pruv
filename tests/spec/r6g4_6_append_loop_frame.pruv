// spec: R-6g4-6 reject
fn f(src: [u8]) -> () ! alloc
  requires len(src) == 1
{
  let mut a: [i64] = alloc(0, 0);
  let mut i: i64 = 0;
  while i < 1
    invariant 0 <= i && i <= 1
    invariant len(a) <= i
    decreases 1 - i
  {
    arr_append(inout a, src, 0, 1);
    i = i + 1;
  }
  assert len(a) == 0;
}
