// spec: R-6g9-16 accept
// L-gaps 8 (LG7-A1): the vec_join bound is `2^40` inclusive: a 2^39-byte view joined twice with an empty
// separator is exactly 2^40 bytes, which the verifier accepts.
fn twice(b: [u8]) -> i64 ! alloc
  requires len(b) == 549755813888
{
  let mut out: Vec<ref [u8]> = vec_new::<ref [u8]>();
  vec_push::<ref [u8]>(inout out, subview(b, 0, len(b)));
  vec_push::<ref [u8]>(inout out, subview(b, 0, len(b)));
  let s: [u8] = vec_join::<ref [u8]>(out, subview(b, 0, 0));
  return len(s);
}
