// spec: R-6g9-12 accept
// P10: `swap` / `replace` are contextual names: a program's own functions of those names keep working (hand Rust
// calls the user's `swap(&mut a, &mut b)` / `replace(x, y)`, not `std::mem`).
fn swap(inout a: i64, inout b: i64) -> ()
  requires a >= 0 && a <= 1000 && b >= 0 && b <= 1000
  ensures a == old(a) + old(b) && b == 0
{
  a = a + b;
  b = 0;
}

fn replace(x: i64, y: i64) -> i64
  requires x >= 0 && x <= 1000 && y >= 0 && y <= 1000
  ensures result == x * 2 + y
{
  return x * 2 + y;
}

fn checksum() -> i64 {
  let mut a: i64 = 4;
  let mut b: i64 = 30;
  swap(inout a, inout b);
  assert a == 34 && b == 0;
  return replace(a, 5) * 10 + b;
}
