// spec: R-6g8-5 accept
// A proof clause is checked after its calls are expanded: iso_n(s) reads only s.n, which is still live.
struct Iso { text: [u8], n: i64, tag: [u8] }

fn mk(x: i64) -> Iso ! alloc
  requires 0 <= x && x <= 100
  ensures result.n == x
{
  let a: [u8] = alloc(3, 1);
  let b: [u8] = alloc(2, 2);
  return Iso { text: move a, n: x, tag: move b };
}

fn iso_n(s: Iso) -> i64
  ensures result == s.n
{
  return s.n;
}

pub fn f() -> i64 ! alloc {
  let s: Iso = mk(4);
  let t: [u8] = move s.text;
  assert iso_n(s) == 4;
  return len(t) + s.n;
}
