// spec: R-6x-5 accept
// Methods of a type of a child module: path call `crate::m::T::f(..)` and dot calls on a value of the imported type.
mod geo;
pub fn run(a: i64) -> i64 requires 0 <= a && a <= 100 {
  let mut p: crate::geo::Pt = crate::geo::Pt::at(a);
  p.bump();
  return p.sum() + crate::geo::Pt::sum(p);
}
