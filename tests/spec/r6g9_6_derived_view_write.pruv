// spec: R-6g9-6 reject
// The copy `r` of the old `ref` field still borrows `x` after `u` is rebuilt, so writing `x` while `r` is live
// is type/borrow_conflict; the rebuild kills only `u`'s own borrow.
struct Units { raw: ref [u8], pos: i64 }
pub fn checksum() -> i64 ! alloc {
  let mut x: [u8] = alloc(5, 3);
  let mut u: Units = Units { raw: subview(x, 1, 4), pos: 0 };
  let r: ref [u8] = u.raw;
  u = Units { raw: subview(x, 0, 2), pos: 1 };
  x[0] = 9;
  return len(r) + u.pos;
}
