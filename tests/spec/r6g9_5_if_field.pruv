// spec: R-6g9-5 accept
// A conditional place: d is x.a or x.b; x.c is written only after d's last use (the footprint is x).
struct P { a: i64, b: i64, c: i64 }

fn bump(inout x: P, first: bool) -> ()
  requires x.a < 1000 && x.b < 1000 && x.c < 1000
  ensures first ==> x.a == old(x.a) + 1 && x.b == old(x.b)
  ensures !first ==> x.b == old(x.b) + 1 && x.a == old(x.a)
  ensures x.c == old(x.c) + 1
{
  let d = inout if first { x.a } else { x.b };
  d = d + 1;
  x.c = x.c + 1;
}

pub fn checksum() -> i64
{
  let mut x: P = P { a: 1, b: 2, c: 3 };
  bump(inout x, true);
  bump(inout x, false);
  bump(inout x, false);
  return x.a * 100 + x.b * 10 + x.c;
}
