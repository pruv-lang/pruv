// spec: R-6g-1 accept
fn set_value(inout a: [i64], x: i64) -> i64
  requires len(a) > 0
  ensures a[0] == x
  ensures result == x
{
  a[0] = x;
  return x;
}

fn sum(x: i64, y: i64) -> i64
  requires 0 <= x && x <= 10 && 0 <= y && y <= 10
  ensures result == x + y
{
  return x + y;
}

fn demo() -> i64 ! alloc
  ensures result == 12
{
  let mut d: [i64] = alloc(1, 0);
  let mut e: [i64] = alloc(1, 0);
  let n: i64 = sum(sum(len(alloc(1, 0)), set_value(inout d, 4)), set_value(inout e, 7));
  assert d[0] == 4 && e[0] == 7;
  return n;
}
