// spec: R-6u-9 accept
// `if let`, `let else` and `while let` take the patterns of a `match` arm (nested, literal, `_`, slice) and `|`
// alternatives; each form is proved under its full pattern, so `x != 0` holds after `let Some(Some(x))` past the
// `Some(Some(0))` test.
enum Halt { Done, Stalled, Bad(c: i64) }

fn nested(o: Option<Option<i64>>) -> i64 {
  if let Some(Some(0)) = o { return 0; }
  let Some(Some(x)) = o else { return -1; };
  if x > 0 { return 100 / x; }
  return 1;
}

fn lit(k: i64) -> i64
  ensures k == 3 ==> result == 1
{
  if let 3 | 4 = k { return 1; }
  return 0;
}

fn halt(r: Result<bool, Halt>) -> i64 {
  if let Ok(true) | Err(Halt::Done) = r { return 1; } else if let Err(Halt::Bad(c)) = r { return c; }
  return 0;
}

fn pair(xs: [i64]) -> i64
  requires len(xs) < 10
{
  if let [a, _] = xs { return 1; }
  return 0;
}

fn count(k0: i64) -> i64
  requires 0 <= k0 && k0 < 100
  ensures result <= k0
{
  let mut k: i64 = k0;
  let mut s: i64 = 0;
  while let Some(1) | Some(2) | Some(3) = if k > 0 { Some::<i64>(k) } else { None::<i64> }
    invariant 0 <= k && k <= k0 && 0 <= s && s <= k0 - k
    decreases k
  {
    s = s + 1;
    k = k - 1;
  }
  return s;
}

// an `if let` without else whose alternatives cover every value runs its block
fn all_cases(o: Option<i64>) -> i64
  ensures result == 1
{
  if let Some(_) | None = o { return 1; }
  return 0;
}

enum Inner { Arr(xs: [i64]), Nil }
enum Outer { Wrap(e: Inner), Empty }

// an `@` binder names the payload itself: no copy, so no `! alloc`
fn at_len(w: Outer) -> i64 {
  match w {
    Outer::Wrap(i @ Inner::Arr(s)) => { return len(s); }
    _ => { return 0; }
  }
}
