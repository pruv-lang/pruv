// spec: R-6t-4 accept
// A fixed-length array is a local value: literals, repeat literals, constant lengths, indexing and copies.
// The `<=N` length bound is not a fixed-length array and keeps working.
const K: usize = 2 * 2;

fn first(a: [i64; <=8]) -> i64
  requires len(a) >= 1
{
  return a[0];
}

fn table(k: i64) -> u16
  requires k >= 0 && k < 4
{
  let mut a: [u16; K] = [7; K];
  let b: [u16; 4] = a;
  a[1] = 9;
  let c: [bool; 2] = [true, false];
  let z: [char; 0] = ['x'; 0];
  if c[1] || len(z) != 0 {
    return 0;
  }
  return a[k] + b[3] + u16(len(a));
}

// A loop that writes a fixed array forgets its element values but keeps the element type's range.
fn ranges() -> i64 {
  let mut a: [u8; 2] = [0; 2];
  let mut s: [i16; 2] = [0; 2];
  let mut h: [char; 1] = ['a'; 1];
  let mut k: i64 = 0;
  while k < 2
    invariant 0 <= k && k <= 2
    decreases 2 - k
  {
    a[k] = 255;
    s[k] = -32768;
    h[0] = 'b';
    k = k + 1;
  }
  assert a[1] <= 255 && a[0] >= 0;
  assert s[1] >= -32768 && s[0] <= 32767;
  assert u32(h[0]) <= 1114111 && (u32(h[0]) < 55296 || u32(h[0]) > 57343);
  return 0;
}
