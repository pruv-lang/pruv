// spec: R-6e-20 accept
// A local recursive value moved into vec_push.
enum Tree { Leaf, Branch(xs: Vec<Tree>) }

fn count(t: Tree) -> i64 {
  match t {
    Tree::Leaf => { return 0; }
    Tree::Branch(xs) => { return len(xs); }
  }
}

fn main() -> () ! alloc, io {
  let x: Tree = Tree::Leaf;
  let t: Tree = Tree::Branch(vec_push::<Tree>(vec_new::<Tree>(), move x));
  print(count(t));
}
