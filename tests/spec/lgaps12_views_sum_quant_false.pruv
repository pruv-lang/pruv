// spec: R-6g9-13 reject
// LG11-QS (L-gaps 12): a false claim about a prefix sum of a view list inside a quantifier is refuted quickly
// (it ran past 2 minutes before; the json carries a time bound)
fn f(p: [u8]) -> i64 ! alloc
  requires len(p) == 3
  ensures result == 3
{
  let mut out: Vec<ref [u8]> = vec_new::<ref [u8]>();
  vec_push::<ref [u8]>(inout out, subview(p, 0, 1));
  vec_push::<ref [u8]>(inout out, subview(p, 1, 3));
  assert forall k in 2..3: vec_views_len::<ref [u8]>(out, k) == 4;
  let s: [u8] = vec_join::<ref [u8]>(out, []);
  return len(s);
}
