// spec: R-6-3 accept
// user-named triggers: the sorted fact is used only at the named reads; the verifier still proves every ensures
fn gap(a: [i64]) -> i64
  requires len(a) >= 3
  requires a[0] >= 0
  requires forall t in 0..len(a) trigger a[t]: (forall j in t + 1..len(a) trigger a[j]: a[j] >= a[t])
  ensures result >= 0
{
  return a[2] - a[0];
}

fn low(a: [i64]) -> i64
  requires len(a) >= 1
  ensures exists k in 0..len(a) trigger a[k]: a[k] <= a[0]
{
  return a[0];
}

fn main() -> i64 { return 0; }
