// spec: R-6e-3 accept
struct Sess { card: [u8], n: i64 }
struct St { sessions: HashMap<String, Sess>, total: i64 }

fn put(inout st: St, key: str, data: [u8]) -> i64 ! alloc
  requires len(data) <= 1000 && len(st.sessions) < 1000
{
  st.sessions = map_insert::<String, Sess>(move st.sessions, string_from(key), Sess { card: copy(data), n: len(data) });
  return len(data);
}

fn first(st: St, key: str) -> i64 {
  match map_get::<String, Sess>(st.sessions, key) {
    Some(s) => {
      if len(s.card) > 0 { return s.card[0]; }
      return 0;
    }
    None => { return 0; }
  }
}
