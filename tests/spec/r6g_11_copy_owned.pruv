// spec: R-6g-11 accept
// An owned array from a borrowed view goes through copy (which allocates); the owner is free again after the
// view's last use.
pub fn f() -> i64 ! alloc
{
  let mut b: [u8] = alloc(4, 7);
  let m: ref [u8] = subview(b, 1, 3);
  let o: [u8] = copy(m);
  b = resize(b, 8, 0);
  b[0] = 1;
  return len(o) + o[0] + b[0];
}
