// spec: R-6e-20 accept
// Every in-bounds child is smaller, stated with a quantified contract.
struct Tree { kids: Vec<Tree> }

fn all_smaller(t: Tree) -> i64
  ensures forall i in 0..len(t.kids): size(t.kids[i]) < size(t)
{
  return 0;
}

fn main() -> () ! alloc, io {
  let t: Tree = Tree { kids: vec_new::<Tree>() };
  print(all_smaller(t));
}
