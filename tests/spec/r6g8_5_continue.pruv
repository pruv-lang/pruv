// spec: R-6g8-5 reject
struct Iso { text: [u8], n: i64, tag: [u8] }

fn mk(x: i64) -> Iso ! alloc
  requires 0 <= x && x <= 100
{
  let a: [u8] = alloc(3, 1);
  let b: [u8] = alloc(2, 2);
  return Iso { text: move a, n: x, tag: move b };
}

fn iso_n(s: Iso) -> i64 {
  return s.n;
}

pub fn f() -> i64 ! alloc {
  let mut s: Iso = mk(4);
  let mut i: i64 = 0;
  while i < 2
    invariant 0 <= i && i <= 2
    decreases 2 - i
  {
    let t: [u8] = move s.text;
    i = i + 1;
    if i < 2 {
      continue;
    }
    s.text = move t;
  }
  return i;
}
