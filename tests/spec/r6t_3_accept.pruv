// spec: R-6t-3 accept
// Constants are evaluated at compile time; the proof sees their values.
const SIZE: i64 = 4 * 1024;
const HALF: i64 = SIZE / 2;
const LOW: u8 = u8(HALF % 200);
const FIRST: char = 'A';

fn half(x: i64) -> i64
  requires 0 <= x && x <= SIZE
  ensures result <= HALF
{
  return x / 2;
}

fn low() -> u8
  ensures result == 48
{
  return LOW;
}

fn first() -> char
  ensures u32(result) == 65
{
  return FIRST;
}
