// spec: R-6g8-5 reject
// A labeled continue of the outer loop skips the restore.
struct Iso { text: [u8], n: i64, tag: [u8] }

fn mk(x: i64) -> Iso ! alloc
  requires 0 <= x && x <= 100
  ensures result.n == x
{
  let a: [u8] = alloc(3, 1);
  let b: [u8] = alloc(2, 2);
  return Iso { text: move a, n: x, tag: move b };
}

pub fn f() -> i64 ! alloc {
  let mut s: Iso = mk(4);
  let mut i: i64 = 0;
  'outer: while i < 2
    invariant 0 <= i && i <= 2
    decreases 2 - i
  {
    let t: [u8] = move s.text;
    i = i + 1;
    let mut j: i64 = 0;
    while j < 1
      invariant 0 <= j && j <= 1
      decreases 1 - j
    {
      j = j + 1;
      if i < 2 { continue 'outer; }
    }
    s.text = move t;
  }
  return i;
}
