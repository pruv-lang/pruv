// spec: R-6g9-12 reject
// one field path passed twice: `swap(inout s.data, inout s.data)` is two live `&mut` paths into s
struct Buf { data: [u8], tag: i64 }
fn f() -> i64 ! alloc {
  let d: [u8] = alloc(1, 2);
  let mut s: Buf = Buf { data: move d, tag: 1 };
  swap(inout s.data, inout s.data);
  return s.tag;
}
