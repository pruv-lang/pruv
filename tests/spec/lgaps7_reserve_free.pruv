// spec: R-6g9-10 accept
// LG6-T3: under --no-verify a view-list `vec_reserve` outside `0..=2^40` fails its requires at run time; the
// LLVM backend frees the live heap values (a heap array, an owned `[u8]`, the list's buffer) before it fails.
fn checksum() -> i64 ! alloc {
  let n: i64 = 3;
  let big: [i64] = alloc(100000, 7);
  let own: [u8] = alloc(n, 3);
  let mut names: Vec<ref [u8]> = vec_new::<ref [u8]>();
  vec_push::<ref [u8]>(inout names, own);
  vec_reserve::<ref [u8]>(inout names, 0 - n);
  return len(big) + len(names);
}
