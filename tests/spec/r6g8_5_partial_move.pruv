// spec: R-6g8-5 accept
struct Iso { text: [u8], n: i64, tag: [u8] }
struct Wrap { inner: Iso, k: i64 }

fn mk(x: i64) -> Iso ! alloc
  requires 0 <= x && x <= 100
  ensures result.n == x && len(result.text) == 3 && len(result.tag) == 2
{
  let a: [u8] = alloc(3, 1);
  let b: [u8] = alloc(2, 2);
  return Iso { text: move a, n: x, tag: move b };
}

fn eat(take b: [u8]) -> i64
  ensures result == len(b)
{
  return len(b);
}

fn plain() -> i64 ! alloc
  ensures result == 9
{
  let s: Iso = mk(4);
  let t: [u8] = move s.text;
  return len(t) + s.n + len(s.tag);
}

fn as_arg() -> i64 ! alloc
  ensures result == 10
{
  let s: Iso = mk(5);
  let k: i64 = eat(move s.tag);
  return k + s.n + len(s.text);
}

fn both() -> i64 ! alloc
  ensures result == 11
{
  let s: Iso = mk(6);
  let t: [u8] = move s.text;
  let u: [u8] = move s.tag;
  return len(t) + len(u) + s.n;
}

fn refill() -> i64 ! alloc
  ensures result == 16
{
  let mut s: Iso = mk(7);
  let t: [u8] = move s.text;
  let x: i64 = s.n + len(s.tag);
  s.text = alloc(4, 9);
  let w: Iso = move s;
  return len(t) + x + len(w.text);
}

fn nested() -> i64 ! alloc
  ensures result == 16
{
  let w: Wrap = Wrap { inner: mk(8), k: 3 };
  let t: [u8] = move w.inner.text;
  return len(t) + w.k + w.inner.n + len(w.inner.tag);
}

fn tk(take p: Iso) -> i64
  requires p.n == 3 && len(p.text) == 3 && len(p.tag) == 2
  ensures result == 8
{
  let b: [u8] = move p.text;
  return len(b) + p.n + len(p.tag);
}

fn idx() -> i64 ! alloc
  ensures result == 10
{
  let mut s: Iso = mk(2);
  let t: [u8] = move s.text;
  s.tag[0] = 7;
  return len(t) + s.tag[0];
}

pub fn checksum() -> i64 ! alloc {
  return idx() * 1000000 + tk(mk(3)) * 100000 + plain() * 10000 + as_arg() * 1000 + both() * 100 + refill() * 10 + nested();
}
