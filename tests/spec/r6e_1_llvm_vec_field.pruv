// spec: R-6e-1 accept
// A struct with a Vec<i64> field compiles on LLVM (the field is a shim handle, R-6e-21); clone and drop run once.
struct Rec { id: i64, data: Vec<i64> }

fn pack(take v: Vec<i64>) -> Rec {
  return Rec { id: 7, data: move v };
}

fn first(r: Rec) -> i64 {
  if len(r.data) >= 1 {
    return vec_get::<i64>(r.data, 0);
  }
  return 0;
}

fn main() -> () ! alloc, io {
  let r: Rec = pack(vec_push::<i64>(vec_new::<i64>(), 5));
  print(first(r));
  print(r.id);
}
