// spec: R-6e-10 accept
struct Rec { id: i64, words: Vec<String> }

fn clear_local() -> () ! alloc {
  let mut v: Vec<i64> = vec_new::<i64>();
  v = vec_push::<i64>(move v, 1);
  vec_clear::<i64>(inout v);
  assert len(v) == 0;
}

fn clear_vector(inout v: Vec<i64>) -> () ensures len(v) == 0 {
  vec_clear::<i64>(inout v);
}

fn clear_field(inout m: HashMap<i64, Rec>, k: i64) -> () {
  match map_get_mut::<i64, Rec>(inout m, k) {
    Some(r) => {
      let id: i64 = r.id;
      vec_clear::<String>(inout r.words);
      assert len(r.words) == 0 && r.id == id;
    }
    None => { }
  }
}
