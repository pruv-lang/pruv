// spec: R-6g5-3 accept
fn count(s: str, b: i64) -> i64
  requires 0 <= b && b <= 255
  ensures 0 <= result && result <= len(s)
{
  let mut i: i64 = 0;
  let mut n: i64 = 0;
  while i < len(s)
    invariant 0 <= i && i <= len(s) + 1
    invariant 0 <= n && n <= i && n <= len(s)
    decreases len(s) + 1 - i
  {
    let j: i64 = find_byte(s, b, i, len(s));
    if j < len(s) {
      assert s[j] == b;
      n = n + 1;
    }
    i = j + 1;
  }
  return n;
}
fn skip(a: [u8], lo: i64) -> i64
  requires 0 <= lo && lo <= len(a)
  ensures lo <= result && result <= len(a)
  ensures forall k in lo..result: a[k] != 32
{
  return find_byte(a, 32, lo, len(a));
}
pub fn checksum() -> i64 ! alloc {
  let s: str = "a,b,,cd,e";
  let mut a: [u8] = alloc(6, 32);
  a[4] = 120;
  a[5] = 32;
  let lit: i64 = find_byte("xyz:w", 58, 0, 5);
  let none: i64 = find_byte(a, 7, 2, 2);
  let t: i64 = skip(a, 1);
  let mut u: i64 = 0;
  a[1] = 33;
  u = skip(a, 1);
  return count(s, 44) * 1000 + lit * 100 + none * 10 + t + u;
}
