// spec: R-6g9-4 accept
// P10 (G-B4-Q1): a store evaluates its index and value before it writes the target, so a view whose last read is
// in the stored value is dead at the write (hand Rust `b[0] = m[0];` under NLL).
struct S { t: [i64], n: i64 }
fn g() -> i64 ! alloc
  ensures result == 9
{
  let mut b: [i64] = alloc(3, 4);
  let m: ref [i64] = subview(b, 1, 3);
  b[0] = m[0] + 1;
  return b[0] + b[1];
}
fn h() -> i64 ! alloc
  ensures result == 14
{
  let mut s: S = S { t: alloc(3, 4), n: 0 };
  let m: ref [i64] = subview(s.t, 1, 3);
  s.t[m[0] - 4] = m[1] + 1;
  let k: ref [i64] = subview(s.t, 0, 2);
  s.n = k[0] + k[1];
  return s.n + s.t[0];
}
fn run() -> () ! io, alloc { print(g()); print(h()); }
