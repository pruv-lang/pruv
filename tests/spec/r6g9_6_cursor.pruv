// spec: R-6g9-6 accept
// The jstr J1 cursor (hand `body_units`): a borrowing struct with a `ref` field and an owned position, held in a
// `let mut` local and advanced through an `inout` parameter (Rust `fn next(u: &mut Units<'_>)`). A whole
// assignment rebinds the cursor to another view of the same source and kills the old borrow, so the source may
// be written between the last use and the reassignment, and again after the last use.
struct Units { raw: ref [u8], pos: i64 }
fn next(inout u: Units) -> i64
  requires 0 <= u.pos && u.pos < len(u.raw)
  ensures u.pos == old(u.pos) + 1 && len(u.raw) == len(old(u.raw)) && 0 <= result && result <= 255
{
  let b: i64 = u.raw[u.pos];
  u.pos = u.pos + 1;
  return b;
}
pub fn checksum() -> i64 ! alloc {
  let mut x: [u8] = alloc(5, 3);
  let mut u: Units = Units { raw: subview(x, 1, 4), pos: 0 };
  let mut sum: i64 = 0;
  while u.pos < len(u.raw)
    invariant 0 <= u.pos && u.pos <= len(u.raw) && len(u.raw) == 3 && 0 <= sum && sum <= 255 * u.pos
    decreases len(u.raw) - u.pos
  {
    sum = sum + next(inout u);
  }
  x[0] = 7;
  u = Units { raw: subview(x, 0, 2), pos: 1 };
  sum = sum * 10 + next(inout u);
  x[1] = 1;
  return sum * 10 + x[0] + x[1];
}
