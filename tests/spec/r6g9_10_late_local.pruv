// spec: R-6g9-10 reject
// A list may hold only views of data declared before it in an enclosing block (it is dropped last).
fn f(p: str, c: bool) -> i64 ! alloc
  requires len(p) >= 2
{
  let mut parts: Vec<ref str> = vec_new::<ref str>();
  if c {
    let s: str = substr(p, 0, 1);
    vec_push::<ref str>(inout parts, s);
  }
  return len(parts);
}
fn main() -> i64 ! alloc { if f("ab", true) == 1 { return 0; } return 1; }
