// spec: R-6g-11 reject
// A view of an owned field of a borrowing-struct `from` parameter lives in the caller's record, which
// `&Doc<'a>` does not lend to the result.
struct Doc { src: ref [u8], scratch: [u8], n: i64 }
fn tail(d: Doc) -> ref [u8] from(d) { return subview(d.scratch, 0, 0); }
pub fn f(x: [u8], take y: [u8]) -> i64 { let d: Doc = Doc { src: x, scratch: move y, n: 0 }; let s: ref [u8] = tail(d); return len(s); }
