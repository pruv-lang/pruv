// spec: R-6g-11 accept
// A borrowing local passed at a `from` position lends what it borrows, not its own storage:
// `fn body_of<'a>(d: &Doc<'a>) -> &'a [u8]`, so `g` returns a view of `src` through a local `Doc`.
struct Doc { src: ref [u8], n: i64 }
fn parse(src: [u8]) -> Doc from(src) { return Doc { src: src, n: len(src) }; }
fn body_of(d: Doc) -> ref [u8] from(d) { return d.src; }
fn g(src: [u8]) -> ref [u8] from(src) {
  let d: Doc = parse(src);
  return body_of(d);
}
pub fn f(x: [u8]) -> i64 { let s: ref [u8] = g(x); return len(s); }
