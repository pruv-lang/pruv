// spec: R-6e-17 accept
pub struct Sess { blob: Vec<i64> }

fn array_len(a: [i64]) -> i64 ensures result == len(a) {
  return len(a);
}

fn session_len(inout session: Sess) -> i64 ensures result == len(session.blob) {
  return array_len(session.blob);
}

fn first(a: [i64]) -> i64
  requires len(a) > 0
  ensures result == a[0]
{
  return a[0];
}

fn first_flag(a: [bool]) -> bool
  requires len(a) > 0
  ensures result == a[0]
{
  return a[0];
}

fn check() -> i64 ! alloc ensures result == 7 {
  let v: Vec<i64> = vec_push::<i64>(vec_new::<i64>(), 7);
  let flags: Vec<bool> = vec_push::<bool>(vec_new::<bool>(), true);
  let n: i64 = array_len(v);
  let flag: bool = first_flag(flags);
  assert n == 1;
  assert flag;
  return first(v);
}
