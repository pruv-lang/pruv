// spec: R-6-2 reject
// an ensures that names a pred is proved from the expansion; a result that breaks it fails
struct Doc { tape: [i64], n: i64 }

pred fn tape_ok(d: Doc) -> bool {
  return len(d.tape) == 2 * d.n && (forall t in 0..d.n: d.tape[2 * t] >= 0);
}

fn build(n: i64) -> Doc ! alloc
  requires 1 <= n && n < 1000
  ensures tape_ok(result)
{
  let tape: [i64] = alloc(2 * n, 0 - 1);
  return Doc { tape: copy(tape), n: n };
}

fn main() -> i64 { return 0; }
