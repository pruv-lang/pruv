// spec: R-6g9-5 accept
// The index of v[j] is evaluated once at the binding: j itself is not frozen and may change while d is live.
fn bump(inout v: [i64], i: i64) -> i64
  requires 0 <= i && i < len(v) && v[i] < 1000
  ensures result == i + 1
  ensures len(v) == old(len(v))
  ensures v[i] == old(v[i]) + 1
{
  let mut j: i64 = i;
  let d = inout v[j];
  j = j + 1;
  d = d + 1;
  return j;
}

pub fn checksum() -> i64 ! alloc
{
  let mut v: [i64] = alloc(3, 4);
  let k: i64 = bump(inout v, 1);
  return v[1] * 10 + k;
}
