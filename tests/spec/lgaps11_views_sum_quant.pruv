// spec: R-6g9-13 accept
// L-gaps 10 A2 (L-gaps 11): the prefix sums of one view list read outside a quantifier (per-term sum) and inside
// one (array-keyed sum) agree.
fn f(p: [u8]) -> i64 ! alloc
  requires len(p) == 3
  ensures result == 3
{
  let mut out: Vec<ref [u8]> = vec_new::<ref [u8]>();
  vec_push::<ref [u8]>(inout out, subview(p, 0, 1));
  vec_push::<ref [u8]>(inout out, subview(p, 1, 3));
  assert vec_views_len::<ref [u8]>(out, 1) == 1;
  assert forall k in 1..2: vec_views_len::<ref [u8]>(out, k) == vec_views_len::<ref [u8]>(out, 1);
  assert forall k in 2..3: vec_views_len::<ref [u8]>(out, k) == 3;
  let s: [u8] = vec_join::<ref [u8]>(out, []);
  return len(s);
}
