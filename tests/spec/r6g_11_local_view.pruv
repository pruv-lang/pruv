// spec: R-6g-11 accept
// G-DB63-1: a subview bound to a local is a borrowed view (no copy); its source stays readable.
fn width(t: str) -> i64 { return len(t); }
pub fn f(x: [u8], s: str) -> i64
  requires len(x) >= 4 && len(s) >= 1 && is_char_boundary(s, 1)
{
  let m: ref [u8] = subview(x, 1, 3);
  let w: ref str = subview(s, 0, 1);
  let k: i64 = x[0];
  return m[0] + m[1] + k + width(w) + len(w);
}
