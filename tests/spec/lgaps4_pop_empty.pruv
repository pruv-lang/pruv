// spec: R-6g9-11 reject
// vec_pop needs len(parts) >= 1: popping a list that may be empty fails to verify.
fn f(p: [u8], k: i64) -> i64 ! alloc {
  let mut parts: Vec<ref [u8]> = vec_new::<ref [u8]>();
  if k > 0 { vec_push::<ref [u8]>(inout parts, p); }
  vec_pop::<ref [u8]>(inout parts);
  return len(parts);
}
fn main() -> i64 ! alloc { let b: [u8] = alloc(1, 1); if f(b, 1) == 0 { return 0; } return 1; }
