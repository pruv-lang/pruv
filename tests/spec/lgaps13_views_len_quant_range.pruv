// spec: R-6g9-13 accept
// LG12-QK (L-gaps 13): inside 0..=n the quantified prefix sums are proved (the in-range partner of the k == -1 / n + 1 rejects)
fn f(p: [u8]) -> i64 ! alloc
  requires len(p) == 3
  ensures result == 3
{
  let mut out: Vec<ref [u8]> = vec_new::<ref [u8]>();
  vec_push::<ref [u8]>(inout out, subview(p, 0, 1));
  vec_push::<ref [u8]>(inout out, subview(p, 1, 3));
  assert forall k in 0..3: 0 <= vec_views_len::<ref [u8]>(out, k) && vec_views_len::<ref [u8]>(out, k) <= 3;
  let s: [u8] = vec_join::<ref [u8]>(out, []);
  return len(s);
}
