// spec: R-6o-1 R-6o-2 R-6o-3 R-6o-4 accept
// an opaque bool predicate: callers see a symbol; `reveal` gives the body on this path; the guarded body is total
pub opaque fn good(a: [i64], i: i64) -> bool
{ return 0 <= i && i < len(a) && a[i] > 0; }

fn keep(a: [i64], i: i64) -> i64
  requires good(a, i)
  ensures good(a, i) && result == 0
{ return 0; }

pub fn read(a: [i64], i: i64) -> i64
  requires good(a, i)
  ensures result > 0
{
  reveal good;
  return a[i];
}
