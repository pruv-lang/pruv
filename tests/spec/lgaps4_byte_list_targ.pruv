// spec: R-6g9-11 reject
// An operation names the list's own element: a `str` operation on a `[u8]` list is a signature error.
fn f(p: str) -> i64 ! alloc {
  let mut parts: Vec<ref [u8]> = vec_new::<ref [u8]>();
  vec_push::<ref str>(inout parts, p);
  return len(parts);
}
fn main() -> i64 ! alloc { if f("ab") == 1 { return 0; } return 1; }
