// spec: R-6g9-6 accept
// A place binding of an owned field of a `let mut` borrowing struct (Rust `let d = &mut u.pos;`).
struct Units { raw: ref [u8], pos: i64 }
pub fn checksum() -> i64 ! alloc {
  let x: [u8] = alloc(5, 3);
  let mut u: Units = Units { raw: subview(x, 1, 4), pos: 0 };
  let d = inout u.pos;
  d = 4;
  return u.pos * 10 + len(u.raw);
}
