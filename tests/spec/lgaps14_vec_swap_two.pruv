// spec: R-6g9-12 reject
// L-gaps 14 (P10-M1): a swap of Vec elements takes two elements of the same Vec.
fn mix() -> i64 ! alloc {
  let mut v: Vec<i64> = vec_new::<i64>();
  v = vec_push::<i64>(move v, 1);
  v = vec_push::<i64>(move v, 2);
  v = vec_push::<i64>(move v, 3);
  v = vec_push::<i64>(move v, 4);
  let mut w: Vec<i64> = vec_new::<i64>();
  w = vec_push::<i64>(move w, 5);
  swap(inout v[0], inout w[0]);
  return vec_get::<i64>(v, 0);
}
