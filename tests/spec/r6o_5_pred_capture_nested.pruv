// spec: R-6o-5 reject
// the binders of an opaque pred called inside the body count too: q(i) inlines to p(i), whose forall binds i
pub opaque pred fn p(x: i64) -> bool {
  return forall i in 0..1: x == i;
}

pub opaque pred fn q(y: i64) -> bool {
  return p(y);
}

pub fn zero(i: i64) -> i64
  requires q(i)
  ensures result == 0
{ return 0; }
