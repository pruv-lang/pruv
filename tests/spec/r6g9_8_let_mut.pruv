// spec: R-6g9-8 reject
// A wrapper of a view may be an immutable `let` only.
fn head(s: [u8]) -> Option<ref [u8]> from(s) { return Some::<ref [u8]>(s); }
fn f() -> i64 ! alloc {
  let b: [u8] = alloc(4, 1);
  let mut h: Option<ref [u8]> = head(b);
  match h { Some(v) => { return len(v); } None => { return 0; } }
}
