// spec: R-6g9-11 reject
// The list starts as vec_new of its own element type.
fn f(p: [u8]) -> i64 ! alloc {
  let mut parts: Vec<ref [u8]> = vec_new::<ref str>();
  vec_push::<ref [u8]>(inout parts, p);
  return len(parts);
}
fn main() -> i64 ! alloc { let b: [u8] = alloc(1, 1); if f(b) == 1 { return 0; } return 1; }
