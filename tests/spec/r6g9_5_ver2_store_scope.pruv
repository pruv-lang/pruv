// spec: R-6g9-5 accept
fn scoped(inout x: i64, inout y: i64, c: bool) -> i64
  ensures result == 6 && x == 1 && y == 2
{
  let a = inout x;
  if c {
    let b = inout y;
    b = 2;
  } else {
    let b = inout y;
    b = 2;
  }
  let mut b: i64 = 0;
  b = 3;
  a = 1;
  b = b + 3;
  return b;
}

pub fn main_value() -> i64 { return 0; }
