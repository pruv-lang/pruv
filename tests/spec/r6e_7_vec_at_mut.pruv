// spec: R-6e-7 accept
struct Rec { count: i64, names: Vec<String> }
fn f(i: i64) -> i64 ! alloc
  ensures i == 0 ==> result == 7
  ensures i != 0 ==> result == 5
{
  let mut v: Vec<Rec> = vec_push::<Rec>(vec_new::<Rec>(), Rec { count: 5, names: vec_new::<String>() });
  match vec_at_mut::<Rec>(inout v, i) {
    Some(r) => { r.count = 7; }
    None => { }
  }
  assert len(v) == 1;
  return vec_get::<Rec>(v, 0).count;
}
