// spec: R-6e-3 reject
struct Sess { card: [u8], n: i64 }

fn put(take m: HashMap<String, Sess>, key: str, data: [u8]) -> i64 ! alloc
  requires len(data) <= 1000 && len(m) < 1000
{
  let s: Sess = Sess { card: copy(data), n: 1 };
  let m2: HashMap<String, Sess> = map_insert::<String, Sess>(move m, string_from(key), move s);
  return len(s.card);
}
