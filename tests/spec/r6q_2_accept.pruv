// spec: R-6q-2 accept
struct Bag { items: [i64] }

fn units(a: ref [u16]) -> i64
  requires len(a) <= 1000
  ensures 0 <= result && result <= 65535000
{
  let mut s: i64 = 0;
  for x in a invariant 0 <= s && s <= index(x) * 65535 { s = s + x; }
  return s;
}

fn bag(b: Bag) -> i64
  requires len(b.items) <= 100
  requires forall k in 0..len(b.items): 0 <= b.items[k] && b.items[k] <= 10
  ensures 0 <= result && result <= 1000
{
  let mut s: i64 = 0;
  for x in b.items invariant 0 <= s && s <= index(x) * 10 { s = s + x; }
  return s;
}

fn vsum(v: Vec<i64>) -> i64
  requires len(v) <= 100
  requires forall k in 0..len(v): 0 <= v[k] && v[k] <= 10
  ensures 0 <= result && result <= 1000
{
  let mut s: i64 = 0;
  for x in v invariant 0 <= s && s <= index(x) * 10 { s = s + x; }
  return s;
}
