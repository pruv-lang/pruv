// spec: R-6d-1 R-6e-9 accept
trusted rust fn words() -> Vec<String> ! alloc
  ensures len(result) <= 4
  = "::std::vec::Vec::new";

fn text_len(s: str) -> i64 { return len(s); }

fn visit() -> i64 ! alloc {
  let v: Vec<String> = words();
  let mut i: i64 = 0;
  while i < len(v)
    invariant 0 <= i && i <= len(v)
    decreases len(v) - i
  {
    let n: i64 = text_len(vec_get::<String>(v, i));
    i = i + 1;
  }
  return i;
}
