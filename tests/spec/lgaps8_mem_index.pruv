// spec: R-6g9-12 accept
// L-gaps 8 (P10-M1): an element `v[i]` of a resizable array is a swap / replace place (hand Rust `v.swap(i, j)` /
// `std::mem::replace(&mut v[i], x)`): each index carries the range obligation, the two places of a swap are proven
// distinct, the verifier knows the moved elements, and a loop that swaps elements of `v` havocs `v`.

fn rev(inout v: [i64]) -> ()
  ensures len(v) == len(old(v))
{
  let n: i64 = len(v);
  let mut i: i64 = 0;
  while i < n / 2
    invariant 0 <= i && i <= n / 2 && len(v) == n
    decreases n / 2 - i
  {
    let j: i64 = n - 1 - i;
    swap(inout v[i], inout v[j]);
    i = i + 1;
  }
}

fn ints() -> i64 ! alloc
  ensures result == 6033 || result == 0
{
  let mut v: [i64] = alloc(4, 0);
  v[0] = 1;
  v[1] = 2;
  v[2] = 3;
  v[3] = 4;
  swap(inout v[0], inout v[3]);
  assert v[0] == 4 && v[3] == 1 && v[1] == 2;
  let was: i64 = replace(inout v[1], 20);
  assert was == 2 && v[1] == 20;
  let sum: i64 = v[0] * 1000 + v[1] * 100 + v[2] * 10 + v[3] + was;
  rev(inout v);
  assert len(v) == 4;
  if v[0] == 1 && v[1] == 3 && v[2] == 20 && v[3] == 4 {
    return sum;
  }
  return 0;
}

fn bytes() -> i64 ! alloc
  ensures result == 1114
{
  let mut b: [u8] = alloc(3, 7);
  b[2] = 9;
  swap(inout b[0], inout b[2]);
  let was: i64 = replace(inout b[1], 200);
  assert b[0] == 9 && b[1] == 200 && b[2] == 7 && was == 7;
  return b[0] * 100 + b[1] + b[2] + was;
}

fn flags() -> i64 ! alloc
  ensures result == 101
{
  let mut f: [bool] = alloc(3, false);
  f[0] = true;
  swap(inout f[0], inout f[2]);
  let was: bool = replace(inout f[1], true);
  assert !f[0] && f[1] && f[2] && !was;
  let mut r: i64 = 0;
  if f[2] {
    r = r + 100;
  }
  if f[1] {
    r = r + 1;
  }
  return r;
}

fn checksum() -> i64 ! alloc {
  let mut w: [i64] = alloc(3, 0);
  w[0] = 5;
  w[2] = 8;
  rev(inout w);
  let k: i64 = 1;
  let first: i64 = replace(inout w[k - 1], 6);
  let mut r: i64 = ints() * 1000000 + bytes() * 1000 + flags();
  if first == 8 && w[0] == 6 && w[1] == 0 && w[2] == 5 {
    r = r + 7000000000;
  }
  return r;
}
