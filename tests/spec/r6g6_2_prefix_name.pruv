// spec: R-6g6-2 reject
fn hint(a: [i64]) -> bool
  ensures result ==> (forall t in 0..len(a): count(k in 0..a[t]: true) <= a[t])
{
  return false;
}

pub fn bad(lam: [i64], tape: [i64]) -> i64 ! alloc
  requires len(lam) > 0 && len(tape) >= 2
{
  let p: [i64] = copy(subview(tape, 0, 1));
  let q: [i64] = copy(subview(tape, 1, 2));
  let x: bool = hint(p);
  let y: bool = hint(q);
  assert lam[0] == tape[1];
  return 0;
}
