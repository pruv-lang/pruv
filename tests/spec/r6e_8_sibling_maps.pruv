// spec: R-6e-8 accept
struct Budget { active_ms: i64, limit_ms: i64 }
struct Clock { since_ms: i64, armed: bool }
struct St { sessions: HashMap<String, Budget>, clocks: HashMap<String, Clock> }
fn refresh(inout st: St, sid: str, bid: str, now: i64) -> () {
  match map_get_mut::<String, Budget>(inout st.sessions, sid) {
    Some(budget) => {
      match map_get_mut::<String, Clock>(inout st.clocks, bid) {
        Some(clock) => {
          if 0 <= clock.since_ms && clock.since_ms <= now && now <= 1000000 && 0 <= budget.active_ms && budget.active_ms <= 1000000 {
            budget.active_ms = budget.active_ms + (now - clock.since_ms);
          }
          clock.armed = budget.active_ms < budget.limit_ms;
        }
        None => { }
      }
    }
    None => { }
  }
}
