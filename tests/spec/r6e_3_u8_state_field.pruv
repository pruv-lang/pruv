// spec: R-6e-3 accept
struct Sess { card: [u8], n: i64 }
struct St { cur: Sess, list: Vec<Sess> }

fn set(inout st: St, data: [u8]) -> i64 ! alloc
  requires len(data) <= 1000 && len(st.list) < 1000
{
  st.cur = Sess { card: copy(data), n: 1 };
  st.list = vec_push::<Sess>(move st.list, Sess { card: copy(data), n: 2 });
  return len(st.cur.card);
}

fn top(st: St) -> i64
  requires len(st.list) >= 1
{
  let c: i64 = len(vec_get::<Sess>(st.list, 0).card);
  return c;
}
