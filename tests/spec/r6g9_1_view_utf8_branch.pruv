// spec: R-6g9-1 accept
fn head(s: [u8]) -> ref [u8] from(s)
  requires len(s) >= 2
  ensures len(result) == 1
{
  return subview(s, 0, 1);
}
// str_from_utf8 of an array a live view reads, at its last use inside a branch, stays a copy: the str never takes
// the block the view reads (t is freed at the end of the branch; a same-size heap alloc after it would reuse that block).
fn nines() -> [u8] ! alloc
  ensures len(result) == 2
{
  return alloc(2, 9);
}
pub fn checksum() -> i64 ! alloc {
  let s: [u8] = alloc(2, 7);
  let v: ref [u8] = head(s);
  if true {
    let t: str = str_from_utf8(s);
  }
  let w: [u8] = nines();
  return v[0] + w[1] - 9;
}
