// spec: R-6g9-10 reject
// The LLVM backend keeps a list of borrowed views natively, but a list of owned Strings next to it still needs the
// Rust backend: only the view list is lowered, so the error is on the owned list's line.
fn f(p: str) -> i64 ! alloc {
  let mut parts: Vec<ref str> = vec_new::<ref str>();
  let mut owned: Vec<String> = vec_new::<String>();
  vec_push::<ref str>(inout parts, p);
  return len(parts) + len(owned);
}
fn main() -> i64 ! alloc { if f("ab") == 1 { return 0; } return 1; }
