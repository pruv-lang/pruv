// spec: R-6e-4 accept
pub struct Record { hits: i64, log: Vec<i64> }
pub struct St { count: i64, recs: HashMap<i64, Record> }

pub fn touch(inout st: St, k: i64, x: i64) -> i64 ! alloc
  requires x >= 0 && x <= 1000000
{
  let mut res: i64 = 1;
  match map_get_mut::<i64, Record>(inout st.recs, k) {
    Some(r) => {
      if r.hits <= 1000000000000 && len(r.log) < 1000000 {
        r.hits = r.hits + x;
        r.log = vec_push::<i64>(move r.log, x);
        res = 0;
      } else {
        res = 2;
      }
    }
    None => { }
  }
  return res;
}
