// spec: R-5-1 accept
// copy_range then eq_range over the same ranges is true, for [i64] and for [u8].
pub fn then_eq(inout dst: [i64], i: i64, src: [i64], j: i64, n: i64) -> bool
  requires 0 <= i && 0 <= j && 0 <= n && i + n <= len(dst) && j + n <= len(src)
  ensures result
{
  copy_range(inout dst, i, src, j, n);
  return eq_range(dst, i, src, j, n);
}

pub fn then_eq8(inout dst: [u8], i: i64, src: [u8], j: i64, n: i64) -> bool
  requires 0 <= i && 0 <= j && 0 <= n && i + n <= len(dst) && j + n <= len(src)
  ensures result
{
  copy_range(inout dst, i, src, j, n);
  return eq_range(dst, i, src, j, n);
}
