// spec: R-6g9-6 accept
// A view taken from an owned field of a `let mut` borrowing struct ends at its last use; the struct may then be
// rebuilt as a whole (Rust `p = Parser { .. }` after the last use of `t`).
struct Parser { input: ref [u8], pos: i64, tape: [u8] }
pub fn checksum() -> i64 ! alloc {
  let x: [u8] = alloc(5, 3);
  let t0: [u8] = alloc(3, 2);
  let t1: [u8] = alloc(1, 1);
  let mut p: Parser = Parser { input: x, pos: 0, tape: move t0 };
  let t: ref [u8] = subview(p.tape, 0, 2);
  let n: i64 = len(t) + t[1];
  p = Parser { input: subview(x, 1, 3), pos: n, tape: move t1 };
  return p.pos * 10 + len(p.input) + len(p.tape);
}
