// spec: R-6g9-6 reject
// A whole rebind of a `let mut` borrowing struct that moves a root its new value borrows conflicts with the new
// view, as a `let` does (rustc E0505 for `p = Parser { input: &x[1..3], tape: x, .. }`).
struct Parser { input: ref [u8], pos: i64, tape: [u8] }
pub fn checksum() -> i64 ! alloc {
  let x: [u8] = alloc(5, 3);
  let t0: [u8] = alloc(3, 2);
  let t1: [u8] = alloc(1, 1);
  let mut p: Parser = Parser { input: x, pos: 0, tape: move t0 };
  let t: ref [u8] = subview(p.tape, 0, 2);
  let n: i64 = len(t) + t[1];
  p = Parser { input: subview(x, 1, 3), pos: n, tape: move x };
  return p.pos * 10 + len(p.input) + len(p.tape);
}
