// spec: R-6g7-1 accept
// A unit Result crosses the host boundary (zero-word Ok payload) and appears in contracts.
fn take(r: Result<(), i64>) -> i64
  requires is_ok(r) || (err_val(r) > 0 && err_val(r) < 1000)
  ensures result >= 0 && result < 1000
  ensures is_ok(r) ==> result == 0
{
  match r {
    Ok(()) => { return 0; }
    Err(e) => { return e; }
  }
}

fn gate(n: i64) -> Result<(), i64>
  requires n > -1000 && n < 1000
  ensures (n >= 0) ==> result == Ok::<(), i64>(())
  ensures (n < 0) ==> result == Err::<(), i64>(0 - n)
{
  if n < 0 { return Err::<(), i64>(0 - n); }
  return Ok::<(), i64>(());
}

fn only_ok(r: Result<(), i64>, s: Result<(), i64>) -> i64
  requires r == Ok::<(), i64>(())
  requires s != r
  ensures result == 1
{
  return 1;
}

fn checksum() -> i64 {
  let x: i64 = take(gate(5));
  let y: i64 = take(gate(-7));
  let z: i64 = only_ok(gate(1), gate(-2));
  return x * 10 + y + z * 100;
}
