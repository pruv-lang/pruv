// spec: R-6r-3 accept
// The `loop { .. break v }` shape written today: a measured while with a local result.
fn find_root(n: i64) -> i64
  requires 0 <= n && n <= 1000
  ensures 0 <= result && result * result <= n
{
  let mut r: i64 = 0;
  while r < n invariant 0 <= r && r <= n && r * r <= n decreases n - r {
    if (r + 1) * (r + 1) > n { break; }
    r = r + 1;
  }
  return r;
}
