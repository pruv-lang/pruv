// spec: R-6g9-7 accept
// Field lending (hand `fn record(&self, id) -> &[i64] { &self.tape[a..b] }`): `from(doc.tape)` names an owned
// field of a read parameter, so the `ref [i64]` result borrows the caller's document storage, not what the
// document borrows. Rust `fn record<'a>(doc: &'a Document<'_>, id: i64) -> &'a [i64]`; LLVM returns the
// `{ ptr, i64 }` pair of the tape. A `ref [bool]` view works the same way.
struct Document { source: ref [u8], tape: [i64] }
fn parse(src: [u8]) -> Document from(src) ! alloc
  requires len(src) <= 100
  ensures len(result.source) == len(src) && len(result.tape) == 2 * len(src)
{
  let mut t: [i64] = alloc(2 * len(src), 0);
  let mut i: i64 = 0;
  while i < len(src)
    invariant 0 <= i && i <= len(src) && len(t) == 2 * len(src)
    decreases len(src) - i
  {
    t[2 * i] = i;
    t[2 * i + 1] = src[i];
    i = i + 1;
  }
  return Document { source: src, tape: move t };
}
fn record(doc: Document, id: i64) -> ref [i64] from(doc.tape)
  requires 0 <= id && 2 * id + 2 <= len(doc.tape)
  ensures len(result) == 2
{
  return subview(doc.tape, 2 * id, 2 * id + 2);
}
fn window(f: [bool], lo: i64, hi: i64) -> ref [bool] from(f)
  requires 0 <= lo && lo <= hi && hi <= len(f)
  ensures len(result) == hi - lo
{
  return subview(f, lo, hi);
}
pub fn checksum() -> i64 ! alloc {
  let x: [u8] = alloc(5, 7);
  let d: Document = parse(x);
  let r: ref [i64] = record(d, 3);
  let fl: [bool] = alloc(4, true);
  let b: ref [bool] = window(fl, 1, 3);
  let mut extra: i64 = 0;
  if b[1] { extra = 1000; }
  if r[0] == 3 { extra = extra + 300; }
  if r[1] == 7 { extra = extra + 70; }
  return extra + len(r) + len(b) + len(d.source);
}
