// spec: R-6b-5 reject
// A position after a byte >= 128 is not known to be a boundary: after a lead byte (0xC3) the next byte is a
// continuation byte in valid UTF-8, so the cut is utf8_boundary.
fn cut(s: str, i: i64) -> i64 ! alloc
  requires 0 < i && i < len(s) && s[i - 1] == 195
{
  let t: str = substr(s, 0, i);
  return len(t);
}
