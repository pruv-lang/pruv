// spec: R-6b-5 accept
// 4.4d-CB: hand `query_range` finds `<q>`..`</q>` and returns the inner range; the receiver cuts `&text[range]` with no
// run-time boundary test. A position right after an ASCII byte (`>`) or at an ASCII byte (`<`) is a char boundary of a
// `str`, so the finder ensures it and the receiver's `subview` / `substr` need no `is_char_boundary` check.
fn tag_at(s: str, at: i64, lit: str) -> bool
  requires 0 <= at
  ensures result ==> at + len(lit) <= len(s) && (forall k in 0..len(lit): s[at + k] == lit[k])
{
  if at > len(s) || len(lit) > len(s) - at { return false; }
  return eq_range(s, at, lit, 0, len(lit));
}

struct Span { lo: i64, hi: i64 }

fn inner(s: str) -> Span
  ensures result.lo == -1 || (0 < result.lo && result.lo <= result.hi && result.hi < len(s))
  ensures result.lo == -1 || (is_char_boundary(s, result.lo) && is_char_boundary(s, result.hi))
{
  let n: i64 = len(s);
  if n < 7 || !tag_at(s, 0, "<q>") || !tag_at(s, n - 4, "</q>") { return Span { lo: -1, hi: -1 }; }
  // s[2] == '>' (62) and s[n - 4] == '<' (60): both ASCII
  return Span { lo: 3, hi: n - 4 };
}

fn count_bytes(t: str) -> i64
  ensures result == len(t)
{
  return len(t);
}

fn query_len(text: str) -> i64
  ensures result >= -1
{
  let q: Span = inner(text);
  if q.lo < 0 { return -1; }
  // hand: Some(range) => &text[range]; no is_char_boundary test at run time
  return count_bytes(subview(text, q.lo, q.hi));
}

fn query_copy(text: str) -> i64 ! alloc
  ensures result >= -1
{
  let q: Span = inner(text);
  if q.lo < 0 { return -1; }
  let t: str = substr(text, q.lo, q.hi);
  return len(t);
}

fn main() -> i64 ! alloc {
  let a: i64 = query_len("<q>héllo</q>");
  let b: i64 = query_copy("<q>é</q>");
  let c: i64 = query_len("plain");
  if a == 6 && b == 2 && c == -1 { return 0; }
  return 1;
}
