// spec: R-6e-6 accept
struct Rec { count: i64, runs: HashMap<i64, bool> }
fn f() -> i64 ! alloc
  ensures result == 7
{
  let mut m: HashMap<i64, Rec> = map_insert::<i64, Rec>(
    map_new::<i64, Rec>(), 1, Rec { count: 7, runs: map_new::<i64, bool>() });
  m = map_insert::<i64, Rec>(move m, 2, Rec { count: 9, runs: map_new::<i64, bool>() });
  match map_get_mut::<i64, Rec>(inout m, 1) {
    Some(r) => {
      r.runs = map_insert::<i64, bool>(move r.runs, 3, true);
      assert r.count == 7;
    }
    None => { }
  }
  match map_get::<i64, Rec>(m, 2) {
    Some(r) => { assert r.count == 9; }
    None => { assert false; }
  }
  match map_get::<i64, Rec>(m, 1) {
    Some(r) => { return r.count; }
    None => { return 0; }
  }
}
