// spec: R-6g9-7 reject
// A field-lending path must end at an owned buffer field: an `i64` field (or a `ref` field, which the struct only
// borrows) is type/borrow_signature.
struct Document { source: ref [u8], tape: [i64], n: i64 }
fn count(doc: Document) -> ref [i64] from(doc.n)
{
  return subview(doc.tape, 0, 0);
}
