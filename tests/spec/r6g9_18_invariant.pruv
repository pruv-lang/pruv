// spec: R-6g9-18 reject
struct Doc { source: ref [u8], n: i64, invariant n == 1 }
fn one(d: Doc) -> i64 ensures result == 1 { return d.n; }
pub fn checksum() -> i64 ! alloc {
  let a: [u8] = alloc(1, 0);
  let mut v: Vec<Doc> = vec_new::<Doc>();
  let d: Doc = Doc { source: a, n: 0 };
  v = vec_push::<Doc>(move v, move d);
  if len(v) < 1 { return 0; }
  return one(vec_get::<Doc>(v, 0));
}
