// spec: R-6g8-5 reject
struct Iso { text: [u8], n: i64, tag: [u8] }

fn mk(x: i64) -> Iso ! alloc
  requires 0 <= x && x <= 100
{
  let a: [u8] = alloc(3, 1);
  let b: [u8] = alloc(2, 2);
  return Iso { text: move a, n: x, tag: move b };
}

fn iso_n(s: Iso) -> i64 {
  return s.n;
}

pub fn f(c: bool) -> i64 ! alloc {
  let s: Iso = mk(4);
  if c {
    let t: [u8] = move s.text;
  }
  return len(s.text);
}
