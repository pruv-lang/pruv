// spec: R-6g9-10 reject
// Lists stay out of generic functions (one instantiation per call would need its own provenance).
fn f<T>(p: str, x: T) -> i64 ! alloc {
  let mut parts: Vec<ref str> = vec_new::<ref str>();
  vec_push::<ref str>(inout parts, p);
  return len(parts);
}
fn main() -> i64 ! alloc { if f::<i64>("ab", 1) == 1 { return 0; } return 1; }
