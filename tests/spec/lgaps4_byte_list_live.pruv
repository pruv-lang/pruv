// spec: R-6g9-11 reject
// Writing a byte source while the list is still read is a borrow conflict, as for a str list.
fn f(p: [u8]) -> i64 ! alloc
  requires len(p) >= 2
{
  let mut s: [u8] = alloc(2, p[0]);
  let mut parts: Vec<ref [u8]> = vec_new::<ref [u8]>();
  vec_push::<ref [u8]>(inout parts, subview(s, 0, 1));
  s[0] = 7;
  return len(vec_get::<ref [u8]>(parts, 0));
}
fn main() -> i64 ! alloc { let b: [u8] = alloc(2, 1); if f(b) == 1 { return 0; } return 1; }
