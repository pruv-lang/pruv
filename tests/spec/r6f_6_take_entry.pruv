// spec: R-6f-6 accept
pub struct Req { id: i64, log: Vec<i64> }
pub struct BudgetId { units: [u8], k: i64 }
pub fn own(take r: Req) -> i64 ! alloc requires len(r.log) < 1000 {
  let mut q: Req = move r;
  q.log = vec_push::<i64>(move q.log, 1);
  return len(q.log);
}
pub fn ownb(take id: BudgetId) -> i64 { return len(id.units); }
