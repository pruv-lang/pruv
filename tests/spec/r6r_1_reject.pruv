// spec: R-6r-1 reject
// The invariant must hold again on the continue edge (c can reach i + 2 there).
fn cont_inv(n: i64) -> i64
  requires 0 <= n && n <= 100
{
  let mut c: i64 = 0;
  for i in 0..n invariant 0 <= c && c <= i {
    c = c + 1;
    if i % 2 == 1 { c = c + 1; continue; }
  }
  return c;
}
