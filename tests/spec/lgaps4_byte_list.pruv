// spec: R-6g9-11 accept
// L3-VB / L3-VP: hand `let mut parts: Vec<&[u8]> = Vec::new(); parts.push(&b[start..i]); parts.pop();` - a local
// list of borrowed byte views (no UTF-8 needed), with `vec_pop` dropping the last piece; a `str` list pops too.
fn count(t: [u8]) -> i64
  ensures 0 <= result && result <= 1099511627776
{ return len(t); }

// pieces of b between '/' bytes (plus an owned prefix and an empty view); a ".." piece pops the one before it
fn pieces(b: [u8]) -> i64 ! alloc
  requires len(b) <= 1000000 && len(b) >= 1
  ensures 0 <= result && result <= 400000000000000
{
  let head: [u8] = alloc(1, b[0]);
  let mut parts: Vec<ref [u8]> = vec_new::<ref [u8]>();
  vec_reserve::<ref [u8]>(inout parts, 4);
  vec_push::<ref [u8]>(inout parts, head);
  vec_push::<ref [u8]>(inout parts, []);
  let n: i64 = len(b);
  let mut start: i64 = 0;
  let mut i: i64 = 0;
  while i <= n
    invariant 0 <= start && start <= i && i <= n + 1 && n == len(b) && len(parts) <= i + 2
    decreases n + 1 - i
  {
    if i == n || b[i] == 47 {
      if i == start + 2 && b[start] == 46 && b[start + 1] == 46 {
        if len(parts) >= 1 { vec_pop::<ref [u8]>(inout parts); }
      } else if i > start {
        vec_push::<ref [u8]>(inout parts, subview(b, start, i));
      }
      start = i + 1;
    }
    i = i + 1;
  }
  let mut total: i64 = 0;
  let mut k: i64 = 0;
  while k < len(parts)
    invariant 0 <= k && k <= len(parts) && 0 <= total && total <= 3000000000000
    decreases len(parts) - k
  {
    let piece: ref [u8] = vec_get::<ref [u8]>(parts, k);
    if total <= 1000000000000 { total = total + count(piece); }
    k = k + 1;
  }
  return total * 100 + len(parts);
}

// a str list: push two, pop one, the length is known
fn strs(p: str) -> i64 ! alloc
  ensures 0 <= result && result <= 1099511627776
{
  let mut names: Vec<ref str> = vec_new::<ref str>();
  vec_push::<ref str>(inout names, p);
  vec_push::<ref str>(inout names, "x");
  vec_pop::<ref str>(inout names);
  assert len(names) == 1;
  return len(vec_get::<ref str>(names, 0));
}

fn checksum() -> i64 ! alloc {
  let mut b: [u8] = alloc(10, 47);
  b[0] = 97; b[1] = 98; b[3] = 99; b[5] = 46; b[6] = 46; b[8] = 100; b[9] = 255;
  return pieces(b) * 10 + strs("abc");
}
