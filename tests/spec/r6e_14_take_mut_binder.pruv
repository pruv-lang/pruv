// spec: R-6e-14 accept
struct Clock { used: i64, history: Vec<i64> }

fn reset(inout c: Clock) -> () ensures c.used == 0 { c.used = 0; }

fn rekey(take source: HashMap<String, Clock>, k: str, take dst: String) -> HashMap<String, Clock> ! alloc
  requires len(source) < 1099511627776
{
  let mut m: HashMap<String, Clock> = move source;
  match map_take::<String, Clock>(inout m, k) {
    Some(v) => {
      v.used = 7;
      reset(inout v);
      assert v.used == 0;
      m = map_insert::<String, Clock>(move m, move dst, move v);
      return move m;
    }
    None => { return move m; }
  }
}
