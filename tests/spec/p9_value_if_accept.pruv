// spec: R-6w-1 R-6w-2 accept
// A value `if` is read in a let, a return and an operand; else-if chains nest; the expected type types each arm.
fn sign(x: i64) -> i64
  ensures result == -1 || result == 0 || result == 1
{
  return if x < 0 { -1 } else if x == 0 { 0 } else { 1 };
}

fn narrow(b: bool, k: u8) -> u8
  ensures b ==> result == 200
{
  let v: u8 = if b { 200 } else { k };
  return v;
}

fn pair(b: bool) -> (i64, i64) {
  let p: (i64, i64) = if b { (1, 2) } else { (3, 4) };
  return p;
}

fn sum(c: bool, x: i64) -> i64
  requires -100 < x && x < 100
  ensures c ==> result == x + 1
{
  return x + (if c { 1 } else { 2 });
}
