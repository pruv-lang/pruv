// spec: R-6g-1 accept
fn bump(inout a: [i64]) -> i64
  requires len(a) >= 1
  requires a[0] < 9223372036854775807
  ensures result == old(a)[0] + 1
{
  a[0] = a[0] + 1;
  return a[0];
}

fn demo() -> i64 ! alloc
  ensures result == 2
{
  let mut d: [i64] = alloc(2, 0);
  let x: i64 = bump(inout d) + 1;
  return x;
}
