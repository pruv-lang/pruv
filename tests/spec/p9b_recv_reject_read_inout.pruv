// spec: R-6x-2 reject
// A read receiver is immutable: it cannot be passed inout to another method.
struct C { n: i64 }
impl C {
  fn inc(inout self) -> () requires self.n >= 0 && self.n < 100 { self.n = self.n + 1; }
  fn peek(self) -> i64 requires self.n >= 0 && self.n < 100 { self.inc(); return self.n; }
}
fn f(k: i64) -> i64 { return k; }
