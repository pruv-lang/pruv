// spec: R-6g9-10 reject
// A list never leaves its function's own operations: no argument, result, move or copy.
fn g(v: Vec<String>) -> i64 { return len(v); }
fn f(p: str) -> i64 ! alloc {
  let mut parts: Vec<ref str> = vec_new::<ref str>();
  vec_push::<ref str>(inout parts, p);
  return g(parts);
}
fn main() -> i64 ! alloc { if f("ab") == 1 { return 0; } return 1; }
