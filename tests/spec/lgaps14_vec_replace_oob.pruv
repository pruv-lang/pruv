// spec: R-6g9-12 reject
// L-gaps 14 (P10-M1): the index of a Vec element place carries the range obligation; i may be len(v).
fn put(i: i64) -> i64 ! alloc
  requires 0 <= i && i <= 4
{
  let mut v: Vec<i64> = vec_new::<i64>();
  v = vec_push::<i64>(move v, 1);
  v = vec_push::<i64>(move v, 2);
  v = vec_push::<i64>(move v, 3);
  v = vec_push::<i64>(move v, 4);
  let was: i64 = replace(inout v[i], 9);
  return was;
}
