// spec: R-6g9-2 accept
// A borrowing struct carries an invariant on both backends. The invariant may name the `ref` field:
// here it ties the tape length to the borrowed source and bounds every tape element, so a reader
// can index and add tape values without an overflow check of its own.
struct Doc { src: ref [u8], tape: [i64], invariant len(tape) == len(src) && forall k in 0..len(tape): 0 <= tape[k] && tape[k] <= 9 }
fn parse(src: [u8]) -> Doc from(src) ! alloc
  requires len(src) <= 1000
  ensures len(result.src) == len(src)
{
  let t: [i64] = alloc(len(src), 2);
  return Doc { src: src, tape: move t };
}
fn tape_at(d: Doc, i: i64) -> i64 requires 0 <= i && i < len(d.src) ensures 0 <= result && result <= 9 { return d.tape[i]; }
pub fn checksum() -> i64 ! alloc {
  let x: [u8] = alloc(5, 7);
  let d: Doc = parse(x);
  return tape_at(d, 0) * 100 + tape_at(d, 4) * 10 + len(d.tape);
}
