// spec: R-6b-5 reject
// The fact is about valid UTF-8: a `[u8]` buffer is not known to be valid, so a view of it after an ASCII byte is
// still utf8_invalid when passed to a `str` parameter.
fn count_bytes(t: str) -> i64 { return len(t); }

fn cut(b: [u8], i: i64) -> i64
  requires 0 < i && i < len(b) && b[i - 1] == 62
{
  return count_bytes(subview(b, i, len(b)));
}
