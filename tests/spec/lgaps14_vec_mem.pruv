// spec: R-6g9-12 accept
// L-gaps 14 (P10-M1): an element `v[i]` of a `Vec<i64>` / `Vec<bool>` is a swap / replace place (hand Rust
// `v.swap(i, j)` / `std::mem::replace(&mut v[i], x)`): each index carries the range obligation, the two places of a
// swap are proven distinct, the verifier knows the moved elements, and a loop that swaps elements of `v` havocs `v`.

fn rev(inout v: Vec<i64>, n: i64) -> ()
  requires len(v) == n
  ensures len(v) == n
{
  let mut i: i64 = 0;
  while i < n / 2
    invariant 0 <= i && i <= n / 2 && len(v) == n
    decreases n / 2 - i
  {
    let j: i64 = n - 1 - i;
    swap(inout v[i], inout v[j]);
    i = i + 1;
  }
}

fn ints() -> i64 ! alloc
  ensures result == 4321
{
  let mut v: Vec<i64> = vec_new::<i64>();
  v = vec_push::<i64>(move v, 1);
  v = vec_push::<i64>(move v, 2);
  v = vec_push::<i64>(move v, 3);
  v = vec_push::<i64>(move v, 4);
  swap(inout v[0], inout v[3]);
  assert v[0] == 4 && v[3] == 1 && v[1] == 2;
  let k: i64 = 2;
  let old3: i64 = replace(inout v[k - 1], 3);
  let old2: i64 = replace(inout v[k], old3);
  assert v[1] == 3 && v[2] == 2 && old2 == 3;
  return vec_get::<i64>(v, 0) * 1000 + vec_get::<i64>(v, 1) * 100 + vec_get::<i64>(v, 2) * 10 + vec_get::<i64>(v, 3);
}

fn flags() -> i64 ! alloc
  ensures result == 101
{
  let mut f: Vec<bool> = vec_new::<bool>();
  f = vec_push::<bool>(move f, true);
  f = vec_push::<bool>(move f, false);
  f = vec_push::<bool>(move f, false);
  swap(inout f[0], inout f[2]);
  let was: bool = replace(inout f[1], true);
  assert !f[0] && f[1] && f[2] && !was;
  let mut r: i64 = 0;
  if vec_get::<bool>(f, 2) {
    r = r + 100;
  }
  if vec_get::<bool>(f, 1) {
    r = r + 1;
  }
  return r;
}

fn checksum() -> i64 ! alloc {
  let mut w: Vec<i64> = vec_new::<i64>();
  w = vec_push::<i64>(move w, 5);
  w = vec_push::<i64>(move w, 0);
  w = vec_push::<i64>(move w, 8);
  rev(inout w, 3);
  let first: i64 = replace(inout w[0], 6);
  let mut r: i64 = ints() * 1000 + flags();
  if first == 8 && vec_get::<i64>(w, 0) == 6 && vec_get::<i64>(w, 1) == 0 && vec_get::<i64>(w, 2) == 5 {
    r = r + 70000000;
  }
  return r;
}
