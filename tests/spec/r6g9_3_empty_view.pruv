// spec: R-6g9-3 accept
// `[]` in a `ref [u8]` position is the static empty view (hand `return &[];` in `text_of`): no provenance, no
// allocation, never freed.
fn text_of(src: [u8], lo: i64, hi: i64) -> ref [u8] from(src)
  requires 0 <= lo && lo <= len(src) && 0 <= hi && hi <= len(src)
  ensures len(result) <= len(src)
{
  if hi <= lo {
    return [];
  }
  return subview(src, lo, hi);
}

pub fn checksum() -> i64 ! alloc {
  let x: [u8] = alloc(6, 7);
  let e: ref [u8] = [];
  let a: ref [u8] = text_of(x, 4, 2);
  let b: ref [u8] = text_of(x, 1, 4);
  let mut s: i64 = len(e) * 100 + len(a) * 10 + len(b);
  if len(b) > 0 {
    s = s + b[0];
  }
  return s;
}
