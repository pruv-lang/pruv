// spec: R-6g9-18 accept
struct Doc { source: ref [u8], tape: [i64] }
fn mk(data: [u8]) -> Doc from(data) ! alloc {
  let tape: [i64] = alloc(1, 2);
  let d: Doc = Doc { source: data, tape: move tape };
  return move d;
}
fn weigh(d: Doc) -> i64
  ensures 0 <= result && result <= 1000
{
  if len(d.tape) > 1000 { return 0; }
  return len(d.tape);
}
fn build(data: [u8], mode: i64) -> i64 ! alloc
  requires len(data) <= 100
  ensures -3 <= result && result <= 1003
{
  let mut v: Vec<Doc> = vec_new::<Doc>();
  let mut i: i64 = 0;
  while i < 3
    invariant 0 <= i && i <= 3 && len(v) == i
    decreases 3 - i
  {
    let d: Doc = mk(data);
    v = vec_push::<Doc>(move v, move d);
    if mode == i { return weigh(vec_get::<Doc>(v, i)) + len(v); }
    i = i + 1;
  }
  if mode == 5 { return 0 - len(v); }
  return len(v) * 10;
}
pub fn checksum() -> i64 ! alloc {
  let data: [u8] = alloc(4, 1);
  let a: i64 = build(data, 0) + build(data, 1) + build(data, 2);
  let b: i64 = build(data, 3) + build(data, 4) + build(data, 5) + build(data, 6);
  return a + b;
}
